         ply_boot_server_ask_question_handler_t        ask_question_handler;
         ply_boot_server_display_message_handler_t     display_message_handler;
         ply_boot_server_hide_message_handler_t        hide_message_handler;
@@ -144,6 +148,13 @@ ply_boot_server_new (ply_boot_server_update_handler_t              update_handle
 
 static void ply_boot_connection_on_hangup (ply_boot_connection_t *connection);
 
+void
+ply_boot_server_set_abandoned_answer_handler (ply_boot_server_t                         *server,
+                                              ply_boot_server_abandoned_answer_handler_t handler)
+{
+        server->abandoned_answer_handler = handler;
+}
+
 void
 ply_boot_server_free (ply_boot_server_t *server)
 {
@@ -171,6 +182,7 @@ ply_boot_connection_new (ply_boot_server_t *server,
         connection->server = server;
         connection->watch = NULL;
         connection->reference_count = 1;
+        connection->pending_answers = ply_list_new ();
 
         return connection;
 }
@@ -182,6 +194,7 @@ ply_boot_connection_free (ply_boot_connection_t *connection)
                 return;
 
         close (connection->fd);
+        ply_list_free (connection->pending_answers);
         free (connection);
 }
 
@@ -314,10 +327,13 @@ ply_boot_connection_send_answer (ply_boot_connection_t *connection,
 
 static void
 ply_boot_connection_on_password_answer (ply_boot_connection_t *connection,
-                                        const char            *password)
+                                        const char            *password,
+                                        ply_trigger_t         *trigger)
 {
         ply_trace ("got password answer");
 
+        ply_list_remove_data (connection->pending_answers, trigger);
+
         if (!connection->disconnected)
                 ply_boot_connection_send_answer (connection, password);
 
@@ -359,9 +375,12 @@ ply_boot_connection_on_quit_complete (ply_boot_connection_t *connection)
 
 static void
 ply_boot_connection_on_question_answer (ply_boot_connection_t *connection,
-                                        const char            *answer)
+                                        const char            *answer,
+                                        ply_trigger_t         *trigger)
 {
         ply_trace ("got question answer: %s", answer);
+
+        ply_list_remove_data (connection->pending_answers, trigger);
         if (!connection->disconnected)
                 ply_boot_connection_send_answer (connection, answer);
 
@@ -562,6 +581,7 @@ ply_boot_connection_on_request (ply_boot_connection_t *connection)
                                          ply_boot_connection_on_password_answer,
                                          connection);
                 ply_boot_connection_take_reference (connection);
+                ply_list_append_data (connection->pending_answers, answer);
 
                 if (server->ask_for_password_handler != NULL) {
                         server->ask_for_password_handler (server->user_data,
@@ -647,6 +667,7 @@ ply_boot_connection_on_request (ply_boot_connection_t *connection)
                                          ply_boot_connection_on_question_answer,
                                          connection);
                 ply_boot_connection_take_reference (connection);
+                ply_list_append_data (connection->pending_answers, answer);
 
                 if (server->ask_question_handler != NULL) {
                         server->ask_question_handler (server->user_data,
@@ -765,6 +786,23 @@ ply_boot_connection_on_hangup (ply_boot_connection_t *connection)
 
         server = connection->server;
 
+        /* Whoever asked has gone, so nobody is waiting for these answers:
+         * let the asking stop, or the prompt stays up until someone types
+         * an answer that goes nowhere. */
+        node = ply_list_get_first_node (connection->pending_answers);
+        while (node != NULL) {
+                ply_list_node_t *next_node;
+                ply_trigger_t *answer;
+
+                next_node = ply_list_get_next_node (connection->pending_answers, node);
+                answer = ply_list_node_get_data (node);
+
+                if (server->abandoned_answer_handler != NULL)
+                        server->abandoned_answer_handler (server->user_data, answer, server);
+
+                node = next_node;
+        }
+
         node = ply_list_find_node (server->connections, connection);
 
         assert (node != NULL);
