index a2c42ab..259debd 100644
--- a/src/ply-boot-server.c
+++ b/src/ply-boot-server.c
@@ -48,6 +48,9 @@ typedef struct
 
         int                reference_count;
 
+        /* Answers to password requests and questions still to come. */
+        ply_list_t        *pending_answers;
+
