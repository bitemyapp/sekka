Stop asking when whoever asked has gone

A password request or question stayed queued, and on screen, after the
client that sent it hung up: ply_boot_connection_on_hangup() only marked
the connection disconnected. systemd's password agent gives up a request
once the disk it is for has its passphrase another way, so after a
mistyped passphrase the splash could keep asking for a disk that was
already open, until something typed an answer that went nowhere.

Keep each connection's unanswered requests, and when it hangs up, have
plymouthd drop them from the queue and update the display.

diff --git a/src/main.c b/src/main.c
index fa42499..9db6734 100644
--- a/src/main.c
+++ b/src/main.c
@@ -157,6 +157,8 @@ static const char *get_cache_file_for_mode (ply_boot_splash_mode_t mode);
 static void on_escape_pressed (state_t *state);
 static void on_enter (state_t    *state,
                       const char *line);
+static void on_answer_abandoned (state_t       *state,
+                                 ply_trigger_t *answer);
 static void on_keyboard_input (state_t    *state,
                                const char *keyboard_input,
                                size_t      character_size);
@@ -1569,6 +1571,9 @@ start_boot_server (state_t *state)
                                       (ply_boot_server_has_active_vt_handler_t) on_has_active_vt,
                                       (ply_boot_server_reload_handler_t) on_reload,
                                       state);
+        ply_boot_server_set_abandoned_answer_handler (server,
+                                                      (ply_boot_server_abandoned_answer_handler_t)
+                                                      on_answer_abandoned);
 
         if (!ply_boot_server_listen (server)) {
                 ply_save_errno ();
@@ -1756,6 +1761,31 @@ on_enter (state_t    *state,
         }
 }
 
+static void
+on_answer_abandoned (state_t       *state,
+                     ply_trigger_t *answer)
+{
+        ply_list_node_t *node;
+
+        for (node = ply_list_get_first_node (state->entry_triggers);
+             node != NULL;
+             node = ply_list_get_next_node (state->entry_triggers, node)) {
+                ply_entry_trigger_t *entry_trigger = ply_list_node_get_data (node);
+
+                if (entry_trigger->trigger != answer)
+                        continue;
+
+                ply_trace ("no longer asking: whoever asked has gone");
+                if (node == ply_list_get_first_node (state->entry_triggers))
+                        ply_buffer_clear (state->entry_buffer);
+                ply_list_remove_node (state->entry_triggers, node);
+                free (entry_trigger);
+                ply_trigger_pull (answer, NULL);
+                update_display (state);
+                return;
+        }
+}
+
 static void
 attach_splash_to_devices (state_t           *state,
                           ply_boot_splash_t *splash)
