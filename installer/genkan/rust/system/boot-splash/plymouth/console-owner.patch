Free the local console when the renderer that had it goes

local_console_managed was cleared only once no keyboards at all were left.
When a GPU's driver takes over from simpledrm, its framebuffer device can
show up before its DRM device and get a renderer of its own, without the
console terminal, which simpledrm still has. That renderer's keyboard is
still there when simpledrm goes, so the DRM renderer doesn't get the
terminal either, and with legacy (terminal) input nothing typed reaches
plymouthd any more, Escape included.

diff --git a/src/libply-splash-core/ply-device-manager.c b/src/libply-splash-core/ply-device-manager.c
index 446ebd4..aef2bcd 100644
--- a/src/libply-splash-core/ply-device-manager.c
+++ b/src/libply-splash-core/ply-device-manager.c
@@ -198,6 +198,12 @@ free_devices_from_device_path (ply_device_manager_t *manager,
         free_displays_for_renderer (manager, renderer);
         free_keyboards_for_renderer (manager, renderer);
 
+        if (manager->local_console_terminal != NULL &&
+            ply_renderer_get_terminal (renderer) == manager->local_console_terminal) {
+                ply_trace ("local console is free again");
+                manager->local_console_managed = false;
+        }
+
         ply_hashtable_remove (manager->renderers, (void *) device_path);
         free (key);
 
diff --git a/src/libply-splash-core/ply-renderer.c b/src/libply-splash-core/ply-renderer.c
index 21df22f..f80ef7e 100644
--- a/src/libply-splash-core/ply-renderer.c
+++ b/src/libply-splash-core/ply-renderer.c
@@ -111,6 +111,12 @@ ply_renderer_get_type (ply_renderer_t *renderer)
         return renderer->type;
 }
 
+ply_terminal_t *
+ply_renderer_get_terminal (ply_renderer_t *renderer)
+{
+        return renderer->terminal;
+}
+
 static bool
 ply_renderer_load_plugin (ply_renderer_t *renderer,
                           const char     *module_path)
