index 9d2a5e9..825720f 100644
--- a/src/plugins/splash/script/script-lib-plymouth.h
+++ b/src/plugins/splash/script/script-lib-plymouth.h
@@ -53,6 +53,8 @@ script_lib_plymouth_data_t *script_lib_plymouth_setup (script_state_t        *st
                                                        int                    refresh_rate,
                                                        ply_keyboard_t        *keyboard);
 void script_lib_plymouth_destroy (script_lib_plymouth_data_t *data);
+void script_lib_plymouth_set_keyboard (script_lib_plymouth_data_t *data,
