+func included(path string) (bool, error) {
+	for _, root := range searchRoots() {
+		if filepath.Clean(path) == filepath.Clean(root) {
+			return true, nil
 		}
 	}
+	// Events queued before a directory moved out or became ignored cannot
+	// reintroduce its children after the parent watcher has been removed.
+	parent := filepath.Dir(path)
+	if !slices.ContainsFunc(watcher.WatchList(), func(p string) bool { return filepath.Clean(p) == parent }) {
+		return false, nil
+	}
+	paths, err := listedPaths(parent, true)
+	if err != nil {
+		return false, err
+	}
+	return slices.ContainsFunc(paths, func(p string) bool { return filepath.Clean(p) == path }), nil
