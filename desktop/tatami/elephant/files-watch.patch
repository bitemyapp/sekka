+func refresh(path string) error {
+	info, err := os.Stat(path)
+	present := err == nil
+	if err != nil && !os.IsNotExist(err) {
+		return err
+	}
+	if present {
+		present, err = included(path)
+		if err != nil {
+			return err
+		}
+	}
+	// Keep existing watches and data until the replacement scan succeeds.
+	// A transient fd/read error must not silently stop watching descendants.
+	files := []File{}
+	if present {
+		if info.IsDir() {
+			files, err = scanDirectory(path)
+		} else {
+			var f File
+			f, err = fileEntry(path)
+			files = append(files, f)
+		}
+		if err != nil {
+			return err
+		}
+	}
+	if err := replaceFileTree(path, files); err != nil {
+		return err
+	}
+	keep := map[string]bool{}
+	for _, file := range files {
+		if strings.HasSuffix(file.Path, string(os.PathSeparator)) {
+			keep[filepath.Clean(file.Path)] = true
+		}
+	}
+	for _, watched := range watcher.WatchList() {
+		if within(watched, path) && !keep[filepath.Clean(watched)] {
+			_ = watcher.Remove(watched)
+		}
+	}
+	return nil
+}
 
