+++ b/internal/providers/desktopapplications/query.go
@@ -66,5 +66,10 @@
 		var fs int32
 		field := "text"
+		// The generic name, which the launcher shows under the name, whichever
+		// field matched, unless it only repeats the name.
 		subtext := v.GenericName
+		if subtext == v.Name {
+			subtext = ""
+		}
 
 		if query != "" {
@@ -72,5 +77,4 @@
 
 			if ok && match != v.Name {
-				subtext = match
 				field = "subtext"
 			}
@@ -195,4 +199,5 @@
