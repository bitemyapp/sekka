#!/usr/bin/env bash
# Prepare this worktree's Sidestep, the vendor/sidestep submodule that
# desktop/aizome/sidestep links to: check it out at the revision Sekka
# records if it isn't checked out yet, and say when it differs from the
# revision the package builds against. A checkout is never moved, so
# Sidestep work in it is kept. Messages go to standard error, because
# aizome-dev reads the shell's environment from standard output.
set -euo pipefail

search_dir=$PWD
root=
while [[ $search_dir != / ]]; do
  if [[ -f $search_dir/desktop/aizome/Cargo.toml ]]; then
    root=$search_dir
    break
  fi
  search_dir=$(dirname -- "$search_dir")
done
[[ -n $root ]] || exit 0

sidestep=$root/vendor/sidestep
if [[ ! -e $sidestep/.git ]]; then
  echo "aizome: checking out the vendor/sidestep submodule" >&2
  if ! git -C "$root" submodule update --init -- vendor/sidestep >&2; then
    echo "aizome: vendor/sidestep isn't checked out; run" \
      "\`git submodule update --init vendor/sidestep\` in $root" >&2
    exit 0
  fi
fi

pinned=${AIZOME_SIDESTEP_REV:-}
have=$(git -C "$sidestep" rev-parse HEAD 2>/dev/null) || exit 0
if [[ -n $pinned && $have != "$pinned" ]]; then
  echo "aizome: vendor/sidestep is at $have, but the package builds against" \
    "Sidestep $pinned; \`git submodule update vendor/sidestep\` checks out" \
    "the revision Sekka records" >&2
fi

# Later patches may change earlier patches' context. Recognize an applied
# prefix by reversing it in order in a private index, then validate the whole
# series. The real index and worktree stay untouched until every patch passes.
# Snapshot tracked edits and existing files named by the patches into the
# private index. This also recognizes already-applied additions without
# staging unrelated untracked files or touching the developer's real index.
patches=()
patch_names=()
for patch_name in clipboard input mime grid-font sprites; do
  native_patch=$root/apps/hotaru/upstream/sidestep-$patch_name.patch
  [[ -s $native_patch ]] || continue
  patches+=("$native_patch")
  patch_names+=("$patch_name")
done
(( ${#patches[@]} )) || exit 0

patch_scratch=$(mktemp -d)
trap 'rm -rf -- "$patch_scratch"' EXIT
GIT_INDEX_FILE=$patch_scratch/base git -C "$sidestep" read-tree HEAD
GIT_INDEX_FILE=$patch_scratch/base git -C "$sidestep" add -u -- .
for native_patch in "${patches[@]}"; do
  git -C "$sidestep" apply --numstat -z "$native_patch" > "$patch_scratch/paths"
  while IFS= read -r -d '' patch_stat; do
    patch_path=${patch_stat#*$'\t'}
    patch_path=${patch_path#*$'\t'}
    if [[ -f $sidestep/$patch_path || -L $sidestep/$patch_path ]]; then
      GIT_INDEX_FILE=$patch_scratch/base git -C "$sidestep" add -f -- "$patch_path"
    fi
  done < "$patch_scratch/paths"
done
before_tree=$(GIT_INDEX_FILE=$patch_scratch/base git -C "$sidestep" write-tree)
after_tree=
applied_count=0
for ((prefix=${#patches[@]}; prefix>=0; prefix--)); do
  cp -- "$patch_scratch/base" "$patch_scratch/trial"
  valid=true
  for ((i=prefix-1; i>=0; i--)); do
    if ! GIT_INDEX_FILE=$patch_scratch/trial git -C "$sidestep" apply --cached --reverse "${patches[i]}" 2>/dev/null; then
      valid=false
      break
    fi
  done
  $valid || continue
  for native_patch in "${patches[@]}"; do
    if ! GIT_INDEX_FILE=$patch_scratch/trial git -C "$sidestep" apply --cached "$native_patch" 2>/dev/null; then
      valid=false
      break
    fi
  done
  $valid || continue
  after_tree=$(GIT_INDEX_FILE=$patch_scratch/trial git -C "$sidestep" write-tree)
  applied_count=$prefix
  break
done

if [[ -z $after_tree ]]; then
  echo "aizome: cannot apply Hotaru's ordered native patch series;" \
    "preserving vendor/sidestep. Reconcile its local changes before building Hotaru." >&2
  exit 1
fi
[[ $before_tree != "$after_tree" ]] || exit 0
git -C "$sidestep" diff-tree --no-commit-id --binary -p "$before_tree" "$after_tree" > "$patch_scratch/change.patch"
# git apply checks the entire diff before updating files. Concurrent edits
# that invalidate the diff are rejected without changing the developer's index.
git -C "$sidestep" apply "$patch_scratch/change.patch"
for ((i=applied_count; i<${#patches[@]}; i++)); do
  echo "aizome: applied Hotaru's native ${patch_names[i]} patch" >&2
done
