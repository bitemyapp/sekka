#!/bin/sh
# Starts an Aizome session, from a display manager (aizome.desktop) or a
# TTY.
#
# It reads the session's environment (/etc/xdg/aizome/environment, then
# ~/.config/aizome/environment: KEY=VALUE lines), and then:
#
# - with a systemd user manager, hands it the environment, starts
#   aizome.service (the compositor, which says when it is ready and then
#   starts aizome-session.target, binding graphical-session.target) and
#   waits for it to end; afterwards it tears the session's units down and
#   takes the session's variables back out of the manager;
# - without one, runs the compositor itself in a D-Bus session.

# A login shell's environment first (PATH, LANG and the rest), when started
# by a display manager that gives none.
if [ "$1" != --no-login-shell ] && [ -n "$SHELL" ] && grep -qx "$SHELL" /etc/shells 2>/dev/null; then
  case "$SHELL" in
    */nologin | */false) ;;
    *) exec "$SHELL" -l -c 'exec "$0" --no-login-shell "$@"' "$0" "$@" ;;
  esac
fi
[ "$1" = --no-login-shell ] && shift

vars="XDG_CURRENT_DESKTOP XDG_SESSION_DESKTOP XDG_SESSION_TYPE"
for file in /etc/xdg/aizome/environment "${XDG_CONFIG_HOME:-$HOME/.config}/aizome/environment"; do
  [ -r "$file" ] || continue
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in
      '' | '#'*) continue ;;
      *=*)
        key=${line%%=*}
        export "$key=${line#*=}"
        # Each name once: systemctl import-environment refuses the whole
        # list when a name repeats.
        case " $vars " in
          *" $key "*) ;;
          *) vars="$vars $key" ;;
        esac
        ;;
    esac
  done < "$file"
done
export XDG_CURRENT_DESKTOP="${XDG_CURRENT_DESKTOP:-Aizome}"
export XDG_SESSION_DESKTOP=aizome
export XDG_SESSION_TYPE=wayland

state=$(systemctl --user is-system-running 2>/dev/null)
case "$state" in
  running | degraded | starting)
    # Nothing left over from an earlier session.
    if systemctl --user -q is-active aizome.service; then
      echo "Aizome is already running in this user's session." >&2
      exit 1
    fi
    systemctl --user reset-failed
    # shellcheck disable=SC2086
    systemctl --user import-environment $vars
    dbus-update-activation-environment --systemd $vars 2>/dev/null
    # A compositor its watchdog stopped (its main loop stalled) starts
    # again, up to three times in a row; one that ran for five minutes
    # since resets the count. Anything else ends the session.
    restarts=0
    while :; do
      started=$(date +%s)
      systemctl --user --wait start aizome.service
      status=$?
      result=$(systemctl --user show -p Result --value aizome.service 2>/dev/null)
      [ "$result" = watchdog ] || break
      [ $(($(date +%s) - started)) -ge 300 ] && restarts=0
      [ "$restarts" -lt 3 ] || break
      restarts=$((restarts + 1))
      echo "aizome-session: Aizome stopped responding; starting it again" >&2
      systemctl --user reset-failed aizome.service
    done
    systemctl --user start --job-mode=replace-irreversibly aizome-shutdown.target
    systemctl --user unset-environment WAYLAND_DISPLAY DISPLAY AIZOME_SOCKET AIZOME_SHELL_SOCKET $vars
    exit $status
    ;;
  *)
    # No systemd user manager: the compositor is the session.
    if command -v dbus-run-session >/dev/null; then
      exec dbus-run-session aizome "$@"
    fi
    exec aizome "$@"
    ;;
esac
