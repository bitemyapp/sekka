[Desktop Entry]
Type=Application
Name=Koe
GenericName=Dictation
Comment=Speak, and your words are typed into the app you're using
Keywords=dictation;voice;speech;speech to text;microphone;transcribe;whisper;vocabulary;
Categories=Utility;Accessibility;
Icon=org.aizome.Koe
Exec=aizome-koe
Terminal=false
StartupNotify=true
StartupWMClass=org.aizome.Koe
DBusActivatable=false
Actions=Dictate;Cancel;Vocabulary;

[Desktop Action Dictate]
Name=Start or Stop Dictation
Exec=aizome-koe record toggle

[Desktop Action Cancel]
Name=Cancel Dictation
Exec=aizome-koe record cancel

[Desktop Action Vocabulary]
Name=Vocabulary and Teaching
Exec=aizome-koe --page vocabulary
