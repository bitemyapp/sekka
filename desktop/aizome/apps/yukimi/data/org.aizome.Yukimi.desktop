[Desktop Entry]
Type=Application
Name=Yukimi
GenericName=Package Manager
Comment=See what's installed, find what's available, update and go back, on Sekka's NixOS
Keywords=nix;nixos;nixpkgs;packages;software;apps;applications;programs;install;uninstall;remove;update;upgrade;store;app store;software center;generations;rollback;flake;configuration;garbage;
Categories=System;PackageManager;
Icon=org.aizome.Yukimi
Exec=aizome-yukimi %U
Terminal=false
StartupNotify=true
StartupWMClass=org.aizome.Yukimi
DBusActivatable=false
Actions=updates;discover;

[Desktop Action updates]
Name=Check for Updates
Exec=aizome-yukimi --page updates

[Desktop Action discover]
Name=Find Software
Exec=aizome-yukimi --page discover
