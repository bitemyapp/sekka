From a8a8cb374b0e08cd22c5f40dedf3a034d15907fd Mon Sep 17 00:00:00 2001
From: Chris Allen <callen.23dc@gmail.com>
Date: Tue, 20 Oct 2026 15:04:34 -0500
Subject: [PATCH 1/3] screencast: forget the retry timer when destroying the
 cast

xdpw_screencast_instance_destroy() frees every timer of the cast,
process_retry among them, but leaves the pointer to it. Disconnecting
the stream afterwards changes its state, and the state handler disarms
process_retry again: xdpw_destroy_timer() on freed memory. The portal
crashes this way whenever a cast is closed while starved of buffers,
with the retry timer armed.
---
 src/screencast/screencast.c | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/src/screencast/screencast.c b/src/screencast/screencast.c
index a8fdc10..8a567f8 100644
--- a/src/screencast/screencast.c
+++ b/src/screencast/screencast.c
@@ -93,6 +93,9 @@ void xdpw_screencast_instance_destroy(struct xdpw_screencast_instance *cast) {
 			xdpw_destroy_timer(timer);
 		}
 	}
+	// The stream's state changes while it disconnects below, which disarms
+	// the retry timer again
+	cast->process_retry = NULL;
 	struct xdpw_session *sess, *stmp;
 	wl_list_for_each_safe(sess, stmp, &cast->ctx->state->xdpw_sessions, link) {
 		if (sess->screencast_data.screencast_instance == cast) {
-- 
