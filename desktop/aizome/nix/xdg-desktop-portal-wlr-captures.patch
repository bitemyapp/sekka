From 71b2e370bfb3d8907d5761728b316e4b9794e63c Mon Sep 17 00:00:00 2001
From: Chris Allen <callen.23dc@gmail.com>
Date: Tue, 20 Oct 2026 15:05:44 -0500
Subject: [PATCH 3/3] screencast: keep a paused capture's buffer instead of
 queuing it

When the stream pauses in the middle of a capture, the PAUSED handler
queued the capture's buffer as it was: never filled, flagged corrupted,
and stamped with the last frame's presentation time, which is zero
before the first frame. The stream pauses and resumes this way as a
consumer links, so that buffer can be the first one a consumer sees.
GStreamer's pipewiresrc, as a live source, takes its timestamp offset
from the first buffer and then waits on the clock for each later
buffer's pts plus that offset: after a first pts of zero, the second
buffer, stamped with CLOCK_MONOTONIC, waits about as long as the
machine has been up, and the stream stalls after one frame.

Keep the buffer dequeued while the stream is paused, with its capture
cancelled, and capture into it when the stream resumes. Without a kept
buffer, resume through the process handler, which retries when no
buffer can be dequeued.
---
 src/screencast/pipewire_screencast.c | 19 ++++++++++++-------
 1 file changed, 12 insertions(+), 7 deletions(-)

diff --git a/src/screencast/pipewire_screencast.c b/src/screencast/pipewire_screencast.c
index 592979a..62814f2 100644
--- a/src/screencast/pipewire_screencast.c
+++ b/src/screencast/pipewire_screencast.c
@@ -353,6 +353,8 @@ static void pwr_disarm_process_retry(struct xdpw_screencast_instance *cast) {
 	cast->process_retry = NULL;
 }
 
+static void pwr_handle_stream_on_process(void *data);
+
 static void pwr_handle_stream_state_changed(void *data,
 		enum pw_stream_state old, enum pw_stream_state state, const char *error) {
 	struct xdpw_screencast_instance *cast = data;
@@ -365,18 +367,21 @@ static void pwr_handle_stream_state_changed(void *data,
 	switch (state) {
 	case PW_STREAM_STATE_STREAMING:
 		cast->pwr_stream_state = true;
-		xdpw_pwr_dequeue_buffer(cast);
-		xdpw_wlr_frame_capture(cast);
+		if (cast->current_frame.pw_buffer) {
+			// Kept from before a pause, which cancelled its capture
+			xdpw_wlr_frame_capture(cast);
+		} else {
+			pwr_handle_stream_on_process(cast);
+		}
 		break;
 	default:
 		cast->pwr_stream_state = false;
 		pwr_disarm_process_retry(cast);
-		// The capture has to stop before PipeWire gets its buffer back
+		// Keep the buffer for when the stream resumes. Queued uncaptured, it
+		// would go out flagged corrupted and stamped with the last frame's
+		// time, zero before the first frame, and a consumer that syncs to
+		// the stamps would then wait as long as the clock has run.
 		xdpw_wlr_frame_capture_cancel(cast);
-		if (state == PW_STREAM_STATE_PAUSED && old == PW_STREAM_STATE_STREAMING
-				&& cast->current_frame.pw_buffer) {
-			xdpw_pwr_enqueue_buffer(cast);
-		}
 		break;
 	}
 }
-- 
