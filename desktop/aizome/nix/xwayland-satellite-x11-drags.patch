diff --git a/src/server/xdrag.rs b/src/server/xdrag.rs
new file mode 100644
index 0000000..9a60ba1
--- /dev/null
+++ b/src/server/xdrag.rs
@@ -0,0 +1,422 @@
+//! X11 -> Wayland drags: a drag an X client starts is carried by a Wayland drag.
+//!
+//! X windows' positions on the X screen are satellite's choice: Wayland doesn't tell clients
+//! where their windows are. An X client looks for its XDND target at the pointer's X screen
+//! position, so without help its drags land wherever the X screen has a window there, not where
+//! the person sees one. Carried by a Wayland drag, the compositor says which surface the pointer
+//! is over. Over one of our X windows, Xwayland's pointer moves to the matching point on the X
+//! screen, so the X client finds that window and drives XDND with it itself. Over a Wayland
+//! client, satellite's proxy window is the X client's target (see `xstate/xdrag.rs`) and the
+//! data comes from its XdndSelection.
+use super::InnerServerState;
+use super::WindowData;
+use super::clientside::{WlDndEvent, XDragSourceEvent};
+use super::event::{CurrentSurface, SurfaceScaleFactor};
+use crate::X11Selection;
+use hecs::Entity;
+use log::{debug, warn};
+use smithay_client_toolkit::data_device_manager::data_offer::DragOffer;
+use smithay_client_toolkit::data_device_manager::data_source::DragSource;
+use std::rc::Rc;
+use wayland_client::Proxy;
+use wayland_client::protocol::wl_data_device_manager::DndAction;
+use wayland_server::Resource;
+use wayland_server::protocol::{wl_pointer, wl_surface::WlSurface};
+use xcb::x;
+
+/// A pointer button held on one of our X windows: an X client may start a drag with it.
+pub(crate) struct PointerPress {
+    pub pointer: Entity,
+    pub surface: Entity,
+    pub serial: u32,
+    pub button: u32,
+    /// Where the pointer is on that window, in Xwayland's coordinates.
+    pub pos: (f64, f64),
+}
+
+pub(crate) struct XDrag<S> {
+    // Destroyed with the drag.
+    _source: DragSource,
+    data: Rc<S>,
+    pointer: Entity,
+    button: u32,
+    /// The surface the drag started from, which keeps Xwayland's pointer, and where the pointer
+    /// is relative to it.
+    origin: Entity,
+    pos: (f64, f64),
+    time: u32,
+    serial: u32,
+    /// The surface the compositor's drag is over, if it is one of ours.
+    over: Option<Entity>,
+    offer: Option<DragOffer>,
+    dropped_on_x: bool,
+    /// What the Wayland client under the drag said: whether it takes one of the types (if it
+    /// said), and whether it chose an action.
+    wl_mime: Option<bool>,
+    wl_action: bool,
+    released: bool,
+}
+
+impl<S> XDrag<S> {
+    fn over_wayland(&mut self) {
+        self.wl_mime = None;
+        self.wl_action = false;
+    }
+
+    fn wayland_accepts(&self) -> bool {
+        self.wl_mime != Some(false) && self.wl_action
+    }
+}
+
+/// What XState does for an X client's drag, in order.
+pub(crate) enum XDragEvent {
+    /// Over one of our X windows: XState hides its proxy, raises the window and moves
+    /// Xwayland's pointer there with [`InnerServerState::x_drag_pointer_to`].
+    OverX {
+        surface: Entity,
+        window: x::Window,
+        x: f64,
+        y: f64,
+        time: u32,
+    },
+    /// Over a Wayland client's surface, or none: XState shows its proxy as the X target.
+    OverWayland,
+    /// Whether the Wayland client under the drag would take it.
+    WaylandAccepts(bool),
+    /// Dropped on one of our X windows: the X client finishes the drop with it.
+    DroppedOnX,
+    /// Dropped on a Wayland client, which now reads the data.
+    DroppedOnWayland,
+    /// The Wayland drag is over: `true` if a Wayland client took the data.
+    Ended { finished: bool },
+}
+
+impl<S: X11Selection> InnerServerState<S> {
+    pub(crate) fn x_drag_pointer(&self) -> Option<Entity> {
+        self.x_drag.as_ref().map(|d| d.pointer)
+    }
+
+    pub(crate) fn has_pointer_press(&self) -> bool {
+        self.pointer_press.is_some()
+    }
+
+    pub(crate) fn pointer_pressed(&mut self, press: Option<PointerPress>, button: u32) {
+        if let Some(mut press) = press {
+            press.pos = self.pointer_pos;
+            self.pointer_press = Some(press);
+            return;
+        }
+        if self
+            .pointer_press
+            .as_ref()
+            .is_some_and(|p| p.button == button)
+        {
+            self.pointer_press = None;
+        }
+        // The compositor gave us the release itself: it never started the drag.
+        if let Some(drag) = self.x_drag.as_mut().filter(|d| d.button == button) {
+            debug!("X drag ended without a Wayland drag");
+            drag.released = true;
+            drag.dropped_on_x = true;
+            self.x_drag_events
+                .push(XDragEvent::Ended { finished: false });
+        }
+    }
+
+    /// An X client took XdndSelection: carry its drag in a Wayland drag from the window the
+    /// pointer was pressed on.
+    pub(crate) fn start_x_drag(&mut self, data: &Rc<S>) -> bool {
+        if self.x_drag.is_some() {
+            return false;
+        }
+        let Some(press) = &self.pointer_press else {
+            return false;
+        };
+        let Some((manager, device)) = self.selection_states.data_device() else {
+            return false;
+        };
+        let Ok(origin) = self
+            .world
+            .get::<&wayland_client::protocol::wl_surface::WlSurface>(press.surface)
+            .map(|s| (*s).clone())
+        else {
+            return false;
+        };
+        // Copy only: a Wayland target choosing "move" would have the X client delete its data.
+        let source =
+            manager.create_drag_and_drop_source(&self.qh, data.mime_types(), DndAction::Copy);
+        source.start_drag(device, &origin, None, press.serial);
+        debug!("X client started a drag, carried by a Wayland drag");
+        self.world.x_drag_source = Some(source.inner().clone());
+        self.x_drag = Some(XDrag {
+            _source: source,
+            data: data.clone(),
+            pointer: press.pointer,
+            button: press.button,
+            origin: press.surface,
+            pos: press.pos,
+            time: 0,
+            serial: press.serial,
+            over: None,
+            offer: None,
+            dropped_on_x: false,
+            wl_mime: None,
+            wl_action: false,
+            released: false,
+        });
+        // Over nothing until the compositor says otherwise: the pointer may be over a Wayland
+        // client before its first event about the drag.
+        self.x_drag_events.push(XDragEvent::OverWayland);
+        self.flush_wayland();
+        true
+    }
+
+    /// Where the pointer is on the X window it is over, in Xwayland's coordinates.
+    pub(crate) fn pointer_moved(&mut self, pos: (f64, f64)) {
+        self.pointer_pos = pos;
+        if let Some(press) = self.pointer_press.as_mut() {
+            press.pos = pos;
+        }
+    }
+
+    pub(crate) fn pointer_press_lost(&mut self) {
+        self.pointer_press = None;
+    }
+
+    pub(crate) fn take_x_drag_events(&mut self) -> Vec<XDragEvent> {
+        let mut out = std::mem::take(&mut self.x_drag_events);
+        if self.x_drag.is_none() {
+            return out;
+        }
+        let mut events = std::mem::take(&mut self.world.dnd).into_iter().peekable();
+        while let Some(event) = events.next() {
+            let drag = self.x_drag.as_mut().unwrap();
+            match event {
+                WlDndEvent::Enter(offer) => {
+                    if let Some(old) = drag.offer.take() {
+                        old.destroy();
+                    }
+                    drag.serial = offer.serial;
+                    let target = offer.surface.data::<Entity>().copied().and_then(|e| {
+                        let window = *self.world.get::<&x::Window>(e).ok()?;
+                        Some((e, window))
+                    });
+                    match target {
+                        Some((surface, window)) => {
+                            debug!("X drag over {window:?} at {},{}", offer.x, offer.y);
+                            // Accept, so that the compositor reports the drop here: the X client
+                            // and its X target decide the rest.
+                            let mime = drag.data.mime_types().first().map(|m| m.to_string());
+                            offer.accept_mime_type(offer.serial, mime);
+                            offer.set_actions(DndAction::Copy, DndAction::Copy);
+                            out.push(XDragEvent::OverX {
+                                surface,
+                                window,
+                                x: offer.x,
+                                y: offer.y,
+                                time: drag.time,
+                            });
+                            drag.over = Some(surface);
+                            drag.offer = Some(offer);
+                        }
+                        None => {
+                            // A decoration: no X target.
+                            offer.destroy();
+                            drag.over = None;
+                            drag.over_wayland();
+                            out.push(XDragEvent::OverWayland);
+                        }
+                    }
+                }
+                WlDndEvent::Motion(x, y, time) => {
+                    let Some(surface) = drag.over else {
+                        continue;
+                    };
+                    let Ok(window) = self.world.get::<&x::Window>(surface).map(|w| *w) else {
+                        continue;
+                    };
+                    out.push(XDragEvent::OverX {
+                        surface,
+                        window,
+                        x,
+                        y,
+                        time,
+                    });
+                }
+                WlDndEvent::Leave => {
+                    if let Some(offer) = drag.offer.take() {
+                        offer.destroy();
+                    }
+                    // Straight onto another surface of ours: no need for the proxy between.
+                    let onto_ours = matches!(events.peek(), Some(WlDndEvent::Enter(_)));
+                    if drag.over.take().is_some() && !onto_ours {
+                        drag.over_wayland();
+                        out.push(XDragEvent::OverWayland);
+                    }
+                }
+                WlDndEvent::Drop(offer) => {
+                    if drag.over.take().is_some() {
+                        drag.dropped_on_x = true;
+                        out.push(XDragEvent::DroppedOnX);
+                        offer.finish();
+                    }
+                    drag.offer = None;
+                    offer.destroy();
+                }
+            }
+        }
+        for event in std::mem::take(&mut self.world.x_drag_source_events) {
+            let Some(drag) = self.x_drag.as_mut() else {
+                break;
+            };
+            match event {
+                XDragSourceEvent::Target(mime) => {
+                    if drag.over.is_none() {
+                        drag.wl_mime = Some(mime.is_some());
+                        out.push(XDragEvent::WaylandAccepts(drag.wayland_accepts()));
+                    }
+                }
+                XDragSourceEvent::Action(action) => {
+                    if drag.over.is_none() {
+                        drag.wl_action = !action.is_empty();
+                        out.push(XDragEvent::WaylandAccepts(drag.wayland_accepts()));
+                    }
+                }
+                XDragSourceEvent::Send(mime, fd) => drag.data.write_to(&mime, fd),
+                XDragSourceEvent::Dropped => {
+                    if !drag.dropped_on_x {
+                        out.push(XDragEvent::DroppedOnWayland);
+                    }
+                }
+                XDragSourceEvent::Finished => out.push(XDragEvent::Ended { finished: true }),
+                XDragSourceEvent::Cancelled => out.push(XDragEvent::Ended { finished: false }),
+            }
+        }
+        out
+    }
+
+    /// Move Xwayland's pointer to a point on one of our X windows' surfaces (logical
+    /// coordinates).
+    ///
+    /// Xwayland's pointer stays on the window the drag started from: entering another surface
+    /// would make Xwayland release the held button, which ends the X client's drag. Xwayland
+    /// puts the pointer at that window's X position plus the surface coordinates it is given,
+    /// even outside the window, so the point is given relative to it.
+    pub(crate) fn x_drag_pointer_to(&mut self, surface: Entity, x: f64, y: f64, time: u32) {
+        let Some(drag) = self.x_drag.as_mut() else {
+            return;
+        };
+        let position = |entity| {
+            let mut query = self
+                .world
+                .query_one::<(&WindowData, &SurfaceScaleFactor)>(entity)
+                .ok()?;
+            let (data, scale) = query.get()?;
+            Some((data.attrs.dims.x as f64, data.attrs.dims.y as f64, scale.0))
+        };
+        let (Some((tx, ty, scale)), Some((ox, oy, _))) = (position(surface), position(drag.origin))
+        else {
+            return;
+        };
+        let (sx, sy) = (tx - ox + x * scale, ty - oy + y * scale);
+        {
+            let Ok(pointer) = self.world.get::<&wl_pointer::WlPointer>(drag.pointer) else {
+                return;
+            };
+            pointer.motion(time, sx, sy);
+            if pointer.version() >= 5 {
+                pointer.frame();
+            }
+        }
+        drag.pos = (sx, sy);
+        drag.time = time;
+        self.flush_xwayland();
+    }
+
+    /// Move Xwayland's pointer in place, so that the X client looks for its target again.
+    pub(crate) fn x_drag_nudge(&mut self) {
+        let Some(drag) = self.x_drag.as_ref() else {
+            return;
+        };
+        {
+            let Ok(pointer) = self.world.get::<&wl_pointer::WlPointer>(drag.pointer) else {
+                return;
+            };
+            let (x, y) = drag.pos;
+            for x in [x + 1.0, x] {
+                pointer.motion(drag.time, x, y);
+                if pointer.version() >= 5 {
+                    pointer.frame();
+                }
+            }
+        }
+        self.flush_xwayland();
+    }
+
+    /// Give the X client the button release that ends its drag.
+    pub(crate) fn x_drag_release(&mut self) {
+        let Some(drag) = self.x_drag.as_mut() else {
+            return;
+        };
+        if drag.released {
+            return;
+        }
+        drag.released = true;
+        {
+            let Ok(pointer) = self.world.get::<&wl_pointer::WlPointer>(drag.pointer) else {
+                return;
+            };
+            pointer.button(
+                drag.serial,
+                drag.time,
+                drag.button,
+                wl_pointer::ButtonState::Released,
+            );
+            if pointer.version() >= 5 {
+                pointer.frame();
+            }
+        }
+        if self
+            .pointer_press
+            .as_ref()
+            .is_some_and(|p| p.button == drag.button)
+        {
+            self.pointer_press = None;
+        }
+        self.flush_xwayland();
+    }
+
+    /// The Wayland drag is over. Unless it ended over one of our windows, which the compositor
+    /// gives the pointer back to, Xwayland's pointer leaves the X window it was kept on.
+    pub(crate) fn x_drag_end(&mut self) {
+        self.x_drag_release();
+        let Some(drag) = self.x_drag.take() else {
+            return;
+        };
+        if drag.over.is_none() && !drag.dropped_on_x {
+            if let (Ok(pointer), Ok(surface)) = (
+                self.world.get::<&wl_pointer::WlPointer>(drag.pointer),
+                self.world.get::<&WlSurface>(drag.origin),
+            ) {
+                pointer.leave(drag.serial, &surface);
+                if pointer.version() >= 5 {
+                    pointer.frame();
+                }
+            }
+            let _ = self.world.remove_one::<CurrentSurface>(drag.pointer);
+        }
+        if let Some(offer) = &drag.offer {
+            offer.destroy();
+        }
+        self.world.x_drag_source = None;
+        drop(drag);
+        self.flush_wayland();
+        self.flush_xwayland();
+    }
+
+    fn flush_xwayland(&mut self) {
+        if let Err(e) = self.dh.flush_clients() {
+            warn!("Failed to flush Xwayland events: {e}");
+        }
+    }
+}
