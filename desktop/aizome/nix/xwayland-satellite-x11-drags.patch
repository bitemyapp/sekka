diff --git a/src/xstate/xdrag.rs b/src/xstate/xdrag.rs
new file mode 100644
index 0000000..407482d
--- /dev/null
+++ b/src/xstate/xdrag.rs
@@ -0,0 +1,421 @@
+//! The X side of carrying X clients' drags in Wayland drags (see `server/xdrag.rs`): noticing
+//! that an X client started one, converting its XdndSelection for Wayland clients, and being its
+//! XDND target while the drag is over a Wayland client.
+use super::selection::Selection;
+use super::{Atoms, XState};
+use crate::RealServerState;
+use crate::server::xdrag::XDragEvent;
+use log::{debug, warn};
+use std::rc::Rc;
+use xcb::{Xid, x};
+
+pub(super) struct XDragBridge {
+    /// Where XdndSelection's conversions arrive.
+    requestor: x::Window,
+    /// Shown above every X window while the drag is over a Wayland client, so that the X client
+    /// has satellite as its XDND target there rather than whatever X window is at the pointer's
+    /// position on the X screen.
+    proxy: x::Window,
+    proxy_shown: bool,
+    targets_property: x::Atom,
+    /// Targets that make the owner do something rather than give data.
+    side_effect_targets: [x::Atom; 2],
+    /// An X client took XdndSelection without an XdndTypeList: its TARGETS are on their way.
+    awaiting_targets: Option<u32>,
+    drag: Option<Drag>,
+}
+
+struct Drag {
+    selection: Rc<Selection>,
+    /// The X client's window in XDND conversation with the proxy.
+    peer: Option<x::Window>,
+    wayland_accepts: bool,
+    /// The X client dropped on the proxy.
+    dropped: bool,
+    /// How the Wayland drag ended, once it has: whether a Wayland client took the data.
+    ended: Option<bool>,
+}
+
+impl XDragBridge {
+    pub fn new(connection: &xcb::Connection, root: x::Window, atoms: &Atoms) -> Self {
+        let create = |window, event_mask| {
+            connection
+                .send_and_check_request(&x::CreateWindow {
+                    wid: window,
+                    width: 1,
+                    height: 1,
+                    depth: 0,
+                    parent: root,
+                    x: 0,
+                    y: 0,
+                    border_width: 0,
+                    class: x::WindowClass::InputOnly,
+                    visual: x::COPY_FROM_PARENT,
+                    value_list: &[x::Cw::OverrideRedirect(true), x::Cw::EventMask(event_mask)],
+                })
+                .expect("Couldn't create window for X drags");
+        };
+        let requestor = connection.generate_id();
+        create(requestor, x::EventMask::PROPERTY_CHANGE);
+        let proxy = connection.generate_id();
+        create(proxy, x::EventMask::empty());
+        connection
+            .send_and_check_request(&x::ChangeProperty {
+                mode: x::PropMode::Replace,
+                window: proxy,
+                property: atoms.xdnd_aware,
+                r#type: x::ATOM_ATOM,
+                data: &[5u32],
+            })
+            .expect("Couldn't make the X drag proxy XdndAware");
+        let intern = |name: &[u8]| {
+            connection
+                .wait_for_reply(connection.send_request(&x::InternAtom {
+                    only_if_exists: false,
+                    name,
+                }))
+                .expect("Couldn't intern atoms for X drags")
+                .atom()
+        };
+        Self {
+            requestor,
+            proxy,
+            proxy_shown: false,
+            targets_property: intern(b"_XDND_TARGETS"),
+            side_effect_targets: [intern(b"DELETE"), intern(b"TIMESTAMP")],
+            awaiting_targets: None,
+            drag: None,
+        }
+    }
+
+    fn owns(&self, window: x::Window) -> bool {
+        window == self.requestor || window == self.proxy
+    }
+}
+
+impl XState {
+    fn send_to_peer(&self, peer: x::Window, r#type: x::Atom, data: [u32; 4]) {
+        let event = x::ClientMessageEvent::new(
+            peer,
+            r#type,
+            x::ClientMessageData::Data32([
+                self.x_drag.proxy.resource_id(),
+                data[0],
+                data[1],
+                data[2],
+                data[3],
+            ]),
+        );
+        if let Err(e) = self.connection.send_and_check_request(&x::SendEvent {
+            propagate: false,
+            destination: x::SendEventDest::Window(peer),
+            event_mask: x::EventMask::empty(),
+            event: &event,
+        }) {
+            warn!("Failed to answer the X drag: {e:?}");
+        }
+    }
+
+    fn copy_if(&self, yes: bool) -> u32 {
+        if yes {
+            self.atoms.xdnd_action_copy.resource_id()
+        } else {
+            0
+        }
+    }
+
+    fn send_status(&self) {
+        let Some(drag) = &self.x_drag.drag else {
+            return;
+        };
+        let Some(peer) = drag.peer else {
+            return;
+        };
+        let accepts = drag.wayland_accepts;
+        // Bit 1: send a position for every move, since the proxy covers everything.
+        self.send_to_peer(
+            peer,
+            self.atoms.xdnd_status,
+            [accepts as u32 | 2, 0, 0, self.copy_if(accepts)],
+        );
+    }
+
+    /// Answer the X client's drop on the proxy, once the Wayland drag has ended.
+    fn finish_proxy_drop(&mut self) {
+        let Some(drag) = &self.x_drag.drag else {
+            return;
+        };
+        let (Some(peer), true, Some(finished)) = (drag.peer, drag.dropped, drag.ended) else {
+            return;
+        };
+        self.send_to_peer(
+            peer,
+            self.atoms.xdnd_finished,
+            [finished as u32, self.copy_if(finished), 0, 0],
+        );
+        debug!("X drag over a Wayland client finished ({finished})");
+        self.x_drag.drag = None;
+    }
+
+    fn show_proxy(&mut self, shown: bool) {
+        if self.x_drag.proxy_shown == shown {
+            return;
+        }
+        self.x_drag.proxy_shown = shown;
+        let proxy = self.x_drag.proxy;
+        let result = if shown {
+            let geometry =
+                self.connection
+                    .wait_for_reply(self.connection.send_request(&x::GetGeometry {
+                        drawable: x::Drawable::Window(self.root),
+                    }));
+            let (width, height) = geometry
+                .map(|g| (g.width().into(), g.height().into()))
+                .unwrap_or((u16::MAX.into(), u16::MAX.into()));
+            self.connection
+                .send_and_check_request(&x::ConfigureWindow {
+                    window: proxy,
+                    value_list: &[
+                        x::ConfigWindow::X(0),
+                        x::ConfigWindow::Y(0),
+                        x::ConfigWindow::Width(width),
+                        x::ConfigWindow::Height(height),
+                        x::ConfigWindow::StackMode(x::StackMode::Above),
+                    ],
+                })
+                .and_then(|()| {
+                    self.connection
+                        .send_and_check_request(&x::MapWindow { window: proxy })
+                })
+        } else {
+            self.connection
+                .send_and_check_request(&x::UnmapWindow { window: proxy })
+        };
+        if let Err(e) = result {
+            warn!("Failed to show or hide the X drag proxy: {e:?}");
+        }
+    }
+
+    fn begin_x_drag(&mut self, targets: &[x::Atom], time: u32, server_state: &mut RealServerState) {
+        // A Wayland target asking for DELETE would have the X client delete what it dragged.
+        let targets: Vec<x::Atom> = targets
+            .iter()
+            .copied()
+            .filter(|t| !self.x_drag.side_effect_targets.contains(t))
+            .collect();
+        let selection = Rc::new(Selection::new(
+            &self.connection,
+            &self.atoms,
+            self.x_drag.requestor,
+            self.atoms.xdnd_selection,
+            time,
+            &targets,
+        ));
+        if server_state.start_x_drag(&selection) {
+            self.x_drag.drag = Some(Drag {
+                selection,
+                peer: None,
+                wayland_accepts: false,
+                dropped: false,
+                ended: None,
+            });
+        }
+    }
+
+    /// An X client took XdndSelection while a button is held on one of our windows: the start
+    /// of its drag.
+    fn x_drag_selection_owner(
+        &mut self,
+        owner: x::Window,
+        time: u32,
+        server_state: &mut RealServerState,
+    ) {
+        if owner.is_none()
+            || self.x_drag.owns(owner)
+            || owner == self.dnd.window
+            || server_state.x_drag_pointer().is_some()
+            || !server_state.has_pointer_press()
+        {
+            return;
+        }
+        let types = self
+            .connection
+            .wait_for_reply(self.connection.send_request(&x::GetProperty {
+                delete: false,
+                window: owner,
+                property: self.atoms.xdnd_type_list,
+                r#type: x::ATOM_ATOM,
+                long_offset: 0,
+                long_length: 256,
+            }));
+        match types {
+            Ok(reply) if !reply.value::<x::Atom>().is_empty() => {
+                let targets = reply.value::<x::Atom>().to_vec();
+                self.begin_x_drag(&targets, time, server_state);
+            }
+            // Up to three types may be named only in XdndEnter, which goes to X targets alone.
+            _ => {
+                if let Err(e) = self
+                    .connection
+                    .send_and_check_request(&x::ConvertSelection {
+                        requestor: self.x_drag.requestor,
+                        selection: self.atoms.xdnd_selection,
+                        target: self.atoms.targets,
+                        property: self.x_drag.targets_property,
+                        time,
+                    })
+                {
+                    warn!("Couldn't ask the X drag for its types: {e:?}");
+                    return;
+                }
+                self.x_drag.awaiting_targets = Some(time);
+            }
+        }
+    }
+
+    pub(super) fn handle_x_drag_event(
+        &mut self,
+        event: &xcb::Event,
+        server_state: &mut RealServerState,
+    ) -> bool {
+        match event {
+            xcb::Event::XFixes(xcb::xfixes::Event::SelectionNotify(e))
+                if e.selection() == self.atoms.xdnd_selection =>
+            {
+                if e.subtype() == xcb::xfixes::SelectionEvent::SetSelectionOwner {
+                    self.x_drag_selection_owner(e.owner(), e.timestamp(), server_state);
+                }
+                true
+            }
+            xcb::Event::X(x::Event::SelectionNotify(e))
+                if e.requestor() == self.x_drag.requestor =>
+            {
+                if e.target() == self.atoms.targets {
+                    let Some(time) = self.x_drag.awaiting_targets.take() else {
+                        return true;
+                    };
+                    let targets = if e.property() == x::ATOM_NONE {
+                        Vec::new()
+                    } else {
+                        self.connection
+                            .wait_for_reply(self.connection.send_request(&x::GetProperty {
+                                delete: true,
+                                window: self.x_drag.requestor,
+                                property: e.property(),
+                                r#type: x::ATOM_ATOM,
+                                long_offset: 0,
+                                long_length: 256,
+                            }))
+                            .map(|r| r.value::<x::Atom>().to_vec())
+                            .unwrap_or_default()
+                    };
+                    self.begin_x_drag(&targets, time, server_state);
+                } else if let Some(drag) = &self.x_drag.drag {
+                    if e.property() == x::ATOM_NONE {
+                        drag.selection.next_conversion();
+                    } else {
+                        drag.selection.handle_notify(e.target());
+                    }
+                }
+                true
+            }
+            xcb::Event::X(x::Event::PropertyNotify(e)) if e.window() == self.x_drag.requestor => {
+                if let Some(drag) = &self.x_drag.drag {
+                    if e.state() == x::Property::NewValue {
+                        drag.selection.check_for_incr(e);
+                    }
+                }
+                true
+            }
+            xcb::Event::X(x::Event::ClientMessage(e)) if e.window() == self.x_drag.proxy => {
+                let x::ClientMessageData::Data32(data) = e.data() else {
+                    return true;
+                };
+                let source = <x::Window as xcb::XidNew>::new(data[0]);
+                let Some(drag) = &mut self.x_drag.drag else {
+                    return true;
+                };
+                let r#type = e.r#type();
+                if r#type == self.atoms.xdnd_enter {
+                    debug!("X drag entered the proxy from {source:?}");
+                    drag.peer = Some(source);
+                    drag.dropped = false;
+                } else if r#type == self.atoms.xdnd_position {
+                    drag.peer = Some(source);
+                    self.send_status();
+                } else if r#type == self.atoms.xdnd_leave {
+                    drag.peer = None;
+                    if drag.ended.is_some() {
+                        self.x_drag.drag = None;
+                    }
+                } else if r#type == self.atoms.xdnd_drop {
+                    debug!("X drag dropped on the proxy");
+                    drag.peer = Some(source);
+                    drag.dropped = true;
+                    self.finish_proxy_drop();
+                }
+                true
+            }
+            // Our own windows aren't windows to manage.
+            xcb::Event::X(x::Event::CreateNotify(e)) => self.x_drag.owns(e.window()),
+            xcb::Event::X(x::Event::MapNotify(e)) => self.x_drag.owns(e.window()),
+            xcb::Event::X(x::Event::UnmapNotify(e)) => self.x_drag.owns(e.window()),
+            xcb::Event::X(x::Event::ConfigureNotify(e)) => self.x_drag.owns(e.window()),
+            xcb::Event::X(x::Event::DestroyNotify(e)) => self.x_drag.owns(e.window()),
+            _ => false,
+        }
+    }
+
+    pub(crate) fn handle_x_drag(&mut self, server_state: &mut RealServerState) {
+        for event in server_state.take_x_drag_events() {
+            match event {
+                XDragEvent::OverX {
+                    surface,
+                    window,
+                    x,
+                    y,
+                    time,
+                } => {
+                    // The X client looks for its target at the pointer's position on the X
+                    // screen: the window under the drag has to be the topmost one there.
+                    self.show_proxy(false);
+                    if let Err(e) = self.connection.send_and_check_request(&x::ConfigureWindow {
+                        window,
+                        value_list: &[x::ConfigWindow::StackMode(x::StackMode::Above)],
+                    }) {
+                        debug!("Couldn't raise {window:?} under the X drag: {e:?}");
+                    }
+                    server_state.x_drag_pointer_to(surface, x, y, time);
+                }
+                XDragEvent::OverWayland => {
+                    debug!("X drag over a Wayland client");
+                    self.show_proxy(true);
+                    server_state.x_drag_nudge();
+                }
+                XDragEvent::WaylandAccepts(accepts) => {
+                    debug!("Wayland client accepts the X drag: {accepts}");
+                    if let Some(drag) = &mut self.x_drag.drag {
+                        drag.wayland_accepts = accepts;
+                    }
+                    self.send_status();
+                }
+                XDragEvent::DroppedOnX | XDragEvent::DroppedOnWayland => {
+                    debug!("X drag dropped");
+                    server_state.x_drag_release();
+                }
+                XDragEvent::Ended { finished } => {
+                    debug!("X drag's Wayland drag ended (finished: {finished})");
+                    server_state.x_drag_end();
+                    self.show_proxy(false);
+                    match &mut self.x_drag.drag {
+                        Some(drag) if drag.peer.is_some() => {
+                            drag.ended = Some(finished);
+                            self.finish_proxy_drop();
+                        }
+                        _ => self.x_drag.drag = None,
+                    }
+                }
+            }
+        }
+    }
+}
