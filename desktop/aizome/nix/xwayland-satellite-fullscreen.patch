+#[test]
+fn fullscreen_requests_before_role_creation() {
+    for (requests, expected) in [
+        (vec![SetState::Add], true),
+        (vec![SetState::Remove], false),
+        (vec![SetState::Add, SetState::Remove], false),
+        (vec![SetState::Toggle], true),
+        (vec![SetState::Toggle, SetState::Toggle], false),
+    ] {
+        let (mut f, comp) = TestFixture::new_with_compositor();
+        let win = Window::new(1);
+        let (buffer, surface) = comp.create_surface();
+        f.new_window(win, false, WindowData::default());
+        for request in requests {
+            f.satellite.set_fullscreen(win, request);
+        }
+        f.map_window(&comp, win, &surface.obj, &buffer);
+        f.run();
+        let id = f.check_new_surface();
+        assert_eq!(
+            f.testwl
+                .get_surface_data(id)
+                .unwrap()
+                .toplevel()
+                .states
+                .contains(&xdg_toplevel::State::Fullscreen),
+            expected
+        );
+    }
+}
+
+#[test]
+fn keyboard_focus_restores_minimized_windows_in_every_focus_model() {
+    // SDL and Wine advertise WM_TAKE_FOCUS; they must see the restoration too.
+    for take_focus in [false, true] {
+        let (mut f, comp) = TestFixture::new_with_compositor();
+        let win = Window::new(1);
+        let (buffer, surface) = comp.create_surface();
+        let data = WindowData {
+            mapped: true,
+            dims: WindowDims {
+                width: 50,
+                height: 50,
+                ..Default::default()
+            },
+            ..Default::default()
+        };
+        f.new_window(win, false, data);
+        f.satellite.set_take_focus(win, take_focus);
+        f.map_window(&comp, win, &surface.obj, &buffer);
+        f.run();
+        let id = f.check_new_surface();
+        f.testwl.configure_toplevel(id, 50, 50, vec![]);
+        f.run();
+        // As after WM_CHANGE_STATE: testwl has no set_minimized handler.
+        f.satellite.connection.set_minimized(win, true);
+        f.testwl.focus_toplevel(id);
+        f.run();
+        assert!(
+            !f.connection().minimized.contains(&win),
+            "take_focus={take_focus}"
+        );
+    }
+}
