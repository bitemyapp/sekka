diff --git a/src/server/emulation.rs b/src/server/emulation.rs
new file mode 100644
index 0000000..f904eb6
--- /dev/null
+++ b/src/server/emulation.rs
@@ -0,0 +1,126 @@
+//! Xwayland's per-client RandR mode is distinct from the physical output mode.
+//! Keep the X drawable at the requested resolution and scale its viewport to
+//! the fullscreen configure. Satellite owns the viewport, so Xwayland cannot
+//! perform this scaling itself (it runs with -force-xrandr-emulation).
+use super::*;
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) struct EmulatedMode {
+    x: i32,
+    y: i32,
+    width: u16,
+    height: u16,
+}
+
+impl EmulatedMode {
+    pub(crate) fn parse(values: &[u32]) -> Vec<Self> {
+        if !values.chunks_exact(4).remainder().is_empty() {
+            return Vec::new();
+        }
+        values
+            .chunks_exact(4)
+            .filter_map(|v| {
+                let width = u16::try_from(v[2]).ok().filter(|v| *v > 0)?;
+                let height = u16::try_from(v[3]).ok().filter(|v| *v > 0)?;
+                Some(Self {
+                    x: v[0] as i32,
+                    y: v[1] as i32,
+                    width,
+                    height,
+                })
+            })
+            .collect()
+    }
+}
+
+pub(super) fn mode(win: &WindowData, role: &SurfaceRole) -> Option<(u16, u16)> {
+    let SurfaceRole::Toplevel(Some(t)) = role else {
+        return None;
+    };
+    if !t.fullscreen || t.fullscreen_size.is_none() {
+        return None;
+    }
+    win.attrs
+        .emulated_modes
+        .iter()
+        .find(|m| m.x == win.output_offset.x && m.y == win.output_offset.y)
+        .map(|m| (m.width, m.height))
+}
+
+// Track the surface rather than copying its scale into input devices. A mode
+// can change while the pointer remains inside the window or stays locked.
+#[derive(Clone, Copy)]
+pub(super) struct InputSurface(pub Entity);
+
+pub(super) fn input_scale(world: &hecs::World, entity: Entity) -> (f64, f64) {
+    let factor = world
+        .get::<&SurfaceScaleFactor>(entity)
+        .map(|s| s.0)
+        .unwrap_or(1.0);
+    if let Ok(mut q) = world.query_one::<(&WindowData, &SurfaceRole)>(entity) {
+        if let Some((win, role)) = q.get() {
+            if let (Some((w, h)), SurfaceRole::Toplevel(Some(t))) = (mode(win, role), role) {
+                let (width, height) = t.fullscreen_size.unwrap();
+                return (w as f64 / width as f64, h as f64 / height as f64);
+            }
+        }
+    }
+    (factor, factor)
+}
+
+impl<S: X11Selection + 'static> InnerServerState<S> {
+    pub(crate) fn set_emulated_modes(&mut self, window: x::Window, modes: Vec<EmulatedMode>) {
+        let Some(&entity) = self.windows.get(&window) else {
+            return;
+        };
+        let data = self.world.entity(entity).unwrap();
+        let mut win = data.get::<&mut WindowData>().unwrap();
+        if win.attrs.emulated_modes == modes {
+            return;
+        }
+        win.attrs.emulated_modes = modes;
+        let Some(role) = data.get::<&SurfaceRole>() else {
+            return;
+        };
+        let SurfaceRole::Toplevel(Some(t)) = &*role else {
+            return;
+        };
+        let Some((width, height)) = t.fullscreen_size.filter(|_| t.fullscreen) else {
+            return;
+        };
+        let factor = data.get::<&SurfaceScaleFactor>().unwrap().0;
+        let (width, height) = mode(&win, &role).unwrap_or((
+            (width as f64 * factor) as u16,
+            (height as f64 * factor) as u16,
+        ));
+        win.attrs.dims.width = width;
+        win.attrs.dims.height = height;
+        let pending = PendingSurfaceState {
+            x: win.output_offset.x,
+            y: win.output_offset.y,
+            width: width as _,
+            height: height as _,
+        };
+        drop(win);
+        drop(role);
+        self.world.insert_one(entity, pending).unwrap();
+        update_surface_viewport(&self.world, self.world.query_one(entity).unwrap());
+        self.world
+            .get::<&client::wl_surface::WlSurface>(entity)
+            .unwrap()
+            .commit();
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn malformed_modes_are_not_used_as_drawable_sizes() {
+        assert!(EmulatedMode::parse(&[0, 0, 1920]).is_empty());
+        assert!(EmulatedMode::parse(&[0, 0, 0, 1080, 0, 0, 65536, 1080]).is_empty());
+        let modes = EmulatedMode::parse(&[(-1920i32) as u32, 0, 1920, 1080, 0, 0, 800, 600]);
+        assert_eq!(modes.len(), 2);
+        assert_eq!(modes[0].x, -1920);
+    }
+}
