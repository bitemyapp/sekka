# Experiment, not used by any package, system or check: Aizome's compositor
# built with one Nix derivation per crate, the granularity Bazel's rules_rust
# uses, to measure what that costs and saves against ../package.nix, which
# builds the whole workspace in one derivation (README.md).
#
# Cargo.nix is generated by crate2nix from the workspace's Cargo.lock;
# nixpkgs' buildRustCrate compiles each crate with rustc directly, and
# ./overrides.nix supplies what Cargo would have found on its own (system
# libraries for -sys crates, tools for build scripts).
{
  pkgs,
  # A string that changes every derivation here and nothing they build: a
  # fresh graph to time cold builds against.
  salt ? "",
}:
let
  salted = lib.optionalAttrs (salt != "") { PERCRATE_SALT = salt; };
  inherit (pkgs) lib;
  overrides = import ./overrides.nix {
    inherit pkgs;
    inherit (cargoNix.internal) crates;
  };
  # Cargo's release profile in ../../Cargo.toml: optimised (buildRustCrate's
  # default), four codegen units, line tables only.
  buildRustCrateForPkgs =
    pkgs: args:
    (pkgs.buildRustCrate.override {
      defaultCrateOverrides = pkgs.defaultCrateOverrides // overrides;
    })
      (
        args
        // {
          codegenUnits = 4;
          extraRustcOpts = (args.extraRustcOpts or [ ]) ++ [ "-C debuginfo=line-tables-only" ];
        }
        // salted
      );
  cargoNix = import ./Cargo.nix { inherit pkgs buildRustCrateForPkgs; };
  members = cargoNix.workspaceMembers;
  # ../default.nix's sources, for the single-derivation baseline.
  src = lib.fileset.toSource {
    root = ../..;
    fileset = lib.fileset.unions [
      ../../Cargo.toml
      ../../Cargo.lock
      ../../crates
      ../../icons
      ../../etc
      ../../scripts
      ../../sukumo/Cargo.toml
      ../../sukumo/crates
      (lib.fileset.maybeMissing ../../apps)
      (lib.fileset.maybeMissing ../../session)
    ];
  };
  yukimiSrc = lib.fileset.toSource {
    root = ../../../../apps/yukimi;
    fileset = lib.fileset.unions [
      ../../../../apps/yukimi/Cargo.toml
      ../../../../apps/yukimi/crates
    ];
  };
  hotaruSrc = lib.fileset.toSource {
    root = ../../../../apps/hotaru;
    fileset = lib.fileset.unions [
      ../../../../apps/hotaru/Cargo.toml
      ../../../../apps/hotaru/crates
      ../../../../apps/hotaru/resources
      ../../../../apps/hotaru/vendor/simdutf8
    ];
  };
in
{
  inherit cargoNix;
  # The `aizome` binary and the core dylib it links.
  compositor = members.aizome-comp.build;
  # The hot-swapped logic library, which links the same core.
  logic = members.aizome-comp-logic.build;
  # Every workspace member, each crate its own derivation: the whole of
  # what ../package.nix compiles (evaluated for its cost, not built).
  workspace = cargoNix.allWorkspaceMembers;
  # The same two packages in one derivation and one Cargo run.
  monolithic = (pkgs.callPackage ./monolithic.nix { inherit src yukimiSrc hotaruSrc; }).overrideAttrs salted;
}
