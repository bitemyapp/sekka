 pub use sidestep_engine::protocol::Op as RecordedOp;
 pub use sidestep_engine::gpu_scene::{Prepare as GpuPrepare, Scene as GpuScene, Fallback as GpuFallback};
 
+/// Profiling-only cached CPU state, matching the current full-damage banded raster path.
+#[derive(Default)]
+pub struct CpuRaster { glyphs: Glyphs, pixels:Vec<u32> }
 impl RecordedFrame {
+    pub fn profile_cpu(&self, state:&mut CpuRaster)->(u128,Vec<u8>) {
+        state.pixels.resize(self.width as usize*self.height as usize,0);
+        let rect=protocol::Rect::new(0.,0.,self.width as f32/self.scale as f32,self.height as f32/self.scale as f32);
+        let started=std::time::Instant::now();
+        // Recorded complete scenes start on a transparent destination, including
+        // popup shadow pixels. Include clearing in the CPU work being measured.
+        state.pixels.fill(0);
+        let mut canvas=raster::Canvas::new(&mut state.pixels,self.width,self.height,0.,self.scale as f32);
+        raster::bands::paint_banded(&mut canvas,&mut state.glyphs,&[rect],&self.ops);
+        let elapsed=started.elapsed().as_nanos();
+        (elapsed,state.pixels.iter().flat_map(|v|v.to_ne_bytes()).collect())
+    }
+
     pub fn prepare_gpu(&self, prepare:&mut GpuPrepare)->Result<GpuScene,GpuFallback> {
         prepare.prepare(self.width,self.height,self.scale as f32,&self.ops)
     }
