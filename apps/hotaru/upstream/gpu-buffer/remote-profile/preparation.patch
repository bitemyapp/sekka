+mod index_equivalence {
+    use super::*;
+    #[test]
+    fn contiguous_index_is_identical_to_ordered_per_tile_reference() {
+        let mut random=0x74a80152u32;
+        let mut next=||{random^=random<<13;random^=random>>17;random^=random<<5;random};
+        for _ in 0..300 {
+            let w=1+next()%256;let h=1+next()%256;let cols=w.div_ceil(TILE);let rows=h.div_ceil(TILE);
+            let mut s=Scene{width:w,height:h,commands:Vec::new(),assets:Vec::new(),tiles:Vec::new(),indices:Vec::new()};
+            let mut reference=vec![Vec::new();(cols*rows)as usize];
+            for index in 0..100u32 {
+                let a=next()%w;let b=next()%h;let x=a+1+next()%(w-a);let y=b+1+next()%(h-b);
+                s.commands.push(Command{bounds:[a,b,x,y],kind:1,solid:0,alpha:255,asset:None,origin:[0,0]});
+                for ty in b/TILE..=(y-1)/TILE{for tx in a/TILE..=(x-1)/TILE{reference[(ty*cols+tx)as usize].push(index);}}
+            }
+            s.index_tiles(&||false).unwrap();
+            for (bounds,expected)in s.tiles.iter().zip(reference){assert_eq!(&s.indices[bounds[0]as usize..(bounds[0]+bounds[1])as usize],expected);}
+        }
+    }
