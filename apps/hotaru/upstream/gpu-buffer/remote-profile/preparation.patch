+#[cfg(test)]
+mod cancellation_tests {
+    use super::*;
+    use std::cell::Cell;
+    #[test]
+    fn cancelled_preparation_publishes_nothing_and_next_job_succeeds() {
+        let mut prepare=Prepare::default();
+        let ops=vec![Op::Fill {rect:Rect::new(0.,0.,128.,128.),color:[1.,0.,0.,1.]};64];
+        for limit in [0,8,70,140,200] {
+            let calls=Cell::new(0);
+            let cancelled=||{let n=calls.get();calls.set(n+1);n>=limit};
+            assert!(matches!(prepare.prepare_cancellable(128,128,1.,&ops,&cancelled),Err(Fallback::Cancelled)));
+            assert!(calls.get()<=limit+2);
+            let scene=prepare.prepare(128,128,1.,&ops).unwrap();
+            assert_eq!(scene.interpret(),vec![255,0,0,255].repeat(128*128));
+        }
+    }
+    #[test]
+    fn huge_tile_expansion_can_cancel_within_one_command() {
+        let calls=Cell::new(0);
+        let mut prepare=Prepare::default();
+        let op=Op::Fill {rect:Rect::new(0.,0.,8192.,8192.),color:[1.,1.,1.,1.]};
+        assert!(matches!(prepare.prepare_cancellable(8192,8192,1.,&[op],&||{let n=calls.get();calls.set(n+1);n>=20}),Err(Fallback::Cancelled)));
+        assert_eq!(calls.get(),21);
+    }
+}
