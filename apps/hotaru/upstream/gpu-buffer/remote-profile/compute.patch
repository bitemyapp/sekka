+impl Driver<Scene> for SceneDriver {
+    type Resource = EglResource;
+    fn render(
+        &mut self,
+        frame: &Frame<Scene>,
+        cancelled: &Cancellation,
+    ) -> Result<(EglResource, Descriptor), RenderError> {
+        let (resource, descriptor) =
+            self.render_scene(&frame.source, Some(cancelled), true, true)?;
+        Ok((resource, descriptor.expect("required export checked")))
+    }
+}
+
+fn reset_atlas(used: usize, entries: usize, additional: usize, new_entries: usize) -> bool {
+    used.checked_add(additional).is_none_or(|n| n > ATLAS)
+        || entries
+            .checked_add(new_entries)
+            .is_none_or(|n| n > MAX_CACHED_ASSETS)
+}
+#[cfg(test)]
+mod atlas_tests {
+    use super::*;
+    #[test]
+    fn tiny_assets_cannot_accumulate_unbounded_metadata() {
+        assert!(!reset_atlas(32768, 8192, 0, 0));
+        assert!(reset_atlas(32768, 8192, 4, 1));
+        assert!(reset_atlas(0, usize::MAX, 0, 1));
+        assert!(reset_atlas(usize::MAX, 0, 4, 0));
+        assert!(!reset_atlas(ATLAS - 4, 1, 4, 1));
+        assert!(reset_atlas(ATLAS - 4, 1, 8, 1));
+    }
+}
