@@ -0,0 +1,49 @@
+mod egl;
+mod scene;
+use std::{path::Path, time::Instant};
+fn main() -> Result<(), String> {
+    let args: Vec<_> = std::env::args().collect();
+    if args.len() != 5 {
+        return Err(
+            "usage: scene-phase-probe LIBEGL SCENE_OR_DIRECTORY REPEATS attempt|skip".into(),
+        );
+    }
+    let repeats: usize = args[3].parse().map_err(|_| "repeats")?;
+    if repeats == 0 || repeats > 100 {
+        return Err("repeats bounds".into());
+    }
+    let attempt = match args[4].as_str() {
+        "attempt" => true,
+        "skip" => false,
+        _ => return Err("export policy".into()),
+    };
+    let lib = args[1].clone();
+    let path = Path::new(&args[2]);
+    let mut paths = if path.is_dir() {
+        std::fs::read_dir(path)
+            .map_err(|e| e.to_string())?
+            .filter_map(Result::ok)
+            .map(|p| p.path())
+            .filter(|p| p.extension().is_some_and(|e| e == "scene"))
+            .collect::<Vec<_>>()
+    } else {
+        vec![path.to_owned()]
+    };
+    paths.sort();
+    if paths.is_empty() || paths.len() > 64 {
+        return Err("fixture count".into());
+    }
+    // This standalone diagnostic has no UI or Wayland event owner. Driver and
+    // all resources are constructed/destroyed within this dedicated worker;
+    // joining it here is diagnostic process completion, not a product API.
+    std::thread::spawn(move || ->Result<(),String>{
+        let start=Instant::now();
+        let mut driver=egl::SceneDriver::new(&lib,"egl-device-index:0",None)?;
+        println!("{}",serde_json::json!({"event":"profile_driver_ready","setup_ns":start.elapsed().as_nanos(),"export_policy":if attempt{"attempt"}else{"skip"}}));
+        for path in paths {let scene=scene::Scene::load(&path)?;for iteration in 0..repeats{
+            println!("{}",serde_json::json!({"event":"profile_iteration","scene":scene.name(),"iteration":iteration,"source_bytes":scene.bytes()}));
+            driver.profile_offscreen(&scene,attempt).map_err(|e|format!("{e:?}"))?;
+        }}
+        drop(driver);println!("{}",serde_json::json!({"event":"profile_complete","offscreen_only":true}));Ok(())
+    }).join().map_err(|_|"worker panic".to_owned())?
+}
