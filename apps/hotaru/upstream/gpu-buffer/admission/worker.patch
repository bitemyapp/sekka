+//! GPU cache/staging and output reservations over the same CPU/source budget.
+#![forbid(unsafe_code)]
+use crate::{
+    Cancellation, Descriptor, Driver, FallbackReason, Frame, RenderError,
+    budget::{Accounted, Budget, Reservation},
+};
+/// Fixed cache/metadata/staging allowance is reserved before driver construction.
+/// The resource reservation survives until the driver's authoritative release.
+/// Graphics-driver internal allocator/OS storage remains outside this logical cap.
+pub struct Reserved<D> {
+    driver: D,
+    budget: Budget,
+    _fixed: Reservation,
+}
+impl<D> Reserved<D> {
+    pub fn new(
+        budget: Budget,
+        fixed_bytes: usize,
+        make: impl FnOnce() -> Result<D, String>,
+    ) -> Result<Self, String> {
+        let fixed = budget
+            .reserve(fixed_bytes)
+            .map_err(|_| "driver fixed storage allowance")?;
+        let driver = make()?;
+        Ok(Self {
+            driver,
+            budget,
+            _fixed: fixed,
+        })
+    }
+}
+impl<F, D: Driver<F>> Driver<F> for Reserved<D> {
+    type Resource = Accounted<D::Resource>;
+    fn render(
+        &mut self,
+        frame: &Frame<F>,
+        cancel: &Cancellation,
+    ) -> Result<(Self::Resource, Descriptor), RenderError> {
+        if cancel.is_cancelled() {
+            return Err(RenderError::Cancelled);
+        }
+        let charge = self
+            .budget
+            .reserve(frame.buffer_bytes)
+            .map_err(|_| RenderError::Fallback(FallbackReason::Admission))?;
+        let (resource, descriptor) = self.driver.render(frame, cancel)?;
+        Ok((Accounted::new(resource, charge), descriptor))
+    }
+}
