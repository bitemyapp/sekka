+//! Independent CPU-worker output: premultiplied pixels → size-sealed memfd, immutable by ownership.
+//! All allocation, rasterization and file writes execute inside Driver::render.
+#![forbid(unsafe_code)]
+use crate::{
+    Cancellation, Descriptor, Driver, FallbackReason, Frame, RenderError,
+    budget::{Accounted, Budget, Reservation},
+};
+use rustix::fs::{MemfdFlags, SealFlags, fcntl_add_seals, memfd_create};
+use std::{fs::File, io::Write, os::fd::OwnedFd};
+
+/// An implementation must paint the complete frame in RGBA byte-order u32s.
+/// The initialized destination is transparent. Check cancellation between bounded
+/// raster batches; never interpret this as an incremental framebuffer.
+pub trait Raster<F> {
+    fn dimensions(&self, source: &F) -> (u32, u32);
+    fn paint(
+        &mut self,
+        source: &F,
+        pixels: &mut [u32],
+        cancel: &Cancellation,
+    ) -> Result<(), RenderError>;
+}
+pub struct Cpu<R> {
+    raster: R,
+    budget: Budget,
+}
+pub struct Buffer {
+    _storage: Accounted<File>,
+}
+impl<R> Cpu<R> {
+    pub fn new(raster: R, budget: Budget) -> Self {
+        Self { raster, budget }
+    }
+}
+fn refusal() -> RenderError {
+    RenderError::Fallback(FallbackReason::Admission)
+}
+fn failed(error: impl std::fmt::Display) -> RenderError {
+    RenderError::Failed(error.to_string())
+}
+impl<F, R: Raster<F>> Driver<F> for Cpu<R> {
+    type Resource = Buffer;
+    fn render(
+        &mut self,
+        frame: &Frame<F>,
+        cancel: &Cancellation,
+    ) -> Result<(Buffer, Descriptor), RenderError> {
+        if cancel.is_cancelled() {
+            return Err(RenderError::Cancelled);
+        }
+        let (width, height) = self.raster.dimensions(&frame.source);
+        let bytes = (width as usize)
+            .checked_mul(height as usize)
+            .and_then(|n| n.checked_mul(4))
+            .ok_or_else(refusal)?;
+        if width == 0 || height == 0 || width > 8192 || height > 8192 || bytes > frame.buffer_bytes
+        {
+            return Err(refusal());
+        }
+        // Both staging and the file are admitted before either allocation; a
+        // resize cannot borrow the charge belonging to an unreleased old buffer.
+        let stage_charge = self.budget.reserve(bytes).map_err(|_| refusal())?;
+        let file_charge = self.budget.reserve(bytes).map_err(|_| refusal())?;
+        let mut pixels = Vec::new();
+        pixels.try_reserve_exact(bytes / 4).map_err(|_| refusal())?;
+        pixels.resize(bytes / 4, 0);
+        let mut pixels = Accounted::new(pixels, stage_charge);
+        self.raster.paint(&frame.source, pixels.get_mut(), cancel)?;
+        if cancel.is_cancelled() {
+            return Err(RenderError::Cancelled);
+        }
+        let (resource, fd) = write_sealed(pixels.get(), file_charge, cancel)?;
+        Ok((
+            resource,
+            Descriptor {
+                fd,
+                width,
+                height,
+                stride: width * 4,
+                offset: 0,
+                fourcc: u32::from_le_bytes(*b"AR24"),
+                modifier: 0,
+            },
+        ))
+    }
+}
+fn write_sealed(
+    pixels: &[u32],
+    charge: Reservation,
+    cancel: &Cancellation,
+) -> Result<(Buffer, OwnedFd), RenderError> {
+    let fd = memfd_create(
+        c"hotaru-whole-frame",
+        MemfdFlags::CLOEXEC | MemfdFlags::ALLOW_SEALING,
+    )
+    .map_err(failed)?;
+    // Own the accounting alongside the file even on all partial-write failures.
+    let mut storage = Accounted::new(File::from(fd), charge);
+    let mut encoded = [0u8; 16 * 1024];
+    for chunk in pixels.chunks(encoded.len() / 4) {
+        if cancel.is_cancelled() {
+            return Err(RenderError::Cancelled);
+        }
+        for (p, out) in chunk.iter().zip(encoded.chunks_exact_mut(4)) {
+            let [r, g, b, a] = p.to_ne_bytes();
+            out.copy_from_slice(&[b, g, r, a]);
+        }
+        storage
+            .get_mut()
+            .write_all(&encoded[..chunk.len() * 4])
+            .map_err(failed)?;
+    }
+    // wl_shm servers may mmap PROT_WRITE even when only reading. WRITE/FUTURE_WRITE
+    // seals would make valid import fail. Private worker ownership forbids further
+    // writes; size seals prevent resizing/SIGBUS until authoritative release.
+    fcntl_add_seals(
+        storage.get(),
+        SealFlags::GROW | SealFlags::SHRINK | SealFlags::SEAL,
+    )
+    .map_err(failed)?;
+    let descriptor = storage.get().try_clone().map_err(failed)?.into();
+    Ok((Buffer { _storage: storage }, descriptor))
+}
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::{
+        io::{Read, Seek, SeekFrom},
+        sync::{Arc, mpsc},
+        thread,
+        time::{Duration, Instant},
+    };
+    struct Fill;
+    impl Raster<u32> for Fill {
+        fn dimensions(&self, _: &u32) -> (u32, u32) {
+            (2, 2)
+        }
+        fn paint(
+            &mut self,
+            value: &u32,
+            pixels: &mut [u32],
+            _: &Cancellation,
+        ) -> Result<(), RenderError> {
+            pixels.fill(*value);
+            Ok(())
+        }
+    }
+    fn until(mut f: impl FnMut() -> bool) {
+        let end = Instant::now() + Duration::from_secs(3);
+        while !f() {
+            assert!(Instant::now() < end);
+            thread::sleep(Duration::from_millis(1));
+        }
+    }
+    #[test]
+    fn invalidated_event_import_keeps_memfd_charge_and_lease_until_token_drop() {
+        let budget = Budget::new(64);
+        let b = budget.clone();
+        let mut owner = crate::spawn(
+            crate::Limits {
+                leases: 2,
+                leases_per_window: 2,
+                bytes: 64,
+                ..crate::Limits::default()
+            },
+            move || Ok(Cpu::new(Fill, b)),
+        )
+        .unwrap();
+        let w = owner.open().unwrap();
+        let mut held = Vec::new();
+        for _ in 0..2 {
+            owner.submit(w, Arc::new(1), 4, 16).unwrap();
+            let mut ready = None;
+            until(|| {
+                ready = owner.poll_ready();
+                ready.is_some()
+            });
+            held.push(ready.unwrap());
+            owner.invalidate(w).unwrap();
+        }
+        assert_eq!(owner.stats().leases, 2);
+        assert_eq!(owner.stats().bytes, 40);
+        assert_eq!(budget.used(), 32);
+        owner.submit(w, Arc::new(2), 4, 16).unwrap();
+        assert_eq!(owner.stats().pending, 1);
+        assert!(owner.poll_ready().is_none());
+        let old = held.remove(0);
+        assert!(matches!(owner.commit(old), Err(crate::Error::Stale)));
+        let mut next = None;
+        until(|| {
+            next = owner.poll_ready();
+            next.is_some()
+        });
+        assert_eq!(budget.used(), 32);
+        owner.close(w);
+        owner.connection_lost();
+        assert_eq!(
+            budget.used(),
+            32,
+            "disconnect must not erase charges for still-owned fds"
+        );
+        drop(held);
+        drop(next);
+        until(|| budget.used() == 0);
+        until(|| owner.stats().leases == 0);
+    }
+    #[test]
+    fn output_is_exact_premultiplied_argb_and_sealed_until_authoritative_release() {
+        let budget = Budget::new(32);
+        let b = budget.clone();
+        let mut owner =
+            crate::spawn(crate::Limits::default(), move || Ok(Cpu::new(Fill, b))).unwrap();
+        let w = owner.open().unwrap();
+        owner
+            .submit(w, Arc::new(u32::from_ne_bytes([32, 16, 8, 64])), 4, 16)
+            .unwrap();
+        let mut ready = None;
+        until(|| {
+            ready = owner.poll_ready();
+            ready.is_some()
+        });
+        let ready = ready.unwrap();
+        assert_eq!(budget.used(), 16); // staging retired; file retained.
+        let mut file = File::from(ready.descriptor().fd.try_clone().unwrap());
+        file.seek(SeekFrom::Start(0)).unwrap();
+        let mut bytes = Vec::new();
+        file.read_to_end(&mut bytes).unwrap();
+        assert_eq!(bytes, [8, 16, 32, 64].repeat(4));
+        assert!(file.set_len(0).is_err());
+        assert!(file.set_len(32).is_err());
+        drop(file);
+        let lease = owner.commit(ready).unwrap();
+        owner.close(w);
+        assert_eq!(budget.used(), 16);
+        owner.released(lease);
+        until(|| budget.used() == 0);
+        owner.connection_lost();
+    }
+    #[test]
+    fn staging_and_file_must_both_fit_before_raster_and_refusal_is_recoverable() {
+        let budget = Budget::new(31);
+        let b = budget.clone();
+        let mut owner =
+            crate::spawn(crate::Limits::default(), move || Ok(Cpu::new(Fill, b))).unwrap();
+        let w = owner.open().unwrap();
+        owner.submit(w, Arc::new(0), 4, 16).unwrap();
+        let mut rejected = None;
+        until(|| {
+            rejected = owner.poll_fallback();
+            rejected.is_some()
+        });
+        assert_eq!(budget.used(), 0);
+        assert_eq!(rejected.unwrap().reason(), FallbackReason::Admission);
+        assert!(!owner.stats().failed);
+        owner.connection_lost();
+    }
+    #[test]
+    fn independent_cpu_completes_and_event_owner_closes_while_gpu_is_blocked() {
+        struct Block(mpsc::Sender<()>, mpsc::Receiver<()>);
+        impl Driver<u32> for Block {
+            type Resource = ();
+            fn render(
+                &mut self,
+                _: &Frame<u32>,
+                c: &Cancellation,
+            ) -> Result<((), Descriptor), RenderError> {
+                self.0.send(()).unwrap();
+                self.1.recv().unwrap();
+                assert!(c.is_cancelled());
+                Err(RenderError::Cancelled)
+            }
+        }
+        let (started_tx, started) = mpsc::channel();
+        let (unblock, wait) = mpsc::channel();
+        let mut gpu = crate::spawn(crate::Limits::default(), move || {
+            Ok(Block(started_tx, wait))
+        })
+        .unwrap();
+        let gw = gpu.open().unwrap();
+        gpu.submit(gw, Arc::new(0), 4, 16).unwrap();
+        started.recv_timeout(Duration::from_secs(3)).unwrap();
+        let budget = Budget::new(32);
+        let b = budget.clone();
+        let mut cpu =
+            crate::spawn(crate::Limits::default(), move || Ok(Cpu::new(Fill, b))).unwrap();
+        let cw = cpu.open().unwrap();
+        cpu.submit(cw, Arc::new(u32::MAX), 4, 16).unwrap();
+        let mut ready = None;
+        until(|| {
+            ready = cpu.poll_ready();
+            ready.is_some()
+        });
+        let lease = cpu.commit(ready.unwrap()).unwrap();
+        // Only the source/one pending job can be replaced during a stalled driver.
+        for _ in 0..1000 {
+            gpu.submit(gw, Arc::new(0), 4, 16).unwrap();
+            assert_eq!(gpu.stats().pending, 1);
+        }
+        gpu.close(gw);
+        drop(gpu);
+        cpu.released(lease);
+        cpu.connection_lost();
+        until(|| budget.used() == 0);
+        unblock.send(()).unwrap();
+    }
+}
