+//! Event-side selection of complete GPU or complete SHM frames. No raster, file
+//! copy, driver call or worker join occurs here. Workers retain their own leases.
+#![forbid(unsafe_code)]
+use crate::{Committed, Descriptor, Error, EventOwner, Import, WindowId, budget::Accounted};
+use std::{
+    sync::Arc,
+    time::{Duration, Instant},
+};
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct SurfaceId(u64);
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct SceneId {
+    surface: SurfaceId,
+    revision: u64,
+    sequence: u64,
+}
+/// Original full-scene identity shared by independent workers. A worker's own
+/// FrameId is not comparable with the other worker's FrameId.
+pub struct Job<F> {
+    id: SceneId,
+    source: Arc<Accounted<F>>,
+    width: u32,
+    height: u32,
+    bytes: usize,
+}
+impl<F> Job<F> {
+    pub fn id(&self) -> SceneId {
+        self.id
+    }
+    pub fn source(&self) -> &F {
+        self.source.get()
+    }
+    pub fn dimensions(&self) -> (u32, u32) {
+        (self.width, self.height)
+    }
+}
+struct Surface<F> {
+    id: SurfaceId,
+    revision: u64,
+    gpu: Option<WindowId>,
+    cpu: WindowId,
+    latest: Option<Arc<Job<F>>>,
+    presented: u64,
+    cpu_only: bool,
+    gpu_queued: u64,
+    cpu_queued: u64,
+    deadline: Option<Instant>,
+    retry_after: Option<Instant>,
+}
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Route {
+    Gpu,
+    Shm,
+}
+pub struct Pending<F> {
+    route: Route,
+    import: Import<Job<F>>,
+}
+impl<F> Pending<F> {
+    pub fn route(&self) -> Route {
+        self.route
+    }
+    pub fn descriptor(&self) -> &Descriptor {
+        self.import.descriptor()
+    }
+    pub fn scene(&self) -> SceneId {
+        self.import.source().id
+    }
+}
+pub struct Lease {
+    route: Route,
+    lease: Committed,
+}
+pub struct Bridge<F> {
+    gpu: EventOwner<Job<F>>,
+    cpu: EventOwner<Job<F>>,
+    surfaces: Vec<Surface<F>>,
+    next: u64,
+    limit: usize,
+    timeout: Duration,
+    gpu_disabled: bool,
+}
+impl<F> Bridge<F> {
+    pub fn new(
+        gpu: EventOwner<Job<F>>,
+        cpu: EventOwner<Job<F>>,
+        limit: usize,
+        timeout: Duration,
+    ) -> Self {
+        Self {
+            gpu,
+            cpu,
+            surfaces: Vec::new(),
+            next: 1,
+            limit,
+            timeout,
+            gpu_disabled: false,
+        }
+    }
+    fn next(&mut self) -> Result<u64, Error> {
+        let n = self.next;
+        self.next = n.checked_add(1).ok_or(Error::Exhausted)?;
+        Ok(n)
+    }
+    pub fn open(&mut self) -> Result<SurfaceId, Error> {
+        if self.surfaces.len() >= self.limit {
+            return Err(Error::Limit);
+        }
+        let id = SurfaceId(self.next()?);
+        let cpu = self.cpu.open()?;
+        let gpu = match self.gpu.open() {
+            Ok(w) => Some(w),
+            Err(Error::DriverFailed) => None,
+            Err(e) => {
+                self.cpu.close(cpu);
+                return Err(e);
+            }
+        };
+        self.surfaces.push(Surface {
+            id,
+            revision: id.0,
+            gpu,
+            cpu,
+            latest: None,
+            presented: 0,
+            cpu_only: gpu.is_none(),
+            gpu_queued: 0,
+            cpu_queued: 0,
+            deadline: None,
+            retry_after: None,
+        });
+        Ok(id)
+    }
+    /// The complete capture is already admitted/owned. Exactly one latest Arc is
+    /// retained per live surface, regardless of a permanently stuck GPU driver.
+    pub fn submit(
+        &mut self,
+        id: SurfaceId,
+        source: Arc<Accounted<F>>,
+        width: u32,
+        height: u32,
+        now: Instant,
+    ) -> Result<SceneId, Error> {
+        let bytes = (width as usize)
+            .checked_mul(height as usize)
+            .and_then(|n| n.checked_mul(4))
+            .filter(|&n| n > 0)
+            .ok_or(Error::Limit)?;
+        if width > 8192 || height > 8192 {
+            return Err(Error::Limit);
+        }
+        let seq = self.next()?;
+        let s = self
+            .surfaces
+            .iter_mut()
+            .find(|s| s.id == id)
+            .ok_or(Error::Closed)?;
+        let id = SceneId {
+            surface: id,
+            revision: s.revision,
+            sequence: seq,
+        };
+        s.latest = Some(Arc::new(Job {
+            id,
+            source,
+            width,
+            height,
+            bytes,
+        }));
+        if s.deadline.is_none() {
+            s.deadline = Some(now.checked_add(self.timeout).ok_or(Error::Limit)?)
+        }
+        self.dispatch(now);
+        Ok(id)
+    }
+    pub fn invalidate(&mut self, id: SurfaceId) -> Result<(), Error> {
+        let revision = self.next()?;
+        let s = self
+            .surfaces
+            .iter_mut()
+            .find(|s| s.id == id)
+            .ok_or(Error::Closed)?;
+        s.revision = revision;
+        s.latest = None;
+        s.deadline = None;
+        s.retry_after = None;
+        if let Some(w) = s.gpu {
+            self.gpu.invalidate(w)?
+        }
+        self.cpu.invalidate(s.cpu)?;
+        Ok(())
+    }
+    pub fn close(&mut self, id: SurfaceId) {
+        if let Some(i) = self.surfaces.iter().position(|s| s.id == id) {
+            let s = self.surfaces.swap_remove(i);
+            if let Some(w) = s.gpu {
+                self.gpu.close(w)
+            }
+            self.cpu.close(s.cpu);
+        }
+    }
+    fn current(&self, id: SceneId) -> bool {
+        self.surfaces
+            .iter()
+            .any(|s| s.id == id.surface && s.revision == id.revision && s.presented < id.sequence)
+    }
+    fn dispatch(&mut self, now: Instant) {
+        for s in &mut self.surfaces {
+            let Some(job) = &s.latest else { continue };
+            if s.retry_after.is_some_and(|d| now < d) {
+                continue;
+            }
+            s.retry_after = None;
+            let cpu = s.cpu_only || self.gpu_disabled;
+            let queued = if cpu {
+                &mut s.cpu_queued
+            } else {
+                &mut s.gpu_queued
+            };
+            if *queued == job.id.sequence {
+                continue;
+            }
+            let result = if cpu {
+                self.cpu
+                    .submit(s.cpu, job.clone(), job.source.bytes(), job.bytes)
+            } else {
+                self.gpu.submit(
+                    s.gpu.expect("GPU route has window"),
+                    job.clone(),
+                    job.source.bytes(),
+                    job.bytes,
+                )
+            };
+            if result.is_ok() {
+                *queued = job.id.sequence
+            }
+            // A bounded capacity refusal keeps only latest and retries on release
+            // wake/tick. No repeated allocation or new worker is created here.
+        }
+    }
+    /// Called from the coalesced worker wake and one deadline timer. Work is
+    /// bounded by surface and lease caps, never by an unbounded completion queue.
+    pub fn tick(&mut self, now: Instant) {
+        while let Some(refused) = self.gpu.poll_fallback() {
+            let id = refused.source().id;
+            if refused.is_current()
+                && self.current(id)
+                && let Some(s) = self.surfaces.iter_mut().find(|s| s.id == id.surface)
+            {
+                s.cpu_only = true;
+            }
+        }
+        while let Some(refused) = self.cpu.poll_fallback() {
+            // Capacity rejection is retried on later tick/release, retaining only
+            // latest. A permanent CPU failure is visible through cpu_failed().
+            let id = refused.source().id;
+            if let Some(s) = self
+                .surfaces
+                .iter_mut()
+                .find(|s| s.id == id.surface && s.revision == id.revision)
+                && s.cpu_queued == id.sequence
+            {
+                s.cpu_queued = 0;
+                s.retry_after = now.checked_add(Duration::from_millis(16));
+            }
+        }
+        let expired = self
+            .surfaces
+            .iter()
+            .any(|s| !s.cpu_only && s.deadline.is_some_and(|d| now >= d));
+        if !self.gpu_disabled && (self.gpu.stats().failed || expired) {
+            self.gpu_disabled = true;
+            for s in &self.surfaces {
+                if let Some(w) = s.gpu {
+                    let _ = self.gpu.invalidate(w);
+                }
+            }
+        }
+        self.dispatch(now);
+    }
+    /// Protocol import refusal also falls back as a whole frame. SHM import
+    /// refusal is terminal for this attempt; it must be reported by the adapter.
+    pub fn import_failed(&mut self, pending: Pending<F>, now: Instant) -> Result<(), Error> {
+        let id = pending.scene();
+        if !self.current(id) {
+            return Err(Error::Stale);
+        }
+        if pending.route == Route::Shm {
+            return Err(Error::InvalidDescriptor);
+        }
+        let s = self
+            .surfaces
+            .iter_mut()
+            .find(|s| s.id == id.surface)
+            .expect("validated surface");
+        s.cpu_only = true;
+        if s.latest
+            .as_ref()
+            .is_none_or(|j| j.id.sequence < id.sequence)
+        {
+            s.latest = Some(pending.import.source().clone());
+        }
+        drop(pending);
+        self.dispatch(now);
+        Ok(())
+    }
+    /// Earliest bounded timeout/retry; the event adapter arms one timer for this
+    /// instant and replaces/cancels it when state changes. No per-job timer queue.
+    pub fn next_deadline(&self) -> Option<Instant> {
+        self.surfaces
+            .iter()
+            .flat_map(|s| {
+                [
+                    s.retry_after,
+                    if self.gpu_disabled || s.cpu_only {
+                        None
+                    } else {
+                        s.deadline
+                    },
+                ]
+            })
+            .flatten()
+            .min()
+    }
+    pub fn cpu_failed(&self) -> bool {
+        self.cpu.stats().failed
+    }
+    pub fn gpu_disabled(&self) -> bool {
+        self.gpu_disabled
+    }
+    pub fn retained_latest(&self) -> usize {
+        self.surfaces.iter().filter(|s| s.latest.is_some()).count()
+    }
+    pub fn poll(&mut self) -> Option<Pending<F>> {
+        // CPU first once fallback has completed; a late GPU success for this
+        // original scene will then fail the shared sequence gate at commit.
+        while let Some(import) = self.cpu.poll_ready() {
+            if self.current(import.source().id) {
+                return Some(Pending {
+                    route: Route::Shm,
+                    import,
+                });
+            }
+        }
+        while let Some(import) = self.gpu.poll_ready() {
+            if self.current(import.source().id) {
+                return Some(Pending {
+                    route: Route::Gpu,
+                    import,
+                });
+            }
+        }
+        None
+    }
+    /// Validate immediately before the adapter's attach/commit. Params creation
+    /// and GPU/SHM completion alone never authorize a stale frame to present.
+    pub fn commit(&mut self, pending: Pending<F>, now: Instant) -> Result<Lease, Error> {
+        let id = pending.scene();
+        if !self.current(id) {
+            return Err(Error::Stale);
+        }
+        let lease = match pending.route {
+            Route::Gpu => self.gpu.commit(pending.import)?,
+            Route::Shm => self.cpu.commit(pending.import)?,
+        };
+        let s = self
+            .surfaces
+            .iter_mut()
+            .find(|s| s.id == id.surface)
+            .expect("validated surface");
+        s.presented = id.sequence;
+        if s.latest.as_ref().is_some_and(|j| j.id == id) {
+            s.latest = None;
+            s.deadline = None;
+        } else {
+            s.deadline = now.checked_add(self.timeout);
+        }
+        Ok(Lease {
+            route: pending.route,
+            lease,
+        })
+    }
+    pub fn released(&mut self, lease: Lease) {
+        match lease.route {
+            Route::Gpu => self.gpu.released(lease.lease),
+            Route::Shm => self.cpu.released(lease.lease),
+        }
+    }
+    pub fn connection_lost(&mut self) {
+        self.gpu.connection_lost();
+        self.cpu.connection_lost();
+        self.surfaces.clear();
+    }
+}
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::{
+        Cancellation, Driver, FallbackReason, Frame, Limits, RenderError,
+        budget::Budget,
+        shm::{Cpu, Raster},
+    };
+    use std::{os::unix::net::UnixStream, sync::mpsc, thread};
+    struct Paint;
+    impl Raster<Job<u32>> for Paint {
+        fn dimensions(&self, s: &Job<u32>) -> (u32, u32) {
+            s.dimensions()
+        }
+        fn paint(
+            &mut self,
+            s: &Job<u32>,
+            px: &mut [u32],
+            _: &Cancellation,
+        ) -> Result<(), RenderError> {
+            px.fill(*s.source());
+            Ok(())
+        }
+    }
+    struct Gpu {
+        started: mpsc::Sender<SceneId>,
+        unblock: Option<mpsc::Receiver<()>>,
+        refuse: bool,
+    }
+    impl Driver<Job<u32>> for Gpu {
+        type Resource = UnixStream;
+        fn render(
+            &mut self,
+            frame: &Frame<Job<u32>>,
+            c: &Cancellation,
+        ) -> Result<(UnixStream, Descriptor), RenderError> {
+            let _ = self.started.send(frame.source.id());
+            if let Some(wait) = &self.unblock {
+                wait.recv().unwrap();
+            }
+            if c.is_cancelled() {
+                return Err(RenderError::Cancelled);
+            }
+            if self.refuse {
+                return Err(RenderError::Fallback(FallbackReason::Unsupported));
+            }
+            let (a, b) = UnixStream::pair().unwrap();
+            let (w, h) = frame.source.dimensions();
+            Ok((
+                a,
+                Descriptor {
+                    fd: b.into(),
+                    width: w,
+                    height: h,
+                    stride: w * 4,
+                    offset: 0,
+                    fourcc: u32::from_le_bytes(*b"AB24"),
+                    modifier: 0,
+                },
+            ))
+        }
+    }
+    fn fixture(
+        block: bool,
+        refuse: bool,
+    ) -> (
+        Bridge<u32>,
+        Budget,
+        mpsc::Receiver<SceneId>,
+        mpsc::Sender<()>,
+    ) {
+        let budget = Budget::new(4096);
+        let b = budget.clone();
+        let (started_tx, started) = mpsc::channel();
+        let (send, wait) = mpsc::channel();
+        let gpu = crate::spawn(Limits::default(), move || {
+            Ok(Gpu {
+                started: started_tx,
+                unblock: block.then_some(wait),
+                refuse,
+            })
+        })
+        .unwrap();
+        let cpu = crate::spawn(Limits::default(), move || Ok(Cpu::new(Paint, b))).unwrap();
+        (
+            Bridge::new(gpu, cpu, 2, Duration::from_millis(50)),
+            budget,
+            started,
+            send,
+        )
+    }
+    fn source(b: &Budget, pixel: u32) -> Arc<Accounted<u32>> {
+        Arc::new(Accounted::new(pixel, b.reserve(4).unwrap()))
+    }
+    fn until(mut f: impl FnMut() -> bool) {
+        let end = Instant::now() + Duration::from_secs(3);
+        while !f() {
+            assert!(Instant::now() < end, "progress");
+            thread::sleep(Duration::from_millis(1));
+        }
+    }
+    fn ready(b: &mut Bridge<u32>, now: Instant) -> Pending<u32> {
+        let mut p = None;
+        until(|| {
+            b.tick(now);
+            p = b.poll();
+            p.is_some()
+        });
+        p.unwrap()
+    }
+    #[test]
+    fn failed_gpu_factory_still_opens_a_cpu_only_surface() {
+        let budget = Budget::new(4096);
+        let cb = budget.clone();
+        let gpu =
+            crate::spawn::<Job<u32>, Gpu, _>(Limits::default(), || Err("unavailable GPU".into()))
+                .unwrap();
+        until(|| gpu.stats().failed);
+        let cpu = crate::spawn(Limits::default(), move || Ok(Cpu::new(Paint, cb))).unwrap();
+        let mut b = Bridge::new(gpu, cpu, 2, Duration::from_millis(50));
+        let w = b.open().unwrap();
+        let now = Instant::now();
+        b.submit(w, source(&budget, 42), 2, 2, now).unwrap();
+        let p = ready(&mut b, now);
+        assert_eq!(p.route(), Route::Shm);
+        let lease = b.commit(p, now).unwrap();
+        b.released(lease);
+        b.connection_lost();
+        until(|| budget.used() == 0);
+    }
+    #[test]
+    fn post_release_capacity_wake_retries_latest_after_slow_resource_destructor() {
+        struct Resource {
+            wait: Option<mpsc::Receiver<()>>,
+            entered: mpsc::Sender<()>,
+        }
+        impl Drop for Resource {
+            fn drop(&mut self) {
+                if let Some(wait) = self.wait.take() {
+                    self.entered.send(()).unwrap();
+                    wait.recv().unwrap();
+                }
+            }
+        }
+        struct DriverOnce {
+            wait: Option<mpsc::Receiver<()>>,
+            entered: mpsc::Sender<()>,
+        }
+        impl Driver<Job<u32>> for DriverOnce {
+            type Resource = Resource;
+            fn render(
+                &mut self,
+                _: &Frame<Job<u32>>,
+                _: &Cancellation,
+            ) -> Result<(Resource, Descriptor), RenderError> {
+                let (a, b) = UnixStream::pair().unwrap();
+                drop(a);
+                Ok((
+                    Resource {
+                        wait: self.wait.take(),
+                        entered: self.entered.clone(),
+                    },
+                    Descriptor {
+                        fd: b.into(),
+                        width: 2,
+                        height: 2,
+                        stride: 8,
+                        offset: 0,
+                        fourcc: 0,
+                        modifier: 0,
+                    },
+                ))
+            }
+        }
+        let (unblock, wait) = mpsc::channel();
+        let (entered_tx, entered) = mpsc::channel();
+        let (wake_tx, wake) = mpsc::channel();
+        let gpu = crate::spawn_with_wake(
+            Limits {
+                bytes: 20,
+                ..Limits::default()
+            },
+            move || {
+                Ok(DriverOnce {
+                    wait: Some(wait),
+                    entered: entered_tx,
+                })
+            },
+            move || {
+                let _ = wake_tx.send(());
+            },
+        )
+        .unwrap();
+        let budget = Budget::new(4096);
+        let cb = budget.clone();
+        let cpu = crate::spawn(Limits::default(), move || Ok(Cpu::new(Paint, cb))).unwrap();
+        let mut b = Bridge::new(gpu, cpu, 2, Duration::from_secs(60));
+        let w = b.open().unwrap();
+        let now = Instant::now();
+        b.submit(w, source(&budget, 1), 2, 2, now).unwrap();
+        let p = ready(&mut b, now);
+        let first = b.commit(p, now).unwrap();
+        wake.recv_timeout(Duration::from_secs(3)).unwrap();
+        while wake.try_recv().is_ok() {}
+        b.submit(w, source(&budget, 2), 2, 2, now).unwrap();
+        assert_eq!(
+            b.gpu.stats().pending,
+            0,
+            "full lease capacity rejects worker submission"
+        );
+        b.released(first);
+        entered.recv_timeout(Duration::from_secs(3)).unwrap();
+        b.tick(now);
+        assert_eq!(b.gpu.stats().pending, 0);
+        assert!(wake.try_recv().is_err());
+        unblock.send(()).unwrap();
+        wake.recv_timeout(Duration::from_secs(3))
+            .expect("no capacity wake after actual reclamation");
