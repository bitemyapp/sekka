+//! Explicit complete native scenes. Admission retains original immutable ops;
+//! unsupported GPU drawing therefore still has a complete CPU source.
+#![forbid(unsafe_code)]
+use crate::{
+    Cancellation, RenderError,
+    bridge::Job,
+    budget::{Accounted, Budget, Reservation},
+    shm::Raster,
+};
+use sidestep_engine::{
+    protocol::{Draw, Op, Paint, Rect},
+    raster::{self, Glyphs, images::Pixels},
+};
+use std::{mem::size_of, sync::Arc};
+const MAX_OPS: usize = 65536;
+const MAX_SOURCE: usize = 64 << 20;
+const MAX_FRAME: usize = 32 << 20;
+const WORKER_ALLOWANCE: usize = 128 << 20;
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Admission {
+    Geometry,
+    Limit,
+    RequiresExistingBackend,
+}
+/// Construct on a preparation worker from a full-damage recording. Validation
+/// and compact path copies do not belong on a UI/Wayland callback or mutex.
+/// An incremental Paint message or scroll delta cannot satisfy this contract,
+/// even if its rect covers the window.
+pub struct CompleteScene {
+    width: u32,
+    height: u32,
+    scale: f32,
+    ops: Arc<[Op]>,
+}
+impl CompleteScene {
+    pub fn admit_full_recording(
+        width: u32,
+        height: u32,
+        scale: f32,
+        ops: Arc<[Op]>,
+        budget: &Budget,
+    ) -> Result<Arc<Accounted<Self>>, Admission> {
+        let bytes = (width as usize)
+            .checked_mul(height as usize)
+            .and_then(|n| n.checked_mul(4))
+            .ok_or(Admission::Limit)?;
+        if width == 0
+            || height == 0
+            || width > 8192
+            || height > 8192
+            || bytes > MAX_FRAME
+            || !scale.is_finite()
+            || !(0.0625..=16.).contains(&scale)
+        {
+            return Err(Admission::Geometry);
+        }
+        if ops.len() > MAX_OPS {
+            return Err(Admission::Limit);
+        }
+        let mut charge = size_of::<Self>()
+            .checked_add(
+                ops.len()
+                    .checked_mul(size_of::<Op>())
+                    .ok_or(Admission::Limit)?,
+            )
+            .ok_or(Admission::Limit)?;
+        for op in ops.iter() {
+            charge = charge
+                .checked_add(op_charge(op, scale)?)
+                .filter(|n| *n <= MAX_SOURCE)
+                .ok_or(Admission::Limit)?;
+        }
+        let reservation = budget.reserve(charge).map_err(|_| Admission::Limit)?;
+        // tiny-skia hides Path's Vec capacities. Clone compacts those buffers so
+        // admitted ownership never pins an arbitrarily oversized builder reserve.
+        let mut compact = Vec::new();
+        compact
+            .try_reserve_exact(ops.len())
+            .map_err(|_| Admission::Limit)?;
+        for op in ops.iter() {
+            let mut owned = op.clone();
+            match &mut owned {
+                Op::FillPath { path, .. } | Op::StrokePath { path, .. } => {
+                    *path = Arc::new((**path).clone())
+                }
+                _ => {}
+            }
+            compact.push(owned);
+        }
+        Ok(Arc::new(Accounted::new(
+            Self {
+                width,
+                height,
+                scale,
+                ops: compact.into(),
+            },
+            reservation,
+        )))
+    }
+
+    pub fn dimensions(&self) -> (u32, u32) {
+        (self.width, self.height)
+    }
+    pub fn scale(&self) -> f32 {
+        self.scale
+    }
+    pub fn ops(&self) -> &[Op] {
+        &self.ops
+    }
+}
+fn bounded(v: f32) -> bool {
+    v.is_finite() && v.abs() <= 1_000_000.
+}
+fn rect(r: &Rect) -> bool {
+    [r.x0, r.y0, r.x1, r.y1].into_iter().all(bounded)
+}
+fn color(c: &[f32; 4]) -> bool {
+    c.iter().all(|v| v.is_finite())
+}
+fn draw(d: &Draw) -> Result<(), Admission> {
+    if d.mask.is_some() || d.shadow.is_some() {
+        return Err(Admission::RequiresExistingBackend);
+    }
+    if !d.xf.is_finite() || !rect(&d.clip) {
+        return Err(Admission::Geometry);
+    }
+    Ok(())
+}
+fn paint(p: &Paint) -> Result<usize, Admission> {
+    match p {
+        Paint::Solid(c) if color(c) => Ok(0),
+        Paint::Gradient(g)
+            if g.stops.len() <= 256
+                && [g.start.0, g.start.1, g.end.0, g.end.1]
+                    .into_iter()
+                    .all(bounded)
+                && g.radii
+                    .is_none_or(|(a, b)| bounded(a) && bounded(b) && a >= 0. && b >= 0.)
+                && g.stops.iter().all(|(t, c)| t.is_finite() && color(c)) =>
+        {
+            Ok(size_of::<sidestep_engine::protocol::GradientSpec>()
+                + g.stops.capacity() * size_of::<(f32, [f32; 4])>())
+        }
+        _ => Err(Admission::Geometry),
+    }
+}
+fn path_charge(path: &tiny_skia::Path) -> Result<usize, Admission> {
+    let n = path.points().len();
+    if n > 8192 || path.len() > 16384 {
+        return Err(Admission::Limit);
+    }
+    // Path stores points and verb tags; overcharge each point for both containers.
+    Ok(size_of::<tiny_skia::Path>() + n * 32 + 64)
+}
+fn op_charge(op: &Op, scale: f32) -> Result<usize, Admission> {
+    match op {
+        Op::Fill { rect: r, color: c }
+        | Op::FillWith {
+            rect: r, color: c, ..
+        } if rect(r) && color(c) => Ok(0),
+        Op::AlphaMask {
+            mask,
+            dst,
+            clip,
+            color: c,
+        } if rect(dst) && rect(clip) && color(c) => Ok(mask.storage_bytes()),
+        Op::Glyphs(run)
+            if run.glyphs.len() <= 131072
+                && run.size.is_finite()
+                && run.size > 0.
+                && run.size * scale <= 256.
+                && bounded(run.x)
+                && bounded(run.y)
+                && rect(&run.clip)
+                && color(&run.color)
+                && run.glyphs.iter().all(|g| bounded(g.x) && bounded(g.y)) =>
+        {
+            Ok(run.glyphs.len() * size_of::<sidestep_engine::protocol::Glyph>() + 32)
+        }
+        Op::Image {
+            image,
+            draw: d,
+            src,
+            dst,
+            alpha,
+            tint,
+            ..
+        } => {
+            draw(d)?;
+            if !rect(src) || !rect(dst) || !alpha.is_finite() || !tint.is_none_or(|c| color(&c)) {
+                return Err(Admission::Geometry);
+            }
+            let Pixels::Rgba(data) = &image.pixels else {
+                return Err(Admission::RequiresExistingBackend);
+            };
+            let expected = (image.width as usize)
+                .checked_mul(image.height as usize)
+                .and_then(|n| n.checked_mul(4))
+                .ok_or(Admission::Limit)?;
+            if expected == 0 || expected > 1 << 20 || data.len() != expected {
+                return Err(Admission::Limit);
+            }
+            Ok(size_of::<raster::images::ImageData>() + data.len() + 32)
+        }
+        Op::FillPath {
+            path,
+            paint: p,
+            draw: d,
+            ..
+        } => {
+            draw(d)?;
+            Ok(path_charge(path)? + paint(p)?)
+        }
+        Op::StrokePath {
+            path,
+            stroke,
+            paint: p,
+            draw: d,
+        } => {
+            draw(d)?;
+            if !stroke.width.is_finite()
+                || !(0.0..=64.).contains(&stroke.width)
+                || !stroke.miter.is_finite()
+                || !(0.0..=100.).contains(&stroke.miter)
+            {
+                return Err(Admission::Geometry);
+            }
+            let dash = match &stroke.dash {
+                None => 0,
+                Some((items, phase)) => {
+                    if items.len() > 128
+                        || !phase.is_finite()
+                        || !items.iter().all(|v| v.is_finite() && *v >= 0.)
+                    {
+                        return Err(Admission::Geometry);
+                    }
+                    items.capacity() * 4
+                }
+            };
+            Ok(path_charge(path)?
+                + paint(p)?
+                + size_of::<sidestep_engine::protocol::StrokeSpec>()
+                + dash)
+        }
+        // These need recursive CA resolution or nested scratch reservation. Keep the
+        // old CPU backend authoritative until explicit complete immutable support.
+        Op::Composite(_) | Op::BeginGroup { .. } | Op::EndGroup => {
+            Err(Admission::RequiresExistingBackend)
+        }
+        _ => Err(Admission::Geometry),
+    }
+}
+/// Separate CPU-worker raster state. This conservative allowance includes its
+/// scratch/image/glyph caches; existing global font registry is process baseline.
+/// No bands pool is used: cancellation is checked between128physical-row slices.
+pub struct NativeRaster {
+    _allowance: Reservation,
+}
+impl NativeRaster {
+    pub fn new(budget: &Budget) -> Result<Self, String> {
+        let allowance = budget
+            .reserve(WORKER_ALLOWANCE)
+            .map_err(|_| "CPU worker cache allowance")?;
+        raster::images::configure_thread_cache(16 << 20);
+        Ok(Self {
+            _allowance: allowance,
+        })
+    }
+}
+impl Drop for NativeRaster {
+    fn drop(&mut self) {
+        raster::ops::clear_thread_cache();
+        raster::images::configure_thread_cache(0);
+    }
+}
+impl Raster<Job<CompleteScene>> for NativeRaster {
+    fn dimensions(&self, job: &Job<CompleteScene>) -> (u32, u32) {
+        job.source().dimensions()
+    }
+    fn paint(
+        &mut self,
+        job: &Job<CompleteScene>,
+        pixels: &mut [u32],
+        cancel: &Cancellation,
+    ) -> Result<(), RenderError> {
+        let scene = job.source();
+        let mut glyphs = Glyphs::default();
+        let mut canvas = raster::Canvas::new(pixels, scene.width, scene.height, 0., scene.scale);
+        for row in (0..scene.height).step_by(128) {
+            if cancel.is_cancelled() {
+                return Err(RenderError::Cancelled);
+            }
+            let clip = Rect::new(
+                0.,
+                row as f32 / scene.scale,
+                scene.width as f32 / scene.scale,
+                (row + 128).min(scene.height) as f32 / scene.scale,
+            );
+            raster::paint(&mut canvas, &mut glyphs, &[clip], &scene.ops);
+        }
+        Ok(())
+    }
+}
+#[cfg(test)]
+mod tests {
