+//! Logical owned-storage budget shared by CPU preparation, GPU and event paths.
+//! No graphics calls or data destruction run while its accounting mutex is held.
+#![forbid(unsafe_code)]
+use std::sync::{Arc, Mutex};
+#[derive(Clone)]
+pub struct Budget(Arc<Inner>);
+struct Inner {
+    limit: usize,
+    used: Mutex<usize>,
+}
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct Exhausted;
+/// Clones share one charge. The final clone releases it, independently of which
+/// worker/event path retires the resource. This models ownership, not process RSS.
+#[derive(Clone)]
+pub struct Reservation(Arc<Charge>);
+struct Charge {
+    budget: Budget,
+    bytes: usize,
+}
+/// Field order is intentional: storage is destroyed before its charge retires.
+/// Share this wrapper through Arc when several jobs reference one allocation.
+pub struct Accounted<T> {
+    value: T,
+    charge: Reservation,
+}
+impl<T> Accounted<T> {
+    pub fn new(value: T, charge: Reservation) -> Self {
+        Self { value, charge }
+    }
+    pub fn get(&self) -> &T {
+        &self.value
+    }
+    pub fn get_mut(&mut self) -> &mut T {
+        &mut self.value
+    }
+    pub fn bytes(&self) -> usize {
+        self.charge.bytes()
+    }
+}
+impl Budget {
+    pub fn new(limit: usize) -> Self {
+        Self(Arc::new(Inner {
+            limit,
+            used: Mutex::new(0),
+        }))
+    }
+    pub fn reserve(&self, bytes: usize) -> Result<Reservation, Exhausted> {
+        let mut used = self.0.used.lock().unwrap();
+        let next = used
+            .checked_add(bytes)
+            .filter(|&n| n <= self.0.limit)
+            .ok_or(Exhausted)?;
+        *used = next;
+        drop(used);
+        Ok(Reservation(Arc::new(Charge {
+            budget: self.clone(),
+            bytes,
+        })))
+    }
+    pub fn used(&self) -> usize {
+        *self.0.used.lock().unwrap()
+    }
+    pub fn limit(&self) -> usize {
+        self.0.limit
+    }
+}
+impl Reservation {
+    pub fn bytes(&self) -> usize {
+        self.0.bytes
+    }
+    /// Growing must reserve a second token before allocation. Do not release the
+    /// old token until the old allocation/committed buffer actually retires.
+    pub fn same_charge(&self, other: &Self) -> bool {
+        Arc::ptr_eq(&self.0, &other.0)
+    }
+}
+impl Drop for Charge {
+    fn drop(&mut self) {
+        let mut used = self.budget.0.used.lock().unwrap();
+        *used = used.checked_sub(self.bytes).expect("owned budget charge");
+    }
+}
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn old_retired_and_new_buffers_all_stay_charged_until_last_owner() {
+        let b = Budget::new(128);
+        let fixed = b.reserve(32).unwrap();
+        let source = b.reserve(16).unwrap();
+        let current = b.reserve(40).unwrap();
+        let committed = current.clone();
+        drop(current);
+        let replacement = b.reserve(40).unwrap();
+        assert_eq!(b.used(), 128);
+        assert!(b.reserve(1).is_err());
+        drop(source);
+        assert_eq!(b.used(), 112);
+        drop(replacement);
+        assert_eq!(b.used(), 72);
+        drop(committed);
+        assert_eq!(b.used(), 32);
+        drop(fixed);
+        assert_eq!(b.used(), 0);
+    }
+    #[test]
+    fn clones_do_not_double_count_and_overflow_never_changes_state() {
+        let b = Budget::new(usize::MAX);
+        let token = b.reserve(usize::MAX - 1).unwrap();
+        let other = token.clone();
+        assert!(token.same_charge(&other));
+        assert!(b.reserve(2).is_err());
+        assert_eq!(b.used(), usize::MAX - 1);
+        drop(token);
+        assert_eq!(b.used(), usize::MAX - 1);
+        drop(other);
+        assert_eq!(b.used(), 0);
+    }
+    #[test]
+    fn reservations_from_workers_share_one_bound() {
+        let b = Budget::new(4096);
+        let barrier = Arc::new(std::sync::Barrier::new(9));
+        let threads = (0..8)
+            .map(|_| {
+                let b = b.clone();
+                let barrier = barrier.clone();
+                std::thread::spawn(move || {
+                    let token = b.reserve(1024);
+                    barrier.wait();
+                    barrier.wait();
+                    token
+                })
+            })
+            .collect::<Vec<_>>();
+        barrier.wait();
+        assert_eq!(b.used(), 4096);
+        barrier.wait();
+        let held = threads
+            .into_iter()
+            .filter_map(|t| t.join().unwrap().ok())
+            .collect::<Vec<_>>();
+        assert_eq!(held.len(), 4);
+        assert_eq!(b.used(), 4096);
+        drop(held);
+        assert_eq!(b.used(), 0);
+    }
+    #[test]
+    fn storage_destructor_runs_before_accounting_release() {
+        struct Storage(Budget);
+        impl Drop for Storage {
+            fn drop(&mut self) {
+                assert_eq!(self.0.used(), 32);
+            }
+        }
+        let b = Budget::new(64);
+        let charge = b.reserve(32).unwrap();
+        let storage = Accounted::new(Storage(b.clone()), charge);
+        drop(storage);
+        assert_eq!(b.used(), 0);
+    }
+}
