+        b.released(lease);
+        b.submit(w, source(&budget, 2), 2, 2, now).unwrap();
+        let old = ready(&mut b, now);
+        b.invalidate(w).unwrap();
+        assert!(matches!(b.commit(old, now), Err(Error::Stale)));
+        b.submit(w, source(&budget, 3), 2, 2, now).unwrap();
+        let p = ready(&mut b, now);
+        b.close(w);
+        assert!(matches!(b.commit(p, now), Err(Error::Stale)));
+        b.connection_lost();
+        until(|| budget.used() == 0);
+    }
+    #[test]
+    fn bounded_surface_cardinality_and_monotonic_identity_exhaustion() {
+        let (mut b, _, _, _) = fixture(false, false);
+        let a = b.open().unwrap();
+        let _ = b.open().unwrap();
+        assert_eq!(b.open(), Err(Error::Limit));
