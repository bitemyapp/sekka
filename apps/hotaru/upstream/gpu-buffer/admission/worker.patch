+//! Private-compositor diagnostic for actual worker-filled SHM. Not a production
+//! event-loop adapter: fixture marker polling and bounded teardown waits belong
+//! only to this diagnostic. CPU/GPU work still stays on their dedicated workers.
+#![forbid(unsafe_code)]
+use crate::{
+    bridge::{Bridge, Lease, Pending, Route, SurfaceId},
+    complete::CompleteScene,
+};
+use sctk::{
+    compositor::{CompositorHandler, CompositorState},
+    output::{OutputHandler, OutputState},
+    reexports::{calloop::EventLoop, calloop_wayland_source::WaylandSource},
+    registry::{ProvidesRegistryState, RegistryState},
+    shell::{
+        WaylandSurface,
+        wlr_layer::{
+            KeyboardInteractivity, Layer, LayerShell, LayerShellHandler, LayerSurface,
+            LayerSurfaceConfigure,
+        },
+    },
+};
+use std::{
+    net::Shutdown,
+    os::{fd::AsFd, unix::net::UnixStream},
+    path::Path,
+    time::{Duration, Instant},
+};
+use wayland_client::{
+    Connection, Dispatch, Proxy, QueueHandle,
+    globals::registry_queue_init,
+    protocol::{wl_buffer, wl_output, wl_shm, wl_shm_pool, wl_surface},
+};
+struct State {
+    registry: RegistryState,
+    output: OutputState,
+    layer: LayerSurface,
+    bridge: Bridge<CompleteScene>,
+    window: SurfaceId,
+    configured: bool,
+    extent: (u32, u32),
+    frame: bool,
+    buffer: Option<wl_buffer::WlBuffer>,
+    lease: Option<Lease>,
+    released: bool,
+    detached: bool,
+    error: Option<String>,
+}
+impl ProvidesRegistryState for State {
+    fn registry(&mut self) -> &mut RegistryState {
+        &mut self.registry
+    }
+    sctk::registry_handlers![OutputState];
+}
+impl OutputHandler for State {
+    fn output_state(&mut self) -> &mut OutputState {
+        &mut self.output
+    }
+    fn new_output(&mut self, _: &Connection, _: &QueueHandle<Self>, _: wl_output::WlOutput) {}
+    fn update_output(&mut self, _: &Connection, _: &QueueHandle<Self>, _: wl_output::WlOutput) {}
+    fn output_destroyed(&mut self, _: &Connection, _: &QueueHandle<Self>, _: wl_output::WlOutput) {}
+}
+impl CompositorHandler for State {
+    fn scale_factor_changed(
+        &mut self,
+        _: &Connection,
+        _: &QueueHandle<Self>,
+        _: &wl_surface::WlSurface,
+        n: i32,
+    ) {
+        if n != 1 {
+            self.error = Some("unexpected private scale".into())
+        }
+    }
+    fn transform_changed(
+        &mut self,
+        _: &Connection,
+        _: &QueueHandle<Self>,
+        _: &wl_surface::WlSurface,
+        t: wl_output::Transform,
+    ) {
+        if t != wl_output::Transform::Normal {
+            self.error = Some("unexpected private transform".into())
+        }
+    }
+    fn frame(&mut self, _: &Connection, _: &QueueHandle<Self>, _: &wl_surface::WlSurface, _: u32) {
+        self.frame = true;
+    }
+    fn surface_enter(
+        &mut self,
+        _: &Connection,
+        _: &QueueHandle<Self>,
+        _: &wl_surface::WlSurface,
+        _: &wl_output::WlOutput,
+    ) {
+    }
+    fn surface_leave(
+        &mut self,
+        _: &Connection,
+        _: &QueueHandle<Self>,
+        _: &wl_surface::WlSurface,
+        _: &wl_output::WlOutput,
+    ) {
+    }
+}
+impl LayerShellHandler for State {
+    fn closed(&mut self, _: &Connection, _: &QueueHandle<Self>, _: &LayerSurface) {
+        self.error = Some("private layer closed".into())
+    }
+    fn configure(
+        &mut self,
+        _: &Connection,
+        _: &QueueHandle<Self>,
+        _: &LayerSurface,
+        c: LayerSurfaceConfigure,
+        _: u32,
+    ) {
+        if c.new_size != self.extent {
+            self.error = Some(format!("extent mismatch {:?}", c.new_size))
+        }
+        self.configured = true;
+    }
+}
+impl Dispatch<wl_shm::WlShm, ()> for State {
+    fn event(
+        _: &mut Self,
+        _: &wl_shm::WlShm,
+        _: wl_shm::Event,
+        _: &(),
+        _: &Connection,
+        _: &QueueHandle<Self>,
+    ) {
+    }
+}
+impl Dispatch<wl_shm_pool::WlShmPool, ()> for State {
+    fn event(
+        _: &mut Self,
+        _: &wl_shm_pool::WlShmPool,
+        _: wl_shm_pool::Event,
+        _: &(),
+        _: &Connection,
+        _: &QueueHandle<Self>,
+    ) {
+    }
+}
+impl Dispatch<wl_buffer::WlBuffer, ()> for State {
+    fn event(
+        state: &mut Self,
+        buffer: &wl_buffer::WlBuffer,
+        event: wl_buffer::Event,
+        _: &(),
+        _: &Connection,
+        _: &QueueHandle<Self>,
+    ) {
+        if let wl_buffer::Event::Release = event {
+            if state.buffer.as_ref().map(Proxy::id) != Some(buffer.id()) {
+                state.error = Some("unknown release".into());
+                return;
+            }
+            if let Some(lease) = state.lease.take() {
+                state.bridge.released(lease);
+                state.released = true;
+            } else {
+                state.error = Some("duplicate release".into());
+            }
+        }
+    }
+}
+sctk::delegate_compositor!(State);
+sctk::delegate_output!(State);
+sctk::delegate_layer!(State);
+sctk::delegate_registry!(State);
+
+/// `ready` is a complete CPU result already compared byte-for-byte by the native
+/// harness. External runner captures only after `ready.json`, then writes detach.
+pub fn present(
+    bridge: Bridge<CompleteScene>,
+    window: SurfaceId,
+    ready: Pending<CompleteScene>,
+    directory: &Path,
+) -> Result<(), String> {
+    if ready.route() != Route::Shm {
+        return Err("SHM route required".into());
+    }
+    let extent = (ready.descriptor().width, ready.descriptor().height);
+    let runtime = std::env::var_os("XDG_RUNTIME_DIR").ok_or("private runtime required")?;
+    let display = std::env::var_os("WAYLAND_DISPLAY").ok_or("private display required")?;
+    let path = Path::new(&runtime).join(display);
+    let socket = UnixStream::connect(path).map_err(|e| e.to_string())?;
+    let connection = Connection::from_socket(socket.try_clone().map_err(|e| e.to_string())?)
+        .map_err(|e| e.to_string())?;
+    let (globals, queue) = registry_queue_init::<State>(&connection).map_err(|e| e.to_string())?;
+    let qh = queue.handle();
+    let compositor = CompositorState::bind(&globals, &qh).map_err(|e| e.to_string())?;
+    let layer_shell = LayerShell::bind(&globals, &qh).map_err(|e| e.to_string())?;
+    let shm = globals
+        .bind::<wl_shm::WlShm, _, _>(&qh, 1..=1, ())
+        .map_err(|e| e.to_string())?;
+    let layer = layer_shell.create_layer_surface(
+        &qh,
+        compositor.create_surface(&qh),
+        Layer::Overlay,
+        Some("hotaru-admission-private"),
+        None,
+    );
+    layer.set_size(extent.0, extent.1);
+    layer.set_keyboard_interactivity(KeyboardInteractivity::None);
+    layer.commit();
+    let mut event_loop = EventLoop::<State>::try_new().map_err(|e| e.to_string())?;
+    WaylandSource::new(connection.clone(), queue)
+        .insert(event_loop.handle())
+        .map_err(|e| e.to_string())?;
+    let mut state = State {
+        registry: RegistryState::new(&globals),
+        output: OutputState::new(&globals, &qh),
+        layer,
+        bridge,
+        window,
+        configured: false,
+        extent,
+        frame: false,
+        buffer: None,
+        lease: None,
+        released: false,
+        detached: false,
+        error: None,
+    };
+    let mut ready = Some(ready);
+    let end = Instant::now() + Duration::from_secs(15);
+    let mut announced = false;
+    let result = (|| {
+        while !state.detached || !state.released {
+            if Instant::now() > end {
+                return Err("private SHM phase deadline".into());
+            }
+            event_loop
+                .dispatch(Duration::from_millis(16), &mut state)
+                .map_err(|e| e.to_string())?;
+            if let Some(error) = state.error.take() {
+                return Err(error);
+            }
+            if state.configured
+                && let Some(import) = ready.take()
+            {
+                let d = import.descriptor();
+                let size = d
+                    .stride
+                    .checked_mul(d.height)
+                    .and_then(|n| n.checked_add(d.offset))
+                    .filter(|n| *n <= i32::MAX as u32)
+                    .ok_or("pool bounds")?;
+                if d.fourcc != u32::from_le_bytes(*b"AR24") {
+                    return Err("SHM pixel format".into());
+                }
+                let pool = shm.create_pool(d.fd.as_fd(), size as i32, &qh, ());
+                let buffer = pool.create_buffer(
+                    d.offset as i32,
+                    d.width as i32,
+                    d.height as i32,
+                    d.stride as i32,
+                    wl_shm::Format::Argb8888,
+                    &qh,
+                    (),
+                );
+                pool.destroy();
+                let lease = state
+                    .bridge
+                    .commit(import, Instant::now())
+                    .map_err(|e| format!("stale import {e:?}"))?;
+                state.layer.wl_surface().attach(Some(&buffer), 0, 0);
+                state
+                    .layer
+                    .wl_surface()
+                    .damage_buffer(0, 0, extent.0 as i32, extent.1 as i32);
+                state
+                    .layer
+                    .wl_surface()
+                    .frame(&qh, state.layer.wl_surface().clone());
+                state.buffer = Some(buffer);
+                state.lease = Some(lease);
+                state.layer.commit();
+            }
+            if state.frame && !announced {
+                std::fs::write(directory.join("ready.json"),serde_json::to_vec(&serde_json::json!({"width":extent.0,"height":extent.1,"whole_frame":true,"sealed_shm":true,"worker_raster":true})).unwrap()).map_err(|e|e.to_string())?;
+                announced = true;
+            }
+            if announced && !state.detached && directory.join("detach").exists() {
+                state.detached = true;
+                state.layer.wl_surface().attach(None, 0, 0);
+                state.layer.commit();
+                state.bridge.close(state.window);
+            }
+        }
+        Ok(())
+    })();
+    if let Some(buffer) = state.buffer.take() {
+        buffer.destroy()
+    }
+    socket.shutdown(Shutdown::Both).map_err(|e| e.to_string())?;
+    state.bridge.connection_lost();
+    result?;
+    std::fs::write(directory.join("released.json"),serde_json::to_vec(&serde_json::json!({"released":state.released,"detached":state.detached,"connection_closed":true})).unwrap()).map_err(|e|e.to_string())?;
+    Ok(())
+}
