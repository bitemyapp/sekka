+use aizome_kit::sidestep_ui::offscreen::{RecordedFrame,GpuPrepare,GpuFallback};
+use hotaru_gpu_transport_prototype::{self as worker,budget::{Budget,Reservation},bridge::{Bridge,Job,Route},complete::{CompleteScene,NativeRaster},shm::Cpu,Cancellation,Descriptor,Driver,FallbackReason,Frame,Limits,RenderError};
+use std::{fs::File,io::{Read,Seek,SeekFrom},time::{Duration,Instant}};
+struct RefusedGpu {prepare:GpuPrepare,_allowance:Reservation}
+impl Driver<Job<CompleteScene>> for RefusedGpu {
+    type Resource=();
+    fn render(&mut self,frame:&Frame<Job<CompleteScene>>,cancel:&Cancellation)->Result<((),Descriptor),RenderError>{
+        let scene=frame.source.source();let(w,h)=scene.dimensions();
+        match self.prepare.prepare_cancellable(w,h,scene.scale(),scene.ops(),&||cancel.is_cancelled()) {
+            Ok(_)=>Err(RenderError::Fallback(FallbackReason::Unavailable)),
+            Err(GpuFallback::Cancelled)=>Err(RenderError::Cancelled),
+            Err(_)=>Err(RenderError::Fallback(FallbackReason::Unsupported)),
+        }
+    }
+}
+/// Full actual native ops travel through the bounded fallback worker. The GPU
+/// refusal is deliberately simulated; this is not hardware presentation evidence.
+pub fn check(frame:&RecordedFrame,expected:&[u8],number:usize) {
+    let budget=Budget::new(512<<20);let gb=budget.clone();let cb=budget.clone();
+    let gpu=worker::spawn(Limits::default(),move||Ok(RefusedGpu{prepare:GpuPrepare::default(),_allowance:gb.reserve(64<<20).map_err(|_|"gpu cache allowance")?})).unwrap();
+    let cpu=worker::spawn(Limits::default(),move||Ok(Cpu::new(NativeRaster::new(&cb)?,cb))).unwrap();
+    let mut bridge=Bridge::new(gpu,cpu,4,Duration::from_secs(2));let w=bridge.open().unwrap();
+    let scene=CompleteScene::admit_full_recording(frame.width,frame.height,frame.scale as f32,frame.ops.clone(),&budget).unwrap();
+    let now=Instant::now();bridge.submit(w,scene,frame.width,frame.height,now).unwrap();
+    let end=now+Duration::from_secs(10);let ready=loop {
+        bridge.tick(Instant::now());if let Some(ready)=bridge.poll(){break ready}
+        assert!(Instant::now()<end,"native fallback did not progress");std::thread::sleep(Duration::from_millis(1));
+    };
+    assert_eq!(ready.route(),Route::Shm);let mut file=File::from(ready.descriptor().fd.try_clone().unwrap());
+    file.seek(SeekFrom::Start(0)).unwrap();let mut actual=Vec::new();file.read_to_end(&mut actual).unwrap();drop(file);
+    for pixel in actual.chunks_exact_mut(4){pixel.swap(0,2)}
+    assert_eq!(actual.len(),expected.len());assert!(actual==expected,"complete fallback differs scene {number}, byte {:?}",actual.iter().zip(expected).position(|(a,b)|a!=b));
+    if number==4 && std::env::var_os("HOTARU_ADMISSION_WAYLAND").is_some() {
+        let dir=std::path::PathBuf::from(std::env::var_os("HOTARU_ADMISSION_WAYLAND").unwrap());
+        std::fs::write(dir.join("expected.rgba"),expected).unwrap();
+        worker::present_shm::present(bridge,w,ready,&dir).unwrap();
+    } else {
+        let lease=bridge.commit(ready,Instant::now()).unwrap();bridge.close(w);bridge.released(lease);bridge.connection_lost();
+    }
+    let end=Instant::now()+Duration::from_secs(3);
+    while budget.used()!=0 {assert!(Instant::now()<end,"native cache/buffer reservation leaked: {}",budget.used());std::thread::sleep(Duration::from_millis(1));}
+}
