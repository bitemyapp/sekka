+/// Isolated complete-frame worker: replace only this thread's image cache with
+/// an explicitly budgeted cache. Default renderer configuration is unchanged.
+pub fn configure_thread_cache(budget:usize) {
+    CACHE.with(|cache|*cache.borrow_mut()=Cache{budget,..Cache::default()});
