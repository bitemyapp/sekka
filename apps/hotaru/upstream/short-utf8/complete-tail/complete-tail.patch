+#[test]
+#[cfg(not(miri))]
+fn common_mixed_guard_coverage() {
+    let pattern = "雪花 藍染 蛍 café e\u{301} 日本語 👩🏽‍💻\r\n".as_bytes();
+    for (bytes, rows) in [(2 * 1024 * 1024, 12), (8 * 1024 * 1024, 80)] {
+        let input = pattern.repeat(bytes / pattern.len());
+        let mut terminal = super::Terminal::new(120, rows, 0);
+        COVERAGE.with(|cell| cell.set(Some((0, 0))));
+        for chunk in input.chunks(65536) {
+            terminal.feed(chunk);
+        }
+        let (calls, eligible) = COVERAGE.with(|cell| cell.replace(None).unwrap());
+        eprintln!(
+            "coverage rows={rows} bytes={} calls={calls} eligible={eligible}",
+            input.len()
+        );
+        assert!(calls > 0);
+    }
+}
