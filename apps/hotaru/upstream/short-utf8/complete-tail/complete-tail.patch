+#[test]
+#[cfg(not(miri))]
+fn guard_matches_standard_suffix_scalar_definition() {
+    fn check(bytes: &[u8]) {
+        let expected = (1..=4).any(|width| {
+            bytes.len().checked_sub(width).is_some_and(|start| {
+                std::str::from_utf8(&bytes[start..]).is_ok_and(|text| text.chars().count() == 1)
+            })
+        });
+        assert_eq!(super::complete_utf8_tail(bytes), expected, "{bytes:02x?}");
+    }
+    for scalar in (0..=0x10ffff).filter_map(char::from_u32) {
+        let mut storage = [0; 4];
+        let bytes = scalar.encode_utf8(&mut storage).as_bytes();
+        for cut in 0..=bytes.len() {
+            check(&bytes[..cut]);
+        }
+    }
+    // Exact UTF-8 boundary classes, every length through four bytes. The
+    // independent standard decoder checks suffixes rather than our ranges.
+    let classes = [
+        0x00, 0x7f, 0x80, 0x8f, 0x90, 0x9f, 0xa0, 0xbf, 0xc0, 0xc1, 0xc2, 0xdf, 0xe0, 0xe1, 0xec,
+        0xed, 0xee, 0xef, 0xf0, 0xf1, 0xf3, 0xf4, 0xf5, 0xff,
+    ];
+    for a in classes {
+        for b in classes {
+            for c in classes {
+                for d in classes {
+                    let bytes = [a, b, c, d];
+                    for len in 0..=4 {
+                        check(&bytes[..len]);
+                    }
+                }
+            }
+        }
+    }
+}
