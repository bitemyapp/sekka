-// Keep validation's dispatch/error paths out of the parser's ASCII/control
-// loop. This call is reached only for candidate non-ASCII text runs.
+// This conservative guard reads only the final four byte positions. A complete
+// final scalar prevents an incomplete UTF-8 suffix, even if earlier bytes fail.
+fn complete_utf8_tail(bytes: &[u8]) -> bool {
+    matches!(
+        bytes,
+        [.., 0x00..=0x7f]
+            | [.., 0xc2..=0xdf, 0x80..=0xbf]
+            | [.., 0xe0, 0xa0..=0xbf, 0x80..=0xbf]
+            | [.., 0xe1..=0xec | 0xee..=0xef, 0x80..=0xbf, 0x80..=0xbf]
+            | [.., 0xed, 0x80..=0x9f, 0x80..=0xbf]
+            | [.., 0xf0, 0x90..=0xbf, 0x80..=0xbf, 0x80..=0xbf]
+            | [.., 0xf1..=0xf3, 0x80..=0xbf, 0x80..=0xbf, 0x80..=0xbf]
+            | [.., 0xf4, 0x80..=0x8f, 0x80..=0xbf, 0x80..=0xbf]
+    )
+}
+
+// Keep bounded SIMD dispatch out of the ASCII/control loop.
 #[inline(never)]
+#[allow(unsafe_code)] // The validated original-prefix conversion below.
 fn validate_utf8_run(bytes: &[u8]) -> Result<&str, simdutf8::compat::Utf8Error> {
+    let eligible = (32..64).contains(&bytes.len())
+        && (0xc2..=0xf4).contains(&bytes[0])
+        && complete_utf8_tail(bytes);
+    #[cfg(test)]
+    short_utf8_tests::record_validation(eligible);
+    if eligible {
+        let mut block = [0u8; 64];
+        block[..bytes.len()].copy_from_slice(bytes);
+        match simdutf8::compat::from_utf8(&block) {
+            Ok(_) => {
+                // SAFETY: initialized ASCII padding cannot complete or repair
+                // an invalid original prefix. The returned string borrows the
+                // validated original input and never the temporary block.
+                return Ok(unsafe { std::str::from_utf8_unchecked(bytes) });
+            }
+            // A complete final scalar rules out an incomplete suffix. Any error
+            // starts and is diagnosed within the original, so NUL padding
+            // preserves both error offset and error length unchanged.
+            Err(error) => return Err(error),
+        }
+    }
     simdutf8::compat::from_utf8(bytes)
 }
