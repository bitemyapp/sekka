+thread_local! {
+    static COVERAGE: std::cell::Cell<Option<(usize, usize)>> = const { std::cell::Cell::new(None) };
+}
+
+pub(super) fn record_validation(eligible: bool) {
+    COVERAGE.with(|cell| {
+        if let Some((calls, hits)) = cell.get() {
+            cell.set(Some((calls + 1, hits + usize::from(eligible))));
+        }
+    });
+}
