+#[test]
+#[cfg(not(miri))]
+fn exhaustive_three_byte_suffixes_at_both_padding_boundaries() {
+    // Every possible incomplete UTF-8 prefix has at most three bytes. These
+    // suffixes include invalid leads and restricted second continuations,
+    // where translating Some(1) to None would be wrong.
+    for len in [32, 63] {
+        let mut bytes = vec![b'x'; len];
+        bytes[..2].copy_from_slice("é".as_bytes());
+        for value in 0..=0x00ff_ffffu32 {
+            bytes[len - 3..].copy_from_slice(&value.to_le_bytes()[..3]);
+            compare(&bytes);
+        }
+    }
+}
+
+#[test]
+#[cfg(not(miri))]
+fn every_unicode_scalar_and_truncated_prefix() {
+    for scalar in (0..=0x10ffff).filter_map(char::from_u32) {
+        let mut storage = [0; 4];
+        let encoded = scalar.encode_utf8(&mut storage).as_bytes();
+        for len in [31, 32, 63, 64] {
+            let mut bytes = [b'x'; 64];
+            bytes[..2].copy_from_slice("é".as_bytes());
+            for take in 1..=encoded.len() {
+                bytes[len - 4..len].fill(b'x');
+                bytes[len - take..len].copy_from_slice(&encoded[..take]);
+                compare(&bytes[..len]);
+            }
+        }
+    }
+}
+
+#[test]
+fn final_valid_lead_and_invalid_lead_have_different_error_lengths() {
+    let mut bytes = [b'x'; 32];
+    bytes[..2].copy_from_slice("é".as_bytes());
+    for last in 0..=u8::MAX {
+        bytes[31] = last;
+        compare(&bytes);
+        if (0xc2..=0xf4).contains(&last) {
+            assert_eq!(validate_utf8_run(&bytes).unwrap_err().error_len(), None);
+        } else if last >= 0x80 {
+            assert_eq!(validate_utf8_run(&bytes).unwrap_err().error_len(), Some(1));
+        }
+    }
+}
+
+fn compare(bytes: &[u8]) {
+    let standard = std::str::from_utf8(bytes).map_err(|e| (e.valid_up_to(), e.error_len()));
+    let actual = validate_utf8_run(bytes).map_err(|e| (e.valid_up_to(), e.error_len()));
+    assert_eq!(actual, standard, "input={bytes:02x?}");
+    if let Ok(text) = actual {
+        // A successful result must borrow the original input, not stack padding.
+        assert_eq!(text.as_ptr(), bytes.as_ptr());
+        assert_eq!(text.len(), bytes.len());
+    }
+}
