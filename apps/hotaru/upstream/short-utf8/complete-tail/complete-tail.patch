+#[test]
+fn complete_tail_keeps_earlier_malformed_error_boundaries() {
+    for prefix in [
+        &[0xc2, 0xff][..],
+        &[0xe0, 0x80, 0x80],
+        &[0xed, 0xa0, 0x80],
+        &[0xf0, 0x80, 0x80, 0x80],
+        &[0xf4, 0x90, 0x80, 0x80],
+        &[0xe1, 0x80, b'X'],
+        &[0xf1, 0x80, 0x80, b'X'],
+    ] {
+        for len in [31, 32, 33, 63, 64] {
+            for tail in ["A", "é", "雪", "👩"] {
+                let mut bytes = vec![b'x'; len];
+                bytes[..prefix.len()].copy_from_slice(prefix);
+                bytes[len - tail.len()..].copy_from_slice(tail.as_bytes());
+                compare(&bytes);
+            }
+        }
+    }
