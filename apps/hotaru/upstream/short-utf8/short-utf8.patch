 // Keep validation's dispatch/error paths out of the parser's ASCII/control
 // loop. This call is reached only for candidate non-ASCII text runs.
 #[inline(never)]
+#[allow(unsafe_code)] // Only the validated original-prefix conversion below.
 fn validate_utf8_run(bytes: &[u8]) -> Result<&str, simdutf8::compat::Utf8Error> {
+    if (32..64).contains(&bytes.len()) && (0xc2..=0xf4).contains(&bytes[0]) {
+        // The dependency uses scalar validation below one 64-byte SIMD block.
+        // Pad short terminal text spans with ASCII NULs to use its existing
+        // bounded block validator. Impossible leading bytes keep the original
+        // cheap error path. No input byte is read beyond the slice.
+        let mut block = [0u8; 64];
+        block[..bytes.len()].copy_from_slice(bytes);
+        if simdutf8::compat::from_utf8(&block).is_ok() {
+            // SAFETY: the validated block starts with exactly `bytes`, and its
+            // remaining bytes are ASCII NULs. NUL cannot complete an unfinished
+            // multibyte scalar, so a valid block proves that `bytes` ends on a
+            // scalar boundary and is itself valid UTF-8. The returned lifetime
+            // belongs to the original input, never to the temporary block.
+            return Ok(unsafe { std::str::from_utf8_unchecked(bytes) });
+        }
+        // Padding changes an incomplete suffix into an invalid sequence; use
+        // the original slice to preserve compat's precise error_len/offset.
+    }
     simdutf8::compat::from_utf8(bytes)
 }
