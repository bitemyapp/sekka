+#[test]
+fn thresholds_nuls_and_all_truncated_suffix_offsets() {
+    for len in [
+        0, 1, 2, 3, 4, 15, 16, 30, 31, 32, 33, 47, 62, 63, 64, 65, 127,
+    ] {
+        let mut bytes = vec![b'x'; len];
+        compare(&bytes);
+        bytes.fill(0);
+        compare(&bytes);
+        for scalar in [
+            '\0',
+            'a',
+            '\u{80}',
+            'é',
+            '\u{7ff}',
+            '\u{800}',
+            '雪',
+            '\u{ffff}',
+            '\u{10000}',
+            '👩',
+            '\u{10ffff}',
+        ] {
+            let mut encoded = [0; 4];
+            let encoded = scalar.encode_utf8(&mut encoded).as_bytes();
+            for prefix in 1..=encoded.len().min(len) {
+                bytes.fill(b'x');
+                if len >= 2 {
+                    bytes[..2].copy_from_slice("é".as_bytes());
+                }
+                bytes[len - prefix..].copy_from_slice(&encoded[..prefix]);
+                compare(&bytes);
+                // All possible suffix cuts and adjacent ASCII NULs exercise
+                // the premise used by the unchecked conversion.
+                if len > prefix {
+                    bytes[len - prefix - 1] = 0;
+                    compare(&bytes);
+                }
+            }
+        }
+        for value in [0x80, 0xbf, 0xc0, 0xc1, 0xf5, 0xff] {
+            if let Some(last) = bytes.last_mut() {
+                *last = value;
+                compare(&bytes);
+            }
+        }
+    }
+}
