@@ -0,0 +1,148 @@
+use super::validate_utf8_run;
+
+fn compare(bytes: &[u8]) {
+    let standard = std::str::from_utf8(bytes).map_err(|e| (e.valid_up_to(), e.error_len()));
+    let actual = validate_utf8_run(bytes).map_err(|e| (e.valid_up_to(), e.error_len()));
+    assert_eq!(actual, standard, "input={bytes:02x?}");
+    if let Ok(text) = actual {
+        // A successful result must borrow the original input, not stack padding.
+        assert_eq!(text.as_ptr(), bytes.as_ptr());
+        assert_eq!(text.len(), bytes.len());
+    }
+}
