+#[test]
+#[cfg(not(miri))]
+fn exhaustive_pair_values_at_short_run_edges() {
+    for len in [31, 32, 33, 47, 63, 64] {
+        let mut bytes = vec![b'x'; len];
+        for at in [0, len - 2] {
+            bytes[..2].copy_from_slice("é".as_bytes());
+            for value in 0..=u16::MAX {
+                bytes[at..at + 2].copy_from_slice(&value.to_le_bytes());
+                compare(&bytes);
+            }
+            bytes[at..at + 2].fill(b'x');
+        }
+    }
+}
