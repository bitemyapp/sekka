+    fn padded(error: simdutf8::compat::Utf8Error, bytes: &[u8]) -> Self {
+        let mut result = Self::original(error);
+        // Padding preserves the first invalid sequence's start. A valid
+        // multibyte lead is truncated iff its acceptable prefix reaches the
+        // original end and the first NUL is the invalid continuation. Invalid
+        // leads consume one byte even at EOF, so they must not become None.
+        if result.error_len.is_some_and(|length| {
+            result.valid_up_to.checked_add(usize::from(length)) == Some(bytes.len())
+        }) && bytes
+            .get(result.valid_up_to)
+            .is_some_and(|byte| (0xc2..=0xf4).contains(byte))
+        {
+            result.error_len = None;
+        }
+        result
+    }
