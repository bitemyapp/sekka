+#[test]
+#[cfg(not(miri))]
+fn seeded_unaligned_short_runs_and_mutations() {
+    let text = "é\0ASCII 雪 👩🏽‍💻 e\u{301}".as_bytes();
+    let mut seed = 0x2931_92b7u32;
+    for case in 0..65_536 {
+        seed ^= seed << 13;
+        seed ^= seed >> 17;
+        seed ^= seed << 5;
+        let len = case % 129;
+        let offset = (case >> 7) % 32;
+        let mut storage = vec![0; offset + len];
+        let bytes = &mut storage[offset..];
+        for (at, byte) in bytes.iter_mut().enumerate() {
+            *byte = text[at % text.len()];
+        }
+        compare(bytes);
+        if len != 0 {
+            bytes[seed as usize % len] = (seed >> 24) as u8;
+            compare(bytes);
+        }
+    }
+}
