+#[test]
+#[cfg(all(target_os = "linux", not(miri)))]
+#[allow(unsafe_code)] // Test-only OS guard page, owned by the Mapping guard.
+fn original_slice_can_end_at_unreadable_guard_page() {
+    // SAFETY: sysconf takes no pointers; mmap result is checked before use.
+    let page = unsafe { libc::sysconf(libc::_SC_PAGESIZE) } as usize;
+    assert!(page > 512 && page <= isize::MAX as usize / 2);
+    let raw = unsafe {
+        libc::mmap(
+            std::ptr::null_mut(),
+            page * 2,
+            libc::PROT_READ | libc::PROT_WRITE,
+            libc::MAP_PRIVATE | libc::MAP_ANONYMOUS,
+            -1,
+            0,
+        )
+    };
+    assert_ne!(raw, libc::MAP_FAILED);
+    struct Mapping(*mut libc::c_void, usize);
+    impl Drop for Mapping {
+        fn drop(&mut self) {
+            // SAFETY: this guard owns the original mapping and extent.
+            assert_eq!(unsafe { libc::munmap(self.0, self.1) }, 0);
+        }
+    }
+    let _mapping = Mapping(raw, page * 2);
+    // SAFETY: second page is a page-aligned subrange of this mapping.
+    assert_eq!(
+        unsafe { libc::mprotect(raw.cast::<u8>().add(page).cast(), page, libc::PROT_NONE) },
+        0
+    );
+    // SAFETY: first page remains exclusive and writable; initialize before read.
+    let memory = unsafe { std::slice::from_raw_parts_mut(raw.cast::<u8>(), page) };
+    memory.fill(0);
+    let pattern = "é雪👩".as_bytes();
+    for len in 0..=128 {
+        let bytes = &mut memory[page - len..];
+        for (at, byte) in bytes.iter_mut().enumerate() {
+            *byte = pattern[at % pattern.len()];
+        }
+        compare(bytes);
+        if let Some(last) = bytes.last_mut() {
+            *last = 0xff;
+            compare(bytes);
+        }
+    }
+}
