+#[allow(unsafe_code)] // Only the validated original-prefix conversion below.
+fn validate_utf8_run(bytes: &[u8]) -> Result<&str, Utf8RunError> {
+    if (32..64).contains(&bytes.len()) && (0xc2..=0xf4).contains(&bytes[0]) {
+        let mut block = [0u8; 64];
+        block[..bytes.len()].copy_from_slice(bytes);
+        match simdutf8::compat::from_utf8(&block) {
+            Ok(_) => {
+                // SAFETY: block contains exactly bytes followed by ASCII NULs.
+                // NUL cannot complete a truncated multibyte scalar or repair
+                // earlier invalid input. Validation therefore proves bytes is
+                // valid UTF-8 and ends on a scalar boundary. The result borrows
+                // the original input, never the temporary padded block.
+                return Ok(unsafe { std::str::from_utf8_unchecked(bytes) });
+            }
+            Err(error) => return Err(Utf8RunError::padded(error, bytes)),
+        }
+    }
+    simdutf8::compat::from_utf8(bytes).map_err(Utf8RunError::original)
+}
