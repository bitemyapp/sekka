diff --git a/apps/hotaru/crates/hotaru-core/src/page_diagnostics.rs b/apps/hotaru/crates/hotaru-core/src/page_diagnostics.rs
--- /dev/null
+++ b/apps/hotaru/crates/hotaru-core/src/page_diagnostics.rs
@@ -0,0 +1,17 @@
+//! Development-only counters. Clock/atomic overhead makes these diagnostic,
+//! not acceptance timings. Normal builds compile every hook away.
+use std::sync::atomic::{AtomicU64, Ordering};
+use std::time::Instant;
+static COUNTERS: [AtomicU64; 13] = [const { AtomicU64::new(0) }; 13];
+pub(crate) fn add(index: usize, value: u64) {
+    COUNTERS[index].fetch_add(value, Ordering::Relaxed);
+}
+pub(crate) fn elapsed(index: usize, start: Instant) {
+    add(index, start.elapsed().as_nanos() as u64);
+}
+/// Counters: sealed blocks, mapped bytes, map/copy/protect/seal nanoseconds,
+/// decoded blocks, raw decoded bytes, LZ4/links/rows/total decode nanoseconds,
+/// and failed sealing attempts. Only for isolated single-process experiments.
+pub fn take_page_diagnostics() -> [u64; 13] {
+    std::array::from_fn(|index| COUNTERS[index].swap(0, Ordering::Relaxed))
+}
