 pub(crate) struct CellPage(PageBacking);
+#[cfg(not(miri))]
+type BuilderBacking = MmapMut;
+#[cfg(miri)]
+type BuilderBacking = Vec<Cell>;
+
+/// Private, exclusively owned writable storage. No view can outlive this
+/// builder or escape across finish, which consumes it into an immutable page.
+pub(crate) struct CellPageBuilder(BuilderBacking);
+impl CellPageBuilder {
+    pub(crate) fn new(count: usize) -> io::Result<Self> {
+        if count == 0 || count > MAX_CELLS {
+            return Err(io::ErrorKind::InvalidInput.into());
+        }
+        #[cfg(test)]
+        injected_failure(PageFailure::Map)?;
+        #[cfg(not(miri))]
+        {
+            let bytes = count
+                .checked_mul(size_of::<Cell>())
+                .ok_or(io::ErrorKind::InvalidInput)?;
+            let mut mapping = MmapMut::map_anon(bytes)?;
+            bytemuck::try_cast_slice_mut::<u8, Cell>(&mut mapping)
+                .map_err(|_| io::ErrorKind::InvalidData)?;
+            Ok(Self(mapping))
+        }
+        #[cfg(miri)]
+        {
+            Ok(Self(vec![Cell::default(); count]))
+        }
+    }
+    pub(crate) fn cells_mut(&mut self) -> &mut [Cell] {
+        #[cfg(not(miri))]
+        {
+            bytemuck::try_cast_slice_mut(&mut self.0).expect("validated cell builder alignment")
+        }
+        #[cfg(miri)]
+        {
+            &mut self.0
+        }
+    }
+    pub(crate) fn finish(self) -> io::Result<Arc<CellPage>> {
+        #[cfg(test)]
+        injected_failure(PageFailure::Protect)?;
+        #[cfg(not(miri))]
+        {
+            Ok(Arc::new(CellPage(self.0.make_read_only()?)))
+        }
+        #[cfg(miri)]
+        {
+            Ok(Arc::new(CellPage(self.0.into_boxed_slice())))
+        }
+    }
+}
+
+#[cfg(test)]
+#[derive(Clone, Copy, PartialEq, Eq)]
+pub(crate) enum PageFailure {
+    Map,
+    Protect,
+}
+#[cfg(test)]
+std::thread_local! { static PAGE_FAILURE: std::cell::Cell<Option<PageFailure>> = const { std::cell::Cell::new(None) }; }
+#[cfg(test)]
+fn injected_failure(stage: PageFailure) -> io::Result<()> {
+    PAGE_FAILURE.with(|failure| {
+        if failure.get() == Some(stage) {
+            failure.set(None);
+            Err(io::ErrorKind::OutOfMemory.into())
+        } else {
+            Ok(())
+        }
+    })
+}
+#[cfg(test)]
+pub(crate) fn with_page_failure<R>(stage: PageFailure, run: impl FnOnce() -> R) -> R {
+    struct Restore(Option<PageFailure>);
+    impl Drop for Restore {
+        fn drop(&mut self) {
+            PAGE_FAILURE.with(|f| f.set(self.0));
+        }
+    }
+    let _restore = Restore(PAGE_FAILURE.with(|f| f.replace(Some(stage))));
+    run()
+}
