+fn decode_rows_page(
+    input: &[u8],
+    rows: usize,
+    links: &[LinkRef],
+    budget: usize,
+) -> Option<Vec<RowRef>> {
+    if rows == 0 || rows > MAX_ROWS {
+        return None;
+    }
+    let mut scan = input;
+    let mut layouts = Vec::with_capacity(rows);
+    let mut total = 0usize;
+    for _ in 0..rows {
+        let start = input.len().checked_sub(scan.len())?;
+        let cols = Row::scan_history_layout(&mut scan)?;
+        let end = input.len().checked_sub(scan.len())?;
+        let next = total.checked_add(cols)?;
+        if next > MAX_ROWS * crate::MAX_COLS {
+            return None;
+        }
+        layouts.push((start..end, total..next));
+        total = next;
+    }
+    if !scan.is_empty() {
+        return None;
+    }
+    // Every valid row has positive width, as in the original heap decoder.
+    let mut builder = match crate::cells::CellPageBuilder::new(total) {
+        Ok(builder) => builder,
+        Err(_) => return decode_rows_heap(input, rows, links, budget),
+    };
+    let mut remaining = budget;
+    let mut parts = Vec::with_capacity(rows);
+    {
+        let cells = builder.cells_mut();
+        for (encoded, range) in &layouts {
+            let mut encoded = input.get(encoded.clone())?;
+            let part = Row::decode_history_into(
+                &mut encoded,
+                links,
+                &mut remaining,
+                cells.get_mut(range.clone())?,
+            )?;
+            if !encoded.is_empty() {
+                return None;
+            }
+            parts.push(part);
+        }
+    } // All mutable builder slices end before mprotect/immutable publication.
+    let page = match builder.finish() {
+        Ok(page) => page,
+        Err(_) => {
+            // Drop partial metadata before retry, keeping peak restoration
+            // ownership bounded by one complete decoding attempt.
+            drop(parts);
+            return decode_rows_heap(input, rows, links, budget);
+        }
+    };
+    let mut result = Vec::with_capacity(rows);
+    for (part, (_, range)) in parts.into_iter().zip(layouts) {
+        let cells = crate::cells::CellBuffer::frozen(page.clone(), range, part.cells_capacity())?;
+        result.push(RowRef::new(part.finish(cells)?));
+    }
+    Some(result)
 }
 
