+// Short ASCII fragments stay in the existing UTF-8 loop; a longer prefix
+// amortizes the ASCII path's row bookkeeping and uses its packed cell stores.
+// This scans only at ASCII entry, never the whole non-ASCII input repeatedly.
+fn long_ascii_prefix(text: &str) -> usize {
+    const MIN: usize = 16;
+    let bytes = text.as_bytes();
+    if bytes.len() < MIN || !bytes[0].is_ascii() {
+        return 0;
+    }
+    let count = crate::scan::printable_ascii(bytes);
+    if count >= MIN { count } else { 0 }
