+#[test]
+fn interior_ascii_preserves_unicode_wrap_charset_and_rep_across_chunks() {
+    let bodies = [
+        "雪{ascii}\u{301}\x1b[3b",
+        "\u{600}{ascii}\x1b[2b",
+        "雪{ascii}1\u{fe0f}\u{20e3}\x1b[2b",
+        "雪{ascii}\u{fe0f}日",
+        "雪{ascii}\u{80}\x1b[2b",
+        "雪{ascii}👩🏽‍💻end",
+        "\x1b(0雪{ascii}x\x1b(B",
+        "\x1b(A雪{ascii}#\x1b(B",
+        "\x1b*0\x1bN雪{ascii}x",
+        "\x1b[4h雪{ascii}\x1b[4l",
+        "\x1b[1\"q雪{ascii}\x1b[0\"q",
+    ];
+    for mode in [GraphemeWidthMethod::Legacy, GraphemeWidthMethod::Unicode] {
+        for cols in [1, 2, 7, 16, 80] {
+            for nowrap in [false, true] {
+                for count in [15, 16, 17, 48] {
+                    for body in bodies {
+                        let mut data = if nowrap { b"\x1b[?7l".to_vec() } else { vec![] };
+                        data.extend(body.replace("{ascii}", &"a".repeat(count)).as_bytes());
+                        data.extend(b"\x1b[6n");
+                        for chunk in [1, 7, 16, 31] {
+                            let mut whole = Terminal::new(cols, 3, 32);
+                            let mut split = Terminal::new(cols, 3, 32);
+                            for t in [&mut whole, &mut split] {
+                                t.set_default_grapheme_width(mode);
+                                t.feed("old 雪雪\r\nline\r".as_bytes());
+                            }
+                            whole.feed(&data);
+                            for part in data.chunks(chunk) {
+                                split.feed(part);
+                            }
+                            same(&mut whole, &mut split);
+                        }
+                    }
+                }
+            }
+        }
+    }
+}
