+#[test]
+fn interior_ascii_preserves_metadata_peaks_cow_and_compressed_history() {
+    for limit in [Some(12_000), None] {
+        for chunk in [1, 7, 16, 65_536] {
+            for mode in [GraphemeWidthMethod::Legacy, GraphemeWidthMethod::Unicode] {
+                let limits = HistoryLimits {
+                    rows: 1000,
+                    bytes: limit,
+                };
+                let mut whole = Terminal::with_history_limits(80, 4, limits);
+                let mut split = Terminal::with_history_limits(80, 4, limits);
+                for t in [&mut whole, &mut split] {
+                    t.set_default_grapheme_width(mode);
+                    for _ in 0..180 {
+                        t.feed(b"historical text\r\n");
+                    }
+                    while t.compress_history_step() {}
+                }
+                let held = (whole.content_snapshot(), split.content_snapshot());
+                for i in 0..96 {
+                    let setup = format!(
+                        "\r\x1b]8;id={i};https://example.test/{i}\x1b\\\x1b[38;5;{};44m雪雪e{}\x1b]8;;\x1b\\\r",
+                        i % 16,
+                        "\u{301}".repeat(i % 31)
+                    );
+                    let write = format!("\x1b[31;44m雪{}\u{301}\x1b[2b\r\n", "a".repeat(48));
+                    for data in [setup.as_bytes(), write.as_bytes()] {
+                        let render = (whole.snapshot(), split.snapshot());
+                        whole.feed(data);
+                        for part in data.chunks(chunk) {
+                            split.feed(part);
+                        }
+                        same(&mut whole, &mut split);
+                        assert_eq!(render.0.plain_text(), render.1.plain_text());
+                    }
+                    if i % 17 == 0 {
+                        for t in [&mut whole, &mut split] {
+                            while t.compress_history_step() {}
+                        }
+                        same(&mut whole, &mut split);
+                    }
+                }
+                assert_eq!(held.0.rows, held.1.rows);
+                for (a, b) in held.0.rows().zip(held.1.rows()) {
+                    assert_eq!(a.cells(), b.cells());
+                }
+            }
+        }
+    }
