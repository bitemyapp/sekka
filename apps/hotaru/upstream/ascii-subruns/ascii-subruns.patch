+use hotaru_core::{GraphemeWidthMethod, HistoryLimits, Terminal};
+
+fn same(a: &mut Terminal, b: &mut Terminal) {
+    let x = a.snapshot_all();
+    let y = b.snapshot_all();
+    assert_eq!((x.cols, x.rows, x.cursor), (y.cols, y.rows, y.cursor));
+    assert_eq!(x.modes, y.modes);
+    assert_eq!(x.palette, y.palette);
+    assert_eq!(a.scrollback_len(), b.scrollback_len());
+    assert_eq!(
+        a.history_memory().active_bytes,
+        b.history_memory().active_bytes
+    );
+    assert_eq!(
+        a.history_memory().logical_bytes,
+        b.history_memory().logical_bytes
+    );
+    assert_eq!(x.lines.len(), y.lines.len());
+    for (x, y) in x.lines.iter().zip(&y.lines) {
+        assert_eq!(x.wrapped(), y.wrapped());
+        assert_eq!(x.cells(), y.cells());
+        for col in 0..x.cells().len() {
+            assert_eq!(x.style(x.cells()[col]), y.style(y.cells()[col]));
+            assert_eq!(x.grapheme(col), y.grapheme(col));
+            assert_eq!(x.hyperlink(col), y.hyperlink(col));
+        }
+    }
+    assert_eq!(a.take_responses(), b.take_responses());
+    assert_eq!(a.take_events(), b.take_events());
+}
