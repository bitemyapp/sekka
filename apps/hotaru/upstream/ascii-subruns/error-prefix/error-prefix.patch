+#[test]
+fn long_dense_valid_prefix_before_error_matches_bytewise_and_boundary_chunks() {
+    for mode in [GraphemeWidthMethod::Legacy, GraphemeWidthMethod::Unicode] {
+        for suffix in [b"".as_slice(), b"abcdefghijklmnopabcdefghijklmnop"] {
+            let mut data = "雪".repeat(16_384).into_bytes();
+            data.extend(suffix);
+            data.extend(b"\xf0\x9f\r\n\x1b[6n");
+            for chunk in [1, 7, 65_535, 65_536] {
+                let mut whole = Terminal::new(120, 12, 1024);
+                let mut split = Terminal::new(120, 12, 1024);
+                whole.set_default_grapheme_width(mode);
+                split.set_default_grapheme_width(mode);
+                whole.feed(&data);
+                for part in data.chunks(chunk) {
+                    split.feed(part);
+                }
+                same(&mut whole, &mut split);
+            }
+        }
+    }
