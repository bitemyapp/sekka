+
+// A malformed sequence often follows a valid non-ASCII scalar and a longer
+// ASCII tail. Reuse the packed ASCII writer only on this error-prefix path;
+// ordinary valid UTF-8 printing keeps its existing implementation unchanged.
+#[inline(never)]
+fn print_prefix_before_error(state: &mut screen::State, text: &str) {
+    const MIN_ASCII: usize = 16;
+    let bytes = text.as_bytes();
+    let mut at = 0;
+    let mut pending = 0;
+    while at < bytes.len() {
+        // ASCII bytes cannot occur inside a multibyte UTF-8 scalar. Thus each
+        // ASCII start and end below is a valid boundary in the borrowed str.
+        if !bytes[at].is_ascii() {
+            at += 1;
+            continue;
+        }
+        let count = scan::printable_ascii(&bytes[at..]);
+        if count >= MIN_ASCII {
+            if pending < at {
+                state.print_utf8(&text[pending..at]);
+            }
+            state.print_ascii(&bytes[at..at + count]);
+            at += count;
+            pending = at;
+        } else {
+            // Input comes from the existing control-free scanner; the max
+            // also makes this local traversal progress on any ASCII control.
+            at += count.max(1);
+        }
+    }
+    if pending < text.len() {
+        state.print_utf8(&text[pending..]);
+    }
