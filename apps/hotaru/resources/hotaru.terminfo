# Hotaru's implemented Linux terminal capabilities.
# Based on Ghostty's MIT-licensed src/terminfo/ghostty.zig, pinned in
# upstream/ghostty.json. Keep LICENSE.ghostty with distributions.
# Deliberately omit OSC52, synchronized output, horizontal margins, cursor
# shapes/blinking and repeat-character: native behavior is not qualified yet.
xterm-hotaru|hotaru|Hotaru terminal,
    am, bce, ccc, km, mir, msgr, npc, xenl, AX, Tc, Su, fullkbd,
    colors#256, cols#80, it#8, lines#24, pairs#32767,
    acsc=``aaffgghhiijjkkllmmnnooppqqrrssttuuvvwwxxyyzz{{||}}~~,
    bel=^G, bold=\E[1m, dim=\E[2m, rev=\E[7m,
    sitm=\E[3m, ritm=\E[23m, smul=\E[4m, rmul=\E[24m,
    smso=\E[7m, rmso=\E[27m, invis=\E[8m,
    sgr0=\E(B\E[m, smacs=\E(0, rmacs=\E(B,
    clear=\E[H\E[2J, E3=\E[3J, ed=\E[J, el=\E[K, el1=\E[1K,
    cr=\r, nel=\EE, ind=\n, ri=\EM,
    cup=\E[%i%p1%d;%p2%dH, home=\E[H,
    hpa=\E[%i%p1%dG, vpa=\E[%i%p1%dd,
    cub=\E[%p1%dD, cub1=^H, cud=\E[%p1%dB, cud1=^J,
    cuf=\E[%p1%dC, cuf1=\E[C, cuu=\E[%p1%dA, cuu1=\E[A,
    sc=\E7, rc=\E8, csr=\E[%i%p1%d;%p2%dr,
    dl=\E[%p1%dM, dl1=\E[M, il=\E[%p1%dL, il1=\E[L,
    dch=\E[%p1%dP, dch1=\E[P, ich=\E[%p1%d@, ich1=\E[@,
    ech=\E[%p1%dX, indn=\E[%p1%dS, rin=\E[%p1%dT,
    smir=\E[4h, rmir=\E[4l,
    ht=^I, cbt=\E[Z, hts=\EH, tbc=\E[3g,
    civis=\E[?25l, cnorm=\E[?25h,
    smcup=\E[?1049h, rmcup=\E[?1049l,
    smkx=\E[?1h\E=, rmkx=\E[?1l\E>,
    op=\E[39;49m,
    setaf=\E[38;5;%p1%dm, setab=\E[48;5;%p1%dm,
    setrgbf=\E[38:2:%p1%d:%p2%d:%p3%dm,
    setrgbb=\E[48:2:%p1%d:%p2%d:%p3%dm,
    initc=\E]4;%p1%d;rgb\:%p2%{255}%*%{1000}%/%2.2X/%p3%{255}%*%{1000}%/%2.2X/%p4%{255}%*%{1000}%/%2.2X\E\\,
    oc=\E]104\007,
    Smulx=\E[4:%p1%dm, Smol=\E[53m, Rmol=\E[55m,
    Setulc=\E[58:2::%p1%{65536}%/%d:%p1%{256}%/%{255}%&%d:%p1%{255}%&%d%;m,
    smxx=\E[9m, rmxx=\E[29m,
    BD=\E[?2004l, BE=\E[?2004h, PS=\E[200~, PE=\E[201~,
    XM=\E[?1006;1000%?%p1%{1}%=%th%el%;,
    kmous=\E[<,
    fe=\E[?1004h, fd=\E[?1004l, kxIN=\E[I, kxOUT=\E[O,
    kbs=^?, kcbt=\E[Z, kcuu1=\EOA, kcud1=\EOB,
    kcuf1=\EOC, kcub1=\EOD, khome=\EOH, kend=\EOF,
    kich1=\E[2~, kdch1=\E[3~, kpp=\E[5~, knp=\E[6~,
    kf1=\EOP, kf2=\EOQ, kf3=\EOR, kf4=\EOS,
    kf5=\E[15~, kf6=\E[17~, kf7=\E[18~, kf8=\E[19~,
    kf9=\E[20~, kf10=\E[21~, kf11=\E[23~, kf12=\E[24~,
    u7=\E[6n, u9=\E[c,
