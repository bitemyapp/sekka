"""Sekka's Bazel module (docs/bazel-build-plan.md).

Nix provides the tools and C libraries, from the root flake's lock
(build/bazel/nix.bzl); Bazel builds and tests the components that migrate.
Cargo's manifests and locks stay the dependency inputs: crate_universe reads
them for crates.io's crates, and build/bazel/generate.py writes the BUILD
files of Sekka's own crates from `cargo metadata`.
"""

module(name = "sekka")

bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "bazel_skylib", version = "1.8.2")
bazel_dep(name = "rules_cc", version = "0.2.17")
bazel_dep(name = "rules_rust", version = "0.75.0")
bazel_dep(name = "rules_nixpkgs_core", version = "0.14.1")
bazel_dep(name = "rules_nixpkgs_cc", version = "0.14.1")
bazel_dep(name = "rules_nixpkgs_rust", version = "0.14.1")

# rules_nixpkgs at one commit of 2026-10-30 (after v0.14.1), which the
# 2026-11-03 probe used with Bazel 9. Only its core is in the Bazel Central
# Registry.
archive_override(
    module_name = "rules_nixpkgs_core",
    integrity = "sha256-3JptKk3jhvvXA/0sDC61XbR5GJruSVH4qdXz9hluUOQ=",
    strip_prefix = "rules_nixpkgs-58151f3745a1abe09277a6a8d0c58449018d2baa/core",
    urls = ["https://github.com/tweag/rules_nixpkgs/archive/58151f3745a1abe09277a6a8d0c58449018d2baa.tar.gz"],
)

archive_override(
    module_name = "rules_nixpkgs_cc",
    integrity = "sha256-3JptKk3jhvvXA/0sDC61XbR5GJruSVH4qdXz9hluUOQ=",
    strip_prefix = "rules_nixpkgs-58151f3745a1abe09277a6a8d0c58449018d2baa/toolchains/cc",
    urls = ["https://github.com/tweag/rules_nixpkgs/archive/58151f3745a1abe09277a6a8d0c58449018d2baa.tar.gz"],
)

archive_override(
    module_name = "rules_nixpkgs_rust",
    integrity = "sha256-3JptKk3jhvvXA/0sDC61XbR5GJruSVH4qdXz9hluUOQ=",
    strip_prefix = "rules_nixpkgs-58151f3745a1abe09277a6a8d0c58449018d2baa/toolchains/rust",
    urls = ["https://github.com/tweag/rules_nixpkgs/archive/58151f3745a1abe09277a6a8d0c58449018d2baa.tar.gz"],
)

nix = use_extension("//build/bazel:nix.bzl", "nix")
use_repo(nix, "nix_cc_info", "nix_cc_toolchains", "nix_native", "nix_rust", "nix_rust_toolchain", "nix_test_env", "nixpkgs")

register_toolchains(
    "@nix_rust_toolchain//:all",
    "@nix_cc_toolchains//:all",
)

# Aizome's crates.io and Git dependencies, as its Cargo.lock pins them.
# crate_universe resolves them from generate.py's mirror of the workspace
# (build/bazel/aizome-cargo), and only on a repin (build/bazel/repin.py), into
# build/bazel/aizome-crates.lock.json; builds read that lock.
crate = use_extension("@rules_rust//crate_universe:extensions.bzl", "crate")
crate.from_cargo(
    name = "aizome_crates",
    cargo_lockfile = "//desktop/aizome:Cargo.lock",
    # Repository evaluation must use the same Nix-pinned Cargo/rustc as actions;
    # upstream downloaded host tools require an ambient non-Nix ELF loader.
    host_tools = "@nix_rust//:BUILD.bazel",
    lockfile = "//build/bazel:aizome-crates.lock.json",
    manifests = ["//build/bazel/aizome-cargo:Cargo.toml"],
    supported_platform_triples = ["x86_64-unknown-linux-gnu"],
)
use_repo(crate, "aizome_crates")

# Build scripts that find C libraries with pkg-config, generate bindings or
# run tools by name get the package's native environment, declared here
# rather than found on the host (build/bazel/native.bzl,
# nix/bazel/toolchains.nix).

crate.annotation(
    build_script_env = {
        "PATH": "$(BUILD_PATH)",
        "PKG_CONFIG": "$(PKG_CONFIG)",
        "PKG_CONFIG_PATH": "$(PKG_CONFIG_PATH)",
    },
    build_script_toolchains = ["@@//build/bazel:native"],
