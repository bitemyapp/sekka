# libudev-sys links a test program with rustc to see whether udev has hwdb.
crate.annotation(
    build_script_env = {
        "LIBRARY_PATH": "$(LIBRARY_PATH)",
        "PATH": "$(BUILD_PATH)",
        "PKG_CONFIG": "$(PKG_CONFIG)",
        "PKG_CONFIG_PATH": "$(PKG_CONFIG_PATH)",
    },
    build_script_toolchains = ["@@//build/bazel:native"],
    crate = "libudev-sys",
)

# whisper.cpp for Koe, through CMake, with the package's settings
# (desktop/aizome/nix/package.nix): portable code, no -march. rules_rust
# gives build scripts the C++ toolchain's `-x c++` in CXXFLAGS, with which
# CMake would link objects as C++ source; `-x none` (appended) ends it.
crate.annotation(
    build_script_env = {
        "CXXFLAGS": "-x none",
        "CMAKE_PREFIX_PATH": "$(CMAKE_PREFIX_PATH)",
        "NIXPKGS_CMAKE_PREFIX_PATH": "$(NIXPKGS_CMAKE_PREFIX_PATH)",
        "BINDGEN_EXTRA_CLANG_ARGS": "$(BINDGEN_EXTRA_CLANG_ARGS)",
        "LIBCLANG_PATH": "$(LIBCLANG_PATH)",
        "BLAS_INCLUDE_DIRS": "$(BLAS_INCLUDE_DIRS)",
        "GGML_AVX": "$(GGML_AVX)",
        "GGML_AVX2": "$(GGML_AVX2)",
        "GGML_F16C": "$(GGML_F16C)",
        "GGML_FMA": "$(GGML_FMA)",
        "GGML_NATIVE": "$(GGML_NATIVE)",
        "OPENBLAS_PATH": "$(OPENBLAS_PATH)",
        "PATH": "$(BUILD_PATH)",
        "PKG_CONFIG": "$(PKG_CONFIG)",
        "PKG_CONFIG_PATH": "$(PKG_CONFIG_PATH)",
    },
    build_script_toolchains = ["@@//build/bazel:native"],
    crate = "whisper-rs-sys",
)

# The WebGL extensions' XML, which khronos_api's build script names by its
# own working directory: under Bazel, runfiles its library never sees.
crate.annotation(
    crate = "khronos_api",
    patch_args = ["-p1"],
    patches = ["@@//build/bazel/patches:khronos_api-manifest-dir.patch"],
)
