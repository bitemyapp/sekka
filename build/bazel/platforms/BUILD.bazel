# The platform Bazel builds for and on: x86_64 Linux with a Nix store, which
# the toolchains from Nixpkgs require (build/bazel/nix.bzl).
platform(
    name = "x86_64-linux-nix",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
        "@rules_nixpkgs_core//constraints:support_nix",
    ],
    # Identical scheduling properties for local/cache/RBE invocations: adding
    # them only on remote invocations would needlessly split the action cache.
    exec_properties = {
        "OSFamily": "linux",
        "ISA": "x86-64",
    },
    visibility = ["//visibility:public"],
)
