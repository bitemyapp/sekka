#!/usr/bin/env bash
# The root half of apply-configuration, which pkexec starts after the
# password dialog: keep the current files, install the new ones, apply them
# with Yukimi's helper, and put the files back unless the switch had begun.
#
#   install-configuration NIXOS HELPER [NAME FILE]...
set -u
PATH=/run/wrappers/bin:/run/current-system/sw/bin${PATH:+:$PATH}
if [ $# -lt 2 ] || [ $(($# % 2)) -ne 0 ]; then
  echo "Usage: install-configuration NIXOS HELPER [NAME FILE]..." >&2
  exit 2
fi
nixos=$1 helper=$2
shift 2
backup=$(mktemp -d) || exit 1
names=()
put_back() {
  for name in "${names[@]}"; do
    if [ -e "$backup/$name" ]; then
      cp -p "$backup/$name" "$nixos/$name"
    else
      rm -f "$nixos/$name"
    fi
  done
}
while [ $# -gt 0 ]; do
  names+=("$1")
  if [ -e "$nixos/$1" ]; then
    { mkdir -p "$backup/$(dirname "$1")" && cp -p "$nixos/$1" "$backup/$1"; } || exit 1
  fi
  if ! install -D -m 0644 "$2" "$nixos/$1"; then
    put_back
    exit 1
  fi
  shift 2
done
result=$("$helper" change --mode auto </dev/null)
status=$?
printf '%s\n' "$result"
if [ $status -ne 0 ]; then
  case $result in
    *"System changes had already begun"*) ;;
    *) put_back ;;
  esac
fi
rm -rf "$backup"
exit "$status"
