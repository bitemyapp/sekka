#!/usr/bin/env bash
# Apply edited files of Sekka's /etc/nixos as Yukimi applies its own changes:
# build the new system as the current user first, then, after one password
# in the desktop's dialog, put the files in place and let Yukimi's helper
# switch (or prepare the next start), putting the files back on failure.
set -euo pipefail

usage() {
  cat <<'EOF'
Usage: apply-configuration [--check] [NAME=FILE]...

Replace /etc/nixos/NAME with FILE for each NAME=FILE (for example
configuration.nix=/tmp/edit/configuration.nix, or a new module that the
configuration imports), build the system as you, then ask through the
desktop's password dialog to install the files and apply them with Yukimi's
helper: live when that is safe, otherwise for the next start. If anything
fails, the files are put back. With no NAME=FILE, it applies /etc/nixos as
it is.

  --check   stop after the build: nothing is installed, no password is asked
EOF
}

nixos=${SEKKA_NIXOS:-/etc/nixos}
helper=$(readlink -f "${YUKIMI_HELPER:-/run/current-system/sw/bin/yukimi-helper}")
check=false
names=()
files=()
for argument in "$@"; do
  case $argument in
    -h | --help)
      usage
      exit 0
      ;;
    --check) check=true ;;
    *=*)
      name=${argument%%=*}
      file=${argument#*=}
      case $name in
        flake.nix | flake.lock)
          echo "apply-configuration: $name belongs to Sekka; sekka-update changes it" >&2
          exit 2
          ;;
        yukimi.nix)
          echo "apply-configuration: yukimi.nix belongs to Yukimi; change software through it (yukimi skill)" >&2
          exit 2
          ;;
        /* | *..* | '' | *[!A-Za-z0-9._/-]*)
          echo "apply-configuration: $name isn't a file name inside $nixos" >&2
          exit 2
          ;;
      esac
      if [ ! -f "$file" ]; then
        echo "apply-configuration: $file doesn't exist" >&2
        exit 2
      fi
      names+=("$name")
      files+=("$(readlink -f "$file")")
      ;;
    *)
      usage >&2
      exit 2
      ;;
  esac
done

work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
mkdir "$work/nixos"
if ! cp -R "$nixos/." "$work/nixos/" 2>"$work/copy.log"; then
  echo "apply-configuration: couldn't read $nixos:" >&2
  cat "$work/copy.log" >&2
  exit 1
fi
chmod -R u+w "$work/nixos"
changed=false
for i in "${!names[@]}"; do
  target=$work/nixos/${names[$i]}
  mkdir -p "$(dirname "$target")"
  cp "${files[$i]}" "$target"
  if [ -e "$nixos/${names[$i]}" ]; then
    original=$nixos/${names[$i]}
  else
    original=/dev/null
  fi
  if ! diff -u --label "a/${names[$i]}" --label "b/${names[$i]}" "$original" "$target"; then
    changed=true
  fi
done
if [ ${#names[@]} -gt 0 ] && ! $changed; then
  echo "apply-configuration: the files are the same as in $nixos; applying it as it is"
fi

# The configuration named after this computer, or the only one, as Yukimi
# and nixos-rebuild choose it.
flake="path:$work/nixos"
host=$(nix eval --raw "$flake#nixosConfigurations" --apply "configurations:
  let names = builtins.attrNames configurations; host = \"$(</proc/sys/kernel/hostname)\"; in
  if builtins.elem host names then host
  else if builtins.length names == 1 then builtins.head names
  else \"\"" 2>"$work/eval.log") || {
  cat "$work/eval.log" >&2
  exit 1
}
if [ -z "$host" ]; then
  echo "apply-configuration: no configuration in $nixos is named $(</proc/sys/kernel/hostname)" >&2
  exit 1
fi

echo "Building the new system as $(id -un); nothing is changed yet."
if ! system=$(nix build --no-link --print-out-paths \
  "$flake#nixosConfigurations.\"$host\".config.system.build.toplevel" 2>"$work/build.log"); then
  echo "apply-configuration: the new configuration doesn't build; nothing was changed." >&2
  tail -n 60 "$work/build.log" >&2
  exit 1
fi
echo "Built $system"
if $check; then
  exit 0
fi

# Yukimi's helper reports progress as Nix's internal-json log: keep its
# stages, warnings and errors, readable, and leave out the rest.
decode() {
  sed -nE \
    -e '/^@nix /!{p;d}' \
    -e 's/^@nix \{"action":"start".*"level":0,.*"text":"(([^"\\]|\\.)*)".*/\1/p' \
    -e 's/^@nix \{"action":"msg".*"level":[0-3],.*"msg":"(([^"\\]|\\.)*)".*/\1/p' |
    sed -E -e 's/\\u001b\[[0-9;]*m//g' -e 's/\\n/\n/g' -e 's/\\t/\t/g' -e 's/\\"/"/g' -e 's/\\\\/\\/g'
}

pairs=()
for i in "${!names[@]}"; do
  pairs+=("${names[$i]}" "${files[$i]}")
done

echo "Asking for an administrator's password to apply it."
status=0
# The result on standard output, the progress decoded on standard error.
{
  pkexec --disable-internal-agent "$(dirname "$(readlink -f "$0")")/install-configuration" \
    "$nixos" "$helper" "${pairs[@]}" </dev/null 2>&1 1>&3 3>&- | decode >&2 3>&-
  status=${PIPESTATUS[0]}
} 3>&1 || true
case $status in
  0)
    sekka-update --status 2>/dev/null || true
    ;;
  126)
    echo "apply-configuration: the password dialog was dismissed; nothing was changed." >&2
    ;;
  127)
    echo "apply-configuration: no authorization. If pkexec said it must be setuid root, run this outside your sandbox; if no authentication agent was found, there is no desktop session to ask in." >&2
    ;;
  *)
    echo "apply-configuration: applying failed (above)." >&2
    ;;
esac
exit "$status"
