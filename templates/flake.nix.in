# Generated by Genkan. Update Sekka through Yukimi or `sekka-update`.
# This lock records the exact Sekka source and dependencies used by the media.
# Everything else follows Sekka: the revisions its nightly build checked and
# put in its binary cache, which updating Sekka moves together.
{
  inputs.sekka.url = "github:bitemyapp/sekka/nightly";
  inputs.nixpkgs.follows = "sekka/nixpkgs";
  inputs.determinate.follows = "sekka/determinate";
  inputs.fh.follows = "sekka/fh";
  inputs.applications.follows = "sekka/applications";
  inputs.ai-apps.follows = "sekka/ai-apps";
  inputs.omp.follows = "sekka/omp";

  outputs = { nixpkgs, determinate, fh, applications, ai-apps, omp, sekka, ... }:
  let system = "@SYSTEM@"; in {
    nixosConfigurations.@HOSTNAME@ = nixpkgs.lib.nixosSystem {
      inherit system;
      specialArgs = {
        applicationPkgs = import applications {
          inherit system;
          config.allowUnfree = true;
        };
        aiPackages = ai-apps.packages.${system};
        ompPackage = omp.packages.${system}.omp;
      };
      modules = [
        determinate.nixosModules.default
        sekka.nixosModules.default
        ./configuration.nix
        ({ pkgs, ... }: {
          environment.systemPackages = [ fh.packages.${pkgs.stdenv.hostPlatform.system}.default ];
        })
      ] ++ nixpkgs.lib.optional (system == "aarch64-linux") sekka.nixosModules.utm;
    };
  };
}
