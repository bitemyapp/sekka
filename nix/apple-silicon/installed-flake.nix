# The installed flake a Mac image ships in /etc/nixos: Genkan's own template
# (templates/flake.nix.in), rendered for another system and update branch,
# and the lock nix/installed-lock.nix derives from the image's own source.
#
# Only the system, the branch Sekka follows and the header comment change.
# The template's inputs (Sekka plus the six Genkan's parser requires to
# follow Sekka's) and its module list stay exactly as they are, so the
# installed lock passes the same Template::parse check as on PCs
# (tests.nix), and Yukimi treats the flake as it treats a PC's.
{
  lib,
  self,
  system ? "aarch64-linux",
  # Until the platform is on main, Macs follow the Apple integration branch.
  ref ? "fix/apple-silicon-aizome",
  hostname ? "sekka",
}:
let
  source = builtins.readFile ../../templates/flake.nix.in;
  # Replace `from` exactly `count` times, so a changed template fails here
  # rather than rendering a flake nobody reviewed.
  replace =
    text:
    {
      from,
      to,
      count,
    }:
    let
      found = builtins.length (lib.splitString from text) - 1;
    in
    if found != count then
      throw "templates/flake.nix.in: expected ${toString count} of `${from}`, found ${toString found}"
    else
      builtins.replaceStrings [ from ] [ to ] text;
  # The template with its @HOSTNAME@ placeholder, as Genkan's parser reads it.
  template = builtins.foldl' replace source [
    {
      from = "# Generated by Genkan.";
      to = "# Shipped with Sekka's Mac image (nix/apple-silicon).";
      count = 1;
    }
    {
      from = "used by the media.";
      to = "the image was built from.";
      count = 1;
    }
    {
      # The Apple branch has no nightly build or aarch64 cache behind it yet.
      from = "the revisions its nightly build checked and\n# put in its binary cache, which updating Sekka moves together.";
      to = "the revisions it was built and tested with,\n# which updating Sekka moves together.";
      count = 1;
    }
    {
      from = "\"github:bitemyapp/sekka/nightly\"";
      to = "\"github:bitemyapp/sekka/${ref}\"";
      count = 1;
    }
    {
      from = "x86_64-linux";
      to = system;
      count = 4;
    }
  ];
in
{
  inherit template ref system;
  # Genkan quotes the host name as a Nix string (config.rs, nix_string).
  flake = replace template {
    from = "@HOSTNAME@";
    to = builtins.toJSON hostname;
    count = 1;
  };
  lock = import ../installed-lock.nix { inherit self ref; };
}
