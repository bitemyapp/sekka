+        #[test]
+        fn reflink_store_buffers_advisory_writes_until_eviction() -> buck2_error::Result<()> {
+            let temp = tempfile::tempdir()?;
+            let config = DigestConfig::leak_new(vec![DigestAlgorithm::Sha256], None)?;
+            let store = Store::open(temp.path().join("store"), 2 * 4096, 2)?;
+            let bytes = vec![7; 4096];
+            let digest = FileDigest::from_content(&bytes, config.cas_digest_config());
+            let original = temp.path().join("original");
+            fs::write(&original, &bytes)?;
+            assert!(store.access(&original, &digest, false, config, true)?);
+            let hinted = |path: &Path| -> buck2_error::Result<bool> {
+                Ok(store.db.query_row(
+                    "SELECT EXISTS(SELECT 1 FROM views WHERE path=?1)",
+                    [path.to_str().expect("temporary UTF-8 path")], |row| row.get(0),
+                )?)
+            };
+            // A cached lookup publishes its view but writes no metadata yet.
+            let view = temp.path().join("view");
+            assert!(store.access(&view, &digest, false, config, false)?);
+            assert_eq!(fs::read(&view)?, bytes);
+            assert!(!hinted(&view)?);
+            // An eviction decision sees every buffered access first.
+            store.evict(2 * 4096, 1)?;
+            assert!(hinted(&view)?);
+            assert_bounded_and_accounted(&store)?;
+            Ok(())
+        }
