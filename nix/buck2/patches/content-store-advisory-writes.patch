+        fn advisory_due(&self) -> bool {
+            self.advisory.borrow().len() >= ADVISORY_BATCH
+                || self.advisory_since.get().is_some_and(|since| since.elapsed() >= ADVISORY_AGE)
+        }
+
+        /// Writes buffered accesses and hints, in order, into the caller's
+        /// transaction. Callers hold both locks; an eviction decision flushes
+        /// first so that it sees every access this process has made.
+        fn flush_advisory(&self) -> buck2_error::Result<()> {
+            let pending = std::mem::take(&mut *self.advisory.borrow_mut());
+            self.advisory_since.set(None);
+            for advisory in pending {
+                match advisory {
+                    Advisory::Access { path, key } => {
+                        self.db.prepare_cached("UPDATE clock SET tick=tick+1 WHERE id=1")?.execute([])?;
+                        self.db.prepare_cached(
+                            "UPDATE objects SET used=(SELECT tick FROM clock WHERE id=1) WHERE key=?1",
+                        )?.execute([&key])?;
+                        self.remember_view(Path::new(&path), &key)?;
+                    }
+                    Advisory::Forget { path } => {
+                        self.db.prepare_cached("DELETE FROM views WHERE path=?1")?.execute([&path])?;
+                    }
+                }
+            }
+            Ok(())
+        }
+
+        /// Drops buffered hints for paths that were never published.
+        fn forget_pending(&self, paths: &HashSet<&Path>) {
+            self.advisory.borrow_mut().retain(|advisory| match advisory {
+                Advisory::Access { path, .. } => !paths.contains(Path::new(path)),
+                Advisory::Forget { .. } => true,
+            });
+        }
