+/// On the CAS host with cache writes (`BUCK2_LOCAL_CAS_DIR` and
+/// `BUCK2_LOCAL_CAS_JOURNAL`), produced outputs are not ingested into the
+/// content store: the cache uploader puts each one in the CAS and lists it in
+/// the journal, and the client shares its extents with the CAS blob after the
+/// build. The CAS is then the one store on this host.
+pub(crate) fn local_cas_writes() -> bool {
+    static WRITES: std::sync::LazyLock<bool> = std::sync::LazyLock::new(|| {
+        std::env::var_os("BUCK2_LOCAL_CAS_DIR").is_some()
+            && std::env::var_os("BUCK2_LOCAL_CAS_JOURNAL").is_some()
+    });
+    *WRITES
+}
+
+/// Lists every file of an output the CAS now holds. One `HASH SIZE PATH` line
+/// per file, each appended by a fresh open so the client can rotate the file.
+pub(crate) fn note_in_local_cas<D: ActionDirectory>(
+    path: &AbsNormPath,
+    entry: &ActionDirectoryEntry<D>,
+) -> buck2_error::Result<()> {
+    use std::io::Write;
+    let Some(journal) = std::env::var_os("BUCK2_LOCAL_CAS_JOURNAL") else {
+        return Ok(());
+    };
+    let mut lines = String::new();
+    let mut walk = unordered_entry_walk(entry.as_ref().map_dir(Directory::as_ref));
+    while let Some((relative, entry)) = walk.next() {
+        if let DirectoryEntry::Leaf(ActionDirectoryMember::File(metadata)) = entry {
+            let digest = metadata.digest.data();
+            if digest.raw_digest().algorithm() != buck2_common::cas_digest::DigestAlgorithmFamily::Sha256 {
+                continue;
+            }
+            let rendered = digest.to_string();
+            let Some((hash, _)) = rendered.split_once(':') else { continue };
+            let file = path.join(relative.get());
+            let Some(file) = file.as_path().to_str() else { continue };
+            if file.contains('\n') {
+                continue;
+            }
+            lines.push_str(&format!("{hash} {} {file}\n", digest.size()));
+        }
+    }
+    if lines.is_empty() {
+        return Ok(());
+    }
+    let mut options = std::fs::OpenOptions::new();
+    options.create(true).append(true);
+    #[cfg(unix)]
+    std::os::unix::fs::OpenOptionsExt::mode(&mut options, 0o600);
+    options.open(journal)?.write_all(lines.as_bytes())?;
+    Ok(())
+}
