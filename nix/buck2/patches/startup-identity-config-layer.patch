+    #[test]
+    fn test_unreadable_remote_execution_inputs_do_not_fail_startup() -> buck2_error::Result<()> {
+        let digest = |data: &str| -> buck2_error::Result<String> {
+            remote_execution_config_digest(&parse(&[("config", data)], "config")?, Path::new("/"))
+        };
+        let missing = digest("[buck2_re_client]\ntls_ca_certs = /nonexistent/sekka-a.pem\n")?;
+        assert_ne!(missing, digest("[buck2_re_client]\ntls_ca_certs = /nonexistent/sekka-b.pem\n")?);
+        let unset = digest("[buck2_re_client]\nhttp_headers = x-key:$BUCK2_TEST_UNSET_VARIABLE\n")?;
+        assert_ne!(unset, digest("[buck2_re_client]\nhttp_headers = x-key:\n")?);
+        Ok(())
+    }
