+        /// Clones, verifies and syncs every view `stage_group` deferred, then
+        /// renames them and makes the renames durable, without the store locks:
+        /// each reads only its own open object and writes beside its own
+        /// destination. Nothing is renamed unless every snapshot verified.
+        fn publish_deferred(
+            deferred: &[Deferred],
+            config: DigestConfig,
+        ) -> Result<(), PublishFailure> {
+            let stage = |view: &Deferred| -> buck2_error::Result<NamedTempFile> {
+                let staged = Self::stage_publication(
+                    &view.source, &view.destination, &view.digest, view.executable, config,
+                )?;
+                staged.as_file().sync_all()?;
+                Ok(staged)
+            };
+            let staged: Vec<_> = if deferred.len() > 1 {
+                let pool = FILE_IO.as_ref().map_err(|message| PublishFailure {
+                    view: None, error: error(message),
+                })?;
+                pool.install(|| deferred.par_iter().map(stage).collect())
+            } else {
+                deferred.iter().map(stage).collect()
+            };
+            let mut files = Vec::with_capacity(staged.len());
+            for (index, result) in staged.into_iter().enumerate() {
+                match result {
+                    Ok(file) => files.push(file),
+                    Err(error) => return Err(PublishFailure { view: Some(index), error }),
+                }
+            }
+            let failure = |error: std::io::Error| PublishFailure { view: None, error: error.into() };
+            let mut parents = HashSet::new();
+            for (file, view) in files.into_iter().zip(deferred) {
+                file.persist(&view.destination).map_err(|error| failure(error.error))?;
+                parents.extend(view.destination.parent());
+            }
+            for parent in parents {
+                File::open(parent).and_then(|parent| parent.sync_all()).map_err(failure)?;
+            }
+            Ok(())
+        }
+
+        /// After deferred publication failed. No hint may name a view of the
+        /// failed group, as when its transaction rolled back under the locks.
+        /// Destination I/O and reflink errors are not corruption, but an object
+        /// whose view failed to stage is removed if it no longer verifies.
+        fn after_failed_publication(
+            &self,
+            deferred: &[Deferred],
+            failure: &PublishFailure,
+            config: DigestConfig,
+        ) -> buck2_error::Result<()> {
+            let transaction = self.db.unchecked_transaction()?;
+            for view in deferred {
+                self.db.execute(
+                    "DELETE FROM views WHERE path=?1",
+                    [view.destination.to_str().ok_or_else(|| error("Non-UTF-8 artifact view path"))?],
+                )?;
+            }
+            transaction.commit()?;
+            let Some(view) = failure.view.map(|index| &deferred[index]) else {
+                return Ok(());
+            };
+            let path = self.root.join(&view.key);
+            let Ok(mut source) = open_file(&path) else {
+                return Ok(());
+            };
+            if verify(&mut source, &view.digest, config).is_err() {
+                remove(&path)?;
+                self.db.execute("DELETE FROM objects WHERE key=?1", [&view.key])?;
+                File::open(&self.root)?.sync_all()?;
+            }
+            Ok(())
+        }
