+async def test_invalid_outputs_do_not_publish_cache_roots(buck: Buck) -> None:
+    for target, error in [
+        ("write_missing_output", "Action failed to produce outputs"),
+        ("write_wrong_output_type", "Action didn't produce output of the right type"),
