+        let budget = budget();
+        let registry = Arc::new(Registry::default());
+        let entry = registry.register(prepared(&budget, directory, b"one-shot", false)?)?;
+        let barrier = Barrier::new(8);
+        let count = std::thread::scope(|scope| {
+            let threads: Vec<_> = (0..8)
