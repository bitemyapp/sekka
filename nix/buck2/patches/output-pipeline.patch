+                    line,
+                    "Event",
+                    "data",
+                    "SpanEnd",
+                    "data",
+                    "ActionExecution",
+                    "commands",
+                )
+                or []
+            )
+        ]
+        assert [command["status"] for command in commands] == [{"Success": {}}]
+        assert commands[0]["details"]["signed_exit_code"] == 0
