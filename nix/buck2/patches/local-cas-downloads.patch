+        fn local_cas_index_prefers_the_newest_generation_and_clones() -> buck2_error::Result<()> {
+            let temp = tempfile::tempdir()?;
+            let d2 = temp.path().join("d2");
+            fs::create_dir(&d2)?;
+            let hash = "a".repeat(64);
+            fs::write(d2.join(format!("{hash}-5-3")), b"older")?;
+            fs::write(d2.join(format!("{hash}-5-9")), b"newer")?;
+            fs::write(d2.join("not-a-blob"), b"x")?;
+            let mut cas = LocalCas { root: temp.path().to_path_buf(), files: HashMap::new(), scanned: None };
+            let newest = cas.find(&hash, 5).expect("indexed blob");
+            assert_eq!(newest, d2.join(format!("{hash}-5-9")));
+            assert_eq!(cas.find(&"b".repeat(64), 5), None);
+            let destination = temp.path().join("download");
+            File::create(&destination)?;
+            assert!(clone_blob(&newest, 5, &destination));
+            assert_eq!(fs::read(&destination)?, b"newer");
+            assert!(!clone_blob(&newest, 6, &destination));
+            Ok(())
+        }
