+    fn local_cas_key(digest: &FileDigest) -> Option<(String, u64)> {
+        if digest.raw_digest().algorithm() != buck2_common::cas_digest::DigestAlgorithmFamily::Sha256 {
+            return None;
+        }
+        let rendered = digest.to_string();
+        let (hash, _) = rendered.split_once(':')?;
+        Some((hash.to_owned(), digest.size()))
+    }
+
+    fn in_local_cas(digest: &FileDigest) -> bool {
+        #[cfg(target_os = "linux")]
+        {
+            Self::local_cas_key(digest).is_some_and(|(hash, size)| linux::local_cas_contains(&hash, size))
+        }
+        #[cfg(not(target_os = "linux"))]
+        {
+            let _ = digest;
+            false
+        }
+    }
+
+    /// On the CAS host, fills the staged download from the local CAS instead of
+    /// the network. `finish` verifies it like any download.
+    pub(crate) fn clone_from_local_cas(&mut self) -> bool {
+        #[cfg(target_os = "linux")]
+        {
+            let Some((hash, size)) = Self::local_cas_key(self.metadata.digest.data()) else {
+                return false;
+            };
+            self.local = linux::clone_from_local_cas(&hash, size, self.temporary.as_ref());
+            self.local
+        }
+        #[cfg(not(target_os = "linux"))]
+        false
+    }
