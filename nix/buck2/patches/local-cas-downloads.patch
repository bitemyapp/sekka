+    /// On the CAS host, fills the staged download from the local CAS instead of
+    /// the network. `finish` verifies it like any download.
+    pub(crate) fn clone_from_local_cas(&self) -> bool {
+        #[cfg(target_os = "linux")]
+        {
+            let digest = self.metadata.digest.data();
+            if digest.raw_digest().algorithm() != buck2_common::cas_digest::DigestAlgorithmFamily::Sha256 {
+                return false;
+            }
+            let rendered = digest.to_string();
+            let Some((hash, _)) = rendered.split_once(':') else {
+                return false;
+            };
+            linux::clone_from_local_cas(hash, digest.size(), self.temporary.as_ref())
+        }
+        #[cfg(not(target_os = "linux"))]
+        false
+    }
+
     pub(crate) fn name(&self) -> buck2_error::Result<String> {
         Ok(
             buck2_fs::paths::abs_norm_path::AbsNormPathBuf::new(self.temporary.to_path_buf())?
