+    /// A NativeLink filesystem CAS on this host (`BUCK2_LOCAL_CAS_DIR`, its
+    /// content directory) holds every blob the remote cache serves, so cloning
+    /// one replaces a download. Its names carry a generation; an index maps
+    /// digests to files and is rescanned at most once a second on a miss.
+    struct LocalCas {
+        root: PathBuf,
+        files: HashMap<(String, u64), (u64, PathBuf)>,
+        scanned: Option<std::time::Instant>,
+    }
+
+    static LOCAL_CAS: LazyLock<Option<Mutex<LocalCas>>> = LazyLock::new(|| {
+        let root = std::env::var_os("BUCK2_LOCAL_CAS_DIR")?;
+        Some(Mutex::new(LocalCas { root: PathBuf::from(root), files: HashMap::new(), scanned: None }))
+    });
+
+    impl LocalCas {
+        fn scan(&mut self) {
+            self.files.clear();
+            self.scanned = Some(std::time::Instant::now());
+            // Digest folders of NativeLink's layouts v2 and v1; string keys are not blobs.
+            for folder in ["d2", "d"] {
+                let Ok(entries) = fs::read_dir(self.root.join(folder)) else {
+                    continue;
+                };
+                for entry in entries.flatten() {
+                    let name = entry.file_name();
+                    let Some(name) = name.to_str() else { continue };
+                    let mut parts = name.split('-');
+                    let (Some(hash), Some(size)) = (parts.next(), parts.next()) else { continue };
+                    let generation = parts.next().map_or(Some(0), |g| g.parse().ok());
+                    let (Ok(size), Some(generation)) = (size.parse::<u64>(), generation) else { continue };
+                    if hash.len() != 64 || parts.next().is_some() {
+                        continue;
+                    }
+                    let slot = self.files.entry((hash.to_owned(), size)).or_insert((generation, entry.path()));
+                    if generation > slot.0 {
+                        *slot = (generation, entry.path());
+                    }
+                }
+            }
+        }
+
+        fn find(&mut self, hash: &str, size: u64) -> Option<PathBuf> {
+            let key = (hash.to_owned(), size);
+            if !self.files.contains_key(&key)
+                && self.scanned.is_none_or(|at| at.elapsed() >= std::time::Duration::from_secs(1))
+            {
+                self.scan();
+            }
+            self.files.get(&key).map(|(_, path)| path.clone())
+        }
+    }
+
+    /// Clones a local CAS blob into `destination`, an existing empty file. False
+    /// when there is no local CAS, it lacks the blob, or it cannot be cloned; the
+    /// caller then downloads, and verifies either way.
+    pub(super) fn clone_from_local_cas(hash: &str, size: u64, destination: &Path) -> bool {
+        let Some(cas) = LOCAL_CAS.as_ref() else {
+            return false;
+        };
+        let Some(source) = cas.lock().ok().and_then(|mut cas| cas.find(hash, size)) else {
+            return false;
+        };
+        clone_blob(&source, size, destination)
+    }
+
+    fn clone_blob(source: &Path, size: u64, destination: &Path) -> bool {
+        let (Ok(source), Ok(destination)) = (
+            open_file(&source),
+            OpenOptions::new().write(true).custom_flags(O_NOFOLLOW).open(destination),
+        ) else {
+            return false; // Evicted since the scan, or not ours to open.
+        };
+        if source.metadata().map(|m| m.len()).ok() != Some(size) {
+            return false;
+        }
+        clone_file(&source, &destination).is_ok()
+    }
