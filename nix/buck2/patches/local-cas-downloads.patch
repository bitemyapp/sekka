+    /// A NativeLink filesystem CAS on this host (`BUCK2_LOCAL_CAS_DIR`, its
+    /// content directory) holds every blob the remote cache serves, so cloning
+    /// one replaces a download. Its names carry a generation; an index maps
+    /// digests to files and is rescanned at most once a second on a miss.
+    struct LocalCas {
+        root: PathBuf,
+        index: Mutex<LocalCasIndex>,
+        /// Signalled when a scan finishes.
+        scan_done: std::sync::Condvar,
+    }
+
+    type LocalCasFiles = HashMap<(String, u64), (u64, PathBuf)>;
+
+    #[derive(Default)]
+    struct LocalCasIndex {
+        files: LocalCasFiles,
+        /// When the latest scan started, and whether it is still running.
+        scanned: Option<std::time::Instant>,
+        scanning: bool,
+    }
+
+    /// Ends a scan, waking its waiters even if the scan unwinds.
+    struct ScanDone<'a>(&'a LocalCas);
+
+    impl Drop for ScanDone<'_> {
+        fn drop(&mut self) {
+            if let Ok(mut index) = self.0.index.lock() {
+                index.scanning = false;
+            }
+            self.0.scan_done.notify_all();
+        }
+    }
+
+    static LOCAL_CAS: LazyLock<Option<LocalCas>> = LazyLock::new(|| {
+        let root = std::env::var_os("BUCK2_LOCAL_CAS_DIR")?;
+        Some(LocalCas::new(PathBuf::from(root)))
+    });
+
+    impl LocalCas {
+        fn new(root: PathBuf) -> Self {
+            Self { root, index: Mutex::new(LocalCasIndex::default()), scan_done: std::sync::Condvar::new() }
+        }
+
+        fn scan(root: &Path) -> LocalCasFiles {
+            let mut files = LocalCasFiles::new();
+            // Digest folders of NativeLink's layouts v2 and v1; string keys are not blobs.
+            for folder in ["d2", "d"] {
+                let Ok(entries) = fs::read_dir(root.join(folder)) else {
+                    continue;
+                };
+                for entry in entries.flatten() {
+                    let name = entry.file_name();
+                    let Some(name) = name.to_str() else { continue };
+                    let mut parts = name.split('-');
+                    let (Some(hash), Some(size)) = (parts.next(), parts.next()) else { continue };
+                    let generation = parts.next().map_or(Some(0), |g| g.parse().ok());
+                    let (Ok(size), Some(generation)) = (size.parse::<u64>(), generation) else { continue };
+                    if hash.len() != 64 || parts.next().is_some() {
+                        continue;
+                    }
+                    let slot = files.entry((hash.to_owned(), size)).or_insert((generation, entry.path()));
+                    if generation > slot.0 {
+                        *slot = (generation, entry.path());
+                    }
+                }
+            }
+            files
+        }
+
+        /// The scan runs outside the lock: at 500,000 blobs it takes long
+        /// enough that holding the lock would stall every other clone. Hits
+        /// use the current index meanwhile; misses wait for the scan, which
+        /// may find them, as at a daemon's first lookups.
+        fn find(&self, hash: &str, size: u64) -> Option<PathBuf> {
+            let key = (hash.to_owned(), size);
+            let found = |files: &LocalCasFiles| files.get(&key).map(|(_, path)| path.clone());
+            let mut index = self.index.lock().ok()?;
+            if let Some(path) = found(&index.files) {
+                return Some(path);
+            }
+            if index.scanning {
+                let index = self.scan_done.wait_while(index, |index| index.scanning).ok()?;
+                return found(&index.files);
+            }
+            if index.scanned.is_some_and(|at| at.elapsed() < std::time::Duration::from_secs(1)) {
+                return None;
+            }
+            index.scanned = Some(std::time::Instant::now());
+            index.scanning = true;
+            drop(index);
+            let _done = ScanDone(self);
+            let files = Self::scan(&self.root);
+            let mut index = self.index.lock().ok()?;
+            index.files = files;
+            found(&index.files)
+        }
+    }
+
+    /// Clones a local CAS blob into `destination`, an existing empty file. False
+    /// when there is no local CAS, it lacks the blob, or it cannot be cloned; the
+    /// caller then downloads, and verifies either way.
+    pub(super) fn local_cas_contains(hash: &str, size: u64) -> bool {
+        LOCAL_CAS.as_ref().is_some_and(|cas| cas.find(hash, size).is_some())
+    }
+
+    pub(super) fn clone_from_local_cas(hash: &str, size: u64, destination: &Path) -> bool {
+        let Some(source) = LOCAL_CAS.as_ref().and_then(|cas| cas.find(hash, size)) else {
+            return false;
+        };
+        clone_blob(&source, size, destination)
+    }
+
+    fn clone_blob(source: &Path, size: u64, destination: &Path) -> bool {
+        let (Ok(source), Ok(destination)) = (
+            open_file(&source),
+            OpenOptions::new().write(true).custom_flags(O_NOFOLLOW).open(destination),
+        ) else {
+            return false; // Evicted since the scan, or not ours to open.
+        };
+        if source.metadata().map(|m| m.len()).ok() != Some(size) {
+            return false;
+        }
+        clone_file(&source, &destination).is_ok()
+    }
