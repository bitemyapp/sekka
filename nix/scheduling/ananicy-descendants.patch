     }
@@ -139,7 +139,7 @@ bool set_io_priority(pid_t pid, const std::string_view &io_class,
 }
 
 bool set_sched(pid_t pid, const std::string_view &sched_name,
-               unsigned rt_prio) {
+               unsigned rt_prio, bool keep_realtime) {
   std::int32_t sched = 0;
   sched_param  param = {};
   if (sched_name == "idle") {
@@ -163,8 +163,14 @@ bool set_sched(pid_t pid, const std::string_view &sched_name,
     spdlog::error("Invalid scheduler '{}'", __func__, sched_name);
     return false;
   }
-  return for_each_thread(pid, [sched, &param](pid_t tid) {
-    return sched_setscheduler(tid, sched, &param);
+  return for_each_thread(pid, [sched, &param, keep_realtime](pid_t tid) {
+    auto current = sched_getscheduler(tid);
+    if (current < 0) return -1;
+    auto policy = current & ~SCHED_RESET_ON_FORK;
+    if (keep_realtime && (policy == SCHED_FIFO || policy == SCHED_RR ||
+                          policy == SCHED_DEADLINE))
+      return 0;
+    return sched_setscheduler(tid, sched | (current & SCHED_RESET_ON_FORK), &param);
   });
 }
 
