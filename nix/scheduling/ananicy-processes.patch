 namespace priority {
+
+// CPU policy and I/O priority, like nice, are per-thread on Linux. Apply
+// them to threads already created before the exec event reached us too.
+template <typename Apply>
+static bool for_each_thread(pid_t pid, Apply apply) {
+  std::error_code error;
+  fs::directory_iterator tasks(fmt::format("/proc/{}/task", pid), error);
+  if (error)
+    return false;
+  bool success = true;
+  for (const auto &entry : tasks) {
+    const auto tid = to_int<pid_t>(entry.path().filename().string());
+    if (tid <= 0)
+      continue;
+    errno = 0;
+    if (apply(tid) < 0 && errno != ESRCH) {
+      test_errno(errno, "for_each_thread", tid);
+      success = false;
+    }
+  }
+  return success;
+}
 
