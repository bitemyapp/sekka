+#[cfg(test)]
+mod independent_peer_clock_tests {
+    use super::*;
+
+    fn node_and_peer(channel_slot: usize) -> (Node, Peer) {
+        let local = MacAddr([2, 0, 0, 0, 0, 1]);
+        let remote = MacAddr([2, 0, 0, 0, 0, 2]);
+        let node = Node::new(
+            Config::new(
+                local,
+                "test",
+                RadioConstraints {
+                    channel: Channel(6),
+                    presence: Presence::Fixed,
+                },
+            ),
+            Time(0),
+        );
+        let mut peer = Peer::new(remote, Time(0));
+        let mut sequence = Sequence::empty(crate::channel::Encoding::OpClass);
+        sequence.slots[channel_slot] = Channel(6).slot();
+        peer.sequence = Some(sequence);
+        let mut clock = Clock::new(Time(0));
+        clock.update(Time(0), 64, 4);
+        peer.clock = Some(clock);
+        (node, peer)
+    }
+
+    // spec: AWDL-16
+    #[test]
+    fn sends_in_destinations_slot_even_when_another_cluster_is_master() {
+        let (mut node, peer) = node_and_peer(1);
+        let now = Time(SLOT_US / 2);
+        assert_eq!(node.clock.slot(now), 0);
+        assert_eq!(node.unicast_wait(&peer, now), 0);
+        // Electing a different master must not move the destination's slot.
+        node.clock.update(now, 13, 400);
+        assert_eq!(node.unicast_wait(&peer, now), 0);
+    }
+
+    // spec: AWDL-16
+    #[test]
+    fn does_not_send_while_destination_is_away() {
+        let (node, peer) = node_and_peer(0);
+        let now = Time(SLOT_US / 2);
+        assert!(!node.same_channel(&peer, now));
+        assert_eq!(node.unicast_wait(&peer, now), SLOT_US / 2);
+    }
+
+    // spec: AWDL-16
+    #[test]
+    fn guards_destination_boundaries_in_its_own_phase() {
+        let (node, mut peer) = node_and_peer(1);
+        let now = Time(SLOT_US * 3);
+        let mut clock = Clock::new(now);
+        clock.update(now, 2, 4); // its channel-6 slot ends in 2 TU
+        peer.clock = Some(clock);
+        assert_eq!(node.unicast_wait(&peer, now), 2 * TU + UNICAST_GUARD_US);
+        clock.update(now, 63, 4); // its channel-6 slot started 1 TU ago
+        peer.clock = Some(clock);
+        assert_eq!(node.unicast_wait(&peer, now), UNICAST_GUARD_US - TU);
+    }
+}
