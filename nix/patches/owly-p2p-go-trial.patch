+            .u32(126, 0) // HIDDEN_SSID_NOT_IN_USE
+            .u32(53, 0) // AUTHTYPE_OPEN_SYSTEM
+            .bytes(36, &[12, 24, 48]) // basic OFDM rates in 500 kbps units
+            .u8(96, 1) // AP_ISOLATE
+            .bytes(14, &head) // BEACON_HEAD
