+fn go_capable(o: &mut FakeOps) {
+    intel(o);
+    let mut w = o.wiphy.lock().unwrap();
+    w.iftypes.push(IfType::Other(9));
+    w.combinations.push(Combination {
+        limits: vec![(1, vec![IfType::Station]), (1, vec![IfType::Other(9)])],
+        max: 2,
+        channels: 2,
+    });
+}
