+#[tokio::test]
+async fn connected_go_preserves_station_and_cleans_up() {
+    let fx = Fx::with(go_capable);
+    let mut s = fx.settings();
+    s.p2p_go_trial = true;
+    let mut b = fx.backend_with(s);
+    b.up().await.unwrap();
+    assert_eq!(fx.ops.link_freq(STATION), Some(5220));
+    assert_eq!(fx.ops.link_freq(AP), Some(2437));
+    assert_eq!(fx.ops.mac(AP), fx.ops.mac(MONITOR));
+    assert_ne!(fx.ops.mac(AP), fx.ops.mac(STATION));
+    assert_eq!(fx.awdl().radio.presence, Presence::Fixed);
+    b.down().await.unwrap();
+    assert!(!fx.ops.exists(AP));
+    assert!(!fx.ops.exists(MONITOR));
+    assert_eq!(fx.ops.link_freq(STATION), Some(5220));
+    assert!(
+        !fx.ops
+            .calls()
+            .iter()
+            .any(|c| c == "down wlan0" || c == "managed wlan0 false")
+    );
+}
