+fn go_beacon(mac: MacAddr) -> (Vec<u8>, Vec<u8>) {
+    // IEEE 802.11 beacon header and IEs; the firmware inserts TSF and TIM.
+    let mut h = vec![0u8; 36];
+    h[0] = 0x80;
+    h[4..10].fill(0xff);
+    h[10..16].copy_from_slice(&mac.0);
+    h[16..22].copy_from_slice(&mac.0);
+    h[32..34].copy_from_slice(&100u16.to_le_bytes());
+    h[34..36].copy_from_slice(&0x0421u16.to_le_bytes());
+    fn ie(dst: &mut Vec<u8>, kind: u8, bytes: &[u8]) {
+        dst.extend_from_slice(&[kind, bytes.len() as u8]);
+        dst.extend_from_slice(bytes);
+    }
+    ie(&mut h, 0, b"DIRECT-Sekka-test");
+    ie(&mut h, 1, &[0x8c, 0x12, 0x98, 0x24, 0xb0, 0x48, 0x60, 0x6c]);
+    ie(&mut h, 3, &[6]);
+    let mut t = Vec::new();
+    let mut ht = [0u8; 26];
+    ht[2] = 0x1b;
+    ht[3] = 0xff;
+    ie(&mut t, 45, &ht);
+    let mut op = [0u8; 22];
+    op[0] = 6;
+    ie(&mut t, 61, &op);
+    let mut p2p = vec![0x50, 0x6f, 0x9a, 9, 2, 2, 0, 0, 1, 3, 6, 0];
+    p2p.extend_from_slice(&mac.0);
+    ie(&mut t, 221, &p2p);
+    (h, t)
+}
