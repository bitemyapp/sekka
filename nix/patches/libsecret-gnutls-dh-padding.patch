From 96a485819fd47c3a35b7a178909794a8ce41d2a7 Mon Sep 17 00:00:00 2001
From: Myrrh Periwinkle <myrrhperiwinkle@qtmlabs.xyz>
Date: Wed, 10 Jun 2026 18:53:58 +0700
Subject: [PATCH] Ensure length of DH shared secret match length of prime on
 GnuTLS

Aligns the behavior of the GnuTLS backend with that of libgcrypt and fix
a regression with KDE ksecretd after
https://invent.kde.org/frameworks/kwallet/-/merge_requests/146 where
the shared secret calculated by libsecret when built with GnuTLS will
sometimes mismatch with the value calculated by ksecretd.

How to reproduce (on Fedora 44 KDE only) (WARNING: will cause high disk
IO)

```sh
while true; do secret-tool store --label=test1 attr1 val1 <<<sec1; done
```

Expected results: no errors

Actual results: "Can't find session" errors emitted by ksecretd on
decryption failure every few hundred iterations
---
 egg/egg-dh-gnutls.c | 23 ++++++++++++++++++++---
 1 file changed, 20 insertions(+), 3 deletions(-)

diff --git a/egg/egg-dh-gnutls.c b/egg/egg-dh-gnutls.c
index 1273d23..7a61aa6 100644
--- a/egg/egg-dh-gnutls.c
+++ b/egg/egg-dh-gnutls.c
@@ -27,9 +27,12 @@
 /* Enabling this is a complete security compromise */
 #define DEBUG_DH_SECRET 0
 
+#include "egg-secure-memory.h"
 #include <gnutls/gnutls.h>
 #include <gnutls/abstract.h>
 
+EGG_SECURE_DECLARE (dh);
+
 struct egg_dh_params {
 	gnutls_dh_params_t inner;
 	guint bits;
@@ -165,6 +168,8 @@ egg_dh_gen_secret (egg_dh_pubkey *peer, egg_dh_privkey *priv,
 #if DEBUG_DH_SECRET
 	gnutls_datum_t h;
 #endif
+	guchar *value;
+	gsize n_prime = (params->bits + 7) / 8;
 
 	g_return_val_if_fail (peer, NULL);
 	g_return_val_if_fail (priv, NULL);
@@ -182,9 +187,21 @@ egg_dh_gen_secret (egg_dh_pubkey *peer, egg_dh_privkey *priv,
 	gnutls_free (h.data);
 #endif
 
-	return g_bytes_new_with_free_func (k.data, k.size,
-					   (GDestroyNotify)gnutls_free,
-					   k.data);
+	value = egg_secure_alloc (n_prime);
+	if (!value) {
+		gnutls_free (k.data);
+		return NULL;
+	}
+
+	/* Ensure length of secret match length of prime in bytes. */
+	g_return_val_if_fail (k.size <= n_prime, NULL);
+	memcpy (value + (n_prime - k.size), k.data, k.size);
+
+	gnutls_free (k.data);
+
+	return g_bytes_new_with_free_func (value, n_prime,
+					   (GDestroyNotify)egg_secure_free,
+					   value);
 }
 
 void
