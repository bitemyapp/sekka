diff --git a/src/rendervulkan.cpp b/src/rendervulkan.cpp
index 54e4efc..20c1786 100644
--- a/src/rendervulkan.cpp
+++ b/src/rendervulkan.cpp
@@ -1227,6 +1227,9 @@ void CVulkanDevice::compileAllPipelines(std::stop_token st)
 					if (blur_layers > layerCount)
 						continue;
 
+					if (st.stop_requested())
+						return;
+
 					VkPipeline newPipeline = compilePipeline(layerCount, ycbcrMask, info.shaderType, blur_layers, info.compositeDebug, info.colorspaceMask, info.outputEOTF, info.itmEnable);
 					{
 						std::lock_guard<std::mutex> lock(m_pipelineMutex);
@@ -4588,6 +4591,37 @@ void vulkan_wait( uint64_t ulSeqNo, bool bReset )
 	return g_device.wait( ulSeqNo, bReset );
 }
 
+void CVulkanDevice::StopPipelineCompilation()
+{
+	if ( m_pipelineThread.joinable() )
+	{
+		m_pipelineThread.request_stop();
+		m_pipelineThread.join();
+	}
+}
+
+void vulkan_stop_pipeline_compilation( void )
+{
+	g_device.StopPipelineCompilation();
+}
+
+void CVulkanDevice::ReleaseCommandBuffers()
+{
+	waitIdle();
+	m_pendingCmdBufs.clear();
+	m_unusedCmdBufs.clear();
+}
+
+void vulkan_release_shutdown_resources( void )
+{
+	// main has joined the compositor threads. Release GPU-owning C++
+	// containers now, before the dynamically loaded ICD's exit handlers.
+	// Their later static destructors must not call into an unloaded driver.
+	g_device.ReleaseCommandBuffers();
+	g_reshadeManager.clear();
+	g_output = VulkanOutput_t{};
+}
