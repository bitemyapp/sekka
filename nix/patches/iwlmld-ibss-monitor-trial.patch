--- a/drivers/net/wireless/intel/iwlwifi/mld/iface.c
+++ b/drivers/net/wireless/intel/iwlwifi/mld/iface.c
@@ -3,6 +3,7 @@
  * Copyright (C) 2024-2026 Intel Corporation
  */
 #include <net/cfg80211.h>
+#include <linux/moduleparam.h>
 
 #include "iface.h"
 #include "nan.h"
@@ -15,6 +16,14 @@
 #include "fw/api/mac.h"
 #include "fw/api/time-event.h"
 #include "fw/api/datapath.h"
+
+/* Opt-in diagnostic: receive AWDL action/data frames while the IBSS
+ * context supplies hardware ACKs. Never enabled in the normal module.
+ */
+static bool airplay_ibss_monitor;
+module_param(airplay_ibss_monitor, bool, 0400);
+MODULE_PARM_DESC(airplay_ibss_monitor,
+                "Diagnostic IBSS control/management and data receive filter");
 
 /* Cleanup function for struct iwl_mld_vif, will be called in restart */
 void iwl_mld_cleanup_vif(void *data, u8 *mac, struct ieee80211_vif *vif)
@@ -381,6 +390,14 @@
 	cmd->filter_flags |= cpu_to_le32(MAC_CFG_FILTER_ACCEPT_BEACON |
 					 MAC_CFG_FILTER_ACCEPT_PROBE_REQ |
 					 MAC_CFG_FILTER_ACCEPT_GRP);
+
+	if (airplay_ibss_monitor) {
+		cmd->filter_flags |=
+			cpu_to_le32(MAC_CFG_FILTER_PROMISC |
+				    MAC_CFG_FILTER_ACCEPT_CONTROL_AND_MGMT);
+		pr_info("iwlmld: Sekka IBSS receive filter=0x%x\n",
+			le32_to_cpu(cmd->filter_flags));
+	}
 }
 
