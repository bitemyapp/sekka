+SP<Aquamarine::CGBMAllocator> CWaylandPlatform::primaryAllocator() {
+    if (m_primaryAllocator)
+        return m_primaryAllocator;
+
+    // Software GBM may use dumb buffers, whose allocation ioctl is unavailable
+    // on render nodes. Try the matching primary node only after allocation on
+    // the original node failed; keep the renderer's original fd and allocator.
+    if (drmGetNodeTypeFromFd(m_drmState.fd) != DRM_NODE_RENDER)
+        return nullptr;
+
+    auto name = drmGetPrimaryDeviceNameFromFd(m_drmState.fd);
+    if (!name)
+        return nullptr;
+    const int FD = open(name, O_RDWR | O_NONBLOCK | O_CLOEXEC);
+    free(name);
+    if (FD < 0)
+        return nullptr;
+
+    m_primaryAllocator = Aquamarine::CGBMAllocator::create(FD, g_waylandBackend->m_aqBackend);
+    if (!m_primaryAllocator) {
+        close(FD);
+        return nullptr;
+    }
+    g_logger->log(HT_LOG_WARNING, "wayland: retrying buffer allocation on the matching primary DRM node");
+    return m_primaryAllocator;
+}
