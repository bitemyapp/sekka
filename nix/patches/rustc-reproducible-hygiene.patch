 use super::*;
+
+#[test]
+fn encoded_syntax_contexts_are_independent_of_interning_order() {
+    use rustc_serialize::opaque::mem_encoder::MemEncoder;
+
+    use crate::hygiene::{HygieneEncodeContext, raw_encode_syntax_context};
+
+    fn encode(ids: &[u32]) -> Vec<u8> {
+        let context = HygieneEncodeContext::default();
+        let mut encoder = MemEncoder::new();
+        for &id in ids {
+            raw_encode_syntax_context(SyntaxContext::from_u32(id), &context, &mut encoder);
+        }
+        encoder.finish()
+    }
+
+    // The same logical contexts may have different global IDs after parallel
+    // imports. Their serialized identities must agree without merging contexts.
+    assert_eq!(encode(&[0, 37, 8, 37, 0]), encode(&[0, 31, 17, 31, 0]));
+    assert_ne!(encode(&[0, 31, 17, 31, 0]), encode(&[0, 31, 17, 17, 0]));
+    assert_eq!(encode(&[0]), vec![0]);
+}
 
