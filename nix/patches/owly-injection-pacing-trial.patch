+
+// Bounded experimental pacing at the injection boundary. The driver retains
+// a refused frame and rechecks the peer's slot before retrying it.
+fn paced(frame: &Frame) -> bool {
+    !frame.is_action() && !frame.to.is_multicast()
+}
+
+fn pacing_ready(frame: &Frame, now: std::time::Instant, next: std::time::Instant) -> bool {
+    !paced(frame) || now >= next
 }
 
