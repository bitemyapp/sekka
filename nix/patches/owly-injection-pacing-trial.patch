+#[cfg(test)]
+mod pacing_tests {
+    use super::*;
+    #[test]
+    fn delays_only_unicast_data_and_releases_it_at_the_deadline() {
+        let now = std::time::Instant::now();
+        let next = now + std::time::Duration::from_millis(2);
+        let mut frame = Frame { bytes: vec![0x08, 0],
+            to: owly_awdl::MacAddr([2,0,0,0,0,1]),
+            rate: owly_awdl::TxRate::BASIC, no_ack: true };
+        assert!(!pacing_ready(&frame, now, next));
+        assert!(pacing_ready(&frame, next, next));
+        frame.bytes[0] = 0xd0;
+        assert!(pacing_ready(&frame, now, next));
+        frame.bytes[0] = 0x08;
+        frame.to = owly_awdl::MacAddr::BROADCAST;
+        assert!(pacing_ready(&frame, now, next));
+    }
