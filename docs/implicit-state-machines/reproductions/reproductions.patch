@@ -0,0 +1,86 @@
+//! STA-10: the keyboard setup sheet left up over another pane stops
+//! waiting for the key beside the space bar, and nothing starts the wait
+//! again.
+//!
+//! Settei over the sample (whose keyboard's keys come as `SampleKey`, as
+//! the compositor's catch would), opened at `keyboard.setup` as the
+//! shell's setup prompt opens it, then another launch opening Mouse.
+
+mod common;
+
+use std::sync::Arc;
+
+use aizome_kit::layout::Size;
+use aizome_kit::testing::Harness;
+use settei::{AppMsg, Settei};
+
+fn press(h: &mut Harness<Settei>, code: u32) {
+    let msg: settei::pane::PaneMsg = Arc::new(settei::panes::keyboard::Msg::SampleKey(code));
+    h.send(AppMsg::Pane("keyboard", msg));
+}
+
+/// A sheet window's own texts (the harness gives its window's first, up to
+/// the status strip's "Sample system").
+fn own(texts: Vec<String>) -> Vec<String> {
+    match texts.iter().position(|t| t == "Sample system") {
+        Some(i) => texts[i + 1..].to_vec(),
+        None => texts,
+    }
+}
+
+fn launch(h: &mut Harness<Settei>, args: &[&str]) {
+    h.send(AppMsg::Launched(args.iter().map(|a| (*a).to_owned()).collect()));
+}
+
+#[test]
+fn repro_sta_10_the_setup_sheet_left_over_another_pane_still_takes_the_key() {
+    let (mut h, _) = common::open("repro-sta-10", "keyboard.setup");
+    let w = h.window();
+    h.resize(w, Size::new(940.0, 1180.0));
+    let s = h.program().sheet_window().expect("the setup sheet");
+    assert!(h.texts(s).iter().any(|t| t == "Waiting for the key…"), "{:?}", h.texts(s));
+
+    // The palette (or a second `aizome-settei --pane mouse`) opens Mouse.
+    launch(&mut h, &["--pane", "mouse"]);
+    assert_eq!(h.program().pane_id(), "mouse");
+    // What the sheet shows: only its own texts (h.texts gives the window's too).
+    let mut wrong = Vec::new();
+    let Some(s) = h.program().sheet_window() else { return };
+    let texts = own(h.texts(s));
+    if !texts.iter().any(|t| t == "Set Up a Keyboard") {
+        return;
+    }
+    if !texts.iter().any(|t| t == "Waiting for the key…") {
+        wrong.push(format!("over Mouse the setup sheet stays up without “Waiting for the key…”: {texts:?}"));
+    }
+    // Left Alt, beside the space bar on a PC keyboard.
+    press(&mut h, 56);
+    let texts = own(h.texts(s));
+    if !texts.iter().any(|t| t == "Swap left Alt and Super") {
+        wrong.push(format!("the key beside the space bar did nothing: {texts:?}"));
+    }
+    // Back on Keyboard, the sheet still up: does it wait again?
+    if wrong.is_empty() {
+        assert!(wrong.is_empty());
+        return;
+    }
+    launch(&mut h, &["--pane", "keyboard"]);
+    if let Some(s) = h.program().sheet_window() {
+        press(&mut h, 56);
+        let texts = own(h.texts(s));
+        if !texts.iter().any(|t| t == "Swap left Alt and Super") {
+            wrong.push(format!("back on Keyboard, the key still does nothing: {texts:?}"));
+        }
+        let buttons: Vec<String> = h
+            .semantics(s)
+            .into_iter()
+            .filter(|(sem, _)| sem.role == aizome_kit::widget::SemanticRole::Button)
+            .filter(|(sem, _)| {
+                matches!(sem.label.as_deref(), Some("Not Now" | "Same as Other Keyboards" | "Save" | "Press Again"))
+            })
+            .map(|(sem, _)| format!("{} enabled={}", sem.label.clone().unwrap_or_default(), !sem.disabled))
+            .collect();
+        wrong.push(format!("the sheet's buttons: {buttons:?}"));
+    }
+    assert!(wrong.is_empty(), "{}", wrong.join("\n"));
+}
diff --git a/desktop/aizome/apps/settei/tests/repro_sta_12.rs b/desktop/aizome/apps/settei/tests/repro_sta_12.rs
