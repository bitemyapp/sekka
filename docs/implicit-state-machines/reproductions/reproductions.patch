diff --git a/desktop/aizome/crates/aizome-comp-core/src/recovery/repro_cpa_24.rs b/desktop/aizome/crates/aizome-comp-core/src/recovery/repro_cpa_24.rs
new file mode 100644
index 00000000..1598b082
--- /dev/null
+++ b/desktop/aizome/crates/aizome-comp-core/src/recovery/repro_cpa_24.rs
@@ -0,0 +1,80 @@
+//! CPA-24: a Kill queued ahead of a Sample must still be carried out.
+//!
+//! The worker drains its queue keeping only the newest request; when the
+//! first request it takes is a Kill and a Sample is queued behind it (Force
+//! Quit pressed while the worker was busy, then the open overlay's 1 s
+//! sample), the drain's `s => req = s` overwrites the Kill.
+//!
+//! The test queues exactly that (Kill, then Sample) before the worker
+//! runs, drives the real `run` loop to completion and asserts that the
+//! victim (a `sleep` this test started) was killed and a `Killed` report
+//! came back.
+
+use std::process::{Command, Stdio};
+use std::sync::mpsc;
+use std::time::{Duration, Instant};
+
+use smithay::reexports::calloop::{EventLoop, channel};
+
+use super::{AppProcs, Report, Request, run};
+
+#[test]
+fn repro_cpa_24_a_kill_queued_before_a_sample_is_not_lost() {
+    // The victim: a child of this test, nothing else.
+    let mut victim = Command::new("sleep")
+        .arg("30")
+        .stdin(Stdio::null())
+        .stdout(Stdio::null())
+        .stderr(Stdio::null())
+        .spawn()
+        .expect("start sleep");
+    let pid = victim.id() as i32;
+
+    let (tx, rx) = mpsc::channel::<Request>();
+    let (report_tx, report_rx) = channel::channel::<Report>();
+    // Force Quit, then the overlay's periodic sample, both queued while
+    // the worker was busy.
+    tx.send(Request::Kill(AppProcs { key: "org.example.Victim".into(), pids: vec![pid], x11: None })).unwrap();
+    tx.send(Request::Sample(vec![AppProcs { key: "org.example.Victim".into(), pids: vec![pid], x11: None }]))
+        .unwrap();
+    drop(tx);
+    // The real worker loop, on this thread: it handles the queue and
+    // returns once the sender is gone.
+    run(rx, report_tx);
+
+    // What it reported.
+    let mut event_loop: EventLoop<'static, Vec<String>> = EventLoop::try_new().unwrap();
+    event_loop
+        .handle()
+        .insert_source(report_rx, |e, _, got: &mut Vec<String>| {
+            if let channel::Event::Msg(r) = e {
+                got.push(match r {
+                    Report::Samples(s) => format!("Samples({})", s.len()),
+                    Report::Killed { key, result } => format!("Killed({key}, {result:?})"),
+                });
+            }
+        })
+        .unwrap();
+    let mut reports = Vec::new();
+    event_loop.dispatch(Some(Duration::ZERO), &mut reports).unwrap();
+
+    // Whether the victim died.
+    let deadline = Instant::now() + Duration::from_secs(2);
+    let mut status = None;
+    while Instant::now() < deadline {
+        status = victim.try_wait().unwrap();
+        if status.is_some() {
+            break;
+        }
+        std::thread::sleep(Duration::from_millis(20));
+    }
+    if status.is_none() {
+        let _ = victim.kill();
+        let _ = victim.wait();
+    }
+    assert!(
+        status.is_some() && reports.iter().any(|r| r.starts_with("Killed(")),
+        "Force Quit was lost: victim pid {pid} still running = {}, reports = {reports:?}",
+        status.is_none()
+    );
+}
