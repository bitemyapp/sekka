diff --git a/apps/kakehashi/core/tests/repro_ktl_02.rs b/apps/kakehashi/core/tests/repro_ktl_02.rs
new file mode 100644
index 00000000..3d153ae2
--- /dev/null
+++ b/apps/kakehashi/core/tests/repro_ktl_02.rs
@@ -0,0 +1,150 @@
+//! KTL-02 (download half): two downloads of the same build into the same
+//! directory share one `.part` file with no lock (nightly.rs:138). That is
+//! what a Kakehashi window runs when a file dropped onto it orphans the
+//! running download (view.rs:638 drops the session without storing its
+//! cancel flag) and the person starts the same build again.
+//!
+//! With a server that ignores Range, each download falls back to one
+//! connection, and the fallback truncates the shared file (parallel.rs:210).
+//! The orphan hashes the bytes it received, not the file, so it still
+//! "verifies", renames the `.part` and returns it as the build, with a hole
+//! of zeros where the restarted download truncated it.
+//!
+//! Orchestration is deterministic: each download blocks in its `report`
+//! callback at a chosen point until the test lets it go.
+
+use kakehashi_core::image::{hex, sha256_file};
+use kakehashi_core::nightly::{Build, Fetch, download};
+use sha2::{Digest, Sha256};
+use std::fs;
+use std::io::{BufRead, BufReader, Write};
+use std::net::{TcpListener, TcpStream};
+use std::sync::atomic::{AtomicBool, Ordering};
+use std::sync::{Arc, mpsc};
+use std::time::Duration;
+
+/// Always the whole file with 200, as an intermediary that ignores Range.
+fn serve(data: Arc<Vec<u8>>) -> String {
+    let listener = TcpListener::bind("127.0.0.1:0").unwrap();
+    let url = format!("http://{}", listener.local_addr().unwrap());
+    std::thread::spawn(move || {
+        for stream in listener.incoming().flatten() {
+            let data = data.clone();
+            std::thread::spawn(move || {
+                let _ = respond(stream, &data);
+            });
+        }
+    });
+    url
+}
+
+fn respond(mut stream: TcpStream, data: &[u8]) -> std::io::Result<()> {
+    let mut reader = BufReader::new(stream.try_clone()?);
+    loop {
+        let mut line = String::new();
+        if reader.read_line(&mut line)? == 0 || line == "\r\n" {
+            break;
+        }
+    }
+    write!(stream, "HTTP/1.1 200 OK\r\nContent-Length: {}\r\nConnection: close\r\n\r\n", data.len())?;
+    stream.write_all(data)
+}
+
+#[test]
+fn repro_ktl_02_a_download_returned_as_the_build_has_the_builds_checksum() {
+    // No zero bytes, so a hole shows.
+    let data: Arc<Vec<u8>> = Arc::new((0..4u32 << 20).map(|i| (i % 251) as u8 + 1).collect());
+    let build = Build {
+        id: "20261104-0123abc".into(),
+        revision: "0123abcdef".into(),
+        uploaded: "2026-11-04T02:51:44Z".into(),
+        iso: "builds/20261104-0123abc/sekka-repro.iso".into(),
+        bytes: data.len() as u64,
+        sha256: hex(&Sha256::digest(&*data)),
+    };
+    let base = serve(data.clone());
+    let dir = tempfile::tempdir().unwrap();
+    let part = dir.path().join("sekka-repro.iso.part");
+
+    // The orphan: the first session's worker, left running by the drop. It
+    // stops once it has written at least 1 MiB.
+    let (paused_tx, paused_rx) = mpsc::channel();
+    let (go_tx, go_rx) = mpsc::channel::<()>();
+    let orphan = {
+        let (build, base, dir) = (build.clone(), base.clone(), dir.path().to_owned());
+        std::thread::spawn(move || {
+            let mut paused = false;
+            download(
+                &build,
+                &base,
+                &dir,
+                &mut |fetch| {
+                    if let Fetch::Downloading { done, .. } = fetch
+                        && done >= 1 << 20
+                        && !paused
+                    {
+                        paused = true;
+                        paused_tx.send(done).unwrap();
+                        go_rx.recv().unwrap();
+                    }
+                },
+                &|| false,
+            )
+        })
+    };
+    let orphan_at = paused_rx.recv_timeout(Duration::from_secs(30)).expect("the orphan never started downloading");
+
+    // The restarted session for the same build, in the same directory. It
+    // stops at its first Downloading report, just after the fallback has
+    // truncated the .part; then the person presses Stop.
+    let (truncated_tx, truncated_rx) = mpsc::channel();
+    let (stop_tx, stop_rx) = mpsc::channel::<()>();
+    let stopped = Arc::new(AtomicBool::new(false));
+    let restarted = {
+        let (build, base, dir, part, stopped) =
+            (build.clone(), base.clone(), dir.path().to_owned(), part.clone(), stopped.clone());
+        std::thread::spawn(move || {
+            let mut told = false;
+            download(
+                &build,
+                &base,
+                &dir,
+                &mut |fetch| {
+                    if let Fetch::Downloading { done: 0, .. } = fetch
+                        && !told
+                    {
+                        told = true;
+                        truncated_tx.send(fs::metadata(&part).map(|m| m.len()).unwrap_or(u64::MAX)).unwrap();
+                        stop_rx.recv().unwrap();
+                        stopped.store(true, Ordering::Relaxed);
+                    }
+                },
+                &|| stopped.load(Ordering::Relaxed),
+            )
+        })
+    };
+    let part_after_truncation =
+        truncated_rx.recv_timeout(Duration::from_secs(30)).expect("the restarted download never fell back");
+
+    // The orphan finishes while the restarted session waits; then Stop.
+    go_tx.send(()).unwrap();
+    let orphan_result = orphan.join().unwrap();
+    stop_tx.send(()).unwrap();
+    let restarted_result = restarted.join().unwrap();
+
+    let path = orphan_result.expect("the orphan's download");
+    let on_disk = sha256_file(&path, &mut |_| {}, &|| false).unwrap();
+    let bytes = fs::read(&path).unwrap();
+    let zeros = bytes.iter().take_while(|&&b| b == 0).count();
+    let sidecar = fs::read_to_string(dir.path().join("sekka-repro.iso.sha256")).unwrap_or_default();
+    assert_eq!(
+        on_disk,
+        build.sha256,
+        "download() returned {} as the verified build, but its SHA-256 differs: the restarted download truncated \
+         the shared .part to {part_after_truncation} bytes while the orphan had written {orphan_at}; the file \
+         now starts with {zeros} zero bytes; the sidecar still says {:?}; the restarted session ended with {:?}",
+        path.display(),
+        sidecar.trim(),
+        restarted_result.map(|p| p.display().to_string()).map_err(|e| format!("{e:#}")),
+    );
+}
diff --git a/apps/yukimi/crates/yukimi-system/tests/repro_yuk_02.rs b/apps/yukimi/crates/yukimi-system/tests/repro_yuk_02.rs
new file mode 100644
index 00000000..ad526ce2
--- /dev/null
+++ b/apps/yukimi/crates/yukimi-system/tests/repro_yuk_02.rs
@@ -0,0 +1,83 @@
+//! YUK-02: an `activating` receipt left by a Yukimi activation that failed
+//! past its commit point must not outlive a later, healthy boot into a
+//! system the receipt doesn't name (repaired with `nixos-rebuild switch`,
+//! or the previous system booted again). Only Yukimi's own change and
+//! rollback rewrite the receipt, so without that the advice stays
+//! "Activation did not finish successfully" for good.
+use std::path::{Path, PathBuf};
+
+use yukimi_system::completion::{Action, Receipt, system_state};
+
+/// Complete systems with the same boot artefacts, so only the receipt can
+/// make the answer anything but "applied".
+struct Systems {
+    root: PathBuf,
+}
+
+impl Systems {
+    fn new(tag: &str) -> Systems {
+        let root = std::env::temp_dir().join(format!("repro-yuk-02-{tag}-{}", std::process::id()));
+        let _ = std::fs::remove_dir_all(&root);
+        std::fs::create_dir_all(root.join("artefacts")).unwrap();
+        for part in ["kernel", "initrd", "kernel-modules"] {
+            std::fs::write(root.join("artefacts").join(part), part).unwrap();
+        }
+        for name in ["S0", "S1", "S2"] {
+            let system = root.join(name);
+            std::fs::create_dir_all(system.join("etc/yukimi")).unwrap();
+            for part in ["kernel", "initrd", "kernel-modules"] {
+                std::os::unix::fs::symlink(root.join("artefacts").join(part), system.join(part)).unwrap();
+            }
+            std::fs::write(system.join("kernel-params"), "quiet").unwrap();
+            std::fs::write(system.join("init-interface-version"), "2").unwrap();
+            std::fs::write(system.join("etc/yukimi/activation.json"), "{\"version\":1}").unwrap();
+        }
+        Systems { root }
+    }
+    fn get(&self, name: &str) -> PathBuf {
+        self.root.join(name)
+    }
+}
+
+impl Drop for Systems {
+    fn drop(&mut self) {
+        let _ = std::fs::remove_dir_all(&self.root);
+    }
+}
+
+/// What the helper leaves when `switch-to-configuration` (or `nix-env
+/// --set`) fails after commit: `activating` for the system it built, in
+/// the boot it ran in.
+fn failed_activation(system: &Path) -> Receipt {
+    Receipt { system: system.to_owned(), boot_id: "boot-1".into(), state: "activating".into(), reasons: vec![] }
+}
+
+#[test]
+fn repro_yuk_02_rebuilt_and_rebooted_into_another_system() {
+    let s = Systems::new("rebuilt");
+    let (s1, s2) = (s.get("S1"), s.get("S2"));
+    let receipt = failed_activation(&s1);
+    // `nixos-rebuild switch` to S2, then a reboot into it: booted, active
+    // and selected are all S2, in a later boot than the receipt's.
+    let after = system_state(&s2, &s2, &s2, Some(&receipt), "boot-2");
+    assert_ne!(
+        after.action,
+        Action::Unknown,
+        "a later healthy boot into S2 still reports the old failed activation of S1: {after:?}"
+    );
+}
+
+#[test]
+fn repro_yuk_02_rebooted_into_the_previous_system() {
+    // Extension of the entry: `nix-env --set` failed (the profile still
+    // selects S0) and the person simply restarts into S0.
+    let s = Systems::new("previous");
+    let (s0, s1) = (s.get("S0"), s.get("S1"));
+    let receipt = failed_activation(&s1);
+    let after = system_state(&s0, &s0, &s0, Some(&receipt), "boot-2");
+    assert_ne!(
+        after.action,
+        Action::Unknown,
+        "a later healthy boot into S0 still reports the old failed activation of S1: {after:?}"
+    );
+}
diff --git a/apps/yukimi/yukimi-helper/tests/repro_yuk_02.sh b/apps/yukimi/yukimi-helper/tests/repro_yuk_02.sh
new file mode 100644
index 00000000..49b71cd8
--- /dev/null
+++ b/apps/yukimi/yukimi-helper/tests/repro_yuk_02.sh
@@ -0,0 +1,136 @@
+#!/usr/bin/env bash
+# YUK-02 (end to end): a Yukimi update whose activation fails after commit
+# leaves the receipt 'activating' for S1. The person repairs the system with
+# nixos-rebuild switch to S2 and restarts into it. sekka-update --status (the
+# same completion::read the GUI uses) must not keep reporting the old failed
+# activation. The restart is simulated by moving /run/booted-system and
+# giving the receipt an earlier boot id (the real boot id can't change here).
+#
+# Runs the real yukimi-helper worker (`__worker DIR …`) inside an
+# unprivileged user + mount namespace in which /run, /nix/var/nix,
+# /var/lib/yukimi and /etc/yukimi are private tmpfs mounts and /etc/nixos is
+# a bind of a temporary directory. The helper's fixed PATH
+# (/run/current-system/sw/bin) then holds only stand-ins for nix, nix-env,
+# nix-channel, nix-store, git, loginctl and systemctl, so nothing real runs
+# and nothing outside the namespace's temporary directories changes (the
+# namespace's "root" is the unprivileged user outside it).
+#
+# usage: run default yukimi bash repro_yuk_02.sh /path/to/yukimi-helper
+# exit 0: correct behaviour; exit 1: the bug reproduced.
+set -euo pipefail
+if [[ ${REPRO_IN_NS:-} != 1 ]]; then
+  helper=$(readlink -f "${1:?path to the yukimi-helper binary}")
+  exec env REPRO_IN_NS=1 unshare --user --map-root-user --mount --propagation private \
+    bash "$(readlink -f "$0")" "$helper"
+fi
+
+# ---- harness (identical in repro_yuk_02/09/10/11.sh) -----------------------
+T=$(mktemp -d "${TMPDIR:-/tmp}/repro-yuk.XXXXXX")
+trap 'rm -rf "$T"' EXIT
+cp "$1" "$T/yukimi-helper"
+[[ -x $(dirname "$1")/sekka-update ]] && cp "$(dirname "$1")/sekka-update" "$T/sekka-update"
+SH=$(readlink -f "$(command -v bash)")
+CORE=$(dirname "$(readlink -f "$(command -v mkdir)")")
+mkdir -p "$T"/{sw/bin,sys,chan,ctl,state,etc-nixos} && : >"$T/calls"
+mount -t tmpfs repro /run
+mount -t tmpfs repro /nix/var/nix
+mount -t tmpfs repro /var/lib/yukimi
+mount -t tmpfs repro /etc/yukimi
+mount --bind "$T/etc-nixos" /etc/nixos
+mkdir -p /run/lock /nix/var/nix/profiles/per-user/root /var/lib/yukimi/operations
+chmod 700 /var/lib/yukimi/operations
+
+stub() { # name body…: a stand-in on the helper's PATH that logs its arguments
+  local file=$1; shift
+  { echo "#!$SH"; echo "export PATH=$CORE"; echo "T=$T"; echo 'echo "${0##*/} $*" >>"$T/calls"'; printf '%s\n' "$@"; } >"$file"
+  chmod +x "$file"
+}
+stub "$T/sw/bin/nix" 'a=" $* "' 'case "$a" in' \
+  '*" config show nix-path "*) echo "nixpkgs=/nix/var/nix/profiles/per-user/root/channels/nixos";;' \
+  '*" build "*) echo "channels=$(readlink /nix/var/nix/profiles/per-user/root/channels) lock=$(cat /etc/nixos/flake.lock 2>/dev/null)" >>"$T/builds"' \
+  '  m=$(cat "$T/ctl/build"); case "$m" in' \
+  '    fail) echo "error: builder for system failed" >&2; exit 1;;' \
+  '    hang) touch "$T/state/build-started"; exec sleep 600;;' \
+  '    ok\ *) echo "$T/sys/${m#ok }";; esac;;' \
+  '*attrNames*) echo "[\"fake\"]";;' \
+  '*nix.settings*) echo "{\"substituters\":[],\"keys\":[]}";;' \
+  '*" flake update "*) cat "$T/ctl/lock" >/etc/nixos/flake.lock;;' \
+  '*) exit 1;; esac'
+stub "$T/sw/bin/nix-channel" 'cd /nix/var/nix/profiles/per-user/root' \
+  'l=$(readlink channels); n=${l#channels-}; n=$(( ${n%-link} + 1 ))' \
+  'mkdir "channels-$n-link"; mkdir -p "$T/chan/$n"; ln -s "$T/chan/$n" "channels-$n-link/nixos"; ln -sfn "channels-$n-link" channels'
+stub "$T/sw/bin/nix-env" 'cd /nix/var/nix/profiles' 'case "$*" in' \
+  '*--set*) max=0; for l in system-*-link; do n=${l#system-}; n=${n%-link}; (( n > max )) && max=$n; done' \
+  '  ln -s "${@: -1}" "system-$((max+1))-link"; ln -sfn "system-$((max+1))-link" system;;' \
+  '*--switch-generation*) ln -sfn "system-${@: -1}-link" system;;' \
+  '*--delete-generations*) cur=$(readlink system); for l in system-*-link; do [[ $l == "$cur" ]] || rm "$l"; done;;' \
+  'esac'
+stub "$T/sw/bin/nix-store" 'case $(cat "$T/ctl/gc") in' \
+  'fail) echo "error: collecting garbage failed" >&2; exit 1;;' \
+  'hang) touch "$T/state/gc-started"; exec sleep 600;;' \
+  '*) echo "0 store paths deleted, 0.00 MiB freed";; esac'
+for name in git loginctl systemctl; do stub "$T/sw/bin/$name" 'exit 0'; done
+bootmenu() { (cd /nix/var/nix/profiles && for l in system-*-link; do echo "$l"; done) >"$T/state/bootmenu"; }
+mksys() { # a stand-in system whose switch-to-configuration logs and moves /run/current-system
+  local s=$T/sys/$1
+  mkdir -p "$s/bin"; ln -s "$T/sw" "$s/sw"
+  stub "$s/bin/switch-to-configuration" "[[ -e \$T/ctl/switch-fail ]] && exit 1" \
+    "[[ \$1 == switch ]] && ln -sfn $s /run/current-system" \
+    '(cd /nix/var/nix/profiles && for l in system-*-link; do echo "$l"; done) >"$T/state/bootmenu"'
+}
+generation() { ln -sfn "$T/sys/$2" "/nix/var/nix/profiles/system-$1-link"; }
+select_generation() { ln -sfn "system-$1-link" /nix/var/nix/profiles/system; }
+running() { ln -sfn "$T/sys/$1" /run/current-system; [[ -n ${2:-} ]] && ln -sfn "$T/sys/$1" /run/booted-system; true; }
+channels_at() { # n: root's channels profile at generation n
+  local d=/nix/var/nix/profiles/per-user/root
+  rm -rf "$d"/channels*; mkdir -p "$d/channels-$1-link" "$T/chan/$1"
+  ln -s "$T/chan/$1" "$d/channels-$1-link/nixos"; ln -sfn "channels-$1-link" "$d/channels"
+}
+helper() { # args…: run the worker, print its result
+  local dir; dir=$(mktemp -d /var/lib/yukimi/operations/op.XXXXXX)
+  "$T/yukimi-helper" __worker "$dir" "$@" </dev/null 2>"$dir.stderr" || true
+  cat "$dir/result.json"
+}
+helper_stopped() { # marker args…: run the worker, interrupt it once marker appears
+  local marker=$1; shift
+  local dir; dir=$(mktemp -d /var/lib/yukimi/operations/op.XXXXXX)
+  rm -f "$marker"
+  "$T/yukimi-helper" __worker "$dir" "$@" </dev/null 2>"$dir.stderr" &
+  local pid=$! i=0
+  until [[ -e $marker ]]; do sleep 0.02; i=$((i + 1)); ((i < 1500)) || { echo "never reached $marker"; exit 2; }; done
+  kill -INT "$pid"; wait "$pid" || true
+  cat "$dir/result.json"
+}
+check_isolated() { # nothing real is reachable through the helper's fixed paths
+  [[ $(readlink -f /run/current-system/sw/bin/nix) == "$T/sw/bin/nix" ]]
+  [[ ! -e /run/wrappers && ! -e /nix/var/nix/daemon-socket ]]
+  grep -q REPRO-FAKE /etc/nixos/configuration.nix
+  [[ $(readlink -f /nix/var/nix/profiles/system) == "$T/sys/"* ]]
+}
+FAILED=0
+expect() { # description, actual, expected
+  if [[ $2 == "$3" ]]; then echo "ok:   $1"; else echo "FAIL: $1"; echo "      expected: $3"; echo "      actual:   $2"; FAILED=1; fi
+}
+# ---- end of harness ---------------------------------------------------------
+
+for s in S0 S1 S2; do mksys $s; done
+generation 1 S0; select_generation 1; running S0 booted; bootmenu
+printf '# REPRO-FAKE\n{ ... }: { }\n' >/etc/nixos/configuration.nix
+check_isolated
+[[ -x $T/sekka-update ]]
+
+echo "== Yukimi installs htop; switch-to-configuration fails after commit"
+echo "ok S1" >"$T/ctl/build"; touch "$T/ctl/switch-fail"
+echo "result: $(helper change --packages htop --mode auto)"
+echo "receipt: $(cat /var/lib/yukimi/update.json)"
+rm "$T/ctl/switch-fail"
+
+echo "== outside Yukimi: nixos-rebuild switch to S2, then restart into it"
+generation 3 S2; select_generation 3; running S2 booted
+r=$(cat /var/lib/yukimi/update.json); b=$(cat /proc/sys/kernel/random/boot_id)
+printf '%s' "${r//$b/boot-before-restart}" >/var/lib/yukimi/update.json
+echo "receipt: $(cat /var/lib/yukimi/update.json)"
+status=$("$T/sekka-update" --status --json)
+echo "sekka-update --status --json: $status"
+expect "advice after a healthy restart into S2" "$([[ $status == *'"action":"unknown"'* ]] && echo unknown || echo not-unknown)" "not-unknown"
+exit $FAILED
