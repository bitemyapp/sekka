diff --git a/desktop/aizome/apps/fusen/tests/repro_sap_05.rs b/desktop/aizome/apps/fusen/tests/repro_sap_05.rs
new file mode 100644
index 00000000..8eb6372a
--- /dev/null
+++ b/desktop/aizome/apps/fusen/tests/repro_sap_05.rs
@@ -0,0 +1,91 @@
+//! SAP-05: restoring N stickies at login must keep where each one was.
+//! `restore_stickies` opens them one by one, and every `open_sticky` runs
+//! `save_stickies`, which rebuilds the saved list from the stickies open so
+//! far and looks each one's place up in that shrinking list: stickies 2..N
+//! are written back with no place. Without Aizome's IPC (or on a quit
+//! within the 4 s Track), nothing puts the places back.
+
+use std::path::{Path, PathBuf};
+
+use aizome_fusen::app::{Fusen, Msg, Places, Request, SavedStickies, SavedSticky};
+use aizome_fusen::wm::Place;
+use aizome_kit::testing::Harness;
+
+fn scratch(name: &str) -> PathBuf {
+    let d = std::env::temp_dir().join(format!("repro-sap-05-{name}-{}", std::process::id()));
+    let _ = std::fs::remove_dir_all(&d);
+    std::fs::create_dir_all(&d).unwrap();
+    d
+}
+
+fn places(dir: &Path) -> Places {
+    Places {
+        notes: dir.join("Notes"),
+        state: Some(dir.join("state")),
+        trash: Some(dir.join("Trash")),
+        autostart: Some(dir.join("autostart")),
+        compositor: false,
+    }
+}
+
+fn on_disk(dir: &Path) -> SavedStickies {
+    serde_json::from_str(&std::fs::read_to_string(dir.join("state/stickies.json")).unwrap()).unwrap()
+}
+
+fn place_of(s: &SavedStickies, note: &str) -> Option<Place> {
+    s.stickies.iter().find(|x| x.note == note).and_then(|x| x.place)
+}
+
+#[test]
+fn restoring_stickies_keeps_every_place() {
+    let dir = scratch("restore");
+    std::fs::create_dir_all(dir.join("Notes")).unwrap();
+    let names = ["Alpha", "Beta", "Gamma"];
+    for n in names {
+        std::fs::write(dir.join(format!("Notes/{n}.md")), format!("{n}\nsome text\n")).unwrap();
+    }
+    // Where the three were when the last session ended.
+    let saved: Vec<SavedSticky> = names
+        .iter()
+        .enumerate()
+        .map(|(i, n)| SavedSticky {
+            note: format!("{n}.md"),
+            place: Some(Place { x: 40 + 320 * i as i32, y: 60, w: 300, h: 260, desk: Some(2) }),
+            float: true,
+        })
+        .collect();
+    std::fs::create_dir_all(dir.join("state")).unwrap();
+    std::fs::write(
+        dir.join("state/stickies.json"),
+        serde_json::to_string_pretty(&SavedStickies { stickies: saved.clone() }).unwrap(),
+    )
+    .unwrap();
+
+    // Login: `aizome-fusen --stickies`, then quit within 4 s.
+    let (lost, written) = {
+        let mut f = Fusen::new(places(&dir), Request { stickies_only: true, ..Request::default() });
+        f.open_links = false;
+        let mut h = Harness::new(f);
+        assert_eq!(h.program().stickies.len(), 3, "all three stickies come back");
+        let after_restore = on_disk(&dir);
+        h.send(Msg::Quit);
+        let lost: Vec<String> =
+            saved.iter().filter(|s| place_of(&after_restore, &s.note).is_none()).map(|s| s.note.clone()).collect();
+        (lost, std::fs::read_to_string(dir.join("state/stickies.json")).unwrap())
+    };
+    // The next login: each sticky at its old size (300 × 260).
+    let f = Fusen::new(places(&dir), Request { stickies_only: true, ..Request::default() });
+    let h = Harness::new(f);
+    let sizes: Vec<(String, f64, f64)> = h
+        .program()
+        .stickies
+        .iter()
+        .map(|(k, s)| (s.title.clone(), h.size(*k).width, h.size(*k).height))
+        .collect();
+    let wrong: Vec<&(String, f64, f64)> = sizes.iter().filter(|(_, w, hh)| *w != 300.0 || *hh != 260.0).collect();
+    assert!(
+        lost.is_empty() && wrong.is_empty(),
+        "restoring rewrote stickies.json without the places of {lost:?}; at the next login {wrong:?} \
+         (of {sizes:?}) opened at the default size. stickies.json after the first login:\n{written}"
+    );
+}
diff --git a/desktop/aizome/apps/fusen/tests/repro_sap_06.rs b/desktop/aizome/apps/fusen/tests/repro_sap_06.rs
new file mode 100644
index 00000000..2268c7d0
--- /dev/null
+++ b/desktop/aizome/apps/fusen/tests/repro_sap_06.rs
@@ -0,0 +1,125 @@
+//! SAP-06: a second launch while Fusen runs (the shell's Services "New
+//! Note", `aizome-fusen --new …`, a launcher click) must hand its request
+//! over and leave the running Fusen's stickies alone. `main` builds a whole
+//! `Fusen` before it claims the socket; on `Claim::Handed` it returns, and
+//! `Drop` runs `save_all` → `save_stickies` with no stickies open, writing
+//! `{"stickies": []}` and deleting the login item.
+//!
+//! End to end: the running Fusen is the real program in the kit's headless
+//! harness, serving the instance socket; the second launch is the real
+//! `aizome-fusen` binary with the same (private) HOME and XDG dirs.
+
+use std::path::{Path, PathBuf};
+use std::time::{Duration, Instant};
+
+use aizome_fusen::app::{Fusen, Msg, Places, Request};
+use aizome_kit::testing::Harness;
+use aizome_sumi::instance::{self, Claim};
+
+const ENTRY: &str = "org.aizome.Fusen.Stickies.desktop";
+
+struct Env {
+    home: PathBuf,
+    runtime: PathBuf,
+}
+
+impl Env {
+    fn new(name: &str) -> Env {
+        let base = std::env::temp_dir().join(format!("repro-sap-06-{name}-{}", std::process::id()));
+        let _ = std::fs::remove_dir_all(&base);
+        // A short runtime dir of our own (the socket's path must be short).
+        let rt = std::env::var_os("XDG_RUNTIME_DIR").map(PathBuf::from).unwrap_or_else(std::env::temp_dir);
+        let runtime = rt.join(format!("r06-{}", std::process::id()));
+        let _ = std::fs::remove_dir_all(&runtime);
+        std::fs::create_dir_all(&runtime).unwrap();
+        let home = base.join("home");
+        std::fs::create_dir_all(home.join("Notes")).unwrap();
+        Env { home, runtime }
+    }
+
+    /// What `Places::user()` gives under this HOME and XDG dirs.
+    fn places(&self) -> Places {
+        Places {
+            notes: self.home.join("Notes"),
+            state: Some(self.home.join(".local/state/aizome/fusen")),
+            trash: Some(self.home.join(".local/share/Trash")),
+            autostart: Some(self.home.join(".config/autostart")),
+            compositor: false,
+        }
+    }
+
+    fn stickies_json(&self) -> String {
+        std::fs::read_to_string(self.home.join(".local/state/aizome/fusen/stickies.json")).unwrap_or_default()
+    }
+
+    fn entry(&self) -> PathBuf {
+        self.home.join(".config/autostart").join(ENTRY)
+    }
+
+    fn launch(&self, args: &[&str]) -> std::process::Output {
+        std::process::Command::new(env!("CARGO_BIN_EXE_aizome-fusen"))
+            .args(args)
+            .env("HOME", &self.home)
+            .env("XDG_STATE_HOME", self.home.join(".local/state"))
+            .env("XDG_CONFIG_HOME", self.home.join(".config"))
+            .env("XDG_DATA_HOME", self.home.join(".local/share"))
+            .env("XDG_RUNTIME_DIR", &self.runtime)
+            .env_remove("WAYLAND_DISPLAY")
+            .env_remove("DISPLAY")
+            .env_remove("AIZOME_SOCKET")
+            .env_remove("AIZOME_SHELL_SOCKET")
+            .output()
+            .expect("run aizome-fusen")
+    }
+}
+
+impl Drop for Env {
+    fn drop(&mut self) {
+        let _ = std::fs::remove_dir_all(&self.runtime);
+    }
+}
+
+fn wait_for(h: &mut Harness<Fusen>, file: &Path) {
+    let until = Instant::now() + Duration::from_secs(10);
+    while !file.exists() {
+        assert!(Instant::now() < until, "the running Fusen never got the request");
+        std::thread::sleep(Duration::from_millis(5));
+        h.send(Msg::Nothing);
+    }
+}
+
+#[test]
+fn a_second_launch_keeps_the_stickies_and_their_login_item() {
+    let env = Env::new("second");
+    std::fs::write(env.home.join("Notes/Groceries.md"), "Groceries\n- [ ] miso\n").unwrap();
+
+    // The running Fusen, with one sticky, serving the socket at the path
+    // the binary will look for.
+    let Claim::First(listener) = instance::claim_at(env.runtime.join("aizome-app.fusen.sock"), &[]) else {
+        panic!("the running Fusen claims the socket")
+    };
+    let mut f = Fusen::new(env.places(), Request::default());
+    f.open_links = false;
+    f.instance = Some(listener);
+    let mut h = Harness::new(f);
+    let g = h.program().notes.iter().find(|n| n.title == "Groceries").unwrap().id;
+    h.send(Msg::Sticky(Some(g)));
+    assert_eq!(h.program().stickies.len(), 1);
+    assert!(env.stickies_json().contains("Groceries.md"), "{}", env.stickies_json());
+    assert!(env.entry().exists(), "a login item brings the sticky back");
+
+    // The second launch, as the shell's Services "New Note" runs it.
+    let out = env.launch(&["--new", "From Services\nselected text"]);
+    assert!(out.status.success(), "{out:?}");
+    wait_for(&mut h, &env.home.join("Notes/From Services.md"));
+    let (json, entry) = (env.stickies_json(), env.entry().exists());
+    assert!(
+        json.contains("Groceries.md") && entry,
+        "after a second launch handed its request over: stickies.json = {json:?}, login item present = {entry}"
+    );
+
+    // Killed before its next save (no Drop): the next login.
+    std::mem::forget(h);
+    let next = Harness::new(Fusen::new(env.places(), Request { stickies_only: true, ..Request::default() }));
+    assert_eq!(next.program().stickies.len(), 1, "the sticky comes back at the next login");
+}
diff --git a/desktop/aizome/apps/fusen/tests/repro_sap_07.rs b/desktop/aizome/apps/fusen/tests/repro_sap_07.rs
new file mode 100644
index 00000000..ba5dea1c
--- /dev/null
+++ b/desktop/aizome/apps/fusen/tests/repro_sap_07.rs
@@ -0,0 +1,93 @@
+//! SAP-07: once a pass styles a line from a guess (`incomplete`, here a
+//! jump to the end of a long note), the program must be asked to call again
+//! so the states get worked out. Fusen's highlighter never sets `scheduled`
+//! or calls `notify`, so `Msg::Highlight` is never sent and `incomplete`
+//! stays set; `state_at` then guesses at once for every line past the last
+//! edit, and code inside a fence below an edit shows as prose.
+
+use std::path::PathBuf;
+use std::time::Duration;
+
+use aizome_fusen::app::{Fusen, Places, Request};
+use aizome_kit::sidestep_ui::{Modifiers, NamedKey};
+use aizome_kit::testing::Harness;
+use aizome_sumi::syntax::cache::line_text;
+
+const CODE_LINES: usize = 4000;
+
+fn scratch(name: &str) -> PathBuf {
+    let d = std::env::temp_dir().join(format!("repro-sap-07-{name}-{}", std::process::id()));
+    let _ = std::fs::remove_dir_all(&d);
+    std::fs::create_dir_all(&d).unwrap();
+    d
+}
+
+fn incomplete(f: &Fusen, id: u64) -> bool {
+    f.open[&id].highlight.lock().unwrap().incomplete
+}
+
+/// Whether Fusen's highlighter styles line `line` as code (mono).
+fn styled_as_code(f: &Fusen, id: u64, line: usize) -> bool {
+    let o = &f.open[&id];
+    let text = line_text(o.content.rope(), line).into_owned();
+    let hl = aizome_fusen::view::highlighter(o, None);
+    hl(line, &text).iter().any(|s| s.span.mono)
+}
+
+#[test]
+fn code_under_an_edit_stays_code_after_a_jump_far_ahead() {
+    let dir = scratch("fence");
+    let notes = dir.join("Notes");
+    std::fs::create_dir_all(&notes).unwrap();
+    // A long note that is one fenced block: line 1 opens it.
+    let mut text = String::from("Long\n```\n");
+    for i in 0..CODE_LINES {
+        text.push_str(&format!("let x{i} = {i};\n"));
+    }
+    text.push_str("```\nafter\n");
+    std::fs::write(notes.join("Long.md"), &text).unwrap();
+    let mut f = Fusen::new(Places { notes, ..Places::default() }, Request::default());
+    f.open_links = false;
+    let mut h = Harness::new(f);
+    let w = h.program().main.expect("the main window");
+    h.focus_window(w, true);
+    let id = h.program().selected.expect("the note is shown");
+    let _ = h.render(w, 1.0);
+    assert!(styled_as_code(h.program(), id, 21), "precondition: code is code at first");
+
+    // Jump to the end (❖↓ in the editor): those lines are far beyond what
+    // a pass can work out, so they're guessed.
+    let e = h.find_id(w, "editor").expect("the editor");
+    h.click(w, e.center());
+    h.named(w, NamedKey::ArrowDown, Modifiers::SUPER);
+    let _ = h.render(w, 1.0);
+    let last = CODE_LINES + 1;
+    let _ = styled_as_code(h.program(), id, last);
+    assert!(incomplete(h.program(), id), "precondition: the far jump was styled from a guess");
+
+    // Give the program its passes between frames.
+    for _ in 0..100 {
+        let _ = h.render(w, 1.0);
+        if !incomplete(h.program(), id) {
+            break;
+        }
+        h.settle(Duration::from_millis(20), |p| !incomplete(p, id));
+    }
+    let after_passes = incomplete(h.program(), id);
+
+    // Back to the top and type inside the fence, on line 20.
+    h.named(w, NamedKey::ArrowUp, Modifiers::SUPER);
+    for _ in 0..20 {
+        h.named(w, NamedKey::ArrowDown, Modifiers::NONE);
+    }
+    h.type_text(w, "y");
+    let _ = h.render(w, 1.0);
+    assert!(h.program().open[&id].content.text().lines().nth(20).unwrap().starts_with('y'), "typed on line 20");
+    let prose: Vec<usize> = (21..=25).filter(|&l| !styled_as_code(h.program(), id, l)).collect();
+    let valid = h.program().open[&id].highlight.lock().unwrap().valid();
+    assert!(
+        prose.is_empty(),
+        "lines {prose:?} inside the fence show as prose after an edit on line 20 \
+         (incomplete still set after 100 passes: {after_passes}; states valid to line {valid})"
+    );
+}
