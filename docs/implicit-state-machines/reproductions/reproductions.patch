@@ -0,0 +1,166 @@
+//! UIW-15: an outline's and a table's keyboard cursor must follow the
+//! program's rows: (1) an outline whose branch closes under the cursor
+//! must not index past its rows on Return; (2) a table re-sorted by the
+//! program (its selection remapped) must activate the selected row.
+
+use std::sync::Arc;
+
+use aizome_kit::prelude::*;
+use aizome_kit::sidestep_ui::{Modifiers, NamedKey};
+use aizome_kit::testing::Harness;
+
+// (1) The outline.
+
+#[derive(Default)]
+struct Outline {
+    selected: Vec<u64>,
+    activated: Vec<u64>,
+}
+
+#[derive(Clone, Debug)]
+enum OMsg {
+    Select(Vec<u64>),
+    Activate(u64),
+}
+
+impl Program for Outline {
+    type Msg = OMsg;
+    fn info(&self) -> AppInfo {
+        AppInfo::new("org.aizome.ReproUiw15a", "Repro", "Repro")
+    }
+    fn launched(&mut self, cx: &mut Cx<OMsg>) {
+        cx.open_window(WindowSpec::new("Outline").size(400.0, 900.0));
+    }
+    fn update(&mut self, msg: OMsg, _cx: &mut Cx<OMsg>) {
+        match msg {
+            OMsg::Select(s) => self.selected = s,
+            OMsg::Activate(id) => self.activated.push(id),
+        }
+    }
+    fn view(&self, _w: WindowKey) -> Element<OMsg> {
+        let folder = TreeItem::branch(1, "Folder", (0..30).map(|i| TreeItem::leaf(100 + i, format!("file {i}"))).collect());
+        let items = vec![folder, TreeItem::leaf(2, "After")];
+        tree(items)
+            .row_height(24.0)
+            .selected(self.selected.iter().copied())
+            .on_select(OMsg::Select)
+            .on_activate(OMsg::Activate)
+            .id("outline")
+            .into()
+    }
+}
+
+#[test]
+fn repro_uiw_15_outline_return_after_the_cursor_row_is_collapsed_away() {
+    let mut h = Harness::new(Outline::default());
+    let w = h.window();
+    h.focus_window(w, true);
+    let r = h.find_id(w, "outline").unwrap();
+    let rh = 24.0;
+    let triangle = |row: f64| Point::new(r.x0 + 10.0, r.y0 + row * rh + rh / 2.0);
+    let label = |row: f64| Point::new(r.x0 + 120.0, r.y0 + row * rh + rh / 2.0);
+    // Open Folder by its triangle: 30 files show under it.
+    h.click(w, triangle(0.0));
+    assert!(h.texts(w).iter().any(|t| t == "file 24"), "the folder opened");
+    // Click file 24 (row 25): the cursor is 25.
+    h.click(w, label(25.0));
+    assert_eq!(h.program().selected, [124]);
+    // Close Folder by its triangle: two rows are left, the cursor stays 25.
+    h.click(w, triangle(0.0));
+    assert!(!h.texts(w).iter().any(|t| t == "file 24"), "the folder closed");
+    // Return: must not index row 25 of two.
+    h.named(w, NamedKey::Enter, Modifiers::NONE);
+    println!("activated: {:?}", h.program().activated);
+}
+
+// (2) The table, sorted by the program (as the portal's file chooser does).
+
+struct Files {
+    names: Vec<&'static str>,
+    selected: Vec<usize>,
+    activated: Vec<&'static str>,
+}
+
+#[derive(Clone, Debug)]
+#[allow(dead_code)]
+enum TMsg {
+    Select(Vec<usize>),
+    Sort(usize, bool),
+    Activate(usize),
+}
+
+impl Program for Files {
+    type Msg = TMsg;
+    fn info(&self) -> AppInfo {
+        AppInfo::new("org.aizome.ReproUiw15b", "Repro", "Repro")
+    }
+    fn launched(&mut self, cx: &mut Cx<TMsg>) {
+        cx.open_window(WindowSpec::new("Files").size(400.0, 300.0));
+    }
+    fn update(&mut self, msg: TMsg, _cx: &mut Cx<TMsg>) {
+        match msg {
+            TMsg::Select(s) => self.selected = s,
+            TMsg::Sort(_, ascending) => {
+                // Keep the selection by name across the sort.
+                let chosen: Vec<&str> = self.selected.iter().map(|&i| self.names[i]).collect();
+                self.names.sort();
+                if !ascending {
+                    self.names.reverse();
+                }
+                self.selected = chosen.iter().filter_map(|n| self.names.iter().position(|m| m == n)).collect();
+            }
+            TMsg::Activate(i) => self.activated.push(self.names[i]),
+        }
+    }
+    fn view(&self, _w: WindowKey) -> Element<TMsg> {
+        let names: Arc<Vec<&'static str>> = Arc::new(self.names.clone());
+        table(vec![Column::new("Name").width(200.0).sortable()], names.len(), move |r, _| text(names[r]))
+            .row_height(24.0)
+            .selected(self.selected.iter().copied())
+            .on_select(TMsg::Select)
+            .on_sort(TMsg::Sort)
+            .on_activate(TMsg::Activate)
+            .id("table")
+            .into()
+    }
+}
+
+#[test]
+fn repro_uiw_15_table_return_after_a_sort_activates_the_selected_row() {
+    let mut h = Harness::new(Files { names: vec!["b.txt", "a.txt", "c.txt"], selected: vec![], activated: vec![] });
+    let w = h.window();
+    h.focus_window(w, true);
+    // Click b.txt (row 0): selected and the cursor.
+    let t = h.find_id(w, "table").unwrap();
+    // Header 24 pt tall, then rows of 24 pt: b.txt is row 0.
+    let b = Point::new(t.x0 + 50.0, t.y0 + 24.0 + 12.0);
+    h.click(w, b);
+    assert_eq!(h.program().selected, [0]);
+    // Sort by name: a.txt, b.txt, c.txt; the program keeps b.txt selected.
+    let header = Point::new(t.x0 + 50.0, t.y0 + 12.0);
+    h.click(w, header);
+    assert_eq!(h.program().names, ["a.txt", "b.txt", "c.txt"]);
+    assert_eq!(h.program().selected, [1], "b.txt is still the selection, now row 1");
+    // Return opens the selected file.
+    h.named(w, NamedKey::Enter, Modifiers::NONE);
+    println!("activated after sort: {:?} (selected {:?})", h.program().activated, h.program().selected);
+    assert_eq!(h.program().activated, ["b.txt"], "Return activates the selected row, not the old cursor index");
+}
+
+#[test]
+fn repro_uiw_15_table_down_after_a_sort_moves_from_the_selected_row() {
+    let mut h = Harness::new(Files { names: vec!["b.txt", "a.txt", "c.txt"], selected: vec![], activated: vec![] });
+    let w = h.window();
+    h.focus_window(w, true);
+    let t = h.find_id(w, "table").unwrap();
+    // Header 24 pt tall, then rows of 24 pt: b.txt is row 0.
+    let b = Point::new(t.x0 + 50.0, t.y0 + 24.0 + 12.0);
+    h.click(w, b);
+    let header = Point::new(t.x0 + 50.0, t.y0 + 12.0);
+    h.click(w, header);
+    assert_eq!(h.program().selected, [1]);
+    h.named(w, NamedKey::ArrowDown, Modifiers::NONE);
+    let names: Vec<&str> = h.program().selected.iter().map(|&i| h.program().names[i]).collect();
+    println!("after ↓: selected {names:?}");
+    assert_eq!(names, ["c.txt"], "↓ from b.txt selects the row below it");
+}
diff --git a/desktop/aizome/crates/aizome-kit/tests/repro_uiw_18.rs b/desktop/aizome/crates/aizome-kit/tests/repro_uiw_18.rs
