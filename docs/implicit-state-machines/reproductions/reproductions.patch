+fn pump(h: &mut Harness<Settei>, until: impl Fn(&Harness<Settei>) -> bool) {
+    for _ in 0..400 {
+        if until(h) {
+            return;
+        }
+        std::thread::sleep(std::time::Duration::from_millis(5));
+        h.send(AppMsg::Nothing);
+    }
+}
+
+fn msg(m: Msg) -> AppMsg {
+    AppMsg::Pane("network", Arc::new(m))
+}
+
+/// What the field named `name` holds, as the window shows it.
+fn field(h: &Harness<Settei>, name: &str) -> Option<String> {
+    let w = h.window();
+    let f = h.inspected(w).into_iter().find(|e| e["name"] == name)?;
+    Some(f["text"].as_str().or(f["value"].as_str()).unwrap_or("").to_owned())
+}
+
+const A: &str = "c-studio";
+const B: &str = "c-hotel";
+
+#[test]
+fn repro_sta_15_a_late_change_to_one_connection_does_not_fill_anothers_page() {
+    use crate::pane::AnyPane;
+    let net = Rc::new(RefCell::new(Network::default()));
+    let tap = Tap { inner: net.clone(), hold: Rc::new(|_: &Msg| false), held: Rc::new(RefCell::new(Vec::new())) };
+    let mut panes = crate::panes::all();
+    let i = panes.iter().position(|p| AnyPane::id(&**p) == "network").unwrap();
+    panes[i] = crate::pane::pane(tap);
+    let dir = std::env::temp_dir().join(format!("settei-repro-sta-15-{}", std::process::id()));
+    let _ = std::fs::remove_dir_all(&dir);
+    std::fs::create_dir_all(&dir).unwrap();
+    let mut h = Harness::new(Settei::new(panes, dir.join("settings.toml"), true, Start::parse("network")));
+    let w = h.window();
+    h.resize(w, Size::new(940.0, 1400.0));
+    pump(&mut h, |h| h.texts(h.window()).iter().any(|t| t == "Kohaku"));
+
+    // Aizome Studio (A) gets a static address.
+    h.send(msg(Msg::Open(Page::Details(A.into()))));
+    h.send(msg(Msg::Ipv4(A.into(), 1)));
+    h.send(msg(Msg::AddressText("10.9.8.7/24".into())));
+    h.send(msg(Msg::RouterText("10.9.8.1".into())));
+    h.send(msg(Msg::ApplyAddress(A.into())));
+    pump(&mut h, |_| net.borrow().profile(A).is_some_and(|p| p.ipv4_method == "manual"));
+    assert_eq!(net.borrow().profile(A).map(|p| p.ipv4_addresses.clone()), Some(vec!["10.9.8.7/24".to_owned()]));
+
+    // Its DNS changed, then Back and Hotel Sakura (B) opened before the
+    // change comes back.
+    h.send_all([msg(Msg::DnsChoice(A.into(), Dns::Cloudflare)), msg(Msg::Back), msg(Msg::Open(Page::Details(B.into())))]);
+    pump(&mut h, |_| net.borrow().profile(A).is_some_and(|p| p.ipv4_dns.iter().any(|d| d == "1.1.1.1")));
+    assert!(net.borrow().profile(A).is_some_and(|p| p.ipv4_dns.iter().any(|d| d == "1.1.1.1")), "A's DNS change came back");
+    assert_eq!(net.borrow().page, Page::Details(B.into()));
+    let edit = net.borrow().edit.clone();
+
+    // B is automatic (DHCP): Manually chosen, its fields show.
+    h.send(msg(Msg::Ipv4(B.into(), 1)));
+    let address = field(&h, "network-address");
+    let router = field(&h, "network-router");
+    // And Apply.
+    h.send(msg(Msg::ApplyAddress(B.into())));
+    for _ in 0..40 {
+        std::thread::sleep(std::time::Duration::from_millis(5));
+        h.send(AppMsg::Nothing);
+    }
+    let b = net.borrow().sample_profiles.get(B).cloned();
+    let b_addresses = b.as_ref().map(|p| p.ipv4_addresses.clone()).unwrap_or_default();
+    let b_gateway = b.as_ref().and_then(|p| p.ipv4_gateway.clone());
+
+    let mut wrong = Vec::new();
+    if edit.uuid != B {
+        wrong.push(format!("on B's page the edit buffer is A's: {edit:?}"));
+    }
+    if address.as_deref().is_some_and(|a| a.contains("10.9.8.7")) || router.as_deref().is_some_and(|r| r.contains("10.9.8.1")) {
+        wrong.push(format!("B's IP address field shows {address:?}, its router {router:?}: A's"));
+    }
+    if b_addresses.iter().any(|a| a == "10.9.8.7/24") {
+        wrong.push(format!("Apply on B wrote A's static address to B: {b_addresses:?}, router {b_gateway:?}"));
+    }
+    assert!(wrong.is_empty(), "{}", wrong.join("\n"));
+}
