diff --git a/desktop/tatami/network/src/repro_tap_25.rs b/desktop/tatami/network/src/repro_tap_25.rs
new file mode 100644
index 00000000..60e5481f
--- /dev/null
+++ b/desktop/tatami/network/src/repro_tap_25.rs
@@ -0,0 +1,234 @@
+// SPDX-License-Identifier: MIT OR Apache-2.0
+//! TAP-25: closing the Network window while a new network is being joined.
+//! The join runs on a worker thread (`background`, window.rs:128-141) that
+//! nothing waits for: the last window closing ends `app.run()`, `main`
+//! returns, and the process exits with the worker inside
+//! `nmcli --wait 45 connection up`.
+//!
+//! The parent test runs the real program's `main` (main.rs:28-78) in a child
+//! process (this test binary, `repro_tap_25_child`), with a stub `nmcli`
+//! first on PATH, written by the test into TMPDIR: it lists one WPA2 network
+//! "Cafe", keeps added profiles as files, and fails `connection up` after
+//! 2 s with "Secrets were required, but not provided" (a mistyped password).
+//! The child joins "Cafe" through the real dialog, then closes the window as
+//! Escape does. No NetworkManager is used. Needs a display (a private Xvfb)
+//! and a session bus (the app is unique).
+use super::*;
+use std::{
+    os::unix::fs::PermissionsExt,
+    path::{Path, PathBuf},
+    process::Command,
+    time::Instant,
+};
+
+const NMCLI: &str = r#"#!/bin/sh
+D="$REPRO_STUB_DIR"
+log() { echo "$(date +%s.%N) [$$] $*" >> "$D/log"; }
+value() { key=$1; shift; while [ $# -gt 0 ]; do [ "$1" = "$key" ] && { echo "$2"; return; }; shift; done; }
+case "$*" in
+"-t -f WIFI-HW,WIFI radio") echo "enabled:enabled" ;;
+"-t -f DEVICE,TYPE,STATE,CONNECTION,CON-UUID device") echo "wlan0:wifi:disconnected::" ;;
+"-t -f NAME,UUID,TYPE,AUTOCONNECT,ACTIVE,DEVICE,STATE,TIMESTAMP connection show")
+    for p in "$D"/profiles/*; do [ -e "$p" ] && head -n 1 "$p"; done ;;
+"-t -f connection.uuid,802-11-wireless.ssid,802-11-wireless-security.key-mgmt connection show "*)
+    shift 5
+    for u; do [ -e "$D/profiles/$u" ] && tail -n +2 "$D/profiles/$u"; done ;;
+"-t -f IN-USE,SSID,SECURITY,SIGNAL device wifi list --rescan no") echo " :Cafe:WPA2:80" ;;
+"-t -f GENERAL.DEVICE,"*) printf 'GENERAL.DEVICE:wlan0\nGENERAL.HWADDR:AA:BB:CC:DD:EE:01\n' ;;
+"device wifi rescan") ;;
+"monitor") exec sleep 600 ;;
+"connection add "*)
+    name=$(value con-name "$@"); uuid=$(value connection.uuid "$@")
+    printf '%s:%s:802-11-wireless:yes:no:::0\nconnection.uuid:%s\n802-11-wireless.ssid:%s\n802-11-wireless-security.key-mgmt:wpa-psk\n\n' \
+        "$name" "$uuid" "$uuid" "$name" > "$D/profiles/$uuid"
+    log "connection add: $name ($uuid)"
+    echo "Connection '$name' ($uuid) successfully added." ;;
+"--wait 45 connection up "*)
+    uuid=$(value uuid "$@"); secret=$(value passwd-file "$@")
+    log "connection up $uuid: waiting (passwd-file $secret)"
+    sleep 2
+    log "connection up $uuid: failed"
+    echo "Error: Connection activation failed: Secrets were required, but not provided." >&2
+    exit 4 ;;
+"connection delete uuid "*) rm -f "$D/profiles/$4"; log "connection delete: $4" ;;
+*) log "nmcli $*: not scripted" ;;
+esac
+"#;
+
+fn stub_dir() -> PathBuf {
+    std::env::temp_dir().join("repro-tap-25")
+}
+
+fn note(text: &str) {
+    let log = stub_dir().join("log");
+    let line = format!("{:?} TEST: {text}\n", std::time::SystemTime::now());
+    let mut previous = std::fs::read_to_string(&log).unwrap_or_default();
+    previous.push_str(&line);
+    let _ = std::fs::write(log, previous);
+}
+
+fn descendants(widget: &gtk::Widget, out: &mut Vec<gtk::Widget>) {
+    let mut child = widget.first_child();
+    while let Some(current) = child {
+        out.push(current.clone());
+        descendants(&current, out);
+        child = current.next_sibling();
+    }
+}
+
+fn secrets(runtime: &Path, pid: u32) -> Vec<String> {
+    std::fs::read_dir(runtime)
+        .into_iter()
+        .flatten()
+        .flatten()
+        .map(|entry| entry.file_name().to_string_lossy().into_owned())
+        .filter(|name| name.starts_with(&format!("tatami-network-{pid}-")))
+        .collect()
+}
+
+/// The program, as the parent's child: `main`, driven by a timer that joins
+/// "Cafe" and then closes the window.
+#[test]
+fn repro_tap_25_child() {
+    if std::env::var_os("REPRO_TAP_25_CHILD").is_none() {
+        return;
+    }
+    let log = stub_dir().join("log");
+    let mut step = 0;
+    glib::timeout_add_local(Duration::from_millis(50), move || {
+        let Some(ui) = UI.with_borrow(Clone::clone) else {
+            return glib::ControlFlow::Continue;
+        };
+        match step {
+            // The first reading is in: choose "Cafe".
+            0 if ui.state.borrow().loaded => {
+                let network = ui
+                    .state
+                    .borrow()
+                    .snapshot
+                    .networks
+                    .iter()
+                    .find(|n| n.ssid == "Cafe")
+                    .cloned()
+                    .expect("Cafe in range");
+                note("Cafe chosen");
+                join::network(&ui, network);
+                step = 1;
+            }
+            // The password dialog: type a password and choose Join.
+            1 => {
+                let dialog = ui.window.visible_dialog().expect("the password dialog");
+                let mut inside = Vec::new();
+                descendants(dialog.upcast_ref(), &mut inside);
+                let entry = inside
+                    .iter()
+                    .find_map(|w| w.downcast_ref::<adw::PasswordEntryRow>().cloned())
+                    .expect("the password row");
+                entry.set_text("mistyped-password");
+                let join = inside
+                    .iter()
+                    .filter_map(|w| w.downcast_ref::<gtk::Button>())
+                    .find(|button| {
+                        let mut labels = Vec::new();
+                        descendants(button.upcast_ref(), &mut labels);
+                        button.label().as_deref() == Some("Join")
+                            || labels.iter().any(|l| {
+                                l.downcast_ref::<gtk::Label>()
+                                    .is_some_and(|l| l.label() == "Join")
+                            })
+                    })
+                    .cloned()
+                    .expect("the Join button");
+                note("Join clicked");
+                join.emit_clicked();
+                step = 2;
+            }
+            // Joining: nmcli waits for the network. The person presses
+            // Escape, which closes the window from the first page.
+            2 if std::fs::read_to_string(&log)
+                .unwrap_or_default()
+                .contains("waiting (passwd-file") =>
+            {
+                assert_eq!(ui.state.borrow().joining.as_deref(), Some("Cafe"));
+                note("window closed while joining");
+                ui.window.close();
+                return glib::ControlFlow::Break;
+            }
+            _ => {}
+        }
+        glib::ControlFlow::Continue
+    });
+    let code = crate::main();
+    note(&format!("main returned {code:?}; the process exits"));
+    std::process::exit(0);
+}
+
+#[test]
+fn repro_tap_25_close_while_joining() {
+    let dir = stub_dir();
+    let _ = std::fs::remove_dir_all(&dir);
+    std::fs::create_dir_all(dir.join("bin")).unwrap();
+    std::fs::create_dir_all(dir.join("profiles")).unwrap();
+    std::fs::write(dir.join("log"), "").unwrap();
+    let nmcli = dir.join("bin").join("nmcli");
+    std::fs::write(&nmcli, NMCLI).unwrap();
+    std::fs::set_permissions(&nmcli, std::fs::Permissions::from_mode(0o755)).unwrap();
+    let runtime = PathBuf::from(std::env::var("XDG_RUNTIME_DIR").unwrap());
+    assert!(runtime.starts_with(&*std::env::var("ISOLATE_SCRATCH").expect("run through docs/implicit-state-machines/reproductions/isolate")), "a private runtime directory");
+
+    let mut child = Command::new(std::env::current_exe().unwrap())
+        .args([
+            "window::repro_tap_25::repro_tap_25_child",
+            "--exact",
+            "--nocapture",
+            "--test-threads=1",
+        ])
+        .env("REPRO_TAP_25_CHILD", "1")
+        .env("REPRO_STUB_DIR", &dir)
+        .env(
+            "PATH",
+            format!("{}:{}", dir.join("bin").display(), std::env::var("PATH").unwrap()),
+        )
+        .spawn()
+        .unwrap();
+    let pid = child.id();
+    let start = Instant::now();
+    let status = loop {
+        if let Some(status) = child.try_wait().unwrap() {
+            break status;
+        }
+        if start.elapsed() > Duration::from_secs(90) {
+            let _ = child.kill();
+            panic!("the child did not end");
+        }
+        std::thread::sleep(Duration::from_millis(50));
+    };
+    // nmcli's own wait ends 2 s after it began.
+    let log = || std::fs::read_to_string(dir.join("log")).unwrap_or_default();
+    let wait = Instant::now();
+    while !log().contains(": failed") && wait.elapsed() < Duration::from_secs(6) {
+        std::thread::sleep(Duration::from_millis(50));
+    }
+    std::thread::sleep(Duration::from_millis(500));
+    let left: Vec<String> = secrets(&runtime, pid);
+    let profiles: Vec<String> = std::fs::read_dir(dir.join("profiles"))
+        .unwrap()
+        .flatten()
+        .map(|entry| entry.file_name().to_string_lossy().into_owned())
+        .collect();
+    let text = log();
+    // Test data only, in the private runtime directory.
+    for name in &left {
+        let _ = std::fs::remove_file(runtime.join(name));
+    }
+    assert!(status.success(), "the child failed: {status:?}\n{text}");
+    assert!(
+        text.contains("window closed while joining"),
+        "the child did not reach the close:\n{text}"
+    );
+    assert!(
+        left.is_empty() && profiles.is_empty(),
+        "window closed while joining Cafe with a mistyped password, then the join failed: \
+         passwd-files left in XDG_RUNTIME_DIR {left:?}; profiles left {profiles:?}\nlog:\n{text}"
+    );
+}
