+#[test]
+fn repro_sta_05_a_refused_region_choice_keeps_the_formats_preview() {
+    use crate::pane::AnyPane;
+    let general = Rc::new(RefCell::new(General::default()));
+    let holding = Rc::new(std::cell::Cell::new(false));
+    let held = Rc::new(RefCell::new(Vec::new()));
+    let h2 = holding.clone();
+    let tap = Tap {
+        inner: general.clone(),
+        hold: Rc::new(move |m: &G| h2.get() && matches!(m, G::Language(Msg::Done(..)))),
+        held: held.clone(),
+    };
+    let mut panes = crate::panes::all();
+    let i = panes.iter().position(|p| AnyPane::id(&**p) == "general").unwrap();
+    panes[i] = crate::pane::pane(tap);
+    let dir = std::env::temp_dir().join(format!("settei-repro-sta-05-{}", std::process::id()));
+    let _ = std::fs::remove_dir_all(&dir);
+    std::fs::create_dir_all(&dir).unwrap();
+    let mut h = Harness::new(Settei::new(panes, dir.join("settings.toml"), true, Start::parse("general.region")));
+    pump(&mut h, |h| has(h, "Week starts"));
+    assert!(has(&h, "Week starts"), "the preview at first: {:?}", h.texts(h.window()));
+
+    // localed as polkit asks: the request taken, nothing signalled.
+    let snapshot = general.borrow().language.snapshot();
+    let quiet = Svc::Sample(Cell::new((*snapshot).clone(), aizome_sys::Wake::none()));
+    let real = general.borrow_mut().language.svc.replace(quiet);
+    holding.set(true);
+    // German formats chosen (Region 1 is the first locale, de_DE).
+    h.send(AppMsg::Pane("general", Arc::new(G::Language(Msg::Region(1)))));
+    pump(&mut h, |_| held.borrow().len() == 1);
+    assert_eq!(held.borrow().len(), 1, "the request's answer");
+    // The prompt dismissed: localed keeps what it had, and says so.
+    general.borrow_mut().language.svc = real;
+    holding.set(false);
+    let what = match held.borrow_mut().remove(0) {
+        G::Language(Msg::Done(what, _)) => what,
+        other => panic!("{other:?}"),
+    };
+    h.send(AppMsg::Pane(
+        "general",
+        Arc::new(G::Language(Msg::Done(what, Err("Not authorized: the request was dismissed".into())))),
+    ));
+    // Time passes; localed has nothing to say (nothing changed).
+    for _ in 0..20 {
+        std::thread::sleep(std::time::Duration::from_millis(5));
+        h.send(AppMsg::Nothing);
+    }
+    let preview = general.borrow().language.preview.clone();
+    let reading = general.borrow().language.reading.clone();
+    let status = h.program().shared.status.clone().map(|s| s.text);
+    assert!(
+        preview.is_some() && has(&h, "Week starts"),
+        "after the refused Region choice the Formats section is a spinner: preview {preview:?}, \
+         reading {reading:?}, locale shown {:?}, status {status:?}",
+        general.borrow().language.shown_locale()
+    );
+}
