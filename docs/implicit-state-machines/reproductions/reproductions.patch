index 00000000..44429865
--- /dev/null
+++ b/installer/genkan/ui/tests/repro_gen_34.rs
@@ -0,0 +1,77 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+//! GEN-34: the person confirms before preparation finishes (allowed by
+//! design: "Finishing preparation…"), then preparation fails before any disk
+//! write, e.g. the in-memory build's download fails ("the target disk has not
+//! been erased"). `show_failure` takes its `installing` branch: step 1
+//! "Partition the disk" is marked failed, the page is headed "Installation
+//! Failed" and says "The disk may have been modified", and there is no way
+//! back to the review.
+//!
+//! Headless, on the preview's review page (preparation still working,
+//! generation 0); the helper's events go through the real `Msg::Session`
+//! handler in the order the helper sends them for this case: `Failed`, then
+//! the exit (status 1).
+use aizome_kit::testing::Harness;
+use aizome_kit::theme::{Appearance, ThemeChoice};
+use calamares_nixos::install::Event;
+use genkan::Step;
+use genkan::app::{Genkan, Helper, Msg, StepState};
+
+#[test]
+fn a_failure_before_any_disk_write_is_not_reported_as_a_failed_partitioning() {
+    let appearance = Appearance {
+        theme: ThemeChoice::Night,
+        reduced_motion: true,
+        ..Appearance::default()
+    };
+    let mut h = Harness::with(Genkan::new(Some("review".into())), appearance, false);
+    let w = h.window();
+    assert_eq!(h.program().step, Step::Review);
+    assert!(!h.program().prepared, "preparation is still running");
+    let phrase = h.program().phrase.clone();
+    h.send(Msg::Erase(phrase));
+    h.send(Msg::Consent(true));
+    assert!(h.program().next_enabled(), "confirming early is allowed");
+    h.send(Msg::Next);
+    assert_eq!(h.program().step, Step::Install);
+    println!("after confirming: {:?}", h.program().install_message);
+
+    // The helper's in-memory build fails (install.rs:466), before step 1.
+    let message = "The installed system could not be built; the target disk has not been erased: \
+                   nix failed (exit status: 1): error: unable to download 'https://cache.nixos.org/nar/…': HTTP error 503";
+    h.send(Msg::Session(0, Helper::Event(Event::Failed { message: message.into() })));
+    h.send(Msg::Session(
+        0,
+        Helper::Finished(Err("The installation helper stopped (authorization canceled or helper failed, exit status: 1). Do not assume the disk is unchanged if installation had started.".into())),
+    ));
+
+    let app = h.program();
+    let texts = h.texts(w);
+    let says = |what: &str| texts.iter().any(|t| t.contains(what));
+    let failed_steps: Vec<usize> = app
+        .steps
+        .iter()
+        .enumerate()
+        .filter(|(_, s)| **s == StepState::Failed)
+        .map(|(i, _)| i + 1)
+        .collect();
+    let heading_failed = says("Installation Failed");
+    let disk_may_be_modified = says("The disk may have been modified");
+    let back = texts.iter().any(|t| t == "Back");
+    println!(
+        "step={:?} install_step={} failed_steps={failed_steps:?} heading_failed={heading_failed} \
+         disk_may_be_modified={disk_may_be_modified} back_offered={back} next_label={:?} \
+         reachable(Review)={} password_cleared={}",
+        app.step,
+        app.install_step,
+        app.next_label(),
+        app.reachable(Step::Review),
+        app.password.is_empty()
+    );
+    assert!(
+        failed_steps.is_empty() && !disk_may_be_modified,
+        "a failure before any disk write was shown as a failed installation: failed steps \
+         {failed_steps:?} (1 = \"Partition the disk\"), \"The disk may have been modified\": \
+         {disk_may_be_modified}, \"Installation Failed\": {heading_failed}, Back offered: {back}"
+    );
+}
diff --git a/rust/tests/repro_ktl_13.rs b/rust/tests/repro_ktl_13.rs
new file mode 100644
index 00000000..424cfed8
--- /dev/null
+++ b/rust/tests/repro_ktl_13.rs
@@ -0,0 +1,165 @@
+//! KTL-13: the host waits for the guest's whole `build-iso` through
+//! `support::run` (builder.rs:306), capped at 7200 s (support.rs:67), while
+//! the guest runs `nix flake check` and `nix build .#iso` through the same
+//! `run`, each under its own 7200 s cap (builder.rs:396, builder.rs:429). A
+//! cold build whose two steps each stay within their own limit, but together
+//! take more than two hours, is killed from the host.
+//!
+//! Real code on both sides: `respin_tools::support::run` and `Process::wait`.
+//! The guest's two steps are `sleep 4000` run through `run`, as build_iso
+//! runs its two nix commands. Time is scaled: an LD_PRELOAD shim, compiled
+//! here, makes CLOCK_MONOTONIC and sleeps run SCALE times fast in every
+//! process of the run, so 2 x 4000 s of guest work takes about 8 s.
+
+use respin_tools::support::run;
+use std::path::Path;
+use std::process::{Command, Stdio};
+use std::time::{Duration, Instant, SystemTime};
+use std::{env, fs};
+
+const SCALE: &str = "1000";
+const ROLE: &str = "KTL13_ROLE";
+
+const SHIM: &str = r#"
+#define _GNU_SOURCE
+#include <dlfcn.h>
+#include <stdlib.h>
+#include <time.h>
+
+static long long factor(void) {
+    static long long f;
+    if (!f) { const char *s = getenv("KTL13_SCALE"); f = s ? atoll(s) : 1; if (f < 1) f = 1; }
+    return f;
+}
+static int scaled(clockid_t c) {
+    return c == CLOCK_MONOTONIC || c == CLOCK_MONOTONIC_RAW || c == CLOCK_MONOTONIC_COARSE || c == CLOCK_BOOTTIME;
+}
+static long long ns(const struct timespec *t) { return (long long)t->tv_sec * 1000000000LL + t->tv_nsec; }
+static struct timespec ts(long long n) { struct timespec t = { n / 1000000000LL, n % 1000000000LL }; return t; }
+
+static int (*real_gettime)(clockid_t, struct timespec *);
+static long long base = -1;
+static void init(void) {
+    if (!real_gettime) real_gettime = (int (*)(clockid_t, struct timespec *))dlsym(RTLD_NEXT, "clock_gettime");
+    if (base < 0) { struct timespec t; real_gettime(CLOCK_MONOTONIC, &t); base = ns(&t); }
+}
+/* Fake monotonic time: base + (real - base) * factor, per process. */
+int clock_gettime(clockid_t c, struct timespec *t) {
+    init();
+    int r = real_gettime(c, t);
+    if (r == 0 && scaled(c)) *t = ts(base + (ns(t) - base) * factor());
+    return r;
+}
+int nanosleep(const struct timespec *req, struct timespec *rem) {
+    static int (*real)(const struct timespec *, struct timespec *);
+    if (!real) real = (int (*)(const struct timespec *, struct timespec *))dlsym(RTLD_NEXT, "nanosleep");
+    struct timespec s = ts(ns(req) / factor());
+    int r = real(&s, rem);
+    if (r != 0 && rem) *rem = ts(ns(rem) * factor());
+    return r;
+}
+int clock_nanosleep(clockid_t c, int flags, const struct timespec *req, struct timespec *rem) {
+    static int (*real)(clockid_t, int, const struct timespec *, struct timespec *);
+    if (!real) real = (int (*)(clockid_t, int, const struct timespec *, struct timespec *))dlsym(RTLD_NEXT, "clock_nanosleep");
+    init();
+    struct timespec s;
+    if (flags & TIMER_ABSTIME) {
+        if (!scaled(c)) return real(c, flags, req, rem);
+        s = ts(base + (ns(req) - base) / factor());
+    } else {
+        s = ts(ns(req) / factor());
+    }
+    int r = real(c, flags, &s, rem);
+    if (r != 0 && rem && !(flags & TIMER_ABSTIME)) *rem = ts(ns(rem) * factor());
+    return r;
+}
+"#;
+
+/// The guest's build-iso reduced to its two capped steps (builder.rs:385-441).
+#[test]
+#[ignore = "spawned by repro_ktl_13_host_outlasts_the_guest_build_steps"]
+fn repro_ktl_13_guest_build_iso() {
+    if env::var(ROLE).as_deref() != Ok("guest") {
+        return;
+    }
+    run(Command::new("sleep").arg("4000")).expect("step 1 (nix flake check) within its own 7200 s");
+    eprintln!("KTL13 guest: step 1 of 4000 s finished within its 7200 s cap");
+    run(Command::new("sleep").arg("4000")).expect("step 2 (nix build .#iso) within its own 7200 s");
+    eprintln!("KTL13 guest: step 2 of 4000 s finished within its 7200 s cap");
+}
+
+/// The host's run(ssh … build-iso) (builder.rs:306-308).
+#[test]
+#[ignore = "spawned by repro_ktl_13_host_outlasts_the_guest_build_steps"]
+fn repro_ktl_13_host_build() {
+    if env::var(ROLE).as_deref() != Ok("host") {
+        return;
+    }
+    // Refuse to run unscaled: 5 s of fake sleep must take well under 1 s.
+    let wall = SystemTime::now();
+    std::thread::sleep(Duration::from_secs(5));
+    assert!(wall.elapsed().unwrap() < Duration::from_secs(1), "the time-scaling shim is not active");
+
+    let log = env::var("KTL13_GUEST_LOG").unwrap();
+    let started = Instant::now();
+    let result = run(Command::new(env::current_exe().unwrap())
+        .args(["--exact", "repro_ktl_13_guest_build_iso", "--ignored", "--nocapture", "--test-threads=1"])
+        .env(ROLE, "guest")
+        .stdin(Stdio::null())
+        .stdout(fs::File::create(&log).unwrap())
+        .stderr(fs::File::options().append(true).open(&log).unwrap()));
+    let waited = started.elapsed().as_secs();
+    let guest = fs::read_to_string(&log).unwrap_or_default();
+    let steps: Vec<&str> = guest.lines().filter_map(|l| l.split_once("KTL13 guest: ").map(|(_, s)| s)).collect();
+    assert!(
+        result.is_ok(),
+        "the host gave up on the guest's build-iso after {waited} s (scaled clock): {:#}; the guest had \
+         reported {steps:?}",
+        result.unwrap_err()
+    );
+}
+
+#[test]
+fn repro_ktl_13_host_outlasts_the_guest_build_steps() {
+    let dir = tempfile::tempdir().unwrap();
+    let source = dir.path().join("timescale.c");
+    let shim = dir.path().join("timescale.so");
+    fs::write(&source, SHIM).unwrap();
+    let built = Command::new("cc").args(["-shared", "-fPIC", "-O2", "-o"]).arg(&shim).arg(&source).arg("-ldl").status();
+    assert!(built.is_ok_and(|s| s.success()), "could not build the time-scaling shim");
+    assert_shim_scales_sleep(&shim);
+
+    let log = dir.path().join("guest.log");
+    let out = Command::new(env::current_exe().unwrap())
+        .args(["--exact", "repro_ktl_13_host_build", "--ignored", "--nocapture", "--test-threads=1"])
+        .env(ROLE, "host")
+        .env("LD_PRELOAD", &shim)
+        .env("KTL13_SCALE", SCALE)
+        .env("KTL13_GUEST_LOG", &log)
+        .stdin(Stdio::null())
+        .output()
+        .unwrap();
+    let text = format!("{}{}", String::from_utf8_lossy(&out.stdout), String::from_utf8_lossy(&out.stderr));
+    let decisive: Vec<&str> = text.lines().filter(|l| l.contains("gave up") || l.contains("shim")).collect();
+    assert!(out.status.success(), "{}", decisive.join("\n"));
+}
+
+/// `sleep 1000` under the shim must end within a few real seconds.
+fn assert_shim_scales_sleep(shim: &Path) {
+    let mut child = Command::new("sleep")
+        .arg("1000")
+        .env("LD_PRELOAD", shim)
+        .env("KTL13_SCALE", SCALE)
+        .spawn()
+        .unwrap();
+    let end = Instant::now() + Duration::from_secs(5);
+    while Instant::now() < end {
+        if child.try_wait().unwrap().is_some() {
+            return;
+        }
+        std::thread::sleep(Duration::from_millis(50));
+    }
+    let _ = child.kill();
+    let _ = child.wait();
+    panic!("the time-scaling shim does not shorten sleep(1)");
+}
diff --git a/rust/tests/repro_ktl_20.py b/rust/tests/repro_ktl_20.py
new file mode 100644
index 00000000..8e6d9405
--- /dev/null
+++ b/rust/tests/repro_ktl_20.py
@@ -0,0 +1,115 @@
+"""KTL-20: a stand-in for qemu-system-x86_64. Nothing boots.
+
+It parses the QMP, guest-agent and serial options respin-tools passes,
+answers the monitor and the guest agent on their Unix sockets, records
+every guest-exec command as one JSON line in $KTL20_LOG, and gives the
+outputs a live medium and an installed Sekka would. The backend install
+command's log redirect, `> '/workspace/artifacts/RUN/install.log'`, is
+written under $RESPIN_REPO (the 9p share). guest-shutdown exits with 0.
+"""
+
+import base64
+import json
+import os
+import re
+import socket
+import sys
+import threading
+
+LOCK = "ab" * 32
+args = sys.argv[1:]
+qmp_path = qga_path = serial_path = None
+for i, arg in enumerate(args):
+    value = args[i + 1] if i + 1 < len(args) else ""
+    if arg == "-qmp":
+        qmp_path = value.split(",")[0].removeprefix("unix:")
+    elif arg == "-chardev" and "id=qga" in value:
+        qga_path = re.search(r"path=([^,]+)", value).group(1)
+    elif arg == "-serial":
+        serial_path = value.removeprefix("file:")
+open(serial_path, "a").close()
+log_path = os.environ["KTL20_LOG"]
+repo = os.environ["RESPIN_REPO"]
+lock = threading.Lock()
+outputs = {}
+next_pid = [100]
+
+
+def record(command):
+    with lock, open(log_path, "a") as log:
+        log.write(json.dumps({"command": command}) + "\n")
+
+
+def answer(command):
+    if "systemctl is-active display-manager; pgrep" in command:
+        return "active\nnix (Determinate Nix 3.11.0) 2.31.0\n"
+    if command.startswith("sha256sum /etc/calamares-nixos/flake.lock"):
+        return f"{LOCK}  /etc/calamares-nixos/flake.lock\n"
+    if command == "uname -r":
+        return "6.12.0-sekka\n"
+    if command.startswith("nmcli"):
+        return "nixos\n"
+    if " install > " in command:
+        target = re.search(r"> '(/workspace/[^']+)'", command).group(1)
+        path = os.path.join(repo, target.removeprefix("/workspace/"))
+        with open(path, "w") as out:
+            out.write('{"kind":"complete"}\n')
+        return ""
+    if command.rstrip().endswith(" verify"):
+        return f"nix (Determinate Nix 3.11.0) 2.31.0\n{LOCK}  /etc/nixos/flake.lock\nDESKTOP_SESSION=aizome\n"
+    return ""
+
+
+def reply(conn, request, value):
+    conn.sendall((json.dumps({"return": value, "id": request.get("id")}) + "\n").encode())
+
+
+def agent(conn):
+    for line in conn.makefile("r"):
+        request = json.loads(line)
+        command = request["execute"]
+        if command == "guest-ping":
+            reply(conn, request, {})
+        elif command == "guest-exec":
+            text = request["arguments"]["arg"][1]
+            record(text)
+            with lock:
+                next_pid[0] += 1
+                pid = next_pid[0]
+                outputs[pid] = answer(text)
+            reply(conn, request, {"pid": pid})
+        elif command == "guest-exec-status":
+            out = outputs.get(request["arguments"]["pid"], "")
+            reply(conn, request, {"exited": True, "exitcode": 0, "out-data": base64.b64encode(out.encode()).decode()})
+        elif command == "guest-shutdown":
+            os._exit(0)
+        else:
+            reply(conn, request, {})
+
+
+def monitor(conn):
+    conn.sendall(b'{"QMP": {"version": {}, "capabilities": []}}\n')
+    for line in conn.makefile("r"):
+        request = json.loads(line)
+        if request["execute"] == "screendump":
+            with open(request["arguments"]["filename"], "wb") as out:
+                out.write(b"\x89PNG repro")
+        reply(conn, request, {})
+
+
+def listen(path, handler):
+    server = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
+    server.bind(path)
+    server.listen()
+
+    def accept():
+        while True:
+            conn, _ = server.accept()
+            threading.Thread(target=handler, args=(conn,), daemon=True).start()
+
+    threading.Thread(target=accept, daemon=True).start()
+
+
+listen(qmp_path, monitor)
+listen(qga_path, agent)
+threading.Event().wait()
diff --git a/rust/tests/repro_ktl_20.rs b/rust/tests/repro_ktl_20.rs
new file mode 100644
index 00000000..7aeb0ecd
--- /dev/null
+++ b/rust/tests/repro_ktl_20.rs
@@ -0,0 +1,177 @@
+//! KTL-20: `boot-installed` rebuilds the fixture's `verify` command from the
+//! CALAMARES_TEST_* variables of the shell it runs in (`fixture_options()`
+//! in `verify_installed`, vm.rs:687), while `qemu-test` records only
+//! `encrypted` of them in result.json (vm.rs:848). Of the forwarded choices,
+//! the fixture's `verify` reads only CALAMARES_TEST_GITHUB from its
+//! environment (vm-fixture main.rs:831); `flag` treats unset as on and only
+//! "0" or "false" as off (vm-fixture main.rs:216-218).
+//!
+//! Real code: `respin_tools::vm::main` (qemu-test --install) and
+//! `vm::boot_installed`, with `qemu-system-x86_64` on PATH replaced by
+//! repro_ktl_20.py, which answers QMP and the guest agent and records every
+//! guest command. Nothing boots; the 40 GiB target disk is a sparse file.
+
+use respin_tools::vm;
+use serde_json::Value;
+use std::path::{Path, PathBuf};
+use std::process::Command;
+use std::{env, fs};
+
+const OPTIONS: [&str; 6] = [
+    "CALAMARES_TEST_DESKTOPS",
+    "CALAMARES_TEST_ENCRYPT",
+    "CALAMARES_TEST_SWAP",
+    "CALAMARES_TEST_TUNING",
+    "CALAMARES_TEST_SESSION",
+    "CALAMARES_TEST_GITHUB",
+];
+
+fn set(name: &str, value: Option<&str>) {
+    // SAFETY: this test binary has one test, and no other threads read the environment meanwhile.
+    unsafe {
+        match value {
+            Some(value) => env::set_var(name, value),
+            None => env::remove_var(name),
+        }
+    }
+}
+
+fn commands(log: &Path) -> Vec<String> {
+    fs::read_to_string(log)
+        .unwrap_or_default()
+        .lines()
+        .map(|l| serde_json::from_str::<Value>(l).unwrap()["command"].as_str().unwrap().to_owned())
+        .collect()
+}
+
+/// The forwarded fixture choices in a guest command.
+fn choices(command: &str) -> Vec<String> {
+    command
+        .split_whitespace()
+        .filter(|w| OPTIONS.iter().any(|o| w.starts_with(&format!("{o}="))))
+        .map(str::to_owned)
+        .collect()
+}
+
+/// The fixture's github_test(): on unless the variable is "0" or "false".
+fn github(choices: &[String]) -> bool {
+    !choices.iter().any(|c| c == "CALAMARES_TEST_GITHUB=0" || c == "CALAMARES_TEST_GITHUB=false")
+}
+
+fn run_dirs(repo: &Path) -> Vec<String> {
+    let mut names: Vec<String> = fs::read_dir(repo.join("artifacts"))
+        .map(|d| d.flatten().map(|e| e.file_name().to_string_lossy().into_owned()).collect())
+        .unwrap_or_default();
+    names.sort();
+    names
+}
+
+/// qemu-test --install from a shell with `github` as CALAMARES_TEST_GITHUB;
+/// returns the run name and the install command's choices.
+fn install(repo: &Path, iso: &Path, log: &Path, github: Option<&str>) -> (String, Vec<String>) {
+    set("CALAMARES_TEST_GITHUB", github);
+    let before = run_dirs(repo);
+    let start = commands(log).len();
+    vm::main(vec![iso.display().to_string(), "--install".into(), "--firmware".into(), "bios".into()])
+        .expect("qemu-test --install against the fake QEMU");
+    set("CALAMARES_TEST_GITHUB", None);
+    let name = run_dirs(repo).into_iter().find(|n| !before.contains(n)).unwrap();
+    let all = commands(log);
+    let install = all[start..].iter().find(|c| c.contains(" install > ")).expect("the backend install command");
+    (name, choices(install))
+}
+
+/// boot-installed RUN from a shell with `github`; returns the verify choices.
+fn resume(name: &str, log: &Path, github: Option<&str>) -> Vec<String> {
+    set("CALAMARES_TEST_GITHUB", github);
+    let start = commands(log).len();
+    vm::boot_installed(vec![name.into()]).expect("boot-installed against the fake QEMU");
+    set("CALAMARES_TEST_GITHUB", None);
+    let all = commands(log);
+    let verify = all[start..].iter().find(|c| c.trim_end().ends_with(" verify")).expect("the verify command");
+    choices(verify)
+}
+
+#[test]
+fn repro_ktl_20_a_resumed_boot_verifies_the_choices_the_installation_was_made_with() {
+    let tmp = tempfile::tempdir().unwrap();
+    let repo = tmp.path().join("repo");
+    fs::create_dir_all(&repo).unwrap();
+    let git = |args: &[&str]| {
+        let ok = Command::new("git")
+            .arg("-C")
+            .arg(&repo)
+            .args(["-c", "user.name=repro", "-c", "user.email=repro@example.invalid"])
+            .args(args)
+            .status()
+            .unwrap()
+            .success();
+        assert!(ok, "git {args:?}");
+    };
+    git(&["init", "-q"]);
+    git(&["commit", "-q", "--allow-empty", "-m", "repro"]);
+    let iso = tmp.path().join("sekka.iso");
+    fs::write(&iso, b"not an ISO").unwrap();
+    let fixture = tmp.path().join("calamares-vm-fixture");
+    fs::write(&fixture, "#!/bin/sh\n").unwrap();
+    let bin = tmp.path().join("bin");
+    fs::create_dir(&bin).unwrap();
+    let fake = PathBuf::from(env!("CARGO_MANIFEST_DIR")).join("tests/repro_ktl_20.py");
+    let qemu = bin.join("qemu-system-x86_64");
+    fs::write(&qemu, format!("#!/bin/sh\nexec python3 -I '{}' \"$@\"\n", fake.display())).unwrap();
+    use std::os::unix::fs::PermissionsExt;
+    fs::set_permissions(&qemu, fs::Permissions::from_mode(0o755)).unwrap();
+    let log = tmp.path().join("guest-commands.jsonl");
+
+    set("PATH", Some(&format!("{}:{}", bin.display(), env::var("PATH").unwrap())));
+    set("RESPIN_REPO", Some(repo.to_str().unwrap()));
+    set("RESPIN_FIXTURE", Some(fixture.to_str().unwrap()));
+    set("KTL20_LOG", Some(log.to_str().unwrap()));
+    set("RESPIN_QEMU_ACCEL", None);
+    for name in OPTIONS {
+        set(name, None);
+    }
+
+    // The audit's example: installed asking for the GitHub step, resumed in
+    // a fresh shell. Unset means on in the fixture, so this one agrees.
+    let (with_one, installed_one) = install(&repo, &iso, &log, Some("1"));
+    let fresh_after_one = resume(&with_one, &log, None);
+
+    // Installed without the GitHub step, resumed in a fresh shell: verify
+    // demands the SSH key and sshd that were never installed.
+    let (without, installed_without) = install(&repo, &iso, &log, Some("0"));
+    let fresh_after_without = resume(&without, &log, None);
+
+    // Installed with the GitHub step, resumed from a shell that turns it
+    // off: verify silently skips the SSH-key, sshd and Git checks.
+    let off_after_one = resume(&with_one, &log, Some("0"));
+
+    let result: Value = serde_json::from_slice(&fs::read(repo.join("artifacts").join(&without).join("result.json")).unwrap()).unwrap();
+    let recorded: Vec<&String> = result
+        .as_object()
+        .unwrap()
+        .keys()
+        .filter(|k| ["encrypted", "github", "calamares", "options", "choices"].iter().any(|w| k.contains(w)))
+        .collect();
+
+    let cases = [
+        ("installed with GITHUB=1, resumed fresh", &installed_one, &fresh_after_one),
+        ("installed with GITHUB=0, resumed fresh", &installed_without, &fresh_after_without),
+        ("installed with GITHUB=1, resumed with GITHUB=0", &installed_one, &off_after_one),
+    ];
+    let report: Vec<String> = cases
+        .iter()
+        .map(|(case, installed, verified)| {
+            format!(
+                "{case}: install {installed:?} (GitHub step {}), verify {verified:?} (GitHub checks {})",
+                github(installed),
+                github(verified)
+            )
+        })
+        .collect();
+    assert!(
+        cases.iter().all(|(_, installed, verified)| github(installed) == github(verified)),
+        "the resumed verify does not check what was installed; result.json records only {recorded:?}:\n{}",
+        report.join("\n")
+    );
+}
diff --git a/tests/repro_ici_03.py b/tests/repro_ici_03.py
new file mode 100644
index 00000000..244221ec
--- /dev/null
+++ b/tests/repro_ici_03.py
@@ -0,0 +1,200 @@
+#!/usr/bin/env python3
+"""ICI-03: a trusted PR that waits for the builder while main moves must not
+be marked "Build and tests: failure" when nothing was built or tested.
+
+Drives the real gate, scripts/check-pr-trust.py, as its own __main__ (only
+urllib's urlopen is replaced, by a fake GitHub API backed by a temporary git
+repository, and time.sleep by a no-op), and the real `run:` blocks of
+.github/workflows/pr.yml, extracted from the file, with a stub `gh` that
+records commit statuses instead of posting them. Job ordering and results
+follow GitHub Actions: a failing step fails its job and skips the rest; the
+`result` job runs under always().
+
+usage: repro_ici_03.py   (from the repository root)
+"""
+import json
+import os
+from pathlib import Path
+import shutil
+import subprocess
+import sys
+import tempfile
+import unittest
+
+ROOT = Path(__file__).resolve().parent.parent
+PYTHON = Path(sys.executable).resolve()
+REPOSITORY = 'bitemyapp/sekka'
+
+# Runs the gate as __main__ against the fake API in $FAKE_GITHUB.
+GATE = r'''
+import io, json, os, runpy, sys, time, urllib.error, urllib.request
+state = json.load(open(os.environ['FAKE_GITHUB']))
+prefix = 'https://api.github.com/repos/bitemyapp/sekka/'
+def urlopen(request, timeout=None):
+    path = request.full_url[len(prefix):]
+    if path not in state:
+        raise urllib.error.HTTPError(request.full_url, 404, 'Not Found', {}, None)
+    return io.BytesIO(json.dumps(state[path]).encode())
+urllib.request.urlopen = urlopen
+time.sleep = lambda seconds: None
+runpy.run_path(sys.argv[1], run_name='__main__')
+'''
+
+GH = r'''
+import json, os, sys
+args = sys.argv[1:]
+fields = dict(a.split('=', 1) for a in args if '=' in a and not a.startswith('--'))
+with open(os.environ['STATUS_LOG'], 'a') as f:
+    f.write(json.dumps({'endpoint': args[3], **fields}) + '\n')
+'''
+
+
+def git(repo, *args, env=None):
+    return subprocess.run(['git', '-C', str(repo), *args], check=True, text=True,
+                          capture_output=True, env=env).stdout.strip()
+
+
+def run_block(step_name):
+    """The `run:` script of the step named `step_name` in pr.yml."""
+    lines = (ROOT / '.github/workflows/pr.yml').read_text().splitlines()
+    start = next(i for i, l in enumerate(lines) if l.strip() == f'- name: {step_name}')
+    for i in range(start + 1, len(lines)):
+        stripped = lines[i].strip()
+        if stripped.startswith('run:'):
+            value = stripped[len('run:'):].strip()
+            if value != '|':
+                return value + '\n'
+            indent = len(lines[i]) - len(lines[i].lstrip())
+            block = []
+            for line in lines[i + 1:]:
+                if line.strip() and len(line) - len(line.lstrip()) <= indent:
+                    break
+                block.append(line)
+            depth = min(len(l) - len(l.lstrip()) for l in block if l.strip())
+            return '\n'.join(l[depth:] for l in block) + '\n'
+        if stripped.startswith('- '):
+            break
+    raise KeyError(step_name)
+
+
+class TrustedPrWorkflow(unittest.TestCase):
+    def setUp(self):
+        tmp = tempfile.TemporaryDirectory(prefix='ici03-')
+        self.addCleanup(tmp.cleanup)
+        self.work = Path(tmp.name)
+        self.repo = self.work / 'repo'
+        self.repo.mkdir()
+        self.genv = dict(os.environ, GIT_AUTHOR_NAME='t', GIT_AUTHOR_EMAIL='t@example.invalid',
+                         GIT_COMMITTER_NAME='t', GIT_COMMITTER_EMAIL='t@example.invalid',
+                         HOME=str(self.work))
+        git(self.repo, 'init', '-q', '-b', 'main', env=self.genv)
+        (self.repo / 'flake.nix').write_text('{ }\n')
+        git(self.repo, 'add', '.', env=self.genv)
+        git(self.repo, 'commit', '-qm', 'main', env=self.genv)
+        self.base = git(self.repo, 'rev-parse', 'HEAD')
+        git(self.repo, 'checkout', '-qb', 'feature', env=self.genv)
+        (self.repo / 'feature.txt').write_text('change\n')
+        git(self.repo, 'add', '.', env=self.genv)
+        git(self.repo, 'commit', '-qm', 'feature', env=self.genv)
+        self.head = git(self.repo, 'rev-parse', 'HEAD')
+        git(self.repo, 'checkout', '-q', 'main', env=self.genv)
+        bin_ = self.work / 'bin'
+        bin_.mkdir()
+        (bin_ / 'gh').write_text(f'#!{PYTHON}\n' + GH)
+        (bin_ / 'gh').chmod(0o755)
+        (self.work / 'gate.py').write_text(GATE)
+        self.statuses = self.work / 'statuses'
+        self.env = {'PATH': f'{bin_}:' + os.environ['PATH'], 'HOME': str(self.work),
+                    'GITHUB_REPOSITORY': REPOSITORY, 'GITHUB_SERVER_URL': 'https://github.com',
+                    'GITHUB_RUN_ID': '1', 'GH_TOKEN': 'stub', 'STATUS_LOG': str(self.statuses),
+                    'FAKE_GITHUB': str(self.work / 'github.json')}
+        self.publish_merge()
+
+    def publish_merge(self):
+        """GitHub's state: main's tip and its test merge of the PR head."""
+        main = git(self.repo, 'rev-parse', 'main')
+        tree = git(self.repo, 'merge-tree', '--write-tree', main, self.head, env=self.genv)
+        merge = git(self.repo, 'commit-tree', tree, '-p', main, '-p', self.head, '-m', 'merge',
+                    env=self.genv)
+        commits = {}
+        for sha in git(self.repo, 'rev-list', '--all').split() + [merge]:
+            parents = git(self.repo, 'rev-list', '--parents', '-n1', sha).split()[1:]
+            commits[f'git/commits/{sha}'] = {'sha': sha, 'parents': [{'sha': p} for p in parents]}
+        state = {
+            'collaborators/dev/permission': {'permission': 'write'},
+            'pulls/7': {'state': 'open', 'draft': False, 'mergeable': True,
+                        'merge_commit_sha': merge, 'user': {'login': 'dev'},
+                        'base': {'ref': 'main', 'repo': {'full_name': REPOSITORY}},
+                        'head': {'sha': self.head, 'repo': {'full_name': REPOSITORY}}},
+            'git/ref/heads/main': {'object': {'sha': main}},
+            **commits,
+        }
+        (self.work / 'github.json').write_text(json.dumps(state))
+        return merge
+
+    def step(self, name, env):
+        script = self.work / 'step.sh'
+        script.write_text(run_block(name))
+        result = subprocess.run(['bash', '-e', str(script)], env={**self.env, **env},
+                                cwd=ROOT, text=True, capture_output=True)
+        return result.returncode == 0
+
+    def gate(self, expected_head):
+        output = self.work / f'output-{len(list(self.work.glob("output-*")))}'
+        output.write_text('')
+        command = run_block('Check current repository permissions and merge identity').split()
+        assert command == ['python3', 'scripts/check-pr-trust.py'], command
+        subprocess.run([str(PYTHON), str(self.work / 'gate.py'), str(ROOT / command[1])],
+                       env={**self.env, 'PR_NUMBER': '7', 'GITHUB_ACTOR': 'dev',
+                            'GITHUB_TRIGGERING_ACTOR': 'dev', 'EXPECTED_HEAD': expected_head,
+                            'GITHUB_OUTPUT': str(output),
+                            'GITHUB_STEP_SUMMARY': str(self.work / 'summary')},
+                       check=True, capture_output=True, text=True)
+        return dict(l.split('=', 1) for l in output.read_text().splitlines())
+
+    def workflow(self, main_moves_while_queued):
+        built = False
+        # trust job
+        trust = self.gate(self.head)
+        self.assertEqual(trust['allowed'], 'true', trust)
+        self.assertTrue(self.step('Mark the admitted head pending', {'HEAD_SHA': trust['head']}))
+        # queued behind the nightly on the single builder
+        if main_moves_while_queued:
+            (self.repo / 'flake.lock').write_text('{"nightly": 1}\n')
+            git(self.repo, 'add', '.', env=self.genv)
+            git(self.repo, 'commit', '-qm', 'Update Sekka inputs for the nightly build',
+                env=self.genv)
+            self.publish_merge()
+        # build job
+        recheck = self.gate(trust['head'])
+        ok = self.step('Require the same admitted merge',
+                       {'ALLOWED': recheck.get('allowed', ''), 'CURRENT_MERGE': recheck.get('merge', ''),
+                        'EXPECTED_MERGE': trust['merge']})
+        if ok:
+            built = True  # checkout of trust.merge, builds and checks would run here
+        build_result = 'success' if ok else 'failure'
+        # result job: always() && needs.trust.outputs.allowed == 'true'
+        self.assertTrue(self.step('Report against the tested PR head',
+                                  {'HEAD_SHA': trust['head'], 'BUILD_RESULT': build_result}))
+        statuses = [json.loads(l) for l in self.statuses.read_text().splitlines()]
+        return built, statuses
+
+    def test_control_main_unchanged(self):
+        built, statuses = self.workflow(main_moves_while_queued=False)
+        self.assertTrue(built)
+        self.assertEqual([s['state'] for s in statuses], ['pending', 'success'])
+
+    def test_main_moving_while_queued_is_not_a_test_failure(self):
+        built, statuses = self.workflow(main_moves_while_queued=True)
+        final = statuses[-1]
+        self.assertFalse(built)
+        self.assertNotEqual(
+            final['state'], 'failure',
+            f'nothing was built, yet the head {final["endpoint"].rsplit("/", 1)[1][:12]} got '
+            f'{[(s["state"], s.get("description")) for s in statuses]}')
+
+
+if __name__ == '__main__':
+    if not shutil.which('git'):
+        raise SystemExit('git is required')
+    unittest.main()
diff --git a/tests/repro_ici_11.cjs b/tests/repro_ici_11.cjs
new file mode 100644
index 00000000..ebe5c028
--- /dev/null
+++ b/tests/repro_ici_11.cjs
@@ -0,0 +1,220 @@
+// ICI-11: the home page player must never have two soundtracks playing, and
+// a pause during a seek drag must stay paused when the drag ends.
+//
+// Loads the real site/video.js in Node with a small fake DOM, a fake Web
+// Audio context that records each buffer source, and a fake video program
+// (the Wasm glue module) so load() resolves. Drives it with the events a
+// browser would deliver: Play, pointerdown on the seek bar, K presses on the
+// player, pointerup on the window.
+//
+// usage: node tests/repro_ici_11.cjs   (from the repository root)
+"use strict";
+const test = require("node:test");
+const assert = require("node:assert");
+const fs = require("node:fs");
+const os = require("node:os");
+const path = require("node:path");
+const { pathToFileURL } = require("node:url");
+
+const VIDEO = path.resolve(__dirname, "../site/video.js");
+const glueDir = fs.mkdtempSync(path.join(os.tmpdir(), "ici11-"));
+const glue = path.join(glueDir, "glue.mjs");
+fs.writeFileSync(
+  glue,
+  `export default async function init() {}
+export const fallbacks = [], images = [], durations = new Map(), audio = "soundtrack", defaultFont = "Mono";
+export function create_wasm_bridge() {
+  return {
+    populate_static_fonts_db_with_static_fonts() {},
+    get_static_font_data_by_index() { return null; },
+    add_image_source() {},
+    async prepare() { return { fps: 30, durationInFrames: 300 }; },
+    render_frame() { return "<svg></svg>"; },
+  };
+}
+`,
+);
+process.on("exit", () => fs.rmSync(glueDir, { recursive: true, force: true }));
+
+class Target {
+  constructor() {
+    this.listeners = {};
+  }
+  addEventListener(type, fn, options) {
+    (this.listeners[type] ??= []).push({ fn, once: !!options?.once });
+  }
+  removeEventListener(type, fn) {
+    this.listeners[type] = (this.listeners[type] ?? []).filter((l) => l.fn !== fn);
+  }
+  dispatch(type, event = {}) {
+    for (const l of [...(this.listeners[type] ?? [])]) {
+      if (l.once) this.removeEventListener(type, l.fn);
+      l.fn({ type, target: this, preventDefault() {}, ...event });
+    }
+  }
+}
+
+class Element extends Target {
+  constructor(name) {
+    super();
+    this.name = name;
+    this.dataset = {};
+    this.hidden = false;
+    this.attributes = {};
+    this.value = "";
+    this.textContent = "";
+    const classes = new Set();
+    this.classList = {
+      add: (c) => classes.add(c),
+      remove: (c) => classes.delete(c),
+      contains: (c) => classes.has(c),
+      toggle: (c, on) => (on ? classes.add(c) : classes.delete(c)),
+    };
+  }
+  setAttribute(k, v) {
+    this.attributes[k] = v;
+  }
+  querySelector(selector) {
+    return this.children?.[selector] ?? null;
+  }
+  closest() {
+    return null;
+  }
+  insertAdjacentHTML() {}
+}
+
+function page() {
+  const names = ["screen", "poster", "big", "big-label", "bar", "toggle", "time", "seek",
+    "mute", "volume", "full", "note"];
+  const player = new Element("player");
+  player.children = Object.fromEntries(names.map((n) => [`.player-${n}`, new Element(n)]));
+  Object.assign(player.dataset, {
+    moduleSrc: pathToFileURL(glue).href,
+    wasmSrc: "video.wasm",
+    images: "{}",
+    opusSrc: "a.webm",
+    aacSrc: "a.m4a",
+  });
+  const sources = [];
+  class AudioContext {
+    constructor() {
+      this.currentTime = 0;
+      this.destination = {};
+    }
+    resume() {
+      return Promise.resolve();
+    }
+    createGain() {
+      return { gain: { value: 1 }, connect() {} };
+    }
+    createBufferSource() {
+      const source = {
+        id: sources.length + 1,
+        playing: false,
+        connect() {},
+        disconnect() {},
+        start() {
+          this.playing = true;
+        },
+        stop() {
+          this.playing = false;
+        },
+      };
+      sources.push(source);
+      return source;
+    }
+  }
+  const win = new Target();
+  Object.assign(globalThis, {
+    document: {
+      querySelector: (s) => (s === ".player" ? player : null),
+      createElement: () => ({ canPlayType: () => "" }),
+      fonts: { add() {} },
+      readyState: "loading",
+      fullscreenEnabled: false,
+      addEventListener() {},
+    },
+    AudioContext,
+    OfflineAudioContext: class {
+      async decodeAudioData() {
+        return { duration: 10 };
+      }
+    },
+    fetch: async () => ({ ok: true, arrayBuffer: async () => new ArrayBuffer(8) }),
+    requestAnimationFrame: () => 0,
+    addEventListener: win.addEventListener.bind(win),
+    removeEventListener: win.removeEventListener.bind(win),
+  });
+  // Save Data on: nothing is loaded until Play, so the test decides when.
+  Object.defineProperty(globalThis, "navigator", {
+    value: { connection: { saveData: true } },
+    configurable: true,
+  });
+  delete require.cache[VIDEO];
+  require(VIDEO);
+  const el = (n) => player.children[`.player-${n}`];
+  return {
+    player,
+    win,
+    sources,
+    seek: el("seek"),
+    big: el("big"),
+    playing: () => sources.filter((s) => s.playing).map((s) => s.id),
+    key: (key) => player.dispatch("keydown", { key, target: el("seek") }),
+  };
+}
+
+const settle = () => new Promise((resolve) => setTimeout(resolve, 20));
+
+async function playing() {
+  const p = page();
+  p.big.dispatch("click");
+  await settle();
+  assert.equal(p.player.dataset.state, "playing");
+  assert.deepEqual(p.playing(), [1]);
+  return p;
+}
+
+test("control: a drag during playback plays on from where it ends", async () => {
+  const p = await playing();
+  p.seek.dispatch("pointerdown");
+  p.seek.value = "120";
+  p.seek.dispatch("input");
+  p.win.dispatch("pointerup");
+  assert.equal(p.player.dataset.state, "playing");
+  assert.deepEqual(p.playing(), [2]);
+});
+
+test("K twice during a seek drag leaves one soundtrack playing", async () => {
+  const p = await playing();
+  p.seek.dispatch("pointerdown"); // halt: S1 stops, resume = true
+  p.key("k"); // pause
+  p.key("k"); // play: begin() makes S2
+  await settle();
+  p.win.dispatch("pointerup"); // release(): begin() again, S3
+  const live = p.playing();
+  p.key("k"); // the user pauses
+  const afterPause = [p.player.dataset.state, p.playing()];
+  p.key("k"); // and plays on
+  p.sources[1].onended?.(); // S2, if orphaned, reaches its end first
+  const afterOrphanEnds = [p.player.dataset.state, p.playing()];
+  assert.deepEqual(
+    live,
+    [3],
+    `soundtracks playing after pointer-up: ${JSON.stringify(live)}; after K (pause): ` +
+      `${JSON.stringify(afterPause)}; after K (play) and S2's end: ${JSON.stringify(afterOrphanEnds)}`,
+  );
+});
+
+test("a pause during a seek drag stays paused when the drag ends", async () => {
+  const p = await playing();
+  p.seek.dispatch("pointerdown");
+  p.key("k"); // pause
+  assert.equal(p.player.dataset.state, "paused");
+  p.win.dispatch("pointerup");
+  assert.deepEqual(
+    [p.player.dataset.state, p.playing()],
+    ["paused", []],
+    "pointer-up after pausing restarted playback",
+  );
+});
diff --git a/tests/repro_inx_18.py b/tests/repro_inx_18.py
new file mode 100644
index 00000000..5d385073
--- /dev/null
+++ b/tests/repro_inx_18.py
@@ -0,0 +1,99 @@
+#!/usr/bin/env python3
+"""INX-18: copy-to-RAM decides from the size of the block device holding
+/sysroot/iso. When that device is a whole USB stick (a raw-written hybrid
+ISO found by label on the disk rather than its partition), the stick's
+capacity, not the image, is compared with the RAM.
+
+Runs the exact `text` of nix/iso-copytoram.nix under writeShellApplication's
+shell options, in bwrap with a fake /proc/meminfo, and with stubs for every
+tool that would inspect or change mounts (findmnt, blockdev, mount, umount,
+mountpoint, mktemp, cp): nothing is mounted or copied, and no device is read.
+The stubs log what the script asked for.
+
+Scenario: a 64 GB stick holding a 3.5 GB image, 32 GiB of RAM (30 GiB
+available). The image plus the 4 GiB reserve fits; the stick does not.
+
+usage: repro_inx_18.py   (from the repository root)
+"""
+import os
+from pathlib import Path
+import re
+import shutil
+import subprocess
+import sys
+import tempfile
+import unittest
+
+ROOT = Path(__file__).resolve().parent.parent
+GiB = 1024 ** 3
+ISO_BYTES = 3_500_000_000
+STICK_BYTES = 64_023_257_088
+AVAILABLE_KIB = 30 * GiB // 1024
+
+
+def script_text():
+    nix = (ROOT / 'nix/iso-copytoram.nix').read_text()
+    body = re.search(r"\n  text = ''\n(.*?)\n  '';\n", nix, re.S).group(1)
+    # The script interpolates nothing from Nix; undo indented-string escapes.
+    body = body.replace("''${", '${').replace("'''", "''")
+    lines = body.splitlines()
+    indent = min(len(l) - len(l.lstrip()) for l in lines if l.strip())
+    return '\n'.join(l[indent:] for l in lines) + '\n'
+
+
+STUB = r'''#!{bash}
+echo "$(basename "$0") $*" >> {log}
+case "$(basename "$0")" in
+  findmnt) echo "{device}" ;;
+  blockdev) case "$2" in /dev/sdz) echo {stick} ;; /dev/sdz1) echo {iso} ;; *) exit 1 ;; esac ;;
+  mktemp) mkdir -p {work}/stage && echo {work}/stage ;;
+  mountpoint) exit 1 ;;
+  *) : ;;
+esac
+'''
+
+
+class CopyToRamSize(unittest.TestCase):
+    def run_helper(self, device):
+        with tempfile.TemporaryDirectory(prefix='inx18-') as tmp:
+            work = Path(tmp)
+            stubs = work / 'stubs'
+            stubs.mkdir()
+            log = work / 'log'
+            for name in ['findmnt', 'blockdev', 'mount', 'umount', 'mountpoint', 'mktemp', 'cp']:
+                (stubs / name).write_text(STUB.format(
+                    bash=shutil.which('bash'), log=log, device=device, stick=STICK_BYTES,
+                    iso=ISO_BYTES, work=work))
+                (stubs / name).chmod(0o755)
+            meminfo = work / 'meminfo'
+            meminfo.write_text(f'MemTotal:       {32 * GiB // 1024} kB\n'
+                               f'MemFree:        {AVAILABLE_KIB} kB\n'
+                               f'MemAvailable:   {AVAILABLE_KIB} kB\n')
+            script = work / 'sekka-copy-iso-to-ram'
+            # writeShellApplication's preamble; its PATH has the stubs first.
+            script.write_text('set -o errexit\nset -o nounset\nset -o pipefail\n'
+                              f'export PATH="{stubs}:$PATH"\n' + script_text())
+            result = subprocess.run(
+                ['bwrap', '--unshare-all', '--die-with-parent', '--bind', '/', '/',
+                 '--dev', '/dev', '--proc', '/proc', '--ro-bind', str(meminfo), '/proc/meminfo',
+                 '--tmpfs', '/run', shutil.which('bash'), str(script)],
+                text=True, capture_output=True, timeout=30)
+            calls = log.read_text().splitlines() if log.exists() else []
+            return result, calls
+
+    def test_whole_stick_with_room_for_the_image_copies_to_ram(self):
+        result, calls = self.run_helper('/dev/sdz')
+        self.assertEqual(result.returncode, 0, result.stderr)
+        self.assertNotIn('insufficient RAM', result.stderr, calls)
+        self.assertIn('complete;', result.stderr, calls)
+
+    def test_control_partition_of_the_image_size_copies_to_ram(self):
+        result, calls = self.run_helper('/dev/sdz1')
+        self.assertEqual(result.returncode, 0, result.stderr)
+        self.assertIn('complete;', result.stderr, calls)
+
+
+if __name__ == '__main__':
+    if not shutil.which('bwrap'):
+        raise SystemExit('bubblewrap is required')
+    unittest.main()
diff --git a/tests/repro_inx_29.c b/tests/repro_inx_29.c
new file mode 100644
index 00000000..27a504a2
--- /dev/null
+++ b/tests/repro_inx_29.c
@@ -0,0 +1,252 @@
+/* INX-29: the patched IBus Wayland frontend keeps its first system keymap.
+ *
+ * A harness for the code path nix/patches/ibus-wayland-system-keymap.patch
+ * creates in client/wayland/ibuswaylandim.c. The struct, the keymap updater
+ * and the body of input_method_keyboard_keymap() after the virtual-keyboard
+ * forward are copied verbatim from the patch's "+" lines (only GLib's
+ * g_return_* guards and the verbose log are replaced by plain C);
+ * create_system_xkb_keymap() is IBus 1.5.34's, reconstructed (mmap the fd,
+ * compile it). The Wayland virtual keyboard is a recorder, so the harness can
+ * compare what the compositor/application side gets with what IBus keeps.
+ *
+ * Scenario: aizome-ibus runs with use-system-keyboard-layout on (system
+ * mode: active_key = &key_sys in post_key and modifiers). The compositor
+ * sends its US keymap, then the user switches Aizome to German and the
+ * compositor sends the German keymap. Afterwards IBus's own system state
+ * should map the key labelled Y on a US board (evdev KEY_Y) to 'z', as the
+ * German layout does, and as the virtual keyboard now does.
+ *
+ * Build and run:
+ *   cc -o "$TMPDIR/inx29" tests/repro_inx_29.c $(pkg-config --cflags --libs xkbcommon)
+ *   XKB_CONFIG_ROOT=…/share/X11/xkb "$TMPDIR/inx29"
+ * Modes: engine (default), seeded, control. Exit status 0 when IBus follows
+ * the new layout, 1 otherwise.
+ */
+#define _GNU_SOURCE
+#include <limits.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/mman.h>
+#include <unistd.h>
+#include <xkbcommon/xkbcommon.h>
+
+#define WL_KEYBOARD_KEYMAP_FORMAT_XKB_V1 1
+#define KEY_Y 21 /* linux/input-event-codes.h */
+typedef int gboolean;
+#define TRUE 1
+#define FALSE 0
+#define g_clear_pointer(pp, destroy) \
+    do { if (*(pp)) { destroy (*(pp)); *(pp) = NULL; } } while (0)
+
+/* ---- verbatim from the patch ---- */
+typedef struct _IBusXkbKeymap
+{
+    struct xkb_keymap *keymap;
+    struct xkb_state *state;
+
+    xkb_mod_mask_t shift_mask;
+    xkb_mod_mask_t lock_mask;
+    xkb_mod_mask_t control_mask;
+    xkb_mod_mask_t mod1_mask;
+    xkb_mod_mask_t mod2_mask;
+    xkb_mod_mask_t mod3_mask;
+    xkb_mod_mask_t mod4_mask;
+    xkb_mod_mask_t mod5_mask;
+    xkb_mod_mask_t super_mask;
+    xkb_mod_mask_t hyper_mask;
+    xkb_mod_mask_t meta_mask;
+} IBusXkbKeymap;
+/* ---- end verbatim ---- */
+
+/* The parts of IBusWaylandIMPrivate and IBusWaylandSeat this path uses. */
+struct seat { gboolean has_compositor_keymap; char *virtual_keyboard_keymap; };
+struct priv {
+    struct xkb_context *xkb_context;
+    IBusXkbKeymap key_user;
+    IBusXkbKeymap key_sys;
+    struct seat *seat;
+    gboolean use_sys_keymap;
+};
+
+static gboolean
+ibus_xkb_keymap_update_with_keymap (IBusXkbKeymap     *ibus_keymap,
+                                    struct xkb_keymap *keymap)
+{
+    struct xkb_state *state;
+
+    if (!ibus_keymap || !keymap || !(state = xkb_state_new (keymap)))
+        return FALSE;
+    /* ---- verbatim from the patch ---- */
+    if (ibus_keymap->state)
+        xkb_state_unref (ibus_keymap->state);
+    if (ibus_keymap->keymap)
+        xkb_keymap_unref (ibus_keymap->keymap);
+    ibus_keymap->keymap = keymap;
+    ibus_keymap->state = state;
+
+#define _WL_MOD_MASK(keymap, name) \
+    ({ xkb_mod_index_t idx = xkb_map_mod_get_index (keymap, name); \
+       (idx < sizeof (xkb_mod_mask_t) * CHAR_BIT) \
+               ? ((xkb_mod_mask_t) 1 << idx) : 0; })
+    ibus_keymap->shift_mask   = _WL_MOD_MASK (keymap, "Shift");
+    ibus_keymap->lock_mask    = _WL_MOD_MASK (keymap, "Lock");
+    ibus_keymap->control_mask = _WL_MOD_MASK (keymap, "Control");
+    ibus_keymap->mod1_mask    = _WL_MOD_MASK (keymap, "Mod1");
+    ibus_keymap->mod2_mask    = _WL_MOD_MASK (keymap, "Mod2");
+    ibus_keymap->mod3_mask    = _WL_MOD_MASK (keymap, "Mod3");
+    ibus_keymap->mod4_mask    = _WL_MOD_MASK (keymap, "Mod4");
+    ibus_keymap->mod5_mask    = _WL_MOD_MASK (keymap, "Mod5");
+    ibus_keymap->super_mask   = _WL_MOD_MASK (keymap, "Super");
+    ibus_keymap->hyper_mask   = _WL_MOD_MASK (keymap, "Hyper");
+    ibus_keymap->meta_mask    = _WL_MOD_MASK (keymap, "Meta");
+#undef _WL_MOD_MASK
+
+    return TRUE;
+    /* ---- end verbatim ---- */
+}
+
+/* IBus 1.5.34's create_system_xkb_keymap(), reconstructed. */
+static struct xkb_keymap *
+create_system_xkb_keymap (struct xkb_context *xkb_context,
+                          uint32_t format, int32_t fd, uint32_t size)
+{
+    struct xkb_keymap *keymap;
+    char *text;
+    if (format != WL_KEYBOARD_KEYMAP_FORMAT_XKB_V1) {
+        close (fd);
+        return NULL;
+    }
+    text = mmap (NULL, size, PROT_READ, MAP_PRIVATE, fd, 0);
+    if (text == MAP_FAILED) {
+        close (fd);
+        return NULL;
+    }
+    keymap = xkb_keymap_new_from_string (xkb_context, text,
+                                         XKB_KEYMAP_FORMAT_TEXT_V1,
+                                         XKB_KEYMAP_COMPILE_NO_FLAGS);
+    munmap (text, size);
+    close (fd);
+    return keymap;
+}
+
+/* zwp_virtual_keyboard_v1_keymap(): the compositor gets the same keymap. */
+static void
+virtual_keyboard_keymap (struct seat *seat, int32_t fd, uint32_t size)
+{
+    free (seat->virtual_keyboard_keymap);
+    seat->virtual_keyboard_keymap = calloc (1, size + 1);
+    if (pread (fd, seat->virtual_keyboard_keymap, size, 0) < 0)
+        abort ();
+}
+
+static void
+input_method_keyboard_keymap (struct priv *priv, uint32_t format,
+                              int32_t fd, uint32_t size)
+{
+    struct xkb_keymap *keymap;
+
+    if (priv->seat) {
+        virtual_keyboard_keymap (priv->seat, fd, size);
+        priv->seat->has_compositor_keymap = TRUE;
+    }
+    /* ---- verbatim from the patch ---- */
+    if (priv->key_user.keymap && priv->key_user.state && priv->key_sys.state) {
+        close (fd);
+        return;
+    }
+    keymap = create_system_xkb_keymap (priv->xkb_context, format, fd, size);
+    if (keymap &&
+        !ibus_xkb_keymap_update_with_keymap (&priv->key_sys,
+                                             xkb_keymap_ref (keymap))) {
+        xkb_keymap_unref (keymap);
+        g_clear_pointer (&keymap, xkb_keymap_unref);
+    }
+    if (keymap && !priv->key_user.state &&
+        !ibus_xkb_keymap_update_with_keymap (&priv->key_user,
+                                             xkb_keymap_ref (keymap))) {
+        xkb_keymap_unref (keymap);
+        g_clear_pointer (&keymap, xkb_keymap_unref);
+    }
+    if (keymap)
+        xkb_keymap_unref (keymap);
+    /* ---- end verbatim ---- */
+}
+
+/* What the compositor sends: its keymap as text in a sealed memfd. */
+static void
+send_compositor_keymap (struct priv *priv, const char *layout)
+{
+    struct xkb_rule_names names = { .rules = "evdev", .model = "pc105", .layout = layout };
+    struct xkb_keymap *keymap = xkb_keymap_new_from_names (priv->xkb_context, &names, 0);
+    char *text;
+    int fd;
+    if (!keymap) {
+        fprintf (stderr, "cannot compile layout %s (XKB_CONFIG_ROOT?)\n", layout);
+        exit (2);
+    }
+    text = xkb_keymap_get_as_string (keymap, XKB_KEYMAP_FORMAT_TEXT_V1);
+    fd = memfd_create ("keymap", MFD_CLOEXEC);
+    if (fd < 0 || write (fd, text, strlen (text) + 1) < 0)
+        abort ();
+    input_method_keyboard_keymap (priv, WL_KEYBOARD_KEYMAP_FORMAT_XKB_V1, fd,
+                                  strlen (text) + 1);
+    free (text);
+    xkb_keymap_unref (keymap);
+}
+
+static const char *
+sym_name (struct xkb_state *state, char *buf, size_t len)
+{
+    xkb_keysym_get_name (xkb_state_key_get_one_sym (state, KEY_Y + 8), buf, len);
+    return buf;
+}
+
+int
+main (int argc, char **argv)
+{
+    struct seat seat = { 0 };
+    struct priv priv = { .seat = &seat, .use_sys_keymap = TRUE };
+    struct xkb_rule_names us = { .rules = "evdev", .model = "pc105", .layout = "us" };
+    const char *mode = argc > 1 ? argv[1] : "engine";
+    char ibus_sym[64], engine_sym[64], vk_sym[64];
+    struct xkb_keymap *vk;
+    struct xkb_state *vk_state;
+    IBusXkbKeymap *active_key;
+    xkb_keysym_t sym = 0;
+
+    priv.xkb_context = xkb_context_new (XKB_CONTEXT_NO_FLAGS);
+    /* `engine`: the constructor puts the global engine's own keymap
+     * (xkb:us::eng) in key_user. `seeded`: an engine without a layout of its
+     * own, so key_user is seeded from the first system keymap. */
+    if (strcmp (mode, "seeded") != 0)
+        ibus_xkb_keymap_update_with_keymap (&priv.key_user,
+                xkb_keymap_new_from_names (priv.xkb_context, &us, 0));
+
+    /* `control`: German from the start, the case DEVELOPERS.md says passes. */
+    if (strcmp (mode, "control") != 0)
+        send_compositor_keymap (&priv, "us");
+    send_compositor_keymap (&priv, "de"); /* live layout change in Aizome */
+
+    vk = xkb_keymap_new_from_string (priv.xkb_context, seat.virtual_keyboard_keymap,
+                                     XKB_KEYMAP_FORMAT_TEXT_V1, 0);
+    vk_state = xkb_state_new (vk);
+    /* ibus_wayland_im_post_key()/input_method_keyboard_modifiers(): */
+    active_key = priv.use_sys_keymap ? &priv.key_sys : &priv.key_user;
+    sym_name (active_key->state, ibus_sym, sizeof ibus_sym);
+    sym_name (vk_state, vk_sym, sizeof vk_sym);
+    /* input_method_keyboard_key(), verbatim: the keysym an engine receives. */
+    if (priv.key_sys.state)
+        sym = xkb_state_key_get_one_sym (priv.key_sys.state, KEY_Y + 8);
+    if (sym != XKB_KEY_Multi_key && priv.key_user.state)
+        sym = xkb_state_key_get_one_sym (priv.key_user.state, KEY_Y + 8);
+    xkb_keysym_get_name (sym, engine_sym, sizeof engine_sym);
+    printf ("%s: virtual keyboard KEY_Y -> %s; IBus key_sys (system mode) KEY_Y -> %s; "
+            "keysym to the engine -> %s\n", mode, vk_sym, ibus_sym, engine_sym);
+    if (strcmp (ibus_sym, vk_sym) != 0) {
+        printf ("FAIL: IBus kept the previous system keymap\n");
+        return 1;
+    }
+    printf ("ok\n");
+    return 0;
+}
