+++ b/desktop/aizome/crates/aizome-kit/tests/repro_uiw_18.rs
@@ -0,0 +1,108 @@
+//! UIW-18: an editor's caret keeps blinking after it takes the focus while
+//! a tick from scrolling is on its way; an editor's position bar goes
+//! once scrolling stops, after several scroll events too.
+//!
+//! The editor reads the wall clock (`Instant::now()`), so the test moves
+//! the harness clock and the wall clock together, in small steps.
+
+use std::time::Duration;
+
+use aizome_kit::prelude::*;
+use aizome_kit::testing::Harness;
+
+struct Doc {
+    content: EditorContent,
+}
+
+#[derive(Clone, Debug)]
+enum Msg {
+    Edit(EditorAction),
+}
+
+impl Program for Doc {
+    type Msg = Msg;
+    fn info(&self) -> AppInfo {
+        AppInfo::new("org.aizome.ReproUiw18", "Repro", "Repro")
+    }
+    fn launched(&mut self, cx: &mut Cx<Msg>) {
+        cx.open_window(WindowSpec::new("Doc").size(400.0, 300.0));
+    }
+    fn update(&mut self, msg: Msg, _cx: &mut Cx<Msg>) {
+        match msg {
+            Msg::Edit(a) => {
+                self.content.perform(a);
+            }
+        }
+    }
+    fn view(&self, _w: WindowKey) -> Element<Msg> {
+        text_editor(&self.content).on_action(Msg::Edit).wrap(false).id("ed").into()
+    }
+}
+
+fn doc() -> Doc {
+    let text = (0..300).map(|i| format!("line {i}")).collect::<Vec<_>>().join("\n");
+    Doc { content: EditorContent::new(&text) }
+}
+
+/// Let `ms` pass on both clocks, firing the timers that come due.
+fn wait(h: &mut Harness<Doc>, ms: u64) {
+    for _ in 0..ms / 10 {
+        std::thread::sleep(Duration::from_millis(10));
+        h.advance(Duration::from_millis(10));
+    }
+}
+
+fn setup() -> (Harness<Doc>, WindowKey, Point) {
+    let mut h = Harness::new(doc());
+    let w = h.window();
+    h.focus_window(w, true);
+    h.check_frame(w);
+    let r = h.find_id(w, "ed").unwrap();
+    (h, w, Point::new(r.x0 + 120.0, r.y0 + 60.0))
+}
+
+/// Whether the caret blinks over 1.6 s, starting 400 ms on (past the
+/// scroll's tick and the position bar going): damage, and a tick asked
+/// for, while it has the focus.
+fn blinks(h: &mut Harness<Doc>, w: WindowKey) -> (usize, usize) {
+    wait(h, 400);
+    h.take_damage(w);
+    wait(h, 1600);
+    (h.take_damage(w).len(), h.platform.pending_timers())
+}
+
+#[test]
+fn repro_uiw_18_control_click_into_a_still_editor_blinks() {
+    let (mut h, w, at) = setup();
+    h.click(w, at);
+    let (damage, timers) = blinks(&mut h, w);
+    println!("still editor: caret damage {damage}, timers pending {timers}");
+    assert!(damage > 0 && timers > 0);
+}
+
+#[test]
+fn repro_uiw_18_focus_while_a_scroll_tick_is_pending_keeps_the_caret_blinking() {
+    let (mut h, w, at) = setup();
+    h.scroll(w, at, Vec2::new(0.0, 40.0));
+    // 600 ms on (the scroll's tick is due at 920 ms), click into it.
+    wait(&mut h, 600);
+    h.click(w, at);
+    let (damage, timers) = blinks(&mut h, w);
+    println!("after scroll then focus: caret damage {damage}, timers pending {timers}");
+    assert!(damage > 0, "the focused editor's caret must keep blinking (no damage in 1.6 s)");
+    assert!(timers > 0, "a focused editor keeps a blink tick on its way");
+}
+
+#[test]
+fn repro_uiw_18_unfocused_editor_position_bar_goes_after_two_scroll_events() {
+    let (mut h, w, at) = setup();
+    h.scroll(w, at, Vec2::new(0.0, 40.0));
+    h.check_frame(w);
+    wait(&mut h, 100);
+    h.scroll(w, at, Vec2::new(0.0, 40.0));
+    h.check_frame(w);
+    wait(&mut h, 2000);
+    let c = h.check_frame(w);
+    println!("editor bar after two scroll events: {c:?}");
+    assert_eq!(c.differs, 0.0, "the position bar stays drawn after it should have gone: {c:?}");
+}
diff --git a/desktop/aizome/crates/aizome-media/tests/repro_svc_23.rs b/desktop/aizome/crates/aizome-media/tests/repro_svc_23.rs
new file mode 100644
index 00000000..70ac294b
--- /dev/null
+++ b/desktop/aizome/crates/aizome-media/tests/repro_svc_23.rs
@@ -0,0 +1,169 @@
+//! SVC-23: the playback session's two suspected bugs.
+//!
+//! 1. Stepping forward, then Play, must go on from the frame on screen. At
+//!    8e0acbe5 forward steps only show frames (`player.rs:1196-1200`,
+//!    `video.rs:489-494`) and never move the clock, and `play` "catches up"
+//!    by seeking to `clock.now()` (`player.rs:1077-1082`): back to where
+//!    stepping started.
+//! 2. A speed change on media that can't seek (a pipe, a stream) with audio
+//!    must make the clock run at the new speed. At 8e0acbe5 `Speed` drops
+//!    the tempo filter (`player.rs:777-779`) and asks for a seek that
+//!    `seek` skips for unseekable media (`player.rs:1123-1125`), so the
+//!    ring's segment keeps speed 1 while the samples are tempo-changed: the
+//!    clock runs at the old rate.
+//!
+//! The engine runs as in `tests/engine.rs` (null audio output, detached
+//! video sink, software decoding). Part 2 plays a small WAV it generates
+//! into the test's temporary directory, read through a FIFO so FFmpeg
+//! can't seek it.
+
+use std::io::Write;
+use std::path::{Path, PathBuf};
+use std::sync::mpsc;
+use std::time::{Duration, Instant};
+
+use aizome_media::{AudioChoice, Event, Options, PlayState, Player};
+use sidestep_ui::video::{VideoCaps, VideoSink};
+
+fn fixture(name: &str) -> String {
+    PathBuf::from(env!("CARGO_MANIFEST_DIR")).join("tests/fixtures").join(name).to_string_lossy().into_owned()
+}
+
+fn player() -> (Player, mpsc::Receiver<Event>, std::sync::Arc<sidestep_ui::video::Detached>) {
+    let (sink, detached) = VideoSink::detached();
+    let (tx, rx) = mpsc::channel();
+    let caps = VideoCaps { known: true, shm: vec![0, 1], presentation: true, monotonic: true, ..VideoCaps::default() };
+    let player = Player::new(
+        Options { sink: Some(sink), audio: AudioChoice::Null, hardware: false, caps: Some(caps) },
+        move |e| {
+            let _ = tx.send(e);
+        },
+    );
+    (player, rx, detached)
+}
+
+fn until(rx: &mpsc::Receiver<Event>, secs: f64, mut f: impl FnMut(&Event) -> bool) -> Vec<Event> {
+    let end = Instant::now() + Duration::from_secs_f64(secs);
+    let mut seen = Vec::new();
+    loop {
+        match rx.recv_timeout(end.saturating_duration_since(Instant::now())) {
+            Ok(e) => {
+                let hit = f(&e);
+                seen.push(e);
+                if hit {
+                    return seen;
+                }
+            }
+            Err(_) => panic!("timed out; saw {seen:#?}"),
+        }
+    }
+}
+
+#[test]
+fn play_after_stepping_forward_goes_on_from_the_frame_shown() {
+    let (p, rx, detached) = player();
+    // clip.mp4: 25 frames a second.
+    p.open(fixture("clip.mp4"), 0.0, false);
+    until(&rx, 5.0, |e| matches!(e, Event::Seeked(_)));
+    until(&rx, 2.0, |e| matches!(e, Event::State(PlayState::Paused)));
+    let first = detached.shown();
+    for _ in 0..10 {
+        p.step(true);
+    }
+    let deadline = Instant::now() + Duration::from_secs(3);
+    while detached.shown() < first + 10 {
+        assert!(Instant::now() < deadline, "the steps didn't all show: {} of 10", detached.shown() - first);
+        std::thread::sleep(Duration::from_millis(10));
+    }
+    // Ten frames on from the first: the picture is the one at 0.40 s.
+    let showing = 10.0 / 25.0;
+    let position_while_stepped = p.position();
+    p.play();
+    let seen = until(&rx, 3.0, |e| matches!(e, Event::Seeked(_)));
+    let Some(Event::Seeked(to)) = seen.last() else { unreachable!() };
+    eprintln!("showing the frame at {showing:.2} s, position said {position_while_stepped:.3}; Play seeked to {to:.3}");
+    assert!(
+        (to - showing).abs() < 0.05,
+        "Play after ten steps forward went back to {to:.3} s, not on from the frame shown at {showing:.2} s"
+    );
+}
+
+/// `secs` of a 440 Hz tone as 16-bit mono WAV at 24 kHz.
+fn wav(secs: u32) -> Vec<u8> {
+    let rate = 24_000u32;
+    let n = rate * secs;
+    let mut out = Vec::with_capacity(44 + n as usize * 2);
+    out.extend_from_slice(b"RIFF");
+    out.extend_from_slice(&(36 + n * 2).to_le_bytes());
+    out.extend_from_slice(b"WAVEfmt ");
+    out.extend_from_slice(&16u32.to_le_bytes());
+    out.extend_from_slice(&1u16.to_le_bytes()); // PCM
+    out.extend_from_slice(&1u16.to_le_bytes()); // mono
+    out.extend_from_slice(&rate.to_le_bytes());
+    out.extend_from_slice(&(rate * 2).to_le_bytes());
+    out.extend_from_slice(&2u16.to_le_bytes());
+    out.extend_from_slice(&16u16.to_le_bytes());
+    out.extend_from_slice(b"data");
+    out.extend_from_slice(&(n * 2).to_le_bytes());
+    for i in 0..n {
+        let s = (f64::from(i) * 440.0 * std::f64::consts::TAU / f64::from(rate)).sin() * 8000.0;
+        out.extend_from_slice(&(s as i16).to_le_bytes());
+    }
+    out
+}
+
+/// A FIFO at `path` that a thread fills with `data` once it's opened.
+fn fifo(path: &Path, data: Vec<u8>) -> std::thread::JoinHandle<()> {
+    let made = std::process::Command::new("mkfifo").arg(path).status().expect("mkfifo");
+    assert!(made.success());
+    let path = path.to_owned();
+    std::thread::spawn(move || {
+        let mut f = std::fs::OpenOptions::new().write(true).open(&path).expect("open the FIFO");
+        let _ = f.write_all(&data);
+    })
+}
+
+#[test]
+fn a_speed_change_on_unseekable_audio_moves_the_clock_at_the_new_speed() {
+    let dir = std::env::temp_dir().join(format!("repro-svc-23-{}", std::process::id()));
+    let _ = std::fs::remove_dir_all(&dir);
+    std::fs::create_dir_all(&dir).unwrap();
+    let pipe = dir.join("tone.wav");
+    let writer = fifo(&pipe, wav(14));
+    let (p, rx, _detached) = player();
+    let opened_at = Instant::now();
+    p.open(pipe.to_string_lossy().into_owned(), 0.0, true);
+    let seen = until(&rx, 5.0, |e| matches!(e, Event::State(PlayState::Playing)));
+    let info = seen.iter().find_map(|e| if let Event::Opened(i) = e { Some(i.clone()) } else { None }).expect("opened");
+    assert!(!info.seekable, "read through a FIFO, it can't seek");
+    std::thread::sleep(Duration::from_millis(500));
+    let rate = |p: &Player| {
+        let (a, t) = (p.position(), Instant::now());
+        std::thread::sleep(Duration::from_millis(1000));
+        (p.position() - a) / t.elapsed().as_secs_f64()
+    };
+    let before = rate(&p);
+    p.set_speed(2.0);
+    // What was decoded before the change (up to the ring's two seconds)
+    // plays out at the old speed first.
+    std::thread::sleep(Duration::from_millis(2600));
+    let after = rate(&p);
+    // Where the sound is: it ends once the fourteen seconds have played,
+    // which at 2× from about 3.5 s in is about 8.75 s after opening.
+    let ended = until(&rx, 20.0, |e| matches!(e, Event::State(PlayState::Ended)));
+    let (took, at_end) = (opened_at.elapsed().as_secs_f64(), p.position());
+    drop(ended);
+    eprintln!(
+        "clock rate at 1×: {before:.2}; after set_speed(2.0): {after:.2}; the 14 s tone ended {took:.2} s after opening, the clock then saying {at_end:.2} s; duration {:?}",
+        info.duration
+    );
+    drop(p);
+    let _ = writer.join();
+    let _ = std::fs::remove_dir_all(&dir);
+    assert!((before - 1.0).abs() < 0.2, "at 1× the clock ran at {before:.2}");
+    assert!(
+        (after - 2.0).abs() < 0.3,
+        "at 2× on unseekable media the clock runs at {after:.2} media seconds a second; when the 14 s tone \
+         had played ({took:.2} s after opening) the clock said {at_end:.2} s"
+    );
+}
diff --git a/desktop/aizome/crates/aizome-media/tests/repro_svc_29.rs b/desktop/aizome/crates/aizome-media/tests/repro_svc_29.rs
