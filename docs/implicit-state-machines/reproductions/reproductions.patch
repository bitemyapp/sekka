@@ -0,0 +1,83 @@
+//! KOY-05: sheet slots. A second launch's `--new` (the desktop action
+//! New Event) while the editor is open replaces `editor` without closing
+//! its sheet; the old sheet's key then views as the whole main window,
+//! stacked as a sheet. Likewise a second .ics opened while the import
+//! sheet is up.
+
+mod common;
+
+use std::path::PathBuf;
+
+use aizome_kit::theme::ThemeChoice;
+use common::*;
+use koyomi::app::{Msg, View};
+
+/// How many copies of the main window's toolbar are showing (its
+/// "Today" button is in no sheet).
+fn mains(h: &aizome_kit::testing::Harness<koyomi::app::Koyomi>) -> usize {
+    let w = h.window();
+    h.texts(w).iter().filter(|t| *t == "Today").count()
+}
+
+#[test]
+fn repro_koy_05_new_event_from_a_second_launch_leaves_no_orphan_sheet() {
+    let mut h = harness("repro-koy05-a", ThemeChoice::Night);
+    let w = h.window();
+    let alone = mains(&h);
+    // Control: one editor, cancelled, leaves ❖2 working.
+    h.send(Msg::NewEvent);
+    h.send(Msg::EditCancel);
+    h.command(w, '2');
+    assert_eq!(h.program().view, View::Week, "control: ❖2 works after one editor is cancelled");
+    h.command(w, '3');
+    assert_eq!(h.program().view, View::Month);
+    h.send(Msg::NewEvent);
+    assert!(h.program().editor.is_some());
+    let with_editor = mains(&h);
+    // `aizome-koyomi --new` from the desktop action, handed over.
+    h.send(Msg::Instance(vec!["--new".into()]));
+    let after_second = mains(&h);
+    // Cancel the editor.
+    h.send(Msg::EditCancel);
+    let after_cancel = mains(&h);
+    let editor_gone = h.program().editor.is_none();
+    // Is the window still under a sheet? ❖2 is a menu shortcut.
+    h.command(w, '2');
+    let view = h.program().view;
+    assert!(
+        after_second == with_editor && after_cancel == alone && view == View::Week,
+        "copies of the main window showing: {alone} alone, {with_editor} with the editor, {after_second} after \
+         the second --new, {after_cancel} after Cancel (editor gone: {editor_gone}); ❖2 then gives {view:?}"
+    );
+}
+
+#[test]
+fn repro_koy_05_a_second_ics_while_importing_leaves_no_orphan_sheet() {
+    let mut h = harness("repro-koy05-b", ThemeChoice::Night);
+    let w = h.window();
+    let google = PathBuf::from(env!("CARGO_MANIFEST_DIR")).join("tests/fixtures/google.ics");
+    let apple = PathBuf::from(env!("CARGO_MANIFEST_DIR")).join("tests/fixtures/apple.ics");
+    let alone = mains(&h);
+    // Control: one import sheet, cancelled, leaves ❖2 working.
+    h.send(Msg::Instance(vec![google.to_string_lossy().into_owned()]));
+    h.send(Msg::ImportCancel);
+    h.command(w, '2');
+    assert_eq!(h.program().view, View::Week, "control: ❖2 works after one import sheet is cancelled");
+    h.command(w, '3');
+    assert_eq!(h.program().view, View::Month);
+    h.send(Msg::Instance(vec![google.to_string_lossy().into_owned()]));
+    assert!(h.program().import.is_some());
+    let with_import = mains(&h);
+    // Another file opened from Files while the sheet is up.
+    h.send(Msg::Instance(vec![apple.to_string_lossy().into_owned()]));
+    let after_second = mains(&h);
+    h.send(Msg::ImportCancel);
+    let after_cancel = mains(&h);
+    h.command(w, '2');
+    let view = h.program().view;
+    assert!(
+        after_second == with_import && after_cancel == alone && view == View::Week,
+        "copies of the main window showing: {alone} alone, {with_import} with the import sheet, {after_second} \
+         after the second file, {after_cancel} after Cancel; ❖2 then gives {view:?}"
+    );
+}
diff --git a/desktop/aizome/apps/koyomi/tests/repro_koy_10.rs b/desktop/aizome/apps/koyomi/tests/repro_koy_10.rs
new file mode 100644
index 00000000..8c171b09
--- /dev/null
+++ b/desktop/aizome/apps/koyomi/tests/repro_koy_10.rs
@@ -0,0 +1,106 @@
+//! KOY-10: a background calendar write that fails (a read-only folder
+//! here) has already taken the calendar out of `dirty`, and `Saved`
+//! records the unchanged file's stamp. Nothing writes the edit again: the
+//! window's close flushes only `dirty`, and the next external change's
+//! reload throws the edit away.
+
+mod common;
+
+use std::os::unix::fs::PermissionsExt;
+use std::path::{Path, PathBuf};
+use std::time::Duration;
+
+use aizome_kit::testing::Harness;
+use aizome_kit::theme::ThemeChoice;
+use common::*;
+use koyomi::app::{Koyomi, Msg};
+use koyomi::model::{Calendar, Dye};
+
+fn on_disk(dir: &Path, id: &str) -> Calendar {
+    Calendar::parse(id, &std::fs::read_to_string(dir.join(format!("{id}.ics"))).unwrap()).0
+}
+
+fn dir_of(name: &str) -> PathBuf {
+    PathBuf::from(env!("CARGO_TARGET_TMPDIR")).join(format!("koyomi-{name}"))
+}
+
+/// The folder read-only while it's held.
+struct ReadOnly(PathBuf);
+
+impl ReadOnly {
+    fn new(dir: &Path) -> ReadOnly {
+        std::fs::set_permissions(dir, std::fs::Permissions::from_mode(0o555)).unwrap();
+        ReadOnly(dir.to_owned())
+    }
+}
+
+impl Drop for ReadOnly {
+    fn drop(&mut self) {
+        let _ = std::fs::set_permissions(&self.0, std::fs::Permissions::from_mode(0o755));
+    }
+}
+
+/// Work recoloured, its background write failing; the folder writable
+/// again afterwards.
+fn failed_save(name: &str) -> Harness<Koyomi> {
+    let mut h = harness_with(name, ThemeChoice::Night, |o| o.background_saves = true);
+    let dir = dir_of(name);
+    assert_eq!(on_disk(&dir, "work").color, Dye::Hanada);
+    h.send(Msg::SetColor("work".into(), Dye::Green));
+    {
+        let _ro = ReadOnly::new(&dir);
+        // The 300 ms debounce, then the write on the pool.
+        h.advance(Duration::from_millis(300));
+        let told = h.settle(Duration::from_secs(5), |k| {
+            k.note.as_ref().is_some_and(|(n, _)| n.contains("couldn't be saved"))
+        });
+        assert!(told, "the failed write is reported: {:?}", h.program().note);
+    }
+    assert_eq!(on_disk(&dir, "work").color, Dye::Hanada, "the file is as it was");
+    h
+}
+
+#[test]
+fn repro_koy_10_an_edit_whose_write_failed_is_written_at_quit() {
+    let name = "repro-koy10-a";
+    let mut h = failed_save(name);
+    let dir = dir_of(name);
+    // The folder is writable again; the person quits.
+    let w = h.window();
+    h.request_close(w);
+    let d = dir.clone();
+    h.settle(Duration::from_secs(3), move |_| on_disk(&d, "work").color == Dye::Green);
+    let mem = h.program().store.calendars.iter().find(|c| c.id == "work").map(|c| c.color);
+    assert_eq!(
+        on_disk(&dir, "work").color,
+        Dye::Green,
+        "an edit whose write failed should reach the file by quit (in memory: {mem:?})"
+    );
+}
+
+#[test]
+fn repro_koy_10_an_edit_whose_write_failed_survives_a_reload() {
+    let name = "repro-koy10-b";
+    let mut h = failed_save(name);
+    let dir = dir_of(name);
+    // Another program changes Home; the 3 s Poll reads the folder again.
+    let home = std::fs::read_to_string(dir.join("home.ics")).unwrap();
+    std::fs::write(
+        dir.join("home.ics"),
+        home.replace(
+            "END:VCALENDAR",
+            "BEGIN:VEVENT\r\nUID:other@test\r\nDTSTART:20261020T120000Z\r\nDTEND:20261020T130000Z\r\nSUMMARY:Added elsewhere\r\nEND:VEVENT\r\nEND:VCALENDAR",
+        ),
+    )
+    .unwrap();
+    h.advance(Duration::from_secs(3));
+    let k = h.program();
+    let reloaded = k.store.calendars.iter().any(|c| c.events.iter().any(|e| e.uid == "other@test"));
+    let mem = k.store.calendars.iter().find(|c| c.id == "work").map(|c| c.color);
+    assert_eq!(
+        mem,
+        Some(Dye::Green),
+        "the unsaved recolour should survive the reload (the reload happened: {reloaded}; on disk: {:?})",
+        on_disk(&dir, "work").color
+    );
+}
diff --git a/desktop/aizome/apps/koyomi/tests/repro_koy_12.rs b/desktop/aizome/apps/koyomi/tests/repro_koy_12.rs
new file mode 100644
index 00000000..2b2d07f6
--- /dev/null
+++ b/desktop/aizome/apps/koyomi/tests/repro_koy_12.rs
@@ -0,0 +1,115 @@
+//! KOY-12: a weekly series with one moved instance; another instance is
+//! opened, its Repeat changed, and saved for All Events. The master's rule
+//! changes but the override stays, and an override is shown on its own,
+//! so the moved instance of a series that no longer repeats (or no
+//! longer has that instance) still shows.
+
+use std::path::PathBuf;
+
+use aizome_kit::testing::Harness;
+use aizome_kit::theme::{Appearance, ThemeChoice};
+use jiff::civil::{date, datetime};
+use koyomi::app::{Koyomi, Msg, Options};
+use koyomi::model::Calendar;
+use koyomi::ui::editor::Field;
+use koyomi::ui::week::GridAction;
+
+const SERIES: &str = "BEGIN:VCALENDAR\r
+X-WR-CALNAME:Work\r
+BEGIN:VEVENT\r
+UID:weekly@test\r
+DTSTAMP:20261001T000000Z\r
+DTSTART;TZID=Europe/London:20261005T100000\r
+DTEND;TZID=Europe/London:20261005T110000\r
+RRULE:FREQ=WEEKLY\r
+SUMMARY:Weekly sync\r
+END:VEVENT\r
+BEGIN:VEVENT\r
+UID:weekly@test\r
+DTSTAMP:20261001T000000Z\r
+RECURRENCE-ID;TZID=Europe/London:20261012T100000\r
+DTSTART;TZID=Europe/London:20261012T150000\r
+DTEND;TZID=Europe/London:20261012T160000\r
+SUMMARY:Weekly sync\r
+END:VEVENT\r
+END:VCALENDAR\r
+";
+
+fn harness(name: &str) -> (Harness<Koyomi>, PathBuf) {
+    let dir = PathBuf::from(env!("CARGO_TARGET_TMPDIR")).join(format!("koyomi-{name}"));
+    let _ = std::fs::remove_dir_all(&dir);
+    std::fs::create_dir_all(&dir).unwrap();
+    std::fs::write(dir.join("work.ics"), SERIES).unwrap();
+    let opts = Options::test(&dir, datetime(2026, 10, 17, 14, 20, 0, 0), "Europe/London");
+    let mut h = Harness::with(Koyomi::new(opts), Appearance { theme: ThemeChoice::Night, ..Default::default() }, false);
+    let w = h.window();
+    h.resize(w, aizome_kit::Size::new(1120.0, 740.0));
+    (h, dir)
+}
+
+/// Where the series shows in October's month view.
+fn starts(h: &Harness<Koyomi>) -> Vec<String> {
+    let k = h.program();
+    k.occ
+        .iter()
+        .filter(|o| k.store.calendars[o.cal].events[o.event].uid == "weekly@test")
+        .map(|o| o.start.strftime("%Y-%m-%dT%H:%M").to_string())
+        .collect()
+}
+
+/// Open the 19 October instance, set Repeat to `freq` (the editor's
+/// index), Save, All Events.
+fn change_repeat(h: &mut Harness<Koyomi>, freq: usize) {
+    let w = h.window();
+    let k = h.program();
+    let key = k
+        .occ
+        .iter()
+        .find(|o| k.store.calendars[o.cal].events[o.event].uid == "weekly@test" && o.start.date() == date(2026, 10, 19))
+        .map(|o| o.key(&k.store.calendars))
+        .expect("the 19th's instance");
+    h.send(Msg::Grid(GridAction::Select(Some(key))));
+    h.send(Msg::Edit);
+    assert!(h.program().editor.as_ref().is_some_and(|e| e.series), "the editor, for a series");
+    h.send(Msg::EditField(Field::Freq(freq)));
+    h.send(Msg::EditSave);
+    assert!(h.click_text(w, "All Events"), "the scope alert");
+    assert!(h.program().editor.is_none());
+}
+
+fn overrides_on_disk(dir: &std::path::Path) -> Vec<String> {
+    let cal = Calendar::parse("work", &std::fs::read_to_string(dir.join("work.ics")).unwrap()).0;
+    cal.events
+        .iter()
+        .filter(|e| e.recurrence_id.is_some())
+        .map(|e| format!("RECURRENCE-ID {} at {}", e.recurrence_id.as_ref().unwrap().civil(), e.start.civil()))
+        .collect()
+}
+
+#[test]
+fn repro_koy_12_repeat_never_for_all_events_leaves_no_instance_behind() {
+    let (mut h, dir) = harness("repro-koy12-a");
+    let before = starts(&h);
+    assert!(before.contains(&"2026-10-12T15:00".to_owned()), "the moved instance: {before:?}");
+    change_repeat(&mut h, 0); // Never
+    assert_eq!(
+        starts(&h),
+        ["2026-10-05T10:00"],
+        "a series made not to repeat should show once (before: {before:?}; overrides left in the file: {:?})",
+        overrides_on_disk(&dir)
+    );
+}
+
+#[test]
+fn repro_koy_12_a_new_frequency_leaves_no_orphan_instance() {
+    let (mut h, dir) = harness("repro-koy12-b");
+    let before = starts(&h);
+    change_repeat(&mut h, 3); // Monthly: the 5th of each month
+    // October's month view runs 28 September to 1 November.
+    assert_eq!(
+        starts(&h),
+        ["2026-10-05T10:00"],
+        "monthly from the 5th has no instance on 12 October (before: {before:?}; overrides left in the file: {:?})",
+        overrides_on_disk(&dir)
+    );
+}
diff --git a/desktop/aizome/apps/koyomi/tests/repro_koy_14.rs b/desktop/aizome/apps/koyomi/tests/repro_koy_14.rs
new file mode 100644
index 00000000..4605a745
--- /dev/null
+++ b/desktop/aizome/apps/koyomi/tests/repro_koy_14.rs
@@ -0,0 +1,118 @@
+//! KOY-14: the store's view of the folder. An unreadable .ics is counted
+//! by `files()` but never loaded, so `changed_on_disk` stays true: the
+//! app reloads every Poll (3 s) and loses undo each time. And a calendar
+//! whose `create` couldn't write stays in `calendars`, sorted in, while
+//! NameDone skips `reindex`: `occ` points at shifted calendars and the
+//! day view's agenda indexes past an event list's end.
+
+mod common;
+
+use std::os::unix::fs::PermissionsExt;
+use std::panic::{AssertUnwindSafe, catch_unwind};
+use std::path::{Path, PathBuf};
+use std::time::Duration;
+
+use aizome_kit::testing::Harness;
+use aizome_kit::theme::{Appearance, ThemeChoice};
+use common::*;
+use jiff::civil::datetime;
+use koyomi::app::{Koyomi, Msg, Options, View};
+use koyomi::model::Dye;
+use koyomi::store::Store;
+
+fn dir_of(name: &str) -> PathBuf {
+    PathBuf::from(env!("CARGO_TARGET_TMPDIR")).join(format!("koyomi-{name}"))
+}
+
+/// `path`'s mode while held.
+struct Mode(PathBuf, u32);
+
+impl Mode {
+    fn set(path: &Path, mode: u32, back: u32) -> Mode {
+        std::fs::set_permissions(path, std::fs::Permissions::from_mode(mode)).unwrap();
+        Mode(path.to_owned(), back)
+    }
+}
+
+impl Drop for Mode {
+    fn drop(&mut self) {
+        let _ = std::fs::set_permissions(&self.0, std::fs::Permissions::from_mode(self.1));
+    }
+}
+
+/// An .ics in the folder that can't be read (another user's, a bad copy).
+fn unreadable(dir: &Path) -> Mode {
+    let p = dir.join("broken.ics");
+    std::fs::write(&p, "BEGIN:VCALENDAR\r\nEND:VCALENDAR\r\n").unwrap();
+    Mode::set(&p, 0o000, 0o644)
+}
+
+#[test]
+fn repro_koy_14_an_unreadable_file_is_not_a_change_on_every_look() {
+    let dir = folder("repro-koy14-a");
+    let _m = unreadable(&dir);
+    assert!(std::fs::read(dir.join("broken.ics")).is_err(), "the file really is unreadable (not root)");
+    let store = Store::open(&dir);
+    assert_eq!(store.calendars.len(), 2);
+    assert!(
+        !store.changed_on_disk(),
+        "nothing changed since the store read the folder, but changed_on_disk says so (problems: {:?})",
+        store.problems
+    );
+}
+
+#[test]
+fn repro_koy_14_an_unreadable_file_does_not_wipe_undo() {
+    // The unreadable file is there from the start.
+    let dir = folder("repro-koy14-b");
+    let _m = unreadable(&dir);
+    let opts = Options::test(&dir, datetime(2026, 10, 17, 14, 20, 0, 0), "Europe/London");
+    let mut h = Harness::with(Koyomi::new(opts), Appearance { theme: ThemeChoice::Night, ..Default::default() }, false);
+    let w = h.window();
+    h.send(Msg::SetColor("work".into(), Dye::Green));
+    // Two Polls (3 s each), nothing changing on disk.
+    h.advance(Duration::from_secs(7));
+    h.command(w, 'z');
+    let color = h.program().store.calendars.iter().find(|c| c.id == "work").map(|c| c.color);
+    assert_eq!(color, Some(Dye::Hanada), "❖Z after 7 s should undo the recolour (note: {:?})", h.program().note);
+}
+
+/// Control for the test above (passes at 8e0acbe5): the same steps with
+/// no unreadable file keep undo.
+#[test]
+fn repro_koy_14_control_undo_survives_polls_without_an_unreadable_file() {
+    let dir = folder("repro-koy14-ctl");
+    let opts = Options::test(&dir, datetime(2026, 10, 17, 14, 20, 0, 0), "Europe/London");
+    let mut h = Harness::with(Koyomi::new(opts), Appearance { theme: ThemeChoice::Night, ..Default::default() }, false);
+    let w = h.window();
+    h.send(Msg::SetColor("work".into(), Dye::Green));
+    h.advance(Duration::from_secs(7));
+    h.command(w, 'z');
+    let color = h.program().store.calendars.iter().find(|c| c.id == "work").map(|c| c.color);
+    assert_eq!(color, Some(Dye::Hanada));
+}
+
+#[test]
+fn repro_koy_14_a_calendar_that_could_not_be_made_leaves_the_day_view_whole() {
+    let name = "repro-koy14-c";
+    let mut h = harness(name, ThemeChoice::Night);
+    // The day view of Saturday 17th: Home's market, yoga and dinner in its agenda.
+    h.send(Msg::SetView(View::Day));
+    assert_eq!(h.program().view, View::Day);
+    let calendars_before: Vec<String> = h.program().store.calendars.iter().map(|c| c.id.clone()).collect();
+    let _ro = Mode::set(&dir_of(name), 0o555, 0o755);
+    // File ▸ New Calendar…, "Aaa" (sorts first), Make Calendar.
+    h.send(Msg::NewCalendar);
+    h.send(Msg::NameText("Aaa".into()));
+    let r = catch_unwind(AssertUnwindSafe(|| h.send(Msg::NameDone)));
+    let panic = r.err().map(|e| {
+        e.downcast_ref::<String>().cloned().or_else(|| e.downcast_ref::<&str>().map(|s| s.to_string())).unwrap_or_default()
+    });
+    let calendars_after: Vec<String> = h.program().store.calendars.iter().map(|c| c.id.clone()).collect();
+    assert!(
+        panic.is_none(),
+        "the failed New Calendar should leave the day view drawable: it panicked ({panic:?}); calendars \
+         {calendars_before:?} became {calendars_after:?} (note: {:?})",
+        h.program().note
+    );
+}
diff --git a/desktop/aizome/apps/koyomi/tests/repro_koy_17.rs b/desktop/aizome/apps/koyomi/tests/repro_koy_17.rs
new file mode 100644
index 00000000..cfa3efdb
--- /dev/null
+++ b/desktop/aizome/apps/koyomi/tests/repro_koy_17.rs
@@ -0,0 +1,65 @@
+//! KOY-17: a time-grid drag holds the picked-up block by its index in
+//! the grid's current blocks. Pressing → mid-drag shows the next week,
+//! and the drop moves whichever block has that index there.
+
+use std::path::PathBuf;
+
+use aizome_kit::sidestep_ui::{Modifiers, NamedKey, PointerButton};
+use aizome_kit::testing::Harness;
+use aizome_kit::theme::{Appearance, ThemeChoice};
+use aizome_kit::Vec2;
+use jiff::civil::{DateTime, date, datetime};
+use koyomi::app::{Koyomi, Msg, Options, View};
+
+const CAL: &str = "BEGIN:VCALENDAR\r
+X-WR-CALNAME:Work\r
+BEGIN:VEVENT\r
+UID:alpha@test\r
+DTSTART;TZID=Europe/London:20261014T100000\r
+DTEND;TZID=Europe/London:20261014T110000\r
+SUMMARY:Alpha\r
+END:VEVENT\r
+BEGIN:VEVENT\r
+UID:bravo@test\r
+DTSTART;TZID=Europe/London:20261021T150000\r
+DTEND;TZID=Europe/London:20261021T160000\r
+SUMMARY:Bravo\r
+END:VEVENT\r
+END:VCALENDAR\r
+";
+
+fn start_of(h: &Harness<Koyomi>, uid: &str) -> DateTime {
+    h.program().store.calendars.iter().flat_map(|c| &c.events).find(|e| e.uid == uid).unwrap().start.civil()
+}
+
+#[test]
+fn repro_koy_17_a_drag_carried_into_the_next_week_moves_the_event_picked_up() {
+    let dir = PathBuf::from(env!("CARGO_TARGET_TMPDIR")).join("koyomi-repro-koy17");
+    let _ = std::fs::remove_dir_all(&dir);
+    std::fs::create_dir_all(&dir).unwrap();
+    std::fs::write(dir.join("work.ics"), CAL).unwrap();
+    let opts = Options::test(&dir, datetime(2026, 10, 17, 14, 20, 0, 0), "Europe/London");
+    let mut h = Harness::with(Koyomi::new(opts), Appearance { theme: ThemeChoice::Night, ..Default::default() }, false);
+    let w = h.window();
+    h.resize(w, aizome_kit::Size::new(1120.0, 740.0));
+    h.send(Msg::SetView(View::Week));
+    // Pick up Alpha (Wednesday 14th, 10:00) and drag it an hour down.
+    let alpha = h.find(w, "Alpha").expect("Alpha's block");
+    let from = alpha.center();
+    h.press(w, from, PointerButton::Left, 1);
+    for i in 1..=4 {
+        h.move_to(w, from + Vec2::new(0.0, 12.0 * i as f64));
+    }
+    // → while still holding it: the next week.
+    h.named(w, NamedKey::ArrowRight, Modifiers::NONE);
+    assert_eq!(h.program().range(), (date(2026, 10, 19), date(2026, 10, 25)));
+    h.move_to(w, from + Vec2::new(0.0, 49.0));
+    h.release(w, from + Vec2::new(0.0, 49.0), PointerButton::Left);
+    let (a, b) = (start_of(&h, "alpha@test"), start_of(&h, "bravo@test"));
+    assert_eq!(
+        b,
+        datetime(2026, 10, 21, 15, 0, 0, 0),
+        "dropping Alpha moved Bravo, which it never touched (Alpha now at {a}, Bravo at {b}; note {:?})",
+        h.program().note
+    );
+}
diff --git a/desktop/aizome/apps/koyomi/tests/repro_koy_18.rs b/desktop/aizome/apps/koyomi/tests/repro_koy_18.rs
new file mode 100644
index 00000000..52201bd2
--- /dev/null
+++ b/desktop/aizome/apps/koyomi/tests/repro_koy_18.rs
@@ -0,0 +1,111 @@
+//! KOY-18: an all-day strip drag holds the bar by its index in the
+//! strip's current bars. Pressing → mid-drag shows the next week: with
+//! fewer bars there the next move indexes past the end and panics; with
+//! enough, the drop moves another event.
+
+use std::panic::{AssertUnwindSafe, catch_unwind};
+use std::path::PathBuf;
+
+use aizome_kit::sidestep_ui::{Modifiers, NamedKey, PointerButton};
+use aizome_kit::testing::Harness;
+use aizome_kit::theme::{Appearance, ThemeChoice};
+use aizome_kit::{Point, Vec2};
+use jiff::civil::{Date, date, datetime};
+use koyomi::app::{Koyomi, Msg, Options, View};
+
+// Week of 12 October: Alpha on Tuesday, Bravo on Thursday. Week of
+// 19 October: Charlie on Wednesday.
+const CAL: &str = "BEGIN:VCALENDAR\r
+X-WR-CALNAME:Work\r
+BEGIN:VEVENT\r
+UID:alpha@test\r
+DTSTART;VALUE=DATE:20261013\r
+DTEND;VALUE=DATE:20261014\r
+SUMMARY:Alpha\r
+END:VEVENT\r
+BEGIN:VEVENT\r
+UID:bravo@test\r
+DTSTART;VALUE=DATE:20261015\r
+DTEND;VALUE=DATE:20261016\r
+SUMMARY:Bravo\r
+END:VEVENT\r
+BEGIN:VEVENT\r
+UID:charlie@test\r
+DTSTART;VALUE=DATE:20261021\r
+DTEND;VALUE=DATE:20261022\r
+SUMMARY:Charlie\r
+END:VEVENT\r
+END:VCALENDAR\r
+";
+
+fn harness(name: &str) -> Harness<Koyomi> {
+    let dir = PathBuf::from(env!("CARGO_TARGET_TMPDIR")).join(format!("koyomi-{name}"));
+    let _ = std::fs::remove_dir_all(&dir);
+    std::fs::create_dir_all(&dir).unwrap();
+    std::fs::write(dir.join("work.ics"), CAL).unwrap();
+    let opts = Options::test(&dir, datetime(2026, 10, 17, 14, 20, 0, 0), "Europe/London");
+    let mut h = Harness::with(Koyomi::new(opts), Appearance { theme: ThemeChoice::Night, ..Default::default() }, false);
+    let w = h.window();
+    h.resize(w, aizome_kit::Size::new(1120.0, 740.0));
+    h.send(Msg::SetView(View::Week));
+    assert_eq!(h.program().range(), (date(2026, 10, 12), date(2026, 10, 18)));
+    h
+}
+
+fn day_of(h: &Harness<Koyomi>, uid: &str) -> Date {
+    h.program().store.calendars.iter().flat_map(|c| &c.events).find(|e| e.uid == uid).unwrap().start.civil().date()
+}
+
+/// The strip's point in column `col` (Monday 0), lane 0.
+fn bar_at(h: &Harness<Koyomi>, col: f64) -> (Point, f64) {
+    let w = h.window();
+    let strip = h.find_id(w, "all-day").expect("the all-day strip");
+    let cw = (strip.width() - 56.0) / 7.0;
+    (Point::new(strip.x0 + 56.0 + cw * (col + 0.5), strip.y0 + 12.0), cw)
+}
+
+/// Press at `from`, move a column right, press →, move a little, release.
+fn drag_across_weeks(h: &mut Harness<Koyomi>, from: Point, cw: f64) -> Result<(), String> {
+    let w = h.window();
+    catch_unwind(AssertUnwindSafe(|| {
+        h.press(w, from, PointerButton::Left, 1);
+        h.move_to(w, from + Vec2::new(cw / 2.0, 0.0));
+        h.move_to(w, from + Vec2::new(cw, 0.0));
+        h.named(w, NamedKey::ArrowRight, Modifiers::NONE);
+        h.move_to(w, from + Vec2::new(cw + 2.0, 0.0));
+        h.release(w, from + Vec2::new(cw + 2.0, 0.0), PointerButton::Left);
+    }))
+    .map_err(|e| {
+        e.downcast_ref::<String>().cloned().or_else(|| e.downcast_ref::<&str>().map(|s| s.to_string())).unwrap_or_default()
+    })
+}
+
+#[test]
+fn repro_koy_18_a_strip_drag_into_a_week_with_fewer_bars_does_not_panic() {
+    let mut h = harness("repro-koy18-a");
+    // Bravo, Thursday: the second bar.
+    let (thu, cw) = bar_at(&h, 3.0);
+    let r = drag_across_weeks(&mut h, thu, cw);
+    let range = h.program().range();
+    assert!(
+        r.is_ok(),
+        "dragging Bravo (bar 1) into a week with one bar should not panic: {:?} (range {range:?})",
+        r.err()
+    );
+}
+
+#[test]
+fn repro_koy_18_a_strip_drag_into_the_next_week_moves_the_bar_picked_up() {
+    let mut h = harness("repro-koy18-b");
+    // Alpha, Tuesday: the first bar.
+    let (tue, cw) = bar_at(&h, 1.0);
+    let r = drag_across_weeks(&mut h, tue, cw);
+    assert!(r.is_ok(), "no panic: {:?}", r.err());
+    let (a, c) = (day_of(&h, "alpha@test"), day_of(&h, "charlie@test"));
+    assert_eq!(
+        c,
+        date(2026, 10, 21),
+        "dropping Alpha moved Charlie, which it never touched (Alpha on {a}, Charlie on {c}; range {:?})",
+        h.program().range()
+    );
+}
diff --git a/desktop/aizome/apps/kura/tests/repro_kko_30.rs b/desktop/aizome/apps/kura/tests/repro_kko_30.rs
new file mode 100644
index 00000000..c324a608
--- /dev/null
+++ b/desktop/aizome/apps/kura/tests/repro_kko_30.rs
@@ -0,0 +1,68 @@
+//! KKO-30: while a scan runs, another is started (⌘D and Scan another
+//! disk, ⌘N/⌘O, or `aizome-kura PATH` again). The first scan's answer
+//! (cancelled, or done) must not end the second: the window keeps showing
+//! the second scan until its own result comes, and that result is what
+//! shows.
+//!
+//! The real window and scanner over two small temporary trees.
+
+use std::path::{Path, PathBuf};
+use std::time::Duration;
+
+use aizome_kit::testing::Harness;
+use kura::ui::{Kura, Msg, Page};
+
+fn scratch(name: &str) -> PathBuf {
+    let d = std::env::temp_dir().join(format!("kura-repro-{}-{name}", std::process::id()));
+    let _ = std::fs::remove_dir_all(&d);
+    std::fs::create_dir_all(&d).unwrap();
+    std::fs::canonicalize(&d).unwrap()
+}
+
+/// `dirs` folders of `files` empty files each.
+fn tree(root: &Path, dirs: usize, files: usize) {
+    for d in 0..dirs {
+        let dir = root.join(format!("d{d:03}"));
+        std::fs::create_dir_all(&dir).unwrap();
+        for f in 0..files {
+            std::fs::write(dir.join(format!("f{f:04}")), b"").unwrap();
+        }
+    }
+}
+
+#[test]
+fn a_scan_started_over_another_is_the_one_that_finishes() {
+    let base = scratch("kko30");
+    let first = base.join("first");
+    let second = base.join("second");
+    tree(&first, 10, 40);
+    tree(&second, 60, 100);
+    let mut k = Kura::sandboxed(&base.join("out"));
+    k.analyse = false;
+    k.has_store = false;
+    k.index_dir = None;
+    let mut h = Harness::new(k);
+
+    // A scan of `first`, and before its answer is taken in, one of `second`.
+    h.send_all([Msg::Scan(first.clone()), Msg::Scan(second.clone())]);
+    // Until the window stops showing the second scan under way.
+    let ended = h.settle(Duration::from_secs(30), |k| {
+        k.scanning.as_ref().map(|s| s.root.clone()) != Some(second.clone())
+    });
+    let k = h.program();
+    let shown = (k.page, k.notice.clone(), k.tree().map(|t| t.root_path().to_path_buf()));
+    let can_stop = k.scanning.is_some();
+    // And then, the second scan's own result.
+    let later = h.settle(Duration::from_secs(30), |k| k.tree().is_some_and(|t| t.root_path() == second));
+    let k = h.program();
+    let then = (k.page, k.notice.clone());
+    drop(h);
+    let _ = std::fs::remove_dir_all(&base);
+    assert!(ended, "the second scan never ended");
+    assert_eq!(
+        shown,
+        (Page::Results, None, Some(second.clone())),
+        "the first scan's answer ended the second scan's page while it ran (Stop possible: {can_stop}); \
+         its result came later: {later}, then showing {then:?}"
+    );
+}
diff --git a/desktop/aizome/apps/kura/tests/repro_kko_31.rs b/desktop/aizome/apps/kura/tests/repro_kko_31.rs
new file mode 100644
index 00000000..fcaf396f
--- /dev/null
+++ b/desktop/aizome/apps/kura/tests/repro_kko_31.rs
@@ -0,0 +1,115 @@
+//! KKO-31: the analysis of a first scan (looking for duplicates, which
+//! reads files) is still running when a second, smaller scan finishes and
+//! its analysis is done first. When the first analysis finishes, it must
+//! not replace the second's: the Suggestions and index.json describe the
+//! newest scan.
+//!
+//! The real window and analysis over two small temporary trees. To hold the
+//! first analysis deterministically, one of its duplicate candidates is
+//! swapped for a FIFO after the scan: reading it blocks until the test
+//! opens the other end.
+
+use std::os::unix::fs::OpenOptionsExt;
+use std::path::{Path, PathBuf};
+use std::sync::Arc;
+use std::time::{Duration, Instant};
+
+use aizome_kit::testing::Harness;
+use kura::scan::{Progress, ScanOptions};
+use kura::ui::{IndexState, Kura, Msg};
+
+fn scratch(name: &str) -> PathBuf {
+    let d = std::env::temp_dir().join(format!("kura-repro-{}-{name}", std::process::id()));
+    let _ = std::fs::remove_dir_all(&d);
+    std::fs::create_dir_all(&d).unwrap();
+    std::fs::canonicalize(&d).unwrap()
+}
+
+fn mentions(k: &Kura, root: &Path) -> bool {
+    let root = root.display().to_string();
+    k.analysis.hints.iter().any(|h| {
+        h.paths.iter().any(|p| p.path.starts_with(&root))
+            || h.groups.iter().any(|g| g.paths.iter().any(|p| p.starts_with(&root)))
+    })
+}
+
+#[test]
+fn the_newest_scans_analysis_is_the_one_kept() {
+    let base = scratch("kko31");
+    let one = base.join("one");
+    let two = base.join("two");
+    std::fs::create_dir_all(&one).unwrap();
+    std::fs::create_dir_all(&two).unwrap();
+    // One: a set of duplicates, and a third file of their size.
+    std::fs::write(one.join("a.bin"), [1u8; 4096]).unwrap();
+    std::fs::write(one.join("a-copy.bin"), [1u8; 4096]).unwrap();
+    std::fs::write(one.join("slow.bin"), [2u8; 4096]).unwrap();
+    // Two: nothing alike.
+    std::fs::write(two.join("notes.txt"), b"plans").unwrap();
+    std::fs::write(two.join("list.txt"), b"a longer list").unwrap();
+
+    let out = base.join("out");
+    let mut k = Kura::sandboxed(&out);
+    k.has_store = false;
+    k.analyse = true;
+    k.duplicates = true;
+    let mut places = kura::hints::Context::from_env();
+    places.home = None;
+    places.cache_home = None;
+    places.data_home = None;
+    places.config_home = None;
+    places.downloads = None;
+    places.trash = None;
+    places.nix_profiles = Vec::new();
+    places.nix_store = None;
+    places.dupe_limits.min_bytes = 1;
+    k.places = Some(places);
+    let mut h = Harness::new(k);
+
+    // Scan one (as the scan worker does), then its slow file becomes a FIFO,
+    // and the scan's result is taken in: its analysis starts and holds.
+    let scan_one = kura::scan::scan(ScanOptions::new(&one), Progress::new()).unwrap();
+    let slow = one.join("slow.bin");
+    std::fs::remove_file(&slow).unwrap();
+    let c = std::ffi::CString::new(slow.as_os_str().as_encoded_bytes()).unwrap();
+    // SAFETY: a valid NUL-terminated path.
+    assert_eq!(unsafe { libc::mkfifo(c.as_ptr(), 0o600) }, 0);
+    h.send(Msg::Scanned(Ok(Arc::new(scan_one))));
+
+    // The person scans two; its analysis is done first.
+    h.send(Msg::Scan(two.clone()));
+    let two_done = h.settle(Duration::from_secs(30), |k| {
+        k.tree().is_some_and(|t| t.root_path() == two) && matches!(k.index, IndexState::Written { .. })
+    });
+    assert!(two_done, "the second scan and its analysis");
+    let two_index = kura::index::read(&out.join("index/index.json")).map(|i| i.root).unwrap_or_default();
+
+    // The first analysis's slow read ends (its file is opened at the other
+    // end and closed), and it finishes last.
+    let deadline = Instant::now() + Duration::from_secs(10);
+    let held = loop {
+        match std::fs::OpenOptions::new().write(true).custom_flags(libc::O_NONBLOCK).open(&slow) {
+            Ok(f) => break Some(f),
+            Err(_) if Instant::now() < deadline => std::thread::sleep(Duration::from_millis(10)),
+            Err(_) => break None,
+        }
+    };
+    assert!(held.is_some(), "the first analysis never read its slow file");
+    drop(held);
+    let stale = h.settle(Duration::from_secs(5), |k| mentions(k, &one));
+    std::thread::sleep(Duration::from_millis(100));
+    let index_root = kura::index::read(&out.join("index/index.json")).map(|i| i.root).unwrap_or_default();
+    let tree_root = h.program().tree().map(|t| t.root_path().to_path_buf());
+    let hints: Vec<String> = h.program().analysis.hints.iter().map(|x| x.id.clone()).collect();
+    drop(h);
+    let _ = std::fs::remove_dir_all(&base);
+
+    assert_eq!(tree_root, Some(two.clone()), "the second scan shows");
+    assert!(two_index.ends_with("/two"), "two's analysis wrote its index first: {two_index}");
+    assert!(
+        !stale && index_root.ends_with("/two"),
+        "the first scan's late analysis replaced the second's: the Suggestions show {hints:?} about {} \
+         (stale {stale}), and index.json's root is {index_root}",
+        one.display()
+    );
+}
diff --git a/desktop/aizome/apps/myaku/tests/repro_smt_02.rs b/desktop/aizome/apps/myaku/tests/repro_smt_02.rs
new file mode 100644
index 00000000..1ebf2d72
--- /dev/null
+++ b/desktop/aizome/apps/myaku/tests/repro_smt_02.rs
@@ -0,0 +1,79 @@
+//! SMT-02: a row's context menu carries the row index captured at
+//! right-click; a reading that re-sorts the table before Inspect is chosen
+//! must not make Inspect select (and inspect) whichever row now sits there.
+
+use std::sync::Arc;
+
+use aizome_kit::sidestep_ui::{Key, Modifiers, NamedKey, PointerButton};
+use aizome_kit::testing::Harness;
+use myaku::app::{Msg, Myaku, Request, RowRef, Sel};
+use myaku::fixture;
+
+fn start() -> Harness<Myaku> {
+    let (signals, _sent) = Myaku::recorder();
+    let mut h = Harness::new(Myaku::with_frame(Arc::new(fixture::frame(300, 1)), signals, Request::default()));
+    h.send(Msg::Frame(Arc::new(fixture::frame(300, 2))));
+    h
+}
+
+fn row_names(h: &Harness<Myaku>) -> Vec<String> {
+    let m = h.program();
+    m.rows
+        .iter()
+        .map(|r| match r {
+            RowRef::Group(g) => m.frame.groups[*g].name.clone(),
+            RowRef::Process(p, _) => m.frame.processes[*p].name.clone(),
+        })
+        .collect()
+}
+
+#[test]
+fn inspect_from_a_row_menu_inspects_that_row_after_a_reading_resorts_the_table() {
+    let mut h = start();
+    let w = h.window();
+    let _ = h.render(w, 1.0);
+
+    // A group a few rows down, not the focused one (Sumi) the window opened on.
+    let names = row_names(&h);
+    let i = 3;
+    let target = names[i].clone();
+    let key = h.program().frame.groups.iter().find(|g| g.name == target).unwrap().key;
+    assert_ne!(h.program().sel, Some(Sel::Group(key)));
+
+    // Right-click its row: it's selected, and its menu opens.
+    let cell = h.find(w, &target).unwrap_or_else(|| panic!("row {target}"));
+    h.press(w, cell.center(), PointerButton::Right, 1);
+    h.release(w, cell.center(), PointerButton::Right);
+    assert_eq!(h.program().sel, Some(Sel::Group(key)), "right-click selects the row");
+    let popups = h.popups(w);
+    assert_eq!(popups.len(), 1, "the row's menu");
+    let menu = popups[0].0;
+
+    // A second goes by: the next reading has the target busiest, so the
+    // table re-sorts and another group takes row `i`.
+    let mut next = (*h.program().frame).clone();
+    next.tick += 1;
+    let g = next.groups.iter().position(|g| g.key == key).unwrap();
+    next.groups[g].usage.cpu = 900.0;
+    h.send(Msg::Frame(Arc::new(next)));
+    let now = row_names(&h);
+    assert_eq!(now[0], target, "the target sorted to the top");
+    assert_ne!(now[i], target, "another row now sits at {i}");
+    assert_eq!(h.popups(w).len(), 1, "the menu is still open");
+
+    // Inspect (the menu's first item).
+    h.popup_keyboard(menu, Key::Named(NamedKey::ArrowDown), Modifiers::NONE);
+    h.popup_keyboard(menu, Key::Named(NamedKey::Enter), Modifiers::NONE);
+    let m = h.program();
+    assert!(m.inspector, "Inspect opened the inspector");
+    let inspected = match m.sel {
+        Some(Sel::Group(k)) => m.frame.groups.iter().find(|g| g.key == k).map(|g| g.name.clone()),
+        Some(Sel::Process(k)) => m.frame.processes.iter().find(|p| p.key() == k).map(|p| p.name.clone()),
+        None => None,
+    };
+    assert_eq!(
+        m.sel,
+        Some(Sel::Group(key)),
+        "Inspect on {target}'s row inspects {target}, not {inspected:?} (now at row {i})"
+    );
+}
diff --git a/desktop/aizome/apps/myaku/tests/repro_smt_03.rs b/desktop/aizome/apps/myaku/tests/repro_smt_03.rs
new file mode 100644
index 00000000..5d9b8e70
--- /dev/null
+++ b/desktop/aizome/apps/myaku/tests/repro_smt_03.rs
@@ -0,0 +1,104 @@
+//! SMT-03: the status notice (a refused quit, "Paused …", "Asked to quit …")
+//! must not hide the summary for the rest of the session; and a confirmed
+//! quit whose target ended meanwhile must not report success with no name.
+
+use std::sync::Arc;
+use std::time::Duration;
+
+use aizome_kit::sidestep_ui::{Modifiers, NamedKey};
+use aizome_kit::testing::Harness;
+use aizome_sys::sysinfo::Signal;
+use myaku::app::{Msg, Myaku, Request, Sel};
+use myaku::fixture;
+
+type Sent = std::rc::Rc<std::cell::RefCell<Vec<(u32, Signal)>>>;
+
+fn start() -> (Harness<Myaku>, Sent) {
+    let (signals, sent) = Myaku::recorder();
+    let mut h = Harness::new(Myaku::with_frame(Arc::new(fixture::frame(300, 1)), signals, Request::default()));
+    h.send(Msg::Frame(Arc::new(fixture::frame(300, 2))));
+    (h, sent)
+}
+
+fn group_key(h: &Harness<Myaku>, name: &str) -> (u32, u64) {
+    h.program().frame.groups.iter().find(|g| g.name == name).unwrap().key
+}
+
+fn summary(h: &Harness<Myaku>) -> String {
+    let s = &h.program().frame.system;
+    format!(
+        "{} · {} · up {}",
+        myaku::model::count(s.processes, "process", "processes"),
+        myaku::model::count(s.threads as usize, "thread", "threads"),
+        myaku::model::uptime(s.uptime)
+    )
+}
+
+#[test]
+fn a_refused_quit_does_not_hide_the_summary_for_the_rest_of_the_session() {
+    let (mut h, sent) = start();
+    let w = h.window();
+    // Pause something root's: refused, in red.
+    let root = h.program().frame.processes.iter().find(|p| p.uid == 0 && !p.kernel).unwrap().key();
+    h.send(Msg::Select(Sel::Process(root)));
+    h.send(Msg::Pause(true));
+    assert!(sent.borrow().is_empty());
+    let refused = h.program().notice.clone().expect("a notice");
+    assert!(refused.1 && refused.0.contains("another user"), "{refused:?}");
+    assert!(h.texts(w).iter().any(|t| *t == refused.0), "the refusal shows");
+
+    // The user moves on: selects their own application; readings keep
+    // coming for a minute.
+    h.send(Msg::Select(Sel::Group(group_key(&h, "Kura"))));
+    for tick in 3..63 {
+        h.send(Msg::Frame(Arc::new(fixture::frame(300, tick))));
+        h.advance(Duration::from_secs(1));
+    }
+    let texts = h.texts(w);
+    let notice = h.program().notice.clone();
+    assert!(
+        !texts.iter().any(|t| *t == refused.0),
+        "a minute and a new selection later the status still says {:?} (notice {notice:?})",
+        refused.0
+    );
+    let want = summary(&h);
+    assert!(texts.iter().any(|t| *t == want), "the summary {want:?} shows again; notice {notice:?}");
+}
+
+/// Control: without a notice the status shows the summary the first test
+/// expects (so that test can pass once the notice is cleared).
+#[test]
+fn control_the_summary_shows_without_a_notice() {
+    let (mut h, _) = start();
+    let w = h.window();
+    h.program_mut().notice = None;
+    h.send(Msg::Frame(Arc::new(fixture::frame(300, 3))));
+    let want = summary(&h);
+    assert!(h.texts(w).iter().any(|t| *t == want), "{want:?} in {:?}", h.texts(w));
+}
+
+#[test]
+fn confirming_a_quit_whose_target_ended_does_not_report_success() {
+    let (mut h, sent) = start();
+    let w = h.window();
+    let key = group_key(&h, "Signal");
+    h.send(Msg::Select(Sel::Group(key)));
+    h.send(Msg::AskQuit(false));
+    assert!(h.texts(w).iter().any(|t| t == "Quit “Signal”?"));
+    // Before the user answers, Signal's first process ends: the next
+    // reading names its group by another key (its next member's).
+    let mut next = (*h.program().frame).clone();
+    next.tick += 1;
+    let g = next.groups.iter().position(|g| g.key == key).unwrap();
+    let second = next.groups[g].members[1];
+    next.groups[g].key = next.processes[second].key();
+    h.send(Msg::Frame(Arc::new(next)));
+    // Return: Quit.
+    h.named(w, NamedKey::Enter, Modifiers::NONE);
+    let notice = h.program().notice.clone();
+    assert!(sent.borrow().is_empty(), "nothing could be signalled");
+    assert!(
+        notice.as_ref().is_some_and(|(n, error)| *error || n.contains("Signal")),
+        "nothing was signalled, yet the status reports {notice:?}"
+    );
+}
