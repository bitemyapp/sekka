@@ -0,0 +1,101 @@
+//! KIT-04: a shell `Activate` for an item the app has disabled since it
+//! last published its menus must not run the item.
+
+use std::io::{BufRead, BufReader, Write};
+use std::os::unix::net::UnixListener;
+use std::time::Duration;
+
+use aizome_kit::prelude::*;
+use aizome_kit::testing::Harness;
+use aizome_shell_proto as proto;
+
+#[derive(Default)]
+struct Doc {
+    dirty: bool,
+    log: Vec<&'static str>,
+}
+
+#[derive(Clone, Debug)]
+enum Msg {
+    Edit,
+    Revert,
+    Save,
+}
+
+impl Program for Doc {
+    type Msg = Msg;
+    fn info(&self) -> AppInfo {
+        AppInfo::new("org.aizome.ReproKit04", "Repro", "Repro")
+    }
+    fn launched(&mut self, cx: &mut Cx<Msg>) {
+        cx.open_window(WindowSpec::new("Doc").size(300.0, 200.0));
+    }
+    fn update(&mut self, msg: Msg, _cx: &mut Cx<Msg>) {
+        match msg {
+            Msg::Edit => self.dirty = true,
+            Msg::Revert => self.dirty = false,
+            Msg::Save => {
+                self.log.push("save");
+                self.dirty = false;
+            }
+        }
+    }
+    fn view(&self, _w: WindowKey) -> Element<Msg> {
+        text("doc").into()
+    }
+    fn menus(&self) -> MenuBar<Msg> {
+        MenuBar::standard(&self.info()).with_file_menu(
+            Menu::new("File").item(MenuItem::new("Save", Msg::Save).shortcut(Shortcut::cmd('S')).enabled(self.dirty)),
+        )
+    }
+}
+
+fn read(lines: &mut impl Iterator<Item = std::io::Result<String>>) -> proto::AppMessage {
+    proto::decode(&lines.next().expect("a line").expect("read")).expect("a message")
+}
+
+fn find<'a>(menus: &'a [proto::Menu], label: &str) -> &'a proto::Item {
+    fn walk<'a>(items: &'a [proto::Item], label: &str) -> Option<&'a proto::Item> {
+        items.iter().find_map(|i| if i.label == label { Some(i) } else { walk(&i.items, label) })
+    }
+    menus.iter().find_map(|m| walk(&m.items, label)).expect("the item")
+}
+
+#[test]
+fn repro_kit_04_shell_activate_of_a_disabled_item_is_refused() {
+    let base = std::env::var_os("XDG_RUNTIME_DIR").map(std::path::PathBuf::from).unwrap_or_else(std::env::temp_dir);
+    let dir = base.join(format!("k04-{}", std::process::id()));
+    let _ = std::fs::create_dir_all(&dir);
+    let path = dir.join("s.sock");
+    let _ = std::fs::remove_file(&path);
+    let listener = UnixListener::bind(&path).expect("a socket");
+    let mut h = Harness::with_shell(Doc::default(), &path);
+    let (stream, _) = listener.accept().expect("the app connected");
+    stream.set_read_timeout(Some(Duration::from_secs(5))).unwrap();
+    let mut writer = stream.try_clone().unwrap();
+    let mut lines = BufReader::new(stream).lines();
+    assert!(matches!(read(&mut lines), proto::AppMessage::Hello { .. }));
+    h.advance(Duration::from_millis(50));
+    let proto::AppMessage::Menus { .. } = read(&mut lines) else { panic!("menus") };
+
+    // The document is edited: Save is enabled, and the shell hears so.
+    h.send(Msg::Edit);
+    h.advance(Duration::from_millis(50));
+    let proto::AppMessage::Menus { menus } = read(&mut lines) else { panic!("menus") };
+    let save = find(&menus, "Save").clone();
+    assert!(save.enabled, "the shell's copy shows Save enabled");
+
+    // The app reverts: Save is disabled at once in the app; the shell's
+    // copy is republished only after the 40 ms debounce. Meanwhile the user
+    // clicks Save in the shell's open menu.
+    h.send(Msg::Revert);
+    writer.write_all(proto::encode(&proto::ShellMessage::Activate { id: save.id }).as_bytes()).unwrap();
+    assert_eq!(h.pump_shell(Duration::from_secs(5)), 1);
+    println!("log after Activate of the disabled Save: {:?}", h.program().log);
+    assert!(
+        h.program().log.is_empty(),
+        "a disabled item must not run when the shell activates it: log {:?}",
+        h.program().log
+    );
+    let _ = std::fs::remove_dir_all(&dir);
+}
diff --git a/desktop/aizome/crates/aizome-kit/tests/repro_kit_13.rs b/desktop/aizome/crates/aizome-kit/tests/repro_kit_13.rs
