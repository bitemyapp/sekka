+}
+
+fn usb(uri: &str, model: &str) -> Device {
+    Device {
+        class: DeviceClass::Direct,
+        uri: uri.into(),
+        info: model.into(),
+        make_and_model: Some(model.into()),
+        device_id: Some(format!("MFG:{};MDL:{};", model.split(' ').next().unwrap_or(""), model)),
+        location: None,
+        driverless: false,
+    }
+}
+
+const HP_PPD: &str = "drv:///hpcups.drv/hp-laserjet_professional_p1102.ppd";
+
+#[test]
+fn repro_sta_19_a_late_driver_list_is_not_taken_for_another_printer() {
+    use crate::pane::AnyPane;
+    let printers = Rc::new(RefCell::new(Printers::default()));
+    let holding = Rc::new(std::cell::Cell::new(false));
+    let held = Rc::new(RefCell::new(Vec::new()));
+    let h2 = holding.clone();
+    let tap = Tap {
+        inner: printers.clone(),
+        hold: Rc::new(move |m: &Msg| h2.get() && matches!(m, Msg::Drivers(_))),
+        held: held.clone(),
+    };
+    let mut panes = crate::panes::all();
+    let i = panes.iter().position(|p| AnyPane::id(&**p) == "printers").unwrap();
+    panes[i] = crate::pane::pane(tap);
+    let dir = std::env::temp_dir().join(format!("settei-repro-sta-19-{}", std::process::id()));
+    let _ = std::fs::remove_dir_all(&dir);
+    std::fs::create_dir_all(&dir).unwrap();
+    let mut h = Harness::new(Settei::new(panes, dir.join("settings.toml"), true, Start::parse("printers")));
+
+    h.send(msg(Msg::AddPrinter));
+    // CUPS finds two printers plugged in, both needing a driver.
+    let hp = usb("usb://HP/LaserJet%20Professional%20P1102?serial=000000000Q8D", "HP LaserJet Professional P1102");
+    let samsung = usb("usb://Samsung/ML-2160%20Series?serial=Z5CEBJAC900123", "Samsung ML-2160 Series");
+    h.send(msg(Msg::Found(Ok(vec![hp.clone(), samsung.clone()]))));
+    holding.set(true);
+    // The HP chosen: its drivers asked for. Then, before they come, the
+    // Samsung: its drivers asked for.
+    h.send(msg(Msg::Choose(0)));
+    h.send(msg(Msg::Choose(1)));
+    assert_eq!(held.borrow().len(), 2, "both lookups on their way");
+    held.borrow_mut().clear();
+    holding.set(false);
+    // CUPS answers the first lookup (the HP's).
+    let hp_drivers = vec![Driver {
+        name: HP_PPD.into(),
+        make_and_model: "HP LaserJet Professional P1102, hpcups 3.25".into(),
+        language: Some("en".into()),
+        device_id: Some("MFG:HP;MDL:LaserJet Professional P1102;".into()),
+    }];
+    h.send(msg(Msg::Drivers(Ok(hp_drivers))));
+
+    let a = printers.borrow().add.clone().expect("the sheet");
+    let chosen = a.device().map(|d| d.uri.clone());
+    let driver = a.drivers.as_ref().and_then(|d| d.as_ref().ok()).and_then(|d| d.get(a.driver)).map(|d| d.name.clone());
+    let ready = a.ready();
+    let sheet: Vec<String> = h.program().sheet_window().map(|s| h.texts(s)).unwrap_or_default();
+    // The sheet's own (the window's come first, up to "Sample system").
+    let sheet: Vec<String> = sheet.iter().skip_while(|t| *t != "Sample system").skip(1).cloned().collect();
+    // Add pressed: what it adds.
+    h.send(msg(Msg::Submit));
+    for _ in 0..100 {
+        if printers.borrow().add.is_none() {
+            break;
+        }
+        std::thread::sleep(std::time::Duration::from_millis(5));
+        h.send(AppMsg::Nothing);
+    }
+    let added: Vec<(String, Option<String>, Option<bool>)> = printers
+        .borrow()
+        .spool
+        .snapshot()
+        .printers
+        .iter()
+        .filter(|p| p.device_uri.as_deref() == Some(samsung.uri.as_str()))
+        .map(|p| (p.name.clone(), p.device_uri.clone(), p.driverless))
+        .collect();
+    let adding = format!("{added:?}");
+    assert!(
+        driver.is_none() && !ready,
+        "with {chosen:?} chosen, the HP's driver list fills the sheet: driver {driver:?}, Add enabled {ready}, \
+         Add pressed → the sample CUPS added (name, uri, driverless) {adding}\nsheet: {sheet:?}"
+    );
+    let _ = samsung;
+}
