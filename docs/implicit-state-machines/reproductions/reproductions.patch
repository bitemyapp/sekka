index 00000000..80609594
--- /dev/null
+++ b/desktop/aizome/apps/sumi/tests/repro_smt_13.rs
@@ -0,0 +1,96 @@
+//! SMT-13: Close → Save whose save is stopped by another alert (Latin-1
+//! can't hold the text; the write failed) and then cancelled must not leave
+//! the window marked to close: a later, ordinary ⌘S must only save.
+
+use std::os::unix::fs::PermissionsExt;
+use std::path::{Path, PathBuf};
+use std::time::Duration;
+
+use aizome_kit::sidestep_ui::{Modifiers, NamedKey};
+use aizome_kit::testing::Harness;
+use aizome_kit::{Point, WindowKey};
+use aizome_sumi::app::{Command, Msg, Places, Sumi};
+use aizome_sumi::files::Encoding;
+
+const NONE: Modifiers = Modifiers::NONE;
+
+fn scratch(name: &str) -> PathBuf {
+    let d = Path::new(env!("CARGO_TARGET_TMPDIR")).join("sumi-repro").join(name);
+    if d.exists() {
+        let _ = std::fs::set_permissions(&d, std::fs::Permissions::from_mode(0o755));
+        let _ = std::fs::remove_dir_all(&d);
+    }
+    std::fs::create_dir_all(&d).unwrap();
+    d
+}
+
+fn sumi() -> Harness<Sumi> {
+    let mut s = Sumi::new(Places::default());
+    s.open_links = false;
+    s.highlight_budget = Duration::from_secs(10);
+    Harness::new(s)
+}
+
+fn focus_editor(h: &mut Harness<Sumi>, w: WindowKey) {
+    h.focus_window(w, true);
+    let e = h.find_id(w, "editor").expect("the editor");
+    h.click(w, Point::new(e.x1 - 30.0, e.y1 - 10.0));
+}
+
+#[test]
+fn cancelling_a_latin1_alert_after_close_save_leaves_the_window_open_for_good() {
+    let dir = scratch("smt13-latin1");
+    let file = dir.join("latin.txt");
+    std::fs::write(&file, b"caf\xe9\n").unwrap();
+    let mut h = sumi();
+    let w = h.window();
+    h.send(Msg::Opened(Some(vec![file.clone()])));
+    assert_eq!(h.program().docs[&w].encoding, Encoding::Latin1);
+    focus_editor(&mut h, w);
+    h.type_text(w, "ok ✓");
+    // Close: asked; Save (Return); Latin-1 can't hold ✓: asked again; Cancel.
+    h.command(w, 'w');
+    assert!(h.texts(w).iter().any(|t| t.starts_with("Save the changes")), "{:?}", h.texts(w));
+    h.named(w, NamedKey::Enter, NONE);
+    assert!(h.texts(w).iter().any(|t| t.contains("can't be saved in Latin-1")), "{:?}", h.texts(w));
+    h.named(w, NamedKey::Escape, NONE);
+    assert!(h.program().docs.contains_key(&w), "still open after Cancel");
+    assert_eq!(std::fs::read(&file).unwrap(), b"caf\xe9\n");
+    // Later the user switches to UTF-8 and saves: just a save.
+    h.send(Msg::On(w, Command::SetEncoding(Encoding::Utf8)));
+    h.command(w, 's');
+    assert_eq!(std::fs::read_to_string(&file).unwrap(), "café\nok ✓", "⌘S saved");
+    assert!(h.program().docs.contains_key(&w), "an ordinary ⌘S closed the window it saved");
+    assert_eq!(h.windows(), vec![w]);
+}
+
+#[test]
+fn a_failed_write_after_close_save_leaves_the_window_open_for_good() {
+    let dir = scratch("smt13-write");
+    let file = dir.join("notes.txt");
+    std::fs::write(&file, "notes\n").unwrap();
+    let mut h = sumi();
+    let w = h.window();
+    h.send(Msg::Opened(Some(vec![file.clone()])));
+    focus_editor(&mut h, w);
+    h.type_text(w, "more");
+    // The file and its folder become read-only: the save will fail.
+    std::fs::set_permissions(&file, std::fs::Permissions::from_mode(0o444)).unwrap();
+    std::fs::set_permissions(&dir, std::fs::Permissions::from_mode(0o555)).unwrap();
+    if std::fs::write(dir.join("probe"), "x").is_ok() || std::fs::OpenOptions::new().write(true).open(&file).is_ok() {
+        std::fs::set_permissions(&dir, std::fs::Permissions::from_mode(0o755)).unwrap();
+        eprintln!("running as root: permissions don't stop the write; skipped");
+        return;
+    }
+    h.command(w, 'w');
+    h.named(w, NamedKey::Enter, NONE);
+    assert!(h.texts(w).iter().any(|t| t.contains("couldn't be saved")), "{:?}", h.texts(w));
+    h.named(w, NamedKey::Enter, NONE);
+    assert!(h.program().docs.contains_key(&w), "still open after the error");
+    // Writable again; later the user saves with ⌘S.
+    std::fs::set_permissions(&dir, std::fs::Permissions::from_mode(0o755)).unwrap();
+    std::fs::set_permissions(&file, std::fs::Permissions::from_mode(0o644)).unwrap();
+    h.command(w, 's');
+    assert_eq!(std::fs::read_to_string(&file).unwrap(), "notes\nmore", "⌘S saved");
+    assert!(h.program().docs.contains_key(&w), "an ordinary ⌘S closed the window it saved");
+}
diff --git a/desktop/aizome/apps/sumi/tests/repro_smt_14.rs b/desktop/aizome/apps/sumi/tests/repro_smt_14.rs
new file mode 100644
index 00000000..b30dd6c4
--- /dev/null
+++ b/desktop/aizome/apps/sumi/tests/repro_smt_14.rs
@@ -0,0 +1,129 @@
+//! SMT-14: with a Link (or Go to Line) sheet open over each of two
+//! documents, typing in one sheet must edit that sheet, and submitting it
+//! must act on its own document and close only it.
+
+use std::time::Duration;
+
+use aizome_kit::sidestep_ui::{Modifiers, NamedKey};
+use aizome_kit::testing::Harness;
+use aizome_kit::{Point, Selection, WindowKey};
+use aizome_sumi::app::{Command, Msg, Places, Sheet, Sumi};
+
+fn sumi() -> Harness<Sumi> {
+    let mut s = Sumi::new(Places::default());
+    s.open_links = false;
+    s.highlight_budget = Duration::from_secs(10);
+    Harness::new(s)
+}
+
+fn focus_editor(h: &mut Harness<Sumi>, w: WindowKey) {
+    h.focus_window(w, true);
+    let e = h.find_id(w, "editor").expect("the editor");
+    h.click(w, Point::new(e.x1 - 30.0, e.y1 - 10.0));
+}
+
+fn type_in(h: &mut Harness<Sumi>, sheet: WindowKey, field: &str, text: &str) {
+    h.focus_window(sheet, true);
+    let f = h.find_id(sheet, field).unwrap_or_else(|| panic!("{field} in the sheet"));
+    h.click(sheet, f.center());
+    h.type_text(sheet, text);
+}
+
+fn sheet_over(h: &Harness<Sumi>, doc: WindowKey) -> Option<WindowKey> {
+    h.program().sheets.iter().find_map(|(k, s)| match s {
+        Sheet::Link { parent, .. } | Sheet::Goto { parent, .. } if *parent == doc => Some(*k),
+        _ => None,
+    })
+}
+
+fn link_text(h: &Harness<Sumi>, doc: WindowKey) -> Option<String> {
+    h.program().sheets.values().find_map(|s| match s {
+        Sheet::Link { parent, text, .. } if *parent == doc => Some(text.clone()),
+        _ => None,
+    })
+}
+
+fn goto_line(h: &Harness<Sumi>, doc: WindowKey) -> Option<String> {
+    h.program().sheets.values().find_map(|s| match s {
+        Sheet::Goto { parent, line, .. } if *parent == doc => Some(line.clone()),
+        _ => None,
+    })
+}
+
+fn two_documents(h: &mut Harness<Sumi>, a_text: &str, b_text: &str) -> (WindowKey, WindowKey) {
+    let a = h.window();
+    focus_editor(h, a);
+    h.type_text(a, a_text);
+    h.send(Msg::New);
+    let b = *h.program().docs.keys().find(|k| **k != a).expect("document B");
+    focus_editor(h, b);
+    h.type_text(b, b_text);
+    (a, b)
+}
+
+#[test]
+fn two_link_sheets_each_edit_and_insert_into_their_own_document() {
+    let mut h = sumi();
+    let (a, b) = two_documents(&mut h, "alpha ", "beta ");
+    // Link… in A, then (switching to B) Link… in B.
+    h.focus_window(a, true);
+    h.send(Msg::On(a, Command::Link));
+    let sa = sheet_over(&h, a).expect("A's Link sheet");
+    h.focus_window(b, true);
+    h.send(Msg::On(b, Command::Link));
+    let sb = sheet_over(&h, b).expect("B's Link sheet");
+    assert_eq!(h.program().sheets.len(), 2);
+
+    type_in(&mut h, sa, "link-text", "AAA");
+    type_in(&mut h, sb, "link-text", "BBB");
+    let typed = (link_text(&h, a), link_text(&h, b));
+    // Insert Link in B's sheet (Return in its field).
+    h.named(sb, NamedKey::Enter, Modifiers::NONE);
+    let docs = &h.program().docs;
+    let after = (
+        docs[&a].content.text(),
+        docs[&b].content.text().contains("BBB"),
+        sheet_over(&h, a).is_some(),
+        sheet_over(&h, b).is_some(),
+    );
+    assert_eq!(
+        (typed, after),
+        (
+            (Some("AAA".to_owned()), Some("BBB".to_owned())),
+            ("alpha ".to_owned(), true, true, false)
+        ),
+        "(A's sheet text, B's sheet text), (A's document, B's has its link, A's sheet open, B's sheet open)"
+    );
+}
+
+#[test]
+fn two_go_to_line_sheets_each_move_their_own_document() {
+    let mut h = sumi();
+    let (a, b) = two_documents(&mut h, "a1\na2\na3\na4\na5", "b1\nb2\nb3\nb4\nb5");
+    h.send(Msg::Edit(a, aizome_kit::EditorAction::Select(Selection::caret(0))));
+    h.send(Msg::Edit(b, aizome_kit::EditorAction::Select(Selection::caret(0))));
+    h.focus_window(a, true);
+    h.send(Msg::On(a, Command::GotoLine));
+    let sa = sheet_over(&h, a).expect("A's sheet");
+    h.focus_window(b, true);
+    h.send(Msg::On(b, Command::GotoLine));
+    let sb = sheet_over(&h, b).expect("B's sheet");
+
+    type_in(&mut h, sa, "goto-line", "2");
+    type_in(&mut h, sb, "goto-line", "4");
+    let typed = (goto_line(&h, a), goto_line(&h, b));
+    // Go in B's sheet.
+    h.named(sb, NamedKey::Enter, Modifiers::NONE);
+    let docs = &h.program().docs;
+    let after = (
+        docs[&a].content.cursor_position().0,
+        docs[&b].content.cursor_position().0,
+        sheet_over(&h, a).is_some(),
+        sheet_over(&h, b).is_some(),
+    );
+    assert_eq!(
+        (typed, after),
+        ((Some("2".to_owned()), Some("4".to_owned())), (0, 3, true, false)),
+        "(A's sheet line, B's sheet line), (A's caret line, B's caret line, A's sheet open, B's sheet open)"
+    );
+}
diff --git a/desktop/aizome/apps/sumi/tests/repro_smt_17.rs b/desktop/aizome/apps/sumi/tests/repro_smt_17.rs
