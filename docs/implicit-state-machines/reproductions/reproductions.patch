--- /dev/null
+++ b/desktop/aizome/crates/aizome-shell/tests/repro_sha_12.rs
@@ -0,0 +1,65 @@
+//! SHA-12: the palette is open when its output goes. The compositor closes
+//! its layer; `close_requested` forgets only the surface, so
+//! `Shell::palette` keeps the dead window, and the next opening (typing in
+//! the Toolchest, `aizomectl palette QUERY`) only re-ranks into it: no
+//! palette shows.
+
+mod common;
+
+use aizome_kit::prelude::*;
+use aizome_shell::actions::Action;
+use aizome_shell::shell::Msg;
+use common::*;
+
+fn monitor() -> aizome_kit::Output {
+    let mut o = output();
+    o.id = 2;
+    o.name = "DP-1".into();
+    o.connector = Some("DP-1".into());
+    o.frame = Rect::new(W, 0.0, W + 2560.0, 1440.0);
+    o
+}
+
+/// The palette open on the laptop, whose display then goes: the
+/// compositor closes the layers on it, then takes the output away.
+fn palette_lost_with_its_output() -> aizome_kit::testing::Harness<aizome_shell::shell::Shell> {
+    let mut h = scene(false);
+    h.set_outputs(vec![output(), monitor()]);
+    h.send(Msg::Run(Action::Palette { scope: None, query: String::new() }));
+    let p = window_titled(&h, "Palette");
+    assert_eq!(h.program().palette.as_ref().map(|s| s.window), Some(p));
+    h.request_close(p);
+    h.set_outputs(vec![monitor()]);
+    assert!(!h.windows().contains(&p), "the kit closed the palette's window");
+    h
+}
+
+fn shown_palette(h: &aizome_kit::testing::Harness<aizome_shell::shell::Shell>) -> Option<WindowKey> {
+    let w = h.program().palette.as_ref()?.window;
+    (h.windows().contains(&w) && h.is_shown(w)).then_some(w)
+}
+
+#[test]
+fn typing_in_the_toolchest_after_the_palettes_output_went_opens_a_palette_that_shows() {
+    let mut h = palette_lost_with_its_output();
+    h.send(Msg::ToolchestTyped("bold".into()));
+    let state = h.program().palette.as_ref().map(|p| (p.window, p.query.clone()));
+    assert!(
+        shown_palette(&h).is_some(),
+        "the palette must open in a live window; palette state {state:?}, windows {:?}",
+        h.windows().iter().map(|k| h.title(*k)).collect::<Vec<_>>()
+    );
+}
+
+#[test]
+fn opening_the_palette_with_a_query_after_its_output_went_shows_it() {
+    let mut h = palette_lost_with_its_output();
+    // `aizomectl palette bold`, or the binding.
+    h.send(Msg::Run(Action::Palette { scope: None, query: "bold".into() }));
+    let state = h.program().palette.as_ref().map(|p| (p.window, p.query.clone()));
+    assert!(
+        shown_palette(&h).is_some(),
+        "the palette must open in a live window; palette state {state:?}, windows {:?}",
+        h.windows().iter().map(|k| h.title(*k)).collect::<Vec<_>>()
+    );
+}
diff --git a/desktop/aizome/crates/aizome-shell/tests/repro_sha_13.rs b/desktop/aizome/crates/aizome-shell/tests/repro_sha_13.rs
new file mode 100644
index 00000000..bafc8ea7
--- /dev/null
+++ b/desktop/aizome/crates/aizome-shell/tests/repro_sha_13.rs
@@ -0,0 +1,88 @@
+//! SHA-13: the palette's file-search sequence number starts again at 0 at
+//! every opening, so a search from an earlier opening that returns late
+//! carries the same `seq` as the current opening's first search, and is
+//! taken as this opening's answer (with `files_for` set to the new query).
+//!
+//! The late reply is delivered by hand, after the new opening's own reply,
+//! with exactly what the earlier opening's search found: the order a slow
+//! search on the kit's thread pool (2–8 threads) can produce.
+
+mod common;
+
+use std::path::PathBuf;
+use std::sync::Arc;
+use std::time::Duration;
+
+use aizome_search::files::{FileIndex, Limits};
+use aizome_shell::actions::Action;
+use aizome_shell::palette::view::PaletteMsg;
+use aizome_shell::palette::{Index, PaletteEvent};
+use aizome_shell::shell::Msg;
+use common::*;
+
+fn files_dir() -> PathBuf {
+    let dir = std::env::temp_dir().join(format!("repro-sha-13-{}", std::process::id()));
+    std::fs::create_dir_all(&dir).unwrap();
+    for name in ["alpha-report.txt", "beta-plan.txt"] {
+        std::fs::write(dir.join(name), name).unwrap();
+    }
+    dir
+}
+
+fn query(h: &mut aizome_kit::testing::Harness<aizome_shell::shell::Shell>, q: &str) {
+    h.send(Msg::Palette(PaletteEvent::Ui(PaletteMsg::Query(q.into()))));
+}
+
+fn file_titles(h: &aizome_kit::testing::Harness<aizome_shell::shell::Shell>) -> Vec<String> {
+    h.program().palette.as_ref().map(|p| p.files.iter().map(|i| i.title.clone()).collect()).unwrap_or_default()
+}
+
+/// Opens the palette and gives it the index, as its loading thread would.
+fn open_with_index(h: &mut aizome_kit::testing::Harness<aizome_shell::shell::Shell>, index: &Arc<FileIndex>) {
+    h.send(Msg::Run(Action::Palette { scope: None, query: String::new() }));
+    h.send(Msg::Palette(PaletteEvent::Index(Index(index.clone()))));
+}
+
+#[test]
+fn a_search_from_an_earlier_opening_is_not_taken_for_this_ones() {
+    let dir = files_dir();
+    let index = Arc::new(FileIndex::build(std::slice::from_ref(&dir), &Limits::default()));
+    let mut h = scene(false);
+
+    // First opening: "alpha" is searched (seq 1).
+    open_with_index(&mut h, &index);
+    query(&mut h, "alpha");
+    assert_eq!(h.program().palette.as_ref().unwrap().search, 1);
+    assert!(
+        h.settle(Duration::from_secs(5), |s| s.palette.as_ref().is_some_and(|p| p.files_for == "alpha")),
+        "the first search answered"
+    );
+    // What search 1 of the first opening answers: its reply, as a
+    // message, is what arrives late below.
+    let alpha_reply = h.program().palette.as_ref().unwrap().files.clone();
+    assert!(alpha_reply.iter().any(|i| i.title == "alpha-report.txt"), "{:?}", file_titles(&h));
+
+    // Esc, open again, type "beta": its first search is seq 1 too.
+    h.send(Msg::Palette(PaletteEvent::Ui(PaletteMsg::Close)));
+    assert!(h.program().palette.is_none());
+    open_with_index(&mut h, &index);
+    query(&mut h, "beta");
+    assert_eq!(h.program().palette.as_ref().unwrap().search, 1, "the sequence started again");
+    assert!(
+        h.settle(Duration::from_secs(5), |s| s.palette.as_ref().is_some_and(|p| p.files_for == "beta")),
+        "the second search answered"
+    );
+    assert!(file_titles(&h).iter().any(|t| t == "beta-plan.txt"), "{:?}", file_titles(&h));
+
+    // The first opening's search 1 comes back now.
+    h.send(Msg::Palette(PaletteEvent::Files(1, alpha_reply)));
+    let p = h.program().palette.as_ref().unwrap();
+    eprintln!("query {:?}, files_for {:?}, files {:?}", p.query, p.files_for, file_titles(&h));
+    assert!(
+        file_titles(&h).iter().any(|t| t == "beta-plan.txt") && !file_titles(&h).iter().any(|t| t == "alpha-report.txt"),
+        "the palette shows the files for \"beta\", not an earlier opening's \"alpha\": {:?} (files_for {:?})",
+        file_titles(&h),
+        p.files_for
+    );
+    let _ = std::fs::remove_dir_all(dir);
+}
diff --git a/desktop/aizome/crates/aizome-shell/tests/repro_sha_25.rs b/desktop/aizome/crates/aizome-shell/tests/repro_sha_25.rs
new file mode 100644
index 00000000..16c7da08
--- /dev/null
+++ b/desktop/aizome/crates/aizome-shell/tests/repro_sha_25.rs
@@ -0,0 +1,149 @@
+//! SHA-25: torn-off palettes are keyed by their index in `Shell::tearoffs`
+//! (`tear_shown`, `Surface::TearOff(i)`).
+//!
+//! (1) Tearing off again a menu that already has a palette goes through
+//! `tear_off`, whose `retain` shifts the later palettes down while the
+//! shown windows keep the old indices: windows show each other's menus,
+//! and the re-torn palette is not moved where it was dropped.
+//!
+//! (2) A palette's output goes: the compositor closes its layer and
+//! `close_requested` forgets only the surface; `tear_shown[i]` keeps the
+//! dead window, so a pinned (always shown) palette never opens again.
+
+mod common;
+
+use aizome_kit::platform::{LayerChange, OpenKind, WinId};
+use aizome_kit::prelude::*;
+use aizome_kit::testing::Harness;
+use aizome_shell::shell::{Msg, Shell};
+use aizome_shell::tearoff::TearMsg;
+use common::*;
+
+const TORN: &str = "Palette (torn off)";
+
+fn tear(h: &mut Harness<Shell>, menu: &str, x: f64, y: f64) {
+    h.send(Msg::TearOff {
+        app: "org.aizome.Sumi".into(),
+        path: vec![menu.into()],
+        output: "eDP-1".into(),
+        at: Point::new(x, y),
+    });
+}
+
+/// Each torn-off palette's window: its place as the stand-in compositor
+/// has it (left, top margins, as last set) and the title of the menu it
+/// draws (the menu widget's semantics). `Harness::windows` and the
+/// platform's windows are both in window-id order, so the n-th torn-off
+/// key is the n-th torn-off platform window.
+fn palettes(h: &Harness<Shell>) -> Vec<(WinId, (i32, i32), Vec<String>)> {
+    let keys: Vec<WindowKey> = h.windows().into_iter().filter(|k| h.title(*k) == TORN).collect();
+    let ids: Vec<(WinId, (i32, i32))> = h
+        .platform
+        .windows
+        .iter()
+        .filter(|(_, w)| w.title == TORN)
+        .map(|(id, w)| {
+            let mut m = match &w.spec.kind {
+                OpenKind::Layer(opts) => (opts.margins.left, opts.margins.top),
+                _ => (0, 0),
+            };
+            for (win, change) in &h.platform.layer_changes {
+                if win == id
+                    && let LayerChange::Margins(n) = change
+                {
+                    m = (n.left, n.top);
+                }
+            }
+            (*id, m)
+        })
+        .collect();
+    assert_eq!(keys.len(), ids.len());
+    keys.into_iter()
+        .zip(ids)
+        .map(|(k, (id, m))| {
+            let titles = h
+                .semantics(k)
+                .into_iter()
+                .filter(|(s, _)| s.role == aizome_kit::widget::SemanticRole::Menu)
+                .filter_map(|(s, _)| s.label)
+                .collect();
+            (id, m, titles)
+        })
+        .collect()
+}
+
+/// Whether a palette draws the menu titled `menu` ("File" shows New and
+/// Open…, "Edit" Undo Bold, Cut…).
+fn shows(titles: &[String], menu: &str) -> bool {
+    titles.iter().any(|t| t == menu)
+}
+
+#[test]
+fn tearing_off_a_menu_again_keeps_each_palette_showing_its_own_menu_where_it_was_put() {
+    let mut h = scene(false);
+    tear(&mut h, "File", 100.0, 100.0);
+    tear(&mut h, "Edit", 400.0, 100.0);
+    let before = palettes(&h);
+    assert_eq!(before.len(), 2);
+    for (_, at, texts) in &before {
+        match at {
+            (100, 100) => assert!(shows(texts, "File"), "File at (100, 100): {texts:?}"),
+            (400, 100) => assert!(shows(texts, "Edit"), "Edit at (400, 100): {texts:?}"),
+            other => panic!("a palette at {other:?}"),
+        }
+    }
+    // File torn off again, dropped at (700, 300).
+    tear(&mut h, "File", 700.0, 300.0);
+    let after = palettes(&h);
+    eprintln!("remembered: {:?}", h.program().tearoffs.iter().map(|t| (&t.path, t.x, t.y)).collect::<Vec<_>>());
+    for (id, at, texts) in &after {
+        eprintln!("window {id:?} at {at:?}: shows {texts:?}");
+    }
+    let edit = after.iter().find(|(_, _, t)| shows(t, "Edit")).expect("Edit shows");
+    let file = after.iter().find(|(_, _, t)| shows(t, "File")).expect("File shows");
+    assert_eq!(edit.1, (400, 100), "Edit's palette stays where it was");
+    assert_eq!(file.1, (700, 300), "File's palette is where it was dropped again");
+}
+
+#[test]
+fn a_single_palette_torn_off_again_moves_where_it_was_dropped() {
+    let mut h = scene(false);
+    tear(&mut h, "File", 100.0, 100.0);
+    tear(&mut h, "File", 700.0, 300.0);
+    let t = &h.program().tearoffs[0];
+    let shown = palettes(&h);
+    eprintln!("remembered at ({}, {}); shown {:?}", t.x, t.y, shown.iter().map(|p| p.1).collect::<Vec<_>>());
+    assert_eq!(shown.len(), 1);
+    assert_eq!(shown[0].1, (t.x as i32, t.y as i32), "shown where it is remembered");
+}
+
+#[test]
+fn a_pinned_palette_whose_display_went_shows_again_on_the_display_left() {
+    let mut h = scene(false);
+    let mut monitor = output();
+    monitor.id = 2;
+    monitor.name = "DP-1".into();
+    monitor.connector = Some("DP-1".into());
+    monitor.frame = Rect::new(W, 0.0, W + 2560.0, 1440.0);
+    h.set_outputs(vec![output(), monitor.clone()]);
+    tear(&mut h, "File", 100.0, 100.0);
+    h.send(Msg::Tear(TearMsg::Pin(0, true)));
+    let p = window_titled(&h, TORN);
+
+    // The laptop's display goes: the compositor closes the layers on it,
+    // then takes it away.
+    let laptop = h.program().screens.iter().find(|s| s.output.id == 1).cloned().unwrap();
+    for k in [Some(p), laptop.bar, laptop.desktop].into_iter().flatten() {
+        h.request_close(k);
+    }
+    h.set_outputs(vec![monitor.clone()]);
+    h.send(Msg::Nothing);
+    let open = h.windows().into_iter().filter(|k| h.title(*k) == TORN).count();
+    assert_eq!(open, 1, "the pinned palette shows on the display left");
+
+    // And when the laptop's display comes back.
+    h.set_outputs(vec![output(), monitor]);
+    h.send(Msg::Nothing);
+    let open = h.windows().into_iter().filter(|k| h.title(*k) == TORN).count();
+    assert_eq!(open, 1, "the pinned palette shows once the display is back");
+}
diff --git a/desktop/aizome/crates/aizome-shell/tests/repro_shb_03.rs b/desktop/aizome/crates/aizome-shell/tests/repro_shb_03.rs
new file mode 100644
index 00000000..879c26fe
--- /dev/null
+++ b/desktop/aizome/crates/aizome-shell/tests/repro_shb_03.rs
@@ -0,0 +1,187 @@
+//! SHB-03: the shell's polkit dialog, with polkit's helper unreachable (its
+//! socket isn't there). The real agent (aizome-sys) serves a fake polkitd
+//! on a private dbus-daemon; its events go to the real shell, headless, as
+//! its message sender would deliver them. Nobody types: the dialog should
+//! settle on an error, not restart the conversation again and again.
+//! Never the real polkitd, the system bus or polkit-agent-helper-1.
+
+mod common;
+
+use std::collections::HashMap;
+use std::io::{BufRead, BufReader};
+use std::path::PathBuf;
+use std::process::{Child, Command, Stdio};
+use std::sync::mpsc;
+use std::sync::{Arc, Mutex};
+use std::time::{Duration, Instant};
+
+use aizome_shell::auth::AuthMsg;
+use aizome_shell::shell::Msg;
+use aizome_sys::polkit::{AuthEvent, Helper, PolkitAgent};
+use common::*;
+use zbus::zvariant::{OwnedValue, Value};
+
+const AGENT_PATH: &str = "/org/aizome/PolicyKit1/AuthenticationAgent";
+
+/// A private dbus-daemon that allows everything and activates nothing.
+struct TestBus {
+    child: Child,
+    address: String,
+    dir: PathBuf,
+}
+
+impl TestBus {
+    fn start() -> Option<TestBus> {
+        let dir = std::env::temp_dir().join(format!("repro-shb-03-bus-{}", std::process::id()));
+        let _ = std::fs::remove_dir_all(&dir);
+        std::fs::create_dir_all(&dir).ok()?;
+        let config = dir.join("bus.conf");
+        std::fs::write(
+            &config,
+            format!(
+                r#"<!DOCTYPE busconfig PUBLIC "-//freedesktop//DTD D-Bus Bus Configuration 1.0//EN"
+ "http://www.freedesktop.org/standards/dbus/1.0/busconfig.dtd">
+<busconfig>
+  <type>session</type>
+  <listen>unix:dir={}</listen>
+  <auth>EXTERNAL</auth>
+  <policy context="default">
+    <allow send_destination="*" eavesdrop="true"/>
+    <allow eavesdrop="true"/>
+    <allow own="*"/>
+  </policy>
+</busconfig>
+"#,
+                dir.display()
+            ),
+        )
+        .ok()?;
+        let mut child = Command::new("dbus-daemon")
+            .arg(format!("--config-file={}", config.display()))
+            .args(["--print-address", "--nofork"])
+            .stdout(Stdio::piped())
+            .stderr(Stdio::null())
+            .spawn()
+            .ok()?;
+        let mut line = String::new();
+        BufReader::new(child.stdout.take()?).read_line(&mut line).ok()?;
+        let address = line.trim().to_owned();
+        if address.is_empty() {
+            let _ = child.kill();
+            return None;
+        }
+        Some(TestBus { child, address, dir })
+    }
+}
+
+impl Drop for TestBus {
+    fn drop(&mut self) {
+        let _ = self.child.kill();
+        let _ = self.child.wait();
+        let _ = std::fs::remove_dir_all(&self.dir);
+    }
+}
+
+struct Authority {
+    registered: Arc<Mutex<usize>>,
+}
+
+type Subject = (String, HashMap<String, OwnedValue>);
+
+#[zbus::interface(name = "org.freedesktop.PolicyKit1.Authority")]
+impl Authority {
+    fn register_authentication_agent(&self, _subject: Subject, _locale: String, _path: String) {
+        *self.registered.lock().unwrap() += 1;
+    }
+    fn unregister_authentication_agent(&self, _subject: Subject, _path: String) {}
+}
+
+fn me() -> u32 {
+    // SAFETY: getuid has no failure mode.
+    unsafe { libc::getuid() }
+}
+
+#[test]
+fn an_unreachable_helper_does_not_spin_the_dialog() {
+    let Some(bus) = TestBus::start() else {
+        eprintln!("skipping: no dbus-daemon");
+        return;
+    };
+    if !std::fs::read_to_string("/etc/passwd")
+        .is_ok_and(|p| p.lines().any(|l| l.split(':').nth(2) == Some(&me().to_string())))
+    {
+        eprintln!("skipping: no passwd entry for this uid");
+        return;
+    }
+    let registered = Arc::new(Mutex::new(0usize));
+    let polkitd = zbus::blocking::connection::Builder::address(bus.address.as_str())
+        .unwrap()
+        .name("org.freedesktop.PolicyKit1")
+        .unwrap()
+        .serve_at("/org/freedesktop/PolicyKit1/Authority", Authority { registered: registered.clone() })
+        .unwrap()
+        .build()
+        .unwrap();
+    let agent_bus = aizome_sys::Bus::at(&bus.address).unwrap();
+    let agent_name = agent_bus.unique_name().unwrap();
+    let (tx, rx) = mpsc::channel::<AuthEvent>();
+    // polkit 126's socket-activated helper, its socket missing.
+    let missing = bus.dir.join("agent-helper.socket");
+    let _agent = PolkitAgent::register_with(agent_bus, "7".into(), Helper::Socket(missing), move |e| {
+        let _ = tx.send(e);
+    })
+    .unwrap();
+    let deadline = Instant::now() + Duration::from_secs(5);
+    while *registered.lock().unwrap() == 0 {
+        assert!(Instant::now() < deadline, "the agent never registered");
+        std::thread::sleep(Duration::from_millis(20));
+    }
+
+    let mut h = scene(false);
+    // polkitd asks; its call stays pending while the dialog is up.
+    let call = std::thread::spawn({
+        let polkitd = polkitd.clone();
+        move || {
+            let identity: (&str, HashMap<&str, Value>) = ("unix-user", HashMap::from([("uid", Value::from(me()))]));
+            let details: HashMap<&str, &str> = HashMap::new();
+            polkitd.call_method(
+                Some(agent_name.as_str()),
+                AGENT_PATH,
+                Some("org.freedesktop.PolicyKit1.AuthenticationAgent"),
+                "BeginAuthentication",
+                &(
+                    "org.freedesktop.udisks2.filesystem-mount",
+                    "Authentication is required to mount sekka-nightly.iso.",
+                    "drive-removable-media",
+                    details,
+                    "cookie-1",
+                    vec![identity],
+                ),
+            )
+        }
+    });
+
+    // The shell's loop, two seconds of it, nobody typing.
+    let start = Instant::now();
+    let (mut failed, mut errors) = (0usize, 0usize);
+    while start.elapsed() < Duration::from_secs(2) && failed < 500 {
+        let Ok(e) = rx.recv_timeout(Duration::from_millis(50)) else { continue };
+        match &e {
+            AuthEvent::Failed { .. } => failed += 1,
+            AuthEvent::Error { .. } => errors += 1,
+            _ => {}
+        }
+        h.send(Msg::Auth(e.into()));
+    }
+    let took = start.elapsed();
+    let dialog = h.program().auth.as_ref().map(|a| (a.error.clone(), a.busy));
+    // Dismiss it; polkitd's call ends.
+    h.send(Msg::AuthUi(AuthMsg::Cancel));
+    let _ = call.join();
+    assert!(dialog.is_some(), "the dialog opened");
+    assert!(
+        failed <= 3,
+        "the dialog restarted the conversation {failed} times ({errors} errors from the agent) in {took:?} \
+         with no one typing; it shows {dialog:?}"
+    );
+}
diff --git a/desktop/aizome/crates/aizome-shell/tests/repro_shb_06.rs b/desktop/aizome/crates/aizome-shell/tests/repro_shb_06.rs
new file mode 100644
index 00000000..818be967
--- /dev/null
+++ b/desktop/aizome/crates/aizome-shell/tests/repro_shb_06.rs
@@ -0,0 +1,51 @@
+//! SHB-06: the Shut Down countdown, headless, when the compositor takes its
+//! dialog away because the dialog's output went (the laptop's lid closes
+//! while an external display stays). Off-live, the shell only records the
+//! verb it would carry out (`session_done`), so nothing powers off here.
+
+mod common;
+
+use std::time::Duration;
+
+use aizome_kit::Output;
+use aizome_kit::testing::Harness;
+use aizome_shell::actions::{Action, SessionVerb};
+use aizome_shell::shell::{Msg, Shell};
+use common::*;
+
+fn external() -> Output {
+    Output { id: 2, name: "DP-1".into(), connector: Some("DP-1".into()), ..output() }
+}
+
+fn dialog_shown(h: &Harness<Shell>) -> bool {
+    h.windows().iter().any(|k| h.title(*k) == "Confirm")
+}
+
+#[test]
+fn the_countdown_does_not_carry_on_without_its_dialog() {
+    let mut h = scene(false);
+    h.set_outputs(vec![output(), external()]);
+    h.send(Msg::Run(Action::Session(SessionVerb::ShutDown)));
+    let dialog = window_titled(&h, "Confirm");
+    h.advance(Duration::from_secs(5));
+
+    // eDP-1 goes: the compositor closes the layer on it, then the output.
+    h.request_close(dialog);
+    h.set_outputs(vec![external()]);
+    let counting = h.program().confirm.clone();
+    let shown = dialog_shown(&h);
+
+    // The person asks again (Shut Down from the menu) to get the dialog back.
+    h.send(Msg::Run(Action::Session(SessionVerb::ShutDown)));
+    let shown_again = dialog_shown(&h);
+
+    h.advance(Duration::from_secs(61));
+    let done = h.program().session_done;
+    let report = format!(
+        "after the compositor closed the dialog: countdown {:?}, dialog shown {shown}; asked again: dialog shown \
+         {shown_again}; 61 s later the shell did {done:?}",
+        counting.as_ref().map(|c| (c.verb, c.left))
+    );
+    assert!(counting.is_none() || shown, "a countdown runs with no dialog to cancel it: {report}");
+    assert!(done.is_none() || shown || shown_again, "carried out with no dialog shown: {report}");
+}
diff --git a/desktop/aizome/crates/aizome-shell/tests/repro_shb_12.rs b/desktop/aizome/crates/aizome-shell/tests/repro_shb_12.rs
new file mode 100644
index 00000000..49a81348
--- /dev/null
+++ b/desktop/aizome/crates/aizome-shell/tests/repro_shb_12.rs
@@ -0,0 +1,69 @@
+//! SHB-12: the lock screen tells every PAM refusal as a wrong password.
+//! Headless shell, locked, with a stand-in authenticator that answers as
+//! `aizome_shell::pam::Pam` does when PAM refuses for a reason other than
+//! the password: it returns the last message a module said (pam.rs:178), or
+//! pam_strerror's text. The messages are those of pam_faillock (a lockout)
+//! and pam_unix's account management (an expired password).
+
+mod common;
+
+use std::sync::Arc;
+use std::time::Duration;
+
+use aizome_kit::prelude::*;
+use aizome_kit::sidestep_ui::{Modifiers, NamedKey};
+use aizome_shell::actions::{Action, SessionVerb};
+use aizome_shell::lock::Phase;
+use aizome_shell::pam::Authenticator;
+use aizome_shell::shell::Msg;
+use common::*;
+
+/// PAM refusing the right password, for `why`.
+struct Refuses(&'static str);
+
+impl Authenticator for Refuses {
+    fn authenticate(&self, _user: &str, _password: &str) -> Result<(), String> {
+        Err(self.0.into())
+    }
+}
+
+const WRONG: &str = "That password didn't work. Try again.";
+
+#[test]
+fn a_lockout_or_an_expired_password_is_not_called_a_wrong_password() {
+    let cases = [
+        ("faillock lockout", "The account is locked due to 3 failed logins."),
+        ("faillock lockout, its last line", "(10 minutes left to unlock)"),
+        ("expired password", "You are required to change your password immediately (password expired)"),
+        ("expired password, pam_strerror", "Authentication token is no longer valid; new one required"),
+        ("account expired", "Your account has expired; please contact your system administrator."),
+    ];
+    let mut seen = Vec::new();
+    for (why, pam) in cases {
+        let mut h = scene(false);
+        {
+            let s = h.program_mut();
+            s.authenticator = Arc::new(Refuses(pam));
+            s.user = ("callen".into(), "Chris Allen".into());
+        }
+        h.send(Msg::Run(Action::Session(SessionVerb::Lock)));
+        h.confirm_lock();
+        assert_eq!(h.program().lock.phase, Phase::Locked);
+        let lock = h.windows().into_iter().find(|k| h.title(*k).is_empty()).expect("a lock surface");
+        h.resize(lock, Size::new(W, H));
+        h.type_text(lock, "the right password");
+        h.named(lock, NamedKey::Enter, Modifiers::NONE);
+        for _ in 0..100 {
+            std::thread::sleep(Duration::from_millis(10));
+            h.send(Msg::Nothing);
+            if !h.program().lock.busy {
+                break;
+            }
+        }
+        // What the lock surface draws under the field (lock.rs:263-275, 479).
+        let shown = h.program().lock.error.clone();
+        seen.push((why, pam, shown));
+    }
+    let wrong: Vec<_> = seen.iter().filter(|(_, _, shown)| shown.as_deref() == Some(WRONG)).collect();
+    assert!(wrong.is_empty(), "PAM's reason replaced by a wrong-password message: {wrong:#?}");
+}
diff --git a/desktop/aizome/crates/aizome-shell/tests/repro_shb_14.rs b/desktop/aizome/crates/aizome-shell/tests/repro_shb_14.rs
