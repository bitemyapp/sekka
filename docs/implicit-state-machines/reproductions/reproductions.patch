diff --git a/desktop/aizome/apps/koyomi/src/repro_koy_01.rs b/desktop/aizome/apps/koyomi/src/repro_koy_01.rs
new file mode 100644
index 00000000..ae488793
--- /dev/null
+++ b/desktop/aizome/apps/koyomi/src/repro_koy_01.rs
@@ -0,0 +1,57 @@
+//! KOY-01: the agent's Open starts `aizome-koyomi --show DATE` and drops
+//! the `Child` without waiting for it, so every Open click leaves a
+//! zombie under the long-running agent.
+//!
+//! The child here is this test binary (`current_exe`) run with
+//! `--show 2026-10-19`, which libtest refuses at once and exits: the
+//! same as a hand-off launch that exits quickly.
+
+use std::time::{Duration, Instant};
+
+/// This process's children, as (pid, state) from /proc.
+fn children() -> Vec<(i32, char)> {
+    let me = std::process::id() as i32;
+    let mut out = Vec::new();
+    for e in std::fs::read_dir("/proc").into_iter().flatten().flatten() {
+        let Ok(pid) = e.file_name().to_string_lossy().parse::<i32>() else { continue };
+        let Ok(stat) = std::fs::read_to_string(format!("/proc/{pid}/stat")) else { continue };
+        let Some(close) = stat.rfind(')') else { continue };
+        let mut f = stat[close + 1..].split_whitespace();
+        let state = f.next().and_then(|s| s.chars().next()).unwrap_or('?');
+        let ppid: i32 = f.next().and_then(|s| s.parse().ok()).unwrap_or(0);
+        if ppid == me {
+            out.push((pid, state));
+        }
+    }
+    out
+}
+
+#[test]
+fn repro_koy_01_open_leaves_no_zombie() {
+    let before: Vec<i32> = children().into_iter().map(|(p, _)| p).collect();
+    // What `run` does with Reply::Open's day.
+    super::open_app("2026-10-19");
+    let new = || children().into_iter().filter(|(p, _)| !before.contains(p)).collect::<Vec<_>>();
+    // Wait for the child to finish (it exits at once), then give a reaper
+    // two seconds to collect it.
+    let deadline = Instant::now() + Duration::from_secs(10);
+    while new().iter().any(|(_, s)| *s != 'Z') && Instant::now() < deadline {
+        std::thread::sleep(Duration::from_millis(20));
+    }
+    let grace = Instant::now() + Duration::from_secs(2);
+    while !new().is_empty() && Instant::now() < grace {
+        std::thread::sleep(Duration::from_millis(20));
+    }
+    let left = new();
+    let zombies: Vec<i32> = left.iter().filter(|(_, s)| *s == 'Z').map(|(p, _)| *p).collect();
+    // Reap what's left, so the test process stays tidy either way.
+    for (pid, _) in &left {
+        unsafe {
+            libc::waitpid(*pid, std::ptr::null_mut(), 0);
+        }
+    }
+    assert!(
+        zombies.is_empty(),
+        "the child Open started has exited but is still a zombie of the agent 2 s later: pids {zombies:?} (children: {left:?})"
+    );
+}
diff --git a/desktop/aizome/apps/koyomi/tests/repro_koy_02.rs b/desktop/aizome/apps/koyomi/tests/repro_koy_02.rs
new file mode 100644
index 00000000..25ca7068
--- /dev/null
+++ b/desktop/aizome/apps/koyomi/tests/repro_koy_02.rs
@@ -0,0 +1,236 @@
+//! KOY-02: alert delivery. An alert is marked fired before Notify
+//! succeeds, so one whose Notify failed (the shell not yet holding
+//! org.freedesktop.Notifications at login) is never posted; and after a
+//! restart the agent's `shown` is empty, so Snooze and Open on the
+//! notifications still on screen do nothing.
+//!
+//! Driven over a private dbus-daemon with a fake notification server, as
+//! tests/agent.rs does.
+
+use std::collections::HashMap;
+use std::io::{BufRead, BufReader};
+use std::path::PathBuf;
+use std::process::{Child, Command, Stdio};
+use std::sync::mpsc::channel;
+use std::sync::{Arc, Mutex};
+use std::time::Duration;
+
+use jiff::civil::datetime;
+use jiff::tz::TimeZone;
+use jiff::{SignedDuration, Timestamp};
+use koyomi::agent::{Agent, AgentState, Dbus, Reply};
+use koyomi::settings::Settings;
+use koyomi::store::Store;
+use zbus::zvariant::OwnedValue;
+
+/// The agent state file is shared by the tests here.
+static LOCK: Mutex<()> = Mutex::new(());
+
+struct Bus {
+    child: Child,
+    address: String,
+    dir: PathBuf,
+}
+
+impl Bus {
+    fn start(name: &str) -> Bus {
+        // A short socket path (XDG_RUNTIME_DIR from the wrapper).
+        let base = std::env::var_os("XDG_RUNTIME_DIR").map(PathBuf::from).unwrap_or_else(std::env::temp_dir);
+        let dir = base.join(format!("k02{name}{}", std::process::id()));
+        let _ = std::fs::remove_dir_all(&dir);
+        std::fs::create_dir_all(&dir).unwrap();
+        let config = dir.join("bus.conf");
+        std::fs::write(
+            &config,
+            format!(
+                "<!DOCTYPE busconfig PUBLIC \"-//freedesktop//DTD D-Bus Bus Configuration 1.0//EN\" \"http://www.freedesktop.org/standards/dbus/1.0/busconfig.dtd\">\n<busconfig><type>session</type><listen>unix:dir={}</listen><auth>EXTERNAL</auth><policy context=\"default\"><allow send_destination=\"*\" eavesdrop=\"true\"/><allow eavesdrop=\"true\"/><allow own=\"*\"/></policy></busconfig>\n",
+                dir.display()
+            ),
+        )
+        .unwrap();
+        let mut child = Command::new("dbus-daemon")
+            .arg(format!("--config-file={}", config.display()))
+            .args(["--print-address", "--nofork"])
+            .stdout(Stdio::piped())
+            .stderr(Stdio::null())
+            .spawn()
+            .expect("dbus-daemon (this reproduction needs one; it must not skip)");
+        let mut line = String::new();
+        BufReader::new(child.stdout.take().unwrap()).read_line(&mut line).unwrap();
+        let address = line.trim().to_owned();
+        assert!(!address.is_empty(), "dbus-daemon printed no address");
+        Bus { child, address, dir }
+    }
+}
+
+impl Drop for Bus {
+    fn drop(&mut self) {
+        let _ = self.child.kill();
+        let _ = self.child.wait();
+        let _ = std::fs::remove_dir_all(&self.dir);
+    }
+}
+
+type Posted = Arc<Mutex<Vec<(u32, String)>>>;
+
+struct Daemon {
+    posted: Posted,
+    next: u32,
+}
+
+#[zbus::interface(name = "org.freedesktop.Notifications")]
+impl Daemon {
+    #[allow(clippy::too_many_arguments)]
+    fn notify(
+        &mut self,
+        _app: String,
+        replaces: u32,
+        _icon: String,
+        summary: String,
+        _body: String,
+        _actions: Vec<String>,
+        _hints: HashMap<String, OwnedValue>,
+        _timeout: i32,
+    ) -> u32 {
+        let id = if replaces != 0 {
+            replaces
+        } else {
+            self.next += 1;
+            self.next
+        };
+        self.posted.lock().unwrap().push((id, summary));
+        id
+    }
+}
+
+fn serve(bus: &Bus, posted: &Posted) -> zbus::blocking::Connection {
+    zbus::blocking::connection::Builder::address(bus.address.as_str())
+        .unwrap()
+        .name("org.freedesktop.Notifications")
+        .unwrap()
+        .serve_at("/org/freedesktop/Notifications", Daemon { posted: posted.clone(), next: 0 })
+        .unwrap()
+        .build()
+        .unwrap()
+}
+
+const EVENT: &str = "BEGIN:VEVENT\r\nUID:{uid}\r\nDTSTART;TZID=Europe/London:20261019T{start}\r\nDTEND;TZID=Europe/London:20261019T{end}\r\nSUMMARY:{summary}\r\nBEGIN:VALARM\r\nACTION:DISPLAY\r\nTRIGGER:-PT10M\r\nEND:VALARM\r\nEND:VEVENT\r\n";
+
+/// A folder with one calendar holding events alerting at 09:20 on 19 October.
+fn folder(name: &str, events: &[(&str, &str, &str, &str)]) -> PathBuf {
+    let dir = PathBuf::from(env!("CARGO_TARGET_TMPDIR")).join(format!("koyomi-repro-koy02-{name}"));
+    let _ = std::fs::remove_dir_all(&dir);
+    std::fs::create_dir_all(&dir).unwrap();
+    let mut ics = "BEGIN:VCALENDAR\r\nX-WR-CALNAME:Work\r\n".to_owned();
+    for (uid, summary, start, end) in events {
+        ics.push_str(&EVENT.replace("{uid}", uid).replace("{summary}", summary).replace("{start}", start).replace("{end}", end));
+    }
+    ics.push_str("END:VCALENDAR\r\n");
+    std::fs::write(dir.join("work.ics"), ics).unwrap();
+    dir
+}
+
+fn at(h: i8, m: i8) -> Timestamp {
+    datetime(2026, 10, 19, h, m, 0, 0).to_zoned(TimeZone::get("Europe/London").unwrap()).unwrap().timestamp()
+}
+
+fn emit(server: &zbus::blocking::Connection, id: u32, key: &str) {
+    server
+        .emit_signal(
+            None::<&str>,
+            "/org/freedesktop/Notifications",
+            "org.freedesktop.Notifications",
+            "ActionInvoked",
+            &(id, key),
+        )
+        .unwrap();
+}
+
+#[test]
+fn repro_koy_02_an_alert_whose_notify_failed_is_posted_once_the_server_is_there() {
+    let _g = LOCK.lock().unwrap_or_else(|e| e.into_inner());
+    let _ = std::fs::remove_file(AgentState::path());
+    let bus = Bus::start("a");
+    // The stand-up alerts at 09:20; "Later" (a control) at 09:25, once the server is there.
+    let dir = folder("failed", &[("a", "Stand-up", "093000", "094500"), ("c", "Later", "093500", "095000")]);
+    let tz = TimeZone::get("Europe/London").unwrap();
+    let mut agent = Agent::new(Store::open(&dir), tz.clone(), AgentState::default(), &Settings::default());
+    let mut dbus = Dbus::at(&bus.address).unwrap();
+
+    // Login: the agent is up before the shell has the name. Notify fails.
+    let notes = agent.due(at(9, 20), true);
+    assert_eq!(notes.len(), 1, "the stand-up's alert is due");
+    agent.post(notes, &mut dbus);
+    agent.save_if_changed();
+    let fired_on_disk = AgentState::load().fired.len();
+
+    // The shell takes org.freedesktop.Notifications; the agent's next
+    // turns (it wakes at least every 30 s).
+    let posted: Posted = Arc::default();
+    let _server = serve(&bus, &posted);
+    for s in [30, 60, 90, 300] {
+        let now = at(9, 20).checked_add(SignedDuration::from_secs(s)).unwrap();
+        agent.refresh();
+        let notes = agent.due(now, true);
+        agent.post(notes, &mut dbus);
+        agent.save_if_changed();
+    }
+    // And after a restart, from what it saved.
+    let mut again = Agent::new(Store::open(&dir), tz, AgentState::load(), &Settings::default());
+    let notes = again.due(at(9, 26), true);
+    again.post(notes, &mut dbus);
+
+    let mut got: Vec<String> = posted.lock().unwrap().iter().map(|(_, s)| s.clone()).collect();
+    got.sort();
+    assert_eq!(
+        got,
+        ["Later", "Stand-up"],
+        "the alert whose Notify failed should be posted once the server is there (\"Later\", due after, is the control) \
+         (agent.json already listed {fired_on_disk} fired alert(s) after the failed Notify)"
+    );
+}
+
+#[test]
+fn repro_koy_02_snooze_and_open_work_on_notifications_from_before_a_restart() {
+    let _g = LOCK.lock().unwrap_or_else(|e| e.into_inner());
+    let _ = std::fs::remove_file(AgentState::path());
+    let bus = Bus::start("b");
+    let posted: Posted = Arc::default();
+    let server = serve(&bus, &posted);
+    let dir = folder("restart", &[("a", "Stand-up", "093000", "094500"), ("b", "Review", "093000", "094500")]);
+    let tz = TimeZone::get("Europe/London").unwrap();
+
+    // The first agent posts both alerts (they stay on screen: timeout 0).
+    {
+        let mut agent = Agent::new(Store::open(&dir), tz.clone(), AgentState::default(), &Settings::default());
+        let mut dbus = Dbus::at(&bus.address).unwrap();
+        let notes = agent.due(at(9, 20), true);
+        agent.post(notes, &mut dbus);
+        agent.save_if_changed();
+    }
+    let ids: HashMap<String, u32> = posted.lock().unwrap().iter().map(|(id, s)| (s.clone(), *id)).collect();
+    assert_eq!(ids.len(), 2, "both alerts posted: {ids:?}");
+
+    // It crashes; systemd starts it again (Restart=on-failure), from agent.json.
+    let mut agent = Agent::new(Store::open(&dir), tz, AgentState::load(), &Settings::default());
+    let dbus = Dbus::at(&bus.address).unwrap();
+    let (tx, rx) = channel();
+    dbus.listen(tx).unwrap();
+
+    // The person presses Snooze on one old notification and Open on the other.
+    emit(&server, ids["Stand-up"], "snooze");
+    let r = rx.recv_timeout(Duration::from_secs(5)).expect("the restarted agent hears Snooze");
+    assert_eq!(r, Reply::Snooze(ids["Stand-up"]));
+    agent.handle(r, at(9, 22));
+    emit(&server, ids["Review"], "open");
+    let r = rx.recv_timeout(Duration::from_secs(5)).expect("the restarted agent hears Open");
+    assert_eq!(r, Reply::Open(ids["Review"]));
+    let open = agent.handle(r, at(9, 22));
+    let back: Vec<String> = agent.due(at(9, 33), true).into_iter().map(|n| n.summary).collect();
+
+    assert!(
+        open.as_deref() == Some("2026-10-19") && back == ["Stand-up"],
+        "after a restart, Open should give the day to show (got {open:?}) and Snooze should bring the \
+         alert back 10 min later (due at 09:33: {back:?})"
+    );
+}
diff --git a/desktop/aizome/apps/koyomi/tests/repro_koy_03.rs b/desktop/aizome/apps/koyomi/tests/repro_koy_03.rs
new file mode 100644
index 00000000..a32fad06
--- /dev/null
+++ b/desktop/aizome/apps/koyomi/tests/repro_koy_03.rs
@@ -0,0 +1,111 @@
+//! KOY-03: View ▸ Week Numbers and View ▸ First Day of the Week change
+//! the settings in memory only, so they're lost at relaunch; and the
+//! running agent read "Snooze for" once, at start.
+//!
+//! Uses the wrapper's private XDG_CONFIG_HOME/XDG_STATE_HOME (the app
+//! with `persist`), never the real ones.
+
+mod common;
+
+use std::sync::Mutex;
+
+use aizome_kit::testing::Harness;
+use aizome_kit::theme::{Appearance, ThemeChoice};
+use jiff::civil::datetime;
+use jiff::tz::TimeZone;
+use jiff::{SignedDuration, Timestamp};
+use koyomi::agent::{Agent, AgentState, Note, Notifier, Reply};
+use koyomi::app::{Koyomi, Msg, Options};
+use koyomi::settings::{FirstDay, Settings};
+use koyomi::store::Store;
+
+/// The settings file is shared by the tests here.
+static LOCK: Mutex<()> = Mutex::new(());
+
+fn guard_private_home() {
+    let cfg = std::env::var("XDG_CONFIG_HOME").unwrap_or_default();
+    assert!(
+        std::env::var_os("SEKKA_REPRO").is_some() && cfg.starts_with("/tmp/"),
+        "run through the isolation wrapper: this test writes koyomi.toml under XDG_CONFIG_HOME ({cfg})"
+    );
+}
+
+/// Koyomi as people run it, but over `dir` at a fixed time: settings
+/// and state from (and to) their files.
+fn persisted(dir: &std::path::Path) -> Options {
+    let mut o = Options::test(dir, datetime(2026, 10, 17, 14, 20, 0, 0), "Europe/London");
+    o.settings = None;
+    o.state = None;
+    o.persist = true;
+    o
+}
+
+#[test]
+fn repro_koy_03_view_menu_settings_survive_a_relaunch() {
+    let _g = LOCK.lock().unwrap_or_else(|e| e.into_inner());
+    guard_private_home();
+    let _ = std::fs::remove_file(koyomi::settings::settings_path());
+    let dir = common::folder("repro-koy03-a");
+    let mut h = Harness::with(Koyomi::new(persisted(&dir)), Appearance { theme: ThemeChoice::Night, ..Default::default() }, false);
+    let w = h.window();
+    assert!(h.program().settings.week_numbers, "week numbers are on by default");
+    // View ▸ Week Numbers (off), View ▸ First Day of the Week ▸ Sunday.
+    h.send(Msg::WeekNumbers(false));
+    h.send(Msg::FirstDay(FirstDay::Sunday));
+    assert!(!h.program().settings.week_numbers);
+    // Quit (the window's close).
+    h.request_close(w);
+    drop(h);
+    // Relaunch.
+    let k = Koyomi::new(persisted(&dir));
+    assert_eq!(
+        (k.settings.week_numbers, k.settings.first_day),
+        (false, FirstDay::Sunday),
+        "View menu choices should be kept across a relaunch (koyomi.toml exists: {})",
+        koyomi::settings::settings_path().exists()
+    );
+}
+
+#[derive(Default)]
+struct Posted(u32);
+
+impl Notifier for Posted {
+    fn notify(&mut self, _n: &Note, _replaces: u32) -> Option<u32> {
+        self.0 += 1;
+        Some(self.0)
+    }
+}
+
+#[test]
+fn repro_koy_03_a_new_snooze_length_reaches_the_running_agent() {
+    let _g = LOCK.lock().unwrap_or_else(|e| e.into_inner());
+    guard_private_home();
+    let _ = std::fs::remove_file(koyomi::settings::settings_path());
+    Settings { snooze_minutes: 10, ..Settings::default() }.save().unwrap();
+    let dir = common::folder("repro-koy03-b");
+    let tz = TimeZone::get("Europe/London").unwrap();
+    // The agent starts at login, as `run` does: settings read then.
+    let mut agent = Agent::new(Store::open(&dir), tz.clone(), AgentState::default(), &Settings::load());
+
+    // Later, Settings ▸ Snooze for: 30 min, Done.
+    let mut h = Harness::new(Koyomi::new(persisted(&dir)));
+    h.send(Msg::ShowSettings);
+    h.send(Msg::Snooze(30.0));
+    h.send(Msg::SettingsDone);
+    drop(h);
+    assert_eq!(Settings::load().snooze_minutes, 30, "the app saves the new length");
+
+    // The agent's next turns: refresh, due, post; then Snooze is pressed.
+    let at = |h: i8, m: i8| -> Timestamp {
+        datetime(2026, 10, 19, h, m, 0, 0).to_zoned(tz.clone()).unwrap().timestamp()
+    };
+    agent.refresh();
+    let notes = agent.due(at(9, 20), true);
+    assert!(notes.iter().any(|n| n.summary == "Stand-up"), "the stand-up's alert is due: {notes:?}");
+    let mut n = Posted::default();
+    agent.post(notes, &mut n);
+    agent.handle(Reply::Snooze(1), at(9, 21));
+    let back = agent.state.snoozed.first().map(|(s, _)| *s).expect("snoozed");
+    let mins = SignedDuration::from_secs(back - at(9, 21).as_second()).as_mins();
+    assert_eq!(mins, 30, "Snooze should use the length set in Settings (30 min), not the one read at start");
+}
diff --git a/desktop/aizome/apps/koyomi/tests/repro_koy_04.rs b/desktop/aizome/apps/koyomi/tests/repro_koy_04.rs
