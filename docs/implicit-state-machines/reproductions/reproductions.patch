@@ -0,0 +1,312 @@
+//! CPB-25: wlr-screencopy streams.
+//!
+//! (1) A stream is kept per (manager, output, region, cursor), not per
+//! scale, while its damage tracker's scale is fixed when it's made. A
+//! recorder (wf-recorder) capturing a whole output whose scale changes
+//! (same mode) must still get the output as it shows: compared here with
+//! IPC's screenshot of the same moment.
+//! (2) A client that destroys its manager right after asking for a copy
+//! must not leave a stream (a full-output offscreen buffer) behind for as
+//! long as the output exists. Watched as the compositor's anonymous memory
+//! over many such clients.
+
+mod common;
+
+use std::io::Write;
+use std::os::fd::{AsFd, AsRawFd, FromRawFd, OwnedFd};
+use std::os::unix::net::UnixStream;
+use std::time::{Duration, Instant};
+
+use aizome_ipc::{Request, Response};
+use common::*;
+use wayland_client::globals::{GlobalList, GlobalListContents, registry_queue_init};
+use wayland_client::protocol::{wl_buffer, wl_output, wl_registry, wl_shm, wl_shm_pool};
+use wayland_client::{Connection, Dispatch, EventQueue, QueueHandle, WEnum};
+use wayland_protocols_wlr::screencopy::v1::client::{zwlr_screencopy_frame_v1, zwlr_screencopy_manager_v1};
+
+use zwlr_screencopy_frame_v1::ZwlrScreencopyFrameV1 as Frame;
+use zwlr_screencopy_manager_v1::ZwlrScreencopyManagerV1 as Manager;
+
+#[derive(Default)]
+struct Heard {
+    shm: Option<(wl_shm::Format, u32, u32, u32)>,
+    ready: bool,
+    failed: bool,
+}
+
+struct Copier {
+    conn: Connection,
+    globals: GlobalList,
+    queue: EventQueue<Heard>,
+    qh: QueueHandle<Heard>,
+    heard: Heard,
+    shm: wl_shm::WlShm,
+    output: wl_output::WlOutput,
+}
+
+struct Picture {
+    w: u32,
+    h: u32,
+    bgra: Vec<u8>,
+}
+
+impl Picture {
+    fn px(&self, x: i32, y: i32) -> [u8; 3] {
+        let i = ((y as u32 * self.w + x as u32) * 4) as usize;
+        [self.bgra[i + 2], self.bgra[i + 1], self.bgra[i]]
+    }
+}
+
+impl Copier {
+    fn new(c: &Compositor) -> Copier {
+        let conn = Connection::from_socket(UnixStream::connect(c.dir.join(&c.socket)).unwrap()).unwrap();
+        let (globals, mut queue) = registry_queue_init::<Heard>(&conn).unwrap();
+        let qh = queue.handle();
+        let shm = globals.bind(&qh, 1..=1, ()).unwrap();
+        let output = globals.bind(&qh, 1..=4, ()).unwrap();
+        let mut heard = Heard::default();
+        queue.roundtrip(&mut heard).unwrap();
+        Copier { conn, globals, queue, qh, heard, shm, output }
+    }
+
+    fn manager(&self) -> Manager {
+        self.globals.bind(&self.qh, 3..=3, ()).expect("wlr-screencopy 3")
+    }
+
+    fn wait(&mut self, within: Duration, done: impl Fn(&Heard) -> bool) -> bool {
+        let deadline = Instant::now() + within;
+        loop {
+            self.queue.dispatch_pending(&mut self.heard).unwrap();
+            if done(&self.heard) {
+                return true;
+            }
+            let left = deadline.saturating_duration_since(Instant::now());
+            if left.is_zero() {
+                return false;
+            }
+            self.conn.flush().unwrap();
+            if let Some(guard) = self.queue.prepare_read() {
+                let fd = guard.connection_fd();
+                let mut pfd = libc::pollfd { fd: fd.as_raw_fd(), events: libc::POLLIN, revents: 0 };
+                // Safety: one valid pollfd.
+                if unsafe { libc::poll(&mut pfd, 1, left.as_millis().min(100) as i32) } > 0 {
+                    guard.read().unwrap();
+                }
+            }
+        }
+    }
+
+    /// A wl_shm buffer of the output's size (XRGB8888).
+    fn buffer(&self, (w, h): (u32, u32)) -> (wl_shm_pool::WlShmPool, wl_buffer::WlBuffer, std::fs::File) {
+        let len = (w * 4 * h) as usize;
+        // Safety: memfd_create with a static name.
+        let fd = unsafe { OwnedFd::from_raw_fd(libc::memfd_create(c"aizome-copy".as_ptr(), 0)) };
+        let mut file = std::fs::File::from(fd);
+        file.write_all(&vec![0u8; len]).unwrap();
+        let pool = self.shm.create_pool(file.as_fd(), len as i32, &self.qh, ());
+        let buffer = pool.create_buffer(0, w as i32, h as i32, (w * 4) as i32, wl_shm::Format::Xrgb8888, &self.qh, ());
+        (pool, buffer, file)
+    }
+
+    /// A whole-output copy with `manager`, waited for.
+    fn copy(&mut self, manager: &Manager) -> Picture {
+        self.heard = Heard::default();
+        let frame = manager.capture_output(0, &self.output, &self.qh, ());
+        assert!(self.wait(Duration::from_secs(5), |h| h.shm.is_some() || h.failed), "no buffer offer");
+        let (_, w, h, stride) = self.heard.shm.unwrap();
+        assert_eq!(stride, w * 4);
+        let (pool, buffer, file) = self.buffer((w, h));
+        frame.copy(&buffer);
+        assert!(self.wait(Duration::from_secs(5), |h| h.ready || h.failed), "no copy");
+        assert!(!self.heard.failed, "the copy failed");
+        let len = (w * 4 * h) as usize;
+        // Safety: the client's own memfd, `len` bytes.
+        let map =
+            unsafe { libc::mmap(std::ptr::null_mut(), len, libc::PROT_READ, libc::MAP_SHARED, file.as_raw_fd(), 0) };
+        assert_ne!(map, libc::MAP_FAILED);
+        // Safety: mapped above.
+        let bgra = unsafe { std::slice::from_raw_parts(map as *const u8, len) }.to_vec();
+        // Safety: unmapping what we mapped.
+        unsafe { libc::munmap(map, len) };
+        frame.destroy();
+        buffer.destroy();
+        pool.destroy();
+        Picture { w, h, bgra }
+    }
+}
+
+const BLUE: u32 = 0x3366cc;
+
+#[test]
+fn repro_cpb_25_a_recording_follows_a_scale_change() {
+    let c = Compositor::start(Options { outputs: &["1280x800@1"], renderer: Some("pixman"), ..Default::default() });
+    let _client = c.client(Spec::new("org.test.copy", BLUE).size(300, 200));
+    c.wait_window("org.test.copy");
+    c.settle();
+    let mut copier = Copier::new(&c);
+    let manager = copier.manager();
+    let first = copier.copy(&manager);
+    assert_eq!((first.w, first.h), (1280, 800));
+
+    // The output's scale changes; its mode doesn't.
+    c.ok(Request::OutputConfig {
+        name: "HEADLESS-1".into(),
+        mode: None,
+        scale: Some(2.0),
+        position: None,
+        transform: None,
+        enabled: None,
+    });
+    c.settle();
+    c.settle();
+    let w = c.wait_window("org.test.copy").geometry;
+    let shot = c.screenshot();
+    let pic = copier.copy(&manager);
+    assert_eq!((pic.w, pic.h, shot.width, shot.height), (1280, 800, 1280, 800));
+    keep(&shot, "repro_cpb_25_screenshot");
+    keep(
+        &Image {
+            width: pic.w,
+            height: pic.h,
+            rgba: pic.bgra.chunks(4).flat_map(|p| [p[2], p[1], p[0], 255]).collect(),
+        },
+        "repro_cpb_25_screencopy",
+    );
+    // Across the window (in pixels: points × 2), the recording must show
+    // what the screen does.
+    let differ = |pic: &Picture| {
+        let mut differ = Vec::new();
+        for fx in [0.1, 0.3, 0.5, 0.7, 0.9] {
+            for fy in [0.1, 0.5, 0.9] {
+                let x = ((w.x as f64 + w.w as f64 * fx) * 2.0) as i32;
+                let y = ((w.y as f64 + w.h as f64 * fy) * 2.0) as i32;
+                if x >= 1280 || y >= 800 {
+                    continue;
+                }
+                let (a, b) = (shot.px(x, y), pic.px(x, y));
+                if !near(a, b) {
+                    differ.push(((x, y), a, b));
+                }
+            }
+        }
+        differ
+    };
+    // Control: a new manager's stream, made at scale 2, matches the screen.
+    let fresh_manager = copier.manager();
+    let fresh = copier.copy(&fresh_manager);
+    assert!(differ(&fresh).is_empty(), "control: a fresh stream differs too: {:?}", differ(&fresh));
+    let differ = differ(&pic);
+    assert!(
+        differ.is_empty(),
+        "after the scale went 1 → 2, the recording differs from the screen inside the window at {w:?} (screen, \
+         recording): {differ:?}"
+    );
+}
+
+fn anon_kib(pid: u32) -> u64 {
+    let s = std::fs::read_to_string(format!("/proc/{pid}/status")).unwrap();
+    s.lines()
+        .find_map(|l| l.strip_prefix("RssAnon:"))
+        .and_then(|v| v.trim().trim_end_matches("kB").trim().parse().ok())
+        .expect("RssAnon")
+}
+
+#[test]
+fn repro_cpb_25_a_manager_gone_before_its_copy_leaves_no_stream() {
+    let c = Compositor::start(Options { outputs: &["1280x800@1"], renderer: Some("pixman"), ..Default::default() });
+    let pid = match c.request(Request::Version) {
+        Response::Version { pid, .. } => pid,
+        r => panic!("{r:?}"),
+    };
+    let _client = c.client(Spec::new("org.test.copy", BLUE).size(300, 200));
+    c.wait_window("org.test.copy");
+    c.settle();
+    let mut copier = Copier::new(&c);
+    const N: usize = 40;
+    // A full-output stream's offscreen buffer: 1280×800×4 = 4000 KiB.
+    const STREAM_KIB: u64 = 4000;
+
+    // Warm up, then the control: managers destroyed after their copies.
+    for _ in 0..3 {
+        let m = copier.manager();
+        copier.copy(&m);
+        m.destroy();
+    }
+    copier.wait(Duration::from_millis(200), |_| false);
+    let start = anon_kib(pid);
+    for _ in 0..N {
+        let m = copier.manager();
+        copier.copy(&m);
+        m.destroy();
+    }
+    copier.wait(Duration::from_millis(200), |_| false);
+    let control = anon_kib(pid);
+
+    // Now as a one-shot tool that quits at once: frame, copy, manager
+    // destroyed, all in one go.
+    for _ in 0..N {
+        copier.heard = Heard::default();
+        let m = copier.manager();
+        let frame = m.capture_output(0, &copier.output, &copier.qh, ());
+        let (pool, buffer, _file) = copier.buffer((1280, 800));
+        frame.copy(&buffer);
+        m.destroy();
+        assert!(copier.wait(Duration::from_secs(5), |h| h.ready || h.failed), "no copy");
+        frame.destroy();
+        buffer.destroy();
+        pool.destroy();
+    }
+    copier.wait(Duration::from_millis(200), |_| false);
+    let end = anon_kib(pid);
+    let (grew_control, grew) = (control.saturating_sub(start), end.saturating_sub(control));
+    eprintln!(
+        "compositor RssAnon: {start} KiB, {control} KiB after {N} managers destroyed after their copies (+{grew_control}), \
+         {end} KiB after {N} destroyed right after asking (+{grew}; {:.1} full-output buffers' worth)",
+        grew as f64 / STREAM_KIB as f64
+    );
+    assert!(
+        grew < STREAM_KIB * N as u64 / 4,
+        "{N} managers destroyed right after asking for a copy left the compositor {grew} KiB bigger (a stream with \
+         a 4000 KiB offscreen buffer each), against +{grew_control} KiB for {N} destroyed after theirs"
+    );
+}
+
+impl Dispatch<Frame, ()> for Heard {
+    fn event(
+        h: &mut Self,
+        _: &Frame,
+        event: zwlr_screencopy_frame_v1::Event,
+        _: &(),
+        _: &Connection,
+        _: &QueueHandle<Self>,
+    ) {
+        use zwlr_screencopy_frame_v1::Event;
+        match event {
+            Event::Buffer { format: WEnum::Value(f), width, height, stride } => h.shm = Some((f, width, height, stride)),
+            Event::Ready { .. } => h.ready = true,
+            Event::Failed => h.failed = true,
+            _ => {}
+        }
+    }
+}
+
+impl Dispatch<wl_registry::WlRegistry, GlobalListContents> for Heard {
+    fn event(
+        _: &mut Self,
+        _: &wl_registry::WlRegistry,
+        _: wl_registry::Event,
+        _: &GlobalListContents,
+        _: &Connection,
+        _: &QueueHandle<Self>,
+    ) {
+    }
+}
+
+macro_rules! ignore {
+    ($($t:ty),*) => {$(
+        impl Dispatch<$t, ()> for Heard {
+            fn event(_: &mut Self, _: &$t, _: <$t as wayland_client::Proxy>::Event, _: &(), _: &Connection, _: &QueueHandle<Self>) {}
+        }
+    )*};
+}
+ignore!(wl_shm::WlShm, wl_shm_pool::WlShmPool, wl_buffer::WlBuffer, wl_output::WlOutput, Manager);
diff --git a/desktop/aizome/crates/aizome-comp/tests/repro_shb_09.rs b/desktop/aizome/crates/aizome-comp/tests/repro_shb_09.rs
