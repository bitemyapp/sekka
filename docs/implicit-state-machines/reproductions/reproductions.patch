@@ -0,0 +1,116 @@
+#!/usr/bin/env python3
+"""HTT-14 reproduction: in a `--phase throughput` batch, an external compiler
+running during the throughput flood must reject the trial.
+
+Runs the real frame-matrix.py main() (argument checks, calibration copy, trial
+gates, interval selection, compiler_overlap, report status) on fake data. Its
+two process-touching steps are stubbed: preflight() always passes, and
+run_trial() starts no harness; it writes the result.json frame-benchmark.py
+would write (startup, streams, then the throughput flood, in that order) and
+returns activity samples in which an external `rustc` runs only during the
+flood. No workstation lock, terminal, compositor or real /proc sampling is used
+for the decision.
+"""
+import hashlib
+import importlib.util
+import json
+from pathlib import Path
+import shutil
+import sys
+import tempfile
+
+TOOLS = Path(__file__).resolve().parent
+S = 1_000_000_000
+LAUNCH, STARTUP_FRAME, LAST_STREAM_CAPTURE = 10 * S, 11 * S, 20 * S
+FLOOD_START, FLOOD_END, FLOOD_FINAL_CAPTURE = 21 * S, 40 * S, 41 * S
+COMPILER = (25 * S, 35 * S)  # an external rustc, only during the flood
+# --control: the same rustc during the streams instead, which the gate does see.
+if sys.argv[1:] == ["--control"]:
+    COMPILER = (15 * S, 17 * S)
+
+
+def sha(path):
+    return hashlib.sha256(Path(path).read_bytes()).hexdigest()
+
+
+def main():
+    spec = importlib.util.spec_from_file_location("frame_matrix", TOOLS / "frame-matrix.py")
+    matrix = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(matrix)
+    work = Path(tempfile.mkdtemp(prefix="htt14-"))
+    try:
+        fonts, exe, corpus = work / "fonts", work / "app-exe", work / "corpus.txt"
+        fonts.mkdir()
+        exe.write_bytes(b"fake terminal executable")
+        corpus.write_text("throughput corpus\n" * 100)
+        calibration = work / "calibration"
+        apps = {}
+        for kind in ("hotaru", "ghostty"):
+            run = calibration / f"{kind}-run"
+            run.mkdir(parents=True)
+            original = {"binary_sha256": "b" * 64, "fonts": {}, "configuration": f"{kind} config\n"}
+            (run / "result.json").write_text(json.dumps(original))
+            apps[kind] = {"run": f"{kind}-run", "binary": str(exe), "runtime_executable": str(exe),
+                          "runtime_executable_sha256": sha(exe), "window_pixels": [1000, 900]}
+        (calibration / "summary.json").write_text(json.dumps(
+            {"status": "qualified_for_future_matched_measurements", "apps": apps}))
+
+        def preflight(cpus, wait=0):
+            return {"passed": True, "reasons": [], "attempts": 1}
+
+        def run_trial(command, directory, cpus):
+            kind = command[2]
+            run = directory / "run"
+            run.mkdir()
+            result = {
+                "status": "passed", "kind": kind, "purpose": "measurement",
+                "running_executable_sha256": sha(exe), "binary_sha256": "b" * 64, "fonts": {},
+                "configuration": f"{kind} config\n", "physical_geometry_qualified": True,
+                "startup": {"launch_ns": LAUNCH, "qualified": True, "matching_frame": {"ready_ns": STARTUP_FRAME},
+                            "geometry": {"cell_width": 11, "cell_height": 24, "rows": 40}},
+                "streams": [{"kind": "marker", "producer_hz": 30, "last_capture_ns": LAST_STREAM_CAPTURE}],
+                # frame-benchmark.py :599-619, after the streams.
+                "throughput": [{"corpus": str(corpus), "bytes": 1 << 30, "consume_ns": FLOOD_END - FLOOD_START,
+                                "to_final_capture_ns": FLOOD_FINAL_CAPTURE - FLOOD_START,
+                                "before": {"application": {"sample_ns": FLOOD_START}},
+                                "after": {"application": {"sample_ns": FLOOD_FINAL_CAPTURE}}}],
+            }
+            (run / "result.json").write_text(json.dumps(result))
+            samples = []
+            for t in range(9 * S, 43 * S, S):
+                busy = COMPILER[0] <= t <= COMPILER[1]
+                samples.append({"monotonic_ns": t, "compilers":
+                                [{"pid": 4242, "name": "rustc", "origin": "external"}] if busy else []})
+            with (directory / "activity.jsonl").open("w") as stream:
+                for value in samples:
+                    stream.write(json.dumps(value) + "\n")
+            return 0, samples, []
+
+        matrix.preflight = preflight
+        matrix.run_trial = run_trial
+        output = work / "out"
+        sys.argv = ["frame-matrix.py", "--output", str(output), "--calibration", str(calibration),
+                    "--font-dir", str(fonts), "--fallback-dir", str(fonts), "--renderer", "gpu",
+                    "--phase", "throughput", "--corpus", str(corpus), "--rounds", "1",
+                    "--lock", str(work / "shared.lock"),
+                    "--app-cpus", "0", "--compositor-cpus", "1", "--observer-cpus", "2",
+                    "--controller-cpus", "3", "--fixture-cpus", "4"]
+        code = matrix.main()
+        report = json.loads((output / "result.json").read_text())
+        trial = report["trials"][0]
+        print(f"exit code {code}; batch status {report['status']!r}")
+        print(f"first trial ({trial['kind']}): accepted={trial['accepted']} "
+              f"measured=[{trial['measured_start_ns'] / S:.0f} s, {trial['measured_end_ns'] / S:.0f} s] "
+              f"compiler_overlap_samples={trial['compiler_overlap_samples']} reasons={trial['rejection_reasons']}")
+        print(f"flood [{FLOOD_START / S:.0f} s, {FLOOD_FINAL_CAPTURE / S:.0f} s]; external rustc "
+              f"[{COMPILER[0] / S:.0f} s, {COMPILER[1] / S:.0f} s]")
+        assert not trial["accepted"] and "compiler activity overlaps measurement interval" in trial["rejection_reasons"], (
+            "a throughput trial was accepted although an external compiler ran during its throughput flood")
+        assert report["status"] == "stopped_after_rejected_trial", report["status"]
+        print("PASS")
+    finally:
+        shutil.rmtree(work, ignore_errors=True)
+
+
+if __name__ == "__main__":
+    main()
