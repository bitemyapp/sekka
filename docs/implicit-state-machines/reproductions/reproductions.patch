diff --git a/apps/kakehashi/app/src/repro_ktl_02.rs b/apps/kakehashi/app/src/repro_ktl_02.rs
new file mode 100644
index 00000000..78c87790
--- /dev/null
+++ b/apps/kakehashi/app/src/repro_ktl_02.rs
@@ -0,0 +1,79 @@
+//! KTL-02 (window half): download messages are matched to the window's
+//! session by build id only (view.rs:270, view.rs:280).
+//!
+//! Dropping a file onto the window during a download sets `download = None`
+//! without storing the session's cancel flag (view.rs:638), so its worker
+//! keeps downloading. When the same build is started again, the orphan's
+//! progress and its `Fetched` carry the same id as the new session's: the
+//! orphan's progress is shown as the new session's, and its `Fetched` ends
+//! the new session, whose own worker is then never told to stop.
+//!
+//! The drop listener lives inside `render` and needs a GPUI window, and
+//! GPUI's test support is not in Kakehashi's Cargo.lock, so the drop itself
+//! is not driven here; the session state it leaves is.
+
+use super::*;
+
+fn window() -> Kakehashi {
+    let (tx, rx) = mpsc::channel();
+    Kakehashi {
+        tx,
+        rx,
+        builds: Loading::Pending,
+        image: None,
+        download: None,
+        drives: Loading::Pending,
+        listing: false,
+        listed: Instant::now(),
+        show_all: false,
+        chosen: None,
+        job: None,
+        error: None,
+        downloads: std::env::temp_dir(),
+        _poll: Task::ready(()),
+        _appearance: gpui_kit::Subscription::new(|| {}),
+    }
+}
+
+fn build() -> Build {
+    Build {
+        id: "20261104-0123abc".into(),
+        revision: "0123abcdef".into(),
+        uploaded: "2026-11-04T02:51:44Z".into(),
+        iso: "builds/20261104-0123abc/sekka-nightly-20261104-0123abc-x86_64-linux.iso".into(),
+        bytes: 12_157_655_040,
+        sha256: "3".repeat(64),
+    }
+}
+
+#[test]
+fn repro_ktl_02_an_orphaned_workers_messages_do_not_drive_the_restarted_session() {
+    let mut k = window();
+    let build = build();
+    let total = build.bytes;
+
+    // The restarted session, as start_download leaves it (view.rs:410-411),
+    // and its own worker's first report: checking the shared .part.
+    let cancel = Arc::new(AtomicBool::new(false));
+    k.download = Some(Download { build: build.clone(), fetch: None, from: None, cancel: cancel.clone() });
+    k.apply(Msg::Fetch { id: build.id.clone(), fetch: Fetch::Checking { done: 0, total: 4_000_000_000 } });
+
+    // The orphan, still downloading the same build into the same directory,
+    // reports its progress and then ends (here: its own error).
+    k.apply(Msg::Fetch { id: build.id.clone(), fetch: Fetch::Downloading { done: 11_000_000_000, total } });
+    let shown = k.download.as_ref().and_then(|d| d.fetch);
+    k.apply(Msg::Fetched {
+        id: build.id.clone(),
+        result: Err("the download ended at 11000000000 of 12157655040 bytes; try again to resume it".into()),
+    });
+
+    let still_running = k.download.is_some();
+    let told_to_stop = cancel.load(Ordering::Relaxed);
+    assert!(
+        still_running || told_to_stop,
+        "the orphan's Fetched ended the restarted session (download = None, error = {:?}) while that session's \
+         worker was never told to stop (cancel = {told_to_stop}); before that, the window showed the orphan's \
+         progress as the new session's: {shown:?}",
+        k.error
+    );
+}
diff --git a/apps/kakehashi/app/src/repro_ktl_03.rs b/apps/kakehashi/app/src/repro_ktl_03.rs
new file mode 100644
index 00000000..f644a5c4
--- /dev/null
+++ b/apps/kakehashi/app/src/repro_ktl_03.rs
@@ -0,0 +1,151 @@
+//! KTL-03: a helper killed by a signal mid-write is reported as "Not
+//! written" without the "partly written" warning.
+//!
+//! `elevate::run` maps a signal death to `Ran::Failed("the helper was
+//! killed")` (elevate.rs:51), and `Msg::JobEnded` turns every `Ran::Failed`
+//! into `Failed { touched: false }` (view.rs:319), whatever stage the
+//! helper reported last.
+//!
+//! The unit test feeds the window the messages its worker sends. The
+//! ignored test runs the real `start_write` worker and `elevate::run`, but
+//! only inside `repro_ktl_03.sh`, where bwrap replaces
+//! /run/wrappers/bin/pkexec with a fake that appends a Writing line to the
+//! progress file and dies by SIGKILL. The real pkexec and the helper are
+//! never run; no device is opened.
+
+use super::*;
+
+const FAKE_PKEXEC: &str = "KAKEHASHI-REPRO-FAKE-PKEXEC";
+
+fn window() -> Kakehashi {
+    let (tx, rx) = mpsc::channel();
+    Kakehashi {
+        tx,
+        rx,
+        builds: Loading::Pending,
+        image: None,
+        download: None,
+        drives: Loading::Pending,
+        listing: false,
+        listed: Instant::now(),
+        show_all: false,
+        chosen: None,
+        job: None,
+        error: None,
+        downloads: std::env::temp_dir(),
+        _poll: Task::ready(()),
+        _appearance: gpui_kit::Subscription::new(|| {}),
+    }
+}
+
+fn stick(serial: &str) -> Drive {
+    Drive {
+        name: "sdkk".into(),
+        bytes: 32_000_000_000,
+        vendor: "Repro".into(),
+        model: "Stick".into(),
+        serial: serial.into(),
+        bus: "USB".into(),
+        usb_or_removable: true,
+        ..Drive::default()
+    }
+}
+
+fn failure(k: &Kakehashi) -> (String, bool) {
+    match k.job.as_ref().map(|j| &j.stage) {
+        Some(Stage::Running(Progress::Failed { message, touched })) => (message.clone(), *touched),
+        _ => panic!("the job did not end as Failed"),
+    }
+}
+
+#[test]
+fn repro_ktl_03_killed_mid_write_is_reported_as_partly_written() {
+    let mut k = window();
+    // As start_write leaves it (view.rs:529-537).
+    k.job = Some(Job {
+        drive: stick("4C530001230529115034"),
+        image: "sekka.iso".into(),
+        stage: Stage::PreparingImage,
+        phase: None,
+        cancel: PathBuf::from("/nonexistent/progress.cancel"),
+        cancelling: false,
+        ended: false,
+    });
+    for msg in [
+        Msg::Authorizing,
+        Msg::Job(Progress::Preparing),
+        Msg::Job(Progress::Writing { done: 1 << 30, total: 4 << 30 }),
+        // What elevate::run returns when the helper dies by a signal.
+        Msg::JobEnded(Ran::Failed("the helper was killed".into())),
+    ] {
+        k.apply(msg);
+    }
+    let (message, touched) = failure(&k);
+    assert!(
+        touched,
+        "the helper was killed after reporting Writing 1 GiB of 4 GiB, but the window ends with \
+         Failed {{ message: {message:?}, touched: false }}: \"Not written\" and no \"partly written\" warning"
+    );
+}
+
+fn require_fake_pkexec() {
+    // The real setuid wrapper is not readable, and has no marker.
+    let script = fs::read_to_string("/run/wrappers/bin/pkexec").unwrap_or_default();
+    assert!(
+        script.contains(FAKE_PKEXEC),
+        "refusing to start a write: /run/wrappers/bin/pkexec is not the reproduction's fake; run repro_ktl_03.sh"
+    );
+}
+
+fn ready(k: &mut Kakehashi, drive: Drive, dir: &Path) {
+    let path = dir.join("sekka.iso");
+    fs::write(&path, vec![0u8; 4096]).unwrap();
+    k.image = Some(Image {
+        path,
+        bytes: 4096,
+        sha: Some("0".repeat(64)),
+        holds: None,
+        check: Check::Verified { source: "the reproduction".into() },
+        cancel: Arc::new(AtomicBool::new(false)),
+    });
+    k.chosen = Some(drive.name.clone());
+    k.drives = Loading::Ready(vec![drive]);
+}
+
+/// Apply the worker's messages until the job ends; the helper stages seen.
+fn run_to_end(k: &mut Kakehashi) -> Vec<String> {
+    let deadline = Instant::now() + Duration::from_secs(30);
+    let mut seen = Vec::new();
+    loop {
+        let msg = k.rx.recv_timeout(deadline.saturating_duration_since(Instant::now())).expect("the job never ended");
+        match &msg {
+            Msg::Job(progress) => seen.push(format!("{progress:?}")),
+            Msg::JobEnded(ran) => seen.push(format!("JobEnded({ran:?})")),
+            _ => {}
+        }
+        let ended = matches!(msg, Msg::JobEnded(_));
+        k.apply(msg);
+        if ended {
+            return seen;
+        }
+    }
+}
+
+#[test]
+#[ignore = "needs the fake pkexec: run apps/kakehashi/app/repro_ktl_03.sh"]
+fn repro_ktl_03_killed_helper_through_start_write_and_elevate() {
+    require_fake_pkexec();
+    let dir = tempfile::tempdir().unwrap();
+    let mut k = window();
+    ready(&mut k, stick("KTL03-KILLED"), dir.path());
+    k.start_write();
+    assert!(k.job.is_some(), "start_write did not start a job: {:?}", k.error);
+    let seen = run_to_end(&mut k);
+    assert!(seen.iter().any(|s| s.starts_with("Writing")), "the fake helper's Writing line was not read: {seen:?}");
+    let (message, touched) = failure(&k);
+    assert!(
+        touched,
+        "the helper died by SIGKILL after reporting Writing (worker messages: {seen:?}), and the window ends \
+         with Failed {{ message: {message:?}, touched: false }}: no \"partly written\" warning"
+    );
+}
diff --git a/apps/kakehashi/app/src/repro_ktl_04.rs b/apps/kakehashi/app/src/repro_ktl_04.rs
new file mode 100644
index 00000000..80b4c430
--- /dev/null
+++ b/apps/kakehashi/app/src/repro_ktl_04.rs
@@ -0,0 +1,132 @@
+//! KTL-04: "Erase …?" names the drive chosen when the dialog opens
+//! (view.rs:479-490), but OK calls `start_write`, which looks the chosen
+//! drive up again by name (view.rs:511) in a list that keeps refreshing
+//! under the modal (view.rs:208-211). `Msg::Drives` keeps `chosen` while
+//! some drive still has that name (view.rs:233-237). A stick swapped for
+//! another that gets the same name is the one written, and the plan names
+//! the new drive, so the helper's `still_there` passes for it.
+//!
+//! The test runs the real `start_write` worker and `elevate::run` only
+//! inside `repro_ktl_04.sh`, where bwrap replaces /run/wrappers/bin/pkexec
+//! with a fake that copies the plan it is given and exits. The real pkexec
+//! and the helper are never run; no device is opened.
+
+use super::*;
+
+const FAKE_PKEXEC: &str = "KAKEHASHI-REPRO-FAKE-PKEXEC";
+
+fn window() -> Kakehashi {
+    let (tx, rx) = mpsc::channel();
+    Kakehashi {
+        tx,
+        rx,
+        builds: Loading::Pending,
+        image: None,
+        download: None,
+        drives: Loading::Pending,
+        listing: false,
+        listed: Instant::now(),
+        show_all: false,
+        chosen: None,
+        job: None,
+        error: None,
+        downloads: std::env::temp_dir(),
+        _poll: Task::ready(()),
+        _appearance: gpui_kit::Subscription::new(|| {}),
+    }
+}
+
+fn require_fake_pkexec() {
+    // The real setuid wrapper is not readable, and has no marker.
+    let script = fs::read_to_string("/run/wrappers/bin/pkexec").unwrap_or_default();
+    assert!(
+        script.contains(FAKE_PKEXEC),
+        "refusing to start a write: /run/wrappers/bin/pkexec is not the reproduction's fake; run repro_ktl_04.sh"
+    );
+}
+
+fn run_to_end(k: &mut Kakehashi) {
+    let deadline = Instant::now() + Duration::from_secs(30);
+    loop {
+        let msg = k.rx.recv_timeout(deadline.saturating_duration_since(Instant::now())).expect("the job never ended");
+        let ended = matches!(msg, Msg::JobEnded(_));
+        k.apply(msg);
+        if ended {
+            return;
+        }
+    }
+}
+
+#[test]
+#[ignore = "needs the fake pkexec: run apps/kakehashi/app/repro_ktl_04.sh"]
+fn repro_ktl_04_ok_writes_the_drive_the_dialog_named() {
+    require_fake_pkexec();
+    let out = PathBuf::from(std::env::var("KK_REPRO_OUT").expect("KK_REPRO_OUT, set by repro_ktl_04.sh"));
+    let dir = tempfile::tempdir().unwrap();
+    let mut k = window();
+
+    let first = Drive {
+        name: "sdb".into(),
+        bytes: 32_015_679_488,
+        vendor: "SanDisk".into(),
+        model: "Ultra".into(),
+        serial: "4C530001230529115034".into(),
+        bus: "USB".into(),
+        usb_or_removable: true,
+        ..Drive::default()
+    };
+    let image = dir.path().join("sekka.iso");
+    fs::write(&image, vec![0u8; 4096]).unwrap();
+    k.image = Some(Image {
+        path: image,
+        bytes: 4096,
+        sha: Some("0".repeat(64)),
+        holds: None,
+        check: Check::Verified { source: "the reproduction".into() },
+        cancel: Arc::new(AtomicBool::new(false)),
+    });
+    k.drives = Loading::Ready(vec![first.clone()]);
+    k.chosen = Some(first.name.clone());
+
+    // The dialog opens: confirm describes `chosen_drive()` (view.rs:479).
+    let named = k.chosen_drive().cloned().expect("the stick is offered");
+
+    // Under the modal the 2 s refresh goes on: the stick was swapped for
+    // another, which the kernel named sdb as well.
+    let second = Drive {
+        name: "sdb".into(),
+        bytes: 64_023_052_288,
+        vendor: "Kingston".into(),
+        model: "DataTraveler".into(),
+        serial: "E0D55EA574F4F7A0A9580D51".into(),
+        bus: "USB".into(),
+        usb_or_removable: true,
+        ..Drive::default()
+    };
+    k.apply(Msg::Drives(Ok(vec![second.clone()])));
+    let still_chosen = k.chosen.clone();
+
+    // OK in the dialog (view.rs:500-504).
+    k.start_write();
+    let started = k.job.as_ref().map(|j| j.drive.clone());
+    if started.is_some() {
+        run_to_end(&mut k);
+    }
+    let plan: Option<Plan> =
+        fs::read_to_string(out.join("plan.json")).ok().map(|text| serde_json::from_str(&text).unwrap());
+    let erased = plan.as_ref().map(|p| p.drive.clone()).or(started.clone());
+
+    assert!(
+        erased.as_ref().is_none_or(|d| d.same(&named)),
+        "the dialog asked \"Erase {}?\" ({}, {}); after the refresh chosen = {still_chosen:?}, and OK started a \
+         write of {:?} ({:?}), and the helper's plan names {:?} ({:?}), which passes still_there for the new stick: {}",
+        named.label(),
+        named.name,
+        named.serial_hint(),
+        started.as_ref().map(Drive::label),
+        started.as_ref().map(Drive::serial_hint),
+        plan.as_ref().map(|p| p.drive.label()),
+        plan.as_ref().map(|p| p.drive.serial_hint()),
+        plan.as_ref().is_some_and(|p| p.drive.same(&second)),
+    );
+}
