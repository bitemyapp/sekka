index 00000000..b9cd89e6
--- /dev/null
+++ b/installer/genkan/ui/src/repro_gen_33.rs
@@ -0,0 +1,52 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+//! GEN-33 (GUI side): clicking Review while the keyboard step's key wait is
+//! open neither gives the wait up (`start_review` doesn't call
+//! `stop_listening`, and `step` stays `Keyboard` until `Reviewed`) nor stops
+//! a key caught meanwhile from counting: one typed into a prompt the review
+//! raised (a Secret Agent or wallet prompt during the Wi-Fi snapshot)
+//! becomes "the key beside the space bar" and overrides the person's choice.
+//!
+//! Headless, on the preview's keyboard page. The open wait is set directly
+//! (preview mode never starts the compositor wait); the caught key arrives
+//! through the real `Msg::KeyCaught` handler in the same turn as Next, before
+//! the review worker could answer.
+use super::*;
+use aizome_kit::testing::Harness;
+
+const KEY_A: u32 = 30;
+
+#[test]
+fn starting_the_review_gives_up_the_key_wait() {
+    let mut h = Harness::new(Genkan::new(Some("keyboard".into())));
+    assert_eq!(h.program().step, Step::Keyboard);
+    assert!(
+        h.program().zones.is_some(),
+        "no tzdata: set TZDIR, or the review stops at the time zone"
+    );
+    // The wait the keyboard step opens as it is entered (`go` →
+    // `listen_for_key`), as wait number 7.
+    {
+        let app = h.program_mut();
+        app.key_waits.store(7, Ordering::SeqCst);
+        app.key_check = KeyCheck::Waiting;
+    }
+    // The person chooses the swap themselves, then clicks Review; the
+    // compositor delivers the next key (typed elsewhere) to wait 7.
+    h.send(Msg::SwapAltSuper(true));
+    h.send_all([Msg::Next, Msg::KeyCaught(7, Ok(Some((KEY_A, None))))]);
+    let app = h.program();
+    let reviewing = app.reviewing;
+    let step = app.step;
+    let wait = app.key_waits.load(Ordering::SeqCst);
+    let key_check = app.key_check.clone();
+    let super_key = app.super_key;
+    println!(
+        "reviewing={reviewing} step={step:?} key_waits={wait} key_check={key_check:?} super_key={super_key:?}"
+    );
+    assert!(reviewing && step == Step::Keyboard, "precondition: the review is running");
+    assert!(
+        wait != 7 && super_key == SuperKey::SwapAlt,
+        "the review left the compositor's key wait open (key_waits still {wait}) and a key \
+         caught during it replaced the chosen arrangement: super_key {super_key:?}, key_check {key_check:?}"
+    );
+}
diff --git a/installer/genkan/ui/tests/repro_gen_28.rs b/installer/genkan/ui/tests/repro_gen_28.rs
