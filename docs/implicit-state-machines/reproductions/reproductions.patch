new file mode 100644
index 00000000..068e0242
--- /dev/null
+++ b/tests/repro_inx_34.py
@@ -0,0 +1,154 @@
+#!/usr/bin/env python3
+"""INX-34: `sekka-push-cache` must not report success when asking an upstream
+cache which paths it lacks fails part-way.
+
+Runs the exact `text` of nix/push-cache.nix under writeShellApplication's
+shell options, with stub `nix`, `nix-store` and `aws` first on a PATH that
+holds nothing else but coreutils, grep and sed. Nothing is built, signed,
+queried or uploaded: the stubs serve a made-up closure of 32 paths (12 of
+Sekka's own, 20 from Nixpkgs) and log every call. In the failure case
+cache.nixos.org's validity check prints the invalid paths it found among the
+first 10 and then dies with an HTTP 503, as `nix-store --check-validity
+--print-invalid` does when a substituter query throws.
+
+usage: repro_inx_34.py   (from the repository root)
+"""
+import hashlib
+import json
+import os
+from pathlib import Path
+import re
+import shutil
+import subprocess
+import sys
+import tempfile
+import unittest
+
+ROOT = Path(__file__).resolve().parent.parent
+PYTHON = Path(sys.executable).resolve()
+
+
+def script_text():
+    nix = (ROOT / 'nix/push-cache.nix').read_text()
+    body = re.search(r"\n  text = ''\n(.*?)\n  '';\n", nix, re.S).group(1)
+    body = body.replace('${../scripts/ci-retain.py}', str(ROOT / 'scripts/ci-retain.py'))
+    assert '${../' not in body
+    body = body.replace("''${", '${').replace("'''", "''")
+    lines = body.splitlines()
+    indent = min(len(l) - len(l.lstrip()) for l in lines if l.strip())
+    return '\n'.join(l[indent:] for l in lines) + '\n'
+
+
+def store_path(name):
+    digest = hashlib.sha256(name.encode()).hexdigest()
+    alphabet = '0123456789abcdfghijklmnpqrsvwxyz'
+    return '/nix/store/' + ''.join(alphabet[int(c, 16) % 32] for c in digest[:32]) + '-' + name
+
+
+OWN = [store_path(n) for n in ['genkan', 'tatami', 'displays', 'wallpapers', 'yukimi',
+                               'kakehashi', 'uta', 'uta-source', 'aquamarine', 'hyprland',
+                               'tools', 'installed-systems']]
+NIXPKGS = [store_path(f'nixpkgs-dep-{i}') for i in range(20)]
+
+STUB = r'''
+import json, os, pathlib, sys
+state = pathlib.Path(os.environ['STUB_STATE'])
+facts = json.loads((state / 'facts.json').read_text())
+prog = pathlib.Path(sys.argv[0]).name
+args = sys.argv[1:]
+with open(state / 'calls', 'a') as log:
+    log.write(json.dumps([prog] + args) + '\n')
+if prog == 'nix':
+    if args[0] == 'build':
+        print('\n'.join(facts['own']))
+    elif args[0] == 'copy':
+        to = args[args.index('--to') + 1]
+        cache = pathlib.Path(to[len('file://'):].split('?')[0])
+        (cache / 'nar').mkdir(parents=True, exist_ok=True)
+        for path in facts['closure']:
+            h = path[len('/nix/store/'):].split('-')[0]
+            (cache / f'{h}.narinfo').write_text(f'StorePath: {path}\nURL: nar/{h}.nar.zst\n')
+            (cache / 'nar' / f'{h}.nar.zst').write_text(path)
+    elif args[0] == 'path-info':
+        print('\n'.join(facts['closure']))
+    else:
+        sys.exit(1)
+elif prog == 'nix-store':
+    store = args[args.index('--store') + 1]
+    paths = [a for a in args if a.startswith('/nix/store/')]
+    fail_after = facts['fail'].get(store)
+    for i, path in enumerate(paths):
+        if fail_after is not None and i == fail_after:
+            sys.stdout.flush()
+            sys.stderr.write(f"error: unable to download '{store}/xyz.narinfo': HTTP error 503\n")
+            sys.exit(1)
+        if store == 'https://cache.nixos.org' and path in facts['nixpkgs']:
+            continue  # valid there
+        print(path)
+elif prog == 'aws':
+    # Records what would be uploaded; never contacts anything.
+    if 'sync' in args:
+        positional, skip = [], False
+        for a in args[args.index('sync') + 1:]:
+            if skip:
+                skip = False
+            elif a in ('--content-type', '--exclude', '--include'):
+                skip = True
+            elif not a.startswith('--'):
+                positional.append(a)
+        source = pathlib.Path(positional[0])
+        names = sorted(p.name for p in source.iterdir() if p.is_file())
+        with open(state / 'uploads', 'a') as up:
+            up.write(json.dumps([positional[1], names]) + '\n')
+    elif 'cp' in args:
+        sys.stdin.read()
+'''
+
+
+class PushCacheValidityFailure(unittest.TestCase):
+    def publish(self, fail):
+        with tempfile.TemporaryDirectory(prefix='inx34-') as tmp:
+            work = Path(tmp)
+            stubs, state, config = work / 'stubs', work / 'state', work / 'config'
+            for d in [stubs, state, config]:
+                d.mkdir()
+            (config / 'cache.sekka.computer-1.sec').write_text('test-key:not-a-real-key\n')
+            closure = [p for pair in zip(OWN + [None] * 8, NIXPKGS) for p in pair if p]
+            (state / 'facts.json').write_text(json.dumps(
+                {'own': OWN, 'closure': closure, 'nixpkgs': NIXPKGS, 'fail': fail}))
+            for name in ['nix', 'nix-store', 'aws']:
+                (stubs / name).write_text(f'#!{PYTHON}\n' + STUB)
+                (stubs / name).chmod(0o755)
+            tools = sorted({str(Path(shutil.which(t)).resolve().parent)
+                            for t in ['mktemp', 'grep', 'sed']})
+            script = work / 'sekka-push-cache'
+            # writeShellApplication's preamble; runtimeInputs (awscli2, python3)
+            # are the stubs, and nothing of the host is on PATH.
+            script.write_text('set -o errexit\nset -o nounset\nset -o pipefail\n'
+                              f'export PATH="{stubs}:$PATH"\n' + script_text())
+            env = {'PATH': ':'.join(tools), 'HOME': str(work), 'TMPDIR': str(work),
+                   'STUB_STATE': str(state), 'SEKKA_CACHE_CONFIG': str(config),
+                   'AWS_ACCESS_KEY_ID': 'stub', 'SEKKA_CACHE_ENDPOINT': 'http://stub.invalid'}
+            result = subprocess.run([shutil.which('bash'), str(script), '/nonexistent-flake'],
+                                    env=env, text=True, capture_output=True, timeout=60)
+            uploads = [json.loads(l) for l in (state / 'uploads').read_text().splitlines()] \
+                if (state / 'uploads').exists() else []
+            narinfos = [n for dest, names in uploads for n in names if n.endswith('.narinfo')]
+            return result, narinfos
+
+    def test_control_all_caches_answer(self):
+        result, narinfos = self.publish(fail={})
+        self.assertEqual(result.returncode, 0, result.stderr)
+        self.assertIn('Published 12 of 32 paths', result.stdout)
+        self.assertEqual(len(narinfos), 12)
+
+    def test_failed_validity_query_fails_the_publication(self):
+        result, narinfos = self.publish(fail={'https://cache.nixos.org': 10})
+        self.assertNotEqual(
+            result.returncode, 0,
+            f'exited 0 with stdout {result.stdout.strip()!r} after uploading '
+            f'{len(narinfos)} of 12 narinfos; stderr: {result.stderr.strip()!r}')
+
+
+if __name__ == '__main__':
+    unittest.main()
diff --git a/tests/repro_inx_36.py b/tests/repro_inx_36.py
new file mode 100644
index 00000000..bca5277f
--- /dev/null
+++ b/tests/repro_inx_36.py
@@ -0,0 +1,128 @@
+#!/usr/bin/env python3
+"""INX-36: when the job container cannot start, the runner supervisor must
+back off before registering another just-in-time runner with GitHub.
+
+Runs the exact supervisor `text` of nix/runner.nix under
+writeShellApplication's shell options, with its Nix interpolations filled in
+(the repository, labels and uid as the file defines them; the Git cache
+script replaced by a stub) and the token path moved into a temporary
+directory. Stubs come first on PATH: `docker` (no daemon is contacted; `run`
+fails as Docker does when the image is not loaded or a bind source is
+missing, status 125), `curl` (logs the registration request, answers with a
+made-up JIT configuration; nothing reaches api.github.com) and `sleep`
+(records the pause instead of taking it, and ends the run after six
+registrations). jq, timeout, date and coreutils are the real ones.
+
+usage: repro_inx_36.py   (from the repository root)
+"""
+import json
+import os
+from pathlib import Path
+import re
+import shutil
+import subprocess
+import sys
+import tempfile
+import unittest
+
+ROOT = Path(__file__).resolve().parent.parent
+PYTHON = Path(sys.executable).resolve()
+JQ = os.environ.get('JQ') or shutil.which('jq')
+
+
+def supervisor_text(git_cache_stub, token):
+    nix = (ROOT / 'nix/runner.nix').read_text()
+    repository = re.search(r'repository = "([^"]+)";', nix).group(1)
+    labels = re.findall(r'"([^"]+)"', re.search(r'labels = \[(.*?)\];', nix, re.S).group(1))
+    uid = re.search(r'uid = (\d+);', nix).group(1)
+    block = nix[nix.index('supervisor = pkgs.writeShellApplication'):]
+    body = re.search(r"\n    text = ''\n(.*?)\n    '';\n", block, re.S).group(1)
+    body = (body.replace('${pkgs.bash}/bin/bash ${../scripts/runner-git-cache.sh}', str(git_cache_stub))
+                .replace('${repository}', repository)
+                .replace('${builtins.toJSON labels}', json.dumps(labels, separators=(',', ':')))
+                .replace('${toString uid}', uid)
+                .replace('token=/run/secrets/token', f'token={token}'))
+    assert not re.search(r'\$\{(pkgs|\.\./|builtins|toString|repository|lib)', body), body
+    body = body.replace("''${", '${').replace("'''", "''")
+    lines = body.splitlines()
+    indent = min(len(l) - len(l.lstrip()) for l in lines if l.strip())
+    return '\n'.join(l[indent:] for l in lines) + '\n'
+
+
+STUB = r'''
+import json, os, pathlib, sys
+state = pathlib.Path(os.environ['STUB_STATE'])
+prog = pathlib.Path(sys.argv[0]).name
+args = sys.argv[1:]
+def log(event):
+    with open(state / 'events', 'a') as f:
+        f.write(json.dumps(event) + '\n')
+registrations = lambda: sum(1 for l in (state / 'events').read_text().splitlines()
+                            if json.loads(l)[0] == 'register') if (state / 'events').exists() else 0
+if prog == 'docker':
+    if args[0] == 'wait':
+        sys.stderr.write('Error response from daemon: No such container: sekka-runner-job\n')
+        sys.exit(1)
+    if args[0] == 'run':
+        log(['docker run', 125])
+        sys.stderr.write('docker: Error response from daemon: invalid mount config for type '
+                         '"bind": bind source path does not exist: /var/cache/sekka-ci-git.\n')
+        sys.exit(125)
+    sys.exit(1)
+if prog == 'curl':
+    url = args[-1]
+    log(['register', url])
+    print(json.dumps({'runner': {'id': registrations()}, 'encoded_jit_config': f'jit-{registrations()}'}))
+    sys.exit(0)
+if prog == 'sleep':
+    log(['sleep', float(args[0])])
+    if registrations() >= 6:
+        sys.exit(1)  # ends the supervisor (errexit); the trap cleans up
+    sys.exit(0)
+if prog == 'git-cache':
+    log(['git-cache', args])
+    sys.exit(0)
+'''
+
+
+class SupervisorBackoff(unittest.TestCase):
+    def test_container_start_failure_backs_off_before_reregistering(self):
+        with tempfile.TemporaryDirectory(prefix='inx36-') as tmp:
+            work = Path(tmp)
+            stubs, state = work / 'stubs', work / 'state'
+            stubs.mkdir()
+            state.mkdir()
+            token = work / 'token'
+            token.write_text('not-a-real-token\n')
+            for name in ['docker', 'curl', 'sleep', 'git-cache']:
+                (stubs / name).write_text(f'#!{PYTHON}\n' + STUB)
+                (stubs / name).chmod(0o755)
+            tools = sorted({str(Path(shutil.which(t)).resolve().parent)
+                            for t in ['mktemp', 'timeout', 'date']} | {str(Path(JQ).resolve().parent)})
+            script = work / 'sekka-runner-supervisor'
+            script.write_text('set -o errexit\nset -o nounset\nset -o pipefail\n'
+                              f'export PATH="{stubs}:$PATH"\n'
+                              + supervisor_text(stubs / 'git-cache', token))
+            env = {'PATH': ':'.join(tools), 'HOME': str(work), 'TMPDIR': str(work),
+                   'STUB_STATE': str(state)}
+            result = subprocess.run([shutil.which('bash'), str(script)], env=env, text=True,
+                                    capture_output=True, timeout=60)
+            events = [json.loads(l) for l in (state / 'events').read_text().splitlines()]
+        registrations = [i for i, e in enumerate(events) if e[0] == 'register']
+        self.assertGreaterEqual(len(registrations), 2, (result.stdout, result.stderr, events))
+        # Pauses taken between one registration and the next, after a failed start.
+        gaps = []
+        for a, b in zip(registrations, registrations[1:]):
+            between = events[a:b]
+            self.assertIn(['docker run', 125], between)
+            gaps.append(sum(e[1] for e in between if e[0] == 'sleep'))
+        self.assertTrue(all(gap >= 60 for gap in gaps),
+                        f'{len(registrations)} JIT registrations with pauses {gaps} s between them, '
+                        f'each after `docker run` exited 125; supervisor said: '
+                        f'{result.stdout.strip().splitlines()[-3:]}')
+
+
+if __name__ == '__main__':
+    if not JQ:
+        raise SystemExit('jq is required (set JQ=/path/to/jq)')
+    unittest.main()
diff --git a/tests/repro_ttl_03.py b/tests/repro_ttl_03.py
new file mode 100644
index 00000000..3ab73c83
--- /dev/null
+++ b/tests/repro_ttl_03.py
@@ -0,0 +1,103 @@
+#!/usr/bin/env python3
+"""TTL-03: `tatami awake hold` must not give up the Keep Awake inhibitor
+because one logind query failed.
+
+The real helper runs inside a private PID namespace (bwrap), where its parent
+(the namespace's init, PID 1) stands in for systemd-inhibit. A fake busctl
+answers ListInhibitors with that parent's block lock, except for one call that
+fails as `busctl --timeout=3` does when logind is slow. The holder should ride
+out the failed query; at 8e0acbe5 it exits, which in the real unit ends
+systemd-inhibit and releases the lock until Restart=always (1 s) and the
+ExecStartPost verification take it again.
+
+usage: repro_ttl_03.py /path/to/tatami
+"""
+import json
+import os
+from pathlib import Path
+import shutil
+import subprocess
+import sys
+import tempfile
+import time
+import unittest
+
+BIN = Path(sys.argv.pop(1)).resolve()
+PYTHON = Path(sys.executable).resolve()
+BASH = Path(shutil.which('bash')).resolve()
+
+# Counts calls; call number FAIL_AT fails like a busctl timeout.
+BUSCTL = r'''
+import json, os, pathlib, sys
+state = pathlib.Path('/state')
+count = state / 'count'
+n = int(count.read_text()) + 1 if count.exists() else 1
+count.write_text(str(n))
+fail_at = int((state / 'fail_at').read_text())
+with open(state / 'calls', 'a') as f:
+    f.write(json.dumps([n, sys.argv[1:]]) + '\n')
+if 'ListInhibitors' not in sys.argv:
+    sys.exit(1)
+if n == fail_at:
+    sys.stderr.write('Call failed: Connection timed out\n')
+    sys.exit(1)
+row = ['sleep:idle:handle-lid-switch', 'Tatami Keep Awake', 'Keep Awake is enabled',
+       'block', os.geteuid(), 1]
+print(json.dumps({'type': 'a(ssssuu)', 'data': [[row]]}))
+'''
+
+
+class KeepAwakeHolder(unittest.TestCase):
+    def test_one_failed_logind_query_does_not_release_the_inhibitor(self):
+        self.hold(fail_at=4)
+
+    def test_control_holder_stays_while_logind_answers(self):
+        self.hold(fail_at=1000)
+
+    def hold(self, fail_at):
+        with tempfile.TemporaryDirectory(prefix='ttl03-') as tmp:
+            root = Path(tmp)
+            for folder in ['state', 'fake', 'home/alice', 'run/user/1000', 'nix/store', 'bin']:
+                (root / folder).mkdir(parents=True, exist_ok=True)
+            fake = root / 'fake/busctl'
+            fake.write_text(f'#!{PYTHON}\n' + BUSCTL)
+            fake.chmod(0o755)
+            for quiet in ['notify-send', 'systemctl']:
+                (root / 'fake' / quiet).write_text(f'#!{BASH}\nexit 0\n')
+                (root / 'fake' / quiet).chmod(0o755)
+            # First check before readiness, two good polls, then one slow reply.
+            (root / 'state/fail_at').write_text(str(fail_at))
+            command = [
+                'bwrap', '--unshare-all', '--die-with-parent', '--bind', str(root), '/',
+                '--ro-bind', '/nix/store', '/nix/store', '--ro-bind', str(BIN), '/bin/tatami',
+                '--proc', '/proc', '--dev', '/dev', '--clearenv',
+                '--setenv', 'PATH', '/fake:' + os.environ['PATH'],
+                '--setenv', 'HOME', '/home/alice', '--setenv', 'XDG_RUNTIME_DIR', '/run/user/1000',
+                '--chdir', '/', '/bin/tatami', 'awake', 'hold',
+            ]
+            holder = subprocess.Popen(command, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
+                                      text=True)
+            try:
+                # Calls 1-3 succeed (about 2 s), call 4 fails, calls 5+ succeed.
+                deadline = time.monotonic() + 8
+                while time.monotonic() < deadline and holder.poll() is None:
+                    calls = root / 'state/calls'
+                    if calls.exists() and len(calls.read_text().splitlines()) >= 6:
+                        break
+                    time.sleep(0.05)
+                exited = holder.poll()
+                calls = [json.loads(l) for l in (root / 'state/calls').read_text().splitlines()]
+            finally:
+                if holder.poll() is None:
+                    holder.kill()
+                out, err = holder.communicate(timeout=10)
+            self.assertIsNone(
+                exited,
+                f'holder exited (status {exited}) after {len(calls)} ListInhibitors calls, '
+                f'one of which failed: {err.strip()!r}')
+
+
+if __name__ == '__main__':
+    if not shutil.which('bwrap'):
+        raise SystemExit('bubblewrap is required; never run this against the host session')
+    unittest.main()
diff --git a/tests/repro_ttl_04.py b/tests/repro_ttl_04.py
