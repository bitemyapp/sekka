@@ -0,0 +1,83 @@
+//! KIT-17: a click dismisses a tooltip still pending (not only a shown
+//! one), and a pointer leaving with a tooltip pending leaves no
+//! `TimerUse::Tooltip` behind in `Core.timers`.
+
+use std::time::Duration;
+
+use super::Harness;
+use crate::engine::TimerUse;
+use crate::platform::OpenKind;
+use crate::prelude::*;
+
+#[derive(Default)]
+struct Probe {
+    presses: usize,
+}
+
+#[derive(Clone, Debug)]
+enum Msg {
+    Pressed,
+}
+
+impl Program for Probe {
+    type Msg = Msg;
+    fn info(&self) -> AppInfo {
+        AppInfo::new("org.aizome.ReproKit17", "Repro", "Repro")
+    }
+    fn launched(&mut self, cx: &mut Cx<Msg>) {
+        cx.open_window(WindowSpec::new("Tips").size(400.0, 300.0));
+    }
+    fn update(&mut self, msg: Msg, _cx: &mut Cx<Msg>) {
+        match msg {
+            Msg::Pressed => self.presses += 1,
+        }
+    }
+    fn view(&self, _w: WindowKey) -> Element<Msg> {
+        container(
+            button("Swap On").on_press(Msg::Pressed).tooltip("Use it as swap").id("swap").width(120.0).height(30.0),
+        )
+        .padding(16.0)
+        .into()
+    }
+}
+
+fn tooltips(h: &Harness<Probe>) -> usize {
+    h.platform.windows.values().filter(|w| matches!(w.spec.kind, OpenKind::Popup { .. })).count()
+}
+
+fn tooltip_timers(h: &Harness<Probe>) -> usize {
+    h.rt.core.timers.values().filter(|t| matches!(t, TimerUse::Tooltip { .. })).count()
+}
+
+#[test]
+fn repro_kit_17_click_before_the_delay_dismisses_the_pending_tooltip() {
+    let mut h = Harness::new(Probe::default());
+    let w = h.window();
+    let at = h.find_id(w, "swap").unwrap().center();
+    h.move_to(w, at);
+    h.advance(Duration::from_millis(300));
+    h.click(w, at);
+    assert_eq!(h.program().presses, 1, "the button was clicked");
+    h.advance(Duration::from_millis(400));
+    println!("tooltip popups 400 ms after the click: {}", tooltips(&h));
+    assert_eq!(tooltips(&h), 0, "a click dismisses tooltips, pending ones too");
+}
+
+#[test]
+fn repro_kit_17_leaving_with_a_pending_tooltip_leaves_no_timer_entry() {
+    let mut h = Harness::new(Probe::default());
+    let w = h.window();
+    let at = h.find_id(w, "swap").unwrap().center();
+    for _ in 0..5 {
+        h.move_to(w, at);
+        h.advance(Duration::from_millis(100));
+        h.leave(w);
+    }
+    h.advance(Duration::from_secs(2));
+    println!(
+        "platform timers pending: {}, TimerUse::Tooltip entries in Core.timers: {}",
+        h.platform.pending_timers(),
+        tooltip_timers(&h)
+    );
+    assert_eq!(tooltip_timers(&h), 0, "every pointer leave with a pending tooltip leaks a Core.timers entry");
+}
diff --git a/desktop/aizome/crates/aizome-kit/src/repro_uiw_08.rs b/desktop/aizome/crates/aizome-kit/src/repro_uiw_08.rs
new file mode 100644
index 00000000..b6eb1def
--- /dev/null
+++ b/desktop/aizome/crates/aizome-kit/src/repro_uiw_08.rs
@@ -0,0 +1,128 @@
+//! UIW-08: (1) a menu drawn in a window (a torn-off palette) whose items
+//! shrink while a row past the new end is hovered must not panic on the
+//! next pointer move; (2) a submenu closed by ← must not leave the parent
+//! believing it's open: hovering its row opens it again, and the pointer
+//! isn't held back as if aiming at it.
+
+use super::Harness;
+use crate::prelude::*;
+use sidestep_ui::{Key, Modifiers, NamedKey};
+
+struct Palette {
+    window: Option<WindowKey>,
+    items: usize,
+    chosen: Vec<String>,
+}
+
+#[derive(Clone, Debug)]
+enum Msg {
+    Shrink,
+    Open,
+    Chose(String),
+}
+
+impl Program for Palette {
+    type Msg = Msg;
+    fn info(&self) -> AppInfo {
+        AppInfo::new("org.aizome.ReproUiw08", "Repro", "Repro")
+    }
+    fn launched(&mut self, cx: &mut Cx<Msg>) {
+        self.window = Some(cx.open_window(WindowSpec::new("Palette").size(320.0, 600.0)));
+    }
+    fn update(&mut self, msg: Msg, cx: &mut Cx<Msg>) {
+        match msg {
+            Msg::Shrink => self.items = 3,
+            Msg::Chose(s) => self.chosen.push(s),
+            Msg::Open => {
+                let menu = Menu::new("Ctx")
+                    .item(MenuItem::new("Alpha", Msg::Chose("Alpha".into())))
+                    .submenu(
+                        Menu::new("More")
+                            .item(MenuItem::new("One", Msg::Chose("One".into())))
+                            .item(MenuItem::new("Two", Msg::Chose("Two".into()))),
+                    )
+                    .item(MenuItem::new("Omega", Msg::Chose("Omega".into())));
+                cx.show_context_menu(self.window.unwrap(), Point::new(20.0, 20.0), menu);
+            }
+        }
+    }
+    fn view(&self, _w: WindowKey) -> Element<Msg> {
+        let menu = Menu::new("Palette")
+            .items((0..self.items).map(|i| MenuItem::new(format!("Item {i}"), Msg::Chose(format!("Item {i}")))));
+        menu_view(menu).id("palette").into()
+    }
+}
+
+fn harness(items: usize) -> Harness<Palette> {
+    Harness::new(Palette { window: None, items, chosen: Vec::new() })
+}
+
+/// The centre of action row `i` of a menu without a title strip, in the
+/// menu's own coordinates.
+fn row(h: &Harness<Palette>, i: usize) -> Point {
+    let m = h.theme().metrics.menu_row;
+    Point::new(60.0, 1.0 + 4.0 + (i as f64 + 0.5) * m)
+}
+
+fn move_in_popup(h: &mut Harness<Palette>, popup: u32, at: Point) {
+    h.rt.core.pointer_move(popup, at, &mut h.platform);
+    h.rt.flush(&mut h.platform);
+}
+
+#[test]
+fn repro_uiw_08_palette_shrinking_under_a_hovered_row_does_not_panic() {
+    let mut h = harness(10);
+    let w = h.window();
+    let origin = h.find_id(w, "palette").unwrap().origin().to_vec2();
+    h.move_to(w, row(&h, 9) + origin);
+    // The program's menu loses items while row 9 is hovered.
+    h.send(Msg::Shrink);
+    // The next move over the palette: it must not index the old row.
+    h.move_to(w, row(&h, 0) + origin);
+    h.move_to(w, row(&h, 1) + origin);
+    assert!(h.program().chosen.is_empty());
+}
+
+#[test]
+fn repro_uiw_08_submenu_closed_by_left_arrow_reopens_on_hover() {
+    let mut h = harness(1);
+    let w = h.window();
+    h.send(Msg::Open);
+    let p1 = h.popups(w)[0].0;
+    // Keyboard: down to More, → opens it, ← in it closes it again.
+    h.popup_keyboard(p1, Key::Named(NamedKey::ArrowDown), Modifiers::NONE);
+    h.popup_keyboard(p1, Key::Named(NamedKey::ArrowDown), Modifiers::NONE);
+    h.popup_keyboard(p1, Key::Named(NamedKey::ArrowRight), Modifiers::NONE);
+    assert_eq!(h.popups(w).len(), 2, "→ opened the submenu");
+    let p2 = h.popups(w)[1].0;
+    h.popup_keyboard(p2, Key::Named(NamedKey::ArrowLeft), Modifiers::NONE);
+    assert_eq!(h.popups(w).len(), 1, "← closed the submenu");
+    // The pointer comes over More.
+    let at = row(&h, 1);
+    move_in_popup(&mut h, p1, at);
+    let at = row(&h, 1) + Vec2::new(0.0, 2.0);
+    move_in_popup(&mut h, p1, at);
+    println!("popups after hovering More again: {}", h.popups(w).len());
+    assert_eq!(h.popups(w).len(), 2, "hovering a submenu's row opens it");
+}
+
+#[test]
+fn repro_uiw_08_after_left_arrow_rightward_moves_are_not_aiming() {
+    let mut h = harness(1);
+    let w = h.window();
+    h.send(Msg::Open);
+    let p1 = h.popups(w)[0].0;
+    // The pointer opens More by hovering it; ← (in the submenu) closes it.
+    let at = row(&h, 1);
+    move_in_popup(&mut h, p1, at);
+    assert_eq!(h.popups(w).len(), 2, "hovering More opened it");
+    let p2 = h.popups(w)[1].0;
+    h.popup_keyboard(p2, Key::Named(NamedKey::ArrowLeft), Modifiers::NONE);
+    assert_eq!(h.popups(w).len(), 1, "← closed the submenu");
+    // Down and to the right onto Omega, then Return: Omega is chosen.
+    let at = row(&h, 2) + Vec2::new(40.0, 0.0);
+    move_in_popup(&mut h, p1, at);
+    h.popup_keyboard(p1, Key::Named(NamedKey::Enter), Modifiers::NONE);
+    println!("chosen: {:?}, popups: {}", h.program().chosen, h.popups(w).len());
+    assert_eq!(h.program().chosen, ["Omega"], "the row under the pointer is the one Return chooses");
+}
