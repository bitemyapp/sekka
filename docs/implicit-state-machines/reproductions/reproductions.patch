diff --git a/apps/hotaru/crates/hotaru-core/tests/repro_hco_07.rs b/apps/hotaru/crates/hotaru-core/tests/repro_hco_07.rs
new file mode 100644
index 00000000..6e39323e
--- /dev/null
+++ b/apps/hotaru/crates/hotaru-core/tests/repro_hco_07.rs
@@ -0,0 +1,49 @@
+//! HCO-07: a password the user chose to remember for the session must not be
+//! pushed out by paste events' one-time passwords that the program never spent.
+use hotaru_core::kitty_clipboard::{Direction, Request};
+use hotaru_core::{Terminal, TerminalEvent};
+
+fn granted(terminal: &mut Terminal) -> bool {
+    let reads: Vec<bool> = terminal
+        .take_events()
+        .into_iter()
+        .filter_map(|event| match event {
+            TerminalEvent::KittyClipboard(Request::Read(read)) => Some(read.granted),
+            _ => None,
+        })
+        .collect();
+    assert_eq!(reads.len(), 1, "{reads:?}");
+    reads[0]
+}
+
+#[test]
+fn repro_hco_07_unspent_paste_event_passwords_do_not_evict_a_remembered_grant() {
+    let mut terminal = Terminal::new(20, 4, 0);
+    // pw="secret", name="app", reading text/plain.
+    let secret = b"\x1b]5522;type=read:pw=c2VjcmV0:name=YXBw;dGV4dC9wbGFpbg==\x1b\\";
+    terminal.feed(secret);
+    assert!(!granted(&mut terminal), "precondition: asked the first time");
+    // The user answers "Allow for this session" (session.rs KittyGrant).
+    terminal.kitty_clipboard_grant("secret", Direction::Read);
+    terminal.feed(secret);
+    assert!(granted(&mut terminal), "precondition: remembered");
+    // The program turns on paste events; the user pastes 32 times and the
+    // program reads only each event's listing (it never asks for the data).
+    terminal.feed(b"\x1b[?5522h");
+    let available = ["text/plain".to_string()];
+    for paste in 0..32u8 {
+        let random: Vec<u8> = (0..=255u8).map(|b| b.wrapping_add(paste.wrapping_mul(7))).collect();
+        let event = terminal.kitty_paste_event(false, &available, &random).expect("paste event");
+        let event = String::from_utf8(event).unwrap();
+        let pw = event.strip_prefix("\x1b]5522;type=read:status=OK:pw=").unwrap();
+        let pw = &pw[..pw.find('\x1b').unwrap()];
+        // name="Paste event"; listing only (".").
+        terminal.feed(format!("\x1b]5522;type=read:pw={pw}:name=UGFzdGUgZXZlbnQ=;Lg==\x1b\\").as_bytes());
+        assert!(!granted(&mut terminal), "a listing is never a grant");
+    }
+    terminal.feed(secret);
+    assert!(
+        granted(&mut terminal),
+        "the remembered password was evicted by 32 unspent one-time paste-event passwords; the program is asked again"
+    );
+}
