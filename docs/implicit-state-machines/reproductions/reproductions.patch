@@ -0,0 +1,80 @@
+//! STA-12: with Add a Layout's picker open, the shell's keyboard setup
+//! launch (`aizome-settei --pane keyboard.setup --keyboard …`) starts a
+//! key catch the window doesn't show; the key is taken as the setup key,
+//! and the leftover setup sheet later stands in for the command sheet.
+//!
+//! Settei over the sample, whose keyboard's keys come as `SampleKey`, as
+//! the compositor's catch would.
+
+mod common;
+
+use std::sync::Arc;
+
+use aizome_kit::layout::Size;
+use aizome_kit::testing::Harness;
+use settei::panes::keyboard::Msg;
+use settei::{AppMsg, Settei};
+
+fn send(h: &mut Harness<Settei>, m: Msg) {
+    let msg: settei::pane::PaneMsg = Arc::new(m);
+    h.send(AppMsg::Pane("keyboard", msg));
+}
+
+/// A sheet window's own texts (the harness gives its window's first, up to
+/// the status strip's "Sample system").
+fn own(texts: Vec<String>) -> Vec<String> {
+    match texts.iter().position(|t| t == "Sample system") {
+        Some(i) => texts[i + 1..].to_vec(),
+        None => texts,
+    }
+}
+
+fn sheet_texts(h: &Harness<Settei>) -> Vec<String> {
+    own(h.program().sheet_window().map(|s| h.texts(s)).unwrap_or_default())
+}
+
+#[test]
+fn repro_sta_12_a_setup_launch_over_the_layout_picker_takes_no_key_and_leaves_no_sheet() {
+    let (mut h, _) = common::open("repro-sta-12", "keyboard");
+    let w = h.window();
+    h.resize(w, Size::new(940.0, 1180.0));
+    assert!(h.click_text(w, "Add a Layout…"));
+    assert!(sheet_texts(&h).iter().any(|t| t == "Add a Keyboard Layout"), "{:?}", sheet_texts(&h));
+
+    // A keyboard plugged in; the shell's prompt accepted.
+    h.send(AppMsg::Launched(
+        ["--pane", "keyboard.setup", "--keyboard", "Apple Inc. Magic Keyboard (05ac:029c)"]
+            .iter()
+            .map(|a| (*a).to_owned())
+            .collect(),
+    ));
+    let mut wrong = Vec::new();
+    let after_launch: Vec<String> = sheet_texts(&h).into_iter().take(5).collect();
+    let picker_shows = after_launch.iter().any(|t| t == "Add a Keyboard Layout");
+    let setup_shows = after_launch.iter().any(|t| t == "Set Up a Keyboard");
+    // A key typed into the layout search while the sheet shows the picker
+    // (the compositor catches it when a catch is on: here SampleKey).
+    send(&mut h, Msg::SampleKey(56));
+    let after_key: Vec<String> = sheet_texts(&h).into_iter().take(5).collect();
+    if picker_shows && !setup_shows {
+        // The picker is what shows: no key should have been taken for setup.
+        send(&mut h, Msg::PickerCancel);
+        let after_cancel = h.program().sheet_window();
+        // Add a Command… must open the command sheet.
+        send(&mut h, Msg::AddCommand);
+        let command = sheet_texts(&h);
+        if !command.iter().any(|t| t == "A Command on Keys of Its Own") {
+            wrong.push(format!(
+                "Add a Command… shows another sheet (sheet window after Cancel: {after_cancel:?}): {command:?}"
+            ));
+        }
+        if command.iter().any(|t| t == "Swap left Alt and Super" || t.starts_with("Beside the space bar")) {
+            wrong.push(format!("the key typed while the picker showed was taken as the setup key: {command:?}"));
+        }
+    }
+    assert!(
+        wrong.is_empty(),
+        "after the launch the sheet showed {after_launch:?}\nafter the key {after_key:?}\n{}",
+        wrong.join("\n")
+    );
+}
