--- /dev/null
+++ b/desktop/aizome/apps/settei/src/panes/displays/repro_stb_13.rs
@@ -0,0 +1,190 @@
+//! STB-13: quitting (⌘Q) or closing the window during "Keep these display
+//! settings?" leaves the risky change applied in the compositor, never
+//! kept and never reverted.
+//!
+//! The real pane in the real window over the sample compositor (which
+//! keeps what it's told, as Aizome's does: it has no timeout of its own).
+//! Dropping the harness stands for the process ending once the app quits.
+//! Either the app stays (and the countdown goes back) or it goes back on
+//! the way out: what's asserted is that the unkept change doesn't stay.
+
+use std::cell::RefCell;
+use std::rc::Rc;
+use std::sync::Arc;
+
+use aizome_kit::prelude::*;
+use aizome_kit::testing::Harness;
+
+use super::system::{Compositor, SampleOutputs};
+use super::{Displays, Msg};
+use crate::app::{AppMsg, Settei, Start};
+use crate::pane::{Group, Pane, PaneCx, SettingEntry, Tile, ViewCx};
+
+/// The real pane, shared with the test, its messages held while `hold`
+/// says so (a reply still on its way).
+struct Tap<P: Pane> {
+    inner: Rc<RefCell<P>>,
+    hold: Rc<dyn Fn(&P::Msg) -> bool>,
+    held: Rc<RefCell<Vec<P::Msg>>>,
+}
+
+impl<P: Pane> Pane for Tap<P> {
+    type Msg = P::Msg;
+    fn id(&self) -> &'static str {
+        <P as Pane>::id(&self.inner.borrow())
+    }
+    fn title(&self) -> &'static str {
+        <P as Pane>::title(&self.inner.borrow())
+    }
+    fn icon(&self) -> Icon {
+        <P as Pane>::icon(&self.inner.borrow())
+    }
+    fn tile(&self) -> Tile {
+        <P as Pane>::tile(&self.inner.borrow())
+    }
+    fn group(&self) -> Group {
+        <P as Pane>::group(&self.inner.borrow())
+    }
+    fn keywords(&self) -> &'static [&'static str] {
+        <P as Pane>::keywords(&self.inner.borrow())
+    }
+    fn entries(&self) -> Vec<SettingEntry> {
+        <P as Pane>::entries(&self.inner.borrow())
+    }
+    fn update(&mut self, msg: P::Msg, cx: &mut PaneCx<P::Msg>) {
+        if (self.hold)(&msg) {
+            self.held.borrow_mut().push(msg);
+            return;
+        }
+        self.inner.borrow_mut().update(msg, cx);
+    }
+    fn view(&self, vcx: &ViewCx) -> Element<P::Msg> {
+        self.inner.borrow().view(vcx)
+    }
+    fn shown(&mut self, cx: &mut PaneCx<P::Msg>) {
+        self.inner.borrow_mut().shown(cx)
+    }
+    fn hidden(&mut self, cx: &mut PaneCx<P::Msg>) {
+        self.inner.borrow_mut().hidden(cx)
+    }
+    fn focus_entry(&mut self, entry: &str, cx: &mut PaneCx<P::Msg>) {
+        self.inner.borrow_mut().focus_entry(entry, cx)
+    }
+    fn system_changed(&mut self, cx: &mut PaneCx<P::Msg>) {
+        self.inner.borrow_mut().system_changed(cx)
+    }
+    fn settings_changed(&mut self, cx: &mut PaneCx<P::Msg>) {
+        self.inner.borrow_mut().settings_changed(cx)
+    }
+    fn listed(&self, vcx: &ViewCx) -> bool {
+        self.inner.borrow().listed(vcx)
+    }
+    fn toolbar(&self, vcx: &ViewCx) -> Option<Element<P::Msg>> {
+        self.inner.borrow().toolbar(vcx)
+    }
+    fn sheet(&self, vcx: &ViewCx) -> Option<Element<P::Msg>> {
+        self.inner.borrow().sheet(vcx)
+    }
+    fn crumb(&self) -> Option<&'static str> {
+        self.inner.borrow().crumb()
+    }
+    fn back(&mut self, cx: &mut PaneCx<P::Msg>) -> bool {
+        self.inner.borrow_mut().back(cx)
+    }
+}
+
+fn pump(h: &mut Harness<Settei>, until: impl Fn(&Harness<Settei>) -> bool) {
+    for _ in 0..400 {
+        if until(h) {
+            return;
+        }
+        std::thread::sleep(std::time::Duration::from_millis(5));
+        h.send(AppMsg::Nothing);
+    }
+}
+
+fn mode(comp: &std::sync::Mutex<SampleOutputs>, name: &str) -> Option<(i32, i32, i32)> {
+    let s = comp.lock().unwrap();
+    s.on.iter().find(|o| o.name == name).and_then(|o| o.current_mode.as_ref()).map(|m| (m.width, m.height, m.refresh))
+}
+
+/// The pane at the countdown after a resolution change on DP-2, and the
+/// sample compositor.
+fn at_the_countdown(name: &str) -> (Harness<Settei>, Rc<RefCell<Displays>>, Arc<std::sync::Mutex<SampleOutputs>>) {
+    use crate::pane::AnyPane;
+    let displays = Rc::new(RefCell::new(Displays::default()));
+    let tap = Tap { inner: displays.clone(), hold: Rc::new(|_: &Msg| false), held: Rc::new(RefCell::new(Vec::new())) };
+    let mut panes = crate::panes::all();
+    let i = panes.iter().position(|p| AnyPane::id(&**p) == "displays").unwrap();
+    panes[i] = crate::pane::pane(tap);
+    let dir = std::env::temp_dir().join(format!("settei-repro-stb-13-{name}-{}", std::process::id()));
+    let _ = std::fs::remove_dir_all(&dir);
+    std::fs::create_dir_all(&dir).unwrap();
+    let mut h = Harness::new(Settei::new(panes, dir.join("settings.toml"), true, Start::parse("displays")));
+    pump(&mut h, |_| displays.borrow().loaded);
+    let comp = match displays.borrow().comp.clone() {
+        Some(Compositor::Sample(c)) => c,
+        _ => panic!("the sample compositor"),
+    };
+    assert_eq!(mode(&comp, "DP-2"), Some((3840, 2160, 144_000)));
+    h.send(AppMsg::Pane("displays", Arc::new(Msg::Resolution("DP-2".into(), (2560, 1440)))));
+    pump(&mut h, |_| displays.borrow().keep.is_some());
+    assert!(displays.borrow().keep.is_some(), "the countdown");
+    assert_eq!(mode(&comp, "DP-2"), Some((2560, 1440, 144_000)), "applied, to be kept or not");
+    let sheet = h.program().sheet_window().expect("Keep these display settings?");
+    assert!(h.texts(sheet).iter().any(|t| t.contains("Keep these display settings")), "{:?}", h.texts(sheet));
+    (h, displays, comp)
+}
+
+#[test]
+fn repro_stb_13_quitting_during_the_countdown_goes_back() {
+    let (mut h, displays, comp) = at_the_countdown("quit");
+    // ⌘Q (the key goes to the sheet, which has focus; else the window).
+    let sheet = h.program().sheet_window().unwrap();
+    h.command(sheet, 'q');
+    if !h.platform.quit {
+        let w = h.window();
+        h.command(w, 'q');
+    }
+    if !h.platform.quit {
+        // The kit refuses Quit while a sheet shows: the countdown goes on.
+        let still = h.windows().len();
+        h.advance(std::time::Duration::from_secs(16));
+        pump(&mut h, |_| mode(&comp, "DP-2") == Some((3840, 2160, 144_000)));
+        assert_eq!(mode(&comp, "DP-2"), Some((3840, 2160, 144_000)), "the app stayed and the countdown went back");
+        eprintln!("STB-13: ⌘Q refused while the keep sheet shows ({still} windows open); the countdown went back");
+        return;
+    }
+    let left = displays.borrow().keep.as_ref().map(|k| k.left);
+    let requests = comp.lock().unwrap().requests.len();
+    drop(h);
+    assert_eq!(
+        mode(&comp, "DP-2"),
+        Some((3840, 2160, 144_000)),
+        "after quitting with {left:?} s left, DP-2 stays at the unkept resolution ({requests} requests, \
+         none going back)"
+    );
+}
+
+#[test]
+fn repro_stb_13_closing_the_window_during_the_countdown_goes_back() {
+    let (mut h, displays, comp) = at_the_countdown("close");
+    let w = h.window();
+    h.request_close(w);
+    let closed = !h.windows().contains(&w);
+    let left = displays.borrow().keep.as_ref().map(|k| k.left);
+    if !closed {
+        // The sheet keeps the window open: the countdown goes on.
+        h.advance(std::time::Duration::from_secs(16));
+        pump(&mut h, |_| mode(&comp, "DP-2") == Some((3840, 2160, 144_000)));
+        assert_eq!(mode(&comp, "DP-2"), Some((3840, 2160, 144_000)), "the window stayed and the countdown went back");
+        eprintln!("STB-13: the close request was refused while the keep sheet shows (window still open)");
+        return;
+    }
+    drop(h);
+    assert_eq!(
+        mode(&comp, "DP-2"),
+        Some((3840, 2160, 144_000)),
+        "after closing the window with {left:?} s left, DP-2 stays at the unkept resolution"
+    );
+}
