@@ -0,0 +1,53 @@
+//! YUK-19: undoing the Desktops group must also put back the default
+//! desktop Yukimi moved by itself when a desktop was taken out, so Apply
+//! never writes a default desktop the person didn't choose.
+use std::sync::{Arc, Mutex};
+
+use aizome_kit::testing::Harness;
+use aizome_yukimi::app::{Clock, Msg, Page, Runner, Source, Yukimi};
+use aizome_yukimi::ops::{Operation, Run, Step};
+
+fn sample() -> (Harness<Yukimi>, Arc<Mutex<Vec<Operation>>>) {
+    let ran = Arc::new(Mutex::new(Vec::new()));
+    let seen = ran.clone();
+    let model = Arc::new(aizome_yukimi::fixture::model());
+    let runner = Runner::Mock(Arc::new(move |op: &Operation| {
+        seen.lock().unwrap().push(op.clone());
+        let step: Step = Box::new(|| {
+            let mut command = std::process::Command::new("sh");
+            command.args(["-c", "echo '{\"ok\":true}'"]);
+            Ok(Some(Run { command, as_root: false }))
+        });
+        vec![step]
+    }));
+    let mut app = Yukimi::with(Source::Sample(model.clone()), runner, Clock::Fixed(aizome_yukimi::fixture::NOW, 21));
+    app.check = Some(Arc::new(aizome_yukimi::fixture::check(&model)));
+    app.index = Some(Arc::new(aizome_yukimi::fixture::index()));
+    (Harness::new(app), ran)
+}
+
+#[test]
+fn repro_yuk_19_undo_desktops_puts_back_the_moved_default() {
+    let (mut h, ran) = sample();
+    h.send(Msg::Show(Page::Desktops));
+    assert_eq!(h.program().chosen("calamares.defaultDesktop"), ["aizome"], "the sample's default");
+    // Untick Aizome: Yukimi moves the default desktop to Tatami by itself.
+    h.send(Msg::Pick { setting: "calamares.desktops".into(), id: "aizome".into(), on: false });
+    assert_eq!(h.program().chosen("calamares.defaultDesktop"), ["tatami"], "moved as the entry says");
+    // The Desktops group's Undo.
+    h.send(Msg::UndoChoice("calamares.desktops".into()));
+    assert_eq!(h.program().chosen("calamares.desktops"), ["aizome", "tatami", "gnome"], "desktops put back");
+    let changes = h.program().choice_changes();
+    // Apply with whatever is left drafted.
+    h.send(Msg::ApplyChoices);
+    let w = h.window();
+    let confirmed = h.semantics(w).into_iter().filter(|(s, _)| s.label.as_deref() == Some("Apply")).map(|(_, r)| r).next_back();
+    if let Some(r) = confirmed {
+        h.click(w, r.center());
+    }
+    let ran = ran.lock().unwrap().clone();
+    assert!(
+        changes.is_empty() && ran.is_empty(),
+        "after undoing the desktops, still drafted: {changes:?}; Apply ran: {ran:?}"
+    );
+}
diff --git a/desktop/aizome/apps/yukimi/tests/repro_yuk_20.rs b/desktop/aizome/apps/yukimi/tests/repro_yuk_20.rs
