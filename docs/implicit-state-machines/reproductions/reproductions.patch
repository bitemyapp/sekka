diff --git a/installer/genkan/rust/tests/repro_gen_03.rs b/installer/genkan/rust/tests/repro_gen_03.rs
new file mode 100644
index 00000000..3ac2b1b6
--- /dev/null
+++ b/installer/genkan/rust/tests/repro_gen_03.rs
@@ -0,0 +1,143 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+//! GEN-03: the selected disk's revalidation must not fail because an
+//! *unrelated* disk vanished or was re-enumerated between `lsblk` and the
+//! per-disk checks. The same `disk::revalidate` runs after `wipefs`/`parted`
+//! (install.rs:573), where failing aborts a half-written installation.
+//!
+//! No real disk is listed, opened or written. The library is built with
+//! `CALAMARES_TOOL_PATH` naming a directory of fakes (this test writes them),
+//! so `lsblk` is a script printing a fixed inventory. The test re-runs itself
+//! in an unprivileged user+mount namespace (`unshare -Urm`) where `/run` and
+//! `/sys/dev/block` are private tmpfs mounts: the "target" is the node
+//! `/dev/loop0` (only `stat`ed; this user cannot open it) and its sysfs
+//! entry is a fake directory, so discovery accepts it as a 40 GiB disk.
+use std::{fs, os::unix::fs::PermissionsExt, path::Path, process::Command};
+
+const TOOLS: Option<&str> = option_env!("CALAMARES_TOOL_PATH");
+const INNER: &str = "GENKAN_REPRO_INNER";
+
+fn tools() -> &'static str {
+    TOOLS.expect("build with CALAMARES_TOOL_PATH=<fake tool dir> (see the repro command)")
+}
+
+fn script(name: &str, body: &str) {
+    let path = Path::new(tools()).join(name);
+    let new = path.with_extension("new");
+    fs::write(&new, format!("#!/bin/sh\necho \"{name} $*\" >> /run/repro-calls.log\n{body}\n")).unwrap();
+    fs::set_permissions(&new, fs::Permissions::from_mode(0o755)).unwrap();
+    fs::rename(new, path).unwrap();
+}
+
+fn write_tools() {
+    let dir = tools();
+    assert!(
+        dir.starts_with(&*std::env::var("ISOLATE_SCRATCH").expect("run through docs/implicit-state-machines/reproductions/isolate")),
+        "refusing a tool path outside the sandbox: {dir}"
+    );
+    fs::create_dir_all(dir).unwrap();
+    // Builtins only: the helper gives its tools PATH=CALAMARES_TOOL_PATH.
+    script(
+        "lsblk",
+        r#"while IFS= read -r l || [ -n "$l" ]; do printf '%s\n' "$l"; done < /run/repro-lsblk.json"#,
+    );
+}
+
+fn mount(source: &str, target: &str, fstype: &str, flags: libc::c_ulong, data: &str) {
+    let c = |s: &str| std::ffi::CString::new(s).unwrap();
+    let (s, t, f, d) = (c(source), c(target), c(fstype), c(data));
+    let rc = unsafe { libc::mount(s.as_ptr(), t.as_ptr(), f.as_ptr(), flags, d.as_ptr().cast()) };
+    assert_eq!(rc, 0, "mount {target}: {}", std::io::Error::last_os_error());
+}
+
+fn disk_json(path: &str, majmin: &str) -> String {
+    format!(
+        r#"{{"path":"{path}","type":"disk","size":42949672960,"ro":false,"model":"Repro Disk","serial":"REPRO-{majmin}","wwn":null,"maj:min":"{majmin}","mountpoints":[null]}}"#
+    )
+}
+
+fn inventory(disks: &[String]) {
+    fs::write(
+        "/run/repro-lsblk.json",
+        format!(r#"{{"blockdevices":[{}]}}"#, disks.join(",")),
+    )
+    .unwrap();
+}
+
+/// Runs only inside the namespace the outer test makes.
+#[test]
+#[ignore = "run by unrelated_disks_do_not_abort_revalidation inside a user+mount namespace"]
+fn inner() {
+    if std::env::var_os(INNER).is_none() {
+        return;
+    }
+    assert_eq!(unsafe { libc::geteuid() }, 0, "expected namespace root");
+    mount("none", "/run", "tmpfs", 0, "mode=755");
+    mount("none", "/sys/dev/block", "tmpfs", 0, "mode=755");
+    // The target's sysfs entry: a non-virtual device with 512-byte sectors
+    // and no holders.
+    let fake = "/run/fakesys/devices/pci0000:00/0000:00:1f.2/repro";
+    fs::create_dir_all(format!("{fake}/queue")).unwrap();
+    fs::create_dir_all(format!("{fake}/holders")).unwrap();
+    fs::write(format!("{fake}/queue/logical_block_size"), "512\n").unwrap();
+    std::os::unix::fs::symlink(fake, "/sys/dev/block/7:0").unwrap();
+
+    let target = calamares_nixos::disk::Identity {
+        path: "/dev/loop0".into(),
+        major_minor: "7:0".into(),
+        bytes: 40 * 1024u64.pow(3),
+        serial: "REPRO-7:0".into(),
+        wwn: String::new(),
+        model: "Repro Disk".into(),
+    };
+
+    // Control: the target alone revalidates.
+    inventory(&[disk_json("/dev/loop0", "7:0")]);
+    let alone = calamares_nixos::disk::revalidate(&target);
+    println!("control (target only): {alone:?}");
+    assert!(alone.is_ok(), "harness broken: {alone:?}");
+
+    let mut failures = Vec::new();
+    // A: a USB disk lsblk listed was unplugged before discovery stat()ed it.
+    inventory(&[
+        disk_json("/dev/loop0", "7:0"),
+        disk_json("/dev/sdz", "65:144"),
+    ]);
+    let unplugged = calamares_nixos::disk::revalidate(&target);
+    println!("A (unrelated /dev/sdz unplugged after lsblk): {unplugged:?}");
+    if let Err(e) = &unplugged {
+        failures.push(format!("unplugged unrelated disk: {e:#}"));
+    }
+    // B: an unrelated disk was re-enumerated: lsblk's numbers are stale.
+    inventory(&[
+        disk_json("/dev/loop0", "7:0"),
+        disk_json("/dev/loop1", "8:16"),
+    ]);
+    let renumbered = calamares_nixos::disk::revalidate(&target);
+    println!("B (unrelated /dev/loop1 re-enumerated, lsblk said 8:16): {renumbered:?}");
+    if let Err(e) = &renumbered {
+        failures.push(format!("re-enumerated unrelated disk: {e:#}"));
+    }
+    let calls = fs::read_to_string("/run/repro-calls.log").unwrap_or_default();
+    println!("tools run:\n{calls}");
+    assert!(
+        failures.is_empty(),
+        "revalidating the unchanged selected disk failed because of another disk: {failures:#?}"
+    );
+}
+
+#[test]
+fn unrelated_disks_do_not_abort_revalidation() {
+    write_tools();
+    let out = Command::new("unshare")
+        .args(["--user", "--map-root-user", "--mount", "--propagation", "private", "--"])
+        .arg(std::env::current_exe().unwrap())
+        .args(["--exact", "inner", "--ignored", "--nocapture", "--test-threads=1"])
+        .env(INNER, "1")
+        .output()
+        .expect("unshare");
+    let stdout = String::from_utf8_lossy(&out.stdout);
+    let stderr = String::from_utf8_lossy(&out.stderr);
+    println!("{stdout}\n{stderr}");
+    assert!(stdout.contains("running 1 test"), "inner test did not run");
+    assert!(out.status.success(), "inner test failed (see above)");
+}
diff --git a/installer/genkan/rust/tests/repro_gen_07.rs b/installer/genkan/rust/tests/repro_gen_07.rs
