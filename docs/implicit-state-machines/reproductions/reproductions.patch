--- /dev/null
+++ b/desktop/aizome/crates/aizome-kit/tests/repro_kit_13.rs
@@ -0,0 +1,80 @@
+//! KIT-13: a program-started drag (`Cx::start_drag` from the drag source's
+//! press-and-move messages, as Hako does) must leave nothing pressed: the
+//! compositor takes the release, so the next click goes to what's clicked.
+
+use aizome_kit::prelude::*;
+use aizome_kit::sidestep_ui::PointerButton;
+use aizome_kit::testing::Harness;
+
+#[derive(Default)]
+struct Files {
+    window: Option<WindowKey>,
+    started: bool,
+    drag_events: Vec<String>,
+    other_pressed: usize,
+}
+
+#[derive(Clone, Debug)]
+enum Msg {
+    Drag(DragEvent),
+    Other,
+}
+
+impl Program for Files {
+    type Msg = Msg;
+    fn info(&self) -> AppInfo {
+        AppInfo::new("org.aizome.ReproKit13", "Repro", "Repro")
+    }
+    fn launched(&mut self, cx: &mut Cx<Msg>) {
+        self.window = Some(cx.open_window(WindowSpec::new("Files").size(400.0, 200.0)));
+    }
+    fn update(&mut self, msg: Msg, cx: &mut Cx<Msg>) {
+        match msg {
+            Msg::Drag(e) => {
+                self.drag_events.push(format!("{e:?}"));
+                if let DragEvent::Move { start, at, .. } = e
+                    && !self.started
+                    && (at - start).hypot() > 4.0
+                {
+                    self.started = true;
+                    let source = DragSource::new().urls(vec![String::from("file:///tmp/a.txt")]).actions(true, false);
+                    cx.start_drag(self.window.unwrap(), source);
+                }
+            }
+            Msg::Other => self.other_pressed += 1,
+        }
+    }
+    fn view(&self, _w: WindowKey) -> Element<Msg> {
+        row![
+            mouse_area(container(text("Drag me")).padding(30.0)).on_drag(Msg::Drag).id("source"),
+            button("Other").on_press(Msg::Other).id("other"),
+        ]
+        .spacing(40.0)
+        .into()
+    }
+}
+
+#[test]
+fn repro_kit_13_click_after_a_program_started_drag_reaches_the_clicked_button() {
+    let mut h = Harness::new(Files::default());
+    let w = h.window();
+    let src = h.find_id(w, "source").expect("the source").center();
+    let other = h.find_id(w, "other").expect("the button").center();
+    // Press on the source and move: the program starts a native drag.
+    h.press(w, src, PointerButton::Left, 1);
+    h.move_to(w, src + Vec2::new(10.0, 0.0));
+    assert!(h.program().started, "the drag started");
+    let (drag, _) = h.drags()[0];
+    // The compositor carries the drag; the release goes to the drop target,
+    // never to this window. The drag ends (dropped elsewhere).
+    h.leave(w);
+    h.end_drag(drag, DropAction::Copy);
+    let before = h.program().drag_events.len();
+    // Back in the window, the user clicks the other button.
+    h.enter(w, other);
+    h.click(w, other);
+    let after: Vec<String> = h.program().drag_events[before..].to_vec();
+    println!("other pressed: {}, drag events after the drop: {after:?}", h.program().other_pressed);
+    assert!(after.is_empty(), "the finished drag's source must hear nothing more: {after:?}");
+    assert_eq!(h.program().other_pressed, 1, "the click after the drag must press the button clicked");
+}
diff --git a/desktop/aizome/crates/aizome-kit/tests/repro_kit_29.rs b/desktop/aizome/crates/aizome-kit/tests/repro_kit_29.rs
new file mode 100644
index 00000000..811b12c1
--- /dev/null
+++ b/desktop/aizome/crates/aizome-kit/tests/repro_kit_29.rs
@@ -0,0 +1,90 @@
+//! KIT-29: a relayout that compacts the node arena must not leave the
+//! layout outboxes (`local_damage`, `scrolls`) pointing at old indices.
+//! Rows of a virtual list die and are mounted again on every relayout;
+//! once enough have died, `Core::relayout` compacts between layout (which
+//! fills the outboxes) and settle (which reads them).
+
+use aizome_kit::layout::Constraints;
+use aizome_kit::prelude::*;
+use aizome_kit::testing::Harness;
+use aizome_kit::widget::{LayoutCx, Widget};
+
+#[derive(Clone, Copy, PartialEq)]
+enum Page {
+    Editors,
+    Leaves,
+}
+
+struct Notes {
+    page: Page,
+    content: EditorContent,
+}
+
+#[derive(Clone, Debug)]
+enum Msg {}
+
+/// What an editor or canvas does when it diffs its own drawing: it finds
+/// something changed and damages it from its layout.
+struct Leaf;
+impl Widget for Leaf {
+    fn name(&self) -> &'static str {
+        "leaf"
+    }
+    fn layout(&mut self, cx: &mut LayoutCx, bc: Constraints) -> Size {
+        cx.invalidate_rect(Rect::new(0.0, 0.0, 4.0, 1.0));
+        bc.constrain(Size::new(100.0, 2.0))
+    }
+}
+
+impl Program for Notes {
+    type Msg = Msg;
+    fn info(&self) -> AppInfo {
+        AppInfo::new("org.aizome.ReproKit29", "Repro", "Repro")
+    }
+    fn launched(&mut self, cx: &mut Cx<Msg>) {
+        cx.open_window(WindowSpec::new("Notes").size(400.0, 600.0));
+    }
+    fn update(&mut self, _msg: Msg, _cx: &mut Cx<Msg>) {}
+    fn view(&self, _w: WindowKey) -> Element<Msg> {
+        match self.page {
+            // Notes, each an editor of its own, in a virtual list.
+            Page::Editors => {
+                let content = self.content.clone();
+                virtual_list(50, 80.0, move |_| text_editor::<Msg>(&content).wrap(false)).id("view").into()
+            }
+            Page::Leaves => virtual_list(100_000, 2.0, |_| Element::<Msg>::new(Leaf, vec![])).id("view").into(),
+        }
+    }
+}
+
+fn lines() -> String {
+    (0..400).map(|i| format!("line {i} of the note, long enough to show")).collect::<Vec<_>>().join("\n")
+}
+
+#[test]
+fn repro_kit_29_scrolling_an_editor_in_a_virtual_row_survives_compaction() {
+    let mut h = Harness::new(Notes { page: Page::Editors, content: EditorContent::new(&lines()) });
+    let w = h.window();
+    h.focus_window(w, true);
+    h.check_frame(w);
+    let first_row = h.find_id(w, "view").unwrap().origin() + Vec2::new(150.0, 40.0);
+    for step in 0..80 {
+        h.scroll(w, first_row, Vec2::new(0.0, 21.0));
+        let c = h.check_frame(w);
+        assert_eq!(c.differs, 0.0, "step {step}: the frame composed differs from the window drawn whole: {c:?}");
+    }
+}
+
+#[test]
+fn repro_kit_29_layout_damage_of_rows_mounted_in_a_compacting_relayout() {
+    let mut h = Harness::new(Notes { page: Page::Leaves, content: EditorContent::default() });
+    let w = h.window();
+    h.focus_window(w, true);
+    h.check_frame(w);
+    let at = h.find_id(w, "view").unwrap().center();
+    for step in 0..6 {
+        h.scroll(w, at, Vec2::new(0.0, 40.0));
+        let c = h.check_frame(w);
+        assert_eq!(c.differs, 0.0, "step {step}: {c:?}");
+    }
+}
