index 00000000..374292d0
--- /dev/null
+++ b/desktop/aizome/apps/hako/tests/repro_hako_11.rs
@@ -0,0 +1,105 @@
+//! HAKO-11: a folder on screen that's deleted and made again under the
+//! same path (`rm -rf dist && mkdir dist`) must still be watched: changes
+//! inside the new folder must be heard (and show in its column).
+
+mod common;
+
+use std::path::PathBuf;
+use std::sync::mpsc;
+use std::time::{Duration, Instant};
+
+use aizome_kit::testing::Harness;
+use common::*;
+use hako::model::watch::Watcher;
+use hako::ui::browser::Load;
+use hako::ui::{Hako, Msg, Options};
+
+fn sandbox(name: &str) -> Sandbox {
+    let dir = std::env::temp_dir().join(format!("hako-repro-11-{name}-{}", std::process::id()));
+    let _ = std::fs::remove_dir_all(&dir);
+    std::fs::create_dir_all(&dir).unwrap();
+    Sandbox(std::fs::canonicalize(&dir).unwrap())
+}
+
+fn drain(rx: &mpsc::Receiver<PathBuf>, quiet: Duration) -> Vec<PathBuf> {
+    let mut v = Vec::new();
+    while let Ok(p) = rx.recv_timeout(quiet) {
+        v.push(p);
+    }
+    v
+}
+
+/// The watcher itself, as `update_watch` drives it: the same folders
+/// asked for again after the folder was made anew.
+#[test]
+fn the_watcher_hears_a_folder_made_again_under_its_path() {
+    let s = sandbox("unit");
+    let proj = s.dir("proj");
+    let dist = s.dir("proj/dist");
+    let (tx, rx) = mpsc::channel();
+    let w = Watcher::new(move |p| {
+        let _ = tx.send(p);
+    })
+    .unwrap();
+    let dirs = vec![proj.clone(), dist.clone()];
+    w.set(&dirs);
+    std::fs::write(dist.join("before.txt"), "x").unwrap();
+    assert!(drain(&rx, Duration::from_millis(300)).contains(&dist), "heard while it's the first folder");
+    // A build tool cleans it.
+    std::fs::remove_dir_all(&dist).unwrap();
+    std::fs::create_dir(&dist).unwrap();
+    let heard = drain(&rx, Duration::from_millis(300));
+    eprintln!("heard during rm -rf && mkdir: {heard:?}");
+    // The parent's reload shows the same columns, so the same folders.
+    w.set(&dirs);
+    std::fs::write(dist.join("after.txt"), "y").unwrap();
+    let heard = drain(&rx, Duration::from_millis(500));
+    eprintln!("heard after writing into the new dist: {heard:?}; watched {:?}", w.watched());
+    assert!(heard.contains(&dist), "a change inside the new dist was not heard");
+}
+
+/// The same in the window: a column showing dist keeps showing what's in it.
+#[test]
+fn a_column_shows_changes_in_a_folder_made_again() {
+    let s = sandbox("window");
+    let dist = s.dir("home/proj/dist");
+    s.file("home/proj/dist/old.js", "old");
+    let mut opts = Options::sandbox(s.path());
+    opts.home = s.home();
+    opts.watch = true;
+    let mut h = Harness::with(Hako::new(opts), appearance(aizome_kit::theme::ThemeChoice::Night), false);
+    settle(&mut h);
+    let w = h.window();
+    h.send(Msg::GoPath(w, dist.clone()));
+    settle(&mut h);
+    let col = |h: &Harness<Hako>| -> Option<(Load, Vec<String>)> {
+        let b = h.program().browser(w)?;
+        let c = b.columns.iter().find(|c| c.loc.folder() == Some(dist.as_path()))?;
+        Some((c.load.clone(), c.rows.iter().map(|e| e.display.clone()).collect()))
+    };
+    assert_eq!(col(&h).map(|c| c.1), Some(vec!["old.js".to_owned()]));
+    // rm -rf dist && mkdir dist: the column empties (heard through the parent).
+    std::fs::remove_dir_all(&dist).unwrap();
+    std::fs::create_dir(&dist).unwrap();
+    assert!(
+        wait_for(&mut h, |p| {
+            p.browser(w)
+                .and_then(|b| b.columns.iter().find(|c| c.loc.folder() == Some(dist.as_path())))
+                .is_some_and(|c| c.load == Load::Ready && c.rows.is_empty())
+        }),
+        "the column of the new, empty dist: {:?}",
+        col(&h)
+    );
+    settle(&mut h);
+    // The build writes into the new dist.
+    std::fs::write(dist.join("bundle.js"), "new").unwrap();
+    let until = Instant::now() + Duration::from_secs(2);
+    let mut shown = false;
+    while Instant::now() < until && !shown {
+        h.send(Msg::Nop);
+        h.advance(Duration::from_millis(20));
+        std::thread::sleep(Duration::from_millis(10));
+        shown = col(&h).is_some_and(|c| c.1.contains(&"bundle.js".to_owned()));
+    }
+    assert!(shown, "bundle.js, made in the new dist, never showed: column {:?}", col(&h));
+}
diff --git a/desktop/aizome/apps/hako/tests/repro_hako_16.rs b/desktop/aizome/apps/hako/tests/repro_hako_16.rs
