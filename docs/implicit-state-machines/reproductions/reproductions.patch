index 00000000..d8944ded
--- /dev/null
+++ b/installer/genkan/ui/tests/repro_gen_28.rs
@@ -0,0 +1,55 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+//! GEN-28: when reading /proc/meminfo fails, `Msg::Memory(Err)` turns swap
+//! off but leaves `memory` as `None`, the same value as "still reading".
+//! Turning swap back on then shows "Reading installed memory…" on the Disk
+//! page and Next answers "Still reading installed memory; try again in a
+//! moment." for ever: nothing reads it again.
+//!
+//! Headless (`aizome_kit::testing::Harness`) on the preview's sample data, so
+//! no disk, network or helper is touched. The preview fills `memory` from its
+//! sample; the test puts it back to `None`, as it is from launch until the
+//! read answers, then delivers the failed read through the real handler.
+use aizome_kit::testing::Harness;
+use aizome_kit::theme::{Appearance, ThemeChoice};
+use genkan::Step;
+use genkan::app::{Genkan, Msg};
+use std::time::Duration;
+
+fn says(h: &Harness<Genkan>, w: aizome_kit::WindowKey, what: &str) -> bool {
+    h.texts(w).iter().any(|t| t.contains(what))
+}
+
+#[test]
+fn a_failed_memory_read_is_not_reported_as_still_reading() {
+    let appearance = Appearance {
+        theme: ThemeChoice::Night,
+        reduced_motion: true,
+        ..Appearance::default()
+    };
+    let mut h = Harness::with(Genkan::new(Some("disk".into())), appearance, false);
+    let w = h.window();
+    assert_eq!(h.program().step, Step::Disk);
+    // Launch state: the worker's read has not answered yet.
+    h.program_mut().memory = None;
+    h.send(Msg::Memory(Err("/proc/meminfo: Permission denied (os error 13)".into())));
+    assert!(!h.program().swap, "the failure turns swap off");
+    assert!(says(&h, w, "Could not read installed memory"));
+    // The person turns swap back on and waits; no read is ever retried.
+    h.send(Msg::Swap(true));
+    h.advance(Duration::from_secs(60));
+    h.send(Msg::Dismissed);
+    let page_says_reading = says(&h, w, "Reading installed memory");
+    let memory = h.program().memory;
+    h.send(Msg::Next);
+    let step_after_next = h.program().step;
+    let next_says_still_reading = says(&h, w, "Still reading installed memory");
+    println!(
+        "memory={memory:?} swap={} page_says_reading={page_says_reading} step_after_next={step_after_next:?} next_says_still_reading={next_says_still_reading}",
+        h.program().swap
+    );
+    assert!(
+        !page_says_reading && !next_says_still_reading,
+        "after the read failed, the Disk page still says it is reading installed memory \
+         (page: {page_says_reading}, Next: {next_says_still_reading}, step {step_after_next:?}, memory {memory:?})"
+    );
+}
diff --git a/installer/genkan/ui/tests/repro_gen_33.rs b/installer/genkan/ui/tests/repro_gen_33.rs
new file mode 100644
index 00000000..569dc07b
--- /dev/null
+++ b/installer/genkan/ui/tests/repro_gen_33.rs
@@ -0,0 +1,116 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+//! GEN-33 (IPC side): once Genkan gives up a key wait (as `go(Review)` does
+//! after `Reviewed`), its IPC thread notices only at its next 500 ms poll.
+//! Until then the compositor still holds the catch, so the next key typed
+//! anywhere (the first character of the Polkit password) goes to Genkan,
+//! which drops it as stale.
+//!
+//! The real Genkan program, headless, on the preview's keyboard page, talks
+//! to a stand-in compositor on a private socket (`AIZOME_SOCKET` in the
+//! wrapper's private XDG_RUNTIME_DIR) that speaks the CatchKey protocol: it
+//! answers Subscribe and CatchKey, waits for the wait to be given up, then
+//! "types" a key 100 ms later as the compositor would route it while the
+//! catch is still held.
+use aizome_kit::testing::Harness;
+use genkan::app::{Genkan, KeyCheck, Msg};
+use std::io::{BufRead, BufReader, Write};
+use std::os::unix::net::UnixListener;
+use std::time::{Duration, Instant};
+
+#[test]
+fn giving_up_the_wait_releases_the_compositor_catch_before_the_next_key() {
+    let runtime = std::env::var("XDG_RUNTIME_DIR").expect("the wrapper's private XDG_RUNTIME_DIR");
+    assert!(runtime.starts_with(&*std::env::var("ISOLATE_SCRATCH").expect("run through docs/implicit-state-machines/reproductions/isolate")), "not the private runtime dir: {runtime}");
+    let socket = format!("{runtime}/gen33-{}.sock", std::process::id());
+    let _ = std::fs::remove_file(&socket);
+    let listener = UnixListener::bind(&socket).unwrap();
+    // Safety: set before the program or any of its threads start.
+    unsafe { std::env::set_var("AIZOME_SOCKET", &socket) };
+
+    let mut h = Harness::new(Genkan::new(Some("keyboard".into())));
+    h.send(Msg::ListenForKey);
+    assert_eq!(h.program().key_check, KeyCheck::Waiting);
+
+    let (stream, _) = listener.accept().unwrap();
+    stream.set_read_timeout(Some(Duration::from_secs(5))).unwrap();
+    let mut reader = BufReader::new(stream.try_clone().unwrap());
+    let mut writer = stream;
+    let mut line = String::new();
+    reader.read_line(&mut line).unwrap();
+    assert!(line.contains(r#""request":"subscribe""#), "{line}");
+    writer.write_all(b"{\"response\":\"ok\"}\n").unwrap();
+    line.clear();
+    reader.read_line(&mut line).unwrap();
+    assert!(line.contains(r#""request":"catch-key""#) && line.contains("genkan-"), "{line}");
+    let tag = line.split(r#""tag":""#).nth(1).unwrap().split('"').next().unwrap().to_owned();
+    writer.write_all(b"{\"response\":\"ok\"}\n").unwrap();
+    // Let the IPC thread settle into its wait for the key.
+    std::thread::sleep(Duration::from_millis(50));
+
+    // Genkan gives the wait up (the same `stop_listening` that `go(Review)`
+    // runs once the review answers).
+    let gave_up = Instant::now();
+    h.send(Msg::StopListening);
+    assert_eq!(h.program().key_check, KeyCheck::Asking);
+
+    // A released catch arrives as `catch-key` without a tag, or as the
+    // connection closing. The compositor routes the next key, typed 100 ms
+    // later, to this connection only if neither came first.
+    let swallowed = match stream_released_within(&mut reader, Duration::from_millis(100)) {
+        Some((what, at)) => {
+            println!("released ({what}) {} ms after giving up", (at - gave_up).as_millis());
+            false
+        }
+        None => {
+            writer
+                .write_all(format!("{{\"event\":\"key-caught\",\"tag\":\"{tag}\",\"code\":30}}\n").as_bytes())
+                .unwrap();
+            let (what, after) = wait_for_release(&mut reader);
+            println!(
+                "no release within 100 ms of giving up; the key typed then went to Genkan's catch; \
+                 Genkan then {what} {} ms after giving up",
+                (after - gave_up).as_millis()
+            );
+            true
+        }
+    };
+    // What Genkan's window made of it: a stale wait's key is dropped.
+    h.settle(Duration::from_millis(200), |_| false);
+    println!(
+        "after: key_check={:?} super_key={:?} (preview sample: SwapAlt)",
+        h.program().key_check,
+        h.program().super_key
+    );
+    let _ = std::fs::remove_file(&socket);
+    assert!(
+        !swallowed,
+        "the compositor still held Genkan's key catch 100 ms after Genkan gave the wait up: \
+         the next key typed anywhere (a Polkit password's first character) was swallowed"
+    );
+}
+
+/// `Some` if the catch was released within `limit`.
+fn stream_released_within(reader: &mut BufReader<std::os::unix::net::UnixStream>, limit: Duration) -> Option<(String, Instant)> {
+    reader.get_ref().set_read_timeout(Some(limit)).unwrap();
+    let mut line = String::new();
+    let result = match reader.read_line(&mut line) {
+        Ok(0) => Some(("closed the connection".to_owned(), Instant::now())),
+        Ok(_) if line.contains("catch-key") && !line.contains("tag") => {
+            Some(("sent catch-key without a tag".to_owned(), Instant::now()))
+        }
+        Ok(_) => panic!("unexpected request {line}"),
+        Err(e) if matches!(e.kind(), std::io::ErrorKind::WouldBlock | std::io::ErrorKind::TimedOut) => None,
+        Err(e) => panic!("{e}"),
+    };
+    reader.get_ref().set_read_timeout(Some(Duration::from_secs(5))).unwrap();
+    result
+}
+
+fn wait_for_release(reader: &mut BufReader<std::os::unix::net::UnixStream>) -> (String, Instant) {
+    let mut line = String::new();
+    match reader.read_line(&mut line) {
+        Ok(0) => ("closed the connection".into(), Instant::now()),
+        Ok(_) => (format!("sent {}", line.trim()), Instant::now()),
+        Err(e) => (format!("errored ({e})"), Instant::now()),
+    }
+}
