diff --git a/desktop/aizome/apps/hako/src/ui/repro_hako_17.rs b/desktop/aizome/apps/hako/src/ui/repro_hako_17.rs
new file mode 100644
index 00000000..a315dab3
--- /dev/null
+++ b/desktop/aizome/apps/hako/src/ui/repro_hako_17.rs
@@ -0,0 +1,115 @@
+//! HAKO-17: pictures queued for thumbnails and dropped from the queue
+//! because the person left their folder must be made when the person
+//! comes back, not shown as generic icons for the rest of the session.
+//!
+//! Deterministic: the worker cap (two) is held by two thumbnails "in
+//! flight" for another folder (`thumb_running = 2`), so the pictures only
+//! queue; the two then finish (their `Msg::Thumb` delivered by hand),
+//! after the person has left, which prunes the queue as Hako does.
+
+use std::path::{Path, PathBuf};
+use std::time::{Duration, Instant};
+
+use aizome_kit::testing::Harness;
+
+use crate::ui::app::{Hako, Msg, Options};
+use crate::ui::browser::Load;
+
+fn settle(h: &mut Harness<Hako>) {
+    let until = Instant::now() + Duration::from_secs(5);
+    while Instant::now() < until {
+        h.send(Msg::Nop);
+        let loading = h
+            .program()
+            .windows
+            .values()
+            .any(|b| b.columns.iter().any(|c| matches!(c.load, Load::Wanted | Load::Loading(_))));
+        if !loading {
+            h.send(Msg::Nop);
+            return;
+        }
+        h.advance(Duration::from_millis(20));
+        std::thread::sleep(Duration::from_millis(5));
+    }
+}
+
+fn png(path: &Path, w: u32, h: u32) {
+    let px: Vec<u8> = (0..w * h).flat_map(|i| [(i % 251) as u8, 90, 160, 255]).collect();
+    aizome_kit::testing::write_png(path, w, h, &px).unwrap();
+}
+
+#[test]
+fn pictures_left_unmade_are_made_on_coming_back() {
+    let root = std::env::temp_dir().join(format!("hako-repro-17-{}", std::process::id()));
+    let _ = std::fs::remove_dir_all(&root);
+    let pics = root.join("home/pics");
+    std::fs::create_dir_all(&pics).unwrap();
+    std::fs::create_dir_all(root.join("home/other")).unwrap();
+    let all: Vec<PathBuf> = (0..6).map(|i| pics.join(format!("p{i}.png"))).collect();
+    for p in &all {
+        png(p, 48, 32);
+    }
+    let mut h = Harness::new(Hako::new(Options::sandbox(&root)));
+    let w = h.window();
+    settle(&mut h);
+    // Two thumbnails of somewhere else are being made: the cap is reached.
+    h.program_mut().thumb_running = 2;
+    h.send(Msg::GoPath(w, pics.clone()));
+    settle(&mut h);
+    assert_eq!(h.program().thumb_wanted.len(), 6, "the pictures queue");
+    // The person leaves before they're made.
+    h.send(Msg::GoPath(w, root.join("home/other")));
+    settle(&mut h);
+    // The two in flight finish: what's queued and off screen is dropped.
+    h.send(Msg::Thumb(root.join("elsewhere/one.png"), None));
+    h.send(Msg::Thumb(root.join("elsewhere/two.png"), None));
+    assert!(h.program().thumb_wanted.is_empty(), "pruned to what's on screen");
+    // Back to the pictures.
+    h.send(Msg::GoPath(w, pics.clone()));
+    settle(&mut h);
+    let until = Instant::now() + Duration::from_secs(5);
+    while Instant::now() < until && h.program().thumbs_pending() {
+        h.send(Msg::Nop);
+        std::thread::sleep(Duration::from_millis(10));
+    }
+    h.send(Msg::Nop);
+    let missing: Vec<&PathBuf> = all.iter().filter(|p| !h.program().thumbs.images.contains_key(*p)).collect();
+    eprintln!(
+        "on coming back: wanted {}, running {}, asked {}, images {}",
+        h.program().thumb_wanted.len(),
+        h.program().thumb_running,
+        h.program().thumb_asked.len(),
+        h.program().thumbs.images.len()
+    );
+    let _ = std::fs::remove_dir_all(&root);
+    assert!(missing.is_empty(), "{} of 6 pictures never get a thumbnail: {missing:?}", missing.len());
+}
+
+/// Control: the same pictures, with the person staying, all get thumbnails
+/// here (so a missing one above is the pipeline's bookkeeping, not the
+/// pictures or the cache).
+#[test]
+fn control_pictures_shown_get_thumbnails() {
+    let root = std::env::temp_dir().join(format!("hako-repro-17-control-{}", std::process::id()));
+    let _ = std::fs::remove_dir_all(&root);
+    let pics = root.join("home/pics");
+    std::fs::create_dir_all(&pics).unwrap();
+    let all: Vec<PathBuf> = (0..6).map(|i| pics.join(format!("p{i}.png"))).collect();
+    for p in &all {
+        png(p, 48, 32);
+    }
+    let mut h = Harness::new(Hako::new(Options::sandbox(&root)));
+    let w = h.window();
+    settle(&mut h);
+    h.send(Msg::GoPath(w, pics.clone()));
+    settle(&mut h);
+    let until = Instant::now() + Duration::from_secs(5);
+    while Instant::now() < until && h.program().thumbs_pending() {
+        h.send(Msg::Nop);
+        std::thread::sleep(Duration::from_millis(10));
+    }
+    h.send(Msg::Nop);
+    let made = all.iter().filter(|p| h.program().thumbs.images.contains_key(*p)).count();
+    let _ = std::fs::remove_dir_all(&root);
+    assert_eq!(made, 6, "thumbnails are made for these pictures");
+}
diff --git a/desktop/aizome/apps/hako/src/ui/repro_hako_19.rs b/desktop/aizome/apps/hako/src/ui/repro_hako_19.rs
new file mode 100644
index 00000000..08e375a6
--- /dev/null
+++ b/desktop/aizome/apps/hako/src/ui/repro_hako_19.rs
@@ -0,0 +1,143 @@
+//! HAKO-19: a change heard while a column's listing is being read (the
+//! debounce fires before the read lands, as in a big or slow folder) must
+//! not be lost: once the stale read lands, the column must be read again
+//! and show the new file.
+//!
+//! Deterministic orchestration: the sandbox has no watcher; the test
+//! plays it. The column is caught `Loading`; an inotify watch of the
+//! test's own says when Hako's read of the folder has closed it (so the
+//! listing predates the new file); then the file is made, and
+//! `DirChanged` plus the `Reload` its 150 ms timer would send are handled
+//! in one turn, before the read's result (still queued) is.
+
+use std::ffi::CString;
+use std::os::unix::ffi::OsStrExt;
+use std::path::Path;
+use std::time::{Duration, Instant};
+
+use aizome_kit::testing::Harness;
+
+use crate::ui::app::{Hako, Msg, Options};
+use crate::ui::browser::Load;
+
+/// Our own inotify watch on a folder, for when it's closed after reading.
+struct Closes(i32);
+
+impl Closes {
+    fn watch(dir: &Path) -> Closes {
+        let fd = unsafe { libc::inotify_init1(libc::IN_NONBLOCK | libc::IN_CLOEXEC) };
+        assert!(fd >= 0);
+        let c = CString::new(dir.as_os_str().as_bytes()).unwrap();
+        assert!(unsafe { libc::inotify_add_watch(fd, c.as_ptr(), libc::IN_CLOSE_NOWRITE) } >= 0);
+        Closes(fd)
+    }
+
+    /// How many times the folder itself was closed (not its files), from
+    /// what's there to read now.
+    fn take(&self) -> usize {
+        let mut buf = [0u8; 4096];
+        let mut n_closes = 0;
+        loop {
+            let n = unsafe { libc::read(self.0, buf.as_mut_ptr().cast(), buf.len()) };
+            if n <= 0 {
+                return n_closes;
+            }
+            let mut i = 0usize;
+            let header = std::mem::size_of::<libc::inotify_event>();
+            while i + header <= n as usize {
+                let ev: libc::inotify_event = unsafe { std::ptr::read_unaligned(buf[i..].as_ptr().cast()) };
+                if ev.len == 0 && ev.mask & libc::IN_CLOSE_NOWRITE != 0 {
+                    n_closes += 1;
+                }
+                i += header + ev.len as usize;
+            }
+        }
+    }
+
+    fn wait(&self, timeout: Duration) -> bool {
+        let until = Instant::now() + timeout;
+        while Instant::now() < until {
+            let mut p = libc::pollfd { fd: self.0, events: libc::POLLIN, revents: 0 };
+            unsafe { libc::poll(&mut p, 1, 50) };
+            if self.take() > 0 {
+                return true;
+            }
+        }
+        false
+    }
+}
+
+impl Drop for Closes {
+    fn drop(&mut self) {
+        unsafe { libc::close(self.0) };
+    }
+}
+
+fn settle(h: &mut Harness<Hako>) {
+    let until = Instant::now() + Duration::from_secs(5);
+    while Instant::now() < until {
+        h.send(Msg::Nop);
+        let loading = h
+            .program()
+            .windows
+            .values()
+            .any(|b| b.columns.iter().any(|c| matches!(c.load, Load::Wanted | Load::Loading(_))));
+        if !loading {
+            h.send(Msg::Nop);
+            return;
+        }
+        h.advance(Duration::from_millis(20));
+        std::thread::sleep(Duration::from_millis(5));
+    }
+}
+
+#[test]
+fn a_change_heard_while_reading_is_not_lost() {
+    let root = std::env::temp_dir().join(format!("hako-repro-19-{}", std::process::id()));
+    let _ = std::fs::remove_dir_all(&root);
+    let d = root.join("home/d");
+    std::fs::create_dir_all(&d).unwrap();
+    for i in 0..200 {
+        std::fs::write(d.join(format!("f{i:03}.txt")), "x").unwrap();
+    }
+    let mut h = Harness::new(Hako::new(Options::sandbox(&root)));
+    let w = h.window();
+    settle(&mut h);
+    let closes = Closes::watch(&d);
+    let d_load = |h: &Harness<Hako>| h.program().windows[&w].columns.get(1).map(|c| c.load.clone());
+    // Show d, until its column is caught while its read is out.
+    let mut caught = false;
+    let mut attempts = 0;
+    for i in 0..50 {
+        attempts = i;
+        h.send(Msg::GoPath(w, d.clone()));
+        if matches!(d_load(&h), Some(Load::Loading(_))) {
+            caught = true;
+            break;
+        }
+        settle(&mut h);
+        std::thread::sleep(Duration::from_millis(20));
+        closes.take();
+    }
+    assert!(caught, "the column was caught loading");
+    eprintln!("caught d loading after {} GoPath attempt(s)", attempts + 1);
+    // The read has gone through the folder: its listing has no new.txt.
+    assert!(closes.wait(Duration::from_secs(5)), "Hako's read of d closed it");
+    std::fs::write(d.join("new.txt"), "new").unwrap();
+    // The watcher hears it; the debounce fires before the read lands.
+    let g = h.program().generation + 1;
+    h.send_all([Msg::DirChanged(d.clone()), Msg::Reload(d.clone(), g)]);
+    assert!(!h.program().reloads.contains_key(&d), "the Reload was the debounce's");
+    settle(&mut h);
+    // Give every later timer and read time to land.
+    for _ in 0..25 {
+        h.send(Msg::Nop);
+        h.advance(Duration::from_millis(20));
+        std::thread::sleep(Duration::from_millis(10));
+    }
+    let c = &h.program().windows[&w].columns[1];
+    let shows = c.rows.iter().any(|e| e.display == "new.txt");
+    eprintln!("column d: {:?}, {} rows, new.txt shown: {shows}", c.load, c.rows.len());
+    let _ = std::fs::remove_dir_all(&root);
+    assert!(shows, "new.txt, made while d was being read, never shows (until the next change)");
+}
