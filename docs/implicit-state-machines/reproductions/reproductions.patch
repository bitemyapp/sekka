index 00000000..d1753053
--- /dev/null
+++ b/desktop/aizome/crates/aizome-shell/tests/repro_sha_02.rs
@@ -0,0 +1,182 @@
+//! SHA-02: a shell that loses `org.freedesktop.Notifications` to a daemon
+//! that is not a replacement shell (dunst or mako started by hand, any
+//! client asking for the name with ReplaceExisting) sets `retiring` for
+//! good and keeps running: it never saves what it carries again, and it
+//! never asks for the name back.
+//!
+//! The bus is a private `dbus-daemon`; the carried state goes to a file of
+//! the test's own (`AIZOME_SHELL_STATE`).
+
+use std::io::{BufRead, BufReader};
+use std::process::{Child, Command, Stdio};
+use std::sync::Mutex;
+use std::sync::mpsc;
+use std::time::Duration;
+
+use aizome_kit::testing::Harness;
+use aizome_shell::deskbar::DeskbarMsg;
+use aizome_shell::notifications::server::{NoteEvent, NoteServer};
+use aizome_shell::shell::{Msg, Options, Shell};
+use zbus::fdo::{RequestNameFlags, RequestNameReply};
+
+const NAME: &str = "org.freedesktop.Notifications";
+
+/// The tests share the process's environment (the bus address).
+static SERIAL: Mutex<()> = Mutex::new(());
+
+struct PrivateBus {
+    child: Child,
+    address: String,
+    dir: std::path::PathBuf,
+}
+
+impl PrivateBus {
+    fn start(tag: &str) -> PrivateBus {
+        let dir = std::env::temp_dir().join(format!("repro-sha-02-{tag}-{}", std::process::id()));
+        std::fs::create_dir_all(&dir).unwrap();
+        let config = dir.join("bus.conf");
+        std::fs::write(
+            &config,
+            format!(
+                r#"<!DOCTYPE busconfig PUBLIC "-//freedesktop//DTD D-Bus Bus Configuration 1.0//EN"
+ "http://www.freedesktop.org/standards/dbus/1.0/busconfig.dtd">
+<busconfig>
+  <type>session</type>
+  <listen>unix:dir={}</listen>
+  <auth>EXTERNAL</auth>
+  <policy context="default">
+    <allow send_destination="*" eavesdrop="true"/>
+    <allow eavesdrop="true"/>
+    <allow own="*"/>
+  </policy>
+</busconfig>
+"#,
+                dir.display()
+            ),
+        )
+        .unwrap();
+        let mut child = Command::new("dbus-daemon")
+            .arg(format!("--config-file={}", config.display()))
+            .args(["--print-address", "--nofork"])
+            .stdout(Stdio::piped())
+            .stderr(Stdio::null())
+            .spawn()
+            .expect("dbus-daemon");
+        let mut line = String::new();
+        BufReader::new(child.stdout.take().unwrap()).read_line(&mut line).unwrap();
+        PrivateBus { child, address: line.trim().to_owned(), dir }
+    }
+
+    fn connect(&self) -> zbus::blocking::Connection {
+        zbus::blocking::connection::Builder::address(self.address.as_str()).unwrap().build().unwrap()
+    }
+}
+
+impl Drop for PrivateBus {
+    fn drop(&mut self) {
+        let _ = self.child.kill();
+        let _ = self.child.wait();
+        let _ = std::fs::remove_dir_all(&self.dir);
+    }
+}
+
+/// The shell's notifications server on `bus`, holding the name; what it
+/// says comes on the receiver.
+fn note_server(bus: &PrivateBus) -> (NoteServer, mpsc::Receiver<NoteEvent>) {
+    // Safety: the tests hold SERIAL; nothing else reads the variable now.
+    unsafe { std::env::set_var("DBUS_SESSION_BUS_ADDRESS", &bus.address) };
+    let (tx, rx) = mpsc::channel();
+    let tx = Mutex::new(tx);
+    let server = NoteServer::start(1, move |e| {
+        let _ = tx.lock().unwrap().send(e);
+    })
+    .expect("the notifications server on the private bus");
+    let first = rx.recv_timeout(Duration::from_secs(5)).expect("an event");
+    assert_eq!(first, NoteEvent::NameAcquired);
+    (server, rx)
+}
+
+/// A notification daemon started by hand: it takes the name, replacing.
+fn stray_daemon(bus: &PrivateBus) -> zbus::blocking::Connection {
+    let conn = bus.connect();
+    let proxy = zbus::blocking::fdo::DBusProxy::new(&conn).unwrap();
+    let reply = proxy
+        .request_name(
+            zbus::names::WellKnownName::from_static_str_unchecked(NAME),
+            RequestNameFlags::ReplaceExisting | RequestNameFlags::DoNotQueue,
+        )
+        .unwrap();
+    assert_eq!(reply, RequestNameReply::PrimaryOwner, "the shell allows replacement");
+    conn
+}
+
+fn live_shell() -> Harness<Shell> {
+    let mut h = Harness::new(Shell::new(Options::default()));
+    let s = h.program_mut();
+    // Saving the carried state is live-only; nothing else this test sends
+    // reaches the session.
+    s.opts.live = true;
+    s.carry_ready = true;
+    h
+}
+
+fn saved_folds() -> Vec<(String, bool)> {
+    aizome_shell::carry::load().map(|c| c.folded).unwrap_or_default()
+}
+
+#[test]
+fn after_a_stray_daemon_takes_the_name_the_shell_still_saves_what_it_carries() {
+    let _serial = SERIAL.lock().unwrap_or_else(|e| e.into_inner());
+    let bus = PrivateBus::start("save");
+    let state = bus.dir.join("state.json");
+    // Safety: as above.
+    unsafe { std::env::set_var("AIZOME_SHELL_STATE", &state) };
+    let (_server, events) = note_server(&bus);
+
+    let mut h = live_shell();
+    h.send(Msg::Deskbar(DeskbarMsg::Fold("org.example.Mail".into())));
+    assert!(saved_folds().contains(&("org.example.Mail".into(), true)), "saving works: {:?}", saved_folds());
+
+    // dunst, started by hand, takes the name. The server says so, as it
+    // would for a replacement shell.
+    let _dunst = stray_daemon(&bus);
+    let lost = events.recv_timeout(Duration::from_secs(5)).expect("NameLost");
+    assert_eq!(lost, NoteEvent::NameLost);
+    h.send(Msg::Note(lost));
+
+    // No replacement shell exists, and nothing stops this one: it goes on
+    // showing the Deskbar and its notifications, and the person folds
+    // another app.
+    h.send(Msg::Deskbar(DeskbarMsg::Fold("org.example.Editor".into())));
+    let live: Vec<(String, bool)> = {
+        let mut f: Vec<_> = h.program().folded.iter().map(|(k, v)| (k.clone(), *v)).collect();
+        f.sort();
+        f
+    };
+    eprintln!("retiring = {}, live folds = {live:?}, saved folds = {:?}", h.program().retiring, saved_folds());
+    // A crash or reload now restores what the file holds.
+    assert!(
+        saved_folds().contains(&("org.example.Editor".into(), true)),
+        "the state file must follow the running shell after a stray daemon took the name: \
+         live {live:?}, saved {:?}, retiring {}",
+        saved_folds(),
+        h.program().retiring
+    );
+}
+
+#[test]
+fn a_shell_that_lost_the_name_to_a_stray_daemon_gets_it_back_when_that_daemon_quits() {
+    let _serial = SERIAL.lock().unwrap_or_else(|e| e.into_inner());
+    let bus = PrivateBus::start("name");
+    let (_server, events) = note_server(&bus);
+    let dunst = stray_daemon(&bus);
+    assert_eq!(events.recv_timeout(Duration::from_secs(5)).unwrap(), NoteEvent::NameLost);
+    // The person quits dunst again.
+    drop(dunst);
+    let back = events.recv_timeout(Duration::from_secs(3));
+    let observer = bus.connect();
+    let proxy = zbus::blocking::fdo::DBusProxy::new(&observer).unwrap();
+    let owner = proxy.get_name_owner(zbus::names::BusName::try_from(NAME).unwrap());
+    eprintln!("after the stray daemon quit: event {back:?}, owner {owner:?}");
+    assert_eq!(back, Ok(NoteEvent::NameAcquired), "the shell's server must hold the notifications name again");
+}
diff --git a/desktop/aizome/crates/aizome-shell/tests/repro_sha_03.rs b/desktop/aizome/crates/aizome-shell/tests/repro_sha_03.rs
new file mode 100644
index 00000000..1bfd52eb
--- /dev/null
+++ b/desktop/aizome/crates/aizome-shell/tests/repro_sha_03.rs
@@ -0,0 +1,60 @@
+//! SHA-03: an auto-hide Deskbar the compositor closes while the pointer is
+//! over it (its display went) keeps `inside = true`; it opens again on the
+//! display left, with no hide armed, and every hide timer is refused, so
+//! it stays revealed although the pointer never came to the new surface.
+//!
+//! The compositor's order is `aizome-comp-core/src/outputs.rs` `detach`:
+//! each layer surface on the output is sent `closed`, then the output is
+//! taken away. A pointer leave for the old surface can't follow: the kit
+//! drops events for windows it closed (`Runtime::pointer_presence`).
+
+mod common;
+
+use std::time::Duration;
+
+use aizome_kit::prelude::*;
+use aizome_shell::actions::Action;
+use aizome_shell::shell::Msg;
+use common::*;
+
+fn monitor() -> aizome_kit::Output {
+    let mut o = output();
+    o.id = 2;
+    o.name = "DP-1".into();
+    o.connector = Some("DP-1".into());
+    o.frame = Rect::new(W, 0.0, W + 2560.0, 1440.0);
+    o
+}
+
+#[test]
+fn an_auto_hide_deskbar_closed_under_the_pointer_hides_once_reopened_elsewhere() {
+    let mut h = scene(false);
+    h.set_outputs(vec![output(), monitor()]);
+    h.program_mut().deskbar_cfg.auto_hide = true;
+    h.send(Msg::Run(Action::SetDeskbarCollapsed(false)));
+    let db = window_titled(&h, "Deskbar");
+    h.enter(db, Point::new(60.0, 20.0));
+    h.advance(Duration::from_secs(1));
+    assert_eq!(h.program().deskbar, Some(db), "the pointer is over it");
+
+    // The laptop's display goes (lid shut, cable out): the compositor
+    // closes every layer surface on it, then takes the output away.
+    let laptop = h.program().screens.iter().find(|s| s.output.id == 1).cloned().unwrap();
+    for k in [Some(db), laptop.bar, laptop.desktop].into_iter().flatten() {
+        h.request_close(k);
+    }
+    h.set_outputs(vec![monitor()]);
+    let again = h.program().deskbar.expect("the Deskbar opens again on the display left");
+    assert_ne!(again, db);
+    assert!(h.program().deskbar_visible());
+
+    // The pointer is on the monitor now and never enters the new surface.
+    h.advance(Duration::from_secs(2));
+    assert!(
+        h.program().deskbar.is_none(),
+        "the reopened auto-hide Deskbar must hide when the pointer isn't over it; \
+         still revealed after 2 s (visible: {}, pending timers: {})",
+        h.program().deskbar_visible(),
+        h.platform.pending_timers()
+    );
+}
diff --git a/desktop/aizome/crates/aizome-shell/tests/repro_sha_12.rs b/desktop/aizome/crates/aizome-shell/tests/repro_sha_12.rs
