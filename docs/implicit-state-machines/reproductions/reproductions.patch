index 00000000..b0b7b76e
--- /dev/null
+++ b/installer/genkan/rust/tests/repro_gen_07.rs
@@ -0,0 +1,279 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+//! GEN-07: on the deferred route (downloads larger than live memory) the
+//! "selected system needs at least N GiB on the root filesystem" guard
+//! (install.rs:479-488) never runs, so `install::prepare` accepts a selection
+//! whose downloads alone exceed the target's root filesystem. Execution then
+//! erases the disk and fails with "No space left" while building on it.
+//!
+//! Drives the real `install::prepare` with fakes only. The library is built
+//! with `CALAMARES_TOOL_PATH` naming a directory of fake tools (written here):
+//! `findmnt` says root is tmpfs and /iso is iso9660, `lsblk` lists one disk,
+//! the formatter/modprobe checks succeed, `nixos-generate-config` prints an
+//! empty module and `nix build --dry-run` reports a 300 GiB unpacked
+//! download. There is no wipefs, parted, mkfs or nix-copy stand-in at all,
+//! so nothing destructive could run even if reached.
+//!
+//! `prepare` insists on euid 0, a root-owned settings path, `/run` and a
+//! live-looking root, so the test re-runs itself in an unprivileged
+//! user+mount namespace (`unshare -Urm`) and chroots into a tmpfs root with
+//! `/proc`, `/sys`, `/dev`, `/nix`, `/tmp`, `/bin`, `/usr` bind-mounted, a
+//! private `/run`, a two-line `/etc`, and a fake `/sys/dev/block/7:0` for the
+//! listed disk `/dev/loop0` (only `stat`ed; this user cannot open it).
+use std::{
+    fs,
+    os::unix::fs::PermissionsExt,
+    path::Path,
+    process::Command,
+};
+
+const TOOLS: Option<&str> = option_env!("CALAMARES_TOOL_PATH");
+const INNER: &str = "GENKAN_REPRO_INNER";
+const GIB: u64 = 1024 * 1024 * 1024;
+
+fn tools() -> &'static str {
+    TOOLS.expect("build with CALAMARES_TOOL_PATH=<fake tool dir> (see the repro command)")
+}
+
+fn script(name: &str, body: &str) {
+    let path = Path::new(tools()).join(name);
+    let new = path.with_extension("new");
+    fs::write(&new, format!("#!/bin/sh\necho \"{name} $*\" >> /run/repro-calls.log\n{body}\n")).unwrap();
+    fs::set_permissions(&new, fs::Permissions::from_mode(0o755)).unwrap();
+    fs::rename(new, path).unwrap();
+}
+
+const DRV: &str = "/nix/store/00000000000000000000000000000000-nixos-system-repro.drv";
+const OUT: &str = "/nix/store/11111111111111111111111111111111-nixos-system-repro";
+
+fn write_tools() {
+    let dir = tools();
+    assert!(
+        dir.starts_with(&*std::env::var("ISOLATE_SCRATCH").expect("run through docs/implicit-state-machines/reproductions/isolate")),
+        "refusing a tool path outside the sandbox: {dir}"
+    );
+    fs::create_dir_all(dir).unwrap();
+    // Builtins only: the helper gives its tools PATH=CALAMARES_TOOL_PATH.
+    script(
+        "lsblk",
+        r#"while IFS= read -r l || [ -n "$l" ]; do printf '%s\n' "$l"; done < /run/repro-lsblk.json"#,
+    );
+    script(
+        "findmnt",
+        r#"for a in "$@"; do last=$a; done
+case "$last" in
+  /) echo tmpfs ;;
+  /iso) echo iso9660 ;;
+  *) exit 1 ;;
+esac"#,
+    );
+    for ok in ["mkfs.ext4", "mkfs.btrfs", "mkfs.xfs", "mkfs.fat", "modprobe", "mkswap"] {
+        script(ok, "exit 0");
+    }
+    script("nixos-generate-config", "echo '{ ... }: { }'");
+    script(
+        "nix",
+        &format!(
+            r#"case "$1 $2" in
+  "build --dry-run")
+    printf '%s\n' '[{{"drvPath":"{DRV}","outputs":{{"out":"{OUT}"}}}}]'
+    echo 'these 4 derivations will be built:' >&2
+    echo 'these 1500 paths will be fetched (60.00 GiB download, 300.00 GiB unpacked):' >&2
+    ;;
+  *) echo "fake nix: unexpected $*" >&2; exit 1 ;;
+esac"#
+        ),
+    );
+}
+
+fn c(s: &str) -> std::ffi::CString {
+    std::ffi::CString::new(s).unwrap()
+}
+
+fn mount(source: &str, target: &str, fstype: Option<&str>, flags: libc::c_ulong, data: &str) {
+    let (s, t, d) = (c(source), c(target), c(data));
+    let f = fstype.map(c);
+    let rc = unsafe {
+        libc::mount(
+            s.as_ptr(),
+            t.as_ptr(),
+            f.as_ref().map_or(std::ptr::null(), |f| f.as_ptr()),
+            flags,
+            d.as_ptr().cast(),
+        )
+    };
+    assert_eq!(rc, 0, "mount {target}: {}", std::io::Error::last_os_error());
+}
+
+/// A root-owned (namespace root) tmpfs root, so `read_trusted` sees every
+/// ancestor of the settings paths owned by uid 0.
+fn enter_fake_root() {
+    let root = format!("{}/root-{}", std::env::var("ISOLATE_SCRATCH").unwrap(), std::process::id());
+    fs::create_dir_all(&root).unwrap();
+    mount("none", &root, Some("tmpfs"), 0, "mode=755");
+    // Only the fake tool directory from /tmp: the tools' interpreter is
+    // /bin/sh, which lives in /nix/store.
+    for dir in ["/proc", "/sys", "/dev", "/nix", "/bin", "/usr", tools()] {
+        let target = format!("{root}{dir}");
+        fs::create_dir_all(&target).unwrap();
+        mount(dir, &target, None, libc::MS_BIND | libc::MS_REC, "");
+    }
+    fs::create_dir(format!("{root}/run")).unwrap();
+    mount("none", &format!("{root}/run"), Some("tmpfs"), 0, "mode=755");
+    mount("none", &format!("{root}/sys/dev/block"), Some("tmpfs"), 0, "mode=755");
+    fs::create_dir(format!("{root}/etc")).unwrap();
+    fs::write(format!("{root}/etc/os-release"), "NAME=NixOS\nID=nixos\n").unwrap();
+    fs::write(format!("{root}/etc/passwd"), "root:x:0:0::/root:/bin/sh\n").unwrap();
+    let r = c(&root);
+    assert_eq!(unsafe { libc::chroot(r.as_ptr()) }, 0, "chroot: {}", std::io::Error::last_os_error());
+    std::env::set_current_dir("/").unwrap();
+}
+
+const LOCK: &str = r#"{"version":7,"root":"root","nodes":{
+  "root":{"inputs":{"sekka":"sekka","nixpkgs":["sekka","nixpkgs"],"determinate":["sekka","determinate"],
+    "fh":["sekka","fh"],"applications":["sekka","applications"],"ai-apps":["sekka","ai-apps"],"omp":["sekka","omp"]}},
+  "sekka":{"locked":{"narHash":"sha256-s"},"inputs":{"nixpkgs":"n","determinate":"d","fh":"f",
+    "applications":"a","ai-apps":"i","omp":"o"}},
+  "n":{"locked":{"narHash":"sha256-n"}},"d":{"locked":{"narHash":"sha256-d"}},
+  "f":{"locked":{"narHash":"sha256-f"}},"a":{"locked":{"narHash":"sha256-a"}},
+  "i":{"locked":{"narHash":"sha256-i"}},"o":{"locked":{"narHash":"sha256-o"}}}}"#;
+
+/// Runs only inside the namespace the outer test makes.
+#[test]
+#[ignore = "run by deferred_route_still_checks_root_space inside a user+mount namespace"]
+fn inner() {
+    if std::env::var_os(INNER).is_none() {
+        return;
+    }
+    assert_eq!(unsafe { libc::geteuid() }, 0, "expected namespace root");
+    unsafe { libc::umask(0o022) };
+    enter_fake_root();
+
+    // The listed disk's sysfs entry: non-virtual, 512-byte sectors, no holders.
+    let fake = "/run/fakesys/devices/pci0000:00/0000:00:1f.2/repro";
+    fs::create_dir_all(format!("{fake}/queue")).unwrap();
+    fs::create_dir_all(format!("{fake}/holders")).unwrap();
+    fs::write(format!("{fake}/queue/logical_block_size"), "512\n").unwrap();
+    std::os::unix::fs::symlink(fake, "/sys/dev/block/7:0").unwrap();
+    fs::write(
+        "/run/repro-lsblk.json",
+        r#"{"blockdevices":[{"path":"/dev/loop0","type":"disk","size":42949672960,"ro":false,"model":"Repro Disk","serial":"REPRO","wwn":null,"maj:min":"7:0","mountpoints":[null]}]}"#,
+    )
+    .unwrap();
+    // Root-owned settings: the flake template and tzdata.
+    fs::create_dir_all("/run/genkan-template").unwrap();
+    fs::write("/run/genkan-template/flake.nix.in", "{ hostname = @HOSTNAME@; }\n").unwrap();
+    fs::write("/run/genkan-template/flake.lock", LOCK).unwrap();
+    fs::create_dir_all("/run/zoneinfo/Etc").unwrap();
+    fs::write("/run/zoneinfo/Etc/UTC", "TZif").unwrap();
+
+    use calamares_nixos::*;
+    let settings = Settings {
+        template_dir: "/run/genkan-template".into(),
+        zoneinfo: "/run/zoneinfo".into(),
+        state_version: "26.05".into(),
+        kernel: Kernel::Lts,
+        test_diagnostics: false,
+    };
+    let disk_bytes = 40 * GIB;
+    let request = RawRequest {
+        disk: disk::Identity {
+            path: "/dev/loop0".into(),
+            major_minor: "7:0".into(),
+            bytes: disk_bytes,
+            serial: "REPRO".into(),
+            wwn: String::new(),
+            model: "Repro Disk".into(),
+        },
+        firmware: Firmware::current(),
+        filesystem: Filesystem::Ext4,
+        encrypt: false,
+        encryption_password: String::new(),
+        hostname: "repro".into(),
+        username: "reprouser".into(),
+        full_name: "Repro User".into(),
+        password: "long-enough-test-password".into(),
+        locale: "en_US.UTF-8".into(),
+        timezone: "Etc/UTC".into(),
+        keyboard: "us".into(),
+        super_key: Default::default(),
+        desktops: vec![Desktop::Plasma],
+        default_desktop: Desktop::Plasma,
+        applications: applications::default_selection(),
+        copy_wifi: false,
+        wifi_profiles: vec![],
+        allow_unfree: false,
+        swap: false,
+        tuning: true,
+        graphics: Default::default(),
+        github_user: String::new(),
+        ssh_keys: vec![],
+        ssh_server: false,
+        git_name: String::new(),
+        git_email: String::new(),
+        confirmation: String::new(),
+    };
+    let plan = request.parse(&settings).expect("plan");
+    let ram = memory::read().unwrap();
+    println!(
+        "live RAM {:.1} GiB total, {:.1} GiB available; target disk {} GiB",
+        ram.total as f64 / GIB as f64,
+        ram.available as f64 / GIB as f64,
+        disk_bytes / GIB
+    );
+    let result = install::prepare(&plan);
+    let calls = fs::read_to_string("/run/repro-calls.log").unwrap_or_default();
+    println!("tools run:\n{calls}");
+    match &result {
+        Ok(prepared) => {
+            let s = prepared.summary();
+            println!(
+                "prepare: Ok(Prepared {{ deferred: {}, closure_bytes: {}, downloaded_bytes: {}, root_bytes: {:.1} GiB }})",
+                s.deferred,
+                s.closure_bytes,
+                s.downloaded_bytes,
+                s.root_bytes as f64 / GIB as f64
+            );
+            assert!(s.deferred, "harness: expected the deferred route");
+        }
+        Err(e) => println!("prepare: Err({e:#})"),
+    }
+    let error = result.err().map(|e| format!("{e:#}"));
+    assert!(
+        error.as_deref().is_some_and(|e| e.contains("root filesystem")),
+        "preparation accepted a selection with 300 GiB of unpacked downloads for a {:.1} GiB root filesystem (deferred route); expected a refusal before erasure, got {error:?}",
+        disk::Layout::for_install(disk_bytes, Firmware::current(), None, false).unwrap().root_bytes() as f64 / GIB as f64,
+    );
+}
+
+#[test]
+fn deferred_route_still_checks_root_space() {
+    write_tools();
+    let out = Command::new("unshare")
+        .args(["--user", "--map-root-user", "--mount", "--propagation", "private", "--"])
+        .arg(std::env::current_exe().unwrap())
+        .args(["--exact", "inner", "--ignored", "--nocapture", "--test-threads=1"])
+        .env(INNER, "1")
+        .output()
+        .expect("unshare");
+    let stdout = String::from_utf8_lossy(&out.stdout);
+    let stderr = String::from_utf8_lossy(&out.stderr);
+    println!("{stdout}\n{stderr}");
+    // The namespace's mounts are gone with it; remove the empty mount points.
+    for entry in fs::read_dir(std::env::var("ISOLATE_SCRATCH").unwrap()).unwrap().flatten() {
+        if entry.file_name().to_string_lossy().starts_with("root-") {
+            let _ = remove_empty_tree(&entry.path());
+        }
+    }
+    assert!(stdout.contains("running 1 test"), "inner test did not run");
+    assert!(out.status.success(), "inner test failed (see above)");
+}
+
+/// Removes directories only, never files: the tree holds empty mount points.
+fn remove_empty_tree(dir: &Path) -> std::io::Result<()> {
+    for entry in fs::read_dir(dir)?.flatten() {
+        if entry.file_type()?.is_dir() {
+            remove_empty_tree(&entry.path())?;
+        }
+    }
+    fs::remove_dir(dir)
+}
