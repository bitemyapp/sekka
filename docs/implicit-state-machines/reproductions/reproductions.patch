index 00000000..dab432c9
--- /dev/null
+++ b/desktop/aizome/crates/aizome-comp/tests/repro_cpb_24.rs
@@ -0,0 +1,180 @@
+//! CPB-24: wlr-output-management apply. A configuration of two heads
+//! whose second change fails (under udev: "has no mode WxH", a CRTC
+//! refusing the mode) must leave the first head as it was when the client
+//! hears `failed`: the core applies changes one by one and reverts none.
+//!
+//! The attempt here, on the headless backend: kanshi's profile of two
+//! heads, the first a scale change, the second a mode its head doesn't
+//! list. The headless backend makes any mode it's given (`add_mode`), and
+//! every other way a change can fail is checked before anything applies,
+//! so the second change can't fail here: the test then only reports what
+//! happened. It asserts the protocol's rule for when it does fail.
+
+mod common;
+
+use std::collections::HashMap;
+use std::os::unix::net::UnixStream;
+use std::time::{Duration, Instant};
+
+use aizome_ipc::{Request, Response};
+use common::*;
+use wayland_client::globals::{GlobalListContents, registry_queue_init};
+use wayland_client::protocol::wl_registry;
+use wayland_client::{Connection, Dispatch, Proxy, QueueHandle, event_created_child};
+use wayland_protocols_wlr::output_management::v1::client::{
+    zwlr_output_configuration_head_v1 as conf_head, zwlr_output_configuration_v1 as conf,
+    zwlr_output_head_v1 as head, zwlr_output_manager_v1 as manager, zwlr_output_mode_v1 as mode,
+};
+
+#[derive(Default)]
+struct Heard {
+    serial: Option<u32>,
+    heads: HashMap<wayland_client::backend::ObjectId, (head::ZwlrOutputHeadV1, String)>,
+    result: Option<&'static str>,
+}
+
+impl Dispatch<manager::ZwlrOutputManagerV1, ()> for Heard {
+    fn event(
+        h: &mut Self,
+        _: &manager::ZwlrOutputManagerV1,
+        event: manager::Event,
+        _: &(),
+        _: &Connection,
+        _: &QueueHandle<Self>,
+    ) {
+        if let manager::Event::Done { serial } = event {
+            h.serial = Some(serial);
+        }
+    }
+
+    event_created_child!(Heard, manager::ZwlrOutputManagerV1, [
+        manager::EVT_HEAD_OPCODE => (head::ZwlrOutputHeadV1, ()),
+    ]);
+}
+
+impl Dispatch<head::ZwlrOutputHeadV1, ()> for Heard {
+    fn event(
+        h: &mut Self,
+        hd: &head::ZwlrOutputHeadV1,
+        event: head::Event,
+        _: &(),
+        _: &Connection,
+        _: &QueueHandle<Self>,
+    ) {
+        if let head::Event::Name { name } = event {
+            h.heads.insert(hd.id(), (hd.clone(), name));
+        }
+    }
+
+    event_created_child!(Heard, head::ZwlrOutputHeadV1, [
+        head::EVT_MODE_OPCODE => (mode::ZwlrOutputModeV1, ()),
+    ]);
+}
+
+impl Dispatch<conf::ZwlrOutputConfigurationV1, ()> for Heard {
+    fn event(
+        h: &mut Self,
+        _: &conf::ZwlrOutputConfigurationV1,
+        event: conf::Event,
+        _: &(),
+        _: &Connection,
+        _: &QueueHandle<Self>,
+    ) {
+        h.result = Some(match event {
+            conf::Event::Succeeded => "succeeded",
+            conf::Event::Failed => "failed",
+            conf::Event::Cancelled => "cancelled",
+            _ => "?",
+        });
+    }
+}
+
+impl Dispatch<wl_registry::WlRegistry, GlobalListContents> for Heard {
+    fn event(
+        _: &mut Self,
+        _: &wl_registry::WlRegistry,
+        _: wl_registry::Event,
+        _: &GlobalListContents,
+        _: &Connection,
+        _: &QueueHandle<Self>,
+    ) {
+    }
+}
+
+macro_rules! ignore {
+    ($($t:ty),*) => {$(
+        impl Dispatch<$t, ()> for Heard {
+            fn event(_: &mut Self, _: &$t, _: <$t as wayland_client::Proxy>::Event, _: &(), _: &Connection, _: &QueueHandle<Self>) {}
+        }
+    )*};
+}
+ignore!(mode::ZwlrOutputModeV1, conf_head::ZwlrOutputConfigurationHeadV1);
+
+fn outputs(c: &Compositor) -> Vec<aizome_ipc::OutputInfo> {
+    match c.request(Request::Outputs) {
+        Response::Outputs { outputs } => outputs,
+        r => panic!("{r:?}"),
+    }
+}
+
+#[test]
+fn repro_cpb_24_a_failed_two_head_apply_leaves_the_first_head_unchanged() {
+    let c = Compositor::start(Options {
+        outputs: &["1280x800@1", "1280x800@1"],
+        renderer: Some("pixman"),
+        ..Default::default()
+    });
+    let conn = Connection::from_socket(UnixStream::connect(c.dir.join(&c.socket)).unwrap()).unwrap();
+    let (globals, mut queue) = registry_queue_init::<Heard>(&conn).unwrap();
+    let qh = queue.handle();
+    let m: manager::ZwlrOutputManagerV1 = globals.bind(&qh, 1..=4, ()).expect("wlr-output-management");
+    let mut heard = Heard::default();
+    let deadline = Instant::now() + Duration::from_secs(5);
+    while heard.serial.is_none() || heard.heads.len() < 2 {
+        assert!(Instant::now() < deadline, "no heads");
+        queue.roundtrip(&mut heard).unwrap();
+    }
+    let by_name = |n: &str| heard.heads.values().find(|(_, name)| name == n).map(|(h, _)| h.clone()).unwrap();
+    let (h1, h2) = (by_name("HEADLESS-1"), by_name("HEADLESS-2"));
+    let before = outputs(&c);
+
+    // kanshi's profile: HEADLESS-1 at scale 2, HEADLESS-2 at a mode it
+    // doesn't list (what udev refuses: "has no mode 1234x567").
+    let config = m.create_configuration(heard.serial.unwrap(), &qh, ());
+    let c1 = config.enable_head(&h1, &qh, ());
+    c1.set_scale(2.0);
+    let c2 = config.enable_head(&h2, &qh, ());
+    c2.set_custom_mode(1234, 567, 0);
+    config.apply();
+    let deadline = Instant::now() + Duration::from_secs(5);
+    while heard.result.is_none() {
+        assert!(Instant::now() < deadline, "no answer to apply");
+        queue.roundtrip(&mut heard).unwrap();
+    }
+    let after = outputs(&c);
+    let s = |os: &[aizome_ipc::OutputInfo], n: &str| {
+        let o = os.iter().find(|o| o.name == n).unwrap();
+        (o.scale, o.current_mode.as_ref().map(|m| (m.width, m.height)), o.modes.len())
+    };
+    eprintln!(
+        "apply: {}; HEADLESS-1 (scale, mode, modes) {:?} -> {:?}; HEADLESS-2 {:?} -> {:?}",
+        heard.result.unwrap(),
+        s(&before, "HEADLESS-1"),
+        s(&after, "HEADLESS-1"),
+        s(&before, "HEADLESS-2"),
+        s(&after, "HEADLESS-2"),
+    );
+    if heard.result == Some("failed") {
+        assert_eq!(
+            s(&after, "HEADLESS-1"),
+            s(&before, "HEADLESS-1"),
+            "the client heard `failed`, but the first head's change stayed applied"
+        );
+    } else {
+        eprintln!(
+            "the headless backend couldn't fail the second head (it accepts any mode): the half-applied case needs \
+             a backend that refuses modes (udev, on real or virtual KMS)"
+        );
+    }
+    let _ = (c1.id(), c2.id());
+}
diff --git a/desktop/aizome/crates/aizome-comp/tests/repro_cpb_25.rs b/desktop/aizome/crates/aizome-comp/tests/repro_cpb_25.rs
