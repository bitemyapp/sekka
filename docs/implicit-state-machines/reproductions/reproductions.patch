+++ b/desktop/aizome/crates/aizome-shell/tests/repro_shb_14.rs
@@ -0,0 +1,54 @@
+//! SHB-14: critical notification cards, headless, when the compositor takes
+//! their surface away because its output went (the laptop's lid closes
+//! while an external display stays).
+
+mod common;
+
+use aizome_kit::Output;
+use aizome_kit::testing::Harness;
+use aizome_shell::notifications::server::NoteEvent;
+use aizome_shell::notifications::store::{Incoming, Urgency};
+use aizome_shell::shell::{Msg, Shell};
+use common::*;
+
+fn external() -> Output {
+    Output { id: 2, name: "DP-1".into(), connector: Some("DP-1".into()), ..output() }
+}
+
+fn critical(summary: &str) -> Box<Incoming> {
+    Box::new(Incoming {
+        app_name: "Power".into(),
+        summary: summary.into(),
+        body: "Plug in soon".into(),
+        urgency: Urgency::Critical,
+        ..Default::default()
+    })
+}
+
+fn cards_shown(h: &Harness<Shell>) -> bool {
+    h.windows().iter().any(|k| h.title(*k) == "Notifications")
+}
+
+#[test]
+fn critical_cards_come_back_after_their_output_goes() {
+    let mut h = scene(false);
+    h.set_outputs(vec![output(), external()]);
+    h.send(Msg::Note(NoteEvent::Notify(40, critical("Battery low: 6% left"))));
+    let cards = window_titled(&h, "Notifications");
+
+    // eDP-1 goes: the compositor closes the layer on it, then the output.
+    h.request_close(cards);
+    h.set_outputs(vec![external()]);
+    let after_close = (cards_shown(&h), h.program().cards);
+
+    // Another critical notification comes.
+    h.send(Msg::Note(NoteEvent::Notify(41, critical("Battery low: 3% left"))));
+    let shown = cards_shown(&h);
+    let unread_critical = h.program().card_views().len();
+    assert!(
+        shown,
+        "{unread_critical} critical cards and no surface showing them; after the close: (shown, cards) = \
+         {after_close:?}; now cards = {:?} (window {cards:?} was closed)",
+        h.program().cards
+    );
+}
diff --git a/desktop/aizome/crates/aizome-shell/tests/repro_shb_15.rs b/desktop/aizome/crates/aizome-shell/tests/repro_shb_15.rs
new file mode 100644
index 00000000..8f1c4d13
--- /dev/null
+++ b/desktop/aizome/crates/aizome-shell/tests/repro_shb_15.rs
@@ -0,0 +1,45 @@
+//! SHB-15: the bar's notification line, headless, when the notification on
+//! it is replaced in place (same id, as `replaces_id` gives): the first
+//! `BannerDone(id)` timer is still pending and ends the replacement's line.
+
+mod common;
+
+use std::time::Duration;
+
+use aizome_shell::notifications::server::NoteEvent;
+use aizome_shell::notifications::store::Incoming;
+use aizome_shell::shell::Msg;
+use common::*;
+
+fn progress(body: &str) -> Box<Incoming> {
+    Box::new(Incoming {
+        app_name: "Transfers".into(),
+        summary: "Copying photos".into(),
+        body: body.into(),
+        transient: true,
+        ..Default::default()
+    })
+}
+
+#[test]
+fn an_updated_notification_keeps_the_line_for_its_own_seconds() {
+    let mut h = scene(false);
+    let seconds = h.program().notes_cfg.banner_seconds;
+    assert_eq!(seconds, 5);
+    h.send(Msg::Note(NoteEvent::Notify(50, progress("10%"))));
+    assert_eq!(h.program().banner, Some(50));
+    h.advance(Duration::from_secs(3));
+    // The app updates it (replaces_id 50).
+    h.send(Msg::Note(NoteEvent::Notify(50, progress("60%"))));
+    assert_eq!(h.program().banner, Some(50));
+    // 2.5 s after the update (5.5 s after the first post).
+    h.advance(Duration::from_millis(2500));
+    let banner = h.program().banner;
+    let kept = h.program().notes.get(50).map(|n| n.body.clone());
+    assert!(
+        banner == Some(50) && kept.is_some(),
+        "2.5 s into its {seconds} s the updated notification's line is gone (banner {banner:?}), and the \
+         transient notification is {}",
+        if kept.is_some() { "still there" } else { "closed as expired" }
+    );
+}
diff --git a/desktop/aizome/crates/aizome-shell/tests/repro_shb_20.rs b/desktop/aizome/crates/aizome-shell/tests/repro_shb_20.rs
new file mode 100644
index 00000000..ffab5085
--- /dev/null
+++ b/desktop/aizome/crates/aizome-shell/tests/repro_shb_20.rs
@@ -0,0 +1,93 @@
+//! SHB-20: a recording taken back after a shell restart (`adopt_recording`,
+//! what the live shell calls at start) gets its systray indicator but not
+//! the indicator's one-second tick. The "recorder" is a `sleep` this test
+//! starts and kills; the note goes in the wrapper's private
+//! `$XDG_RUNTIME_DIR/aizome/recording.json`.
+
+mod common;
+
+use std::process::{Command, Stdio};
+use std::time::Duration;
+
+use aizome_shell::recording::run::{Note, note_path};
+use aizome_shell::shell::Msg;
+use common::*;
+
+/// `/proc/PID/stat` field 22, as the shell reads it.
+fn start_ticks(pid: u32) -> u64 {
+    let stat = std::fs::read_to_string(format!("/proc/{pid}/stat")).unwrap();
+    let rest = &stat[stat.rfind(')').unwrap() + 1..];
+    rest.split_whitespace().nth(19).unwrap().parse().unwrap()
+}
+
+#[test]
+fn an_adopted_recording_keeps_its_indicator_ticking() {
+    let note = note_path();
+    // Never the live session's runtime dir.
+    let runtime = std::env::var("XDG_RUNTIME_DIR").expect("a private XDG_RUNTIME_DIR");
+    assert!(
+        note.starts_with(&runtime) && !runtime.starts_with("/run/user"),
+        "the note must go in a private runtime dir: {}",
+        note.display()
+    );
+    let mut recorder = Command::new("sleep").arg("60").stdout(Stdio::null()).spawn().unwrap();
+    let pid = recorder.id();
+    let dir = std::env::temp_dir().join(format!("repro-shb-20-{}", std::process::id()));
+    std::fs::create_dir_all(&dir).unwrap();
+    let file = dir.join("screenrecording.mp4");
+    std::fs::write(&file, b"").unwrap();
+    let now = std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).unwrap().as_secs();
+    std::fs::create_dir_all(note.parent().unwrap()).unwrap();
+    std::fs::write(
+        &note,
+        serde_json::to_string(&Note {
+            pid: pid as i32,
+            start_ticks: start_ticks(pid),
+            recorder: "wf-recorder".into(),
+            path: file.clone(),
+            since: now - 5,
+        })
+        .unwrap(),
+    )
+    .unwrap();
+
+    let mut h = scene(false);
+    let bar = window_titled(&h, "Menu bar");
+    // The restarted shell takes it back.
+    h.program_mut().adopt_recording();
+    h.send(Msg::Nothing);
+    let adopted = h.program().recording.as_ref().map(|r| (r.phase, r.tick));
+    let before: Vec<String> = h.texts(bar).into_iter().filter(|t| t.starts_with("Recording")).collect();
+    h.take_damage(bar);
+
+    // Three seconds of the recording: wall clock for its label, harness
+    // clock for its timers.
+    for _ in 0..3 {
+        std::thread::sleep(Duration::from_millis(1010));
+        h.advance(Duration::from_millis(1010));
+    }
+    let after: Vec<String> = h.texts(bar).into_iter().filter(|t| t.starts_with("Recording")).collect();
+    let repainted = !h.take_damage(bar).is_empty();
+    let tick = h.program().recording.as_ref().map(|r| r.tick);
+
+    // A recording started by this shell, for comparison (test mode fakes
+    // the recorder's start).
+    let _ = recorder.kill();
+    let _ = recorder.wait();
+    let _ = std::fs::remove_file(&note);
+    let _ = std::fs::remove_dir_all(&dir);
+    let mut fresh = scene(false);
+    fresh.send(Msg::Run(aizome_shell::actions::Action::Record(aizome_shell::recording::Ask {
+        target: aizome_shell::recording::Target::Screen,
+        audio: None,
+    })));
+    fresh.advance(Duration::from_millis(3030));
+    let fresh_tick = fresh.program().recording.as_ref().map(|r| r.tick);
+
+    assert!(adopted.is_some(), "the recording was taken back");
+    assert!(
+        tick.is_some_and(|t| t >= 2),
+        "the adopted recording's indicator never ticked: tick {tick:?} (a fresh one's: {fresh_tick:?}); label \
+         {before:?} then {after:?} after 3 s, bar repainted: {repainted}"
+    );
+}
diff --git a/desktop/aizome/crates/aizome-shell/tests/repro_syb_12.rs b/desktop/aizome/crates/aizome-shell/tests/repro_syb_12.rs
new file mode 100644
index 00000000..4d5ee7db
--- /dev/null
+++ b/desktop/aizome/crates/aizome-shell/tests/repro_syb_12.rs
@@ -0,0 +1,221 @@
+//! SYB-12: logind's sleep delay and the lock before sleep, across a sleep
+//! that came before the lock was confirmed. The real shell (headless) and
+//! the real `aizome_sys::power::Logind` follower, against a fake logind on
+//! a private dbus-daemon whose `Inhibit` hands out pipes (a write end
+//! closed = the inhibitor released). Nothing suspends: "sleeping" is the
+//! fake emitting PrepareForSleep(true), then (false).
+
+mod common;
+
+use std::io::{BufRead, BufReader};
+use std::os::fd::{AsRawFd, FromRawFd, OwnedFd};
+use std::path::PathBuf;
+use std::process::{Child, Command, Stdio};
+use std::sync::{Arc, Mutex};
+use std::time::{Duration, Instant};
+
+use aizome_shell::lock::Phase;
+use aizome_shell::shell::Msg;
+use aizome_sys::Wake;
+use aizome_sys::power::Logind;
+use common::*;
+use zbus::fdo;
+use zbus::object_server::SignalEmitter;
+use zbus::zvariant::OwnedObjectPath;
+
+/// A private dbus-daemon that allows everything and activates nothing.
+struct TestBus {
+    child: Child,
+    address: String,
+    dir: PathBuf,
+}
+
+impl TestBus {
+    fn start() -> Option<TestBus> {
+        let dir = std::env::temp_dir().join(format!("repro-syb-12-bus-{}", std::process::id()));
+        let _ = std::fs::remove_dir_all(&dir);
+        std::fs::create_dir_all(&dir).ok()?;
+        let config = dir.join("bus.conf");
+        std::fs::write(
+            &config,
+            format!(
+                r#"<!DOCTYPE busconfig PUBLIC "-//freedesktop//DTD D-Bus Bus Configuration 1.0//EN"
+ "http://www.freedesktop.org/standards/dbus/1.0/busconfig.dtd">
+<busconfig>
+  <type>session</type>
+  <listen>unix:dir={}</listen>
+  <auth>EXTERNAL</auth>
+  <policy context="default">
+    <allow send_destination="*" eavesdrop="true"/>
+    <allow eavesdrop="true"/>
+    <allow own="*"/>
+  </policy>
+</busconfig>
+"#,
+                dir.display()
+            ),
+        )
+        .ok()?;
+        let mut child = Command::new("dbus-daemon")
+            .arg(format!("--config-file={}", config.display()))
+            .args(["--print-address", "--nofork"])
+            .stdout(Stdio::piped())
+            .stderr(Stdio::null())
+            .spawn()
+            .ok()?;
+        let mut line = String::new();
+        BufReader::new(child.stdout.take()?).read_line(&mut line).ok()?;
+        let address = line.trim().to_owned();
+        if address.is_empty() {
+            let _ = child.kill();
+            return None;
+        }
+        Some(TestBus { child, address, dir })
+    }
+}
+
+impl Drop for TestBus {
+    fn drop(&mut self) {
+        let _ = self.child.kill();
+        let _ = self.child.wait();
+        let _ = std::fs::remove_dir_all(&self.dir);
+    }
+}
+
+#[derive(Default)]
+struct Log {
+    /// The read ends of the inhibitor pipes handed out.
+    inhibitors: Vec<OwnedFd>,
+}
+
+struct LoginManager {
+    log: Arc<Mutex<Log>>,
+}
+
+#[zbus::interface(name = "org.freedesktop.login1.Manager")]
+impl LoginManager {
+    fn get_session(&self, id: String) -> fdo::Result<OwnedObjectPath> {
+        if id == "7" {
+            Ok(OwnedObjectPath::try_from("/org/freedesktop/login1/session/_37").unwrap())
+        } else {
+            Err(fdo::Error::Failed("no session".into()))
+        }
+    }
+    fn inhibit(&self, what: String, _who: String, _why: String, mode: String) -> zbus::zvariant::OwnedFd {
+        assert_eq!((what.as_str(), mode.as_str()), ("sleep", "delay"));
+        let mut fds = [0; 2];
+        // SAFETY: pipe2 fills two descriptors we then own.
+        assert_eq!(unsafe { libc::pipe2(fds.as_mut_ptr(), libc::O_CLOEXEC | libc::O_NONBLOCK) }, 0);
+        // SAFETY: fresh descriptors.
+        let (read, write) = unsafe { (OwnedFd::from_raw_fd(fds[0]), OwnedFd::from_raw_fd(fds[1])) };
+        self.log.lock().unwrap().inhibitors.push(read);
+        zbus::zvariant::OwnedFd::from(write)
+    }
+    #[zbus(signal)]
+    async fn prepare_for_sleep(emitter: &SignalEmitter<'_>, start: bool) -> zbus::Result<()>;
+}
+
+struct LoginSession;
+
+#[zbus::interface(name = "org.freedesktop.login1.Session")]
+impl LoginSession {
+    #[zbus(property)]
+    fn id(&self) -> String {
+        "7".into()
+    }
+    #[zbus(property)]
+    fn active(&self) -> bool {
+        true
+    }
+    fn set_locked_hint(&self, _locked: bool) {}
+}
+
+/// Whether every write end of the pipe whose read end is `read` is closed.
+fn released(read: &OwnedFd) -> bool {
+    let mut byte = 0u8;
+    // SAFETY: reading one byte into a valid buffer from a pipe we own.
+    let n = unsafe { libc::read(read.as_raw_fd(), (&mut byte as *mut u8).cast(), 1) };
+    n == 0
+}
+
+fn until(what: &str, mut f: impl FnMut() -> bool) {
+    let deadline = Instant::now() + Duration::from_secs(5);
+    while !f() {
+        assert!(Instant::now() < deadline, "timed out: {what}");
+        std::thread::sleep(Duration::from_millis(20));
+    }
+}
+
+#[test]
+fn a_sleep_delay_is_held_for_the_next_sleep() {
+    // The shell follows logind's session events only in an Aizome session.
+    // SAFETY: set before this test starts any thread; the only test here.
+    unsafe { std::env::set_var("AIZOME_SESSION", "1") };
+    let Some(bus) = TestBus::start() else {
+        eprintln!("skipping: no dbus-daemon");
+        return;
+    };
+    let log = Arc::new(Mutex::new(Log::default()));
+    let fake = zbus::blocking::connection::Builder::address(bus.address.as_str())
+        .unwrap()
+        .name("org.freedesktop.login1")
+        .unwrap()
+        .serve_at("/org/freedesktop/login1", LoginManager { log: log.clone() })
+        .unwrap()
+        .serve_at("/org/freedesktop/login1/session/_37", LoginSession)
+        .unwrap()
+        .build()
+        .unwrap();
+    let emit = |start: bool| {
+        fake.emit_signal(
+            None::<&str>,
+            "/org/freedesktop/login1",
+            "org.freedesktop.login1.Manager",
+            "PrepareForSleep",
+            &(start,),
+        )
+        .unwrap();
+    };
+    let logind = Logind::with_bus(aizome_sys::Bus::at(&bus.address).unwrap(), Wake::none(), Some("7".into()));
+    until("logind available", || logind.available());
+
+    let mut h = scene(false);
+    assert!(h.program().lock_cfg.before_sleep);
+    // What start_lock does in a session: hold the delay.
+    logind.take_sleep_delay().unwrap();
+    h.program_mut().sys.logind = Some(logind);
+    let inhibitors = |log: &Arc<Mutex<Log>>| log.lock().unwrap().inhibitors.len();
+    assert_eq!(inhibitors(&log), 1);
+
+    // The lid closes: logind says it's about to sleep; the shell locks.
+    emit(true);
+    until("the shell locking for sleep", || {
+        h.send(Msg::Sys);
+        h.program().lock.sleep_pending && h.program().lock.phase == Phase::Locking
+    });
+    assert!(!released(&log.lock().unwrap().inhibitors[0]), "sleep waits for the lock");
+
+    // The compositor doesn't confirm the lock within logind's delay limit
+    // (InhibitDelayMaxSec): the machine sleeps anyway, and wakes.
+    emit(false);
+    until("the shell taking the delay again on resume", || {
+        h.send(Msg::Sys);
+        inhibitors(&log) >= 2
+    });
+    // Now the compositor confirms the lock.
+    h.confirm_lock();
+    assert_eq!(h.program().lock.phase, Phase::Locked);
+    std::thread::sleep(Duration::from_millis(100));
+    h.send(Msg::Sys);
+
+    let log = log.lock().unwrap();
+    let held: Vec<bool> = log.inhibitors.iter().map(|r| !released(r)).collect();
+    let model_held = h.program().sys.logind.as_ref().unwrap().snapshot().sleep_delay_held;
+    assert!(
+        held.iter().any(|h| *h),
+        "no sleep delay is held for the next sleep: inhibitors taken {}, held now {held:?}, \
+         LogindState.sleep_delay_held {model_held}, sleep_pending {}",
+        held.len(),
+        h.program().lock.sleep_pending
+    );
+}
