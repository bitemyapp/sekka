diff --git a/desktop/tatami/displays/src/repro_tap_19.rs b/desktop/tatami/displays/src/repro_tap_19.rs
new file mode 100644
index 00000000..d6b8e86d
--- /dev/null
+++ b/desktop/tatami/displays/src/repro_tap_19.rs
@@ -0,0 +1,305 @@
+// SPDX-License-Identifier: MIT OR Apache-2.0
+//! TAP-19: Hyprland's display events while the window applies or reads.
+//! `refresh` (window.rs:194-243) returns while applying or already reading,
+//! and a slider's change (`quietly`, window.rs:1044-1074) schedules no
+//! reading after it.
+//!
+//! The real window (`build`) runs against stubs on PATH, written by the test
+//! into TMPDIR: `hyprctl` answers `-j monitors all` from a JSON file and can
+//! hold its answer; `tatami displays apply` can hold until released;
+//! `tatami displays lid` says "open"; `tatami nightlight status` "off 4000".
+//! Hyprland's event socket is a listener in the private XDG_RUNTIME_DIR.
+//! Nothing reaches Hyprland, hyprsunset or the helper. Needs a display (a
+//! private Xvfb) and a session bus to register the app.
+use super::*;
+use std::{
+    io::Write,
+    os::unix::{fs::PermissionsExt, net::UnixListener},
+    path::{Path, PathBuf},
+    time::Instant,
+};
+
+pub(super) const HYPRCTL: &str = r#"#!/bin/sh
+D="$REPRO_STUB_DIR"
+log() { echo "$(date +%s.%N) $*" >> "$D/log"; }
+case "$*" in
+"-j monitors all")
+    reply=$(cat "$D/monitors.json")
+    log "hyprctl monitors: read $(printf '%s' "$reply" | grep -o '"name"' | wc -l) display(s)"
+    while [ -e "$D/hold-monitors" ]; do sleep 0.02; done
+    printf '%s\n' "$reply"
+    log "hyprctl monitors: answered" ;;
+"-j getoption misc:vrr") echo '{"int":0}' ;;
+"hyprsunset temperature"|"hyprsunset temperature "*)
+    exec 9>>"$D/sunset.lock"; flock 9
+    read active up temp < "$D/sunset"
+    if [ "$active" != 1 ] || [ "$(date +%s%3N)" -lt "$up" ]; then
+        log "hyprctl $*: hyprsunset not up"; echo "Couldn't connect to hyprsunset"; exit 1
+    fi
+    if [ $# -eq 3 ]; then echo "$active $up $3" > "$D/sunset"; log "hyprsunset: tint $3 K"; echo ok
+    else echo "$temp"; fi ;;
+*) log "hyprctl $*: unexpected"; exit 1 ;;
+esac
+"#;
+
+pub(super) const TATAMI: &str = r#"#!/bin/sh
+D="$REPRO_STUB_DIR"
+log() { echo "$(date +%s.%N) $*" >> "$D/log"; }
+case "$1 $2" in
+"displays lid") echo open ;;
+"displays apply")
+    cat > /dev/null
+    log "apply: started"
+    while [ -e "$D/hold-apply" ]; do sleep 0.02; done
+    log "apply: finished" ;;
+"nightlight "*)
+    if [ -n "$REPRO_TATAMI_BIN" ]; then
+        log "tatami nightlight $2: started"
+        "$REPRO_TATAMI_BIN" "$@"; rc=$?
+        log "tatami nightlight $2: finished ($rc)"; exit $rc
+    fi
+    echo "off 4000" ;;
+*) log "tatami $*: unexpected"; exit 1 ;;
+esac
+"#;
+
+/// hyprsunset's unit for the real `tatami nightlight` (TAP-21). It first
+/// checks that its caller, the helper, has the preload shim, which keeps
+/// signal_waybar's kill() away from the host's waybar.
+pub(super) const SYSTEMCTL: &str = r#"#!/bin/sh
+D="$REPRO_STUB_DIR"
+log() { echo "$(date +%s.%N) $*" >> "$D/log"; }
+if ! grep -q repro-shim.so "/proc/$PPID/maps"; then
+    log "GUARD: caller $PPID has no shim; killed"; kill -9 "$PPID"; exit 1
+fi
+exec 9>>"$D/sunset.lock"; flock 9
+read active up temp < "$D/sunset"
+case "$*" in
+"--user --quiet is-active tatami-hyprsunset.service") [ "$active" = 1 ]; exit $? ;;
+"--user start tatami-hyprsunset.service")
+    if [ "$active" != 1 ]; then
+        echo "1 $(( $(date +%s%3N) + ${REPRO_SUNSET_START_MS:-1200} )) 6000" > "$D/sunset"
+        log "hyprsunset: started, its socket up in ${REPRO_SUNSET_START_MS:-1200} ms"
+    fi ;;
+"--user stop tatami-hyprsunset.service") echo "0 0 6000" > "$D/sunset"; log "hyprsunset: stopped" ;;
+*) log "systemctl $*: unexpected"; exit 1 ;;
+esac
+"#;
+
+pub(super) const LOGGED: &str = r#"#!/bin/sh
+echo "$(date +%s.%N) $(basename "$0") $*: unexpected" >> "$REPRO_STUB_DIR/log"
+"#;
+
+pub(super) fn monitor(id: i64, name: &str, x: i64) -> String {
+    format!(
+        r#"{{"id":{id},"name":"{name}","description":"Repro {name}","make":"Repro","model":"{name}","width":2560,"height":1440,"refreshRate":60.0,"x":{x},"y":0,"scale":1.0,"transform":0,"disabled":false,"mirrorOf":"none","colorManagementPreset":"hdr","sdrBrightness":1.0,"sdrSaturation":1.0,"availableModes":["2560x1440@60.00Hz"],"activeWorkspace":{{"id":{id}}}}}"#
+    )
+}
+
+pub(super) struct Stubs {
+    pub dir: PathBuf,
+}
+
+impl Stubs {
+    /// Stubs in TMPDIR first on PATH, and Hyprland's event socket.
+    pub fn new(tag: &str) -> (Stubs, UnixListener) {
+        let dir = std::env::temp_dir().join(format!("repro-{tag}"));
+        let _ = std::fs::remove_dir_all(&dir);
+        let bin = dir.join("bin");
+        std::fs::create_dir_all(&bin).unwrap();
+        for (name, text) in [
+            ("hyprctl", HYPRCTL),
+            ("tatami", TATAMI),
+            ("systemctl", SYSTEMCTL),
+            ("brightnessctl", LOGGED),
+            ("notify-send", LOGGED),
+        ] {
+            let path = bin.join(name);
+            std::fs::write(&path, text).unwrap();
+            std::fs::set_permissions(&path, std::fs::Permissions::from_mode(0o755)).unwrap();
+        }
+        std::fs::write(dir.join("monitors.json"), format!("[{}]", monitor(1, "DP-1", 0))).unwrap();
+        std::fs::write(dir.join("sunset"), "0 0 6000\n").unwrap();
+        std::fs::write(dir.join("log"), "").unwrap();
+        let runtime = std::env::var("XDG_RUNTIME_DIR").unwrap();
+        assert!(runtime.starts_with(&*std::env::var("ISOLATE_SCRATCH").expect("run through docs/implicit-state-machines/reproductions/isolate")), "a private runtime directory");
+        let hypr = Path::new(&runtime).join("hypr").join(tag);
+        let _ = std::fs::remove_dir_all(&hypr);
+        std::fs::create_dir_all(&hypr).unwrap();
+        let events = UnixListener::bind(hypr.join(".socket2.sock")).unwrap();
+        let path = format!("{}:{}", bin.display(), std::env::var("PATH").unwrap());
+        // SAFETY: set before the window starts any thread or process.
+        unsafe {
+            std::env::set_var("PATH", path);
+            std::env::set_var("REPRO_STUB_DIR", &dir);
+            std::env::set_var("HYPRLAND_INSTANCE_SIGNATURE", tag);
+            // The helper keeps the night temperature and the settings here.
+            std::env::set_var("XDG_STATE_HOME", dir.join("state"));
+        }
+        (Stubs { dir }, events)
+    }
+
+    pub fn log(&self) -> String {
+        std::fs::read_to_string(self.dir.join("log")).unwrap_or_default()
+    }
+
+    pub fn note(&self, text: &str) {
+        let mut log = std::fs::OpenOptions::new()
+            .append(true)
+            .open(self.dir.join("log"))
+            .unwrap();
+        let now = std::time::SystemTime::now()
+            .duration_since(std::time::UNIX_EPOCH)
+            .unwrap();
+        writeln!(log, "{}.{:09} TEST: {text}", now.as_secs(), now.subsec_nanos()).unwrap();
+    }
+
+    pub fn set(&self, name: &str, on: bool) {
+        let path = self.dir.join(name);
+        if on {
+            std::fs::write(path, "").unwrap();
+        } else {
+            let _ = std::fs::remove_file(path);
+        }
+    }
+
+    pub fn monitors(&self, names: &[&str]) {
+        let rows: Vec<String> = names
+            .iter()
+            .enumerate()
+            .map(|(i, name)| monitor(i as i64 + 1, name, i as i64 * 2560))
+            .collect();
+        std::fs::write(self.dir.join("monitors.json"), format!("[{}]", rows.join(","))).unwrap();
+    }
+}
+
+pub(super) fn app(id: &str) -> adw::Application {
+    adw::init().unwrap();
+    let app = adw::Application::builder()
+        .application_id(id)
+        .flags(gtk::gio::ApplicationFlags::NON_UNIQUE)
+        .build();
+    app.register(None::<&gtk::gio::Cancellable>).unwrap();
+    app
+}
+
+pub(super) async fn pause(milliseconds: u64) {
+    glib::timeout_future(Duration::from_millis(milliseconds)).await;
+}
+
+pub(super) async fn wait_until(what: &str, ready: impl Fn() -> bool) {
+    let start = Instant::now();
+    while !ready() {
+        assert!(start.elapsed() < Duration::from_secs(10), "timed out: {what}");
+        pause(10).await;
+    }
+}
+
+pub(super) fn descendants(widget: &gtk::Widget, out: &mut Vec<gtk::Widget>) {
+    let mut child = widget.first_child();
+    while let Some(current) = child {
+        out.push(current.clone());
+        descendants(&current, out);
+        child = current.next_sibling();
+    }
+}
+
+pub(super) fn all(window: &adw::ApplicationWindow) -> Vec<gtk::Widget> {
+    let mut out = Vec::new();
+    descendants(window.upcast_ref(), &mut out);
+    out
+}
+
+pub(super) fn tiles(window: &adw::ApplicationWindow) -> usize {
+    all(window)
+        .iter()
+        .filter(|w| w.has_css_class("display-tile"))
+        .count()
+}
+
+/// The control in the row with this title.
+pub(super) fn control<T: IsA<gtk::Widget>>(window: &adw::ApplicationWindow, title: &str) -> T {
+    let row = all(window)
+        .into_iter()
+        .filter_map(|w| w.downcast::<adw::PreferencesRow>().ok())
+        .find(|row| row.title() == title)
+        .unwrap_or_else(|| panic!("no row {title}"));
+    if let Ok(found) = row.clone().upcast::<gtk::Widget>().downcast::<T>() {
+        return found;
+    }
+    let mut inside = Vec::new();
+    descendants(row.upcast_ref(), &mut inside);
+    inside
+        .into_iter()
+        .find_map(|w| w.downcast::<T>().ok())
+        .unwrap_or_else(|| panic!("no control in {title}"))
+}
+
+fn send(events: &mut std::os::unix::net::UnixStream, line: &str) {
+    writeln!(events, "{line}").unwrap();
+}
+
+#[test]
+fn repro_tap_19_display_added_while_applying_or_reading() {
+    let (stubs, listener) = Stubs::new("repro-tap-19");
+    let app = app("org.tatami.Displays.ReproTap19");
+    let context = glib::MainContext::default();
+    context.block_on(async {
+        let window = build(&app);
+        window.present();
+        let mut events = listener.accept().unwrap().0;
+        wait_until("the first reading", || tiles(&window) == 1).await;
+        pause(300).await;
+        let mut wrong = Vec::new();
+
+        // A. A display is plugged in while an SDR brightness change applies.
+        stubs.set("hold-apply", true);
+        let slider: gtk::Scale = control(&window, "Brightness of SDR content");
+        slider.set_value(1.3);
+        wait_until("the apply", || stubs.log().contains("apply: started")).await;
+        stubs.monitors(&["DP-1", "DP-2"]);
+        stubs.note("DP-2 plugged in; monitoradded sent");
+        send(&mut events, "monitoradded>>DP-2");
+        send(&mut events, "monitoraddedv2>>2,DP-2,Repro DP-2");
+        pause(600).await;
+        stubs.set("hold-apply", false);
+        wait_until("the apply's end", || stubs.log().contains("apply: finished")).await;
+        pause(1500).await;
+        if tiles(&window) != 2 {
+            wrong.push(format!(
+                "A: plugged in during a slider's apply: {} display shown, 2 connected",
+                tiles(&window)
+            ));
+        }
+
+        // B. A display is plugged in while a reading runs.
+        stubs.monitors(&["DP-1"]);
+        stubs.note("DP-2 unplugged; monitorremoved sent");
+        send(&mut events, "monitorremoved>>DP-2");
+        wait_until("one display again", || tiles(&window) == 1).await;
+        pause(500).await;
+        stubs.set("hold-monitors", true);
+        stubs.note("configreloaded sent; the reading will be held");
+        send(&mut events, "configreloaded>>");
+        let reads = || stubs.log().matches("hyprctl monitors: read").count();
+        let before = reads();
+        wait_until("a reading in flight", || reads() > before).await;
+        stubs.monitors(&["DP-1", "DP-2"]);
+        stubs.note("DP-2 plugged in during that reading; monitoradded sent");
+        send(&mut events, "monitoradded>>DP-2");
+        pause(600).await;
+        stubs.set("hold-monitors", false);
+        pause(1500).await;
+        if tiles(&window) != 2 {
+            wrong.push(format!(
+                "B: plugged in during a reading: {} display shown, 2 connected",
+                tiles(&window)
+            ));
+        }
+        assert!(
+            wrong.is_empty(),
+            "{wrong:#?}\nstub log:\n{}",
+            stubs.log()
+        );
+    });
+}
diff --git a/desktop/tatami/displays/src/repro_tap_21.rs b/desktop/tatami/displays/src/repro_tap_21.rs
new file mode 100644
index 00000000..0f79ed05
--- /dev/null
+++ b/desktop/tatami/displays/src/repro_tap_21.rs
@@ -0,0 +1,122 @@
+// SPDX-License-Identifier: MIT OR Apache-2.0
+//! TAP-21: Night Shift requests on unordered threads. The switch and the
+//! debounced temperature slider (window.rs:1126-1147) each start
+//! `tatami nightlight on|off|K` on a thread of its own (system.rs:188-203).
+//!
+//! The real window (`build`) and the real helper (`tatami nightlight`, from
+//! tool/, its path in REPRO_TATAMI_BIN) run against the stubs of TAP-19:
+//! `systemctl --user … tatami-hyprsunset.service` and `hyprctl hyprsunset
+//! temperature [K]` model hyprsunset, whose socket comes up 1.2 s after it
+//! starts. The helper's signal_waybar would signal the host's waybar: the
+//! test runs under the preload shim, which refuses that kill(), and the
+//! `systemctl` stub kills any helper that lacks the shim before it gets
+//! there. Needs a display and a session bus.
+use super::repro_tap_19::{Stubs, app, control, pause, wait_until};
+use super::*;
+
+fn shim_loaded() -> bool {
+    std::env::var("LD_PRELOAD").is_ok_and(|preload| preload.contains("repro-shim.so"))
+        && std::fs::read_to_string("/proc/self/maps").is_ok_and(|maps| maps.contains("repro-shim.so"))
+}
+
+/// The tint hyprsunset shows, from the stub's state: Some(K) below 6000 K.
+fn tint(stubs: &Stubs) -> Option<u32> {
+    let state = std::fs::read_to_string(stubs.dir.join("sunset")).unwrap();
+    let fields: Vec<u64> = state
+        .split_whitespace()
+        .filter_map(|f| f.parse().ok())
+        .collect();
+    (fields[0] == 1)
+        .then_some(fields[2] as u32)
+        .filter(|kelvin| *kelvin < 6000)
+}
+
+fn finished(stubs: &Stubs, request: &str) -> bool {
+    stubs
+        .log()
+        .contains(&format!("tatami nightlight {request}: finished"))
+}
+
+fn setup(tag: &str, sunset: &str) -> (Stubs, adw::Application) {
+    assert!(shim_loaded(), "run under LD_PRELOAD=…/repro-shim.so");
+    assert!(
+        std::env::var("REPRO_TATAMI_BIN").is_ok(),
+        "REPRO_TATAMI_BIN: the helper built from desktop/tatami/tool"
+    );
+    let (stubs, listener) = Stubs::new(tag);
+    // The window's watcher connects; no events are needed here.
+    std::thread::spawn(move || {
+        let _connection = listener.accept();
+        std::thread::sleep(Duration::from_secs(60));
+    });
+    std::fs::write(stubs.dir.join("sunset"), sunset).unwrap();
+    let app = app(&format!("org.tatami.Displays.{}", tag.replace('-', "")));
+    (stubs, app)
+}
+
+#[test]
+fn repro_tap_21_switch_on_then_off() {
+    let (stubs, app) = setup("repro-tap-21a", "0 0 6000\n");
+    let context = glib::MainContext::default();
+    context.block_on(async {
+        let window = build(&app);
+        window.present();
+        wait_until("the first reading", || finished(&stubs, "status")).await;
+        pause(500).await;
+        let switch: adw::SwitchRow = control(&window, "Night Shift");
+        assert!(!switch.is_active() && tint(&stubs).is_none());
+
+        stubs.note("switch on");
+        switch.set_active(true);
+        pause(400).await;
+        stubs.note("switch off");
+        switch.set_active(false);
+        wait_until("both requests done", || {
+            finished(&stubs, "on") && finished(&stubs, "off")
+        })
+        .await;
+        pause(300).await;
+        let shown = switch.is_active();
+        assert!(
+            tint(&stubs).is_none(),
+            "Night Shift switched on, then off 0.4 s later: the switch shows {}, the screen is \
+             tinted {:?} K\nstub log:\n{}",
+            if shown { "on" } else { "off" },
+            tint(&stubs),
+            stubs.log()
+        );
+    });
+}
+
+#[test]
+fn repro_tap_21_temperature_then_off() {
+    // Night Shift on at 4000 K, hyprsunset running.
+    let (stubs, app) = setup("repro-tap-21b", "1 0 4000\n");
+    let context = glib::MainContext::default();
+    context.block_on(async {
+        let window = build(&app);
+        window.present();
+        wait_until("the first reading", || finished(&stubs, "status")).await;
+        pause(500).await;
+        let switch: adw::SwitchRow = control(&window, "Night Shift");
+        let slider: gtk::Scale = control(&window, "Color temperature");
+        assert!(switch.is_active() && tint(&stubs) == Some(4000));
+
+        stubs.note("temperature dragged to 3000 K, then the switch turned off");
+        slider.set_value(3000.0);
+        switch.set_active(false);
+        wait_until("both requests done", || {
+            finished(&stubs, "off") && finished(&stubs, "3000")
+        })
+        .await;
+        pause(300).await;
+        assert!(
+            tint(&stubs).is_none(),
+            "temperature changed, then Night Shift off within 300 ms: the switch shows {}, the \
+             screen is tinted {:?} K\nstub log:\n{}",
+            if switch.is_active() { "on" } else { "off" },
+            tint(&stubs),
+            stubs.log()
+        );
+    });
+}
diff --git a/desktop/tatami/displays/src/window.rs b/desktop/tatami/displays/src/window.rs
index 4b773818..3b91ddd8 100644
--- a/desktop/tatami/displays/src/window.rs
+++ b/desktop/tatami/displays/src/window.rs
@@ -1169,3 +1169,5 @@ fn control_row(title: &str, control: &impl IsA<gtk::Widget>) -> adw::Preferences
         .child(&body)
         .build()
 }
+#[cfg(test)] #[path = "repro_tap_19.rs"] mod repro_tap_19;
