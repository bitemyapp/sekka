diff --git a/desktop/aizome/apps/nisshi/src/repro_ntu_03.rs b/desktop/aizome/apps/nisshi/src/repro_ntu_03.rs
new file mode 100644
index 00000000..017fe668
--- /dev/null
+++ b/desktop/aizome/apps/nisshi/src/repro_ntu_03.rs
@@ -0,0 +1,51 @@
+//! NTU-03: a row selected while the newest page still streams in; its
+//! fields read fails (a vacuumed cursor, or "too many reads at once"). The
+//! page is still being read, so "Reading…" must stay, Read Earlier must
+//! stay disabled, and a pending `--cursor` must keep waiting.
+//!
+//! The window's own update, with the reader's events as the reader sends
+//! them (a request table as `load` and `fetch` leave it).
+
+use std::time::Duration;
+
+use aizome_kit::testing::Harness;
+
+use super::*;
+use crate::backend::Event;
+use crate::fixture;
+
+#[test]
+fn a_failed_fields_read_does_not_end_the_page_still_being_read() {
+    let mut n =
+        Nisshi::sample(fixture::journal(), fixture::boots(), fixture::files(), fixture::clock(), fixture::UID, Access::System);
+    // The newest page streams in from the user's reader (its generation 0,
+    // request 1): some of it read, the rest coming.
+    n.store.complete = false;
+    n.loading = true;
+    n.pending.insert((0, 1), Want::Load(1000));
+    // A row was selected meanwhile and its fields asked for (request 2).
+    let seq = n.store.entries.last().unwrap().seq;
+    n.selected = vec![seq];
+    n.pending.insert((0, 2), Want::Fields(seq));
+    // Launched with `--cursor` for a message not read yet.
+    n.want_cursor = Some("s=not-read-yet".into());
+    let mut h = Harness::new(n);
+
+    h.send(Msg::Backend(0, Event::Failed { id: 2, why: "too many reads at once".into() }));
+    let n = h.program();
+    let loading = n.loading;
+    let still_pending = n.pending.values().any(|w| matches!(w, Want::Load(_)));
+    // Read Earlier's enablement, as the Journal menu has it.
+    let read_earlier = !n.in_file() && !n.store.complete && !n.loading;
+    // More of the page comes, and the view follows it.
+    h.send(Msg::Backend(0, Event::Entries { id: 1, entries: Vec::new() }));
+    h.advance(Duration::from_millis(200));
+    let notice = h.program().notice.clone();
+
+    assert!(still_pending, "the page's read is still pending");
+    assert!(
+        loading && !read_earlier && notice.is_none(),
+        "a failed fields read, with the newest page still being read: loading {loading} (\"Reading…\"), \
+         Read Earlier enabled {read_earlier}, --cursor notice {notice:?}"
+    );
+}
diff --git a/desktop/aizome/apps/nisshi/tests/repro_ntu_01.rs b/desktop/aizome/apps/nisshi/tests/repro_ntu_01.rs
new file mode 100644
index 00000000..22ffce71
--- /dev/null
+++ b/desktop/aizome/apps/nisshi/tests/repro_ntu_01.rs
@@ -0,0 +1,87 @@
+//! NTU-01: an unreadable log file asks to unlock; while the password
+//! dialog is up the user goes back to All Messages; once unlocked, the
+//! window must stay where the user went, not jump back to the file.
+//!
+//! Real reader (`aizome-nisshi-helper`, run as you) over the stand-in
+//! journalctl, and a stand-in pkexec that holds "the dialog" open until the
+//! test gives the password (a file appears). Nothing asks polkit.
+
+use std::os::unix::fs::PermissionsExt;
+use std::path::Path;
+use std::time::Duration;
+
+use aizome_kit::testing::Harness;
+use nisshi::app::{Msg, Nisshi, Request, Unlock};
+use nisshi::filter::Scope;
+use nisshi::fixture;
+
+const WAIT: Duration = Duration::from_secs(20);
+
+fn script(path: &Path, body: &str) {
+    std::fs::write(path, body).unwrap();
+    std::fs::set_permissions(path, std::fs::Permissions::from_mode(0o755)).unwrap();
+}
+
+#[test]
+fn unlocking_after_leaving_the_locked_file_stays_where_the_user_went() {
+    // SAFETY: geteuid has no preconditions.
+    if unsafe { libc::geteuid() } == 0 {
+        eprintln!("skipped: root reads a file whatever its mode");
+        return;
+    }
+    let dir = std::env::temp_dir().join(format!("nisshi-repro-ntu01-{}", std::process::id()));
+    let _ = std::fs::remove_dir_all(&dir);
+    fixture::stage(&dir).unwrap();
+    // A log only an administrator may read.
+    let secret = dir.join("log/secret.log");
+    std::fs::write(&secret, "2026-10-29T16:00:00-05:00 secret\n").unwrap();
+    std::fs::set_permissions(&secret, std::fs::Permissions::from_mode(0o000)).unwrap();
+    let path = std::env::var("PATH").unwrap_or_default();
+    let d = dir.display();
+    // pkexec: "the dialog" is up until `go` exists (at most 30 s), then it
+    // runs the helper as you.
+    script(
+        &dir.join("pkexec"),
+        &format!(
+            r#"#!/bin/sh
+export PATH='{path}'
+i=0
+while [ ! -e '{d}/go' ]; do
+  i=$((i+1)); [ $i -gt 1500 ] && {{ echo 'Error executing command as another user: Request dismissed' >&2; exit 126; }}
+  sleep 0.02
+done
+[ "$1" = --disable-internal-agent ] && shift
+exec "$@"
+"#
+        ),
+    );
+    // SAFETY: the only test in this binary; nothing else reads the
+    // environment meanwhile.
+    unsafe {
+        std::env::set_var("NISSHI_HELPER", env!("CARGO_BIN_EXE_aizome-nisshi-helper"));
+        std::env::set_var("NISSHI_JOURNALCTL", dir.join("journalctl"));
+        std::env::set_var("NISSHI_LOG_DIR", dir.join("log"));
+        std::env::set_var("NISSHI_PKEXEC", dir.join("pkexec"));
+    }
+    let mut h = Harness::new(Nisshi::live(Request::default()));
+    assert!(h.settle(WAIT, |n| !n.loading && n.store.entries.len() > 500), "the boot is read");
+    assert!(h.settle(WAIT, |n| n.files.iter().any(|f| f.path.ends_with("secret.log"))), "the files are listed");
+    let file = h.program().files.iter().find(|f| f.path.ends_with("secret.log")).unwrap().clone();
+    assert!(!file.readable);
+
+    // The unreadable file: the password dialog opens.
+    h.send(Msg::OpenFile(file.path.clone()));
+    assert_eq!(h.program().unlock, Unlock::Asking, "an unreadable file asks to unlock");
+    // While it's up, the user goes back to All Messages.
+    h.send(Msg::Scope(Scope::All));
+    assert_eq!(h.program().filter.scope, Scope::All);
+    // The administrator's password is given.
+    std::fs::write(dir.join("go"), "").unwrap();
+    assert!(h.settle(WAIT, |n| n.unlock == Unlock::Unlocked), "unlocked");
+    h.advance(Duration::from_millis(200));
+    let scope = h.program().filter.scope.clone();
+    drop(h);
+    let _ = std::fs::set_permissions(&secret, std::fs::Permissions::from_mode(0o600));
+    let _ = std::fs::remove_dir_all(&dir);
+    assert_eq!(scope, Scope::All, "unlocking switched the window back to the file the user had left");
+}
