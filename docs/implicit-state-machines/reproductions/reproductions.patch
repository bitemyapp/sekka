+  '    hang) touch "$T/state/build-started"; exec sleep 600;;' \
+  '    ok\ *) echo "$T/sys/${m#ok }";; esac;;' \
+  '*attrNames*) echo "[\"fake\"]";;' \
+  '*nix.settings*) echo "{\"substituters\":[],\"keys\":[]}";;' \
