@@ -0,0 +1,58 @@
+//! KIT-07: a window closed by the program while its save panel is up:
+//! the panel's completion must still be heard (as a cancel), and the
+//! panel's state must not stay behind.
+
+use std::path::PathBuf;
+
+use super::Harness;
+use crate::prelude::*;
+
+#[derive(Default)]
+struct Two {
+    main: Option<WindowKey>,
+    doc: Option<WindowKey>,
+    saved: Vec<Option<PathBuf>>,
+}
+
+#[derive(Clone, Debug)]
+enum Msg {
+    Save,
+    Saved(Option<PathBuf>),
+    CloseDoc,
+}
+
+impl Program for Two {
+    type Msg = Msg;
+    fn info(&self) -> AppInfo {
+        AppInfo::new("org.aizome.ReproKit07", "Repro", "Repro")
+    }
+    fn launched(&mut self, cx: &mut Cx<Msg>) {
+        self.main = Some(cx.open_window(WindowSpec::new("Main").size(500.0, 400.0)));
+        self.doc = Some(cx.open_window(WindowSpec::new("Doc").size(720.0, 520.0)));
+    }
+    fn update(&mut self, msg: Msg, cx: &mut Cx<Msg>) {
+        match msg {
+            Msg::Save => {
+                let dir = std::env::temp_dir();
+                cx.save_panel(self.doc.unwrap(), FileDialog::new().directory(dir).file_name("a.txt"), Msg::Saved)
+            }
+            Msg::Saved(p) => self.saved.push(p),
+            Msg::CloseDoc => cx.close_window(self.doc.unwrap()),
+        }
+    }
+    fn view(&self, _w: WindowKey) -> Element<Msg> {
+        text("window").into()
+    }
+}
+
+#[test]
+fn repro_kit_07_closing_a_window_under_its_save_panel_completes_the_panel() {
+    let mut h = Harness::new(Two::default());
+    h.send(Msg::Save);
+    assert_eq!(h.rt.core.panels.len(), 1, "the save panel is up");
+    h.send(Msg::CloseDoc);
+    assert_eq!(h.windows().len(), 1, "the document window closed");
+    println!("panels left: {}, completions heard: {:?}", h.rt.core.panels.len(), h.program().saved);
+    assert_eq!(h.program().saved, vec![None], "the panel's done callback must fire (as a cancel) when its window closes");
+    assert!(h.rt.core.panels.is_empty(), "the closed window's panel state must not stay in Core.panels");
+}
diff --git a/desktop/aizome/crates/aizome-kit/src/repro_kit_17.rs b/desktop/aizome/crates/aizome-kit/src/repro_kit_17.rs
