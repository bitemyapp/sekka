@@ -0,0 +1,55 @@
+//! HOT-17: one launch of a second `aizome-hotaru` must yield one terminal, even
+//! when the first instance takes longer than the 2 s acknowledgement wait to
+//! start serving its socket (a cold start).
+use aizome_hotaru::app::Hotaru;
+use aizome_hotaru::instance::{Claim, claim};
+use aizome_kit::testing::Harness;
+use hotaru_io::PtyCommand;
+use std::os::unix::fs::PermissionsExt;
+use std::time::{Duration, Instant};
+
+#[test]
+fn repro_hot_17_a_timed_out_handoff_does_not_also_open_a_tab_in_the_first_instance() {
+    // A private runtime directory for this test process only.
+    let base = std::env::var_os("XDG_RUNTIME_DIR").map(std::path::PathBuf::from).unwrap_or_else(std::env::temp_dir);
+    let runtime = base.join(format!("hot17-{}", std::process::id()));
+    std::fs::create_dir_all(&runtime).unwrap();
+    std::fs::set_permissions(&runtime, std::fs::Permissions::from_mode(0o700)).unwrap();
+    // SAFETY: this test binary has one test and no other threads yet.
+    unsafe { std::env::set_var("XDG_RUNTIME_DIR", &runtime) };
+
+    // Control: a Hotaru with no instance socket starts with one tab.
+    let mut alone = Harness::new(Hotaru::preview());
+    alone.advance(Duration::ZERO);
+    assert_eq!(alone.program().tabs.len(), 1, "control");
+    drop(alone);
+
+    let command = PtyCommand::shell();
+    // The first instance claims the socket, then is still starting up.
+    let Claim::First(instance) = claim(&command).expect("first claim") else { panic!("first claim forwarded") };
+    // A second launch (another `aizome-hotaru` process; a thread here).
+    let second = std::thread::spawn(move || {
+        let started = Instant::now();
+        let result = claim(&PtyCommand::shell());
+        (started.elapsed(), result.map(|c| matches!(c, Claim::Forwarded)))
+    });
+    let (waited, second) = second.join().unwrap();
+    // main.rs: Err(_) → "Could not join Hotaru's running instance", and the
+    // second process opens its own window.
+    let standalone = !matches!(second, Ok(true));
+    // The first instance finishes starting and serves its socket.
+    let mut app = Hotaru::preview();
+    app.instance = Some(instance);
+    let mut h = Harness::new(app);
+    h.advance(Duration::ZERO);
+    // Its own launch opens one tab; anything more came through the socket.
+    let forwarded_tab = h.settle(Duration::from_secs(2), |app| app.tabs.len() > 1);
+    let tabs = h.program().tabs.len();
+    eprintln!("second claim: {second:?} after {waited:?}; first instance tabs: {tabs}");
+    let _ = std::fs::remove_dir_all(&runtime);
+    assert!(
+        !(standalone && forwarded_tab),
+        "one launch, two terminals: the second claim gave {second:?} after {waited:?} (so it runs standalone) \
+         and the first instance then opened a tab for the same request ({tabs} tabs)"
+    );
+}
diff --git a/desktop/aizome/apps/hotaru/tests/repro_hot_21.rs b/desktop/aizome/apps/hotaru/tests/repro_hot_21.rs
new file mode 100644
index 00000000..095d0b3b
--- /dev/null
+++ b/desktop/aizome/apps/hotaru/tests/repro_hot_21.rs
@@ -0,0 +1,61 @@
+//! HOT-21: when the pane's shell exits, the pane ends ("Session ended", or
+//! closes) promptly, even if a background job it left still holds the PTY.
+use aizome_hotaru::app::Hotaru;
+use aizome_kit::testing::Harness;
+use hotaru_io::PtyCommand;
+use std::time::{Duration, Instant};
+
+/// Kills the background job this test started, whatever the outcome.
+struct Job(std::path::PathBuf);
+impl Drop for Job {
+    fn drop(&mut self) {
+        if let Some(pid) = std::fs::read_to_string(&self.0).ok().and_then(|s| s.trim().parse::<i32>().ok()) {
+            // SAFETY: kill takes plain integers; the pid is our own grandchild.
+            unsafe { libc::kill(pid, libc::SIGKILL) };
+        }
+        let _ = std::fs::remove_file(&self.0);
+    }
+}
+
+#[test]
+fn repro_hot_21_shell_exit_with_a_background_job_ends_the_pane() {
+    let pidfile = std::env::temp_dir().join(format!("hot21-{}.pid", std::process::id()));
+    let _ = std::fs::remove_file(&pidfile);
+    let job = Job(pidfile.clone());
+    // `sleep 30 &` then `exit`, as in an interactive shell whose job control
+    // keeps the job out of the hangup: here the job ignores SIGHUP itself.
+    // It inherits the PTY slave as stdin/stdout/stderr.
+    let script = format!("(trap '' HUP; exec sleep 30) & echo $! > {}.tmp && mv {0}.tmp {0}; exit 0", pidfile.display());
+    let mut command = PtyCommand::new("/bin/sh");
+    command.args = vec!["-c".into(), script.into()];
+    let mut app = Hotaru::new(command);
+    app.settings.wait_after_command = true;
+    let mut h = Harness::new(app);
+    let id = h.program().active_pane().unwrap().id;
+    let until = Instant::now() + Duration::from_secs(5);
+    while !pidfile.exists() {
+        assert!(Instant::now() < until, "the shell never started its job");
+        h.settle(Duration::from_millis(10), |_| false);
+    }
+    let shell_done = Instant::now();
+    let ended = loop {
+        h.advance(Duration::from_millis(5));
+        h.settle(Duration::from_millis(10), |_| false);
+        let pane = h.program().panes.iter().find(|p| p.id == id);
+        if pane.is_none_or(|p| p.ended) {
+            break true;
+        }
+        if shell_done.elapsed() > Duration::from_secs(3) {
+            break false;
+        }
+    };
+    let status = h.program().panes.iter().find(|p| p.id == id).map(|p| p.status.clone());
+    let job_pid = std::fs::read_to_string(&pidfile).unwrap_or_default();
+    drop(job);
+    assert!(
+        ended,
+        "the shell exited, but 3 s later its pane has not ended (status {status:?}); the background job \
+         (pid {}) still holds the PTY slave",
+        job_pid.trim()
+    );
+}
diff --git a/desktop/aizome/apps/hotaru/tests/repro_hot_27.rs b/desktop/aizome/apps/hotaru/tests/repro_hot_27.rs
new file mode 100644
index 00000000..803cb54a
--- /dev/null
+++ b/desktop/aizome/apps/hotaru/tests/repro_hot_27.rs
@@ -0,0 +1,43 @@
+//! HOT-27: once a drag-select's button release goes elsewhere (the compositor
+//! took the pointer: the window sees it leave with the button down), plain
+//! hover with no button held must not go on extending the selection.
+use aizome_hotaru::app::{Hotaru, Msg};
+use aizome_kit::Vec2;
+use aizome_kit::sidestep_ui::PointerButton;
+use aizome_kit::testing::Harness;
+use hotaru_core::Terminal;
+use std::sync::Arc;
+use std::time::Duration;
+
+#[test]
+fn repro_hot_27_hover_after_a_lost_release_does_not_extend_the_selection() {
+    let mut h = Harness::new(Hotaru::preview());
+    let win = h.window();
+    h.advance(Duration::ZERO);
+    let id = h.program().active_pane().unwrap().id;
+    let mut term = Terminal::new(80, 24, 0);
+    term.feed(b"alpha beta gamma delta epsilon zeta eta theta");
+    h.send(Msg::Frame(id, Arc::new(term.snapshot())));
+    assert!(h.settle(Duration::from_secs(5), |app| app
+        .active_pane()
+        .is_some_and(|pane| pane.displayed_snapshot().is_some_and(|shown| Arc::ptr_eq(shown, &pane.snapshot)))));
+    let pane = h.program().active_pane().unwrap();
+    let metrics = pane.font_metrics().unwrap();
+    let origin = h.find_id(win, &format!("terminal-{id}")).unwrap().origin() + Vec2::new(10., 10.);
+    let at = |col: f64| origin + Vec2::new((col + 0.5) * metrics.cell_width(), metrics.cell_height() * 0.4);
+    // Drag-select "alpha".
+    h.press(win, at(0.), PointerButton::Left, 1);
+    h.move_to(win, at(5.));
+    let dragged = h.program().active_pane().unwrap().selection;
+    assert!(dragged.is_some_and(|s| !s.is_empty()), "precondition: the drag selects ({dragged:?})");
+    // The compositor takes the pointer; the release is delivered elsewhere.
+    h.leave(win);
+    // Later the pointer comes back and just hovers: no button is held.
+    h.enter(win, at(20.));
+    h.move_to(win, at(30.));
+    let hovered = h.program().active_pane().unwrap().selection;
+    assert_eq!(
+        hovered, dragged,
+        "plain hover after the lost release moved the selection's end (drag {dragged:?} → hover {hovered:?})"
+    );
+}
diff --git a/desktop/aizome/apps/koe/tests/repro_kko_01.rs b/desktop/aizome/apps/koe/tests/repro_kko_01.rs
new file mode 100644
index 00000000..9f3d54b3
--- /dev/null
+++ b/desktop/aizome/apps/koe/tests/repro_kko_01.rs
@@ -0,0 +1,143 @@
+//! KKO-01: Koe's unit crash-loops on a startup error until systemd's start
+//! limit refuses it. Turning dictation on (`aizome-koe enable`, as the
+//! window's switch does through the same `Session::start`) then sees
+//! `systemctl --user start` fail.
+//!
+//! The real `aizome-koe` program, as the session's service would be (the
+//! default koe.toml and socket, in folders of the test's own), with
+//! stand-in `systemctl` (refusing the start: start-limit-hit) and
+//! `journalctl` (the unit's last fatal error) first on PATH. No user
+//! manager, journal or session bus is asked anything.
+
+use std::os::unix::fs::PermissionsExt;
+use std::path::{Path, PathBuf};
+use std::process::{Command, Output, Stdio};
+use std::time::Duration;
+
+use koe::config::{Backend, Config, OutputMode};
+
+const REASON: &str = "cannot bind the socket: Not a directory (os error 20)";
+
+fn script(path: &Path, body: &str) {
+    std::fs::write(path, body).unwrap();
+    std::fs::set_permissions(path, std::fs::Permissions::from_mode(0o755)).unwrap();
+}
+
+struct Stage {
+    dir: PathBuf,
+}
+
+impl Stage {
+    fn new(name: &str) -> Stage {
+        let dir = std::env::temp_dir().join(format!("koe-repro-kko01-{name}-{}", std::process::id()));
+        let _ = std::fs::remove_dir_all(&dir);
+        for d in ["bin", "home", "config/aizome", "data", "run"] {
+            std::fs::create_dir_all(dir.join(d)).unwrap();
+        }
+        std::fs::set_permissions(dir.join("run"), std::fs::Permissions::from_mode(0o700)).unwrap();
+        let d = dir.display();
+        script(
+            &dir.join("bin/systemctl"),
+            &format!(
+                r#"#!/bin/sh
+echo "systemctl $*" >> '{d}/calls'
+case " $* " in
+  *" start "*) echo 'Job for aizome-koe.service failed because the service was restarted too often.' >&2
+               echo 'See "systemctl --user status aizome-koe.service" and "journalctl --user -xeu aizome-koe.service" for details.' >&2
+               exit 1 ;;
+esac
+exit 0
+"#
+            ),
+        );
+        script(
+            &dir.join("bin/journalctl"),
+            &format!(
+                r#"#!/bin/sh
+echo "journalctl $*" >> '{d}/calls'
+echo 'Koe listening on {d}/run/aizome-koe/control.sock'
+echo 'aizome-koe: {REASON}'
+"#
+            ),
+        );
+        let mut config = Config::default();
+        config.engine.backend = Backend::Http;
+        config.engine.http.endpoint = "http://127.0.0.1:9/inference".into();
+        config.tray.enabled = false;
+        config.output.mode = OutputMode::None;
+        config.output.notify = false;
+        std::fs::write(dir.join("config/aizome/koe.toml"), toml::to_string(&config).unwrap()).unwrap();
+        Stage { dir }
+    }
+
+    fn koe(&self, args: &[&str]) -> Output {
+        let path = std::env::var("PATH").unwrap_or_default();
+        Command::new(env!("CARGO_BIN_EXE_aizome-koe"))
+            .args(args)
+            .env_remove("AIZOME_SOCKET")
+            .env_remove("AIZOME_SHELL_SOCKET")
+            .env_remove("WAYLAND_DISPLAY")
+            .env("PATH", format!("{}:{path}", self.dir.join("bin").display()))
+            .env("HOME", self.dir.join("home"))
+            .env("XDG_CONFIG_HOME", self.dir.join("config"))
+            .env("XDG_DATA_HOME", self.dir.join("data"))
+            .env("XDG_RUNTIME_DIR", self.dir.join("run"))
+            .env("DBUS_SESSION_BUS_ADDRESS", format!("unix:path={}/run/no-bus", self.dir.display()))
+            .stdin(Stdio::null())
+            .output()
+            .unwrap()
+    }
+
+    fn calls(&self) -> String {
+        std::fs::read_to_string(self.dir.join("calls")).unwrap_or_default()
+    }
+
+    fn socket(&self) -> PathBuf {
+        self.dir.join("run/aizome-koe/control.sock")
+    }
+}
+
+impl Drop for Stage {
+    fn drop(&mut self) {
+        // A daemon started outside the unit: shut it down (over its socket).
+        if self.socket().exists() {
+            let _ = self.koe(&["disable"]);
+        }
+        let _ = std::fs::remove_dir_all(&self.dir);
+    }
+}
+
+/// The daemon's startup error is the unit's too: the one started in its
+/// place fails the same way, quietly. What Koe says should be why.
+#[test]
+fn a_refused_start_says_why_the_service_fails() {
+    let stage = Stage::new("why");
+    // The startup error: the socket's folder can't be made.
+    std::fs::write(stage.dir.join("run/aizome-koe"), b"").unwrap();
+    let out = stage.koe(&["enable"]);
+    let stderr = String::from_utf8_lossy(&out.stderr).into_owned();
+    let calls = stage.calls();
+    assert!(calls.contains("systemctl --user start aizome-koe.service"), "{calls}");
+    assert!(!out.status.success());
+    assert!(
+        stderr.contains(REASON) || stderr.contains("restarted too often"),
+        "Koe said only {stderr:?}: neither the unit's journal reason nor systemd's refusal (calls: {calls})"
+    );
+}
+
+/// A unit that exists but is refused: no daemon runs outside it.
+#[test]
+fn a_refused_start_runs_no_daemon_outside_the_unit() {
+    let stage = Stage::new("outside");
+    let out = stage.koe(&["enable"]);
+    let stdout = String::from_utf8_lossy(&out.stdout).into_owned();
+    let stderr = String::from_utf8_lossy(&out.stderr).into_owned();
+    std::thread::sleep(Duration::from_millis(100));
+    let answering = koe::service::running(&stage.socket());
+    assert!(
+        !answering,
+        "systemd refused the unit, yet a daemon answers on the session's socket, started outside it \
+         (stdout {stdout:?}, stderr {stderr:?}, calls {:?})",
+        stage.calls()
+    );
+}
