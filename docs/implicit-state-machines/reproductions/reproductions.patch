diff --git a/desktop/tatami/bluetooth/src/repro_tap_15.rs b/desktop/tatami/bluetooth/src/repro_tap_15.rs
new file mode 100644
index 00000000..c09c2927
--- /dev/null
+++ b/desktop/tatami/bluetooth/src/repro_tap_15.rs
@@ -0,0 +1,157 @@
+// SPDX-License-Identifier: MIT OR Apache-2.0
+//! TAP-15: Bluetooth launched again while its window's close drain runs.
+//! `open` (window.rs:70-74) presents whatever `UI` holds, including the
+//! window the close handler (window.rs:294-326) hid and will destroy.
+//!
+//! A fake BlueZ on a private dbus-daemon (the crate's test bus) holds its
+//! GetManagedObjects reply, so the drain waits for that reading
+//! (window.rs:316-318) as it would for a slow adapter. No host bus or
+//! adapter is used: the first launch's system-bus lookup fails in this
+//! environment and the window is then pointed at the private bus, as
+//! ui_test.rs does. Needs a display (a private Xvfb).
+use super::*;
+use crate::model::Objects;
+use std::{
+    io::{BufRead, BufReader},
+    process::{Child, Command, Stdio},
+    time::Instant,
+};
+
+struct Bus(Child);
+impl Drop for Bus {
+    fn drop(&mut self) {
+        let _ = self.0.kill();
+        let _ = self.0.wait();
+    }
+}
+
+async fn connection(address: &str) -> gio::DBusConnection {
+    gio::DBusConnection::for_address_future(
+        address,
+        gio::DBusConnectionFlags::AUTHENTICATION_CLIENT
+            | gio::DBusConnectionFlags::MESSAGE_BUS_CONNECTION,
+        None,
+    )
+    .await
+    .unwrap()
+}
+
+async fn wait_until(what: &str, ready: impl Fn() -> bool) {
+    let start = Instant::now();
+    while !ready() {
+        assert!(start.elapsed() < Duration::from_secs(8), "timed out: {what}");
+        glib::timeout_future(Duration::from_millis(10)).await;
+    }
+}
+
+fn export(
+    conn: &gio::DBusConnection,
+    path: &str,
+    xml: &str,
+    held: &Rc<RefCell<Vec<gio::DBusMethodInvocation>>>,
+) {
+    let info = gio::DBusNodeInfo::for_xml(xml).unwrap();
+    for interface in info.interfaces() {
+        let held = held.clone();
+        conn.register_object(path, interface)
+            .method_call(move |_, _, _, _, method, _, call| match method {
+                "GetManagedObjects" => held.borrow_mut().push(call),
+                _ => call.return_value(Some(&().to_variant())),
+            })
+            .build()
+            .unwrap();
+    }
+}
+
+#[test]
+fn repro_tap_15_relaunch_during_the_close_drain() {
+    adw::init().unwrap();
+    let context = glib::MainContext::default();
+    let (after_relaunch, in_the_end, destroyed) = context.block_on(async {
+        let mut daemon = Command::new("dbus-daemon")
+            .arg(concat!(
+                "--config-file=",
+                env!("CARGO_MANIFEST_DIR"),
+                "/data/test-bus.conf"
+            ))
+            .args(["--nofork", "--print-address=1"])
+            .stdout(Stdio::piped())
+            .spawn()
+            .unwrap();
+        let mut address = String::new();
+        BufReader::new(daemon.stdout.take().unwrap())
+            .read_line(&mut address)
+            .unwrap();
+        let _bus = Bus(daemon);
+        let client = connection(address.trim()).await;
+        let service = connection(address.trim()).await;
+        let held = Rc::new(RefCell::new(Vec::new()));
+        export(
+            &service,
+            "/",
+            r#"<node><interface name="org.freedesktop.DBus.ObjectManager"><method name="GetManagedObjects"><arg type="a{oa{sa{sv}}}" direction="out"/></method></interface></node>"#,
+            &held,
+        );
+        export(
+            &service,
+            "/org/bluez",
+            r#"<node><interface name="org.bluez.AgentManager1"><method name="RegisterAgent"><arg type="o" direction="in"/><arg type="s" direction="in"/></method><method name="UnregisterAgent"><arg type="o" direction="in"/></method></interface></node>"#,
+            &held,
+        );
+
+        let app = adw::Application::builder()
+            .application_id("org.tatami.Bluetooth.ReproTap15")
+            .flags(gio::ApplicationFlags::NON_UNIQUE)
+            .build();
+        app.register(None::<&gio::Cancellable>).unwrap();
+        // The first launch (main.rs: activate → open).
+        open(&app);
+        let ui = UI.with_borrow(Clone::clone).expect("the window");
+        watch(&ui, &client);
+        let owner = gio::bus_own_name_on_connection(
+            &service,
+            "org.bluez",
+            gio::BusNameOwnerFlags::NONE,
+            |_, _| {},
+            |_, _| {},
+        );
+        wait_until("a reading in flight", || {
+            ui.reading.get() && !held.borrow().is_empty()
+        })
+        .await;
+
+        // The person closes the window; the drain waits for the reading.
+        ui.window.close();
+        wait_until("the window hidden", || !ui.window.is_visible()).await;
+        assert!(ui.closing.get());
+        glib::timeout_future(Duration::from_millis(100)).await;
+
+        // They launch Bluetooth again (activate → open).
+        open(&app);
+        glib::timeout_future(Duration::from_millis(100)).await;
+        let after_relaunch = UI.with_borrow(|slot| {
+            slot.as_ref()
+                .map(|shown| (shown.window.is_visible(), shown.closing.get()))
+        });
+        // The slow reading returns; the drain goes on and ends.
+        for call in held.borrow_mut().drain(..) {
+            call.return_value(Some(&(Objects::new(),).to_variant()));
+        }
+        glib::timeout_future(Duration::from_millis(1500)).await;
+        let in_the_end = UI.with_borrow(|slot| {
+            slot.as_ref()
+                .map(|shown| (shown.window.is_visible(), shown.closing.get()))
+        });
+        let destroyed = !ui.window.is_visible() && ui.window.application().is_none();
+        // Let the fake go before its bus does.
+        gio::bus_unown_name(owner);
+        glib::timeout_future(Duration::from_millis(50)).await;
+        (after_relaunch, in_the_end, destroyed)
+    });
+    assert!(
+        after_relaunch == Some((true, false)) && in_the_end == Some((true, false)),
+        "relaunched during the close drain: (visible, closing) of the window shown \
+         right after = {after_relaunch:?}; 1.5 s later, once the drain ended = \
+         {in_the_end:?}; the window shown destroyed: {destroyed}"
+    );
+}
