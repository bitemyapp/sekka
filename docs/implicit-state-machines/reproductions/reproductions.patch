+++ b/desktop/aizome/crates/aizome-comp-core/src/repro_cpa_32.rs
@@ -0,0 +1,217 @@
+//! CPA-32: the stall watcher's signal must not turn a stall that would
+//! end into one that never does.
+//!
+//! The watcher signals a stalled thread and its handler (`on_signal`)
+//! takes a backtrace, which allocates. If the thread stalled inside the
+//! allocator (holding glibc's arena lock: malloc under memory pressure,
+//! waiting on mmap or brk), the handler's allocation waits for that lock,
+//! held by the same thread, for ever.
+//!
+//! The scenario runs in a child process (it may deadlock): a thread
+//! blocks while holding the arena lock, as a stalled allocation does
+//! (`malloc_stats` holds it while it writes to stderr, here a full pipe).
+//! The child sends it the watcher's signal as `capture` does, then ends
+//! the stall (drains the pipe) and sees whether the thread comes back.
+//! `GLIBC_TUNABLES=glibc.malloc.arena_max=1` gives that thread the main
+//! arena, the one the compositor's main thread always uses. A control run
+//! without the signal shows the stall ends by itself.
+
+use std::process::{Command, Stdio};
+use std::sync::atomic::{AtomicBool, AtomicI32, Ordering};
+use std::time::{Duration, Instant};
+
+use super::{CAPTURED, install_handler, signal};
+
+const CHILD_ENV: &str = "REPRO_CPA_32_CHILD";
+
+static STUCK_TID: AtomicI32 = AtomicI32::new(0);
+static GO: AtomicBool = AtomicBool::new(false);
+static DONE: AtomicBool = AtomicBool::new(false);
+static PROBE_GO: AtomicBool = AtomicBool::new(false);
+static PROBE_DONE: AtomicBool = AtomicBool::new(false);
+
+unsafe extern "C" {
+    fn malloc_stats();
+}
+
+/// Writes without allocating (the arena may be locked).
+fn say(s: &[u8]) {
+    // Safety: writing a valid buffer to stdout.
+    unsafe {
+        libc::write(1, s.as_ptr().cast(), s.len());
+    }
+}
+
+/// Reads a small /proc file into a stack buffer, without allocating.
+fn read_small(path: &[u8], buf: &mut [u8]) -> usize {
+    // Safety: a NUL-terminated path and a buffer we own.
+    unsafe {
+        let fd = libc::open(path.as_ptr().cast(), libc::O_RDONLY);
+        if fd < 0 {
+            return 0;
+        }
+        let n = libc::read(fd, buf.as_mut_ptr().cast(), buf.len());
+        libc::close(fd);
+        n.max(0) as usize
+    }
+}
+
+#[inline(never)]
+fn deep(n: u32) {
+    if n == 0 {
+        // Safety: glibc's malloc_stats has no preconditions.
+        unsafe { malloc_stats() };
+        DONE.store(true, Ordering::SeqCst);
+    } else {
+        deep(n - 1);
+        std::hint::black_box(n);
+    }
+}
+
+/// The child: `send_signal` says whether the watcher's signal is sent.
+fn child(send_signal: bool) -> ! {
+    install_handler();
+    // stderr is a pipe nobody reads, filled to the brim.
+    let mut fds = [0; 2];
+    // Safety: plain pipe and fcntl calls on our own descriptors.
+    unsafe {
+        assert_eq!(libc::pipe(fds.as_mut_ptr()), 0);
+        libc::dup2(fds[1], 2);
+        let fl = libc::fcntl(2, libc::F_GETFL);
+        libc::fcntl(2, libc::F_SETFL, fl | libc::O_NONBLOCK);
+        let chunk = [b'x'; 4096];
+        while libc::write(2, chunk.as_ptr().cast(), chunk.len()) > 0 {}
+        while libc::write(2, chunk.as_ptr().cast(), 1) > 0 {}
+        libc::fcntl(2, libc::F_SETFL, fl);
+        let rfl = libc::fcntl(fds[0], libc::F_GETFL);
+        libc::fcntl(fds[0], libc::F_SETFL, rfl | libc::O_NONBLOCK);
+    }
+    std::thread::spawn(|| {
+        // Safety: gettid has no preconditions.
+        STUCK_TID.store(unsafe { libc::gettid() }, Ordering::SeqCst);
+        while !GO.load(Ordering::SeqCst) {
+            std::thread::sleep(Duration::from_millis(5));
+        }
+        deep(40);
+    });
+    // A probe that allocates past the thread cache (64 KiB, from the
+    // arena) once told to: it finishes at once unless the arena is locked.
+    std::thread::spawn(|| {
+        while !PROBE_GO.load(Ordering::SeqCst) {
+            std::thread::sleep(Duration::from_millis(5));
+        }
+        // Safety: a plain malloc and free.
+        unsafe { libc::free(libc::malloc(64 * 1024)) };
+        PROBE_DONE.store(true, Ordering::SeqCst);
+    });
+    while STUCK_TID.load(Ordering::SeqCst) == 0 {
+        std::thread::sleep(Duration::from_millis(5));
+    }
+    let tid = STUCK_TID.load(Ordering::SeqCst);
+    let mut syscall_path = format!("/proc/self/task/{tid}/syscall").into_bytes();
+    syscall_path.push(0);
+    let mut wchan_path = format!("/proc/self/task/{tid}/wchan").into_bytes();
+    wchan_path.push(0);
+    // From here on nothing on this thread allocates.
+    GO.store(true, Ordering::SeqCst);
+    // Wait until it sits in write(2) (syscall 1) inside malloc_stats, the
+    // arena lock held: a stall.
+    let mut buf = [0u8; 256];
+    let start = Instant::now();
+    loop {
+        let n = read_small(&syscall_path, &mut buf);
+        if n >= 2 && &buf[..2] == b"1 " {
+            break;
+        }
+        if start.elapsed() > Duration::from_secs(5) {
+            say(b"RESULT never-blocked\n");
+            // Safety: exiting the child.
+            unsafe { libc::_exit(4) };
+        }
+        std::thread::sleep(Duration::from_millis(5));
+    }
+    std::thread::sleep(Duration::from_millis(100));
+    PROBE_GO.store(true, Ordering::SeqCst);
+    std::thread::sleep(Duration::from_millis(300));
+    let lock_held = !PROBE_DONE.load(Ordering::SeqCst);
+    if send_signal {
+        // What `capture` does to the stalled main thread.
+        CAPTURED.store(false, Ordering::SeqCst);
+        // Safety: tgkill to a thread of ours with a signal we handle.
+        unsafe {
+            libc::syscall(libc::SYS_tgkill, libc::getpid(), tid, signal());
+        }
+        let waited = Instant::now();
+        while !CAPTURED.load(Ordering::SeqCst) && waited.elapsed() < Duration::from_millis(800) {
+            std::thread::sleep(Duration::from_millis(10));
+        }
+    }
+    // The stall ends: the pipe drains.
+    let end = Instant::now();
+    while end.elapsed() < Duration::from_secs(3) && !DONE.load(Ordering::SeqCst) {
+        // Safety: reading into a stack buffer from our pipe.
+        unsafe {
+            while libc::read(fds[0], buf.as_mut_ptr().cast(), buf.len()) > 0 {}
+        }
+        std::thread::sleep(Duration::from_millis(5));
+    }
+    let captured = CAPTURED.load(Ordering::SeqCst);
+    let n = read_small(&wchan_path, &mut buf);
+    say(if DONE.load(Ordering::SeqCst) { &b"RESULT recovered"[..] } else { b"RESULT stuck" });
+    say(if captured { &b" captured=yes"[..] } else { b" captured=no" });
+    say(if lock_held { &b" arena-lock-held-in-stall=yes"[..] } else { b" arena-lock-held-in-stall=no" });
+    say(b" wchan=");
+    say(&buf[..n]);
+    say(b"\n");
+    // Safety: exiting the child (its stuck thread with it).
+    unsafe { libc::_exit(0) };
+}
+
+fn run_child(send_signal: bool) -> String {
+    let me = std::env::current_exe().unwrap();
+    let name = module_path!().split_once("::").map(|(_, m)| m).unwrap_or(module_path!());
+    let test = format!("{name}::repro_cpa_32_the_stall_signal_does_not_freeze_a_thread_in_the_allocator");
+    let mut child = Command::new(me)
+        .args(["--exact", &test, "--nocapture", "--test-threads=1"])
+        .env(CHILD_ENV, if send_signal { "signal" } else { "control" })
+        .env("GLIBC_TUNABLES", "glibc.malloc.arena_max=1")
+        .stdin(Stdio::null())
+        .stdout(Stdio::piped())
+        .stderr(Stdio::null())
+        .spawn()
+        .unwrap();
+    // The child ends itself within ~10 s; past 20 s it is killed (it is
+    // our own child).
+    let deadline = Instant::now() + Duration::from_secs(20);
+    while child.try_wait().unwrap().is_none() {
+        if Instant::now() > deadline {
+            let _ = child.kill();
+            break;
+        }
+        std::thread::sleep(Duration::from_millis(50));
+    }
+    let out = child.wait_with_output().unwrap();
+    let text = String::from_utf8_lossy(&out.stdout).into_owned();
+    // libtest's "test … " has no newline before the child's own words.
+    text.find("RESULT")
+        .and_then(|i| text[i..].lines().next())
+        .unwrap_or("RESULT none (child killed or silent)")
+        .to_string()
+}
+
+#[test]
+fn repro_cpa_32_the_stall_signal_does_not_freeze_a_thread_in_the_allocator() {
+    match std::env::var(CHILD_ENV).as_deref() {
+        Ok("signal") => child(true),
+        Ok("control") => child(false),
+        _ => {}
+    }
+    let control = run_child(false);
+    assert!(control.starts_with("RESULT recovered"), "the control stall didn't end by itself: {control}");
+    let signalled = run_child(true);
+    eprintln!("control: {control}\nwith the watcher's signal: {signalled}");
+    assert!(
+        signalled.starts_with("RESULT recovered"),
+        "the watcher's signal turned a stall that ends into a permanent one: {signalled} (control: {control})"
+    );
+}
