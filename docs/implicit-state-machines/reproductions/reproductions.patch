@@ -0,0 +1,75 @@
+//! UIW-11: scroll bars shown by scrolling go once scrolling has stopped a
+//! while, also after a gesture of several scroll events.
+//!
+//! The widgets read the wall clock (`Instant::now()`), so the test moves
+//! the harness clock and the wall clock together, in small steps.
+
+use std::time::Duration;
+
+use aizome_kit::prelude::*;
+use aizome_kit::testing::Harness;
+
+struct Rows;
+
+#[derive(Clone, Debug)]
+enum Msg {}
+
+impl Program for Rows {
+    type Msg = Msg;
+    fn info(&self) -> AppInfo {
+        AppInfo::new("org.aizome.ReproUiw11", "Repro", "Repro")
+    }
+    fn launched(&mut self, cx: &mut Cx<Msg>) {
+        cx.open_window(WindowSpec::new("Rows").size(400.0, 300.0));
+    }
+    fn update(&mut self, _msg: Msg, _cx: &mut Cx<Msg>) {}
+    fn view(&self, _w: WindowKey) -> Element<Msg> {
+        virtual_list(1000, 24.0, |i| text(format!("row {i}"))).id("view").into()
+    }
+}
+
+/// Let `ms` pass on both clocks, firing the timers that come due.
+fn wait(h: &mut Harness<Rows>, ms: u64) {
+    for _ in 0..ms / 10 {
+        std::thread::sleep(Duration::from_millis(10));
+        h.advance(Duration::from_millis(10));
+    }
+}
+
+fn setup() -> (Harness<Rows>, WindowKey, Point) {
+    let mut h = Harness::new(Rows);
+    let w = h.window();
+    h.focus_window(w, true);
+    h.check_frame(w);
+    // Over the rows, away from the bar.
+    let r = h.find_id(w, "view").unwrap();
+    (h, w, Point::new(r.x0 + 60.0, r.center().y))
+}
+
+#[test]
+fn repro_uiw_11_control_one_scroll_event_hides_the_bar() {
+    let (mut h, w, at) = setup();
+    h.scroll(w, at, Vec2::new(0.0, 30.0));
+    assert_eq!(h.check_frame(w).differs, 0.0);
+    wait(&mut h, 2000);
+    let c = h.check_frame(w);
+    println!("one event: {c:?}");
+    assert_eq!(c.differs, 0.0, "the bar was drawn away: {c:?}");
+}
+
+#[test]
+fn repro_uiw_11_a_two_event_scroll_hides_the_bar_too() {
+    let (mut h, w, at) = setup();
+    h.scroll(w, at, Vec2::new(0.0, 30.0));
+    assert_eq!(h.check_frame(w).differs, 0.0);
+    // A second event 100 ms on (a touchpad gesture sends dozens).
+    wait(&mut h, 100);
+    h.scroll(w, at, Vec2::new(0.0, 30.0));
+    assert_eq!(h.check_frame(w).differs, 0.0);
+    // The bar lingers 900 ms after the last event; well past that it must
+    // have been drawn away.
+    wait(&mut h, 2000);
+    let c = h.check_frame(w);
+    println!("two events: {c:?} (differs: share of pixels the composed frame gets wrong)");
+    assert_eq!(c.differs, 0.0, "the scroll bar stays drawn after it should have gone: {c:?}");
+}
diff --git a/desktop/aizome/crates/aizome-kit/tests/repro_uiw_15.rs b/desktop/aizome/crates/aizome-kit/tests/repro_uiw_15.rs
