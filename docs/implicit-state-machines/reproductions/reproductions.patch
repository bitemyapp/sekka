@@ -0,0 +1,35 @@
+//! HCO-18: with no explicit DECSCUSR in force, the cursor follows the
+//! configured default, including a default changed while the program was on
+//! the alternate screen.
+use hotaru_core::{CursorShape, Terminal};
+
+#[test]
+fn repro_hco_18_default_cursor_changed_on_the_alternate_screen_reaches_the_primary() {
+    let mut terminal = Terminal::new(20, 4, 0);
+    terminal.set_default_cursor(CursorShape::Block, false);
+    assert_eq!(terminal.snapshot().cursor.shape, CursorShape::Block);
+    // vim/less enters the 1049 alternate screen; it never sends DECSCUSR.
+    terminal.feed(b"\x1b[?1049h");
+    // The user changes Hotaru's cursor preference (session.rs set_default_cursor).
+    terminal.set_default_cursor(CursorShape::Bar, false);
+    assert_eq!(terminal.snapshot().cursor.shape, CursorShape::Bar, "alternate screen follows");
+    // The program exits back to the shell.
+    terminal.feed(b"\x1b[?1049l");
+    assert_eq!(
+        terminal.snapshot().cursor.shape,
+        CursorShape::Bar,
+        "primary screen keeps the old default though no DECSCUSR is in force"
+    );
+}
+
+/// The entry's hazard, against `Terminal::set_default_cursor`'s documentation
+/// ("DEC mode 12 may still override blinking independently").
+#[test]
+fn repro_hco_18_default_change_keeps_a_programs_mode_12_blink() {
+    let mut terminal = Terminal::new(20, 4, 0);
+    terminal.set_default_cursor(CursorShape::Block, false);
+    terminal.feed(b"\x1b[?12h");
+    assert!(terminal.snapshot().cursor.blinking, "precondition: DECSET 12 blinks");
+    terminal.set_default_cursor(CursorShape::Underline, false);
+    assert!(terminal.snapshot().cursor.blinking, "a default change undid the program's DECSET 12");
+}
diff --git a/apps/hotaru/crates/hotaru-io/tests/repro_hco_24.rs b/apps/hotaru/crates/hotaru-io/tests/repro_hco_24.rs
new file mode 100644
index 00000000..16f214b0
--- /dev/null
+++ b/apps/hotaru/crates/hotaru-io/tests/repro_hco_24.rs
@@ -0,0 +1,34 @@
+//! HCO-24: a transient failure to start the process-wide child reaper (EAGAIN
+//! at thread creation) must not make every later `Pty::spawn` fail once the
+//! condition has cleared. This binary holds one test: the reaper is a
+//! process-wide `OnceLock`, so nothing else may spawn a PTY first.
+use hotaru_io::{Pty, PtyCommand, PtySize};
+
+fn command() -> PtyCommand {
+    let mut command = PtyCommand::new("/bin/sh");
+    command.args = vec!["-c".into(), "exit 0".into()];
+    command
+}
+
+#[test]
+fn repro_hco_24_spawn_recovers_after_a_transient_thread_creation_failure() {
+    let mut original = libc::rlimit { rlim_cur: 0, rlim_max: 0 };
+    // SAFETY: getrlimit/setrlimit write and read plain structs owned here.
+    // RLIMIT_NPROC is this process's own limit: lowering it makes only this
+    // process's clone() calls (threads, forks) fail with EAGAIN.
+    assert_eq!(unsafe { libc::getrlimit(libc::RLIMIT_NPROC, &mut original) }, 0);
+    let lowered = libc::rlimit { rlim_cur: 0, rlim_max: original.rlim_max };
+    assert_eq!(unsafe { libc::setrlimit(libc::RLIMIT_NPROC, &lowered) }, 0);
+    let first = Pty::spawn(command(), PtySize::default());
+    // The transient condition clears.
+    assert_eq!(unsafe { libc::setrlimit(libc::RLIMIT_NPROC, &original) }, 0);
+    let first = first.err().expect("could not provoke a thread-creation failure (RLIMIT_NPROC not enforced here)");
+    // Thread creation works again in this process.
+    std::thread::spawn(|| ()).join().unwrap();
+    let second = Pty::spawn(command(), PtySize::default());
+    assert!(
+        second.is_ok(),
+        "after the condition cleared, spawn still fails: {:?} (the first failure was {first:?})",
+        second.as_ref().err()
+    );
+}
diff --git a/apps/hotaru/crates/hotaru-io/tests/repro_hco_26.rs b/apps/hotaru/crates/hotaru-io/tests/repro_hco_26.rs
new file mode 100644
index 00000000..bbb75952
--- /dev/null
+++ b/apps/hotaru/crates/hotaru-io/tests/repro_hco_26.rs
@@ -0,0 +1,117 @@
+//! HCO-26: after a nested program (here a nested integrated Bash) reports
+//! another directory with OSC 7 and exits, the outer shell's next prompt must
+//! report its own directory again, so the terminal's last report is the shell
+//! the user is back in. Real Bash and the real hotaru.bash in a disposable
+//! home; the system bashrc is skipped (NOSYSBASHRC) so no host config runs.
+use hotaru_core::{Terminal, TerminalEvent};
+use hotaru_io::{Pty, PtyCommand, PtySize};
+use std::io;
+use std::path::PathBuf;
+use std::time::{Duration, Instant};
+
+fn bash() -> Option<PathBuf> {
+    std::env::var_os("PATH").and_then(|path| {
+        std::env::split_paths(&path).map(|dir| dir.join("bash")).find(|candidate| candidate.is_file())
+    })
+}
+
+#[test]
+fn repro_hco_26_outer_prompt_reports_its_directory_after_a_nested_report() {
+    let resources = PathBuf::from(env!("CARGO_MANIFEST_DIR")).join("../../resources").canonicalize().unwrap();
+    let root = std::env::temp_dir().join(format!("hco26-{}", std::process::id()));
+    let _ = std::fs::remove_dir_all(&root);
+    let (home, src, other) = (root.join("home"), root.join("src"), root.join("other"));
+    for dir in [&home, &src, &other] {
+        std::fs::create_dir_all(dir).unwrap();
+    }
+    std::fs::write(home.join(".bashrc"), "PS1='HOTARU> '\n").unwrap();
+    let bash = bash().expect("bash on PATH");
+    // What Hotaru launches for a default Bash: integrate_shell adds
+    // --rcfile rc.bash, which sources ~/.bashrc and then hotaru.bash.
+    let mut command = PtyCommand::new(&bash);
+    command.integrate_shell = true;
+    command.cwd = Some(src.clone());
+    command.env = vec![
+        ("HOME".into(), home.clone().into()),
+        ("HOTARU_RESOURCES_DIR".into(), resources.clone().into()),
+        ("NOSYSBASHRC".into(), "1".into()),
+        ("HISTFILE".into(), "/dev/null".into()),
+    ];
+    let nested = format!(
+        "{} --rcfile {}/shell-integration/bash/rc.bash -i\n",
+        bash.display(),
+        resources.display()
+    );
+    // One line per prompt: the nested integrated shell, its cd, its exit,
+    // then the outer shell's exit once the outer prompt is back.
+    let steps: Vec<String> =
+        vec![nested, format!("cd {}\n", other.display()), "exit\n".into(), "exit\n".into()];
+    let mut pty = Pty::spawn(command, PtySize::default()).unwrap();
+    let mut terminal = Terminal::new(80, 24, 0);
+    let mut output = Vec::new();
+    let mut reports: Vec<(usize, String)> = Vec::new(); // (prompts seen before it, uri)
+    let mut prompts = 0;
+    let mut sent = 0;
+    let mut pending: Vec<u8> = Vec::new();
+    let mut buffer = [0u8; 8192];
+    let deadline = Instant::now() + Duration::from_secs(10);
+    loop {
+        assert!(Instant::now() < deadline, "shell timed out: {}", String::from_utf8_lossy(&output));
+        match pty.read(&mut buffer) {
+            Ok(0) => break,
+            Ok(n) => {
+                output.extend_from_slice(&buffer[..n]);
+                terminal.feed(&buffer[..n]);
+                pending.extend(terminal.take_responses());
+                for event in terminal.take_events() {
+                    if let TerminalEvent::WorkingDirectory(uri) = event {
+                        reports.push((prompts, uri));
+                    }
+                }
+                prompts = output.windows(8).filter(|w| w == b"HOTARU> ").count();
+            }
+            Err(error) if error.kind() == io::ErrorKind::WouldBlock => {}
+            Err(error) if error.raw_os_error() == Some(libc::EIO) => break,
+            Err(error) => panic!("{error}"),
+        }
+        if !pending.is_empty() {
+            if let Ok(n) = pty.write(&pending) {
+                pending.drain(..n);
+            }
+        } else if sent < steps.len() && prompts > sent {
+            pty.write(steps[sent].as_bytes()).unwrap();
+            sent += 1;
+        }
+        if sent == steps.len() && pty.try_wait().unwrap().is_some() {
+            while let Ok(n) = pty.read(&mut buffer) {
+                if n == 0 {
+                    break;
+                }
+                terminal.feed(&buffer[..n]);
+            }
+            for event in terminal.take_events() {
+                if let TerminalEvent::WorkingDirectory(uri) = event {
+                    reports.push((prompts, uri));
+                }
+            }
+            break;
+        }
+        std::thread::sleep(Duration::from_millis(2));
+    }
+    let _ = std::fs::remove_dir_all(&root);
+    let path = |uri: &str| uri.strip_prefix("file://").and_then(|rest| rest.find('/').map(|at| rest[at..].to_string()));
+    let paths: Vec<(usize, Option<String>)> = reports.iter().map(|(n, uri)| (*n, path(uri))).collect();
+    let src = src.display().to_string();
+    let other = other.display().to_string();
+    assert!(paths.iter().any(|(_, p)| p.as_deref() == Some(&src)), "outer shell never reported: {paths:?}");
+    assert!(paths.iter().any(|(_, p)| p.as_deref() == Some(&other)), "nested shell never reported: {paths:?}");
+    // Reports made once the outer prompt is back (4 prompts: outer, nested,
+    // nested after cd, outer again), i.e. the terminal's last word.
+    let last = paths.last().and_then(|(_, p)| p.clone());
+    assert_eq!(
+        last.as_deref(),
+        Some(src.as_str()),
+        "back at the outer prompt in {src} ({prompts} prompts shown), the terminal's last OSC 7 still names \
+         the nested shell's {other}; reports (prompts seen before it, path): {paths:?}"
+    );
+}
diff --git a/apps/hotaru/tools/repro_htt_10.py b/apps/hotaru/tools/repro_htt_10.py
new file mode 100644
index 00000000..5b1d6f4b
--- /dev/null
+++ b/apps/hotaru/tools/repro_htt_10.py
@@ -0,0 +1,142 @@
+#!/usr/bin/env python3
+"""HTT-10 reproduction: a frame-benchmark run stopped by SIGINT (frame-matrix's
+600 s timeout path, frame-matrix.py run_trial) must not leave a result.json
+that still says "running".
+
+Runs the real frame-benchmark.py main()/run() as frame-matrix does (its own
+session, a private --lock), with every child replaced by a local stub on PATH:
+no D-Bus, compositor, observer build, terminal or workstation lock is used.
+Stubs: dbus-daemon and sway only create their sockets; the observer (returned
+by a patched build_observer) prints "ready"; the "application" records that it
+started and waits. The driver then sends SIGINT while the harness waits for the
+fixture connection, exactly as frame-matrix's timeout does.
+"""
+import json
+import os
+from pathlib import Path
+import shutil
+import signal
+import subprocess
+import sys
+import tempfile
+import time
+
+TOOLS = Path(__file__).resolve().parent
+PY = sys.executable
+
+DBUS = f"""#!{PY}
+import os, re, signal, socket, sys
+config = next(a.split("=", 1)[1] for a in sys.argv if a.startswith("--config-file="))
+path = re.search(r"<listen>unix:path=(.*?)</listen>", open(config).read()).group(1)
+s = socket.socket(socket.AF_UNIX); s.bind(path); s.listen(1)
+open(os.environ["REPRO_PIDS"] + "/dbus", "w").write(str(os.getpid()))
+signal.pause()
+"""
+SWAY = f"""#!{PY}
+import os, signal, socket
+runtime = os.environ["XDG_RUNTIME_DIR"]
+held = []
+for name in ("wayland-1", "sway-ipc.1000.1.sock"):
+    s = socket.socket(socket.AF_UNIX); s.bind(os.path.join(runtime, name)); s.listen(1); held.append(s)
+open(os.environ["REPRO_PIDS"] + "/sway", "w").write(str(os.getpid()))
+signal.pause()
+"""
+OBSERVER = f"""#!{PY}
+import json, os, sys, time
+open(os.environ["REPRO_PIDS"] + "/observer", "w").write(str(os.getpid()))
+sys.stdout.write(json.dumps({{"event": "ready"}}) + "\\n"); sys.stdout.flush()
+for line in sys.stdin:
+    pass
+time.sleep(3600)
+"""
+APP = f"""#!{PY}
+import os, signal
+open(os.environ["REPRO_PIDS"] + "/application", "w").write(str(os.getpid()))
+signal.pause()
+"""
+SHIM = """
+import importlib.util, sys
+from pathlib import Path
+tools, observer = sys.argv[1], sys.argv[2]
+spec = importlib.util.spec_from_file_location("frame_benchmark", tools + "/frame-benchmark.py")
+bench = importlib.util.module_from_spec(spec); spec.loader.exec_module(bench)
+def build_observer(directory, overrides=None):
+    directory.mkdir(parents=True, exist_ok=True)
+    return Path(observer)
+bench.build_observer = build_observer
+sys.argv = ["frame-benchmark.py", *sys.argv[3:]]
+bench.main()
+"""
+
+
+def stub(directory, name, text):
+    path = directory / name
+    path.write_text(text)
+    path.chmod(0o755)
+    return path
+
+
+def main():
+    work = Path(tempfile.mkdtemp(prefix="htt10-"))
+    bin_dir, pids, fonts = work / "bin", work / "pids", work / "fonts"
+    for d in (bin_dir, pids, fonts):
+        d.mkdir()
+    stub(bin_dir, "dbus-daemon", DBUS)
+    stub(bin_dir, "sway", SWAY)
+    observer = stub(work, "observer", OBSERVER)
+    app = stub(work, "application", APP)
+    output = work / "run"
+    args = ["hotaru", str(app), "--output", str(output), "--font-dir", str(fonts), "--fallback-dir", str(fonts),
+            "--lock", str(work / "child.lock"), "--keys", "1", "--frames", "1", "--control-seconds", ".1",
+            "--app-cpus", "0", "--compositor-cpus", "1", "--observer-cpus", "2", "--controller-cpus", "3",
+            "--fixture-cpus", "4"]
+    env = dict(os.environ, PATH=f"{bin_dir}:{os.environ['PATH']}", REPRO_PIDS=str(pids))
+    with (work / "controller.log").open("wb") as log:
+        harness = subprocess.Popen([PY, "-c", SHIM, str(TOOLS), str(observer), *args], env=env,
+                                   stdout=log, stderr=subprocess.STDOUT, start_new_session=True)
+    try:
+        end = time.monotonic() + 30
+        while not (pids / "application").exists():
+            if harness.poll() is not None or time.monotonic() > end:
+                raise SystemExit("harness never reached the application launch:\n" + (work / "controller.log").read_text())
+            time.sleep(.05)
+        time.sleep(.3)  # the harness is now blocked in listener.accept()
+        # frame-matrix.py run_trial, after process.wait(timeout=600) expires:
+        harness.send_signal(signal.SIGINT)
+        code = harness.wait(timeout=20)
+        log_text = (work / "controller.log").read_text()
+        result_path = output / "result.json"
+        result = json.loads(result_path.read_text()) if result_path.exists() else None
+        print(f"harness exit code: {code}")
+        frames = [line.strip() for line in log_text.splitlines() if "frame-benchmark.py\", line" in line]
+        print("interrupted at:", frames[-1] if frames else None, "|", log_text.strip().splitlines()[-1])
+        print("result.json status:", None if result is None else result["status"],
+              "| error:", None if result is None else result.get("error"))
+        def alive(name):
+            try:
+                return str(work).encode() in Path(f"/proc/{(pids / name).read_text()}/cmdline").read_bytes()
+            except OSError:
+                return False
+        left = [name for name in os.listdir(pids) if alive(name)]
+        print("stub processes still running after the harness exited:", left)
+        assert result is not None, "no result.json written"
+        assert result["status"] != "running", (
+            f'an interrupted run is recorded as status "running" (exit code {code}), not failed/interrupted')
+        print("PASS")
+    finally:
+        if harness.poll() is None:
+            os.killpg(harness.pid, signal.SIGKILL)
+            harness.wait()
+        for name in os.listdir(pids):
+            pid = int((pids / name).read_text())
+            try:
+                # Only a live stub of this run (its command line names our work dir).
+                if str(work).encode() in Path(f"/proc/{pid}/cmdline").read_bytes():
+                    os.kill(pid, signal.SIGKILL)
+            except OSError:
+                pass
+        shutil.rmtree(work, ignore_errors=True)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/apps/hotaru/tools/repro_htt_14.py b/apps/hotaru/tools/repro_htt_14.py
