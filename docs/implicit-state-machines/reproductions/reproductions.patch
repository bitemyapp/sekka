diff --git a/desktop/aizome/crates/aizome-sys/src/repro_sya_17.rs b/desktop/aizome/crates/aizome-sys/src/repro_sya_17.rs
new file mode 100644
index 00000000..e8e1dbc2
--- /dev/null
+++ b/desktop/aizome/crates/aizome-sys/src/repro_sya_17.rs
@@ -0,0 +1,165 @@
+//! SYA-17: the level meter's thread ends on every error (the sound server
+//! leaving among them) without putting its level back to 0, and nothing
+//! starts it again: an owner polling `level()` (Settei's Sound pane, which
+//! makes a new meter only when the default input's name changes) shows the
+//! last peak, frozen, and the meter never follows the input again.
+//!
+//! A private PipeWire with its own pipewire-pulse (null devices, no session
+//! manager, no hardware), as in `tests/audio.rs`. With no session manager
+//! nothing links or drives the graph, so the server sends no peaks here:
+//! the last peak is put in the meter's level by hand, where its read
+//! callback would have put it.
+
+use super::*;
+use std::path::PathBuf;
+use std::process::{Child, Command, Stdio};
+use std::time::{Duration, Instant};
+
+fn eventually(wait: Duration, mut condition: impl FnMut() -> bool) -> bool {
+    let start = Instant::now();
+    while start.elapsed() < wait {
+        if condition() {
+            return true;
+        }
+        std::thread::sleep(Duration::from_millis(20));
+    }
+    condition()
+}
+
+struct PrivatePipeWire {
+    pipewire: Option<Child>,
+    pulse: Option<Child>,
+    dir: PathBuf,
+}
+
+impl PrivatePipeWire {
+    fn start(tag: &str) -> PrivatePipeWire {
+        let dir = PathBuf::from(format!("/tmp/repro-sya17-{tag}-{}", std::process::id()));
+        std::fs::create_dir_all(&dir).unwrap();
+        std::fs::write(
+            dir.join("daemon.conf"),
+            "context.properties = { core.daemon = true core.name = pipewire-0 support.dbus = false }\n\
+             context.spa-libs = { audio.convert.* = audioconvert/libspa-audioconvert support.* = support/libspa-support }\n\
+             context.modules = [\n\
+               { name = libpipewire-module-protocol-native }\n\
+               { name = libpipewire-module-access }\n\
+               { name = libpipewire-module-metadata }\n\
+               { name = libpipewire-module-spa-node-factory }\n\
+               { name = libpipewire-module-client-node }\n\
+               { name = libpipewire-module-adapter }\n\
+               { name = libpipewire-module-link-factory }\n\
+             ]\n\
+             context.objects = [\n\
+               { factory = metadata args = { metadata.name = default metadata.values = [ \
+                  { key = default.audio.source value = { name = test-mic } } ] } }\n\
+               { factory = adapter args = { factory.name = support.null-audio-sink node.name = \"test-mic\" \
+                  node.description = \"Test Mic\" media.class = \"Audio/Source/Virtual\" audio.position = [ MONO ] } }\n\
+             ]\n",
+        )
+        .unwrap();
+        std::fs::write(
+            dir.join("pulse.conf"),
+            format!(
+                "context.properties = {{ support.dbus = false }}\n\
+                 context.spa-libs = {{ audio.convert.* = audioconvert/libspa-audioconvert support.* = support/libspa-support }}\n\
+                 context.modules = [\n\
+                   {{ name = libpipewire-module-protocol-native }}\n\
+                   {{ name = libpipewire-module-client-node }}\n\
+                   {{ name = libpipewire-module-adapter }}\n\
+                   {{ name = libpipewire-module-metadata }}\n\
+                   {{ name = libpipewire-module-protocol-pulse }}\n\
+                 ]\n\
+                 pulse.properties = {{ server.address = [ \"unix:{}/pulse.sock\" ] }}\n",
+                dir.display()
+            ),
+        )
+        .unwrap();
+        let mut pw = PrivatePipeWire { pipewire: None, pulse: None, dir: dir.clone() };
+        pw.pipewire = Some(pw.command("pipewire").arg("-c").arg(dir.join("daemon.conf")).spawn().expect("pipewire"));
+        assert!(eventually(Duration::from_secs(5), || dir.join("pipewire-0").exists()), "pipewire started");
+        pw.start_pulse();
+        pw
+    }
+
+    fn start_pulse(&mut self) {
+        let _ = std::fs::remove_file(self.dir.join("pulse.sock"));
+        let child = self.command("pipewire-pulse").arg("-c").arg(self.dir.join("pulse.conf")).spawn();
+        self.pulse = Some(child.expect("pipewire-pulse"));
+        let sock = self.dir.join("pulse.sock");
+        assert!(eventually(Duration::from_secs(5), || sock.exists()), "pipewire-pulse started");
+    }
+
+    /// pipewire-pulse goes (restarted by systemd, or crashed).
+    fn stop_pulse(&mut self) {
+        if let Some(mut c) = self.pulse.take() {
+            let _ = c.kill();
+            let _ = c.wait();
+        }
+    }
+
+    fn command(&self, program: &str) -> Command {
+        let mut c = Command::new(program);
+        c.env("XDG_RUNTIME_DIR", &self.dir)
+            .env("PIPEWIRE_RUNTIME_DIR", &self.dir)
+            .env("DBUS_SESSION_BUS_ADDRESS", "disabled:")
+            .env_remove("PIPEWIRE_REMOTE")
+            .stdin(Stdio::null())
+            .stdout(Stdio::null())
+            .stderr(Stdio::null());
+        c
+    }
+
+    /// Whether a client of PipeWire's (through pipewire-pulse) is called `name`.
+    fn has_client(&self, name: &str) -> bool {
+        let out = self.command("pw-cli").args(["-r", "pipewire-0", "ls", "Client"]).stdout(Stdio::piped()).output();
+        let listing = String::from_utf8_lossy(&out.expect("pw-cli").stdout).into_owned();
+        let want = format!("application.name = \"{name}\"");
+        listing.lines().any(|l| l.trim() == want)
+    }
+
+    fn server(&self) -> String {
+        format!("unix:{}/pulse.sock", self.dir.display())
+    }
+}
+
+impl Drop for PrivatePipeWire {
+    fn drop(&mut self) {
+        self.stop_pulse();
+        if let Some(mut c) = self.pipewire.take() {
+            let _ = c.kill();
+            let _ = c.wait();
+        }
+        let _ = std::fs::remove_dir_all(&self.dir);
+    }
+}
+
+const METER: &str = "Aizome level meter";
+
+#[test]
+fn a_meter_whose_sound_server_left_does_not_keep_showing_its_last_peak() {
+    let mut pw = PrivatePipeWire::start("peak");
+    let meter = Meter::start_on(Some(pw.server()), "test-mic", Wake::none());
+    assert!(eventually(Duration::from_secs(5), || pw.has_client(METER)), "the meter connected");
+    std::thread::sleep(Duration::from_millis(300));
+    // The last peak the server sent, as the read callback stores it.
+    meter.level.store(0.5f32.to_bits(), Ordering::Relaxed);
+    pw.stop_pulse();
+    let cleared = eventually(Duration::from_secs(3), || meter.level() == 0.0);
+    eprintln!("3 s after pipewire-pulse went the meter shows {}", meter.level());
+    assert!(cleared, "a meter whose server left shows no level, not the last peak ({})", meter.level());
+}
+
+#[test]
+fn a_meter_follows_its_input_again_after_the_sound_server_restarts() {
+    let mut pw = PrivatePipeWire::start("again");
+    let meter = Meter::start_on(Some(pw.server()), "test-mic", Wake::none());
+    assert!(eventually(Duration::from_secs(5), || pw.has_client(METER)), "the meter connected");
+    pw.stop_pulse();
+    assert!(eventually(Duration::from_secs(5), || !pw.has_client(METER)), "its client went with pipewire-pulse");
+    // systemd starts pipewire-pulse again (socket activation, an update).
+    pw.start_pulse();
+    let back = eventually(Duration::from_secs(8), || pw.has_client(METER));
+    eprintln!("meter reconnected within 8 s: {back}");
+    assert!(back, "the meter must connect to the sound server again and follow its input");
+    drop(meter);
+}
diff --git a/desktop/aizome/crates/aizome-sys/tests/repro_sya_05.rs b/desktop/aizome/crates/aizome-sys/tests/repro_sya_05.rs
new file mode 100644
index 00000000..8939f36d
--- /dev/null
+++ b/desktop/aizome/crates/aizome-sys/tests/repro_sya_05.rs
@@ -0,0 +1,162 @@
+//! SYA-05: a volume change the sound server refuses stays in the snapshot.
+//! `set_volume_in` stores the new level before the server answers; when
+//! the answer is a refusal nothing puts the old level back, and no change
+//! event follows, so the snapshot (Settings' slider, the OSD) shows a level
+//! the server never applied.
+//!
+//! A private PipeWire with its own pipewire-pulse (null sinks, no session
+//! manager, no hardware), as in `tests/audio.rs`. The refusal: this
+//! client's permissions on the speakers are set to read and execute
+//! without write (as a sandbox's permission store sets them), so
+//! pipewire-pulse answers "Access denied".
+
+mod common;
+
+use aizome_sys::Wake;
+use aizome_sys::audio::Audio;
+use common::eventually;
+use std::path::PathBuf;
+use std::process::{Child, Command, Stdio};
+
+struct PrivatePipeWire {
+    children: Vec<Child>,
+    dir: PathBuf,
+}
+
+impl PrivatePipeWire {
+    fn start() -> PrivatePipeWire {
+        let dir = PathBuf::from(format!("/tmp/repro-sya05-pw-{}", std::process::id()));
+        std::fs::create_dir_all(&dir).unwrap();
+        let daemon = dir.join("daemon.conf");
+        let pulse = dir.join("pulse.conf");
+        std::fs::write(
+            &daemon,
+            "context.properties = { core.daemon = true core.name = pipewire-0 support.dbus = false }\n\
+             context.spa-libs = { audio.convert.* = audioconvert/libspa-audioconvert support.* = support/libspa-support }\n\
+             context.modules = [\n\
+               { name = libpipewire-module-protocol-native }\n\
+               { name = libpipewire-module-access }\n\
+               { name = libpipewire-module-metadata }\n\
+               { name = libpipewire-module-spa-node-factory }\n\
+               { name = libpipewire-module-client-node }\n\
+               { name = libpipewire-module-adapter }\n\
+               { name = libpipewire-module-link-factory }\n\
+             ]\n\
+             context.objects = [\n\
+               { factory = metadata args = { metadata.name = default metadata.values = [ \
+                  { key = default.audio.sink value = { name = test-speakers } } ] } }\n\
+               { factory = adapter args = { factory.name = support.null-audio-sink node.name = \"test-speakers\" \
+                  node.description = \"Test Speakers\" media.class = \"Audio/Sink\" audio.position = [ FL FR ] } }\n\
+             ]\n",
+        )
+        .unwrap();
+        std::fs::write(
+            &pulse,
+            format!(
+                "context.properties = {{ support.dbus = false }}\n\
+                 context.spa-libs = {{ audio.convert.* = audioconvert/libspa-audioconvert support.* = support/libspa-support }}\n\
+                 context.modules = [\n\
+                   {{ name = libpipewire-module-protocol-native }}\n\
+                   {{ name = libpipewire-module-client-node }}\n\
+                   {{ name = libpipewire-module-adapter }}\n\
+                   {{ name = libpipewire-module-metadata }}\n\
+                   {{ name = libpipewire-module-protocol-pulse }}\n\
+                 ]\n\
+                 pulse.properties = {{ server.address = [ \"unix:{}/pulse.sock\" ] }}\n",
+                dir.display()
+            ),
+        )
+        .unwrap();
+        let mut pw = PrivatePipeWire { children: Vec::new(), dir: dir.clone() };
+        pw.children.push(pw.command("pipewire").arg("-c").arg(&daemon).spawn().expect("pipewire"));
+        assert!(eventually(|| dir.join("pipewire-0").exists()), "pipewire started");
+        pw.children.push(pw.command("pipewire-pulse").arg("-c").arg(&pulse).spawn().expect("pipewire-pulse"));
+        assert!(eventually(|| dir.join("pulse.sock").exists()), "pipewire-pulse started");
+        pw
+    }
+
+    fn command(&self, program: &str) -> Command {
+        let mut c = Command::new(program);
+        c.env("XDG_RUNTIME_DIR", &self.dir)
+            .env("PIPEWIRE_RUNTIME_DIR", &self.dir)
+            .env("DBUS_SESSION_BUS_ADDRESS", "disabled:")
+            .env_remove("PIPEWIRE_REMOTE")
+            .stdin(Stdio::null())
+            .stdout(Stdio::null())
+            .stderr(std::fs::File::create(self.dir.join(format!("{program}.log"))).map(Stdio::from).unwrap());
+        c
+    }
+
+    /// `pw-cli -r pipewire-0 ARGS`, its output.
+    fn cli(&self, args: &[&str]) -> String {
+        let out = self.command("pw-cli").arg("-r").arg("pipewire-0").args(args).stdout(Stdio::piped()).output();
+        String::from_utf8_lossy(&out.expect("pw-cli").stdout).into_owned()
+    }
+
+    /// The id of the object of `kind` (`Client`, `Node`) with `key = "value"`.
+    fn id_of(&self, kind: &str, key: &str, value: &str) -> Option<String> {
+        let listing = self.cli(&["ls", kind]);
+        let want = format!("{key} = \"{value}\"");
+        listing.split("\tid ").skip(1).find(|block| block.lines().any(|l| l.trim() == want)).map(|block| {
+            block.split(',').next().unwrap_or_default().trim().to_owned()
+        })
+    }
+
+    fn server(&self) -> String {
+        format!("unix:{}/pulse.sock", self.dir.display())
+    }
+}
+
+impl Drop for PrivatePipeWire {
+    fn drop(&mut self) {
+        for child in self.children.iter_mut().rev() {
+            let _ = child.kill();
+            let _ = child.wait();
+        }
+        let _ = std::fs::remove_dir_all(&self.dir);
+    }
+}
+
+fn close(a: f32, b: f32) -> bool {
+    (a - b).abs() < 0.011
+}
+
+#[test]
+fn a_volume_the_server_refuses_does_not_stay_in_the_snapshot() {
+    let pw = PrivatePipeWire::start();
+    let audio = Audio::with_server(Some(pw.server()), Wake::none());
+    assert!(eventually(|| audio.snapshot().sinks.len() == 1), "{:?}", audio.snapshot());
+    let speakers = audio.snapshot().sinks[0].clone();
+    audio.set_sink_volume(speakers.index, 0.5).wait().unwrap();
+    assert!(eventually(|| close(audio.snapshot().sink(speakers.index).unwrap().volume, 0.5)));
+
+    // This client may see the speakers but not change them.
+    let client = pw.id_of("Client", "application.name", "Aizome").expect("Aizome's client in PipeWire");
+    let node = pw.id_of("Node", "node.name", "test-speakers").expect("the speakers' node");
+    eprintln!("client {client}, node {node}");
+    pw.cli(&["permissions", &client, &node, "0"]);
+    let hidden = eventually(|| audio.snapshot().sink(speakers.index).is_none());
+    // Read and execute, without write (0o500).
+    pw.cli(&["permissions", &client, &node, "320"]);
+    let back = eventually(|| audio.snapshot().sink(speakers.index).is_some());
+    eprintln!("hidden {hidden}, back {back}; {}", pw.cli(&["get-permissions", &client]).trim());
+    assert!(back, "the speakers are listed again: {:?}", audio.snapshot().sinks);
+    assert!(close(audio.snapshot().sink(speakers.index).unwrap().volume, 0.5));
+
+    let refused = audio.set_sink_volume(speakers.index, 0.2).wait();
+    eprintln!("set_sink_volume(0.2): {refused:?}");
+    assert!(refused.is_err(), "the server refused the change");
+    // What the server has, as a client of its own sees it.
+    let witness = Audio::with_server(Some(pw.server()), Wake::none());
+    assert!(eventually(|| witness.snapshot().sink(speakers.index).is_some()));
+    let server_level = witness.snapshot().sink(speakers.index).unwrap().volume;
+    // Past the one-second window the expectation is held for.
+    std::thread::sleep(std::time::Duration::from_millis(1500));
+    let shown = audio.snapshot().sink(speakers.index).unwrap().volume;
+    eprintln!("server level {server_level}, snapshot level {shown}");
+    assert!(close(server_level, 0.5), "the server kept 0.5: {server_level}");
+    assert!(
+        close(shown, server_level),
+        "after a refused change the snapshot must show the level the server kept ({server_level}), not {shown}"
+    );
+}
diff --git a/desktop/aizome/crates/aizome-sys/tests/repro_sya_06.rs b/desktop/aizome/crates/aizome-sys/tests/repro_sya_06.rs
new file mode 100644
index 00000000..5615b05d
--- /dev/null
+++ b/desktop/aizome/crates/aizome-sys/tests/repro_sya_06.rs
@@ -0,0 +1,229 @@
+//! SYA-06: bluetoothd restarts while the pairing agent is registered.
+//! BlueZ forgets its agents when it restarts; the worker keeps its
+//! `Registration` and nothing registers it again (the follower's
+//! `Appeared` never reaches the worker), so pairing a device that asks
+//! for a confirmation finds no agent and fails without a prompt.
+//!
+//! A fake BlueZ on a private bus (as in `tests/bluetooth.rs`); the restart
+//! is the fake leaving the bus and a fresh one, with no agents, taking
+//! `org.bluez` again.
+
+mod common;
+
+use aizome_sys::Wake;
+use aizome_sys::bluetooth::{Bluetooth, PairingRequest, PairingResponse};
+use common::eventually;
+use std::sync::atomic::{AtomicBool, Ordering};
+use std::sync::{Arc, Mutex};
+use zbus::fdo;
+use zbus::object_server::SignalEmitter;
+use zbus::zvariant::OwnedObjectPath;
+
+const ADAPTER: &str = "/org/bluez/hci0";
+const SPEAKER: &str = "/org/bluez/hci0/dev_11_22_33_44_55_66";
+
+/// One bluetoothd's memory: the agent registered with it.
+#[derive(Default)]
+struct Shared {
+    agent: Option<(String, OwnedObjectPath)>,
+    default_agent: bool,
+}
+
+struct AgentManager {
+    shared: Arc<Mutex<Shared>>,
+}
+
+#[zbus::interface(name = "org.bluez.AgentManager1")]
+impl AgentManager {
+    fn register_agent(
+        &self,
+        agent: OwnedObjectPath,
+        _capability: String,
+        #[zbus(header)] header: zbus::message::Header<'_>,
+    ) -> fdo::Result<()> {
+        let sender = header.sender().map(|s| s.to_string()).unwrap_or_default();
+        self.shared.lock().unwrap().agent = Some((sender, agent));
+        Ok(())
+    }
+    fn request_default_agent(&self, _agent: OwnedObjectPath) {
+        self.shared.lock().unwrap().default_agent = true;
+    }
+    fn unregister_agent(&self, _agent: OwnedObjectPath) {
+        self.shared.lock().unwrap().agent = None;
+    }
+}
+
+struct Adapter;
+
+#[zbus::interface(name = "org.bluez.Adapter1")]
+impl Adapter {
+    #[zbus(property)]
+    fn address(&self) -> String {
+        "00:00:00:00:00:01".into()
+    }
+    #[zbus(property)]
+    fn powered(&self) -> bool {
+        true
+    }
+    #[zbus(property)]
+    fn power_state(&self) -> String {
+        "on".into()
+    }
+    #[zbus(property)]
+    fn alias(&self) -> String {
+        "ganymede".into()
+    }
+    #[zbus(property)]
+    fn discovering(&self) -> bool {
+        false
+    }
+}
+
+#[derive(Debug, zbus::DBusError)]
+#[zbus(prefix = "org.bluez.Error")]
+enum BluezError {
+    AuthenticationRejected(String),
+    AuthenticationCanceled(String),
+}
+
+struct Device {
+    paired: AtomicBool,
+    trusted: bool,
+    connected: bool,
+    shared: Arc<Mutex<Shared>>,
+}
+
+#[zbus::interface(name = "org.bluez.Device1")]
+impl Device {
+    #[zbus(property)]
+    fn address(&self) -> String {
+        "11:22:33:44:55:66".into()
+    }
+    #[zbus(property)]
+    fn alias(&self) -> String {
+        "Speaker".into()
+    }
+    #[zbus(property)]
+    fn name(&self) -> String {
+        "Speaker".into()
+    }
+    #[zbus(property)]
+    fn icon(&self) -> String {
+        "audio-card".into()
+    }
+    #[zbus(property)]
+    fn adapter(&self) -> OwnedObjectPath {
+        common::path(ADAPTER)
+    }
+    #[zbus(property)]
+    fn paired(&self) -> bool {
+        self.paired.load(Ordering::SeqCst)
+    }
+    #[zbus(property)]
+    fn trusted(&self) -> bool {
+        self.trusted
+    }
+    #[zbus(property)]
+    fn set_trusted(&mut self, on: bool) {
+        self.trusted = on;
+    }
+    #[zbus(property)]
+    fn connected(&self) -> bool {
+        self.connected
+    }
+
+    /// Ask the registered agent to confirm 123456, as BlueZ does for a
+    /// device with a display.
+    async fn pair(
+        &self,
+        #[zbus(connection)] conn: &zbus::Connection,
+        #[zbus(header)] header: zbus::message::Header<'_>,
+        #[zbus(signal_emitter)] emitter: SignalEmitter<'_>,
+    ) -> Result<(), BluezError> {
+        let agent = self.shared.lock().unwrap().agent.clone();
+        let Some((sender, agent_path)) = agent else {
+            return Err(BluezError::AuthenticationRejected("no agent".into()));
+        };
+        let me = header.path().map(|p| p.to_owned()).unwrap();
+        let reply = conn
+            .call_method(
+                Some(sender.as_str()),
+                agent_path.as_str(),
+                Some("org.bluez.Agent1"),
+                "RequestConfirmation",
+                &(me, 123456u32),
+            )
+            .await;
+        match reply {
+            Ok(_) => {
+                self.paired.store(true, Ordering::SeqCst);
+                let _ = self.paired_changed(&emitter).await;
+                Ok(())
+            }
+            Err(_) => Err(BluezError::AuthenticationCanceled("Canceled".into())),
+        }
+    }
+
+    async fn connect(&mut self, #[zbus(signal_emitter)] emitter: SignalEmitter<'_>) -> fdo::Result<()> {
+        self.connected = true;
+        self.connected_changed(&emitter).await?;
+        Ok(())
+    }
+}
+
+/// A bluetoothd, freshly started: it knows no agent.
+fn bluetoothd(bus: &common::TestBus) -> (zbus::blocking::Connection, Arc<Mutex<Shared>>) {
+    let shared = Arc::new(Mutex::new(Shared::default()));
+    let speaker = Device { paired: AtomicBool::new(false), trusted: false, connected: false, shared: shared.clone() };
+    let conn = bus
+        .builder()
+        .name("org.bluez")
+        .unwrap()
+        .serve_at("/", zbus::fdo::ObjectManager)
+        .unwrap()
+        .serve_at("/org/bluez", AgentManager { shared: shared.clone() })
+        .unwrap()
+        .serve_at(ADAPTER, Adapter)
+        .unwrap()
+        .serve_at(SPEAKER, speaker)
+        .unwrap()
+        .build()
+        .unwrap();
+    (conn, shared)
+}
+
+#[test]
+fn the_pairing_agent_is_registered_again_when_bluetoothd_restarts() {
+    let bus = common::TestBus::start().expect("dbus-daemon");
+    let (first_daemon, first) = bluetoothd(&bus);
+    let bt = Bluetooth::with_bus(bus.bus(), Wake::none());
+    assert!(eventually(|| bt.available() && bt.snapshot().device(SPEAKER).is_some()));
+
+    // Settei's Bluetooth pane shows: it registers the agent, once.
+    let prompts = Arc::new(Mutex::new(Vec::new()));
+    let seen = prompts.clone();
+    bt.register_agent(move |prompt| {
+        seen.lock().unwrap().push(prompt.request.clone());
+        match prompt.request {
+            PairingRequest::Confirm(123456) => prompt.responder.respond(PairingResponse::Accept),
+            _ => prompt.responder.reject(),
+        }
+    })
+    .wait()
+    .unwrap();
+    assert!(first.lock().unwrap().agent.is_some() && first.lock().unwrap().default_agent);
+
+    // bluetoothd restarts (an update, a crash, `systemctl restart`).
+    drop(first_daemon);
+    assert!(eventually(|| !bt.available()), "BlueZ left");
+    let (_second_daemon, second) = bluetoothd(&bus);
+    assert!(eventually(|| bt.available() && bt.snapshot().device(SPEAKER).is_some()), "BlueZ is back");
+
+    let registered = eventually(|| second.lock().unwrap().agent.is_some());
+    let paired = bt.pair(SPEAKER).wait();
+    let asked = prompts.lock().unwrap().clone();
+    eprintln!("agent registered with the new bluetoothd: {registered}; pair: {paired:?}; prompts: {asked:?}");
+    assert!(registered, "the agent must be registered with the bluetoothd that runs now");
+    assert!(paired.is_ok(), "pairing a device that asks for a confirmation: {paired:?}");
+    assert_eq!(asked, [PairingRequest::Confirm(123456)], "the person was asked");
+}
diff --git a/desktop/aizome/crates/aizome-sys/tests/repro_syb_01.rs b/desktop/aizome/crates/aizome-sys/tests/repro_syb_01.rs
new file mode 100644
index 00000000..805bd894
--- /dev/null
+++ b/desktop/aizome/crates/aizome-sys/tests/repro_syb_01.rs
@@ -0,0 +1,192 @@
+//! SYB-01: airplane mode's fallback marker (`$XDG_RUNTIME_DIR/aizome-airplane-mode`
+//! here a temporary file) outlives airplane mode when Wi-Fi is switched back
+//! on by hand. A fake NetworkManager and BlueZ on a private bus, a read-only
+//! file for `/dev/rfkill` (so the fallback runs) and a fake sysfs with two
+//! unblocked radios; nothing touches the real rfkill, NetworkManager or BlueZ.
+
+mod common;
+
+use aizome_sys::Wake;
+use aizome_sys::network::{Network, RadioPaths};
+use common::eventually;
+use std::os::unix::fs::PermissionsExt;
+use std::path::{Path, PathBuf};
+
+const NM_PATH: &str = "/org/freedesktop/NetworkManager";
+
+/// NetworkManager: only its Wi-Fi switch.
+struct Manager {
+    wireless_enabled: bool,
+}
+
+#[zbus::interface(name = "org.freedesktop.NetworkManager")]
+impl Manager {
+    #[zbus(property)]
+    fn version(&self) -> String {
+        "1.58.0".into()
+    }
+    #[zbus(property)]
+    fn state(&self) -> u32 {
+        70
+    }
+    #[zbus(property)]
+    fn networking_enabled(&self) -> bool {
+        true
+    }
+    #[zbus(property)]
+    fn wireless_enabled(&self) -> bool {
+        self.wireless_enabled
+    }
+    #[zbus(property)]
+    fn set_wireless_enabled(&mut self, on: bool) {
+        self.wireless_enabled = on;
+    }
+    #[zbus(property)]
+    fn wireless_hardware_enabled(&self) -> bool {
+        true
+    }
+}
+
+/// A BlueZ adapter.
+struct Adapter {
+    powered: bool,
+}
+
+#[zbus::interface(name = "org.bluez.Adapter1")]
+impl Adapter {
+    #[zbus(property)]
+    fn powered(&self) -> bool {
+        self.powered
+    }
+    #[zbus(property)]
+    fn set_powered(&mut self, on: bool) {
+        self.powered = on;
+    }
+}
+
+/// A sysfs radio directory, as `/sys/class/rfkill/rfkillN`.
+fn radio(root: &Path, index: u32, kind: &str) {
+    let dir = root.join(format!("rfkill{index}"));
+    std::fs::create_dir_all(&dir).unwrap();
+    for (name, value) in [("index", index.to_string()), ("type", kind.into()), ("soft", "0".into()), ("hard", "0".into())]
+    {
+        std::fs::write(dir.join(name), format!("{value}\n")).unwrap();
+    }
+}
+
+struct Rig {
+    _bus: common::TestBus,
+    _nm: zbus::blocking::Connection,
+    bluez: zbus::blocking::Connection,
+    network: Network,
+    fallback: PathBuf,
+    dir: PathBuf,
+}
+
+impl Rig {
+    fn start(name: &str) -> Option<Rig> {
+        let bus = common::TestBus::start()?;
+        let nm = bus
+            .builder()
+            .name("org.freedesktop.NetworkManager")
+            .unwrap()
+            .serve_at("/org/freedesktop", zbus::fdo::ObjectManager)
+            .unwrap()
+            .serve_at(NM_PATH, Manager { wireless_enabled: true })
+            .unwrap()
+            .build()
+            .unwrap();
+        let bluez = bus
+            .builder()
+            .name("org.bluez")
+            .unwrap()
+            .serve_at("/", zbus::fdo::ObjectManager)
+            .unwrap()
+            .serve_at("/org/bluez/hci0", Adapter { powered: true })
+            .unwrap()
+            .build()
+            .unwrap();
+        let dir = std::env::temp_dir().join(format!("repro-syb-01-{name}-{}", std::process::id()));
+        let _ = std::fs::remove_dir_all(&dir);
+        std::fs::create_dir_all(&dir).unwrap();
+        // `/dev/rfkill` that may not be written (no uaccess): the fallback.
+        let device = dir.join("rfkill");
+        std::fs::write(&device, b"").unwrap();
+        std::fs::set_permissions(&device, std::fs::Permissions::from_mode(0o444)).unwrap();
+        if std::fs::OpenOptions::new().write(true).open(&device).is_ok() {
+            eprintln!("skipping: a read-only file can be written here (root)");
+            return None;
+        }
+        // The laptop's radios, unblocked, as sysfs shows them.
+        let sysfs = dir.join("sysfs");
+        radio(&sysfs, 0, "wlan");
+        radio(&sysfs, 1, "bluetooth");
+        let fallback = dir.join("aizome-airplane-mode");
+        let network =
+            Network::with_bus(bus.bus(), Wake::none(), RadioPaths { device, sysfs, fallback: fallback.clone() });
+        assert!(eventually(|| network.available() && network.snapshot().wifi_enabled));
+        Some(Rig { _bus: bus, _nm: nm, bluez, network, fallback, dir })
+    }
+
+    fn bluetooth(&self) -> bool {
+        self.bluez.object_server().interface::<_, Adapter>("/org/bluez/hci0").unwrap().get().powered
+    }
+
+    fn marker(&self) -> Option<String> {
+        std::fs::read_to_string(&self.fallback).ok()
+    }
+
+    /// Airplane mode on, then Wi-Fi switched back on with the Wi-Fi switch.
+    fn airplane_then_wifi_on(&self) {
+        self.network.set_airplane_mode(true).wait().unwrap();
+        assert!(!self.bluetooth(), "airplane mode switched Bluetooth off");
+        assert_eq!(self.marker().as_deref(), Some("/org/bluez/hci0"));
+        assert!(eventually(|| self.network.snapshot().airplane_mode && !self.network.snapshot().wifi_enabled));
+        self.network.set_wifi_enabled(true).wait().unwrap();
+        assert!(eventually(|| self.network.snapshot().wifi_enabled));
+        assert!(!self.network.snapshot().airplane_mode, "the switch reads off once Wi-Fi is on");
+    }
+}
+
+impl Drop for Rig {
+    fn drop(&mut self) {
+        let _ = std::fs::remove_dir_all(&self.dir);
+    }
+}
+
+/// After leaving airplane mode through the Wi-Fi switch, switching Wi-Fi
+/// off is just Wi-Fi off, not airplane mode.
+#[test]
+fn wifi_off_after_leaving_airplane_mode_by_hand_is_not_airplane_mode() {
+    let Some(rig) = Rig::start("wifi") else { return };
+    rig.airplane_then_wifi_on();
+    let stale = rig.marker();
+    rig.network.set_wifi_enabled(false).wait().unwrap();
+    assert!(eventually(|| !rig.network.snapshot().wifi_enabled));
+    // Let the follower settle on its derived state.
+    std::thread::sleep(std::time::Duration::from_millis(200));
+    let s = rig.network.snapshot();
+    assert!(
+        !s.airplane_mode,
+        "plain Wi-Fi off reads as airplane mode: airplane_mode={}, radios={:?}, marker left behind={stale:?}",
+        s.airplane_mode, s.radios
+    );
+}
+
+/// Airplane mode on (Bluetooth goes off), Wi-Fi on by hand, airplane mode on
+/// again and off again: the Bluetooth adapter airplane mode switched off
+/// comes back.
+#[test]
+fn bluetooth_comes_back_after_a_second_airplane_mode() {
+    let Some(rig) = Rig::start("bt") else { return };
+    rig.airplane_then_wifi_on();
+    rig.network.set_airplane_mode(true).wait().unwrap();
+    let rewritten = rig.marker();
+    rig.network.set_airplane_mode(false).wait().unwrap();
+    assert!(eventually(|| rig.network.snapshot().wifi_enabled));
+    assert!(
+        rig.bluetooth(),
+        "Bluetooth stays off after airplane mode ends: the marker was rewritten as {rewritten:?} by the second \
+         airplane mode (hci0 was still off), so nothing was switched back on"
+    );
+}
diff --git a/desktop/aizome/crates/aizome-sys/tests/repro_syb_02.rs b/desktop/aizome/crates/aizome-sys/tests/repro_syb_02.rs
new file mode 100644
index 00000000..2fb0f225
--- /dev/null
+++ b/desktop/aizome/crates/aizome-sys/tests/repro_syb_02.rs
@@ -0,0 +1,351 @@
+//! SYB-02: joining a saved network with a new password that takes longer
+//! than the 45 s join timeout. A fake NetworkManager on a private bus keeps
+//! the activation in "activating" (as a slow DHCP server would). The join
+//! gives up with Timeout and reloads the profile from disk, but leaves
+//! NetworkManager's activation (running with the in-memory password) going,
+//! so NetworkManager can still connect with a password that was never saved.
+//!
+//! Runs for about 46 s: the timeout is a constant (`JOIN_TIMEOUT`).
+
+mod common;
+
+use aizome_sys::network::{Network, RadioPaths};
+use aizome_sys::{Error, Wake};
+use common::{eventually, path};
+use std::collections::HashMap;
+use std::sync::{Arc, Mutex};
+use zbus::fdo;
+use zbus::object_server::{ObjectServer, SignalEmitter};
+use zbus::zvariant::{OwnedObjectPath, OwnedValue, Value};
+
+type Settings = HashMap<String, HashMap<String, OwnedValue>>;
+
+const NM_PATH: &str = "/org/freedesktop/NetworkManager";
+const DEVICE: &str = "/org/freedesktop/NetworkManager/Devices/1";
+const HOME: &str = "/org/freedesktop/NetworkManager/Settings/1";
+const HOME_FILE: &str = "/etc/NetworkManager/system-connections/Home.nmconnection";
+
+fn clone_settings(settings: &Settings) -> Settings {
+    settings
+        .iter()
+        .map(|(group, props)| (group.clone(), props.iter().map(|(k, v)| (k.clone(), v.try_clone().unwrap())).collect()))
+        .collect()
+}
+
+fn setting_str(settings: &Settings, group: &str, key: &str) -> Option<String> {
+    String::try_from(settings.get(group)?.get(key)?.try_clone().ok()?).ok()
+}
+
+fn value(v: impl Into<Value<'static>>) -> OwnedValue {
+    OwnedValue::try_from(v.into()).unwrap()
+}
+
+#[derive(Default)]
+struct Log {
+    /// Update2 calls: (psk, flags).
+    updated: Vec<(Option<String>, u32)>,
+    saved: usize,
+    loaded: Vec<Vec<String>>,
+    activated: Vec<String>,
+    deactivated: Vec<String>,
+}
+
+struct Manager {
+    log: Arc<Mutex<Log>>,
+    active: Vec<OwnedObjectPath>,
+    next: u32,
+}
+
+#[zbus::interface(name = "org.freedesktop.NetworkManager")]
+impl Manager {
+    #[zbus(property)]
+    fn version(&self) -> String {
+        "1.58.0".into()
+    }
+    #[zbus(property)]
+    fn state(&self) -> u32 {
+        70
+    }
+    #[zbus(property)]
+    fn networking_enabled(&self) -> bool {
+        true
+    }
+    #[zbus(property)]
+    fn wireless_enabled(&self) -> bool {
+        true
+    }
+    #[zbus(property)]
+    fn wireless_hardware_enabled(&self) -> bool {
+        true
+    }
+    #[zbus(property)]
+    fn active_connections(&self) -> Vec<OwnedObjectPath> {
+        self.active.clone()
+    }
+
+    /// Starts an activation that stays in "activating" (state 1): the
+    /// access point accepted the key, DHCP is slow.
+    async fn activate_connection(
+        &mut self,
+        connection: OwnedObjectPath,
+        _device: OwnedObjectPath,
+        _specific_object: OwnedObjectPath,
+        #[zbus(object_server)] server: &ObjectServer,
+        #[zbus(signal_emitter)] emitter: SignalEmitter<'_>,
+    ) -> fdo::Result<OwnedObjectPath> {
+        self.next += 1;
+        let active = path(&format!("{NM_PATH}/ActiveConnection/{}", self.next));
+        self.log.lock().unwrap().activated.push(active.to_string());
+        server
+            .at(active.as_str(), Active { connection: connection.clone(), state: 1 })
+            .await?;
+        self.active.push(active.clone());
+        self.active_connections_changed(&emitter).await?;
+        Ok(active)
+    }
+
+    async fn deactivate_connection(
+        &mut self,
+        active: OwnedObjectPath,
+        #[zbus(object_server)] server: &ObjectServer,
+        #[zbus(signal_emitter)] emitter: SignalEmitter<'_>,
+    ) -> fdo::Result<()> {
+        self.log.lock().unwrap().deactivated.push(active.to_string());
+        let _ = server.remove::<Active, _>(active.as_str()).await;
+        self.active.retain(|a| *a != active);
+        self.active_connections_changed(&emitter).await?;
+        Ok(())
+    }
+}
+
+struct SettingsRoot {
+    log: Arc<Mutex<Log>>,
+}
+
+#[zbus::interface(name = "org.freedesktop.NetworkManager.Settings")]
+impl SettingsRoot {
+    #[zbus(property)]
+    fn hostname(&self) -> String {
+        "testhost".into()
+    }
+    fn get_connection_by_uuid(&self, uuid: String) -> fdo::Result<OwnedObjectPath> {
+        if uuid == "11111111-1111-1111-1111-111111111111" {
+            Ok(path(HOME))
+        } else {
+            Err(fdo::Error::Failed(format!("no connection {uuid}")))
+        }
+    }
+    fn load_connections(&self, filenames: Vec<String>) -> (bool, Vec<String>) {
+        self.log.lock().unwrap().loaded.push(filenames);
+        (true, Vec::new())
+    }
+}
+
+struct Connection {
+    log: Arc<Mutex<Log>>,
+    settings: Settings,
+}
+
+#[zbus::interface(name = "org.freedesktop.NetworkManager.Settings.Connection")]
+impl Connection {
+    #[zbus(property)]
+    fn filename(&self) -> String {
+        HOME_FILE.into()
+    }
+    fn get_settings(&self) -> Settings {
+        clone_settings(&self.settings)
+    }
+    async fn update2(
+        &mut self,
+        settings: Settings,
+        flags: u32,
+        _args: HashMap<String, OwnedValue>,
+    ) -> fdo::Result<HashMap<String, OwnedValue>> {
+        let psk = setting_str(&settings, "802-11-wireless-security", "psk");
+        self.log.lock().unwrap().updated.push((psk, flags));
+        self.settings = settings;
+        Ok(HashMap::new())
+    }
+    fn save(&self) {
+        self.log.lock().unwrap().saved += 1;
+    }
+}
+
+struct Device;
+
+#[zbus::interface(name = "org.freedesktop.NetworkManager.Device")]
+impl Device {
+    #[zbus(property)]
+    fn interface(&self) -> String {
+        "wlan0".into()
+    }
+    #[zbus(property)]
+    fn device_type(&self) -> u32 {
+        2
+    }
+    #[zbus(property)]
+    fn state(&self) -> u32 {
+        // NM_DEVICE_STATE_IP_CONFIG: waiting for DHCP.
+        70
+    }
+    #[zbus(property)]
+    fn state_reason(&self) -> (u32, u32) {
+        (70, 0)
+    }
+    #[zbus(property)]
+    fn managed(&self) -> bool {
+        true
+    }
+    #[zbus(property)]
+    fn real(&self) -> bool {
+        true
+    }
+}
+
+struct Wireless;
+
+#[zbus::interface(name = "org.freedesktop.NetworkManager.Device.Wireless")]
+impl Wireless {
+    #[zbus(property)]
+    fn access_points(&self) -> Vec<OwnedObjectPath> {
+        vec![path("/org/freedesktop/NetworkManager/AccessPoint/1")]
+    }
+}
+
+struct AccessPoint;
+
+#[zbus::interface(name = "org.freedesktop.NetworkManager.AccessPoint")]
+impl AccessPoint {
+    #[zbus(property)]
+    fn ssid(&self) -> Vec<u8> {
+        b"Home".to_vec()
+    }
+    #[zbus(property)]
+    fn flags(&self) -> u32 {
+        1
+    }
+    #[zbus(property)]
+    fn wpa_flags(&self) -> u32 {
+        0
+    }
+    #[zbus(property)]
+    fn rsn_flags(&self) -> u32 {
+        0x188
+    }
+    #[zbus(property)]
+    fn frequency(&self) -> u32 {
+        2437
+    }
+    #[zbus(property)]
+    fn strength(&self) -> u8 {
+        70
+    }
+    #[zbus(property)]
+    fn mode(&self) -> u32 {
+        2
+    }
+}
+
+struct Active {
+    connection: OwnedObjectPath,
+    state: u32,
+}
+
+#[zbus::interface(name = "org.freedesktop.NetworkManager.Connection.Active")]
+impl Active {
+    #[zbus(property)]
+    fn connection(&self) -> OwnedObjectPath {
+        self.connection.clone()
+    }
+    #[zbus(property)]
+    fn uuid(&self) -> String {
+        "11111111-1111-1111-1111-111111111111".into()
+    }
+    #[zbus(property)]
+    fn id(&self) -> String {
+        "Home".into()
+    }
+    #[zbus(property, name = "Type")]
+    fn kind(&self) -> String {
+        "802-11-wireless".into()
+    }
+    #[zbus(property)]
+    fn state(&self) -> u32 {
+        self.state
+    }
+    #[zbus(property)]
+    fn devices(&self) -> Vec<OwnedObjectPath> {
+        vec![path(DEVICE)]
+    }
+}
+
+#[test]
+fn a_slow_join_that_times_out_does_not_leave_the_unsaved_password_activating() {
+    let bus = test_bus!();
+    let log = Arc::new(Mutex::new(Log::default()));
+    let home: Settings = HashMap::from([
+        (
+            "connection".to_owned(),
+            HashMap::from([
+                ("id".to_owned(), value("Home")),
+                ("uuid".to_owned(), value("11111111-1111-1111-1111-111111111111")),
+                ("type".to_owned(), value("802-11-wireless")),
+                ("timestamp".to_owned(), value(1_700_000_000u64)),
+            ]),
+        ),
+        ("802-11-wireless".to_owned(), HashMap::from([("ssid".to_owned(), value(b"Home".to_vec()))])),
+        (
+            "802-11-wireless-security".to_owned(),
+            HashMap::from([("key-mgmt".to_owned(), value("wpa-psk")), ("psk".to_owned(), value("old-password"))]),
+        ),
+    ]);
+    let nm = bus
+        .builder()
+        .name("org.freedesktop.NetworkManager")
+        .unwrap()
+        .serve_at("/org/freedesktop", zbus::fdo::ObjectManager)
+        .unwrap()
+        .serve_at(NM_PATH, Manager { log: log.clone(), active: Vec::new(), next: 0 })
+        .unwrap()
+        .serve_at(format!("{NM_PATH}/Settings"), SettingsRoot { log: log.clone() })
+        .unwrap()
+        .serve_at(HOME, Connection { log: log.clone(), settings: home })
+        .unwrap()
+        .serve_at(DEVICE, Device)
+        .unwrap()
+        .serve_at(DEVICE, Wireless)
+        .unwrap()
+        .serve_at("/org/freedesktop/NetworkManager/AccessPoint/1", AccessPoint)
+        .unwrap()
+        .build()
+        .unwrap();
+    let missing = std::env::temp_dir().join("repro-syb-02-no-rfkill");
+    let radios = RadioPaths { device: missing.clone(), sysfs: missing.clone(), fallback: missing.join("airplane") };
+    let network = Network::with_bus(bus.bus(), Wake::none(), radios);
+    assert!(eventually(|| network.snapshot().network("Home").is_some_and(|n| n.known)), "{:?}", network.snapshot());
+    let home = network.snapshot().network("Home").unwrap().clone();
+
+    let started = std::time::Instant::now();
+    let result = network.connect(&home, Some("new-password")).wait();
+    let took = started.elapsed();
+
+    let log = log.lock().unwrap();
+    let active = log.activated.last().cloned().unwrap_or_default();
+    let still_activating = nm.object_server().interface::<_, Active>(active.as_str()).is_ok();
+    eprintln!(
+        "join: {result:?} after {took:?}; Update2 {:?}; saved {}; LoadConnections {:?}; activations {:?}; \
+         deactivated {:?}; activation still running: {still_activating}",
+        log.updated, log.saved, log.loaded, log.activated, log.deactivated
+    );
+    assert!(matches!(result, Err(Error::Timeout)), "the join should time out here: {result:?}");
+    assert_eq!(log.updated.first(), Some(&(Some("new-password".into()), 2)), "the new password went in memory");
+    assert_eq!(log.loaded, [vec![HOME_FILE.to_owned()]], "the old profile was reloaded from disk");
+    // Reported failed and rolled back on disk: NetworkManager must not be
+    // left activating with the password that was rolled back.
+    assert!(
+        !still_activating && log.deactivated.contains(&active),
+        "after the timeout the activation {active} (with the in-memory password) is still running and was never \
+         deactivated; the disk profile has the old password and nothing was saved (Save calls: {})",
+        log.saved
+    );
+}
diff --git a/desktop/aizome/crates/aizome-sys/tests/repro_syb_09.rs b/desktop/aizome/crates/aizome-sys/tests/repro_syb_09.rs
new file mode 100644
index 00000000..73a97e1f
--- /dev/null
+++ b/desktop/aizome/crates/aizome-sys/tests/repro_syb_09.rs
@@ -0,0 +1,181 @@
+//! SYB-09: the polkit agent reports a helper that can't be reached, or one
+//! that exits without a verdict, as `Failed` at once ("that attempt failed:
+//! let the person try again with authenticate"), and the shell does try
+//! again at once (aizome-shell/src/auth.rs:289-296). The driver here does
+//! what the shell's Failed handler does, through a queue as the shell's
+//! message loop does. A fake polkitd on a private bus and fake helpers (a
+//! stub script that reads the cookie and exits, or a socket path that isn't
+//! there); never the real polkitd or polkit-agent-helper-1.
+
+mod common;
+
+use aizome_sys::polkit::{AuthEvent, AuthRequest, Helper, PolkitAgent};
+use common::eventually;
+use std::collections::HashMap;
+use std::os::unix::fs::PermissionsExt;
+use std::path::{Path, PathBuf};
+use std::sync::mpsc;
+use std::sync::{Arc, Mutex};
+use std::time::{Duration, Instant};
+use zbus::zvariant::{OwnedValue, Value};
+
+const AGENT_PATH: &str = "/org/aizome/PolicyKit1/AuthenticationAgent";
+
+struct Authority {
+    registered: Arc<Mutex<usize>>,
+}
+
+type Subject = (String, HashMap<String, OwnedValue>);
+
+#[zbus::interface(name = "org.freedesktop.PolicyKit1.Authority")]
+impl Authority {
+    fn register_authentication_agent(&self, _subject: Subject, _locale: String, _path: String) {
+        *self.registered.lock().unwrap() += 1;
+    }
+    fn unregister_authentication_agent(&self, _subject: Subject, _path: String) {}
+}
+
+fn me() -> u32 {
+    // SAFETY: getuid has no failure mode.
+    unsafe { libc::getuid() }
+}
+
+fn has_passwd_entry() -> bool {
+    std::fs::read_to_string("/etc/passwd")
+        .is_ok_and(|p| p.lines().any(|l| l.split(':').nth(2) == Some(&me().to_string())))
+}
+
+fn begin(polkitd: &zbus::blocking::Connection, agent: &str, cookie: &str) -> zbus::Result<()> {
+    let identity: (&str, HashMap<&str, Value>) = ("unix-user", HashMap::from([("uid", Value::from(me()))]));
+    let details: HashMap<&str, &str> = HashMap::new();
+    polkitd
+        .call_method(
+            Some(agent),
+            AGENT_PATH,
+            Some("org.freedesktop.PolicyKit1.AuthenticationAgent"),
+            "BeginAuthentication",
+            &(
+                "org.freedesktop.udisks2.filesystem-mount",
+                "Authentication is required to mount the disk",
+                "drive-removable-media",
+                details,
+                cookie,
+                vec![identity],
+            ),
+        )
+        .map(drop)
+}
+
+/// What happened while the driver retried as the shell does.
+struct Run {
+    failed: usize,
+    errors: Vec<String>,
+    prompts: usize,
+    took: Duration,
+}
+
+/// Serve the agent with `helper`, have polkitd ask, and answer like the
+/// shell's dialog for `window`: authenticate on Begin and again on each
+/// Failed, until 200 failures or the window passes. Then cancel.
+fn drive(helper: Helper, window: Duration) -> Option<Run> {
+    let bus = common::TestBus::start()?;
+    if !has_passwd_entry() {
+        eprintln!("skipping: no passwd entry for this uid");
+        return None;
+    }
+    let registered = Arc::new(Mutex::new(0));
+    let polkitd = bus
+        .builder()
+        .name("org.freedesktop.PolicyKit1")
+        .unwrap()
+        .serve_at("/org/freedesktop/PolicyKit1/Authority", Authority { registered: registered.clone() })
+        .unwrap()
+        .build()
+        .unwrap();
+    let agent_bus = bus.bus();
+    let agent_name = agent_bus.unique_name().unwrap();
+    let (tx, rx) = mpsc::channel::<AuthEvent>();
+    let agent = PolkitAgent::register_with(agent_bus, "7".into(), helper, move |e| {
+        let _ = tx.send(e);
+    })
+    .unwrap();
+    assert!(eventually(|| *registered.lock().unwrap() >= 1));
+    let call = std::thread::spawn({
+        let polkitd = polkitd.clone();
+        move || begin(&polkitd, &agent_name, "cookie-1")
+    });
+    let mut request: Option<AuthRequest> = None;
+    let mut run = Run { failed: 0, errors: Vec::new(), prompts: 0, took: Duration::ZERO };
+    let start = Instant::now();
+    while start.elapsed() < window && run.failed < 200 {
+        let Ok(event) = rx.recv_timeout(Duration::from_millis(50)) else { continue };
+        match event {
+            AuthEvent::Begin(r) => {
+                let id = r.default_identity().cloned().unwrap();
+                r.authenticate(&id);
+                request = Some(r);
+            }
+            AuthEvent::Failed { .. } => {
+                run.failed += 1;
+                // The shell's handler: clear, say so, start again at once.
+                let r = request.as_ref().unwrap();
+                let id = r.default_identity().cloned().unwrap();
+                r.authenticate(&id);
+            }
+            AuthEvent::Error { text, .. } => {
+                if run.errors.len() < 3 {
+                    run.errors.push(text);
+                }
+            }
+            AuthEvent::Prompt { .. } => run.prompts += 1,
+            _ => {}
+        }
+    }
+    run.took = start.elapsed();
+    if let Some(r) = &request {
+        r.cancel();
+    }
+    let _ = call.join();
+    drop(agent);
+    Some(run)
+}
+
+fn script(dir: &Path) -> PathBuf {
+    std::fs::create_dir_all(dir).unwrap();
+    let script = dir.join("polkit-agent-helper-1");
+    // A helper that can't do its job (not setuid, PAM refusing before any
+    // prompt): it takes the cookie and exits without SUCCESS or FAILURE.
+    std::fs::write(&script, "#!/bin/sh\nread cookie\necho \"$1\" >> \"$(dirname \"$0\")/spawns\"\nexit 1\n").unwrap();
+    std::fs::set_permissions(&script, std::fs::Permissions::from_mode(0o755)).unwrap();
+    script
+}
+
+#[test]
+fn a_helper_that_exits_without_a_verdict_is_not_respawned_without_end() {
+    let dir = std::env::temp_dir().join(format!("repro-syb-09-{}", std::process::id()));
+    let _ = std::fs::remove_dir_all(&dir);
+    let helper = script(&dir);
+    let Some(run) = drive(Helper::Program(helper), Duration::from_secs(2)) else { return };
+    let spawns = std::fs::read_to_string(dir.join("spawns")).unwrap_or_default().lines().count();
+    let _ = std::fs::remove_dir_all(&dir);
+    assert!(
+        spawns <= 3,
+        "{spawns} helper processes started in {:?} with no one typing ({} Failed, {} prompts)",
+        run.took,
+        run.failed,
+        run.prompts
+    );
+}
+
+#[test]
+fn a_missing_helper_socket_is_not_retried_without_end() {
+    let missing = std::env::temp_dir().join(format!("repro-syb-09-none-{}/agent-helper.socket", std::process::id()));
+    let Some(run) = drive(Helper::Socket(missing), Duration::from_secs(2)) else { return };
+    assert!(
+        run.failed <= 3,
+        "{} connection attempts failed in {:?} with no one typing (errors shown: {:?})",
+        run.failed,
+        run.took,
+        run.errors
+    );
+}
diff --git a/desktop/aizome/sukumo/crates/sidestep-engine/tests/repro_skr_03.rs b/desktop/aizome/sukumo/crates/sidestep-engine/tests/repro_skr_03.rs
