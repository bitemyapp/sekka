+++ b/desktop/aizome/apps/shashin/tests/repro_sap_10.rs
@@ -0,0 +1,49 @@
+//! SAP-10: open folder A, then folder B (a drop, the Open panel, a second
+//! launch) before Shashin has listed A: what shows must be B. `Listed`
+//! carries no generation and passes while nothing shows yet, so A's late
+//! listing shows A's first picture and B's is then dropped as another
+//! folder's.
+
+use std::path::{Path, PathBuf};
+use std::time::Duration;
+
+use aizome_kit::theme::ThemeChoice;
+use aizome_shashin::Msg;
+
+mod common;
+use common::*;
+
+fn private(name: &str) -> PathBuf {
+    let d = std::env::temp_dir().join(format!("repro-sap-10-{name}-{}", std::process::id()));
+    let _ = std::fs::remove_dir_all(&d);
+    std::fs::create_dir_all(&d).unwrap();
+    d
+}
+
+fn shown_in(r: &Rig) -> Option<PathBuf> {
+    r.h.program().current_path().and_then(|p| p.parent()).map(Path::to_path_buf)
+}
+
+#[test]
+fn the_folder_asked_for_last_is_the_one_shown() {
+    let base = private("base");
+    let a = private("a");
+    write_folder(&a);
+    let b = private("b");
+    sprite().save(b.join("yak.png")).unwrap();
+    sprite().save(b.join("zebra.png")).unwrap();
+    let mut r = rig_in(base, ThemeChoice::Night, "");
+
+    // Folder A: its listing runs in the background.
+    r.h.send(Msg::Open(vec![a.clone()]));
+    // Long enough for the listing to finish; its reply then waits for the
+    // event loop's next turn, as it does when B comes in the same turn.
+    std::thread::sleep(Duration::from_millis(300));
+    // Then folder B, handed over by a second launch.
+    r.h.send(Msg::Raise(vec![b.clone()]));
+    settle(&mut r, 1.0);
+
+    let names: Vec<String> =
+        r.h.program().folder.iter().map(|p| p.file_name().unwrap().to_string_lossy().into_owned()).collect();
+    assert_eq!(shown_in(&r).as_deref(), Some(b.as_path()), "asked for B last, shown from {:?}: {names:?}", shown_in(&r));
+}
diff --git a/desktop/aizome/apps/shashin/tests/repro_sap_11.rs b/desktop/aizome/apps/shashin/tests/repro_sap_11.rs
new file mode 100644
index 00000000..fd210c3f
--- /dev/null
+++ b/desktop/aizome/apps/shashin/tests/repro_sap_11.rs
@@ -0,0 +1,105 @@
+//! SAP-11: a picture turned 90° and saved must be saved at 90°, however
+//! many times Save is asked for while the save runs. Nothing marks a save
+//! in flight and the turn stays set until `Saved` is handled, while
+//! `save_turned` turns the file from what's on disk now: a second Save whose
+//! job reads the file after the first job wrote it (a second ❖S while the
+//! pool is busy, or ❖Q → Save twice) turns it again, to 180°.
+
+use std::path::{Path, PathBuf};
+use std::time::{Duration, Instant};
+
+use aizome_kit::theme::ThemeChoice;
+use aizome_shashin::Msg;
+
+mod common;
+use common::*;
+
+fn private(name: &str) -> PathBuf {
+    let d = std::env::temp_dir().join(format!("repro-sap-11-{name}-{}", std::process::id()));
+    let _ = std::fs::remove_dir_all(&d);
+    std::fs::create_dir_all(&d).unwrap();
+    d
+}
+
+/// Wait (without letting Shashin hear back) until the file is `dims`.
+fn until_on_disk(path: &Path, dims: (u32, u32)) {
+    let until = Instant::now() + Duration::from_secs(20);
+    while image::image_dimensions(path).ok() != Some(dims) {
+        assert!(Instant::now() < until, "the first save never landed");
+        std::thread::sleep(Duration::from_millis(2));
+    }
+}
+
+#[test]
+fn saving_a_quarter_turn_twice_turns_it_once() {
+    let dir = private("twice");
+    let wide = landscape(96, 64);
+    let path = dir.join("wide.png");
+    wide.save(&path).unwrap();
+    let mut r = rig_in(dir, ThemeChoice::Night, "wide.png");
+    r.h.send(Msg::Rotate(1));
+    settle(&mut r, 1.0);
+    assert_eq!(r.h.program().current_turns(), 1);
+
+    // ❖S: the rewrite runs in the background.
+    r.h.send(Msg::Save);
+    until_on_disk(&path, (64, 96));
+    // ❖S again before the first `Saved` is handled: the turn is still set.
+    r.h.send(Msg::Save);
+    settle(&mut r, 1.0);
+
+    let got = image::open(&path).unwrap().to_rgb8();
+    assert_eq!(got.dimensions(), (64, 96), "turned 90° once, saved as {:?}", got.dimensions());
+    assert!(got == image::imageops::rotate90(&wide), "the pixels are the picture turned 90° clockwise once");
+}
+
+#[test]
+fn save_and_quit_asked_twice_turns_each_picture_once() {
+    // Two big pictures, so the first Save takes a while over each.
+    let dir = private("quit");
+    let (w0, h0) = (4000, 3000);
+    let names = ["a.png", "b.png"];
+    for n in names {
+        landscape(w0, h0).save(dir.join(n)).unwrap();
+    }
+    let mut r = rig_in(dir.clone(), ThemeChoice::Night, "a.png");
+    let w = r.h.window();
+    r.h.send(Msg::Rotate(1));
+    r.h.send(Msg::Step(1));
+    settle(&mut r, 1.0);
+    r.h.send(Msg::Rotate(1));
+    settle(&mut r, 1.0);
+    assert_eq!(r.h.program().turns.len(), 2);
+
+    // ❖Q → Save: one job saves both, one after the other.
+    let asked = |r: &Rig| r.h.texts(w).iter().any(|t| t == "Save 2 turned pictures?");
+    r.h.request_close(w);
+    assert!(asked(&r), "{:?}", r.h.texts(w));
+    assert!(r.h.click_text(w, "Save"));
+    assert!(!asked(&r), "the alert closed");
+    // The first of them is written; the job is on the other.
+    let until = Instant::now() + Duration::from_secs(60);
+    let first = loop {
+        if let Some(n) = names.iter().find(|n| image::image_dimensions(dir.join(n)).ok() == Some((h0, w0))) {
+            break *n;
+        }
+        assert!(Instant::now() < until, "the first save never landed");
+        std::thread::sleep(Duration::from_millis(2));
+    };
+    let other = names.iter().find(|n| **n != first).unwrap();
+    let other_done = image::image_dimensions(dir.join(other)).ok() == Some((h0, w0));
+    assert!(!other_done, "precondition: the first job is still on {other}");
+    // ❖Q → Save again: the turns are still set, so the alert asks again.
+    r.h.request_close(w);
+    assert!(asked(&r), "asked again: {:?}", r.h.texts(w));
+    assert!(r.h.click_text(w, "Save"));
+    settle(&mut r, 1.0);
+
+    let dims = image::image_dimensions(dir.join(first)).unwrap();
+    assert_eq!(
+        dims,
+        (h0, w0),
+        "{first}, turned 90° once, was saved as {dims:?} (the other picture was already written when Save was \
+         asked again: {other_done})"
+    );
+}
diff --git a/desktop/aizome/apps/shashin/tests/repro_sap_13.rs b/desktop/aizome/apps/shashin/tests/repro_sap_13.rs
new file mode 100644
index 00000000..501ce9b9
--- /dev/null
+++ b/desktop/aizome/apps/shashin/tests/repro_sap_13.rs
@@ -0,0 +1,80 @@
+//! SAP-13: zoom in (the toolbar's Zoom In, ❖=) while a large photo decodes:
+//! once it has decoded, Shashin must make a drawing for that zoom. The
+//! stage reports `Seen { exact: false }` while it decodes; `run_jobs` takes
+//! the request and drops it (not decoded yet); after `install` the zoom,
+//! centre and view are the same, so the stage's report key is unchanged and
+//! it never reports again: the picture stays the fit drawing scaled up.
+//!
+//! The centre is unchanged when the fitted picture sits on whole device
+//! pixels: 7680 × 4400 fills the default 960 × 610 stage across at 12.5%,
+//! 30 px above and below. (For 6000 × 4000 the fit origin is 22.5 px, its
+//! rounding moves the zoomed centre by 3 px, `install` puts it back, and the
+//! stage reports again by that accident.)
+
+use std::path::PathBuf;
+use std::time::{Duration, Instant};
+
+use aizome_kit::Appearance;
+use aizome_kit::testing::Harness;
+use aizome_shashin::app::same_zoom;
+use aizome_shashin::view::Zoom;
+use aizome_shashin::{Msg, Shashin};
+
+mod common;
+use common::*;
+
+fn private(name: &str) -> PathBuf {
+    let d = std::env::temp_dir().join(format!("repro-sap-13-{name}-{}", std::process::id()));
+    let _ = std::fs::remove_dir_all(&d);
+    std::fs::create_dir_all(&d).unwrap();
+    d
+}
+
+#[test]
+fn zooming_in_while_a_big_photo_decodes_gets_a_drawing_for_the_zoom() {
+    let dir = private("zoom");
+    std::fs::write(dir.join("big.jpg"), camera_jpeg(7680, 4400)).unwrap();
+    let mut app = Shashin::new();
+    app.trash = aizome_shashin::trash::Trash { home: dir.join(".trash-can"), uid: 1000 };
+    app.settings_path = Some(dir.join("settings.toml"));
+    app.thumb_dir = dir.join(".thumbnails");
+    app.dry_run = true;
+    app.initial = vec![dir.join("big.jpg")];
+    let h = Harness::with(app, Appearance::default(), false);
+    let mut r = Rig { h, dir };
+    let w = r.h.window();
+
+    // The header is in (its size is known); the pixels are still decoding.
+    let until = Instant::now() + Duration::from_secs(20);
+    while r.h.program().pic.as_ref().is_none_or(|p| p.info.dims.0 == 0) {
+        assert!(Instant::now() < until, "no header");
+        std::thread::sleep(Duration::from_millis(1));
+        r.h.send(Msg::Nothing);
+    }
+    assert!(r.h.program().loading(), "precondition: still decoding at the header");
+    // Zoom In, and the stage draws it and reports what it lacks.
+    r.h.send(Msg::ZoomIn);
+    let _ = r.h.render(w, 1.0);
+    r.h.send(Msg::Nothing);
+    assert!(r.h.program().loading(), "precondition: the zoom was seen while still decoding");
+    let Zoom::Fixed(z) = r.h.program().zoom else { panic!("zoomed in") };
+    let zoomed_center = r.h.program().center;
+
+    settle(&mut r, 1.0);
+    // And a while longer: frames drawn, nothing else changing.
+    for _ in 0..50 {
+        let _ = r.h.render(w, 1.0);
+        r.h.send(Msg::Nothing);
+        std::thread::sleep(Duration::from_millis(4));
+    }
+    let p = r.h.program();
+    assert_eq!(p.zoom, Zoom::Fixed(z));
+    eprintln!("zoom {z}: centre {zoomed_center:?} while decoding, {:?} once decoded", p.center);
+    let pic = p.pic.as_ref().unwrap();
+    assert!(pic.decoded);
+    assert!(
+        pic.tiles.iter().any(|t| same_zoom(t.z, z)),
+        "no drawing made for zoom {z} once decoded; drawings at {:?}",
+        pic.tiles.iter().map(|t| t.z).collect::<Vec<_>>()
+    );
+}
diff --git a/desktop/aizome/apps/shashin/tests/repro_sap_18.rs b/desktop/aizome/apps/shashin/tests/repro_sap_18.rs
