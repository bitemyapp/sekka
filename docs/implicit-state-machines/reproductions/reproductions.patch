+++ b/tests/repro_ttl_08.py
@@ -0,0 +1,123 @@
+#!/usr/bin/env python3
+"""TTL-08: stopping a screen recording within its first three seconds must
+leave nothing recording.
+
+Everything runs in a private PID namespace (bwrap), so `tatami screenrecord`
+sees and signals only the fake recorders started there. A fake
+gpu-screen-recorder (process name `gpu-screen-reco`, as /proc truncates it)
+records until SIGINT; a fake wf-recorder logs that it was started. The first
+`tatami screenrecord` is still in its started(15) probe when a second one
+(Alt+Print, the bar indicator) stops the recording.
+
+usage: repro_ttl_08.py /path/to/tatami
+"""
+import json
+import os
+from pathlib import Path
+import shutil
+import subprocess
+import sys
+import tempfile
+import time
+import unittest
+
+PYTHON = Path(sys.executable).resolve()
+HERE = Path(__file__).resolve()
+BASH = Path(shutil.which('bash')).resolve()
+
+RECORDER = r'''
+import json, os, pathlib, signal, sys, time
+name = pathlib.Path(sys.argv[0]).name
+with open('/state/recorders', 'a') as f:
+    f.write(json.dumps([name, os.getpid(), time.monotonic(), sys.argv[1:]]) + '\n')
+def stop(*_):
+    with open('/state/recorders', 'a') as f:
+        f.write(json.dumps([name, os.getpid(), time.monotonic(), 'SIGINT']) + '\n')
+    sys.exit(0)
+signal.signal(signal.SIGINT, stop)
+signal.signal(signal.SIGTERM, stop)
+while True:
+    time.sleep(0.05)
+'''
+HYPRCTL = f'#!{BASH}\necho "[]"\n'
+SLURP = f'#!{BASH}\ncat >/dev/null\necho "10,10 640x480"\n'
+NOTIFY = f'#!{BASH}\necho "$@" >> /state/notifications\n'
+
+
+def inner():
+    def recorders():
+        path = Path('/state/recorders')
+        return [json.loads(l) for l in path.read_text().splitlines()] if path.exists() else []
+
+    def comm_running(name):
+        for pid in os.listdir('/proc'):
+            if pid.isdigit():
+                try:
+                    if Path(f'/proc/{pid}/comm').read_text().strip() == name:
+                        state = Path(f'/proc/{pid}/stat').read_text().rsplit(') ', 1)[1][0]
+                        if state != 'Z':
+                            return True
+                except OSError:
+                    pass
+        return False
+
+    start = subprocess.Popen(['/bin/tatami', 'screenrecord'])
+    until = time.monotonic() + 5
+    while time.monotonic() < until and not recorders():
+        time.sleep(0.02)
+    time.sleep(0.5)  # recording for half a second, start still probing
+    facts = {'gsr_comm_seen': comm_running('gpu-screen-reco')}
+    subprocess.run(['/bin/tatami', 'screenrecord', '--stop'], timeout=20)
+    facts['stopped_at'] = time.monotonic()
+    start.wait(timeout=20)
+    time.sleep(0.3)
+    facts['recorders'] = recorders()
+    facts['still_recording'] = comm_running('gpu-screen-reco') or comm_running('wf-recorder')
+    path = Path('/state/notifications')
+    facts['notifications'] = path.read_text().splitlines() if path.exists() else []
+    print(json.dumps(facts))
+
+
+class EarlyStop(unittest.TestCase):
+    def test_stop_during_start_probe_does_not_start_a_fallback(self):
+        with tempfile.TemporaryDirectory(prefix='ttl08-') as tmp:
+            root = Path(tmp)
+            for folder in ['state', 'fake', 'home/alice', 'run/user/1000', 'nix/store', 'bin']:
+                (root / folder).mkdir(parents=True, exist_ok=True)
+            for name, body in [('gpu-screen-recorder', f'#!{PYTHON}\n' + RECORDER),
+                               ('wf-recorder', f'#!{PYTHON}\n' + RECORDER),
+                               ('hyprctl', HYPRCTL), ('slurp', SLURP),
+                               ('notify-send', NOTIFY)]:
+                (root / 'fake' / name).write_text(body)
+                (root / 'fake' / name).chmod(0o755)
+            command = [
+                'bwrap', '--unshare-all', '--die-with-parent', '--bind', str(root), '/',
+                '--ro-bind', '/nix/store', '/nix/store', '--ro-bind', str(BIN), '/bin/tatami',
+                '--ro-bind', str(HERE), '/test.py',
+                '--proc', '/proc', '--dev', '/dev', '--clearenv',
+                '--setenv', 'PATH', '/fake:' + os.environ['PATH'],
+                '--setenv', 'HOME', '/home/alice', '--setenv', 'XDG_RUNTIME_DIR', '/run/user/1000',
+                '--chdir', '/', str(PYTHON), '/test.py', '--inner',
+            ]
+            result = subprocess.run(command, text=True, capture_output=True, timeout=60)
+            self.assertEqual(result.returncode, 0, result.stdout + result.stderr)
+            facts = json.loads(result.stdout.strip().splitlines()[-1])
+        self.assertTrue(facts['gsr_comm_seen'], facts)
+        started = [r[0] for r in facts['recorders'] if r[3] != 'SIGINT']
+        stop = facts['stopped_at']
+        events = [(r[0], 'signalled' if r[3] == 'SIGINT' else 'started ' + ' '.join(r[3]),
+                   round(r[2] - stop, 2)) for r in facts['recorders']]
+        self.assertEqual(started, ['gpu-screen-recorder'],
+                         f'recorders started: {started}; events (s relative to the stop '
+                         f'command returning): {events}; notifications: {facts["notifications"]}')
+        self.assertFalse(facts['still_recording'], facts)
+
+
+if __name__ == '__main__':
+    if sys.argv[1:2] == ['--inner']:
+        inner()
+    else:
+        BIN = Path(sys.argv.pop(1)).resolve()
+        if not shutil.which('bwrap'):
+            raise SystemExit('bubblewrap is required; never run this against the host session')
+        unittest.main()
