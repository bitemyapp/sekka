index 00000000..c3a11cdf
--- /dev/null
+++ b/desktop/aizome/crates/aizome-comp/tests/repro_cpb_18.rs
@@ -0,0 +1,181 @@
+//! CPB-18: an input method's candidate popup (zwp_input_popup_surface_v2,
+//! as fcitx5 and IBus draw their candidate lists) must show. The core
+//! tracks such popups in smithay's PopupManager, but the popup layer
+//! (drawing, hit-testing, capture) walks `popup_order`, which only xdg
+//! popups join.
+
+mod common;
+
+use std::os::unix::net::UnixStream;
+use std::time::{Duration, Instant};
+
+use common::*;
+use wayland_client::globals::{GlobalListContents, registry_queue_init};
+use wayland_client::protocol::{wl_buffer, wl_compositor, wl_registry, wl_seat, wl_shm, wl_shm_pool, wl_surface};
+use wayland_client::{Connection, Dispatch, QueueHandle};
+use wayland_protocols_misc::zwp_input_method_v2::client::{
+    zwp_input_method_manager_v2, zwp_input_method_v2, zwp_input_popup_surface_v2,
+};
+
+/// The candidate list's colour: nothing else on screen is this.
+const MAGENTA: u32 = 0xee11cc;
+
+#[derive(Default)]
+struct Im {
+    active: bool,
+    pending_active: Option<bool>,
+    text_input_rect: Option<(i32, i32, i32, i32)>,
+    /// The preferred buffer scale the popup's surface was told: the logic
+    /// tells every popup smithay lists in a shown window's popup tree.
+    popup_scale: Option<i32>,
+}
+
+#[test]
+fn repro_cpb_18_an_input_methods_candidate_popup_is_drawn() {
+    // At scale 2, so that the logic's buffer-scale refresh (which tells a
+    // surface only what differs from 1) says which popups smithay lists.
+    let c = Compositor::start(Options { outputs: &["1280x800@2"], renderer: Some("pixman"), ..Default::default() });
+
+    // The input method, first.
+    let conn = Connection::from_socket(UnixStream::connect(c.dir.join(&c.socket)).unwrap()).unwrap();
+    let (globals, mut queue) = registry_queue_init::<Im>(&conn).unwrap();
+    let qh = queue.handle();
+    let compositor: wl_compositor::WlCompositor = globals.bind(&qh, 6..=6, ()).unwrap();
+    let shm: wl_shm::WlShm = globals.bind(&qh, 1..=1, ()).unwrap();
+    let seat: wl_seat::WlSeat = globals.bind(&qh, 1..=7, ()).unwrap();
+    let manager: zwp_input_method_manager_v2::ZwpInputMethodManagerV2 =
+        globals.bind(&qh, 1..=1, ()).expect("zwp_input_method_manager_v2");
+    let im = manager.get_input_method(&seat, &qh, ());
+    let mut st = Im::default();
+    queue.roundtrip(&mut st).unwrap();
+
+    // A terminal with a text input, focused: the input method activates.
+    let term = c.client(Spec::new("foot", 0x2222cc).text_input());
+    let w = c.wait_window("foot");
+    term.wait_seen("its text input enabled", |s| s.keyboard_focus && s.ime_enabled);
+    let deadline = Instant::now() + Duration::from_secs(10);
+    while !st.active {
+        assert!(Instant::now() < deadline, "the input method never activated");
+        queue.roundtrip(&mut st).unwrap();
+        std::thread::sleep(Duration::from_millis(20));
+    }
+
+    // Its candidate list: a popup surface with a 160×48 magenta buffer.
+    let surface = compositor.create_surface(&qh, ());
+    let _popup = im.get_input_popup_surface(&surface, &qh, ());
+    let buffer = solid_buffer(&shm, (160, 48), MAGENTA, &qh);
+    surface.attach(Some(&buffer), 0, 0);
+    surface.damage_buffer(0, 0, 160, 48);
+    surface.commit();
+    // The compositor has it: smithay maps it into the window's popup tree
+    // (the logic, walking that tree, tells its surface a buffer scale).
+    let deadline = Instant::now() + Duration::from_secs(3);
+    while st.popup_scale.is_none() && Instant::now() < deadline {
+        queue.roundtrip(&mut st).unwrap();
+        std::thread::sleep(Duration::from_millis(20));
+    }
+    assert!(st.popup_scale.is_some(), "precondition: the popup never joined the window's popup tree");
+    c.settle();
+    c.settle();
+
+    let shot = c.screenshot();
+    let mut magenta = 0;
+    for y in 0..shot.height as i32 {
+        for x in 0..shot.width as i32 {
+            if near(shot.px(x, y), rgb(MAGENTA)) {
+                magenta += 1;
+            }
+        }
+    }
+    let path = keep(&shot, "repro_cpb_18");
+    assert!(
+        magenta >= 160 * 48 / 2,
+        "the input method's 160×48 candidate popup (parent: the text field of the window at {:?}, in that window's \
+         popup tree: its surface was told buffer scale {:?}) isn't on screen: {magenta} magenta pixels in {}",
+        w.geometry,
+        st.popup_scale,
+        path.display()
+    );
+    drop(term);
+}
+
+impl Dispatch<zwp_input_method_v2::ZwpInputMethodV2, ()> for Im {
+    fn event(
+        im: &mut Self,
+        _: &zwp_input_method_v2::ZwpInputMethodV2,
+        event: zwp_input_method_v2::Event,
+        _: &(),
+        _: &Connection,
+        _: &QueueHandle<Self>,
+    ) {
+        use zwp_input_method_v2::Event;
+        match event {
+            Event::Activate => im.pending_active = Some(true),
+            Event::Deactivate => im.pending_active = Some(false),
+            Event::Done => {
+                if let Some(a) = im.pending_active.take() {
+                    im.active = a;
+                }
+            }
+            _ => {}
+        }
+    }
+}
+
+impl Dispatch<zwp_input_popup_surface_v2::ZwpInputPopupSurfaceV2, ()> for Im {
+    fn event(
+        im: &mut Self,
+        _: &zwp_input_popup_surface_v2::ZwpInputPopupSurfaceV2,
+        event: zwp_input_popup_surface_v2::Event,
+        _: &(),
+        _: &Connection,
+        _: &QueueHandle<Self>,
+    ) {
+        if let zwp_input_popup_surface_v2::Event::TextInputRectangle { x, y, width, height } = event {
+            im.text_input_rect = Some((x, y, width, height));
+        }
+    }
+}
+
+impl Dispatch<wl_surface::WlSurface, ()> for Im {
+    fn event(
+        im: &mut Self,
+        _: &wl_surface::WlSurface,
+        event: wl_surface::Event,
+        _: &(),
+        _: &Connection,
+        _: &QueueHandle<Self>,
+    ) {
+        if let wl_surface::Event::PreferredBufferScale { factor } = event {
+            im.popup_scale = Some(factor);
+        }
+    }
+}
+
+impl Dispatch<wl_registry::WlRegistry, GlobalListContents> for Im {
+    fn event(
+        _: &mut Self,
+        _: &wl_registry::WlRegistry,
+        _: wl_registry::Event,
+        _: &GlobalListContents,
+        _: &Connection,
+        _: &QueueHandle<Self>,
+    ) {
+    }
+}
+
+macro_rules! ignore {
+    ($($t:ty),*) => {$(
+        impl Dispatch<$t, ()> for Im {
+            fn event(_: &mut Self, _: &$t, _: <$t as wayland_client::Proxy>::Event, _: &(), _: &Connection, _: &QueueHandle<Self>) {}
+        }
+    )*};
+}
+ignore!(
+    wl_compositor::WlCompositor,
+    wl_shm::WlShm,
+    wl_shm_pool::WlShmPool,
+    wl_buffer::WlBuffer,
+    wl_seat::WlSeat,
+    zwp_input_method_manager_v2::ZwpInputMethodManagerV2
+);
diff --git a/desktop/aizome/crates/aizome-comp/tests/repro_cpb_20.rs b/desktop/aizome/crates/aizome-comp/tests/repro_cpb_20.rs
new file mode 100644
index 00000000..94880d24
--- /dev/null
+++ b/desktop/aizome/crates/aizome-comp/tests/repro_cpb_20.rs
@@ -0,0 +1,251 @@
+//! CPB-20: wlr-foreign-toplevel-management v3 `parent`. A dialog whose
+//! parent is set after it mapped (xdg_toplevel.set_parent on a mapped
+//! toplevel) must be re-parented in taskbars: its handle must get a
+//! `parent` event naming the parent's handle. The core compares the
+//! parent in its per-window snapshot but sends `parent` only when it
+//! announces a window.
+
+mod common;
+
+use std::collections::HashMap;
+use std::os::unix::net::UnixStream;
+use std::time::{Duration, Instant};
+
+use common::*;
+use wayland_client::backend::ObjectId;
+use wayland_client::globals::{GlobalListContents, registry_queue_init};
+use wayland_client::protocol::{wl_buffer, wl_compositor, wl_registry, wl_shm, wl_shm_pool, wl_surface};
+use wayland_client::{Connection, Dispatch, EventQueue, Proxy, QueueHandle, event_created_child};
+use wayland_protocols::xdg::shell::client::{xdg_surface, xdg_toplevel, xdg_wm_base};
+use wayland_protocols_wlr::foreign_toplevel::v1::client::{
+    zwlr_foreign_toplevel_handle_v1 as handle, zwlr_foreign_toplevel_manager_v1 as manager,
+};
+
+// ---- an app with a main window and a dialog -------------------------------------
+
+struct App {
+    shm: wl_shm::WlShm,
+    surfaces: Vec<(wl_surface::WlSurface, u32)>,
+}
+
+struct Windows {
+    conn: Connection,
+    queue: EventQueue<App>,
+    app: App,
+    toplevels: Vec<xdg_toplevel::XdgToplevel>,
+}
+
+impl Windows {
+    fn new(c: &Compositor) -> Windows {
+        let conn = Connection::from_socket(UnixStream::connect(c.dir.join(&c.socket)).unwrap()).unwrap();
+        let (globals, mut queue) = registry_queue_init::<App>(&conn).unwrap();
+        let qh = queue.handle();
+        let compositor: wl_compositor::WlCompositor = globals.bind(&qh, 4..=6, ()).unwrap();
+        let shm: wl_shm::WlShm = globals.bind(&qh, 1..=1, ()).unwrap();
+        let wm: xdg_wm_base::XdgWmBase = globals.bind(&qh, 1..=6, ()).unwrap();
+        let mut app = App { shm, surfaces: Vec::new() };
+        let mut toplevels = Vec::new();
+        for (i, (app_id, color)) in [("org.test.main", 0x3366ccu32), ("org.test.dialog", 0xdd7722)].iter().enumerate() {
+            let s = compositor.create_surface(&qh, ());
+            let xs = wm.get_xdg_surface(&s, &qh, i);
+            let tl = xs.get_toplevel(&qh, ());
+            tl.set_app_id((*app_id).into());
+            tl.set_title((*app_id).into());
+            s.commit();
+            app.surfaces.push((s, *color));
+            toplevels.push(tl);
+        }
+        queue.roundtrip(&mut app).unwrap();
+        Windows { conn, queue, app, toplevels }
+    }
+
+    fn roundtrip(&mut self) {
+        if let Err(e) = self.queue.roundtrip(&mut self.app) {
+            panic!("app disconnected: {e} ({:?})", self.conn.protocol_error());
+        }
+    }
+}
+
+impl Dispatch<xdg_surface::XdgSurface, usize> for App {
+    fn event(
+        app: &mut Self,
+        xs: &xdg_surface::XdgSurface,
+        event: xdg_surface::Event,
+        i: &usize,
+        _: &Connection,
+        qh: &QueueHandle<Self>,
+    ) {
+        if let xdg_surface::Event::Configure { serial } = event {
+            xs.ack_configure(serial);
+            let (s, color) = app.surfaces[*i].clone();
+            let (w, h) = if *i == 0 { (400, 300) } else { (240, 160) };
+            let buffer = solid_buffer(&app.shm, (w, h), color, qh);
+            s.attach(Some(&buffer), 0, 0);
+            s.damage_buffer(0, 0, w, h);
+            s.commit();
+        }
+    }
+}
+
+impl Dispatch<xdg_wm_base::XdgWmBase, ()> for App {
+    fn event(
+        _: &mut Self,
+        wm: &xdg_wm_base::XdgWmBase,
+        event: xdg_wm_base::Event,
+        _: &(),
+        _: &Connection,
+        _: &QueueHandle<Self>,
+    ) {
+        if let xdg_wm_base::Event::Ping { serial } = event {
+            wm.pong(serial);
+        }
+    }
+}
+
+impl Dispatch<wl_registry::WlRegistry, GlobalListContents> for App {
+    fn event(
+        _: &mut Self,
+        _: &wl_registry::WlRegistry,
+        _: wl_registry::Event,
+        _: &GlobalListContents,
+        _: &Connection,
+        _: &QueueHandle<Self>,
+    ) {
+    }
+}
+
+macro_rules! ignore {
+    ($s:ty: $($t:ty),*) => {$(
+        impl Dispatch<$t, ()> for $s {
+            fn event(_: &mut Self, _: &$t, _: <$t as wayland_client::Proxy>::Event, _: &(), _: &Connection, _: &QueueHandle<Self>) {}
+        }
+    )*};
+}
+ignore!(App: wl_compositor::WlCompositor, wl_shm::WlShm, wl_shm_pool::WlShmPool, wl_buffer::WlBuffer,
+    wl_surface::WlSurface, xdg_toplevel::XdgToplevel);
+
+// ---- a taskbar ---------------------------------------------------------------------
+
+#[derive(Default, Debug)]
+struct Bar {
+    /// Per handle: its app id and the parent handle it was last told of.
+    handles: HashMap<ObjectId, (String, Option<ObjectId>)>,
+    parent_events: u32,
+}
+
+impl Bar {
+    fn handle_of(&self, app_id: &str) -> Option<ObjectId> {
+        self.handles.iter().find(|(_, (a, _))| a == app_id).map(|(id, _)| id.clone())
+    }
+}
+
+impl Dispatch<manager::ZwlrForeignToplevelManagerV1, ()> for Bar {
+    fn event(
+        _: &mut Self,
+        _: &manager::ZwlrForeignToplevelManagerV1,
+        _: manager::Event,
+        _: &(),
+        _: &Connection,
+        _: &QueueHandle<Self>,
+    ) {
+    }
+
+    event_created_child!(Bar, manager::ZwlrForeignToplevelManagerV1, [
+        manager::EVT_TOPLEVEL_OPCODE => (handle::ZwlrForeignToplevelHandleV1, ()),
+    ]);
+}
+
+impl Dispatch<handle::ZwlrForeignToplevelHandleV1, ()> for Bar {
+    fn event(
+        bar: &mut Self,
+        h: &handle::ZwlrForeignToplevelHandleV1,
+        event: handle::Event,
+        _: &(),
+        _: &Connection,
+        _: &QueueHandle<Self>,
+    ) {
+        let entry = bar.handles.entry(h.id()).or_default();
+        match event {
+            handle::Event::AppId { app_id } => entry.0 = app_id,
+            handle::Event::Parent { parent } => {
+                entry.1 = parent.map(|p| p.id());
+                bar.parent_events += 1;
+            }
+            handle::Event::Closed => {
+                bar.handles.remove(&h.id());
+            }
+            _ => {}
+        }
+    }
+}
+
+impl Dispatch<wl_registry::WlRegistry, GlobalListContents> for Bar {
+    fn event(
+        _: &mut Self,
+        _: &wl_registry::WlRegistry,
+        _: wl_registry::Event,
+        _: &GlobalListContents,
+        _: &Connection,
+        _: &QueueHandle<Self>,
+    ) {
+    }
+}
+
+#[test]
+fn repro_cpb_20_a_dialog_parented_after_it_mapped_is_reparented_in_taskbars() {
+    let c = Compositor::start(Options { renderer: Some("pixman"), ..Default::default() });
+    let mut app = Windows::new(&c);
+    let deadline = Instant::now() + Duration::from_secs(10);
+    let (main, dialog) = loop {
+        app.roundtrip();
+        let ws = c.windows();
+        let find = |a: &str| ws.iter().find(|w| w.app_id == a).cloned();
+        if let (Some(m), Some(d)) = (find("org.test.main"), find("org.test.dialog")) {
+            break (m, d);
+        }
+        assert!(Instant::now() < deadline, "the windows didn't map: {ws:#?}");
+        std::thread::sleep(Duration::from_millis(30));
+    };
+    assert_eq!(dialog.parent, None, "the dialog mapped without a parent");
+
+    // The taskbar, as waybar's or sfwbar's: both windows, no parents.
+    let conn = Connection::from_socket(UnixStream::connect(c.dir.join(&c.socket)).unwrap()).unwrap();
+    let (globals, mut queue) = registry_queue_init::<Bar>(&conn).unwrap();
+    let qh = queue.handle();
+    let _manager: manager::ZwlrForeignToplevelManagerV1 =
+        globals.bind(&qh, 3..=3, ()).expect("wlr-foreign-toplevel-management v3");
+    let mut bar = Bar::default();
+    queue.roundtrip(&mut bar).unwrap();
+    queue.roundtrip(&mut bar).unwrap();
+    let main_handle = bar.handle_of("org.test.main").expect("the main window's handle");
+    let dialog_handle = bar.handle_of("org.test.dialog").expect("the dialog's handle");
+    assert_eq!(bar.handles[&dialog_handle].1, None);
+
+    // Now the app makes the dialog the main window's (GTK does this when a
+    // dialog is reused for another window, Qt when it's reparented).
+    app.toplevels[1].set_parent(Some(&app.toplevels[0]));
+    app.roundtrip();
+    let deadline = Instant::now() + Duration::from_secs(5);
+    loop {
+        app.roundtrip();
+        if c.window("org.test.dialog").and_then(|w| w.parent) == Some(main.id) {
+            break;
+        }
+        assert!(Instant::now() < deadline, "the compositor never took the new parent: {:#?}", c.windows());
+        std::thread::sleep(Duration::from_millis(30));
+    }
+    // The taskbar should hear of it.
+    let deadline = Instant::now() + Duration::from_secs(3);
+    while bar.handles[&dialog_handle].1.as_ref() != Some(&main_handle) && Instant::now() < deadline {
+        queue.roundtrip(&mut bar).unwrap();
+        std::thread::sleep(Duration::from_millis(30));
+    }
+    assert_eq!(
+        bar.handles[&dialog_handle].1.as_ref(),
+        Some(&main_handle),
+        "the compositor knows the dialog's parent is window {} (IPC), but the taskbar's handle for it never got a \
+         `parent` event ({} parent events in all, all at announce): {bar:?}",
+        main.id,
+        bar.parent_events
+    );
+}
diff --git a/desktop/aizome/crates/aizome-comp/tests/repro_cpb_22.rs b/desktop/aizome/crates/aizome-comp/tests/repro_cpb_22.rs
new file mode 100644
index 00000000..db726988
--- /dev/null
+++ b/desktop/aizome/crates/aizome-comp/tests/repro_cpb_22.rs
@@ -0,0 +1,278 @@
+//! CPB-22: ext-image-copy-capture, a frame replaced (by the session's
+//! next `create_frame`, which Aizome lets take over rather than raise
+//! `duplicate_frame`) whose copy still runs: its copy advances the
+//! session's damage, `ready` drops it, and the new frame then waits for
+//! the next change. On an idle screen the stream stalls on content the
+//! client never received.
+//!
+//! The entry's case has the copy in flight on a GPU fence when the new
+//! frame comes (GLES, dmabuf). Here, under pixman, copies finish within
+//! the loop iteration, so the replaced frame's copy is brought about the
+//! other way the core allows: `capture` queues a frame that is no longer
+//! the session's current one.
+
+mod common;
+
+use std::io::Write;
+use std::os::fd::{AsFd, AsRawFd, FromRawFd, OwnedFd};
+use std::os::unix::net::UnixStream;
+use std::time::{Duration, Instant};
+
+use common::*;
+use wayland_client::globals::{GlobalListContents, registry_queue_init};
+use wayland_client::protocol::{wl_buffer, wl_output, wl_registry, wl_shm, wl_shm_pool};
+use wayland_client::{Connection, Dispatch, EventQueue, QueueHandle, WEnum};
+use wayland_protocols::ext::image_capture_source::v1::client::{
+    ext_image_capture_source_v1, ext_output_image_capture_source_manager_v1,
+};
+use wayland_protocols::ext::image_copy_capture::v1::client::{
+    ext_image_copy_capture_frame_v1, ext_image_copy_capture_manager_v1, ext_image_copy_capture_session_v1,
+};
+
+use ext_image_copy_capture_frame_v1::ExtImageCopyCaptureFrameV1 as Frame;
+use ext_image_copy_capture_session_v1::ExtImageCopyCaptureSessionV1 as Session;
+
+const BLUE: u32 = 0x3366cc;
+const ORANGE: u32 = 0xdd7722;
+
+#[derive(Default)]
+struct Heard {
+    size: Option<(u32, u32)>,
+    constraints: u32,
+    stopped: bool,
+    /// Frames (by their tag) that came ready, and that failed.
+    ready: Vec<u32>,
+    failed: Vec<(u32, u32)>,
+}
+
+struct Capturer {
+    conn: Connection,
+    queue: EventQueue<Heard>,
+    qh: QueueHandle<Heard>,
+    heard: Heard,
+    shm: wl_shm::WlShm,
+    output: wl_output::WlOutput,
+    manager: ext_image_copy_capture_manager_v1::ExtImageCopyCaptureManagerV1,
+    outputs: ext_output_image_capture_source_manager_v1::ExtOutputImageCaptureSourceManagerV1,
+}
+
+/// A wl_shm buffer and the memfd behind it.
+struct Target {
+    _pool: wl_shm_pool::WlShmPool,
+    buffer: wl_buffer::WlBuffer,
+    file: std::fs::File,
+    w: u32,
+    h: u32,
+}
+
+impl Target {
+    fn px(&self, x: u32, y: u32) -> [u8; 3] {
+        let len = (self.w * 4 * self.h) as usize;
+        // Safety: the client's own memfd, `len` bytes.
+        let map = unsafe {
+            libc::mmap(std::ptr::null_mut(), len, libc::PROT_READ, libc::MAP_SHARED, self.file.as_raw_fd(), 0)
+        };
+        assert_ne!(map, libc::MAP_FAILED);
+        // Safety: mapped above.
+        let b = unsafe { std::slice::from_raw_parts(map as *const u8, len) };
+        let i = ((y * self.w + x) * 4) as usize;
+        let px = [b[i + 2], b[i + 1], b[i]];
+        // Safety: unmapping what we mapped.
+        unsafe { libc::munmap(map, len) };
+        px
+    }
+}
+
+impl Capturer {
+    fn new(c: &Compositor) -> Capturer {
+        let conn = Connection::from_socket(UnixStream::connect(c.dir.join(&c.socket)).unwrap()).unwrap();
+        let (globals, mut queue) = registry_queue_init::<Heard>(&conn).unwrap();
+        let qh = queue.handle();
+        let shm = globals.bind(&qh, 1..=1, ()).unwrap();
+        let output = globals.bind(&qh, 1..=4, ()).unwrap();
+        let manager = globals.bind(&qh, 1..=1, ()).expect("ext-image-copy-capture");
+        let outputs = globals.bind(&qh, 1..=1, ()).expect("output capture sources");
+        let mut heard = Heard::default();
+        queue.roundtrip(&mut heard).unwrap();
+        Capturer { conn, queue, qh, heard, shm, output, manager, outputs }
+    }
+
+    fn output_session(&mut self) -> Session {
+        let source = self.outputs.create_source(&self.output, &self.qh, ());
+        let session = self.manager.create_session(
+            &source,
+            ext_image_copy_capture_manager_v1::Options::empty(),
+            &self.qh,
+            (),
+        );
+        assert!(self.wait(Duration::from_secs(5), |h| h.constraints > 0 || h.stopped), "no constraints");
+        assert!(!self.heard.stopped);
+        session
+    }
+
+    fn target(&self) -> Target {
+        let (w, h) = self.heard.size.expect("a buffer size");
+        let len = (w * 4 * h) as usize;
+        // Safety: memfd_create with a static name.
+        let fd = unsafe { OwnedFd::from_raw_fd(libc::memfd_create(c"aizome-capture".as_ptr(), 0)) };
+        let mut file = std::fs::File::from(fd);
+        file.write_all(&vec![0u8; len]).unwrap();
+        let pool = self.shm.create_pool(file.as_fd(), len as i32, &self.qh, ());
+        let buffer = pool.create_buffer(0, w as i32, h as i32, (w * 4) as i32, wl_shm::Format::Xrgb8888, &self.qh, ());
+        Target { _pool: pool, buffer, file, w, h }
+    }
+
+    fn capture(frame: &Frame, t: &Target) {
+        frame.attach_buffer(&t.buffer);
+        frame.damage_buffer(0, 0, t.w as i32, t.h as i32);
+        frame.capture();
+    }
+
+    fn wait(&mut self, within: Duration, done: impl Fn(&Heard) -> bool) -> bool {
+        let deadline = Instant::now() + within;
+        loop {
+            self.queue.dispatch_pending(&mut self.heard).unwrap();
+            if done(&self.heard) {
+                return true;
+            }
+            let left = deadline.saturating_duration_since(Instant::now());
+            if left.is_zero() {
+                return false;
+            }
+            self.conn.flush().unwrap();
+            if let Some(guard) = self.queue.prepare_read() {
+                let fd = guard.connection_fd();
+                let mut pfd = libc::pollfd { fd: fd.as_raw_fd(), events: libc::POLLIN, revents: 0 };
+                // Safety: one valid pollfd.
+                if unsafe { libc::poll(&mut pfd, 1, left.as_millis().min(100) as i32) } > 0 {
+                    guard.read().unwrap();
+                }
+            }
+        }
+    }
+}
+
+#[test]
+fn repro_cpb_22_a_replaced_frames_copy_doesnt_stall_the_next_frame() {
+    let c = Compositor::start(Options { renderer: Some("pixman"), ..Default::default() });
+    let client = c.client(Spec::new("org.test.capture", BLUE).size(300, 200));
+    let r = c.wait_window("org.test.capture").geometry;
+    c.settle();
+    let (x, y) = ((r.x + 150) as u32, (r.y + 100) as u32);
+    let mut cap = Capturer::new(&c);
+    let session = cap.output_session();
+
+    // The stream's first frame.
+    let t0 = cap.target();
+    let f0 = session.create_frame(&cap.qh, 0u32);
+    Capturer::capture(&f0, &t0);
+    assert!(cap.wait(Duration::from_secs(5), |h| h.ready.contains(&0)), "the first frame");
+    f0.destroy();
+    assert!(near(t0.px(x, y), rgb(BLUE)));
+
+    // The screen changes once, and then stays still.
+    client.send(Cmd::Color(ORANGE));
+    let deadline = Instant::now() + Duration::from_secs(5);
+    while !near(c.screenshot().px(x as i32, y as i32), rgb(ORANGE)) {
+        assert!(Instant::now() < deadline, "the window never turned orange");
+        c.settle();
+    }
+
+    // The client makes its next frame twice over (the portal's pause and
+    // resume): the second replaces the first, and both are captured.
+    let (t1, t2) = (cap.target(), cap.target());
+    let f1 = session.create_frame(&cap.qh, 1u32);
+    let f2 = session.create_frame(&cap.qh, 2u32);
+    Capturer::capture(&f1, &t1);
+    Capturer::capture(&f2, &t2);
+    let got = cap.wait(Duration::from_secs(3), |h| h.ready.contains(&2) || h.failed.iter().any(|(t, _)| *t == 2));
+    let replaced = if cap.heard.ready.contains(&1) {
+        "answered"
+    } else if cap.heard.failed.iter().any(|(t, _)| *t == 1) {
+        "failed"
+    } else {
+        "never answered"
+    };
+    let copied = near(t1.px(x, y), rgb(ORANGE));
+    assert!(
+        got && cap.heard.ready.contains(&2),
+        "the session's current frame got nothing in 3 s on an idle screen; the replaced frame was {replaced}, and \
+         {} (failed: {:?})",
+        if copied { "its buffer holds the orange change: its copy took the stream's damage" } else { "not copied" },
+        cap.heard.failed
+    );
+    assert!(near(t2.px(x, y), rgb(ORANGE)), "the current frame shows the change: {:?}", t2.px(x, y));
+    drop(client);
+}
+
+impl Dispatch<Session, ()> for Heard {
+    fn event(
+        h: &mut Self,
+        _: &Session,
+        event: ext_image_copy_capture_session_v1::Event,
+        _: &(),
+        _: &Connection,
+        _: &QueueHandle<Self>,
+    ) {
+        use ext_image_copy_capture_session_v1::Event;
+        match event {
+            Event::BufferSize { width, height } => h.size = Some((width, height)),
+            Event::Done => h.constraints += 1,
+            Event::Stopped => h.stopped = true,
+            _ => {}
+        }
+    }
+}
+
+impl Dispatch<Frame, u32> for Heard {
+    fn event(
+        h: &mut Self,
+        _: &Frame,
+        event: ext_image_copy_capture_frame_v1::Event,
+        tag: &u32,
+        _: &Connection,
+        _: &QueueHandle<Self>,
+    ) {
+        use ext_image_copy_capture_frame_v1::Event;
+        match event {
+            Event::Ready => h.ready.push(*tag),
+            Event::Failed { reason } => {
+                let r = match reason {
+                    WEnum::Value(v) => v as u32,
+                    WEnum::Unknown(u) => u,
+                };
+                h.failed.push((*tag, r));
+            }
+            _ => {}
+        }
+    }
+}
+
+impl Dispatch<wl_registry::WlRegistry, GlobalListContents> for Heard {
+    fn event(
+        _: &mut Self,
+        _: &wl_registry::WlRegistry,
+        _: wl_registry::Event,
+        _: &GlobalListContents,
+        _: &Connection,
+        _: &QueueHandle<Self>,
+    ) {
+    }
+}
+
+macro_rules! ignore {
+    ($($t:ty),*) => {$(
+        impl Dispatch<$t, ()> for Heard {
+            fn event(_: &mut Self, _: &$t, _: <$t as wayland_client::Proxy>::Event, _: &(), _: &Connection, _: &QueueHandle<Self>) {}
+        }
+    )*};
+}
+ignore!(
+    wl_shm::WlShm,
+    wl_shm_pool::WlShmPool,
+    wl_buffer::WlBuffer,
+    wl_output::WlOutput,
+    ext_image_copy_capture_manager_v1::ExtImageCopyCaptureManagerV1,
+    ext_output_image_capture_source_manager_v1::ExtOutputImageCaptureSourceManagerV1,
+    ext_image_capture_source_v1::ExtImageCaptureSourceV1
+);
diff --git a/desktop/aizome/crates/aizome-comp/tests/repro_cpb_24.rs b/desktop/aizome/crates/aizome-comp/tests/repro_cpb_24.rs
