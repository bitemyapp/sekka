+//! UIW-01: a release over a control that was never pressed (the press was
+//! on inert background) must not click it.
+
+use aizome_kit::column;
+use aizome_kit::prelude::*;
+use aizome_kit::sidestep_ui::PointerButton;
+use aizome_kit::testing::Harness;
+
+#[derive(Default)]
+struct Controls {
+    log: Vec<String>,
+}
+
+#[derive(Clone, Debug)]
+enum Msg {
+    Button,
+    Toggle(bool),
+    Check(bool),
+    Segment(usize),
+}
+
+impl Program for Controls {
+    type Msg = Msg;
+    fn info(&self) -> AppInfo {
+        AppInfo::new("org.aizome.ReproUiw01", "Repro", "Repro")
+    }
+    fn launched(&mut self, cx: &mut Cx<Msg>) {
+        cx.open_window(WindowSpec::new("Controls").size(500.0, 400.0));
+    }
+    fn update(&mut self, msg: Msg, _cx: &mut Cx<Msg>) {
+        self.log.push(format!("{msg:?}"));
+    }
+    fn view(&self, _w: WindowKey) -> Element<Msg> {
+        column![
+            text("Inert background text").id("bg"),
+            button("Press").on_press(Msg::Button).id("button"),
+            toggle(false).on_toggle(Msg::Toggle).id("toggle"),
+            checkbox("Check", false).on_toggle(Msg::Check).id("check"),
+            segmented(["One", "Two"], Some(0)).on_select(Msg::Segment).id("seg"),
+        ]
+        .spacing(30.0)
+        .padding(20.0)
+        .into()
+    }
+}
+
+#[test]
+fn repro_uiw_01_release_without_a_press_clicks_nothing() {
+    let mut h = Harness::new(Controls::default());
+    let w = h.window();
+    // Empty window background, away from every control.
+    let bg = Point::new(490.0, 390.0);
+    let mut fired = Vec::new();
+    for id in ["button", "toggle", "check", "seg"] {
+        let r = h.find_id(w, id).unwrap();
+        // The segment under the pointer: the second.
+        let at = if id == "seg" { Point::new(r.x0 + r.width() * 0.75, r.center().y) } else { r.center() };
+        let before = h.program().log.len();
+        h.press(w, bg, PointerButton::Left, 1);
+        h.move_to(w, at);
+        h.release(w, at, PointerButton::Left);
+        let new: Vec<String> = h.program().log[before..].to_vec();
+        if !new.is_empty() {
+            fired.push((id, new));
+        }
+    }
+    println!("controls that fired on a release with no press: {fired:?}");
+    assert!(fired.is_empty(), "a release without a press on the control must not fire it: {fired:?}");
+}
