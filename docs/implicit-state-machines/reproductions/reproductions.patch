+++ b/desktop/aizome/apps/koyomi/tests/repro_koy_04.rs
@@ -0,0 +1,97 @@
+//! KOY-04: navigation and selection. A day clicked in Month (or Week)
+//! view moves only `cursor`; ❖1 then shows `anchor`'s day while the
+//! agenda and New Event use the clicked day. And a selection that's no
+//! longer on screen (navigated away, or its calendar hidden) is still
+//! what ⌫ deletes.
+
+mod common;
+
+use aizome_kit::Point;
+use aizome_kit::sidestep_ui::{Modifiers, NamedKey};
+use aizome_kit::theme::ThemeChoice;
+use common::*;
+use jiff::civil::date;
+use koyomi::app::{Msg, View};
+
+fn review_exists(h: &aizome_kit::testing::Harness<koyomi::app::Koyomi>) -> bool {
+    h.program().store.calendars.iter().any(|c| c.events.iter().any(|e| e.uid == "review@test"))
+}
+
+#[test]
+fn repro_koy_04_day_view_after_clicking_a_day_shows_that_day() {
+    let mut h = harness("repro-koy04-a", ThemeChoice::Night);
+    let w = h.window();
+    assert_eq!(h.program().view, View::Month);
+    // Click Wednesday 14 October's empty space (below its chips).
+    let wed = h
+        .semantics(w)
+        .into_iter()
+        .find(|(s, _)| s.label.as_deref().is_some_and(|l| l.starts_with("Wednesday 14 October 2026")))
+        .map(|(_, r)| r)
+        .expect("the 14th's cell");
+    h.click(w, Point::new(wed.center().x, wed.y1 - 6.0));
+    assert_eq!(h.program().cursor, date(2026, 10, 14), "the click selects the 14th");
+    // View ▸ Day (❖1).
+    h.command(w, '1');
+    let k = h.program();
+    assert_eq!(k.view, View::Day);
+    let shown = k.range().0;
+    let title = k.title().0;
+    let texts = h.texts(w);
+    // The agenda filters the shown occurrences by the cursor's day; the
+    // grid shows the anchor's.
+    let agenda_empty = texts.iter().any(|t| t == "Nothing on this day.");
+    let grid_has_market = texts.iter().any(|t| t == "Farmers' market");
+    let cursor = k.cursor;
+    // New Event goes on the cursor's day.
+    h.send(Msg::NewEvent);
+    let new_day = h.program().editor.as_ref().expect("the editor").times().unwrap().0.date();
+    assert!(
+        shown == date(2026, 10, 14) && new_day == shown && !agenda_empty,
+        "❖1 after clicking the 14th should show the 14th, with its agenda and New Event there: the Day view \
+         shows {shown} (title {title:?}; the 17th's Farmers' market in the grid: {grid_has_market}), the cursor \
+         is {cursor}, the agenda says \"Nothing on this day.\": {agenda_empty}, and New Event opens on {new_day}"
+    );
+}
+
+#[test]
+fn repro_koy_04_delete_after_navigating_away_keeps_the_unseen_event() {
+    let mut h = harness("repro-koy04-b", ThemeChoice::Night);
+    let w = h.window();
+    h.send(Msg::SetView(View::Week));
+    let review = h.find(w, "Design review: Koyomi").expect("the review's block");
+    h.click(w, review.center());
+    assert_eq!(h.program().selected.as_ref().map(|s| s.uid.as_str()), Some("review@test"));
+    // → to the next week: the review isn't on screen.
+    h.named(w, NamedKey::ArrowRight, Modifiers::NONE);
+    assert_eq!(h.program().range(), (date(2026, 10, 19), date(2026, 10, 25)));
+    let on_screen = h.program().selected_event().is_some();
+    let still_selected = h.program().selected.is_some();
+    // ⌫
+    h.named(w, NamedKey::Backspace, Modifiers::NONE);
+    assert!(
+        review_exists(&h),
+        "⌫ in a week that doesn't show the selected event should not delete it (selected: {still_selected}, \
+         shown: {on_screen}; note: {:?})",
+        h.program().note
+    );
+}
+
+#[test]
+fn repro_koy_04_delete_after_hiding_its_calendar_keeps_the_unseen_event() {
+    let mut h = harness("repro-koy04-c", ThemeChoice::Night);
+    let w = h.window();
+    h.send(Msg::SetView(View::Week));
+    let review = h.find(w, "Design review: Koyomi").expect("the review's block");
+    h.click(w, review.center());
+    assert_eq!(h.program().selected.as_ref().map(|s| s.uid.as_str()), Some("review@test"));
+    // Hide Work (the sidebar's toggle).
+    h.send(Msg::ToggleCalendar("work".into()));
+    let on_screen = h.program().selected_event().is_some();
+    h.named(w, NamedKey::Backspace, Modifiers::NONE);
+    assert!(
+        review_exists(&h),
+        "⌫ with the selected event's calendar hidden should not delete it (shown: {on_screen}; note: {:?})",
+        h.program().note
+    );
+}
diff --git a/desktop/aizome/apps/koyomi/tests/repro_koy_05.rs b/desktop/aizome/apps/koyomi/tests/repro_koy_05.rs
