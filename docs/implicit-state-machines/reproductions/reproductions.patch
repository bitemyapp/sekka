@@ -0,0 +1,50 @@
+//! SAP-18: move a picture of folder A to the Trash, open folder B, ❖Z: the
+//! file goes back to A, and whatever shows must be among its own folder's
+//! pictures. `undo_trash` inserts the restored path into the list of the
+//! moment (B's) and shows it there, with B's pictures as its neighbours.
+
+use std::path::PathBuf;
+
+use aizome_kit::theme::ThemeChoice;
+use aizome_shashin::Msg;
+
+mod common;
+use common::*;
+
+fn private(name: &str) -> PathBuf {
+    let d = std::env::temp_dir().join(format!("repro-sap-18-{name}-{}", std::process::id()));
+    let _ = std::fs::remove_dir_all(&d);
+    std::fs::create_dir_all(&d).unwrap();
+    d
+}
+
+#[test]
+fn undo_after_opening_another_folder_shows_the_picture_among_its_own() {
+    let a = private("a");
+    write_folder(&a);
+    let b = private("b");
+    sprite().save(b.join("yak.png")).unwrap();
+    sprite().save(b.join("zebra.png")).unwrap();
+    let mut r = rig_in(a.clone(), ThemeChoice::Night, "IMG_2.jpg");
+    let original = a.join("IMG_2.jpg");
+
+    r.h.send(Msg::Trash);
+    settle(&mut r, 1.0);
+    assert!(!original.exists(), "in the Trash");
+    r.h.send(Msg::Open(vec![b.join("yak.png")]));
+    settle(&mut r, 1.0);
+    assert_eq!(r.h.program().folder.len(), 2, "B's pictures");
+    r.h.send(Msg::Undo);
+    settle(&mut r, 1.0);
+    assert!(original.exists(), "back in A");
+
+    let p = r.h.program();
+    let cur = p.current_path().cloned();
+    let dir = cur.as_ref().and_then(|c| c.parent()).map(|d| d.to_path_buf());
+    let strangers: Vec<&PathBuf> = p.folder.iter().filter(|x| x.parent().map(|d| d.to_path_buf()) != dir).collect();
+    assert!(
+        strangers.is_empty(),
+        "showing {cur:?} with another folder's pictures as its neighbours: {:?}",
+        p.folder
+    );
+}
diff --git a/desktop/aizome/apps/shiori/tests/repro_tsh_02.rs b/desktop/aizome/apps/shiori/tests/repro_tsh_02.rs
new file mode 100644
index 00000000..5c7f51c8
--- /dev/null
+++ b/desktop/aizome/apps/shiori/tests/repro_tsh_02.rs
@@ -0,0 +1,83 @@
+//! TSH-02: a document is showing at page 9 when its worker dies, and the
+//! supervisor can't start another (the program is gone, as an old store
+//! path after an upgrade and a collection; or fork fails), so it sends
+//! `OpenFailed(Worker)`. What showed must stay (Open, nothing more drawn),
+//! and Reload must reopen it in place, not as a new document at the top.
+//!
+//! Real hayro workers through a link to the worker program that the test
+//! removes before killing the worker it started.
+
+mod common;
+
+use std::time::Duration;
+
+use aizome_kit::testing::Harness;
+use aizome_kit::Appearance;
+use aizome_shiori::app::{Load, Msg, Shiori};
+use aizome_shiori::places::Places;
+
+fn settle(h: &mut Harness<Shiori>) {
+    let mut quiet = 0;
+    for _ in 0..3000 {
+        for w in h.windows() {
+            let _ = h.render(w, 1.0);
+        }
+        h.send(Msg::Nothing);
+        h.advance(Duration::from_millis(20));
+        if h.program().idle() {
+            quiet += 1;
+            if quiet >= 4 {
+                return;
+            }
+        } else {
+            quiet = 0;
+        }
+        std::thread::sleep(Duration::from_millis(3));
+    }
+    panic!("Shiori didn't settle");
+}
+
+#[test]
+fn a_worker_that_cant_be_started_again_leaves_the_document_showing() {
+    let dir = common::scratch("repro-tsh02");
+    common::write(&dir, "long.pdf", &common::long(12));
+    let link = dir.join("worker");
+    std::os::unix::fs::symlink(common::worker(), &link).unwrap();
+    let mut app = Shiori::new();
+    app.worker = link.clone();
+    app.places = Places::load(dir.join("places.json"));
+    app.dry_run = true;
+    app.initial = vec![dir.join("long.pdf")];
+    let mut h = Harness::with(app, Appearance::default(), false);
+    settle(&mut h);
+    let w = h.window();
+    h.send(Msg::GoPage(w, 8));
+    settle(&mut h);
+    assert_eq!(h.program().docs[0].current_page(), 8);
+
+    // The worker program goes; then the worker dies.
+    std::fs::remove_file(&link).unwrap();
+    let pid = h.program().docs[0].engine.as_ref().and_then(|e| e.pid()).expect("a worker");
+    // SAFETY: a signal to our own child.
+    unsafe { libc::kill(pid as i32, libc::SIGKILL) };
+    assert!(h.settle(Duration::from_secs(30), |p| p.docs[0].engine.is_none()), "no worker could be started");
+    settle(&mut h);
+    let load = format!("{:?}", h.program().docs[0].load);
+    let open = matches!(h.program().docs[0].load, Load::Open(_));
+
+    // The program is back; Reload.
+    std::os::unix::fs::symlink(common::worker(), &link).unwrap();
+    h.send(Msg::Reload);
+    settle(&mut h);
+    let page = h.program().docs[0].current_page();
+    let reopened = matches!(h.program().docs[0].load, Load::Open(_));
+    drop(h);
+    let _ = std::fs::remove_dir_all(&dir);
+
+    assert!(reopened, "Reload opened it again");
+    assert!(
+        open && page == 8,
+        "the document that showed became {load}; Reload then opened it on page {} (it showed page 9)",
+        page + 1
+    );
+}
diff --git a/desktop/aizome/apps/shiori/tests/repro_tsh_08.rs b/desktop/aizome/apps/shiori/tests/repro_tsh_08.rs
new file mode 100644
index 00000000..4ce6f778
--- /dev/null
+++ b/desktop/aizome/apps/shiori/tests/repro_tsh_08.rs
@@ -0,0 +1,91 @@
+//! TSH-08: the worker is gone for good (`engine` none) but the document
+//! still shows (Load stays Open). A copy of a selection over pages whose
+//! text was never read must not wait forever for text no worker will
+//! read: it copies what there is, or says why, and Shiori settles.
+//!
+//! Real hayro workers; the worker is lost as the existing tests lose it
+//! (the file unreadable when the worker started again opens it).
+
+mod common;
+
+use std::os::unix::fs::PermissionsExt;
+use std::time::Duration;
+
+use aizome_kit::testing::Harness;
+use aizome_kit::Appearance;
+use aizome_shiori::app::{Load, Msg, Shiori};
+use aizome_shiori::places::Places;
+use aizome_shiori::text::{Caret, Selection};
+
+fn settle(h: &mut Harness<Shiori>) {
+    let mut quiet = 0;
+    for _ in 0..3000 {
+        for w in h.windows() {
+            let _ = h.render(w, 1.0);
+        }
+        h.send(Msg::Nothing);
+        h.advance(Duration::from_millis(20));
+        if h.program().idle() {
+            quiet += 1;
+            if quiet >= 4 {
+                return;
+            }
+        } else {
+            quiet = 0;
+        }
+        std::thread::sleep(Duration::from_millis(3));
+    }
+    panic!("Shiori didn't settle");
+}
+
+#[test]
+fn copying_once_the_worker_is_gone_does_not_wait_for_ever() {
+    // SAFETY: no memory is involved.
+    if unsafe { libc::geteuid() } == 0 {
+        eprintln!("skipped: root reads a file whatever its mode");
+        return;
+    }
+    let dir = common::scratch("repro-tsh08");
+    let path = common::write(&dir, "long.pdf", &common::long(30));
+    let mut app = Shiori::new();
+    app.worker = common::worker();
+    app.places = Places::load(dir.join("places.json"));
+    app.dry_run = true;
+    app.initial = vec![path.clone()];
+    let mut h = Harness::with(app, Appearance::default(), false);
+    settle(&mut h);
+
+    // The worker dies, and the one started again can't open the file: no
+    // worker for this document any more; what showed stays.
+    std::fs::set_permissions(&path, std::fs::Permissions::from_mode(0o000)).unwrap();
+    let pid = h.program().docs[0].engine.as_ref().and_then(|e| e.pid()).expect("a worker");
+    // SAFETY: a signal to our own child.
+    unsafe { libc::kill(pid as i32, libc::SIGKILL) };
+    let gone = h.settle(Duration::from_secs(30), |p| p.docs[0].engine.is_none());
+    std::fs::set_permissions(&path, std::fs::Permissions::from_mode(0o644)).unwrap();
+    assert!(gone, "the worker started again is still there");
+    settle(&mut h);
+    assert!(matches!(h.program().docs[0].load, Load::Open(_)));
+    assert!(!h.program().docs[0].texts.contains_key(&19), "page 20's text was never read");
+
+    // A selection from page 1 to page 20, copied.
+    h.program_mut().docs[0].selection =
+        Some(Selection { anchor: Caret { page: 0, index: 0 }, focus: Caret { page: 19, index: 4 } });
+    h.send(Msg::Copy);
+    for _ in 0..20 {
+        h.send(Msg::Nothing);
+        h.advance(Duration::from_millis(100));
+    }
+    let d = &h.program().docs[0];
+    let waiting = d.copying.as_ref().map(|c| c.missing.len());
+    let trouble = d.trouble.clone();
+    let clipboard = h.platform.clipboard.clone();
+    let idle = h.program().idle();
+    drop(h);
+    let _ = std::fs::remove_dir_all(&dir);
+    assert!(
+        waiting.is_none() && idle,
+        "the copy waits for {waiting:?} pages' text that no worker will read (clipboard {clipboard:?}, \
+         status {trouble:?}, idle {idle})"
+    );
+}
diff --git a/desktop/aizome/apps/shiori/tests/repro_tsh_09.rs b/desktop/aizome/apps/shiori/tests/repro_tsh_09.rs
new file mode 100644
index 00000000..29e9035b
--- /dev/null
+++ b/desktop/aizome/apps/shiori/tests/repro_tsh_09.rs
@@ -0,0 +1,100 @@
+//! TSH-09: search "needle", close Find (StopFind), open it again and search
+//! "wide". The worker's answer for "needle" on the page it was on when the
+//! stop came arrives after the new search started. It must not be taken
+//! for an answer to "wide" (stored as its hits, or moving the view to it).
+//!
+//! Real hayro workers. The late answer is the worker's own "needle" answer
+//! for page 2, delivered in the turn the new search starts (the debounce's
+//! FindRun), before the worker's answers to the new search.
+
+mod common;
+
+use std::time::Duration;
+
+use aizome_kit::testing::Harness;
+use aizome_kit::Appearance;
+use aizome_shiori::app::{Msg, Shiori};
+use aizome_shiori::engine::Event;
+use aizome_shiori::places::Places;
+use aizome_shiori::protocol::Reply;
+
+fn settle(h: &mut Harness<Shiori>) {
+    let mut quiet = 0;
+    for _ in 0..3000 {
+        for w in h.windows() {
+            let _ = h.render(w, 1.0);
+        }
+        h.send(Msg::Nothing);
+        h.advance(Duration::from_millis(20));
+        if h.program().idle() {
+            quiet += 1;
+            if quiet >= 4 {
+                return;
+            }
+        } else {
+            quiet = 0;
+        }
+        std::thread::sleep(Duration::from_millis(3));
+    }
+    panic!("Shiori didn't settle");
+}
+
+#[test]
+fn a_late_answer_for_a_closed_search_is_not_taken_for_the_new_one() {
+    let dir = common::scratch("repro-tsh09");
+    common::write(&dir, "doc.pdf", &common::sample());
+    let mut app = Shiori::new();
+    app.worker = common::worker();
+    app.places = Places::load(dir.join("places.json"));
+    app.dry_run = true;
+    app.initial = vec![dir.join("doc.pdf")];
+    let mut h = Harness::with(app, Appearance::default(), false);
+    settle(&mut h);
+    let w = h.window();
+
+    // "needle": on pages 1, 2 and 4.
+    h.send(Msg::Find);
+    h.send(Msg::FindQuery(w, "needle".into()));
+    h.advance(Duration::from_millis(250));
+    settle(&mut h);
+    let first = h.program().docs[0].find.clone().expect("a search");
+    let needle_on_2 = first.results.get(&1).cloned().unwrap_or_default();
+    assert!(!needle_on_2.is_empty(), "needle is on page 2");
+
+    // Escape, then ⌘F and "wide" (on page 3 only).
+    h.send(Msg::FindClose(w));
+    assert!(h.program().docs[0].find.is_none());
+    h.send(Msg::Find);
+    h.send(Msg::FindQuery(w, "wide".into()));
+    let typed = h.program().docs[0].find.as_ref().unwrap().typed;
+    let doc_serial = h.program().docs[0].serial;
+    // The new search starts, and the worker's "needle" answer for page 2,
+    // sent before it took the stop in, comes in that turn.
+    h.send_all([
+        Msg::FindRun(w, typed),
+        Msg::Worker(doc_serial, Event::Reply(Reply::Found { serial: first.serial, page: 1, hits: needle_on_2.clone() })),
+    ]);
+    let after_late = h.program().docs[0].find.clone().unwrap();
+    // The worker answers the new search.
+    assert!(h.settle(Duration::from_secs(20), |p| p.docs[0].find.as_ref().is_some_and(|f| f.done())));
+    let f = h.program().docs[0].find.clone().unwrap();
+    let page = h.program().docs[0].current_page();
+    drop(h);
+    let _ = std::fs::remove_dir_all(&dir);
+
+    // "wide" isn't on page 2: hits there are the closed search's.
+    let taken = after_late.results.get(&1).is_some_and(|v| !v.is_empty());
+    assert!(
+        !taken && f.current == Some((2, 0)),
+        "the closed search's answer passed as the new one's: serial {} (the closed one's was {}), page 2 given {} \
+         \"needle\" hits, current {:?}; once the worker answered \"wide\": page 2 has {:?} hits, current {:?} \
+         (wide's first is page 3), view on page {}",
+        after_late.serial,
+        first.serial,
+        after_late.results.get(&1).map_or(0, Vec::len),
+        after_late.current,
+        f.results.get(&1).map(Vec::len),
+        f.current,
+        page + 1
+    );
+}
diff --git a/desktop/aizome/apps/soroban/tests/repro_sap_02.rs b/desktop/aizome/apps/soroban/tests/repro_sap_02.rs
new file mode 100644
index 00000000..7b5c31ee
--- /dev/null
+++ b/desktop/aizome/apps/soroban/tests/repro_sap_02.rs
@@ -0,0 +1,57 @@
+//! SAP-02 (Soroban's copy): launches started together must leave one
+//! Soroban. `claim` probes, removes and binds without a lock.
+
+use std::os::unix::net::{UnixListener, UnixStream};
+use std::sync::{Arc, Barrier};
+
+use aizome_soroban::instance::{self, Claim};
+
+const THREADS: usize = 2;
+const ROUNDS: usize = 1000;
+
+#[test]
+fn simultaneous_launches_leave_one_instance() {
+    let mut bad = Vec::new();
+    let mut orphaned = 0;
+    for round in 0..ROUNDS {
+        let name = format!("r02so-{}-{round}", std::process::id());
+        let path = instance::socket_path(&name);
+        let _ = std::fs::remove_file(&path);
+        let barrier = Arc::new(Barrier::new(THREADS));
+        let launches: Vec<_> = (0..THREADS)
+            .map(|_| {
+                let (b, name) = (barrier.clone(), name.clone());
+                std::thread::spawn(move || {
+                    b.wait();
+                    match instance::claim(&name, &[]) {
+                        Claim::First(l) => Some(Some(l)),
+                        Claim::Alone => Some(None),
+                        Claim::Handed => None,
+                    }
+                })
+            })
+            .collect();
+        let running: Vec<Option<UnixListener>> = launches.into_iter().filter_map(|t| t.join().unwrap()).collect();
+        let firsts: Vec<&UnixListener> = running.iter().flatten().collect();
+        if running.len() != 1 {
+            if firsts.len() > 1 {
+                for l in &firsts {
+                    l.set_nonblocking(true).unwrap();
+                }
+                let _probe = UnixStream::connect(&path);
+                let reached = firsts.iter().filter(|l| l.accept().is_ok()).count();
+                orphaned += firsts.len() - reached;
+            }
+            bad.push((round, firsts.len(), running.len() - firsts.len()));
+        }
+        drop(running);
+        let _ = std::fs::remove_file(&path);
+    }
+    assert!(
+        bad.is_empty(),
+        "{} of {ROUNDS} rounds of {THREADS} simultaneous launches ran more than one Soroban \
+         ({orphaned} instances left unreachable by the socket); first rounds (round, First, Alone): {:?}",
+        bad.len(),
+        &bad[..bad.len().min(8)]
+    );
+}
diff --git a/desktop/aizome/apps/soroban/tests/repro_sap_25.rs b/desktop/aizome/apps/soroban/tests/repro_sap_25.rs
new file mode 100644
index 00000000..59d0bd3b
--- /dev/null
+++ b/desktop/aizome/apps/soroban/tests/repro_sap_25.rs
@@ -0,0 +1,61 @@
+//! SAP-25: after ❖Z, a key that does nothing — `)` with no parenthesis
+//! open, a second `.`, a digit outside the radix — must leave ❖⇧Z working.
+//! `press` runs `remember()` before each key's validity check, which pushes
+//! an undo step and always empties the redo stack.
+
+use aizome_kit::sidestep_ui::{Key as KeyPress, Modifiers};
+use aizome_kit::testing::Harness;
+use aizome_soroban::Soroban;
+use aizome_soroban::entry::{Calc, Key, Mode};
+
+fn expr(c: &Calc) -> String {
+    c.pieces.iter().map(|p| p.src.as_str()).collect()
+}
+
+/// Type `keys`, undo the last, press `noop`, redo: what's there, and
+/// whether Redo was still on offer after the no-op key.
+fn redo_after(mode: Mode, keys: &[Key], noop: Key) -> (String, String, bool) {
+    let mut c = Calc::default();
+    c.set_mode(mode);
+    for k in keys {
+        c.press(*k);
+    }
+    let full = expr(&c);
+    c.undo();
+    let undone = expr(&c);
+    c.press(noop);
+    assert_eq!(expr(&c), undone, "precondition: {noop:?} changes nothing");
+    let could = c.can_redo();
+    c.redo();
+    (full, expr(&c), could)
+}
+
+#[test]
+fn a_key_that_does_nothing_keeps_redo() {
+    let cases = [
+        ("`)` with nothing open", Mode::Basic, vec![Key::Digit(1), Key::Digit(2)], Key::Close),
+        ("a second `.`", Mode::Basic, vec![Key::Digit(1), Key::Point, Key::Digit(2)], Key::Point),
+        ("a digit outside the radix", Mode::Programmer, vec![Key::Digit(1), Key::Digit(2)], Key::Digit(0xA)),
+    ];
+    let mut broken = Vec::new();
+    for (what, mode, keys, noop) in cases {
+        let (full, after, could) = redo_after(mode, &keys, noop);
+        if after != full {
+            broken.push(format!("{what}: Redo offered = {could}, expression after ❖⇧Z {after:?}, wanted {full:?}"));
+        }
+    }
+    assert!(broken.is_empty(), "{}", broken.join("\n"));
+}
+
+#[test]
+fn typed_close_paren_after_undo_keeps_redo_in_the_app() {
+    let mut h = Harness::new(Soroban::new(None));
+    let w = h.window();
+    h.type_text(w, "12");
+    h.command(w, 'z');
+    assert_eq!(h.program().calc.shown().main, "1");
+    h.type_text(w, ")");
+    assert_eq!(h.program().calc.shown().main, "1", "precondition: `)` does nothing");
+    h.key(w, KeyPress::Character("z".into()), Modifiers::SUPER | Modifiers::SHIFT);
+    assert_eq!(h.program().calc.shown().main, "12", "❖⇧Z after a key that did nothing");
+}
diff --git a/desktop/aizome/apps/sumi/tests/repro_smt_13.rs b/desktop/aizome/apps/sumi/tests/repro_smt_13.rs
