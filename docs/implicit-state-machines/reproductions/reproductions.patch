diff --git a/desktop/aizome/apps/hotaru/src/repro_hot_07.rs b/desktop/aizome/apps/hotaru/src/repro_hot_07.rs
new file mode 100644
index 00000000..975066a5
--- /dev/null
+++ b/desktop/aizome/apps/hotaru/src/repro_hot_07.rs
@@ -0,0 +1,159 @@
+//! HOT-07: an automatic link activated with ❖-click must still open (or say
+//! why not) when the pointer moves on before the path resolver answers.
+use super::*;
+use aizome_kit::testing::Harness;
+use hotaru_link_regex::{CellPoint, Limits, Matcher};
+use std::sync::atomic::AtomicBool;
+use std::time::{Duration, Instant};
+
+fn request(snapshot: &Arc<Snapshot>, pane: u64, col: u16) -> Arc<crate::automatic_links::Request> {
+    Arc::new(crate::automatic_links::Request {
+        pane,
+        snapshot: snapshot.clone(),
+        cell: CellPoint { row: 0, col },
+        retained_bytes: 1024,
+    })
+}
+
+fn link(snapshot: &Arc<Snapshot>, pane: u64, col: u16) -> crate::links::Link {
+    let cell = CellPoint { row: 0, col };
+    let deadline = Instant::now() + Duration::from_secs(5);
+    let mapped =
+        crate::automatic_links::mapping::extract(snapshot, cell, &AtomicBool::new(false), deadline).unwrap();
+    let matched = Matcher::new()
+        .unwrap()
+        .find_at(&mapped.source, cell, &Limits { deadline, ..Default::default() }, &AtomicBool::new(false))
+        .unwrap()
+        .unwrap();
+    crate::links::Link::automatic(request(snapshot, pane, col), matched).unwrap()
+}
+
+fn shown(h: &mut Harness<Hotaru>, snapshot: &Arc<Snapshot>) {
+    assert!(h.settle(Duration::from_secs(5), |app| {
+        app.active_pane().unwrap().displayed_snapshot().is_some_and(|s| Arc::ptr_eq(s, snapshot))
+    }));
+}
+
+fn status(h: &Harness<Hotaru>, id: u64) -> String {
+    h.program().panes.iter().find(|p| p.id == id).map(|p| p.status.clone()).unwrap_or_default()
+}
+
+/// Wait up to two seconds for the click to have any visible outcome: an
+/// opened URL or a new pane status (`before` is "Preview" in demo mode).
+fn outcome(h: &mut Harness<Hotaru>, id: u64, before: &str) -> (Vec<String>, String) {
+    let until = Instant::now() + Duration::from_secs(2);
+    loop {
+        h.settle(Duration::from_millis(10), |_| false);
+        h.advance(Duration::from_millis(5));
+        let status = status(h, id);
+        if !h.platform.opened_urls.is_empty() || status != before || Instant::now() >= until {
+            return (h.platform.opened_urls.clone(), if status == before { String::new() } else { status });
+        }
+    }
+}
+
+/// Message level, deterministic: the click's `OpenLink` and, with `moved`,
+/// the next motion's `MatchLink` (pointer one cell on, still inside the same
+/// URL) arrive in one event-loop turn, before the resolver's answer is handled.
+fn message_scenario(moved: bool) -> (Vec<String>, String, bool) {
+    let mut h = Harness::new(Hotaru::preview());
+    h.advance(Duration::ZERO);
+    let id = h.program().active_pane().unwrap().id;
+    let mut term = Terminal::new(80, 4, 0);
+    term.feed(b"https://example.test/path");
+    let snapshot = Arc::new(term.snapshot());
+    h.send(Msg::Frame(id, snapshot.clone()));
+    shown(&mut h, &snapshot);
+    let before = status(&h, id);
+    let clicked = link(&snapshot, id, 2);
+    h.send(Msg::MatchLink(id, clicked.request().cloned()));
+    assert!(h.program().valid_link_activation(id, &clicked), "precondition: the hovered link is activatable");
+    let mut turn = vec![Msg::OpenLink(id, clicked.clone())];
+    if moved {
+        turn.push(Msg::MatchLink(id, Some(request(&snapshot, id, 3))));
+    }
+    h.send_all(turn);
+    let pending = h.program().resolver_request.is_some();
+    let (opened, status) = outcome(&mut h, id, &before);
+    (opened, status, pending)
+}
+
+#[test]
+fn repro_hot_07_moving_one_cell_after_the_click_still_opens_the_link() {
+    let (opened, status, pending) = message_scenario(true);
+    assert!(
+        opened == ["https://example.test/path"] || !status.is_empty(),
+        "❖-click on https://example.test/path then one cell of motion: opened {opened:?}, new pane status \
+         {status:?} (resolution still pending after the motion: {pending})"
+    );
+}
+
+/// Control: without the motion the same activation opens the URL.
+#[test]
+fn repro_hot_07_control_without_motion_opens_the_link() {
+    let (opened, _, _) = message_scenario(false);
+    assert_eq!(opened, ["https://example.test/path"]);
+}
+
+/// Pointer level: hover with ❖ held, ❖-click a relative path (resolved by the
+/// spawned helper process), then, with `moved`, move the pointer one cell
+/// while the helper runs. In a test binary the helper is the test executable,
+/// which refuses the helper arguments, so a correct Hotaru shows "Could not
+/// resolve link" (the real app would open the resolved path): either way a
+/// visible outcome.
+fn pointer_scenario(moved: bool) -> (Vec<String>, String) {
+    use aizome_kit::Vec2;
+    use aizome_kit::sidestep_ui::{Cursor, Key, Modifiers};
+    let directory = std::env::temp_dir().join(format!("hot07-{}-{moved}", std::process::id()));
+    std::fs::create_dir_all(&directory).unwrap();
+    std::fs::write(directory.join("notes.txt"), b"x").unwrap();
+    let mut h = Harness::new(Hotaru::preview());
+    let win = h.window();
+    h.advance(Duration::ZERO);
+    let id = h.program().active_pane().unwrap().id;
+    h.program_mut().panes.iter_mut().find(|p| p.id == id).unwrap().link_directory = Some(directory.clone());
+    let mut term = Terminal::new(80, 24, 0);
+    term.feed(b"see ./notes.txt now");
+    let snapshot = Arc::new(term.snapshot());
+    h.send(Msg::Frame(id, snapshot.clone()));
+    shown(&mut h, &snapshot);
+    let pane = h.program().active_pane().unwrap();
+    let metrics = pane.font_metrics().unwrap();
+    let origin = h.find_id(win, &format!("terminal-{id}")).unwrap().origin() + Vec2::new(10., 10.);
+    let at = |col: f64| origin + Vec2::new((col + 0.5) * metrics.cell_width(), metrics.cell_height() * 0.4);
+    let before = status(&h, id);
+    h.key(win, Key::Unidentified, Modifiers::SUPER);
+    h.move_to(win, at(6.));
+    // The automatic match runs off thread; the view picks the hit up on a tick.
+    let until = Instant::now() + Duration::from_secs(5);
+    while !h.platform.cursors.values().any(|c| *c == Cursor::Pointer) {
+        assert!(Instant::now() < until, "automatic link never became hoverable");
+        h.settle(Duration::from_millis(5), |_| false);
+        h.advance(Duration::from_millis(1));
+    }
+    assert!(h.program().automatic_hit.as_ref().is_some_and(|l| &*l.target == "./notes.txt"));
+    h.click(win, at(6.));
+    assert!(h.program().resolver_request.is_some(), "precondition: the click submitted a path resolution");
+    if moved {
+        h.move_to(win, at(7.));
+    }
+    let result = outcome(&mut h, id, &before);
+    std::fs::remove_dir_all(&directory).unwrap();
+    result
+}
+
+#[test]
+fn repro_hot_07_pointer_moving_after_a_click_on_a_relative_path() {
+    let (opened, status) = pointer_scenario(true);
+    assert!(
+        !opened.is_empty() || !status.is_empty(),
+        "❖-click on ./notes.txt then one cell of motion: nothing opened ({opened:?}) and no notice ({status:?})"
+    );
+}
+
+/// Control: without the motion the same click has a visible outcome.
+#[test]
+fn repro_hot_07_control_pointer_click_without_motion_has_an_outcome() {
+    let (opened, status) = pointer_scenario(false);
+    assert!(!opened.is_empty() || !status.is_empty(), "control: {opened:?} {status:?}");
+}
diff --git a/desktop/aizome/apps/hotaru/tests/repro_hot_12.rs b/desktop/aizome/apps/hotaru/tests/repro_hot_12.rs
new file mode 100644
index 00000000..441228e9
--- /dev/null
+++ b/desktop/aizome/apps/hotaru/tests/repro_hot_12.rs
@@ -0,0 +1,78 @@
+//! HOT-12: a close (or an "open hotaru.toml") deferred behind a save in flight
+//! must neither be lost nor fire later when ⇧❖, (Reload Configuration) comes
+//! first and makes that save's answer stale.
+use aizome_hotaru::app::{Hotaru, Msg};
+use aizome_hotaru::settings::{Action, CopyFormat};
+use aizome_kit::testing::Harness;
+use std::path::PathBuf;
+use std::time::{Duration, Instant};
+
+fn config(name: &str) -> (PathBuf, PathBuf) {
+    let directory = std::env::temp_dir().join(format!("hot12-{name}-{}", std::process::id()));
+    let _ = std::fs::remove_dir_all(&directory);
+    std::fs::create_dir_all(&directory).unwrap();
+    let path = directory.join("hotaru.toml");
+    (directory, path)
+}
+
+fn hotaru(path: &std::path::Path) -> Hotaru {
+    let mut app = Hotaru::preview();
+    app.settings_path = Some(path.to_path_buf());
+    app
+}
+
+/// Let the settings worker answer everything it was given.
+fn drain(h: &mut Harness<Hotaru>) {
+    let until = Instant::now() + Duration::from_millis(500);
+    while Instant::now() < until {
+        h.settle(Duration::from_millis(10), |_| false);
+    }
+}
+
+#[test]
+fn repro_hot_12_last_tab_closed_during_a_save_then_reload_closes_the_window() {
+    let (directory, path) = config("close");
+    let mut h = Harness::new(hotaru(&path));
+    h.advance(Duration::ZERO);
+    assert_eq!(h.windows().len(), 1);
+    // One event-loop turn: a settings change starts a save, the last tab
+    // closes while it is in flight (the close waits for the save), and ⇧❖,
+    // reloads hotaru.toml before the save's answer is handled.
+    h.send_all([Msg::SetCopyFormat(CopyFormat::Plain), Msg::CloseTab, Msg::Action(Action::ReloadConfig)]);
+    drain(&mut h);
+    let tabs_after_reload = h.program().tabs.len();
+    let open_after_reload = !h.windows().is_empty();
+    // Later, an unrelated settings change (and its save) lands.
+    h.send(Msg::SetCopyFormat(CopyFormat::Html));
+    drain(&mut h);
+    let open_after_change = !h.windows().is_empty();
+    std::fs::remove_dir_all(&directory).unwrap();
+    assert!(
+        !open_after_reload,
+        "the deferred close was lost: window still open with {tabs_after_reload} tabs once the reload \
+         landed; a later unrelated settings change then {}",
+        if open_after_change { "left it open" } else { "closed the window" }
+    );
+}
+
+#[test]
+fn repro_hot_12_open_config_deferred_behind_a_save_does_not_fire_on_a_later_change() {
+    let (directory, path) = config("open");
+    let mut h = Harness::new(hotaru(&path));
+    h.advance(Duration::ZERO);
+    assert!(!path.exists());
+    // "Open hotaru.toml" with no file yet writes the settings out first and
+    // opens the file once that save lands; ⇧❖, comes before it does.
+    h.send_all([Msg::OpenConfigFile, Msg::Action(Action::ReloadConfig)]);
+    drain(&mut h);
+    let opened_by_request = h.platform.opened_urls.clone();
+    // Later, an unrelated settings change is saved.
+    h.send(Msg::SetCopyFormat(CopyFormat::Html));
+    drain(&mut h);
+    let opened_later: Vec<String> = h.platform.opened_urls[opened_by_request.len()..].to_vec();
+    std::fs::remove_dir_all(&directory).unwrap();
+    assert!(
+        opened_later.is_empty(),
+        "an unrelated settings change opened {opened_later:?} (the earlier request opened {opened_by_request:?})"
+    );
+}
