index 00000000..72ac9bf0
--- /dev/null
+++ b/desktop/aizome/crates/aizome-media/tests/repro_svc_29.rs
@@ -0,0 +1,86 @@
+//! SVC-29: a seek while the window says it's hidden (Utsushi forwards xdg
+//! suspension as `set_visible(false)`, `apps/utsushi/src/app.rs:1149`; an
+//! MPRIS seek arrives at `app.rs:649`) must play on, sound and all.
+//!
+//! At 8e0acbe5 `seek_to` stops the audio and waits for the first frame of
+//! the flushed generation (`player.rs:1146`, `player.rs:1344`) and clears
+//! only the shared `suspended` flag (`player.rs:1176`); the video thread is
+//! still suspended locally, so `check_sight` waits before presenting
+//! anything (`video.rs:778-782`): no frame, no `Seeked`, no restart.
+//!
+//! The engine runs as in `tests/engine.rs`: the tiny fixtures, the null
+//! audio output, a detached video sink, software decoding.
+
+use std::path::PathBuf;
+use std::sync::mpsc;
+use std::time::{Duration, Instant};
+
+use aizome_media::{AudioChoice, Event, Options, PlayState, Player};
+use sidestep_ui::video::{VideoCaps, VideoSink};
+
+fn fixture(name: &str) -> String {
+    PathBuf::from(env!("CARGO_MANIFEST_DIR")).join("tests/fixtures").join(name).to_string_lossy().into_owned()
+}
+
+fn player() -> (Player, mpsc::Receiver<Event>, std::sync::Arc<sidestep_ui::video::Detached>) {
+    let (sink, detached) = VideoSink::detached();
+    let (tx, rx) = mpsc::channel();
+    let caps = VideoCaps { known: true, shm: vec![0, 1], presentation: true, monotonic: true, ..VideoCaps::default() };
+    let player = Player::new(
+        Options { sink: Some(sink), audio: AudioChoice::Null, hardware: false, caps: Some(caps) },
+        move |e| {
+            let _ = tx.send(e);
+        },
+    );
+    (player, rx, detached)
+}
+
+/// Events until one matches within `secs`: `Ok(seen)`, or `Err(seen)`.
+fn until(rx: &mpsc::Receiver<Event>, secs: f64, mut f: impl FnMut(&Event) -> bool) -> Result<Vec<Event>, Vec<Event>> {
+    let end = Instant::now() + Duration::from_secs_f64(secs);
+    let mut seen = Vec::new();
+    loop {
+        match rx.recv_timeout(end.saturating_duration_since(Instant::now())) {
+            Ok(e) => {
+                let hit = f(&e);
+                seen.push(e);
+                if hit {
+                    return Ok(seen);
+                }
+            }
+            Err(_) => return Err(seen),
+        }
+    }
+}
+
+#[test]
+fn a_seek_while_the_window_is_hidden_plays_on() {
+    let (p, rx, _detached) = player();
+    p.open(fixture("chaptered.mkv"), 0.0, true);
+    until(&rx, 5.0, |e| matches!(e, Event::State(PlayState::Playing))).expect("playing");
+    // The window goes out of sight (the compositor suspends it).
+    p.set_visible(false);
+    let deadline = Instant::now() + Duration::from_secs(3);
+    while !p.stats().suspended {
+        assert!(Instant::now() < deadline, "never suspended: {:?}", p.stats());
+        std::thread::sleep(Duration::from_millis(10));
+    }
+    // An MPRIS seek while it's hidden.
+    p.seek(1.0, true);
+    let seeked = until(&rx, 3.0, |e| matches!(e, Event::Seeked(t) if (*t - 1.0).abs() < 1e-9));
+    let playing = seeked.is_ok() && until(&rx, 2.0, |e| matches!(e, Event::State(PlayState::Playing))).is_ok();
+    let at = p.position();
+    std::thread::sleep(Duration::from_millis(600));
+    let later = p.position();
+    eprintln!(
+        "after the hidden seek: Seeked heard: {}, Playing again: {playing}, position {at:.3} then {later:.3} 0.6 s later; stats {:?}",
+        seeked.is_ok(),
+        p.stats()
+    );
+    assert!(
+        seeked.is_ok() && playing && later > at + 0.3,
+        "a seek while hidden stalled playback: Seeked {}, Playing {playing}, position {at:.3} → {later:.3}; events {:?}",
+        seeked.is_ok(),
+        seeked.unwrap_or_else(|e| e)
+    );
+}
diff --git a/desktop/aizome/crates/aizome-shell/tests/repro_sha_02.rs b/desktop/aizome/crates/aizome-shell/tests/repro_sha_02.rs
