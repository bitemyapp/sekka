+//! HAKO-20: New Folder while its column's listing is being read (the read
+//! predates the mkdir) must not leave "rename this folder once it shows"
+//! armed for ever: much later, selecting that folder must not open the
+//! rename field.
+//!
+//! Orchestration as in HAKO-19's reproduction: the column is caught
+//! `Loading`, the test's own inotify watch says when Hako's read has
+//! closed the folder, then New Folder is handled before the (queued)
+//! stale listing.
+
+use std::ffi::CString;
+use std::os::unix::ffi::OsStrExt;
+use std::path::Path;
+use std::time::{Duration, Instant};
+
+use aizome_kit::testing::Harness;
+
+use crate::ui::app::{Hako, Msg, Options};
+use crate::ui::browser::Load;
+
+struct Closes(i32);
+
+impl Closes {
+    fn watch(dir: &Path) -> Closes {
+        let fd = unsafe { libc::inotify_init1(libc::IN_NONBLOCK | libc::IN_CLOEXEC) };
+        assert!(fd >= 0);
+        let c = CString::new(dir.as_os_str().as_bytes()).unwrap();
+        assert!(unsafe { libc::inotify_add_watch(fd, c.as_ptr(), libc::IN_CLOSE_NOWRITE) } >= 0);
+        Closes(fd)
+    }
+
+    fn take(&self) -> usize {
+        let mut buf = [0u8; 4096];
+        let mut n_closes = 0;
+        loop {
+            let n = unsafe { libc::read(self.0, buf.as_mut_ptr().cast(), buf.len()) };
+            if n <= 0 {
+                return n_closes;
+            }
+            let mut i = 0usize;
+            let header = std::mem::size_of::<libc::inotify_event>();
+            while i + header <= n as usize {
+                let ev: libc::inotify_event = unsafe { std::ptr::read_unaligned(buf[i..].as_ptr().cast()) };
+                if ev.len == 0 && ev.mask & libc::IN_CLOSE_NOWRITE != 0 {
+                    n_closes += 1;
+                }
+                i += header + ev.len as usize;
+            }
+        }
+    }
+
+    fn wait(&self, timeout: Duration) -> bool {
+        let until = Instant::now() + timeout;
+        while Instant::now() < until {
+            let mut p = libc::pollfd { fd: self.0, events: libc::POLLIN, revents: 0 };
+            unsafe { libc::poll(&mut p, 1, 50) };
+            if self.take() > 0 {
+                return true;
+            }
+        }
+        false
+    }
+}
+
+impl Drop for Closes {
+    fn drop(&mut self) {
+        unsafe { libc::close(self.0) };
+    }
+}
+
+fn settle(h: &mut Harness<Hako>) {
+    let until = Instant::now() + Duration::from_secs(5);
+    while Instant::now() < until {
+        h.send(Msg::Nop);
+        let loading = h
+            .program()
+            .windows
+            .values()
+            .any(|b| b.columns.iter().any(|c| matches!(c.load, Load::Wanted | Load::Loading(_))));
+        if !loading {
+            h.send(Msg::Nop);
+            return;
+        }
+        h.advance(Duration::from_millis(20));
+        std::thread::sleep(Duration::from_millis(5));
+    }
+}
+
+#[test]
+fn a_new_folder_made_mid_read_does_not_rename_itself_later() {
+    let root = std::env::temp_dir().join(format!("hako-repro-20-{}", std::process::id()));
+    let _ = std::fs::remove_dir_all(&root);
+    let d = root.join("home/d");
+    std::fs::create_dir_all(&d).unwrap();
+    std::fs::create_dir_all(root.join("home/other")).unwrap();
+    for i in 0..200 {
+        std::fs::write(d.join(format!("f{i:03}.txt")), "x").unwrap();
+    }
+    let mut h = Harness::new(Hako::new(Options::sandbox(&root)));
+    let w = h.window();
+    settle(&mut h);
+    let closes = Closes::watch(&d);
+    let d_load = |h: &Harness<Hako>| h.program().windows[&w].columns.get(1).map(|c| c.load.clone());
+    let mut caught = false;
+    let mut attempts = 0;
+    for i in 0..50 {
+        attempts = i;
+        h.send(Msg::GoPath(w, d.clone()));
+        if matches!(d_load(&h), Some(Load::Loading(_))) {
+            caught = true;
+            break;
+        }
+        settle(&mut h);
+        std::thread::sleep(Duration::from_millis(20));
+        closes.take();
+    }
+    assert!(caught, "the column was caught loading");
+    eprintln!("caught d loading after {} GoPath attempt(s)", attempts + 1);
+    assert!(closes.wait(Duration::from_secs(5)), "Hako's read of d closed it");
+    // ⇧❖N now: the folder is made after the listing was taken.
+    h.send(Msg::NewFolder(w));
+    settle(&mut h);
+    let folder = d.join("untitled folder");
+    assert!(folder.is_dir());
+    eprintln!(
+        "after New Folder: rename {:?}, armed {:?}",
+        h.program().windows[&w].rename.as_ref().map(|r| r.path.clone()),
+        h.program().rename_when_loaded
+    );
+    // Later another change in d shows the folder (not selected).
+    std::fs::write(d.join("later.txt"), "x").unwrap();
+    h.send(Msg::DirChanged(d.clone()));
+    h.advance(Duration::from_millis(200));
+    settle(&mut h);
+    assert!(h.program().windows[&w].columns[1].rows.iter().any(|e| e.path == folder), "the folder shows now");
+    // The person goes elsewhere, comes back, and clicks the folder.
+    h.send(Msg::GoPath(w, root.join("home/other")));
+    settle(&mut h);
+    h.send(Msg::GoPath(w, d.clone()));
+    settle(&mut h);
+    let row = h.program().windows[&w].columns[1].rows.iter().position(|e| e.path == folder).unwrap();
+    h.send(Msg::Select(w, 1, vec![row]));
+    settle(&mut h);
+    let rename = h.program().windows[&w].rename.as_ref().map(|r| r.path.clone());
+    eprintln!("after selecting it: rename {rename:?}, armed {:?}", h.program().rename_when_loaded);
+    let _ = std::fs::remove_dir_all(&root);
+    assert_eq!(rename, None, "selecting a folder made long ago opened its rename field");
+}
diff --git a/desktop/aizome/apps/hako/tests/repro_hako_05.rs b/desktop/aizome/apps/hako/tests/repro_hako_05.rs
new file mode 100644
index 00000000..0da24272
--- /dev/null
+++ b/desktop/aizome/apps/hako/tests/repro_hako_05.rs
@@ -0,0 +1,93 @@
+//! HAKO-05: Put Back (and Undo of Move to Trash) answered "Replace" at a
+//! conflict must move the item that was there to the Trash, as the
+//! conflict sheet promises ("Replacing moves the one there to the
+//! Trash"), not delete it for good.
+
+use std::fs;
+use std::path::{Path, PathBuf};
+
+use hako::fsops::transfer::{restore, trash_items};
+use hako::fsops::trash::Trash;
+use hako::fsops::undo::{Record, invert};
+use hako::fsops::{Always, Control, Env, ErrorChoice, Resolution};
+
+/// A folder of the test's own under the private TMPDIR, removed when dropped.
+struct Tmp(PathBuf);
+
+impl Tmp {
+    fn new(name: &str) -> Tmp {
+        let p = std::env::temp_dir().join(format!("hako-repro-05-{name}-{}", std::process::id()));
+        let _ = fs::remove_dir_all(&p);
+        fs::create_dir_all(&p).unwrap();
+        Tmp(fs::canonicalize(&p).unwrap())
+    }
+    fn file(&self, rel: &str, text: &str) -> PathBuf {
+        let p = self.0.join(rel);
+        fs::create_dir_all(p.parent().unwrap()).unwrap();
+        fs::write(&p, text).unwrap();
+        p
+    }
+}
+
+impl Drop for Tmp {
+    fn drop(&mut self) {
+        let _ = fs::remove_dir_all(&self.0);
+    }
+}
+
+/// A Trash entirely inside the test folder (no mount points looked at).
+fn trash_in(t: &Tmp) -> Trash {
+    Trash {
+        home: t.0.join("data/Trash"),
+        home_dir: Some(t.0.join("home")),
+        uid: unsafe { libc::getuid() },
+        topdirs: Some(Vec::new()),
+    }
+}
+
+/// Whether some item in the Trash came from `original` and reads `text`.
+fn in_trash(trash: &Trash, original: &Path, text: &str) -> bool {
+    trash
+        .list()
+        .iter()
+        .any(|e| e.original.as_deref() == Some(original) && fs::read_to_string(&e.file).ok().as_deref() == Some(text))
+}
+
+#[test]
+fn put_back_replace_moves_the_newer_item_to_the_trash() {
+    let t = Tmp::new("putback");
+    let trash = trash_in(&t);
+    let a = t.file("home/docs/a.txt", "old a");
+    let control = Control::new();
+    let mut asker = Always(Resolution::Replace, ErrorChoice::Skip);
+    let (r, trashed) = trash_items(std::slice::from_ref(&a), &trash, &mut Env::new(&control, &mut asker, &mut ()));
+    assert!(r.is_clean() && trashed.len() == 1, "{r:?}");
+    // Something new takes the name meanwhile.
+    t.file("home/docs/a.txt", "newer a");
+    // Put Back, answering the conflict with Replace.
+    let entries = trash.list();
+    let r = restore(&entries, &trash, &mut Env::new(&control, &mut asker, &mut ()));
+    eprintln!("restore report: {r:?}");
+    assert_eq!(fs::read_to_string(&a).unwrap(), "old a", "the trashed item is back");
+    assert!(
+        in_trash(&trash, &a, "newer a"),
+        "the item it replaced should be in the Trash (the sheet says so); the Trash holds {:?}",
+        trash.list().iter().map(|e| (e.file.clone(), e.original.clone())).collect::<Vec<_>>()
+    );
+}
+
+#[test]
+fn undo_of_move_to_trash_replace_moves_the_newer_item_to_the_trash() {
+    let t = Tmp::new("undo");
+    let trash = trash_in(&t);
+    let a = t.file("home/docs/a.txt", "old a");
+    let control = Control::new();
+    let mut asker = Always(Resolution::Replace, ErrorChoice::Skip);
+    let (_, items) = trash_items(std::slice::from_ref(&a), &trash, &mut Env::new(&control, &mut asker, &mut ()));
+    t.file("home/docs/a.txt", "newer a");
+    // ⌘Z of the Move to Trash: the inverse is a restore.
+    let (r, _) = invert(&Record::Trash { items }, &trash, &mut Env::new(&control, &mut asker, &mut ()));
+    eprintln!("undo report: {r:?}");
+    assert_eq!(fs::read_to_string(&a).unwrap(), "old a");
+    assert!(in_trash(&trash, &a, "newer a"), "the item undo replaced should be in the Trash, not deleted");
+}
diff --git a/desktop/aizome/apps/hako/tests/repro_hako_06.rs b/desktop/aizome/apps/hako/tests/repro_hako_06.rs
new file mode 100644
index 00000000..8f6e92ae
--- /dev/null
+++ b/desktop/aizome/apps/hako/tests/repro_hako_06.rs
@@ -0,0 +1,112 @@
+//! HAKO-06: in a move across filesystems, a nested folder whose copy
+//! "couldn't be written safely" (its `fsync` failed) must keep its
+//! source files: the module's promise is that a move deletes only what
+//! arrived safely.
+//!
+//! Two faults are injected into this test binary only, by defining the
+//! C symbols it links against (the executable's own definitions win
+//! over libc's):
+//! - `renameat2` fails with EXDEV for the moved folder, so the move is
+//!   a copy across "filesystems" while everything stays in TMPDIR;
+//! - `fsync` fails with EIO on the copied nested folder `inner`, as a
+//!   flaky USB stick would.
+//!
+//! Everything else goes to the real system calls.
+
+use std::ffi::{CStr, OsStr};
+use std::fs;
+use std::os::unix::ffi::OsStrExt;
+use std::path::{Path, PathBuf};
+use std::sync::Mutex;
+
+use hako::fsops::transfer::{Mode, transfer};
+use hako::fsops::{Always, Control, Env, ErrorChoice, Resolution};
+
+/// The source whose rename is refused as crossing filesystems.
+static EXDEV_FROM: Mutex<Option<PathBuf>> = Mutex::new(None);
+/// Fail `fsync` on folders of this name inside a partial copy.
+static EIO_DIR: Mutex<Option<String>> = Mutex::new(None);
+static EIO_HITS: Mutex<Vec<PathBuf>> = Mutex::new(Vec::new());
+
+fn set_errno(e: libc::c_int) {
+    unsafe { *libc::__errno_location() = e };
+}
+
+#[unsafe(no_mangle)]
+pub extern "C" fn renameat2(
+    olddirfd: libc::c_int,
+    oldpath: *const libc::c_char,
+    newdirfd: libc::c_int,
+    newpath: *const libc::c_char,
+    flags: libc::c_uint,
+) -> libc::c_int {
+    let old = unsafe { CStr::from_ptr(oldpath) };
+    if let Some(from) = EXDEV_FROM.lock().unwrap_or_else(|e| e.into_inner()).as_ref()
+        && Path::new(OsStr::from_bytes(old.to_bytes())) == from
+    {
+        set_errno(libc::EXDEV);
+        return -1;
+    }
+    unsafe { libc::syscall(libc::SYS_renameat2, olddirfd, oldpath, newdirfd, newpath, flags) as libc::c_int }
+}
+
+#[unsafe(no_mangle)]
+pub extern "C" fn fsync(fd: libc::c_int) -> libc::c_int {
+    if let Some(name) = EIO_DIR.lock().unwrap_or_else(|e| e.into_inner()).clone()
+        && let Ok(p) = fs::read_link(format!("/proc/self/fd/{fd}"))
+        && p.file_name() == Some(OsStr::new(&name))
+        && p.parent().and_then(Path::file_name).is_some_and(|n| n.as_bytes().windows(11).any(|w| w == b".hako-part-"))
+    {
+        EIO_HITS.lock().unwrap_or_else(|e| e.into_inner()).push(p);
+        set_errno(libc::EIO);
+        return -1;
+    }
+    unsafe { libc::syscall(libc::SYS_fsync, fd) as libc::c_int }
+}
+
+struct Tmp(PathBuf);
+
+impl Drop for Tmp {
+    fn drop(&mut self) {
+        let _ = fs::remove_dir_all(&self.0);
+    }
+}
+
+#[test]
+fn a_nested_folder_not_written_safely_keeps_its_sources() {
+    let root = std::env::temp_dir().join(format!("hako-repro-06-{}", std::process::id()));
+    let _ = fs::remove_dir_all(&root);
+    let t = Tmp(root.clone());
+    let src = root.join("from/src");
+    fs::create_dir_all(src.join("inner")).unwrap();
+    fs::write(src.join("top.txt"), "top").unwrap();
+    fs::write(src.join("inner/x.txt"), "x").unwrap();
+    fs::write(src.join("inner/y.txt"), "y").unwrap();
+    let dest = root.join("to");
+    fs::create_dir_all(&dest).unwrap();
+    let (src, dest) = (fs::canonicalize(&src).unwrap(), fs::canonicalize(&dest).unwrap());
+
+    *EXDEV_FROM.lock().unwrap() = Some(src.clone());
+    *EIO_DIR.lock().unwrap() = Some("inner".into());
+    let control = Control::new();
+    let mut asker = Always(Resolution::Cancel, ErrorChoice::Skip);
+    let r = transfer(std::slice::from_ref(&src), &dest, Mode::Move, &mut Env::new(&control, &mut asker, &mut ()), None);
+    *EXDEV_FROM.lock().unwrap() = None;
+    *EIO_DIR.lock().unwrap() = None;
+
+    eprintln!("report: {r:?}");
+    eprintln!("fsync failed on: {:?}", EIO_HITS.lock().unwrap());
+    assert!(!EIO_HITS.lock().unwrap().is_empty(), "the fault was injected (fsync of the copied inner folder)");
+    let unsafe_inner = r.problems.iter().any(|(p, why)| p == &src.join("inner") && why.contains("written safely"));
+    assert!(unsafe_inner, "the report says the inner folder couldn't be written safely: {r:?}");
+    let left: Vec<String> = fs::read_dir(src.join("inner"))
+        .map(|rd| rd.flatten().map(|e| e.file_name().to_string_lossy().into_owned()).collect())
+        .unwrap_or_default();
+    assert!(
+        src.join("inner/x.txt").exists() && src.join("inner/y.txt").exists(),
+        "the source files of a folder reported as not written safely must stay; src/inner now holds {left:?}, \
+         dest holds x.txt: {}",
+        dest.join("src/inner/x.txt").exists()
+    );
+    drop(t);
+}
diff --git a/desktop/aizome/apps/hako/tests/repro_hako_08.rs b/desktop/aizome/apps/hako/tests/repro_hako_08.rs
new file mode 100644
index 00000000..f681302f
--- /dev/null
+++ b/desktop/aizome/apps/hako/tests/repro_hako_08.rs
@@ -0,0 +1,93 @@
+//! HAKO-08: Put Back of a trashed folder merged into a folder now at its
+//! place, with a conflicting child skipped, leaves that child in the
+//! Trash. Its entry must keep knowing where it came from (its
+//! `.trashinfo`), so it can still be put back; it must not become an
+//! orphan "of unknown origin".
+
+use std::collections::VecDeque;
+use std::fs;
+use std::path::PathBuf;
+
+use hako::fsops::transfer::{restore, trash_items};
+use hako::fsops::trash::Trash;
+use hako::fsops::{Asker, Conflict, Control, Env, ErrorChoice, Failure, Resolution};
+
+struct Tmp(PathBuf);
+
+impl Tmp {
+    fn new(name: &str) -> Tmp {
+        let p = std::env::temp_dir().join(format!("hako-repro-08-{name}-{}", std::process::id()));
+        let _ = fs::remove_dir_all(&p);
+        fs::create_dir_all(&p).unwrap();
+        Tmp(fs::canonicalize(&p).unwrap())
+    }
+    fn file(&self, rel: &str, text: &str) -> PathBuf {
+        let p = self.0.join(rel);
+        fs::create_dir_all(p.parent().unwrap()).unwrap();
+        fs::write(&p, text).unwrap();
+        p
+    }
+}
+
+impl Drop for Tmp {
+    fn drop(&mut self) {
+        let _ = fs::remove_dir_all(&self.0);
+    }
+}
+
+/// Answers from a script.
+struct Script(VecDeque<Resolution>, Vec<String>);
+
+impl Asker for Script {
+    fn conflict(&mut self, c: &Conflict) -> Resolution {
+        self.1.push(c.target.file_name().unwrap().to_string_lossy().into_owned());
+        self.0.pop_front().expect("an answer")
+    }
+    fn error(&mut self, _: &Failure) -> ErrorChoice {
+        ErrorChoice::Skip
+    }
+}
+
+#[test]
+fn a_merged_put_back_that_skipped_a_child_keeps_its_origin() {
+    let t = Tmp::new("merge");
+    let trash = Trash {
+        home: t.0.join("data/Trash"),
+        home_dir: Some(t.0.join("home")),
+        uid: unsafe { libc::getuid() },
+        topdirs: Some(Vec::new()),
+    };
+    t.file("home/f/keep.txt", "keep");
+    t.file("home/f/clash.txt", "old clash");
+    let f = t.0.join("home/f");
+    let control = Control::new();
+    let mut quiet = Script(VecDeque::new(), Vec::new());
+    let (r, _) = trash_items(std::slice::from_ref(&f), &trash, &mut Env::new(&control, &mut quiet, &mut ()));
+    assert!(r.is_clean(), "{r:?}");
+    // A new f with a clash.txt of its own.
+    t.file("home/f/clash.txt", "new clash");
+    // Put Back: merge the folders, skip the conflicting child.
+    let mut s = Script([Resolution::Merge, Resolution::Skip].into(), Vec::new());
+    let entries = trash.list();
+    let r = restore(&entries, &trash, &mut Env::new(&control, &mut s, &mut ()));
+    eprintln!("asked about {:?}; report {r:?}", s.1);
+    assert_eq!(fs::read_to_string(f.join("keep.txt")).unwrap(), "keep");
+    assert_eq!(fs::read_to_string(f.join("clash.txt")).unwrap(), "new clash");
+    // The skipped child is still in the Trash...
+    let left = trash.list();
+    eprintln!(
+        "the Trash now: {:?}",
+        left.iter().map(|e| (e.file.clone(), e.info.clone(), e.original.clone())).collect::<Vec<_>>()
+    );
+    let entry = left.iter().find(|e| e.file.join("clash.txt").exists()).expect("the skipped child stays in the Trash");
+    // ...and must still know where it came from.
+    assert_eq!(
+        entry.original.as_deref(),
+        Some(f.as_path()),
+        "the folder left in the Trash lost its .trashinfo: it lists as of unknown origin"
+    );
+    // So it can be put back later (here, by keeping both).
+    let mut later = Script([Resolution::Merge, Resolution::KeepBoth].into(), Vec::new());
+    let r = restore(std::slice::from_ref(entry), &trash, &mut Env::new(&control, &mut later, &mut ()));
+    assert!(r.failed.is_empty(), "a later Put Back works: {r:?}");
+}
diff --git a/desktop/aizome/apps/hako/tests/repro_hako_09.rs b/desktop/aizome/apps/hako/tests/repro_hako_09.rs
new file mode 100644
index 00000000..2f12c038
--- /dev/null
+++ b/desktop/aizome/apps/hako/tests/repro_hako_09.rs
@@ -0,0 +1,75 @@
+//! HAKO-09: an undo that fails (the name it would rename back to is
+//! taken now) must not lose its step: ⌘Z again must not silently undo
+//! the step before it instead.
+
+mod common;
+
+use std::path::PathBuf;
+
+use aizome_kit::theme::ThemeChoice;
+use common::*;
+use hako::ui::Msg;
+
+fn sandbox(name: &str) -> Sandbox {
+    let dir = std::env::temp_dir().join(format!("hako-repro-09-{name}-{}", std::process::id()));
+    let _ = std::fs::remove_dir_all(&dir);
+    std::fs::create_dir_all(&dir).unwrap();
+    Sandbox(std::fs::canonicalize(&dir).unwrap())
+}
+
+fn names(dir: &PathBuf) -> Vec<String> {
+    let mut v: Vec<String> =
+        std::fs::read_dir(dir).unwrap().flatten().map(|e| e.file_name().to_string_lossy().into_owned()).collect();
+    v.sort();
+    v
+}
+
+#[test]
+fn a_failed_undo_keeps_its_step() {
+    let s = sandbox("undo");
+    let docs = s.dir("home/docs");
+    s.file("home/docs/a.txt", "a");
+    let mut h = harness(&s, ThemeChoice::Night);
+    let w = h.window();
+    h.focus_window(w, true);
+    // Step 1: Duplicate a.txt.
+    h.send(Msg::GoPath(w, docs.join("a.txt")));
+    settle(&mut h);
+    h.send(Msg::Duplicate(w));
+    settle(&mut h);
+    assert_eq!(h.program().history.undo_label(), Some("Duplicate"));
+    let copy = names(&docs).into_iter().find(|n| n.contains("copy")).expect("a copy made");
+    // Step 2: rename a.txt to b.txt.
+    h.send(Msg::GoPath(w, docs.join("a.txt")));
+    settle(&mut h);
+    h.send(Msg::StartRename(w));
+    h.send(Msg::RenameText(w, "b.txt".into()));
+    h.send(Msg::RenameCommit(w));
+    settle(&mut h);
+    assert_eq!(h.program().history.undo_label(), Some("Rename"));
+    // Something else takes the old name.
+    s.file("home/docs/a.txt", "newer");
+    // ⌘Z: renaming back fails ("a.txt is taken now").
+    h.send(Msg::Undo);
+    settle(&mut h);
+    eprintln!(
+        "after the failed undo: undo {:?}, redo {:?}, folder {:?}",
+        h.program().history.undo_label(),
+        h.program().history.redo_label(),
+        names(&docs)
+    );
+    assert!(docs.join("b.txt").exists(), "the rename wasn't undone");
+    let label = h.program().history.undo_label().map(str::to_owned);
+    // ⌘Z again must not undo the Duplicate behind the person's back.
+    h.send(Msg::Undo);
+    settle(&mut h);
+    let copy_kept = docs.join(&copy).exists();
+    eprintln!("after a second ⌘Z: folder {:?}, items in the Trash {}", names(&docs), h.program().opts.trash.list().len());
+    assert_eq!(
+        label.as_deref(),
+        Some("Rename"),
+        "the step that failed to undo is gone from the history; the next ⌘Z then {}",
+        if copy_kept { "kept the copy" } else { "trashed the Duplicate's copy" }
+    );
+    assert!(copy_kept, "a second ⌘Z undid the step before the failed one: {:?}", names(&docs));
+}
diff --git a/desktop/aizome/apps/hako/tests/repro_hako_11.rs b/desktop/aizome/apps/hako/tests/repro_hako_11.rs
