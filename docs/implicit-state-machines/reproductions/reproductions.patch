@@ -0,0 +1,74 @@
+#!/usr/bin/env python3
+"""TTL-10: closing the lid while docked, when Hyprland finishes turning the
+panel off only after `wait_disabled`'s 2 s, must still bring the panel back
+when the lid opens.
+
+Uses test_display_recovery.py's fake Hyprland and logind in bwrap; the only
+change is a modeset that completes 2.5 s after the rule is accepted.
+
+usage: repro_ttl_10.py /path/to/tatami
+"""
+import importlib.util
+import json
+from pathlib import Path
+import sys
+import threading
+import time
+import unittest
+
+HERE = Path(__file__).resolve().parent
+spec = importlib.util.spec_from_file_location('test_display_recovery',
+                                              HERE / 'test_display_recovery.py')
+harness = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(harness)  # takes the binary from sys.argv[1]
+
+
+class SlowModeset(harness.FakeHyprland):
+    """Accepts `disabled = true` at once and applies it 2.5 s later, as a slow
+    modeset on a dock does; everything else as the shared fake."""
+
+    def evaluate(self, lua):
+        if 'disabled = true' in lua and (self.state / 'slow-disable').exists():
+            def later():
+                time.sleep(2.5)
+                with self.lock:
+                    harness.FakeHyprland.evaluate(self, lua)
+            threading.Thread(target=later, daemon=True).start()
+            return
+        super().evaluate(lua)
+
+
+class LidAfterSlowModeset(harness.Recovery):
+    def setUp(self):
+        super().setUp()
+        self.hyprland.close()
+        (self.root / 'run/user/1000/hypr/test/.socket.sock').unlink()
+        self.hyprland = SlowModeset(self.root)
+
+    def session(self):
+        return json.loads((self.runtime / 'displays-session.json').read_text())
+
+    def test_ttl_10_panel_returns_after_a_slow_lid_close(self):
+        self.docked()
+        self.run_tatami('displays', 'recover')
+        (self.root / 'state/slow-disable').touch()
+        self.set_lid('closed')
+        failed = self.run_tatami('displays', 'recover', ok=False)
+        self.assertIn('did not turn off', failed.stderr)
+        self.wait_for(lambda: self.display('eDP-1')['disabled'], 5)
+        # The watcher's next tick: lid still closed, panel now off.
+        self.run_tatami('displays', 'recover')
+        after_close = self.session()
+        self.set_lid('open')
+        self.run_tatami('displays', 'recover')
+        self.assertFalse(
+            self.display('eDP-1')['disabled'],
+            f'panel stayed off after the lid opened; session after close: {after_close}, '
+            f'after open: {self.session()}; monitors-off: {self.switched_off()}')
+
+
+if __name__ == '__main__':
+    # The shared test of the same journey with a prompt modeset is the control.
+    unittest.main(argv=[sys.argv[0], '-v',
+                         'LidAfterSlowModeset.test_ttl_10_panel_returns_after_a_slow_lid_close',
+                         'LidAfterSlowModeset.test_closing_the_lid_while_docked_turns_the_panel_off_and_opening_restores_it'])
