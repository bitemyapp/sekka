+//! UIW-09: clicking the in-window menu bar's open title closes its menu
+//! (it doesn't open it again).
+
+use aizome_kit::prelude::*;
+use aizome_kit::testing::Harness;
+
+#[derive(Default)]
+struct Notes;
+
+#[derive(Clone, Debug)]
+enum Msg {
+    New,
+}
+
+impl Program for Notes {
+    type Msg = Msg;
+    fn info(&self) -> AppInfo {
+        AppInfo::new("org.aizome.Fusen", "Fusen", "Notes")
+    }
+    fn launched(&mut self, cx: &mut Cx<Msg>) {
+        cx.open_window(WindowSpec::new("Notes").size(400.0, 300.0));
+    }
+    fn update(&mut self, _msg: Msg, _cx: &mut Cx<Msg>) {}
+    fn view(&self, _w: WindowKey) -> Element<Msg> {
+        text("body").into()
+    }
+    fn menus(&self) -> MenuBar<Msg> {
+        MenuBar::standard(&self.info()).with_file_menu(Menu::new("File").item(MenuItem::new("New Note", Msg::New)))
+    }
+}
+
+#[test]
+fn repro_uiw_09_clicking_the_open_title_closes_its_menu() {
+    let mut h = Harness::with(Notes, aizome_kit::Appearance::default(), true);
+    let w = h.window();
+    // "Fusen" in bold, then "File" (as tests/shell_link.rs finds it).
+    let file = Point::new(82.0, 12.0);
+    h.click(w, file);
+    assert_eq!(h.popups(w).len(), 1, "the File menu opened");
+    // The menu's popup grabs the pointer, but a click on the app's own
+    // window still reaches it: the user clicks File again to close it.
+    h.click(w, file);
+    println!("menus open after clicking the open title: {}", h.popups(w).len());
+    assert_eq!(h.popups(w).len(), 0, "clicking the open title closes its menu");
+}
diff --git a/desktop/aizome/crates/aizome-kit/tests/repro_uiw_11.rs b/desktop/aizome/crates/aizome-kit/tests/repro_uiw_11.rs
