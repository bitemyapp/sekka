@@ -0,0 +1,69 @@
+//! HAKO-16: ejecting a volume a window shows sends that window home; its
+//! Home column must then be read (not left blank as `Load::Wanted`), and
+//! the title must say Home.
+//!
+//! UDisks is replaced by `Disks::with_bus(None, …)` (tasks fail at once
+//! as "unavailable"): what's tested happens before the unmount task, in
+//! `Hako::eject` itself.
+
+mod common;
+
+use std::time::{Duration, Instant};
+
+use aizome_kit::theme::ThemeChoice;
+use aizome_sys::disks::{Disks, Volume};
+use common::*;
+use hako::ui::Msg;
+use hako::ui::browser::{Load, Loc};
+
+fn sandbox(name: &str) -> Sandbox {
+    let dir = std::env::temp_dir().join(format!("hako-repro-16-{name}-{}", std::process::id()));
+    let _ = std::fs::remove_dir_all(&dir);
+    std::fs::create_dir_all(&dir).unwrap();
+    Sandbox(std::fs::canonicalize(&dir).unwrap())
+}
+
+#[test]
+fn ejecting_a_shown_volume_reads_the_home_column() {
+    let s = sandbox("eject");
+    s.file("home/notes.txt", "notes");
+    s.file("media/stick/photo.txt", "on the stick");
+    let stick = s.path().join("media/stick");
+    let mut h = harness(&s, ThemeChoice::Night);
+    let w = h.window();
+    // A mounted, ejectable volume (no UDisks behind it).
+    h.program_mut().disks = Some(Disks::with_bus(None, aizome_sys::Wake::none()));
+    h.program_mut().volumes.push(Volume {
+        block: "/org/freedesktop/UDisks2/block_devices/sdz1".into(),
+        name: "STICK".into(),
+        mount_point: Some(stick.display().to_string()),
+        drive: Some("/org/freedesktop/UDisks2/drives/stick".into()),
+        ejectable: true,
+        ..Default::default()
+    });
+    h.send(Msg::GoPath(w, stick.clone()));
+    settle(&mut h);
+    assert_eq!(h.program().browser(w).unwrap().location(), Some(&Loc::Folder(stick.clone())));
+    assert_eq!(h.title(w), "stick");
+    // Eject it.
+    h.send(Msg::Eject("/org/freedesktop/UDisks2/block_devices/sdz1".into()));
+    let until = Instant::now() + Duration::from_millis(1500);
+    let state = |h: &aizome_kit::testing::Harness<hako::ui::Hako>| {
+        let b = h.program().browser(w).unwrap();
+        b.columns.iter().map(|c| (c.loc.clone(), c.load.clone(), c.rows.len())).collect::<Vec<_>>()
+    };
+    while Instant::now() < until && state(&h).iter().any(|(_, l, _)| *l != Load::Ready) {
+        h.send(Msg::Nop);
+        h.advance(Duration::from_millis(20));
+        std::thread::sleep(Duration::from_millis(5));
+    }
+    let cols = state(&h);
+    eprintln!("after Eject: columns {cols:?}, title {:?}", h.title(w));
+    assert_eq!(h.program().browser(w).unwrap().location(), Some(&Loc::Folder(s.home())), "sent home");
+    assert!(
+        cols.iter().all(|(_, l, _)| *l == Load::Ready),
+        "the Home column was never read (blank, no message): {cols:?}"
+    );
+    assert_eq!(cols[0].2, 1, "Home's notes.txt shows");
+    assert_eq!(h.title(w), "Home", "the title follows");
+}
diff --git a/desktop/aizome/apps/hako/tests/repro_hako_25.rs b/desktop/aizome/apps/hako/tests/repro_hako_25.rs
new file mode 100644
index 00000000..4a46c631
--- /dev/null
+++ b/desktop/aizome/apps/hako/tests/repro_hako_25.rs
@@ -0,0 +1,131 @@
+//! HAKO-25: a drag inside a window must resolve against what's on screen.
+//! - In List view, after opening a subfolder (columns [Home, work], the
+//!   list showing work), not against the stale spot 0 left from when the
+//!   list showed Home.
+//! - In search, a drop off a folder row must not fall through to the
+//!   column spots painted before the search began.
+
+mod common;
+
+use aizome_kit::testing::Harness;
+use aizome_kit::theme::ThemeChoice;
+use aizome_kit::{Point, WindowKey};
+use common::*;
+use hako::ui::dnd::Dest;
+use hako::ui::fileview::Layout;
+use hako::ui::{Hako, Msg};
+
+fn sandbox(name: &str) -> Sandbox {
+    let dir = std::env::temp_dir().join(format!("hako-repro-25-{name}-{}", std::process::id()));
+    let _ = std::fs::remove_dir_all(&dir);
+    std::fs::create_dir_all(&dir).unwrap();
+    Sandbox(std::fs::canonicalize(&dir).unwrap())
+}
+
+fn names(h: &Harness<Hako>, w: WindowKey, col: usize) -> Vec<String> {
+    h.program()
+        .browser(w)
+        .unwrap()
+        .columns
+        .get(col)
+        .map(|c| c.rows.iter().map(|e| e.display.clone()).collect())
+        .unwrap_or_default()
+}
+
+fn listing(p: std::path::PathBuf) -> Vec<String> {
+    let mut v: Vec<String> = std::fs::read_dir(p)
+        .map(|rd| rd.flatten().map(|e| e.file_name().to_string_lossy().into_owned()).collect())
+        .unwrap_or_default();
+    v.sort();
+    v
+}
+
+/// The middle of row `row` of a list (its header is 24 points, rows 24).
+fn list_row(h: &Harness<Hako>, w: WindowKey, col: usize, row: usize) -> Point {
+    let r = h.find_id(w, &format!("col-{col}")).unwrap_or_else(|| panic!("column {col} shows"));
+    Point::new(r.x0 + 60.0, r.y0 + 24.0 + row as f64 * 24.0 + 12.0)
+}
+
+#[test]
+fn a_drag_in_a_subfolder_list_resolves_to_the_list_shown() {
+    let s = sandbox("list");
+    s.dir("home/Alpha");
+    s.dir("home/Beta");
+    s.file("home/work/a.txt", "a");
+    s.file("home/work/b.txt", "b");
+    let mut h = harness(&s, ThemeChoice::Night);
+    let w = h.window();
+    h.focus_window(w, true);
+    h.send(Msg::SetLayout(w, Layout::List));
+    h.send(Msg::GoPath(w, s.home()));
+    settle(&mut h);
+    assert_eq!(names(&h, w, 0), ["Alpha", "Beta", "work"]);
+    h.render(w, 1.0);
+    // Into work (as a double-click does): columns [Home, work], the list shows work.
+    h.send(Msg::GoPath(w, s.home().join("work")));
+    settle(&mut h);
+    let b = h.program().browser(w).unwrap();
+    assert_eq!((b.columns.len(), b.focus), (2, 1));
+    assert_eq!(names(&h, w, 1), ["a.txt", "b.txt"]);
+    h.render(w, 1.0);
+    // What a drop at b.txt's row means: work itself (b.txt is a file).
+    let at = list_row(&h, w, 1, 1);
+    let target = h.program().browser(w).unwrap().spots.at(at);
+    eprintln!("target at b.txt's row: {target:?}");
+    // The drag itself: a.txt onto b.txt's row should do nothing.
+    let from = list_row(&h, w, 1, 0);
+    h.send(Msg::Select(w, 1, vec![0]));
+    h.render(w, 1.0);
+    h.drag(w, from, at, 6);
+    settle(&mut h);
+    eprintln!("after the drag: work {:?}, Beta {:?}", listing(s.home().join("work")), listing(s.home().join("Beta")));
+    assert_eq!(
+        target.as_ref().map(|t| (t.spot, t.dest.clone())),
+        Some((1, Dest::Folder(s.home().join("work")))),
+        "the drop target resolves through a spot not on screen"
+    );
+    assert!(s.home().join("work/a.txt").exists(), "a.txt moved out of work into a folder of Home's listing");
+}
+
+#[test]
+fn a_drop_in_search_results_off_a_folder_does_not_reach_old_columns() {
+    let s = sandbox("search");
+    s.dir("home/work/Inner");
+    s.file("home/work/b.txt", "b");
+    s.file("home/work/c.txt", "c");
+    let mut h = harness(&s, ThemeChoice::Night);
+    let w = h.window();
+    h.focus_window(w, true);
+    h.send(Msg::GoPath(w, s.home().join("work")));
+    settle(&mut h);
+    assert_eq!(names(&h, w, 1), ["Inner", "b.txt", "c.txt"]);
+    h.render(w, 1.0);
+    // Where Inner's row is in the columns, before searching.
+    let col1 = h.find_id(w, "col-1").expect("work's column");
+    let over_inner = Point::new(col1.x0 + 60.0, col1.y0 + 12.0);
+    assert_eq!(
+        h.program().browser(w).unwrap().spots.at(over_inner).map(|t| t.dest),
+        Some(Dest::Folder(s.home().join("work/Inner")))
+    );
+    // Search work for "b.txt": the results replace the columns.
+    h.send(Msg::Search(w, "b.txt".into()));
+    assert!(wait_for(&mut h, |p| p.browser(w).unwrap().search.as_ref().is_some_and(|s| !s.running)));
+    let results: Vec<String> =
+        h.program().browser(w).unwrap().search.as_ref().unwrap().results.iter().map(|e| e.display.clone()).collect();
+    assert_eq!(results, ["b.txt"]);
+    h.render(w, 1.0);
+    let target = h.program().browser(w).unwrap().spots.at(over_inner);
+    eprintln!("search shows {results:?}; target where Inner's row was: {target:?}");
+    // Drag the result there and let go.
+    let from = list_row(&h, w, 0, 0);
+    h.send(Msg::SearchSelect(w, vec![0]));
+    h.render(w, 1.0);
+    h.drag(w, from, over_inner, 6);
+    settle(&mut h);
+    eprintln!("after the drop: work {:?}, Inner {:?}", listing(s.home().join("work")), listing(s.home().join("work/Inner")));
+    assert!(
+        target.as_ref().is_none_or(|t| t.spot == 0),
+        "a point of the search results resolves to a column not shown: {target:?}"
+    );
+    assert!(s.home().join("work/b.txt").exists(), "b.txt was moved into a folder not on screen");
+}
diff --git a/desktop/aizome/apps/hako/tests/repro_hako_28.rs b/desktop/aizome/apps/hako/tests/repro_hako_28.rs
new file mode 100644
index 00000000..88ac42b9
--- /dev/null
+++ b/desktop/aizome/apps/hako/tests/repro_hako_28.rs
@@ -0,0 +1,86 @@
+//! HAKO-28: a job whose window closed before it asked puts its question
+//! over another window. When that window closes too, the question must
+//! be asked again somewhere (the operations window), not vanish while
+//! the job waits for an answer nobody can give.
+
+mod common;
+
+use aizome_kit::testing::Harness;
+use aizome_kit::theme::ThemeChoice;
+use aizome_kit::WindowKey;
+use common::*;
+use hako::ui::app::Sheet;
+use hako::ui::dnd::Dest;
+use hako::ui::{Hako, Msg};
+
+fn sandbox(name: &str) -> Sandbox {
+    let dir = std::env::temp_dir().join(format!("hako-repro-28-{name}-{}", std::process::id()));
+    let _ = std::fs::remove_dir_all(&dir);
+    std::fs::create_dir_all(&dir).unwrap();
+    Sandbox(std::fs::canonicalize(&dir).unwrap())
+}
+
+/// The windows showing job `id`'s question (its buttons).
+fn asking_in(h: &Harness<Hako>, id: u64) -> Vec<WindowKey> {
+    let open = h.windows();
+    let shown = h.program().sheets.iter().any(|(_, s)| matches!(s, Sheet::Ask { job, .. } if *job == id));
+    if !shown {
+        return Vec::new();
+    }
+    open.into_iter().filter(|w| h.texts(*w).iter().any(|t| t == "Keep Both")).collect()
+}
+
+#[test]
+fn a_question_survives_its_host_window_closing() {
+    let s = sandbox("ask");
+    let src = s.file("home/a/x.txt", "new x");
+    s.file("home/b/x.txt", "old x");
+    let mut h = harness(&s, ThemeChoice::Night);
+    let first = h.window();
+    h.send(Msg::NewWindow);
+    settle(&mut h);
+    let second = *h.program().windows.keys().find(|k| **k != first).unwrap();
+    // A drop into b starts a copy from the first window, and the first
+    // window closes before the copy asks about x.txt (same turn).
+    let url = format!("file://{}", src.display());
+    h.send_all([
+        Msg::DropUrls(first, Dest::Folder(s.home().join("b")), vec![url]),
+        Msg::CloseWindow(first),
+    ]);
+    assert!(wait_for(&mut h, |p| p.jobs.first().is_some_and(|j| j.question.is_some() && j.sheet.is_some())));
+    let id = h.program().jobs[0].id;
+    assert_eq!(asking_in(&h, id), vec![second], "the question shows over the window left");
+    eprintln!(
+        "job window {:?} (closed: first {:?}), sheet {:?}, ops {:?}",
+        h.program().jobs[0].window,
+        first,
+        h.program().jobs[0].sheet,
+        h.program().ops_window
+    );
+    // That window closes too.
+    h.send(Msg::CloseWindow(second));
+    settle_briefly(&mut h);
+    let j = &h.program().jobs[0];
+    eprintln!(
+        "after closing it: job status {:?}, sheet {:?}, ops {:?}, windows {:?}",
+        j.status(),
+        j.sheet,
+        h.program().ops_window,
+        h.windows()
+    );
+    assert!(h.program().ops_window.is_some(), "the operations window shows the job");
+    assert!(
+        !asking_in(&h, id).is_empty(),
+        "no window shows the question any more; the job says {:?} and can only be stopped",
+        j.status()
+    );
+}
+
+/// A few turns, without waiting on the job (it's blocked on purpose).
+fn settle_briefly(h: &mut Harness<Hako>) {
+    for _ in 0..20 {
+        h.send(Msg::Nop);
+        h.advance(std::time::Duration::from_millis(20));
+        std::thread::sleep(std::time::Duration::from_millis(5));
+    }
+}
