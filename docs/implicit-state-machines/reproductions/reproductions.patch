+++ b/tests/repro_ttl_17.py
@@ -0,0 +1,158 @@
+#!/usr/bin/env python3
+"""TTL-17: `tatami reload` (an appearance reload, Yukimi's update-session)
+must leave Night Light and Do Not Disturb as the user set them.
+
+The real helper runs in bwrap with fakes for the services it talks to:
+systemctl keeps unit state in files, and restarting a unit restarts its fake
+daemon from scratch, as systemd does: hyprsunset at its identity profile
+(desktop/tatami/config/hypr/hyprsunset.conf, 6000 K), mako in its default
+mode (modes live only in mako's memory). Night Light and Do Not Disturb are
+switched on with Tatami's own commands, and read back with them.
+
+usage: repro_ttl_17.py /path/to/tatami
+"""
+import json
+import os
+from pathlib import Path
+import shutil
+import subprocess
+import sys
+import tempfile
+import unittest
+
+BIN = Path(sys.argv.pop(1)).resolve()
+PYTHON = Path(sys.executable).resolve()
+
+UNITS = ['tatami-display-recovery', 'tatami-elephant', 'tatami-hypridle', 'tatami-hyprsunset',
+         'tatami-keep-awake', 'tatami-mako', 'tatami-polkit', 'tatami-power-key',
+         'tatami-restore', 'tatami-swaybg', 'tatami-swayosd', 'tatami-udiskie',
+         'tatami-walker', 'tatami-waybar']
+
+SYSTEMCTL = r'''
+import json, pathlib, sys
+state = pathlib.Path('/state')
+units = state / 'units'
+args = [a for a in sys.argv[1:] if a not in ('--user', '--quiet', '--plain', '--no-legend')]
+with open(state / 'calls', 'a') as f:
+    f.write(json.dumps(['systemctl'] + sys.argv[1:]) + '\n')
+def fresh(unit):
+    # A daemon started afresh: its in-memory state is its defaults.
+    if unit == 'tatami-hyprsunset.service':
+        (state / 'temperature').write_text('6000')
+    if unit == 'tatami-mako.service':
+        (state / 'mako-modes').write_text('default')
+verb, names = args[0], args[1:]
+if verb == 'daemon-reload':
+    sys.exit(0)
+if verb == 'is-active':
+    sys.exit(0 if (units / names[0]).exists() else 3)
+if verb == 'list-units':
+    for name in names:
+        if (units / name).exists():
+            print(f'{name} loaded active running {name}')
+    sys.exit(0)
+if verb in ('start', 'restart', 'try-restart'):
+    for name in names:
+        if verb == 'try-restart' and not (units / name).exists():
+            continue
+        (units / name).touch()
+        fresh(name)
+    sys.exit(0)
+if verb == 'stop':
+    for name in names:
+        (units / name).unlink(missing_ok=True)
+    sys.exit(0)
+sys.exit(1)
+'''
+
+HYPRCTL = r'''
+import pathlib, sys
+state = pathlib.Path('/state')
+args = sys.argv[1:]
+if args[:2] == ['hyprsunset', 'temperature']:
+    if not (state / 'units/tatami-hyprsunset.service').exists():
+        sys.exit(1)
+    if len(args) == 3:
+        (state / 'temperature').write_text(args[2])
+        print('ok')
+    else:
+        print((state / 'temperature').read_text())
+    sys.exit(0)
+sys.exit(1)  # no Hyprland here: `instances` fails, so the config counts as pinned
+'''
+
+MAKOCTL = r'''
+import pathlib, sys
+state = pathlib.Path('/state')
+if not (state / 'units/tatami-mako.service').exists():
+    sys.exit(1)
+modes = (state / 'mako-modes').read_text().split()
+if sys.argv[1:] == ['mode']:
+    print('\n'.join(modes))
+elif sys.argv[1:3] == ['mode', '-t']:
+    mode = sys.argv[3]
+    modes = [m for m in modes if m != mode] if mode in modes else modes + [mode]
+    (state / 'mako-modes').write_text(' '.join(modes))
+    print('\n'.join(modes))
+else:
+    sys.exit(1)
+'''
+
+BUSCTL = r'''
+import sys
+print('b true' if 'NameHasOwner' in sys.argv else '')
+'''
+
+
+class ReloadKeepsToggles(unittest.TestCase):
+    def setUp(self):
+        tmp = tempfile.TemporaryDirectory(prefix='ttl17-')
+        self.addCleanup(tmp.cleanup)
+        self.root = root = Path(tmp.name)
+        for folder in ['state/units', 'fake', 'home/alice', 'run/user/1000', 'nix/store', 'bin',
+                       'etc/xdg/tatami']:
+            (root / folder).mkdir(parents=True, exist_ok=True)
+        (root / 'etc/xdg/tatami/units.json').write_text(
+            json.dumps([u + '.service' for u in UNITS]))
+        for name, body in [('systemctl', SYSTEMCTL), ('hyprctl', HYPRCTL),
+                           ('makoctl', MAKOCTL), ('busctl', BUSCTL), ('notify-send', '')]:
+            (root / 'fake' / name).write_text(f'#!{PYTHON}\n' + body)
+            (root / 'fake' / name).chmod(0o755)
+        # The session as it runs: the bar, notifications, Keep Awake; no nightlight yet.
+        for unit in ['tatami-waybar', 'tatami-mako', 'tatami-keep-awake']:
+            (root / 'state/units' / (unit + '.service')).touch()
+        (root / 'state/mako-modes').write_text('default')
+
+    def tatami(self, *args):
+        command = [
+            'bwrap', '--unshare-all', '--die-with-parent', '--bind', str(self.root), '/',
+            '--ro-bind', '/nix/store', '/nix/store', '--ro-bind', str(BIN), '/bin/tatami',
+            '--proc', '/proc', '--dev', '/dev', '--clearenv',
+            '--setenv', 'PATH', '/fake',
+            '--setenv', 'HOME', '/home/alice', '--setenv', 'XDG_RUNTIME_DIR', '/run/user/1000',
+            '--setenv', 'HYPRLAND_INSTANCE_SIGNATURE', 'test', '--chdir', '/',
+            '/bin/tatami', *args,
+        ]
+        result = subprocess.run(command, text=True, capture_output=True, timeout=60)
+        self.assertEqual(result.returncode, 0, result.stdout + result.stderr)
+        return result.stdout.strip()
+
+    def toggles(self):
+        return {'nightlight': self.tatami('nightlight', 'status'),
+                'notifications': json.loads(self.tatami('indicator', 'notifications'))['class']}
+
+    def test_reload_keeps_night_light_and_do_not_disturb(self):
+        self.tatami('nightlight', 'on')
+        self.tatami('toggle', 'notifications')
+        before = self.toggles()
+        self.assertEqual(before, {'nightlight': '4000', 'notifications': 'active'})
+        self.tatami('reload')
+        restarted = [c for c in map(json.loads, (self.root / 'state/calls').read_text().splitlines())
+                     if 'try-restart' in c]
+        self.assertEqual(self.toggles(), before, f'after `tatami reload`; it ran {restarted}')
+
+
+if __name__ == '__main__':
+    if not shutil.which('bwrap'):
+        raise SystemExit('bubblewrap is required; never run this against the host session')
+    unittest.main()
