+//! STA-22: a new account's password is set only when Users & Groups is
+//! the pane showing as AccountsService lists the account; leave the pane
+//! as CreateUser answers and the account never gets the password chosen.
+//!
+//! The real pane in the real window, over accounts shaped like the
+//! sample's. Live AccountsService answers CreateUser before the snapshot
+//! lists the account (it learns of it from a signal and a property read);
+//! the sample adds it at once, so the test takes it out until "later" and
+//! sends the window's wake itself when it comes.
+
+use std::cell::RefCell;
+use std::rc::Rc;
+use std::sync::Arc;
+
+use aizome_kit::prelude::*;
+use aizome_kit::testing::Harness;
+use aizome_sys::users::PasswordMode;
+
+use super::{Msg, Users};
+use crate::app::{AppMsg, Settei, Start};
+use crate::pane::{Group, Pane, PaneCx, SettingEntry, Tile, ViewCx};
+use crate::system::Cell;
+use crate::system::accounts::{Accounts, sample_users};
+
+/// The real pane, shared with the test, its messages held while `hold`
+/// says so (a reply still on its way).
+struct Tap<P: Pane> {
+    inner: Rc<RefCell<P>>,
+    hold: Rc<dyn Fn(&P::Msg) -> bool>,
+    held: Rc<RefCell<Vec<P::Msg>>>,
+}
+
+impl<P: Pane> Pane for Tap<P> {
+    type Msg = P::Msg;
+    fn id(&self) -> &'static str {
+        <P as Pane>::id(&self.inner.borrow())
+    }
+    fn title(&self) -> &'static str {
+        <P as Pane>::title(&self.inner.borrow())
+    }
+    fn icon(&self) -> Icon {
+        <P as Pane>::icon(&self.inner.borrow())
+    }
+    fn tile(&self) -> Tile {
+        <P as Pane>::tile(&self.inner.borrow())
+    }
+    fn group(&self) -> Group {
+        <P as Pane>::group(&self.inner.borrow())
+    }
+    fn keywords(&self) -> &'static [&'static str] {
+        <P as Pane>::keywords(&self.inner.borrow())
+    }
+    fn entries(&self) -> Vec<SettingEntry> {
+        <P as Pane>::entries(&self.inner.borrow())
+    }
+    fn update(&mut self, msg: P::Msg, cx: &mut PaneCx<P::Msg>) {
+        if (self.hold)(&msg) {
+            self.held.borrow_mut().push(msg);
+            return;
+        }
+        self.inner.borrow_mut().update(msg, cx);
+    }
+    fn view(&self, vcx: &ViewCx) -> Element<P::Msg> {
+        self.inner.borrow().view(vcx)
+    }
+    fn shown(&mut self, cx: &mut PaneCx<P::Msg>) {
+        self.inner.borrow_mut().shown(cx)
+    }
+    fn hidden(&mut self, cx: &mut PaneCx<P::Msg>) {
+        self.inner.borrow_mut().hidden(cx)
+    }
+    fn focus_entry(&mut self, entry: &str, cx: &mut PaneCx<P::Msg>) {
+        self.inner.borrow_mut().focus_entry(entry, cx)
+    }
+    fn system_changed(&mut self, cx: &mut PaneCx<P::Msg>) {
+        self.inner.borrow_mut().system_changed(cx)
+    }
+    fn settings_changed(&mut self, cx: &mut PaneCx<P::Msg>) {
+        self.inner.borrow_mut().settings_changed(cx)
+    }
+    fn listed(&self, vcx: &ViewCx) -> bool {
+        self.inner.borrow().listed(vcx)
+    }
+    fn toolbar(&self, vcx: &ViewCx) -> Option<Element<P::Msg>> {
+        self.inner.borrow().toolbar(vcx)
+    }
+    fn sheet(&self, vcx: &ViewCx) -> Option<Element<P::Msg>> {
+        self.inner.borrow().sheet(vcx)
+    }
+    fn crumb(&self) -> Option<&'static str> {
+        self.inner.borrow().crumb()
+    }
+    fn back(&mut self, cx: &mut PaneCx<P::Msg>) -> bool {
+        self.inner.borrow_mut().back(cx)
+    }
+}
+
+fn msg(m: Msg) -> AppMsg {
+    AppMsg::Pane("users", Arc::new(m))
+}
+
+fn cell(h: &Harness<Settei>) -> &Cell<aizome_sys::users::UsersState> {
+    match &h.program().shared.sys.accounts {
+        Accounts::Sample(c) => c,
+        _ => panic!("the sample's accounts"),
+    }
+}
+
+fn mode_of(h: &Harness<Settei>, login: &str) -> Option<PasswordMode> {
+    cell(h).get().user(login).map(|u| u.password_mode)
+}
+
+fn settle(h: &mut Harness<Settei>) {
+    for _ in 0..40 {
+        std::thread::sleep(std::time::Duration::from_millis(5));
+        h.send(AppMsg::Nothing);
+    }
+}
+
+/// Kai Tanaka added with a password; CreateUser answers before the
+/// accounts list kai; Mouse opened at once; then kai is listed and the
+/// window woken, as AccountsService's signal would.
+fn created_then_left(name: &str) -> (Harness<Settei>, Rc<RefCell<Users>>) {
+    use crate::pane::AnyPane;
+    let users = Rc::new(RefCell::new(Users::default()));
+    let holding = Rc::new(std::cell::Cell::new(false));
+    let held = Rc::new(RefCell::new(Vec::new()));
+    let h2 = holding.clone();
+    let tap = Tap {
+        inner: users.clone(),
+        hold: Rc::new(move |m: &Msg| h2.get() && matches!(m, Msg::Created(_))),
+        held: held.clone(),
+    };
+    let mut panes = crate::panes::all();
+    let i = panes.iter().position(|p| AnyPane::id(&**p) == "users").unwrap();
+    panes[i] = crate::pane::pane(tap);
+    let dir = std::env::temp_dir().join(format!("settei-repro-sta-22-{name}-{}", std::process::id()));
+    let _ = std::fs::remove_dir_all(&dir);
+    std::fs::create_dir_all(&dir).unwrap();
+    let mut h = Harness::new(Settei::new(panes, dir.join("settings.toml"), true, Start::parse("users")));
+    // The accounts, signalling only when the test says (as AccountsService
+    // signals once it has read a new account).
+    h.program_mut().shared.sys.accounts = Accounts::Sample(Cell::new(sample_users(), aizome_sys::Wake::none()));
+
+    h.send(msg(Msg::AddUser));
+    h.send(msg(Msg::Full("Kai Tanaka".into())));
+    h.send(msg(Msg::FirstPassword("kamenozoki-7".into())));
+    holding.set(true);
+    h.send(msg(Msg::Create));
+    for _ in 0..400 {
+        if !held.borrow().is_empty() {
+            break;
+        }
+        std::thread::sleep(std::time::Duration::from_millis(5));
+        h.send(AppMsg::Nothing);
+    }
+    let created = held.borrow_mut().pop().expect("CreateUser answered");
+    // CreateUser has answered; the snapshot doesn't list kai yet.
+    let kai = cell(&h).get().user("kai").cloned().expect("the sample made kai");
+    let _ = cell(&h).update(|s| s.users.retain(|u| u.name != "kai"));
+    holding.set(false);
+    h.send(msg(created));
+    // Mouse opened at once.
+    h.send(AppMsg::Open("mouse".into(), None));
+    assert_eq!(h.program().pane_id(), "mouse");
+    // AccountsService lists kai now, and says so (the window's wake).
+    let _ = cell(&h).update(move |s| s.users.push(kai));
+    h.send(AppMsg::SystemChanged);
+    settle(&mut h);
+    (h, users)
+}
+
+#[test]
+fn repro_sta_22_a_new_accounts_password_is_set_after_leaving_the_pane() {
+    let (mut h, users) = created_then_left("left");
+    let after_leaving = mode_of(&h, "kai");
+    let pending = users.borrow().pending_password.clone();
+    // Only back on Users & Groups, with something else changing, is it set.
+    h.send(AppMsg::Open("users".into(), None));
+    h.send(AppMsg::SystemChanged);
+    settle(&mut h);
+    let after_return = mode_of(&h, "kai");
+    assert_eq!(
+        after_leaving,
+        Some(PasswordMode::Regular),
+        "kai's password wasn't set after leaving Users & Groups (pending, in memory: {pending:?}); \
+         back on the pane with a wake: {after_return:?}"
+    );
+}
+
+#[test]
+fn repro_sta_22_quitting_after_adding_still_sets_the_password() {
+    let (mut h, users) = created_then_left("quit");
+    let w = h.window();
+    h.command(w, 'q');
+    assert!(h.platform.quit, "⌘Q quits");
+    let at_quit = mode_of(&h, "kai");
+    let pending = users.borrow().pending_password.clone();
+    drop(h);
+    assert_eq!(
+        at_quit,
+        Some(PasswordMode::Regular),
+        "Settei quit with kai's password only in memory ({pending:?}): kai is left to choose one at first login"
+    );
+}
diff --git a/desktop/aizome/apps/settei/src/panes/repro_stb_09.rs b/desktop/aizome/apps/settei/src/panes/repro_stb_09.rs
new file mode 100644
index 00000000..fc08709d
--- /dev/null
+++ b/desktop/aizome/apps/settei/src/panes/repro_stb_09.rs
@@ -0,0 +1,252 @@
+//! STB-09: quitting Settei while Bluetooth shows never runs the pane's
+//! `hidden`, the only place that stops discovery, undoes the adapter's
+//! discoverability and unregisters the pairing agent.
+//!
+//! The real pane in the real window over the sample BlueZ (which models
+//! no discoverability: `look` and `hidden` act on live BlueZ only), with
+//! the pane's own `showing` flag and a count of `hidden` calls as the
+//! witness. See `repro_stb_09_live` below for live BlueZ (a fake on a
+//! private bus), when the test is given one.
+
+use std::cell::RefCell;
+use std::rc::Rc;
+
+use aizome_kit::prelude::*;
+use aizome_kit::testing::Harness;
+
+use super::{Bluetooth, Msg};
+use crate::app::{AppMsg, Settei, Start};
+use crate::pane::{Group, Pane, PaneCx, SettingEntry, Tile, ViewCx};
+
+/// The real pane, shared with the test, its messages held while `hold`
+/// says so (a reply still on its way).
+struct Tap<P: Pane> {
+    inner: Rc<RefCell<P>>,
+    hold: Rc<dyn Fn(&P::Msg) -> bool>,
+    held: Rc<RefCell<Vec<P::Msg>>>,
+    hidden: Rc<std::cell::Cell<u32>>,
+}
+
+impl<P: Pane> Pane for Tap<P> {
+    type Msg = P::Msg;
+    fn id(&self) -> &'static str {
+        <P as Pane>::id(&self.inner.borrow())
+    }
+    fn title(&self) -> &'static str {
+        <P as Pane>::title(&self.inner.borrow())
+    }
+    fn icon(&self) -> Icon {
+        <P as Pane>::icon(&self.inner.borrow())
+    }
+    fn tile(&self) -> Tile {
+        <P as Pane>::tile(&self.inner.borrow())
+    }
+    fn group(&self) -> Group {
+        <P as Pane>::group(&self.inner.borrow())
+    }
+    fn keywords(&self) -> &'static [&'static str] {
+        <P as Pane>::keywords(&self.inner.borrow())
+    }
+    fn entries(&self) -> Vec<SettingEntry> {
+        <P as Pane>::entries(&self.inner.borrow())
+    }
+    fn update(&mut self, msg: P::Msg, cx: &mut PaneCx<P::Msg>) {
+        if (self.hold)(&msg) {
+            self.held.borrow_mut().push(msg);
+            return;
+        }
+        self.inner.borrow_mut().update(msg, cx);
+    }
+    fn view(&self, vcx: &ViewCx) -> Element<P::Msg> {
+        self.inner.borrow().view(vcx)
+    }
+    fn shown(&mut self, cx: &mut PaneCx<P::Msg>) {
+        self.inner.borrow_mut().shown(cx)
+    }
+    fn hidden(&mut self, cx: &mut PaneCx<P::Msg>) {
+        self.hidden.set(self.hidden.get() + 1);
+        self.inner.borrow_mut().hidden(cx)
+    }
+    fn focus_entry(&mut self, entry: &str, cx: &mut PaneCx<P::Msg>) {
+        self.inner.borrow_mut().focus_entry(entry, cx)
+    }
+    fn system_changed(&mut self, cx: &mut PaneCx<P::Msg>) {
+        self.inner.borrow_mut().system_changed(cx)
+    }
+    fn settings_changed(&mut self, cx: &mut PaneCx<P::Msg>) {
+        self.inner.borrow_mut().settings_changed(cx)
+    }
+    fn listed(&self, vcx: &ViewCx) -> bool {
+        self.inner.borrow().listed(vcx)
+    }
+    fn toolbar(&self, vcx: &ViewCx) -> Option<Element<P::Msg>> {
+        self.inner.borrow().toolbar(vcx)
+    }
+    fn sheet(&self, vcx: &ViewCx) -> Option<Element<P::Msg>> {
+        self.inner.borrow().sheet(vcx)
+    }
+    fn crumb(&self) -> Option<&'static str> {
+        self.inner.borrow().crumb()
+    }
+    fn back(&mut self, cx: &mut PaneCx<P::Msg>) -> bool {
+        self.inner.borrow_mut().back(cx)
+    }
+}
+
+fn tapped(name: &str, sample: bool) -> (Harness<Settei>, Rc<RefCell<Bluetooth>>, Rc<std::cell::Cell<u32>>) {
+    use crate::pane::AnyPane;
+    let bt = Rc::new(RefCell::new(Bluetooth::default()));
+    let hidden = Rc::new(std::cell::Cell::new(0));
+    let tap = Tap {
+        inner: bt.clone(),
+        hold: Rc::new(|_: &Msg| false),
+        held: Rc::new(RefCell::new(Vec::new())),
+        hidden: hidden.clone(),
+    };
+    let mut panes: Vec<Box<dyn AnyPane>> = if sample {
+        crate::panes::all()
+    } else {
+        // Live: only Bluetooth, so nothing else reaches for a service.
+        vec![crate::pane::pane(crate::panes::mouse::Mouse)]
+    };
+    match panes.iter().position(|p| AnyPane::id(&**p) == "bluetooth") {
+        Some(i) => panes[i] = crate::pane::pane(tap),
+        None => panes.insert(0, crate::pane::pane(tap)),
+    }
+    let dir = std::env::temp_dir().join(format!("settei-repro-stb-09-{name}-{}", std::process::id()));
+    let _ = std::fs::remove_dir_all(&dir);
+    std::fs::create_dir_all(&dir).unwrap();
+    let h = Harness::new(Settei::new(panes, dir.join("settings.toml"), sample, Start::parse("bluetooth")));
+    (h, bt, hidden)
+}
+
+fn quit(h: &mut Harness<Settei>) {
+    let w = h.window();
+    h.command(w, 'q');
+    assert!(h.platform.quit, "⌘Q quits");
+}
+
+#[test]
+fn repro_stb_09_quitting_while_bluetooth_shows_lets_it_go() {
+    let (mut h, bt, hidden) = tapped("sample", true);
+    assert_eq!(h.program().pane_id(), "bluetooth");
+    assert!(bt.borrow().showing, "shown, looking for devices and discoverable (live)");
+    // Leaving the pane runs `hidden`: the witness works.
+    h.send(AppMsg::Open("mouse".into(), None));
+    assert_eq!(hidden.get(), 1);
+    h.send(AppMsg::Open("bluetooth".into(), None));
+    assert!(bt.borrow().showing);
+    quit(&mut h);
+    let showing = bt.borrow().showing;
+    let calls = hidden.get();
+    drop(h);
+    assert!(
+        calls == 2 && !showing,
+        "Settei quit with Bluetooth showing: `hidden` ran {} time(s) on quitting, the pane still `showing` \
+         {showing}, so discovery, discoverability and the agent are never undone",
+        calls - 1
+    );
+}
+
+/// Live BlueZ: a fake `org.bluez` (adapter `/org/bluez/hci0`, settable
+/// `Discoverable`, an agent manager) served on a private `dbus-daemon`
+/// listening at the wrapper's `DBUS_SYSTEM_BUS_ADDRESS`, given as
+/// `REPRO_FAKE_BLUEZ` (the helper's path). Skipped without it.
+#[test]
+fn repro_stb_09_live_quitting_leaves_the_adapter_discoverable() {
+    let Some(helper) = std::env::var_os("REPRO_FAKE_BLUEZ") else {
+        eprintln!("skipping: no REPRO_FAKE_BLUEZ");
+        return;
+    };
+    let runtime = std::env::var("XDG_RUNTIME_DIR").expect("XDG_RUNTIME_DIR");
+    let system = std::env::var("DBUS_SYSTEM_BUS_ADDRESS").unwrap_or_default();
+    let Some(socket) = system.strip_prefix("unix:path=").filter(|p| p.starts_with(&runtime)) else {
+        panic!("only with the wrapper's private system bus address, not {system:?}");
+    };
+    assert!(std::env::var_os("SEKKA_REPRO").is_some(), "run through the isolation wrapper");
+    let _ = std::fs::remove_file(socket);
+    let conf = std::path::Path::new(&runtime).join("stb09-bus.conf");
+    std::fs::write(
+        &conf,
+        format!(
+            "<!DOCTYPE busconfig PUBLIC \"-//freedesktop//DTD D-Bus Bus Configuration 1.0//EN\" \
+             \"http://www.freedesktop.org/standards/dbus/1.0/busconfig.dtd\">\n<busconfig><type>system</type>\
+             <listen>unix:path={socket}</listen><auth>EXTERNAL</auth><policy context=\"default\">\
+             <allow send_destination=\"*\" eavesdrop=\"true\"/><allow eavesdrop=\"true\"/><allow own=\"*\"/>\
+             </policy></busconfig>\n"
+        ),
+    )
+    .unwrap();
+    struct Kill(std::process::Child);
+    impl Drop for Kill {
+        fn drop(&mut self) {
+            let _ = self.0.kill();
+            let _ = self.0.wait();
+        }
+    }
+    let _daemon = Kill(std::process::Command::new("dbus-daemon")
+        .arg(format!("--config-file={}", conf.display()))
+        .args(["--nofork", "--nopidfile"])
+        .spawn()
+        .expect("dbus-daemon"));
+    for _ in 0..200 {
+        if std::path::Path::new(socket).exists() {
+            break;
+        }
+        std::thread::sleep(std::time::Duration::from_millis(10));
+    }
+    let state = std::path::Path::new(&runtime).join("stb09-fake.state");
+    let _ = std::fs::remove_file(&state);
+    let _fake = Kill(std::process::Command::new(&helper).arg(&system).arg(&state).spawn().expect("the fake BlueZ"));
+    let discoverable = || std::fs::read_to_string(&state).ok().map(|s| s.trim().to_owned());
+    let wait = |want: &str| {
+        for _ in 0..500 {
+            if discoverable().as_deref() == Some(want) {
+                return true;
+            }
+            std::thread::sleep(std::time::Duration::from_millis(10));
+        }
+        false
+    };
+    assert!(wait("discoverable=false"), "the fake's adapter, not discoverable at first: {:?}", discoverable());
+
+    // Run 1: Bluetooth shown, the adapter made discoverable; ⌘Q.
+    let (mut h, bt, _) = tapped("live-1", false);
+    for _ in 0..500 {
+        if bt.borrow().looking && discoverable().as_deref() == Some("discoverable=true") {
+            break;
+        }
+        std::thread::sleep(std::time::Duration::from_millis(10));
+        h.send(AppMsg::SystemChanged);
+    }
+    let made = bt.borrow().made_discoverable;
+    let first = discoverable();
+    quit(&mut h);
+    drop(h);
+    std::thread::sleep(std::time::Duration::from_millis(500));
+    let after_quit = discoverable();
+
+    // Run 2: shown and left for another pane, as it should be undone.
+    let (mut h, bt, hidden) = tapped("live-2", false);
+    for _ in 0..300 {
+        if bt.borrow().looking {
+            break;
+        }
+        std::thread::sleep(std::time::Duration::from_millis(10));
+        h.send(AppMsg::SystemChanged);
+    }
+    let made_2 = bt.borrow().made_discoverable;
+    h.send(AppMsg::Open("mouse".into(), None));
+    let left = hidden.get();
+    std::thread::sleep(std::time::Duration::from_millis(500));
+    for _ in 0..10 {
+        h.send(AppMsg::Nothing);
+    }
+    let after_leaving = discoverable();
+    drop(h);
+    assert!(
+        after_quit.as_deref() == Some("discoverable=false") && after_leaving.as_deref() == Some("discoverable=false"),
+        "run 1 made it discoverable ({made}, {first:?}); after ⌘Q: {after_quit:?}. Run 2 found it so \
+         (made_discoverable {made_2}); after leaving the pane ({left} hidden): {after_leaving:?}"
+    );
+}
