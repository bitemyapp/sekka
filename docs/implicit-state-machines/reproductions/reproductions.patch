@@ -0,0 +1,132 @@
+#!/usr/bin/env python3
+"""TTL-25: choosing a new weather place while a background fetch for the old
+one is in flight must end with the new place's report.
+
+Runs the real helper in bwrap with test_tatami_weather.py's approach: a fake
+curl answers wttr.in, Open-Meteo and the geocoder, slowly, and a fake Walker
+types the new place. The bar's periodic `tatami weather` has started
+`tatami weather fetch` for the saved place; while it waits on Open-Meteo, the
+user picks Newtown (`tatami weather place`, Setup > Weather).
+
+usage: repro_ttl_25.py /path/to/tatami
+"""
+import json
+from pathlib import Path
+import shutil
+import subprocess
+import sys
+import tempfile
+import time
+import unittest
+
+PYTHON = Path(sys.executable).resolve()
+HERE = Path(__file__).resolve()
+
+FAKE_CURL = r'''
+import json, pathlib, sys, time
+state = pathlib.Path('/state')
+url = sys.argv[-1]
+with open(state / 'calls', 'a') as out:
+    out.write(f'{time.monotonic():.2f} {url}\n')
+if 'geocoding-api' in url:
+    print(json.dumps({'results': [{'name': 'Newtown', 'admin1': 'North', 'country': 'Germany',
+                                   'latitude': 52.5, 'longitude': 13.4}]}))
+elif 'open-meteo' in url:
+    time.sleep(1.5)
+    warm = 'latitude=52.5' in url  # Newtown is warmer than Oldtown
+    print(json.dumps({
+        'current': {'temperature_2m': 30 if warm else 5, 'apparent_temperature': 20,
+                    'relative_humidity_2m': 40, 'wind_speed_10m': 9,
+                    'weather_code': 0, 'is_day': 1},
+        'daily': {'time': ['2026-10-12', '2026-10-13', '2026-10-14', '2026-10-15'],
+                  'weather_code': [0, 1, 2, 3],
+                  'temperature_2m_max': [25, 26, 27, 28],
+                  'temperature_2m_min': [10, 11, 12, 13]}}))
+else:
+    sys.exit(22)
+'''
+WALKER = 'import sys\nsys.stdin.read()\nprint("Newtown")\n'
+FAIL = 'import sys\nsys.exit(1)\n'
+QUIET = ''
+
+
+def inner(race):
+    cache = Path('/home/alice/.cache/tatami/weather.json')
+    place = Path('/home/alice/.local/state/tatami/weather-place.json')
+    calls = Path('/state/calls')
+    place.parent.mkdir(parents=True, exist_ok=True)
+    place.write_text(json.dumps({'name': 'Oldtown', 'country': 'Germany',
+                                 'latitude': 50.1, 'longitude': 8.7}))
+    now = int(time.time())
+    cache.parent.mkdir(parents=True, exist_ok=True)
+    cache.write_text(json.dumps({'fetched': now - 20 * 60, 'place': 'Oldtown', 'imperial': False,
+                                 'current': {'temp': 4, 'feels': 3, 'humidity': 60, 'wind': 5,
+                                             'glyph': 'OLD'},
+                                 'days': [], 'located': None}))
+
+    def urls():
+        return calls.read_text().splitlines() if calls.exists() else []
+
+    background = subprocess.Popen(["/bin/tatami", "weather", "fetch"] if race else [str(PYTHON), "-c", ""])
+    until = time.monotonic() + 5
+    while race and time.monotonic() < until and not any('open-meteo' in u for u in urls()):
+        time.sleep(0.02)
+    chooser = subprocess.run(['/bin/tatami', 'weather', 'place'], capture_output=True,
+                             text=True, timeout=30)
+    background.wait(timeout=30)
+    report = json.loads(cache.read_text())
+    bar = json.loads(subprocess.run(['/bin/tatami', 'weather'], capture_output=True, text=True,
+                                    timeout=30).stdout)
+    print(json.dumps({
+        'place_file': json.loads(place.read_text()),
+        'report_place': report['place'], 'report_temp': report['current']['temp'],
+        'report_age': int(time.time()) - report['fetched'],
+        'bar_tooltip_mentions_newtown': 'NEWTOWN' in bar['tooltip'],
+        'chooser_status': chooser.returncode, 'calls': urls(),
+        'refreshing_marker_left': Path('/run/user/1000/tatami/weather-refreshing').exists(),
+    }))
+
+
+class PlaceChangeDuringFetch(unittest.TestCase):
+    def test_new_place_wins_over_an_in_flight_fetch(self):
+        self.choose(scenario="race")
+
+    def test_control_new_place_without_a_fetch_in_flight(self):
+        self.choose(scenario="alone")
+
+    def choose(self, scenario):
+        with tempfile.TemporaryDirectory(prefix='ttl25-') as tmp:
+            root = Path(tmp)
+            for folder in ['home/alice', 'run/user/1000', 'state', 'fake', 'bin', 'nix/store']:
+                (root / folder).mkdir(parents=True, exist_ok=True)
+            (root / 'run/user/1000').chmod(0o700)
+            for name, body in [('curl', FAKE_CURL), ('walker', WALKER), ('hyprctl', FAIL),
+                               ('notify-send', QUIET)]:
+                (root / 'fake' / name).write_text(f'#!{PYTHON}\n' + body)
+                (root / 'fake' / name).chmod(0o755)
+            command = [
+                'bwrap', '--unshare-all', '--die-with-parent', '--bind', str(root), '/',
+                '--ro-bind', '/nix/store', '/nix/store', '--ro-bind', str(BIN), '/bin/tatami',
+                '--ro-bind', str(HERE), '/test.py',
+                '--proc', '/proc', '--dev', '/dev', '--clearenv',
+                '--setenv', 'PATH', '/fake',
+                '--setenv', 'HOME', '/home/alice', '--setenv', 'XDG_RUNTIME_DIR', '/run/user/1000',
+                '--setenv', 'LANG', 'en_US.UTF-8', '--chdir', '/',
+                str(PYTHON), '/test.py', '--inner', scenario,
+            ]
+            result = subprocess.run(command, text=True, capture_output=True, timeout=90)
+            self.assertEqual(result.returncode, 0, result.stdout + result.stderr)
+            facts = json.loads(result.stdout.strip().splitlines()[-1])
+        self.assertEqual(facts['place_file']['name'], 'Newtown', facts)
+        self.assertEqual(facts['report_place'], 'Newtown', facts)
+        self.assertTrue(facts['bar_tooltip_mentions_newtown'], facts)
+
+
+if __name__ == '__main__':
+    if sys.argv[1:2] == ['--inner']:
+        inner(sys.argv[2] == "race")
+    else:
+        BIN = Path(sys.argv.pop(1)).resolve()
+        if not shutil.which('bwrap'):
+            raise SystemExit('bubblewrap is required; never run this against the host session')
+        unittest.main()
