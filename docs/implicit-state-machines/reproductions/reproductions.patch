diff --git a/desktop/aizome/crates/aizome-comp/examples/repro_skb_11.rs b/desktop/aizome/crates/aizome-comp/examples/repro_skb_11.rs
new file mode 100644
index 00000000..ec3411f7
--- /dev/null
+++ b/desktop/aizome/crates/aizome-comp/examples/repro_skb_11.rs
@@ -0,0 +1,50 @@
+//! SKB-11 (Sukumo backend): a sidestep-ui window whose main thread is slow
+//! to draw a new size. It opens at 320 × 200 points and draws green; when
+//! it's asked to draw at any other size it writes `$REPRO_DIR/stalling`,
+//! says `REPRO stall begin` on stderr, holds its main thread for
+//! `$REPRO_STALL_MS` (2500 by default) as a long layout pass would, says
+//! `REPRO stall end`, then draws. The render thread meanwhile handles
+//! input and configures on its own. Run with `SIDESTEP_DECORATIONS=client`
+//! for Sukumo's own header, and `WAYLAND_DEBUG=1` to log the requests.
+
+use std::time::Duration;
+
+use sidestep_ui::kurbo::Rect;
+use sidestep_ui::{App, Canvas, Color, Cx, Handler, WindowId, WindowOptions};
+
+const GREEN: Color = Color::rgb8(0x26, 0xa2, 0x69);
+
+struct Slow {
+    first: Option<(f64, f64)>,
+}
+
+impl Handler for Slow {
+    fn launched(&mut self, cx: &mut Cx) {
+        cx.open_window(WindowOptions::new("Repro SKB-11").size(320.0, 200.0));
+    }
+
+    fn draw(&mut self, _cx: &mut Cx, _window: WindowId, canvas: &mut Canvas) {
+        let s = canvas.size();
+        let size = (s.width, s.height);
+        let first = *self.first.get_or_insert(size);
+        if size != first {
+            let dir = std::path::PathBuf::from(std::env::var_os("REPRO_DIR").expect("REPRO_DIR"));
+            eprintln!("REPRO stall begin {}x{}", s.width, s.height);
+            let _ = std::fs::write(dir.join("stalling"), format!("{}x{}\n", s.width, s.height));
+            let ms = std::env::var("REPRO_STALL_MS").ok().and_then(|v| v.parse().ok()).unwrap_or(2500);
+            std::thread::sleep(Duration::from_millis(ms));
+            eprintln!("REPRO stall end");
+            let _ = std::fs::write(dir.join("stalled"), "");
+            self.first = Some(size);
+        }
+        canvas.fill_rect(Rect::new(0.0, 0.0, s.width, s.height), GREEN);
+    }
+}
+
+fn main() {
+    App::new()
+        .app_id("org.aizome.repro-skb11")
+        .quit_when_last_window_closes(true)
+        .run(Slow { first: None })
+        .expect("run");
+}
diff --git a/desktop/aizome/crates/aizome-comp/tests/repro_cpa_16.rs b/desktop/aizome/crates/aizome-comp/tests/repro_cpa_16.rs
new file mode 100644
index 00000000..dfed2582
--- /dev/null
+++ b/desktop/aizome/crates/aizome-comp/tests/repro_cpa_16.rs
@@ -0,0 +1,83 @@
+//! CPA-16: the recovery overlay opened on a display that then leaves the
+//! layout must still show its panel (or close).
+//!
+//! The overlay keeps the output it opened on (`Recovery.output`) and draws
+//! the panel only there; nothing resets it when that output goes. The test
+//! opens the overlay with the pointer on a laptop's panel beside an
+//! external display, closes the lid (the panel leaves the layout), and
+//! asserts that, while it stays open, the panel is drawn on the display
+//! that remains.
+
+mod common;
+
+use aizome_ipc::{OutputInfo, RecoveryState, Request, Response, Synthetic};
+use common::*;
+
+fn recovery(c: &Compositor) -> RecoveryState {
+    match c.request(Request::RecoveryState) {
+        Response::Recovery { state } => state,
+        r => panic!("{r:?}"),
+    }
+}
+
+fn outputs(c: &Compositor) -> Vec<OutputInfo> {
+    match c.request(Request::Outputs) {
+        Response::Outputs { outputs } => outputs,
+        r => panic!("{r:?}"),
+    }
+}
+
+/// Pixels of the image near a colour.
+fn count(img: &Image, want: [u8; 3]) -> usize {
+    let mut n = 0;
+    for y in 0..img.height as i32 {
+        for x in 0..img.width as i32 {
+            if near(img.px(x, y), want) {
+                n += 1;
+            }
+        }
+    }
+    n
+}
+
+#[test]
+fn repro_cpa_16_the_recovery_panel_follows_its_display_leaving() {
+    let c = Compositor::start(Options { outputs: &["eDP-1=1280x800@1", "1280x800@1"], settings: "", ..Default::default() });
+    // The pointer on the laptop's panel (the first output, at the origin).
+    c.ok(Request::Synthesize { events: vec![Synthetic::PointerMotion { x: 640.0, y: 400.0 }] });
+    c.ok(Request::Recovery { state: Some(true) });
+    let st = recovery(&c);
+    assert!(st.open, "{st:?}");
+    let panel = st.panel.expect("the panel's place");
+    c.settle();
+    let before = c.screenshot();
+    // The title strip's colour, where the panel is (on eDP-1).
+    let title = before.px(panel.x + panel.w / 2, panel.y + 6);
+    let backdrop = before.px(4, 4);
+    assert!(!near(title, backdrop), "the panel shows before: title {title:?}, backdrop {backdrop:?}");
+    let title_px_before = count(&before, title);
+
+    // The lid closes: eDP-1 leaves the layout, HEADLESS-2 remains.
+    c.ok(Request::Synthesize { events: vec![Synthetic::Lid { closed: true }] });
+    let outs = outputs(&c);
+    let edp = outs.iter().find(|o| o.name == "eDP-1").unwrap();
+    assert!(!edp.enabled, "the closed panel left the layout: {edp:?}");
+    let ext = outs.iter().find(|o| o.name == "HEADLESS-2").unwrap().logical;
+    c.settle();
+    let st = recovery(&c);
+    let after = c.screenshot();
+    keep(&after, "repro-cpa-16-after-lid");
+    let title_px_after = count(&after, title);
+    let panel_inside = st
+        .panel
+        .is_some_and(|p| p.x >= ext.x && p.y >= ext.y && p.x + p.w <= ext.x + ext.w && p.y + p.h <= ext.y + ext.h);
+    assert!(
+        !st.open || title_px_after > title_px_before / 4,
+        "the overlay is open (taking every key and click) but its panel is drawn on no display: \
+         title-strip pixels {title_px_before} before, {title_px_after} after; layout now {}x{} (HEADLESS-2 at {ext:?}); \
+         reported panel {:?} inside HEADLESS-2: {panel_inside}",
+        after.width,
+        after.height,
+        st.panel
+    );
+}
diff --git a/desktop/aizome/crates/aizome-comp/tests/repro_cpa_27.rs b/desktop/aizome/crates/aizome-comp/tests/repro_cpa_27.rs
new file mode 100644
index 00000000..34c3b350
--- /dev/null
+++ b/desktop/aizome/crates/aizome-comp/tests/repro_cpa_27.rs
@@ -0,0 +1,236 @@
+//! CPA-27: the supervised shell's lifecycle.
+//!
+//! (1) A helper whose first start fails is never tried again: `start_child`
+//! leaves `restart_at` at None and `supervise` restarts only a due
+//! `restart_at`. (2) A shell restart whose new binary fails to start has
+//! already moved the running shell to `retiring` with no handover: that
+//! shell is no longer supervised, and later restarts leave it running
+//! beside the next one, never stopped.
+//!
+//! The "shells" here are scripts this test writes: each appends its pid to
+//! a file and becomes `sleep 120`. Every pid recorded is killed when the
+//! test ends (they're this test's processes, started through the
+//! compositor it started).
+
+mod common;
+
+use std::os::unix::fs::PermissionsExt;
+use std::path::{Path, PathBuf};
+use std::sync::atomic::{AtomicU32, Ordering};
+use std::time::{Duration, Instant};
+
+use aizome_ipc::{ReloadReport, Request, Response};
+use common::*;
+
+static N: AtomicU32 = AtomicU32::new(0);
+
+/// A scratch folder with the fake shells, and the pids they recorded.
+struct Shells {
+    dir: PathBuf,
+}
+
+impl Shells {
+    fn new() -> Shells {
+        let dir = std::env::temp_dir().join(format!("cpa27-{}-{}", std::process::id(), N.fetch_add(1, Ordering::SeqCst)));
+        let _ = std::fs::remove_dir_all(&dir);
+        std::fs::create_dir_all(&dir).unwrap();
+        Shells { dir }
+    }
+
+    fn pids_file(&self) -> PathBuf {
+        self.dir.join("pids")
+    }
+
+    /// A shell that records itself and waits.
+    fn write_good(&self, name: &str) -> PathBuf {
+        let p = self.dir.join(name);
+        let tmp = self.dir.join(format!(".{name}.tmp"));
+        std::fs::write(&tmp, format!("#!/bin/sh\necho $$ >> '{}'\nexec sleep 120\n", self.pids_file().display())).unwrap();
+        std::fs::set_permissions(&tmp, std::fs::Permissions::from_mode(0o755)).unwrap();
+        std::fs::rename(&tmp, &p).unwrap();
+        p
+    }
+
+    /// A program (executable) that can't be started: its interpreter
+    /// doesn't exist, so exec fails (a broken build).
+    fn write_bad(&self, name: &str) -> PathBuf {
+        let p = self.dir.join(name);
+        std::fs::write(&p, "#!/nonexistent/interpreter\n").unwrap();
+        std::fs::set_permissions(&p, std::fs::Permissions::from_mode(0o755)).unwrap();
+        p
+    }
+
+    fn pids(&self) -> Vec<u32> {
+        std::fs::read_to_string(self.pids_file())
+            .unwrap_or_default()
+            .lines()
+            .filter_map(|l| l.trim().parse().ok())
+            .collect()
+    }
+
+    fn alive(&self) -> Vec<u32> {
+        self.pids().into_iter().filter(|p| is_our_sleep(*p)).collect()
+    }
+
+    fn wait_pids(&self, what: &str, n: usize, secs: u64) -> Option<Vec<u32>> {
+        let deadline = Instant::now() + Duration::from_secs(secs);
+        loop {
+            let p = self.pids();
+            if p.len() >= n {
+                return Some(p);
+            }
+            if Instant::now() > deadline {
+                eprintln!("timed out waiting for {what}: pids {p:?}");
+                return None;
+            }
+            std::thread::sleep(Duration::from_millis(50));
+        }
+    }
+}
+
+/// A fake shell still running: `sleep 120`, as the script left it.
+fn is_our_sleep(pid: u32) -> bool {
+    let Ok(cmd) = std::fs::read(format!("/proc/{pid}/cmdline")) else { return false };
+    let stat = std::fs::read_to_string(format!("/proc/{pid}/stat")).unwrap_or_default();
+    let zombie = stat.rsplit(')').next().is_some_and(|s| s.trim_start().starts_with('Z'));
+    cmd == b"sleep\x00120\x00" && !zombie
+}
+
+impl Drop for Shells {
+    fn drop(&mut self) {
+        for p in self.pids() {
+            if is_our_sleep(p) {
+                // Safety: SIGKILL to a fake shell this test started.
+                unsafe {
+                    libc::kill(p as i32, libc::SIGKILL);
+                }
+            }
+        }
+        let _ = std::fs::remove_dir_all(&self.dir);
+    }
+}
+
+fn start(shell: &Path) -> Compositor {
+    let bin = shell.to_string_lossy().into_owned();
+    let env = [("AIZOME_SHELL_BIN", bin.as_str())];
+    Compositor::start(Options { args: &["--shell"], env: &env, settings: "", ..Default::default() })
+}
+
+fn reload_shell(c: &Compositor, from: Option<&Path>, check: bool) -> ReloadReport {
+    match c.request(Request::Reload {
+        logic: false,
+        shell: from.is_none(),
+        from: None,
+        shell_from: from.map(|p| p.to_string_lossy().into_owned()),
+        check,
+    }) {
+        Response::Reload { report } => report,
+        r => panic!("{r:?}"),
+    }
+}
+
+/// (1) The shell can't start at login (here: its binary isn't there yet;
+/// for real, EAGAIN at the process limit, a store path mid-switch); once
+/// it can, the supervisor must start it.
+#[test]
+fn repro_cpa_27_a_helper_whose_first_start_failed_is_retried() {
+    let s = Shells::new();
+    let later = s.dir.join("shell-later");
+    let c = start(&later);
+    let deadline = Instant::now() + Duration::from_secs(10);
+    while !c.log_text().contains("aizome-shell: ") {
+        assert!(Instant::now() < deadline, "no failed start logged:\n{}", c.log_text());
+        std::thread::sleep(Duration::from_millis(50));
+    }
+    // The binary is there now.
+    s.write_good("shell-later");
+    // Backoff starts at 1 s and the supervisor polls every second: give it
+    // eight.
+    let started = s.wait_pids("the shell to be started again", 1, 8);
+    let report = reload_shell(&c, None, true);
+    assert!(
+        started.is_some(),
+        "the shell that failed to start at login was never retried; `reload --shell --check` says {:?}\n{}",
+        report.shell,
+        c.log_text().lines().filter(|l| l.contains("shell")).collect::<Vec<_>>().join("\n")
+    );
+}
+
+/// (2a) After a failed restart the running shell must stay supervised:
+/// if it then dies, a shell comes back.
+#[test]
+fn repro_cpa_27_a_failed_shell_restart_keeps_the_running_shell_supervised() {
+    let s = Shells::new();
+    let good = s.write_good("shell");
+    let c = start(&good);
+    let a = s.wait_pids("the first shell", 1, 10).expect("the first shell started")[0];
+    let bad = s.write_bad("shell-broken");
+    let report = reload_shell(&c, Some(&bad), false);
+    assert_eq!(report.shell.action, "failed", "the broken shell couldn't start: {report:?}");
+    // The running shell, as the compositor sees it.
+    let check = reload_shell(&c, None, true);
+    // The old shell dies (a crash).
+    // Safety: SIGKILL to the fake shell this test started.
+    unsafe {
+        libc::kill(a as i32, libc::SIGKILL);
+    }
+    let again = s.wait_pids("a shell to come back", 2, 8);
+    assert!(
+        again.is_some(),
+        "after a failed restart, shell {a} was no longer supervised: `reload --shell --check` said {:?} \
+         while it ran, and nothing started a shell after it died",
+        check.shell
+    );
+}
+
+/// (2b) Shells must never pile up: after a failed restart and the next
+/// ones, one shell runs, and none outlives the compositor.
+#[test]
+fn repro_cpa_27_a_failed_shell_restart_leaves_no_shell_behind() {
+    let s = Shells::new();
+    let good = s.write_good("shell");
+    let c = start(&good);
+    let a = s.wait_pids("the first shell", 1, 10).expect("the first shell started")[0];
+    // A restart with a broken build fails...
+    let fixed_later = s.write_bad("shell-dev");
+    let report = reload_shell(&c, Some(&fixed_later), false);
+    assert_eq!(report.shell.action, "failed", "{report:?}");
+    // ...the build is fixed and Restart Shell (the recovery overlay)
+    // starts it,
+    s.write_good("shell-dev");
+    match c.request(Request::RecoveryAction { action: "restart-shell".into(), app_id: None }) {
+        Response::Message { .. } => {}
+        r => panic!("restart-shell: {r:?}"),
+    }
+    let b = s.wait_pids("Restart Shell's shell", 2, 8).map(|p| p[1]);
+    std::thread::sleep(Duration::from_millis(1500));
+    let after_restart = s.alive();
+    // ...and later a normal shell restart.
+    let r = reload_shell(&c, Some(&good), false);
+    let c_pid = s.wait_pids("the next shell", 3, 8).map(|p| p[2]);
+    // Its handover ends once the old one has no surfaces (fakes have none).
+    let deadline = Instant::now() + Duration::from_secs(10);
+    while !c.log_text().contains("shell restart finished") && Instant::now() < deadline {
+        std::thread::sleep(Duration::from_millis(50));
+    }
+    std::thread::sleep(Duration::from_millis(1500));
+    let after_handover = s.alive();
+    // The compositor quits.
+    c.ok(Request::Quit);
+    let deadline = Instant::now() + Duration::from_secs(10);
+    while aizome_ipc::Client::connect_to(&c.ipc).is_ok() && Instant::now() < deadline {
+        std::thread::sleep(Duration::from_millis(50));
+    }
+    std::thread::sleep(Duration::from_millis(1000));
+    let after_quit = s.alive();
+    eprintln!(
+        "shells: first {a}, Restart Shell's {b:?}, next {c_pid:?} ({:?}); alive after Restart Shell {after_restart:?}, \
+         after the handover {after_handover:?}, after the compositor quit {after_quit:?}",
+        r.shell
+    );
+    assert!(
+        after_restart.len() <= 1 && after_handover.len() <= 1 && after_quit.is_empty(),
+        "shells piled up: alive after Restart Shell {after_restart:?}, after the next restart's handover \
+         {after_handover:?}, after the compositor quit {after_quit:?} (first shell {a})"
+    );
+}
diff --git a/desktop/aizome/crates/aizome-comp/tests/repro_cpb_07.rs b/desktop/aizome/crates/aizome-comp/tests/repro_cpb_07.rs
new file mode 100644
index 00000000..4b05ba7e
--- /dev/null
+++ b/desktop/aizome/crates/aizome-comp/tests/repro_cpb_07.rs
@@ -0,0 +1,131 @@
+//! CPB-07: idle inhibitors are kept per surface, but smithay hands each
+//! inhibitor object to `inhibit`/`uninhibit` on its own. A surface with two
+//! inhibitors (a browser window playing a video and holding a call) whose
+//! client destroys one must stay inhibited while the other lives.
+//! Watched through ext-idle-notify, as idle daemons see it.
+
+mod common;
+
+use std::os::unix::net::UnixStream;
+use std::time::{Duration, Instant};
+
+use common::*;
+use wayland_client::globals::{GlobalListContents, registry_queue_init};
+use wayland_client::protocol::{wl_compositor, wl_registry, wl_seat, wl_surface};
+use wayland_client::{Connection, Dispatch, EventQueue, QueueHandle};
+use wayland_protocols::ext::idle_notify::v1::client::{ext_idle_notification_v1, ext_idle_notifier_v1};
+use wayland_protocols::wp::idle_inhibit::zv1::client::{zwp_idle_inhibit_manager_v1, zwp_idle_inhibitor_v1};
+
+#[derive(Default)]
+struct Heard {
+    idled: u32,
+    resumed: u32,
+}
+
+struct Client {
+    conn: Connection,
+    queue: EventQueue<Heard>,
+    heard: Heard,
+}
+
+impl Client {
+    fn roundtrip(&mut self) {
+        if let Err(e) = self.queue.roundtrip(&mut self.heard) {
+            panic!("disconnected: {e} ({:?})", self.conn.protocol_error());
+        }
+    }
+
+    fn run_for(&mut self, d: Duration) {
+        let until = Instant::now() + d;
+        while Instant::now() < until {
+            self.roundtrip();
+            std::thread::sleep(Duration::from_millis(20));
+        }
+    }
+}
+
+#[test]
+fn repro_cpb_07_one_of_two_inhibitors_on_a_surface_going_keeps_idleness_held_off() {
+    let c = Compositor::start(Options { renderer: Some("pixman"), ..Default::default() });
+    let conn = Connection::from_socket(UnixStream::connect(c.dir.join(&c.socket)).unwrap()).unwrap();
+    let (globals, queue) = registry_queue_init::<Heard>(&conn).unwrap();
+    let qh = queue.handle();
+    let compositor: wl_compositor::WlCompositor = globals.bind(&qh, 1..=6, ()).unwrap();
+    let seat: wl_seat::WlSeat = globals.bind(&qh, 1..=7, ()).unwrap();
+    let notifier: ext_idle_notifier_v1::ExtIdleNotifierV1 = globals.bind(&qh, 1..=1, ()).expect("ext_idle_notifier_v1");
+    let inhibit: zwp_idle_inhibit_manager_v1::ZwpIdleInhibitManagerV1 =
+        globals.bind(&qh, 1..=1, ()).expect("zwp_idle_inhibit_manager_v1");
+    let mut a = Client { conn, queue, heard: Heard::default() };
+
+    // One surface, two inhibitors: the video's and the call's.
+    let surface = compositor.create_surface(&qh, ());
+    let video = inhibit.create_inhibitor(&surface, &qh, ());
+    let call = inhibit.create_inhibitor(&surface, &qh, ());
+    a.roundtrip();
+
+    // Idle after 300 ms without input; the headless session has none.
+    let _note = notifier.get_idle_notification(300, &seat, &qh, ());
+    a.run_for(Duration::from_millis(1000));
+    assert_eq!(a.heard.idled, 0, "idle while two inhibitors were held");
+
+    // The video ends; the call goes on.
+    video.destroy();
+    a.run_for(Duration::from_millis(1500));
+    assert_eq!(
+        a.heard.idled, 0,
+        "idle while the call's inhibitor on the same surface was still alive (the video's going ended inhibition)"
+    );
+
+    // The call ends too: now idleness comes.
+    call.destroy();
+    let until = Instant::now() + Duration::from_secs(5);
+    while a.heard.idled == 0 {
+        assert!(Instant::now() < until, "never idle after both inhibitors went");
+        a.run_for(Duration::from_millis(100));
+    }
+}
+
+impl Dispatch<wl_registry::WlRegistry, GlobalListContents> for Heard {
+    fn event(
+        _: &mut Self,
+        _: &wl_registry::WlRegistry,
+        _: wl_registry::Event,
+        _: &GlobalListContents,
+        _: &Connection,
+        _: &QueueHandle<Self>,
+    ) {
+    }
+}
+
+impl Dispatch<ext_idle_notification_v1::ExtIdleNotificationV1, ()> for Heard {
+    fn event(
+        h: &mut Self,
+        _: &ext_idle_notification_v1::ExtIdleNotificationV1,
+        event: ext_idle_notification_v1::Event,
+        _: &(),
+        _: &Connection,
+        _: &QueueHandle<Self>,
+    ) {
+        match event {
+            ext_idle_notification_v1::Event::Idled => h.idled += 1,
+            ext_idle_notification_v1::Event::Resumed => h.resumed += 1,
+            _ => {}
+        }
+    }
+}
+
+macro_rules! ignore {
+    ($($t:ty),*) => {$(
+        impl Dispatch<$t, ()> for Heard {
+            fn event(_: &mut Self, _: &$t, _: <$t as wayland_client::Proxy>::Event, _: &(), _: &Connection, _: &QueueHandle<Self>) {}
+        }
+    )*};
+}
+ignore!(
+    wl_compositor::WlCompositor,
+    wl_surface::WlSurface,
+    wl_seat::WlSeat,
+    ext_idle_notifier_v1::ExtIdleNotifierV1,
+    zwp_idle_inhibit_manager_v1::ZwpIdleInhibitManagerV1,
+    zwp_idle_inhibitor_v1::ZwpIdleInhibitorV1
+);
diff --git a/desktop/aizome/crates/aizome-comp/tests/repro_cpb_08.rs b/desktop/aizome/crates/aizome-comp/tests/repro_cpb_08.rs
new file mode 100644
index 00000000..fbcfbaa2
--- /dev/null
+++ b/desktop/aizome/crates/aizome-comp/tests/repro_cpb_08.rs
@@ -0,0 +1,442 @@
+//! CPB-08: pointer constraints.
+//!
+//! (1) A confined pointer (zwp_confined_pointer_v1, as games, VM viewers
+//! and Xwayland's confine-to ask for) must stay in its surface: a mouse
+//! moving past the window's edge mustn't take the pointer out of it.
+//! (2) Mouse motion while the pointer is locked (an FPS, a VM viewer) is
+//! still input: it must count as activity for the idle timers and
+//! ext-idle-notify.
+//!
+//! The core runs in this process (headless backend, pixman, no logic: the
+//! recovery path places and focuses windows) so the test can feed it
+//! relative motion, as libinput's mice do (`process_input` →
+//! `pointer_motion_relative`); IPC's synthetic motion is absolute only.
+//! The client is a real Wayland client on a thread of its own.
+
+mod common;
+
+use std::os::unix::net::UnixStream;
+use std::path::{Path, PathBuf};
+use std::sync::mpsc::{Receiver, Sender, channel};
+use std::sync::{Arc, Mutex};
+use std::time::{Duration, Instant};
+
+use aizome_comp_core::State;
+use aizome_comp_core::smithay::reexports::calloop::EventLoop;
+use aizome_comp_core::smithay::reexports::wayland_server::Display;
+use aizome_comp_core::smithay::utils::Point;
+use wayland_client::globals::{GlobalListContents, registry_queue_init};
+use wayland_client::protocol::{
+    wl_buffer, wl_compositor, wl_pointer, wl_region, wl_registry, wl_seat, wl_shm, wl_shm_pool, wl_surface,
+};
+use wayland_client::{Connection, Dispatch, EventQueue, QueueHandle};
+use wayland_protocols::wp::pointer_constraints::zv1::client::{
+    zwp_confined_pointer_v1, zwp_locked_pointer_v1, zwp_pointer_constraints_v1,
+};
+use wayland_protocols::wp::relative_pointer::zv1::client::{zwp_relative_pointer_manager_v1, zwp_relative_pointer_v1};
+use wayland_protocols::xdg::shell::client::{xdg_surface, xdg_toplevel, xdg_wm_base};
+
+// ---- the core, in process ------------------------------------------------------
+
+struct Core {
+    // The state goes before the loop that owns the display.
+    state: State,
+    event_loop: EventLoop<'static, State>,
+    socket: PathBuf,
+}
+
+impl Core {
+    fn start(name: &str) -> Core {
+        let name = format!("{name}-{}", std::process::id());
+        let args = [
+            "--backend",
+            "headless",
+            "--renderer",
+            "pixman",
+            "--headless-output",
+            "1280x800@1",
+            "--socket",
+            &name,
+            "--no-shell",
+            "--no-xwayland",
+            "--no-session",
+        ];
+        let opts = aizome_comp_core::cli::parse(args.iter().map(|s| s.to_string())).expect("options");
+        let event_loop: EventLoop<'static, State> = EventLoop::try_new().unwrap();
+        let display: Display<State> = Display::new().unwrap();
+        let backend = aizome_comp_core::backend::Backend::Headless(aizome_comp_core::backend::headless::Headless::new(
+            opts.renderer,
+            opts.headless_outputs.clone(),
+        ));
+        let mut state = State::new(
+            display,
+            event_loop.handle(),
+            event_loop.get_signal(),
+            backend,
+            opts,
+            aizome_comp_core::aizome_config::Settings::default(),
+        );
+        aizome_comp_core::backend::headless::Headless::init(&mut state);
+        state.place_pointer_on_primary();
+        let socket = PathBuf::from(std::env::var_os("XDG_RUNTIME_DIR").expect("XDG_RUNTIME_DIR")).join(&name);
+        Core { state, event_loop, socket }
+    }
+
+    /// One turn of the compositor's loop, as `run` does it.
+    fn pump(&mut self) {
+        self.event_loop.dispatch(Some(Duration::from_millis(5)), &mut self.state).unwrap();
+        self.state.on_loop_iteration();
+    }
+
+    fn pump_until(&mut self, what: &str, f: impl Fn(&State) -> bool) {
+        let deadline = Instant::now() + Duration::from_secs(10);
+        while !f(&self.state) {
+            assert!(Instant::now() < deadline, "timed out waiting for {what}");
+            self.pump();
+        }
+    }
+
+    fn pump_until_client(&mut self, game: &Game, what: &str, f: impl Fn(&Seen) -> bool) {
+        let deadline = Instant::now() + Duration::from_secs(10);
+        while !f(&game.seen()) {
+            assert!(Instant::now() < deadline, "timed out waiting for {what}: {:?}", game.seen());
+            self.pump();
+        }
+    }
+
+    fn pump_for(&mut self, d: Duration) {
+        let until = Instant::now() + d;
+        while Instant::now() < until {
+            self.pump();
+        }
+    }
+}
+
+// ---- the client: a game that constrains the pointer ------------------------------
+
+#[derive(Clone, Debug, Default)]
+struct Seen {
+    configured: bool,
+    enters: u32,
+    leaves: u32,
+    confined: bool,
+    locked: bool,
+    relative: u32,
+}
+
+enum Cmd {
+    Confine,
+    Lock,
+    Quit,
+}
+
+struct Game {
+    tx: Sender<Cmd>,
+    seen: Arc<Mutex<Seen>>,
+    join: Option<std::thread::JoinHandle<()>>,
+}
+
+impl Game {
+    fn spawn(socket: &Path) -> Game {
+        let stream = UnixStream::connect(socket).expect("connect");
+        let (tx, rx) = channel();
+        let seen = Arc::new(Mutex::new(Seen::default()));
+        let s2 = seen.clone();
+        let join = std::thread::spawn(move || run_game(stream, rx, s2));
+        Game { tx, seen, join: Some(join) }
+    }
+
+    fn seen(&self) -> Seen {
+        self.seen.lock().unwrap().clone()
+    }
+
+    fn send(&self, c: Cmd) {
+        self.tx.send(c).unwrap();
+    }
+}
+
+impl Drop for Game {
+    fn drop(&mut self) {
+        let _ = self.tx.send(Cmd::Quit);
+        if !std::thread::panicking()
+            && let Some(j) = self.join.take()
+        {
+            let _ = j.join();
+        }
+    }
+}
+
+struct App {
+    seen: Arc<Mutex<Seen>>,
+    shm: wl_shm::WlShm,
+    surface: wl_surface::WlSurface,
+    painted: bool,
+}
+
+fn run_game(stream: UnixStream, rx: Receiver<Cmd>, seen: Arc<Mutex<Seen>>) {
+    let conn = Connection::from_socket(stream).unwrap();
+    let (globals, mut queue): (_, EventQueue<App>) = registry_queue_init(&conn).unwrap();
+    let qh = queue.handle();
+    let compositor: wl_compositor::WlCompositor = globals.bind(&qh, 4..=6, ()).unwrap();
+    let shm: wl_shm::WlShm = globals.bind(&qh, 1..=1, ()).unwrap();
+    let wm: xdg_wm_base::XdgWmBase = globals.bind(&qh, 1..=6, ()).unwrap();
+    let seat: wl_seat::WlSeat = globals.bind(&qh, 5..=9, ()).unwrap();
+    let pointer = seat.get_pointer(&qh, ());
+    let constraints: zwp_pointer_constraints_v1::ZwpPointerConstraintsV1 =
+        globals.bind(&qh, 1..=1, ()).expect("zwp_pointer_constraints_v1");
+    let relative: zwp_relative_pointer_manager_v1::ZwpRelativePointerManagerV1 =
+        globals.bind(&qh, 1..=1, ()).expect("zwp_relative_pointer_manager_v1");
+    let _relative = relative.get_relative_pointer(&pointer, &qh, ());
+    let surface = compositor.create_surface(&qh, ());
+    let xs = wm.get_xdg_surface(&surface, &qh, ());
+    let tl = xs.get_toplevel(&qh, ());
+    tl.set_app_id("org.test.game".into());
+    surface.commit();
+    let mut app = App { seen, shm, surface: surface.clone(), painted: false };
+    let mut _confined = None;
+    let mut _locked = None;
+    use zwp_pointer_constraints_v1::Lifetime;
+    'run: loop {
+        for cmd in rx.try_iter() {
+            match cmd {
+                Cmd::Confine => {
+                    _confined = Some(constraints.confine_pointer(&surface, &pointer, None, Lifetime::Persistent, &qh, ()))
+                }
+                Cmd::Lock => {
+                    _locked = Some(constraints.lock_pointer(&surface, &pointer, None, Lifetime::Persistent, &qh, ()))
+                }
+                Cmd::Quit => break 'run,
+            }
+        }
+        if !common::dispatch_round(&conn, &mut queue, &mut app) {
+            break;
+        }
+    }
+}
+
+impl Dispatch<xdg_surface::XdgSurface, ()> for App {
+    fn event(
+        app: &mut Self,
+        xs: &xdg_surface::XdgSurface,
+        event: xdg_surface::Event,
+        _: &(),
+        _: &Connection,
+        qh: &QueueHandle<Self>,
+    ) {
+        if let xdg_surface::Event::Configure { serial } = event {
+            xs.ack_configure(serial);
+            if !app.painted {
+                app.painted = true;
+                let buffer = common::solid_buffer(&app.shm, (400, 300), 0x3366cc, qh);
+                app.surface.attach(Some(&buffer), 0, 0);
+                app.surface.damage_buffer(0, 0, 400, 300);
+            }
+            app.surface.commit();
+            app.seen.lock().unwrap().configured = true;
+        }
+    }
+}
+
+impl Dispatch<xdg_wm_base::XdgWmBase, ()> for App {
+    fn event(
+        _: &mut Self,
+        wm: &xdg_wm_base::XdgWmBase,
+        event: xdg_wm_base::Event,
+        _: &(),
+        _: &Connection,
+        _: &QueueHandle<Self>,
+    ) {
+        if let xdg_wm_base::Event::Ping { serial } = event {
+            wm.pong(serial);
+        }
+    }
+}
+
+impl Dispatch<wl_pointer::WlPointer, ()> for App {
+    fn event(
+        app: &mut Self,
+        _: &wl_pointer::WlPointer,
+        event: wl_pointer::Event,
+        _: &(),
+        _: &Connection,
+        _: &QueueHandle<Self>,
+    ) {
+        let mut s = app.seen.lock().unwrap();
+        match event {
+            wl_pointer::Event::Enter { .. } => s.enters += 1,
+            wl_pointer::Event::Leave { .. } => s.leaves += 1,
+            _ => {}
+        }
+    }
+}
+
+impl Dispatch<zwp_confined_pointer_v1::ZwpConfinedPointerV1, ()> for App {
+    fn event(
+        app: &mut Self,
+        _: &zwp_confined_pointer_v1::ZwpConfinedPointerV1,
+        event: zwp_confined_pointer_v1::Event,
+        _: &(),
+        _: &Connection,
+        _: &QueueHandle<Self>,
+    ) {
+        match event {
+            zwp_confined_pointer_v1::Event::Confined => app.seen.lock().unwrap().confined = true,
+            zwp_confined_pointer_v1::Event::Unconfined => app.seen.lock().unwrap().confined = false,
+            _ => {}
+        }
+    }
+}
+
+impl Dispatch<zwp_locked_pointer_v1::ZwpLockedPointerV1, ()> for App {
+    fn event(
+        app: &mut Self,
+        _: &zwp_locked_pointer_v1::ZwpLockedPointerV1,
+        event: zwp_locked_pointer_v1::Event,
+        _: &(),
+        _: &Connection,
+        _: &QueueHandle<Self>,
+    ) {
+        match event {
+            zwp_locked_pointer_v1::Event::Locked => app.seen.lock().unwrap().locked = true,
+            zwp_locked_pointer_v1::Event::Unlocked => app.seen.lock().unwrap().locked = false,
+            _ => {}
+        }
+    }
+}
+
+impl Dispatch<zwp_relative_pointer_v1::ZwpRelativePointerV1, ()> for App {
+    fn event(
+        app: &mut Self,
+        _: &zwp_relative_pointer_v1::ZwpRelativePointerV1,
+        event: zwp_relative_pointer_v1::Event,
+        _: &(),
+        _: &Connection,
+        _: &QueueHandle<Self>,
+    ) {
+        if let zwp_relative_pointer_v1::Event::RelativeMotion { .. } = event {
+            app.seen.lock().unwrap().relative += 1;
+        }
+    }
+}
+
+impl Dispatch<wl_buffer::WlBuffer, ()> for App {
+    fn event(
+        _: &mut Self,
+        buffer: &wl_buffer::WlBuffer,
+        event: wl_buffer::Event,
+        _: &(),
+        _: &Connection,
+        _: &QueueHandle<Self>,
+    ) {
+        if let wl_buffer::Event::Release = event {
+            buffer.destroy();
+        }
+    }
+}
+
+impl Dispatch<wl_registry::WlRegistry, GlobalListContents> for App {
+    fn event(
+        _: &mut Self,
+        _: &wl_registry::WlRegistry,
+        _: wl_registry::Event,
+        _: &GlobalListContents,
+        _: &Connection,
+        _: &QueueHandle<Self>,
+    ) {
+    }
+}
+
+macro_rules! ignore {
+    ($($t:ty),*) => {$(
+        impl Dispatch<$t, ()> for App {
+            fn event(_: &mut Self, _: &$t, _: <$t as wayland_client::Proxy>::Event, _: &(), _: &Connection, _: &QueueHandle<Self>) {}
+        }
+    )*};
+}
+ignore!(
+    wl_compositor::WlCompositor,
+    wl_shm::WlShm,
+    wl_shm_pool::WlShmPool,
+    wl_surface::WlSurface,
+    wl_region::WlRegion,
+    wl_seat::WlSeat,
+    xdg_toplevel::XdgToplevel,
+    zwp_pointer_constraints_v1::ZwpPointerConstraintsV1,
+    zwp_relative_pointer_manager_v1::ZwpRelativePointerManagerV1
+);
+
+// ---- the tests -------------------------------------------------------------------
+
+/// Maps the game's window and moves the pointer into it; its rectangle.
+fn game_under_pointer(core: &mut Core, game: &Game) -> aizome_comp_core::Rect {
+    core.pump_until("the window to map", |s| s.az.windows.values().any(|m| m.view.shown));
+    let rect = core.state.az.windows.values().next().unwrap().view.rect;
+    let centre = ((rect.x + rect.w / 2) as f64, (rect.y + rect.h / 2) as f64);
+    core.state.pointer_motion_absolute(Point::from(centre), 1);
+    core.pump_until_client(game, "the pointer's enter", |s| s.enters > 0);
+    rect
+}
+
+#[test]
+fn repro_cpb_08_a_confined_pointer_stays_in_its_window() {
+    let mut core = Core::start("cpb08c");
+    let game = Game::spawn(&core.socket);
+    let rect = game_under_pointer(&mut core, &game);
+    game.send(Cmd::Confine);
+    core.pump_until_client(&game, "confined", |s| s.confined);
+
+    // The mouse moves right, past the window's right edge (still on the
+    // output: the window is 400 wide, centred on a 1280-wide output).
+    for i in 0..10u32 {
+        let d = Point::from((40.0, 0.0));
+        core.state.pointer_motion_relative(d, d, u64::from(i) * 8000, 10 + i * 8);
+        core.pump();
+    }
+    core.pump_for(Duration::from_millis(100));
+    let pos = core.state.az.pointer_pos;
+    let seen = game.seen();
+    let inside = pos.x >= rect.x as f64
+        && pos.x < (rect.x + rect.w) as f64
+        && pos.y >= rect.y as f64
+        && pos.y < (rect.y + rect.h) as f64;
+    assert!(
+        inside && seen.leaves == 0,
+        "the pointer was confined to the window at {rect:?} (the client heard `confined`), yet it went to \
+         ({:.0}, {:.0}) and the client got {} leave(s): {seen:?}",
+        pos.x,
+        pos.y,
+        seen.leaves
+    );
+}
+
+#[test]
+fn repro_cpb_08_mouse_motion_while_locked_counts_as_activity() {
+    let mut core = Core::start("cpb08l");
+    let game = Game::spawn(&core.socket);
+    game_under_pointer(&mut core, &game);
+    game.send(Cmd::Lock);
+    core.pump_until_client(&game, "locked", |s| s.locked);
+    core.pump_for(Duration::from_millis(50));
+
+    let before = core.state.az.idle.last_activity;
+    let pos_before = core.state.az.pointer_pos;
+    let relative_before = game.seen().relative;
+    std::thread::sleep(Duration::from_millis(50));
+    // The player turns: relative motion, delivered to the locked app.
+    let d = Point::from((12.0, -3.0));
+    core.state.pointer_motion_relative(d, d, 1_000_000, 1000);
+    core.pump_until_client(&game, "the relative motion", |s| s.relative > relative_before);
+    let after = core.state.az.idle.last_activity;
+    eprintln!(
+        "locked: pointer {:?} -> {:?}; last activity moved {:?}",
+        pos_before,
+        core.state.az.pointer_pos,
+        after.checked_duration_since(before)
+    );
+    assert!(
+        after > before,
+        "mouse motion reached the pointer-locked app as relative motion, yet the idle state's last activity didn't \
+         move (note_activity never ran): the idle timers and ext-idle-notify count a game played with the mouse as \
+         no input"
+    );
+}
diff --git a/desktop/aizome/crates/aizome-comp/tests/repro_cpb_18.rs b/desktop/aizome/crates/aizome-comp/tests/repro_cpb_18.rs
