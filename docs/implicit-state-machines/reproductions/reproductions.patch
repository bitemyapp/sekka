diff --git a/desktop/aizome/crates/aizome-comp-core/src/protocols/repro_cpb_21.rs b/desktop/aizome/crates/aizome-comp-core/src/protocols/repro_cpb_21.rs
new file mode 100644
index 00000000..f9898da1
--- /dev/null
+++ b/desktop/aizome/crates/aizome-comp-core/src/protocols/repro_cpb_21.rs
@@ -0,0 +1,212 @@
+//! CPB-21: gamma-control ownership. The hold on an output is one `bool`
+//! per output, not tied to the control that took it, and a control keeps
+//! its output after it failed. So client A, whose control failed (its
+//! `set_gamma` couldn't be applied: the VT was switched away), can still
+//! let go of, or drive, an output that client B holds since.
+//!
+//! A unit test of the handlers with the real core state (headless backend,
+//! pixman). Clients are raw sockets inserted into the display; requests
+//! are written on the wire. The headless backend has no gamma LUT, so its
+//! `set_gamma` always fails (as udev's does while the session is away),
+//! and `GetGammaControl` refuses every output there: the grant is made as
+//! that request makes it where the CRTC takes a LUT (the hold set, the
+//! control created with its output).
+
+use std::os::fd::{AsRawFd, FromRawFd, OwnedFd, RawFd};
+use std::os::unix::net::UnixStream;
+use std::sync::Arc;
+use std::time::Duration;
+
+use smithay::output::Output;
+use smithay::reexports::calloop::EventLoop;
+use smithay::reexports::wayland_server::{Client, Display, Resource};
+
+use super::{Control, ControlData};
+use crate::state::{ClientState, State};
+
+struct Core {
+    state: State,
+    event_loop: EventLoop<'static, State>,
+}
+
+impl Core {
+    fn start(name: &str) -> Core {
+        let name = format!("{name}-{}", std::process::id());
+        let args = [
+            "--backend",
+            "headless",
+            "--renderer",
+            "pixman",
+            "--headless-output",
+            "1280x800@1",
+            "--socket",
+            &name,
+            "--no-shell",
+            "--no-xwayland",
+            "--no-session",
+        ];
+        let opts = crate::cli::parse(args.iter().map(|s| s.to_string())).expect("options");
+        let event_loop: EventLoop<'static, State> = EventLoop::try_new().unwrap();
+        let display: Display<State> = Display::new().unwrap();
+        let backend = crate::backend::Backend::Headless(crate::backend::headless::Headless::new(
+            opts.renderer,
+            opts.headless_outputs.clone(),
+        ));
+        let mut state = State::new(
+            display,
+            event_loop.handle(),
+            event_loop.get_signal(),
+            backend,
+            opts,
+            aizome_config::Settings::default(),
+        );
+        crate::backend::headless::Headless::init(&mut state);
+        Core { state, event_loop }
+    }
+
+    /// A few turns of the loop: requests read and handled, events flushed.
+    fn pump(&mut self) {
+        for _ in 0..5 {
+            self.event_loop.dispatch(Some(Duration::from_millis(10)), &mut self.state).unwrap();
+            self.state.on_loop_iteration();
+        }
+    }
+
+    fn client(&mut self) -> (Client, UnixStream) {
+        let (server, client) = UnixStream::pair().unwrap();
+        client.set_nonblocking(true).unwrap();
+        let c = self.state.az.dh.clone().insert_client(server, Arc::new(ClientState::default())).unwrap();
+        (c, client)
+    }
+
+    /// What GetGammaControl does for an output whose CRTC takes a gamma
+    /// LUT: refuses one already held, else holds it for a new control.
+    fn grant(&mut self, client: &Client, output: &Output) -> Control {
+        let s = self.state.az.out.get_mut(output).unwrap();
+        assert!(!s.gamma_client, "GetGammaControl would refuse: the output is held");
+        s.gamma_client = true;
+        client
+            .create_resource::<Control, ControlData, State>(
+                &self.state.az.dh,
+                1,
+                ControlData { output: Some(output.clone()) },
+            )
+            .unwrap()
+    }
+
+    fn held(&self, output: &Output) -> bool {
+        self.state.az.out.get(output).is_some_and(|s| s.gamma_client)
+    }
+}
+
+/// Writes one request (no arguments in the body; an fd beside it).
+fn request(sock: &UnixStream, object: u32, opcode: u32, fd: Option<RawFd>) {
+    let words = [object, (8 << 16) | opcode];
+    let mut bytes = [0u8; 8];
+    bytes[..4].copy_from_slice(&words[0].to_ne_bytes());
+    bytes[4..].copy_from_slice(&words[1].to_ne_bytes());
+    let mut iov = libc::iovec { iov_base: bytes.as_mut_ptr().cast(), iov_len: 8 };
+    // Safety: plain sendmsg with one iovec and, maybe, one SCM_RIGHTS fd.
+    unsafe {
+        let mut cmsg = [0u8; 64];
+        let mut hdr: libc::msghdr = std::mem::zeroed();
+        hdr.msg_iov = &mut iov;
+        hdr.msg_iovlen = 1;
+        if let Some(fd) = fd {
+            hdr.msg_control = cmsg.as_mut_ptr().cast();
+            hdr.msg_controllen = libc::CMSG_SPACE(4) as _;
+            let c = libc::CMSG_FIRSTHDR(&hdr);
+            (*c).cmsg_level = libc::SOL_SOCKET;
+            (*c).cmsg_type = libc::SCM_RIGHTS;
+            (*c).cmsg_len = libc::CMSG_LEN(4) as _;
+            std::ptr::write_unaligned(libc::CMSG_DATA(c).cast::<i32>(), fd);
+        }
+        assert_eq!(libc::sendmsg(sock.as_raw_fd(), &hdr, 0), 8, "sendmsg");
+    }
+}
+
+/// The events a raw client got: (object, opcode).
+fn events(sock: &UnixStream) -> Vec<(u32, u32)> {
+    use std::io::Read;
+    let mut buf = Vec::new();
+    let mut chunk = [0u8; 4096];
+    loop {
+        match (&*sock).read(&mut chunk) {
+            Ok(0) => break,
+            Ok(n) => buf.extend_from_slice(&chunk[..n]),
+            Err(_) => break,
+        }
+    }
+    let mut out = Vec::new();
+    let mut i = 0;
+    while i + 8 <= buf.len() {
+        let obj = u32::from_ne_bytes(buf[i..i + 4].try_into().unwrap());
+        let word = u32::from_ne_bytes(buf[i + 4..i + 8].try_into().unwrap());
+        out.push((obj, word & 0xffff));
+        i += ((word >> 16) as usize).max(8);
+    }
+    out
+}
+
+fn ramps_fd() -> OwnedFd {
+    // Safety: memfd_create with a static name; we own the new fd.
+    unsafe { OwnedFd::from_raw_fd(libc::memfd_create(c"ramps".as_ptr(), 0)) }
+}
+
+const SET_GAMMA: u32 = 0;
+const DESTROY: u32 = 1;
+const FAILED: u32 = 1;
+
+/// A holds the output; its `set_gamma` fails (failed, released); B takes
+/// the output. Returns A's socket and control id, and B's socket and
+/// control (kept: B's going would release its hold).
+fn a_failed_then_b_holds(core: &mut Core, output: &Output) -> (UnixStream, u32, (UnixStream, Control)) {
+    let (a, a_sock) = core.client();
+    let (b, b_sock) = core.client();
+    let ca = core.grant(&a, output);
+    let ca_id = ca.id().protocol_id();
+    let fd = ramps_fd();
+    request(&a_sock, ca_id, SET_GAMMA, Some(fd.as_raw_fd()));
+    core.pump();
+    assert!(events(&a_sock).contains(&(ca_id, FAILED)), "A's control failed");
+    assert!(!core.held(output), "A's failure let the output go");
+    let cb = core.grant(&b, output);
+    assert!(core.held(output), "B holds the output");
+    (a_sock, ca_id, (b_sock, cb))
+}
+
+#[test]
+fn repro_cpb_21_a_failed_controls_destruction_leaves_anothers_hold() {
+    let mut core = Core::start("cpb21d");
+    let output = core.state.az.outputs[0].clone();
+    let (a_sock, ca_id, _cb) = a_failed_then_b_holds(&mut core, &output);
+    core.pump();
+    assert!(core.held(&output), "control: B still holds the output after a quiet turn of the loop");
+    // A destroys its failed control, as the protocol tells it to.
+    request(&a_sock, ca_id, DESTROY, None);
+    core.pump();
+    assert!(
+        core.held(&output),
+        "client A destroyed its control that had failed (and been released) earlier, and that released client \
+         B's hold on {}: Night Light takes the ramps back over B's",
+        output.name()
+    );
+}
+
+#[test]
+fn repro_cpb_21_a_failed_control_cant_drive_the_output_again() {
+    let mut core = Core::start("cpb21s");
+    let output = core.state.az.outputs[0].clone();
+    let (a_sock, ca_id, _cb) = a_failed_then_b_holds(&mut core, &output);
+    // A tries again on its failed control (it should be inert now).
+    let fd = ramps_fd();
+    request(&a_sock, ca_id, SET_GAMMA, Some(fd.as_raw_fd()));
+    core.pump();
+    let heard = events(&a_sock);
+    assert!(
+        core.held(&output),
+        "client A's failed control set gamma on {} again while client B held it (here the set failed and released \
+         B's hold; under udev it succeeds and overwrites B's ramps); A heard {heard:?}",
+        output.name()
+    );
+}
