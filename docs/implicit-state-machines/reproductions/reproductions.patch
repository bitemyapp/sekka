@@ -0,0 +1,39 @@
+//! HOT-14: choosing Follow Desktop must show the desktop's current theme, even
+//! when the desktop changed while Hotaru kept its own theme.
+use aizome_hotaru::app::{Hotaru, Msg};
+use aizome_hotaru::settings::Theme;
+use aizome_kit::testing::Harness;
+use aizome_kit::theme::{Appearance, ThemeChoice};
+use std::time::Duration;
+
+fn turn(h: &mut Harness<Hotaru>) {
+    for _ in 0..5 {
+        h.advance(Duration::from_millis(1));
+        h.settle(Duration::from_millis(5), |_| false);
+    }
+}
+
+#[test]
+fn repro_hot_14_follow_desktop_after_the_desktop_changed_under_an_override() {
+    let day = Appearance { theme: ThemeChoice::Day, ..Appearance::default() };
+    let night = Appearance { theme: ThemeChoice::Night, ..Appearance::default() };
+    let mut h = Harness::with(Hotaru::preview(), day, false);
+    turn(&mut h);
+    assert!(!h.theme().is_dark(), "precondition: Hotaru follows the Day desktop");
+    // Hotaru is set to Night.
+    h.send(Msg::SetTheme(Theme::Night));
+    turn(&mut h);
+    assert!(h.theme().is_dark(), "precondition: Night override shown");
+    // The desktop switches to Night: the kit's settings watcher rethemes the
+    // app to the desktop's appearance (Harness::set_appearance is that call).
+    h.set_appearance(night);
+    turn(&mut h);
+    let cached = h.program().desktop_appearance().theme;
+    // The user now chooses Follow Desktop.
+    h.send(Msg::SetTheme(Theme::Desktop));
+    turn(&mut h);
+    assert!(
+        h.theme().is_dark(),
+        "Follow Desktop shows Day while the desktop is Night (Hotaru's cached desktop theme: {cached:?})"
+    );
+}
diff --git a/desktop/aizome/apps/hotaru/tests/repro_hot_17.rs b/desktop/aizome/apps/hotaru/tests/repro_hot_17.rs
