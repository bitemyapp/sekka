+++ b/desktop/tatami/activity/src/repro_tap_08.rs
@@ -0,0 +1,59 @@
+// SPDX-License-Identifier: MIT OR Apache-2.0
+//! TAP-08: Force Quit answered after the selected process has gone and its
+//! PID belongs to another process. `confirm_quit` (window.rs:696-746) moves
+//! the Target, bare PIDs from the frame shown when it opened, into the
+//! response handler.
+//!
+//! Reusing a PID can't be forced here, so the frames say it: the frame shown
+//! when the dialog opens has "Doomed" (started at tick 111) at PID P, which
+//! is in fact this test's own `sleep`; the next frame shows P as that
+//! `sleep`, with its real start. Only this test's child can be signalled.
+//! Same window as TAP-06 (`build` without the sampler). Needs a display and
+//! a session bus.
+use super::repro_tap_06::{app, frame, settle_for, start_of, ui};
+use super::*;
+
+#[test]
+fn repro_tap_08_force_quit_after_pid_reuse() {
+    let app = app("org.tatami.Activity.ReproTap08");
+    let (ui, _frames) = ui(&app);
+    ui.window.present();
+    settle_for(Duration::from_millis(100));
+
+    let mut other = std::process::Command::new("sleep")
+        .arg("600")
+        .spawn()
+        .unwrap();
+    let pid = other.id() as i32;
+    let start = start_of(pid);
+    assert_ne!(start, 111);
+
+    // The frame shown when the person asks to force quit "Doomed".
+    apply(&ui, &frame(&[(pid, 111, "Doomed", 30.0), (900_001, 1, "Editor", 2.0)]));
+    assert!(ui.table.select(&format!("g{pid}:111")));
+    confirm_quit(&ui, true);
+    let dialog = ui
+        .window
+        .visible_dialog()
+        .and_downcast::<adw::AlertDialog>()
+        .expect("the Force Quit dialog");
+    assert_eq!(dialog.heading().as_deref(), Some("Quit “Doomed”?"));
+
+    // Doomed exits; PID P is now another of the person's processes.
+    apply(&ui, &frame(&[(pid, start, "sleep", 0.0), (900_001, 1, "Editor", 2.0)]));
+    settle_for(Duration::from_millis(50));
+
+    // The dialog is answered: Force Quit.
+    dialog.emit_by_name::<()>("response", &[&"force"]);
+    settle_for(Duration::from_millis(200));
+    let status = other.try_wait().unwrap();
+    if status.is_none() {
+        let _ = other.kill();
+    }
+    let _ = other.wait();
+    assert!(
+        status.is_none(),
+        "Force Quit for “Doomed” (PID {pid}, start 111) ended PID {pid}, now `sleep` \
+         (start {start}): {status:?}"
+    );
+}
