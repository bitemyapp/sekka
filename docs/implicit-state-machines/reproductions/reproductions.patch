+++ b/desktop/aizome/crates/aizome-comp/tests/repro_shb_09.rs
@@ -0,0 +1,69 @@
+//! SHB-09: the shell's compositor follower (aizome-shell/src/ipc.rs
+//! `connect`, private) snapshots with four requests, Outputs, Desks,
+//! Windows and FocusedWindow, then subscribes. A window mapped between the
+//! Windows answer and the subscription is in neither. The real compositor
+//! here (headless, the harness's), the follower's requests made in the same
+//! order on one connection, and a real Wayland client mapping its window in
+//! the gap. A desk added after subscribing marks how far the event stream
+//! has come.
+
+mod common;
+
+use std::time::Duration;
+
+use aizome_ipc::{Client, Event, Request, Response};
+use common::*;
+
+#[test]
+fn a_window_mapped_before_subscribing_reaches_the_follower() {
+    let c = Compositor::start(Options::default());
+    let mut follower = Client::connect_to(&c.ipc).expect("IPC connect");
+    follower.stream().set_read_timeout(Some(Duration::from_secs(10))).unwrap();
+    // The follower's snapshot, as `connect` takes it.
+    follower.call(&Request::Outputs).unwrap();
+    follower.call(&Request::Desks).unwrap();
+    let windows = match follower.call(&Request::Windows).unwrap() {
+        Response::Windows { windows } => windows,
+        r => panic!("{r:?}"),
+    };
+    follower.call(&Request::FocusedWindow).unwrap();
+
+    // An app maps its window now (autostart at login, or the compositor
+    // restarted and the shell is reconnecting).
+    let _app = c.client(Spec::new("repro.gap", 0x3366cc));
+    let gap = c.wait_window("repro.gap");
+    c.settle();
+
+    // Then the follower subscribes.
+    let mut events = follower.events().expect("subscribe");
+    // A marker after the subscription: the stream has got this far.
+    c.ok(Request::AddDesk { name: "repro-marker".into(), folder: None, index: None });
+    let mut seen = Vec::new();
+    let mut reached_marker = false;
+    for e in events.by_ref() {
+        let Ok(e) = e else { break };
+        let marker = matches!(&e, Event::DesksChanged { desks } if desks.iter().any(|d| d.name == "repro-marker"));
+        seen.push(e);
+        if marker {
+            reached_marker = true;
+            break;
+        }
+    }
+    assert!(reached_marker, "the marker desk's event never came: {seen:#?}");
+    let in_snapshot = windows.iter().any(|w| w.id == gap.id);
+    let in_events = seen.iter().any(|e| match e {
+        Event::WindowOpened { window } | Event::WindowChanged { window } => window.id == gap.id,
+        _ => false,
+    });
+    let kinds: Vec<String> =
+        seen.iter().map(|e| format!("{e:?}").split([' ', '{', '(']).next().unwrap_or_default().to_owned()).collect();
+    assert!(
+        in_snapshot || in_events,
+        "window {} ({}) is in neither the snapshot ({} windows) nor the events after Subscribe ({kinds:?}); \
+         the compositor lists it: {}",
+        gap.id,
+        gap.app_id,
+        windows.len(),
+        c.windows().iter().any(|w| w.id == gap.id)
+    );
+}
diff --git a/desktop/aizome/crates/aizome-comp/tests/repro_skb_11.rs b/desktop/aizome/crates/aizome-comp/tests/repro_skb_11.rs
new file mode 100644
index 00000000..41e3e9f6
--- /dev/null
+++ b/desktop/aizome/crates/aizome-comp/tests/repro_skb_11.rs
@@ -0,0 +1,154 @@
+//! SKB-11 (Sukumo backend): between a size-changing configure and the main
+//! thread's present, nothing may commit the new window geometry around the
+//! old content.
+//!
+//! smithay-client-toolkit acks each configure before Sukumo's handler runs,
+//! so the next commit of the frame answers it. After a configure with a new
+//! size the render thread marks the window held and waits for the main
+//! thread to draw (`backend/mod.rs:1577-1599`); the present then sets the
+//! geometry and draws the decorations with the content. But a hover change
+//! over Sukumo's own header (`decor.rs:833-843`, `:846-856`) calls
+//! `refresh_decor`, which goes on whenever the geometry differs from the
+//! expected one (`mod.rs:2008-2023`): it sets the new geometry and commits
+//! the frame around the old-size content buffer.
+//!
+//! The real compositor runs headless (`tests/common`); the client is
+//! `examples/repro_skb_11.rs`, a sidestep-ui window with Sukumo's header
+//! (`SIDESTEP_DECORATIONS=client`) whose main thread takes 2.5 s to draw a
+//! new size, and whose requests are logged (`WAYLAND_DEBUG=1`). The
+//! pointer rests on the header's close button; the compositor fills the
+//! window (a new size, as the maximize button asks); while the main thread
+//! is drawing, the pointer moves a little. Correct: no
+//! `xdg_surface.set_window_geometry` for the new size until the stall ends.
+//! The second test is the control: the same without a hover change.
+
+mod common;
+
+use std::path::{Path, PathBuf};
+use std::process::{Child, Command, Stdio};
+use std::time::{Duration, Instant};
+
+use aizome_ipc::{Request, Synthetic};
+use common::*;
+
+struct Program(Child);
+
+impl Drop for Program {
+    fn drop(&mut self) {
+        let _ = self.0.kill();
+        let _ = self.0.wait();
+    }
+}
+
+fn client_binary() -> PathBuf {
+    let exe = std::env::current_exe().unwrap();
+    exe.parent().unwrap().parent().unwrap().join("examples").join("repro_skb_11")
+}
+
+fn wait_file(path: &Path, what: &str, c: &Compositor, log: &Path) {
+    let deadline = Instant::now() + Duration::from_secs(15);
+    while !path.exists() {
+        assert!(
+            Instant::now() < deadline,
+            "{what} never came\nclient log tail:\n{}\ncompositor:\n{}",
+            tail(log),
+            c.log_text()
+        );
+        std::thread::sleep(Duration::from_millis(20));
+    }
+}
+
+fn tail(log: &Path) -> String {
+    let text = std::fs::read_to_string(log).unwrap_or_default();
+    let lines: Vec<&str> = text.lines().collect();
+    lines[lines.len().saturating_sub(40)..].join("\n")
+}
+
+/// The `set_window_geometry` requests the client sent while its main
+/// thread was drawing the new size, and the commits.
+fn during_stall(log: &Path) -> (Vec<String>, usize) {
+    let text = std::fs::read_to_string(log).unwrap();
+    let begin = text.find("REPRO stall begin").expect("the stall began");
+    let end = text[begin..].find("REPRO stall end").map_or(text.len(), |e| begin + e);
+    let stall = &text[begin..end];
+    let geometry = stall.lines().filter(|l| l.contains("set_window_geometry")).map(str::to_owned).collect();
+    let commits = stall.lines().filter(|l| l.contains("-> wl_surface") && l.contains(".commit()")).count();
+    (geometry, commits)
+}
+
+fn run(hover: bool) -> (Vec<String>, usize, PathBuf) {
+    let c = Compositor::start(Options::default());
+    let dir = c.dir.join(if hover { "hover" } else { "still" });
+    std::fs::create_dir_all(&dir).unwrap();
+    let log = dir.join("client.log");
+    let bin = client_binary();
+    assert!(bin.exists(), "build the example first: {}", bin.display());
+    let _p = Program(
+        Command::new(bin)
+            .env("WAYLAND_DISPLAY", &c.socket)
+            .env("XDG_RUNTIME_DIR", &c.dir)
+            .env("SIDESTEP_DECORATIONS", "client")
+            .env("WAYLAND_DEBUG", "1")
+            .env("REPRO_DIR", &dir)
+            .env_remove("DISPLAY")
+            .stdout(Stdio::null())
+            .stderr(std::fs::File::create(&log).unwrap())
+            .spawn()
+            .unwrap(),
+    );
+    let w = c.wait_window("org.aizome.repro-skb11");
+    let g = w.geometry;
+    eprintln!("mapped: {g:?}, client-side decorations: {}", w.client_side_decorations);
+    // Drawn: green under the header.
+    let deadline = Instant::now() + Duration::from_secs(10);
+    while !near(c.screenshot().px(g.x + g.w / 2, g.y + g.h - 10), [0x26, 0xa2, 0x69]) {
+        assert!(Instant::now() < deadline, "never drew\n{}", tail(&log));
+        std::thread::sleep(Duration::from_millis(50));
+    }
+    // The pointer on the header's close button (its centre is 23 points in
+    // from the right and down from the top), or well away from it.
+    let (x, y) = if hover { (g.x + g.w - 23, g.y + 23) } else { (g.x + g.w / 2, g.y + g.h - 20) };
+    c.ok(Request::Synthesize { events: vec![Synthetic::PointerMotion { x: x as f64, y: y as f64 }] });
+    c.settle();
+    // A new size (the zoom box; the maximize button asks the same).
+    c.ok(Request::Fill { id: Some(w.id), state: Some(true) });
+    wait_file(&dir.join("stalling"), "the draw at the new size", &c, &log);
+    if hover {
+        // The pointer moves a little while the main thread draws: off the
+        // button the header now thinks is elsewhere.
+        c.ok(Request::Synthesize { events: vec![Synthetic::PointerMotion { x: x as f64 - 3.0, y: y as f64 + 1.0 }] });
+    }
+    std::thread::sleep(Duration::from_millis(500));
+    let shot = c.screenshot();
+    let filled = c.window("org.aizome.repro-skb11").unwrap().geometry;
+    let probe = (filled.x + filled.w - 40, filled.y + filled.h - 40);
+    eprintln!("during the stall: filled to {filled:?}; pixel at {probe:?} (outside the old content) is {:?}", shot.px(probe.0, probe.1));
+    shot.save(&dir.join("during-stall.png"));
+    wait_file(&dir.join("stalled"), "the end of the stall", &c, &log);
+    std::thread::sleep(Duration::from_millis(300));
+    let (geometry, commits) = during_stall(&log);
+    let keep = std::env::temp_dir().join(format!("repro-skb-11-{}", if hover { "hover" } else { "still" }));
+    let _ = std::fs::create_dir_all(&keep);
+    let _ = std::fs::copy(&log, keep.join("client.log"));
+    let _ = std::fs::copy(dir.join("during-stall.png"), keep.join("during-stall.png"));
+    (geometry, commits, keep)
+}
+
+#[test]
+fn a_hover_change_before_the_present_doesnt_commit_the_new_size() {
+    let (geometry, commits, keep) = run(true);
+    eprintln!("during the stall: {commits} surface commits; geometry requests {geometry:#?}; logs in {}", keep.display());
+    assert!(
+        geometry.is_empty(),
+        "the new geometry was committed around the old content before the main thread presented: {geometry:?} \
+         ({commits} commits during the stall; see {})",
+        keep.display()
+    );
+}
+
+#[test]
+fn control_without_a_hover_change_the_new_size_waits_for_the_present() {
+    let (geometry, commits, keep) = run(false);
+    eprintln!("during the stall: {commits} surface commits; geometry requests {geometry:#?}; logs in {}", keep.display());
+    assert!(geometry.is_empty(), "{geometry:?}");
+}
diff --git a/desktop/aizome/crates/aizome-comp/tests/repro_wm_04.rs b/desktop/aizome/crates/aizome-comp/tests/repro_wm_04.rs
new file mode 100644
index 00000000..549589ad
--- /dev/null
+++ b/desktop/aizome/crates/aizome-comp/tests/repro_wm_04.rs
@@ -0,0 +1,242 @@
+//! WM-04: the left-edge resize anchor outlives its gesture.
+//!
+//! `start_resize` sets `resize_anchor` and nothing clears it, so after the
+//! window is moved, any commit whose size differs from the model's
+//! (a client resizing itself, a size it clamps to) puts the window's left
+//! edge back at `anchor.start.right() - width`: where the old resize's
+//! right edge was.
+//!
+//! The client here is a minimal one written for the test (the harness
+//! client always takes the size it's given): it obeys configures, and can
+//! grow by itself as a terminal changing its font does.
+
+mod common;
+
+use std::io::Write;
+use std::os::fd::{AsFd, FromRawFd, OwnedFd};
+use std::os::unix::net::UnixStream;
+use std::time::{Duration, Instant};
+
+use aizome_ipc::{Request, Synthetic, WindowInfo};
+use common::*;
+use wayland_client::globals::{GlobalListContents, registry_queue_init};
+use wayland_client::protocol::{wl_buffer, wl_compositor, wl_registry, wl_shm, wl_shm_pool, wl_surface};
+use wayland_client::{Connection, Dispatch, EventQueue, QueueHandle};
+use wayland_protocols::xdg::decoration::zv1::client::{zxdg_decoration_manager_v1, zxdg_toplevel_decoration_v1};
+use wayland_protocols::xdg::shell::client::{xdg_surface, xdg_toplevel, xdg_wm_base};
+
+#[derive(Default)]
+struct Heard {
+    /// The latest xdg_surface.configure not acked yet.
+    configure: Option<u32>,
+    /// The latest toplevel size asked.
+    asked: Option<(i32, i32)>,
+}
+
+struct Selfsizing {
+    queue: EventQueue<Heard>,
+    qh: QueueHandle<Heard>,
+    heard: Heard,
+    shm: wl_shm::WlShm,
+    surface: wl_surface::WlSurface,
+    xs: xdg_surface::XdgSurface,
+    _tl: xdg_toplevel::XdgToplevel,
+    _deco: zxdg_toplevel_decoration_v1::ZxdgToplevelDecorationV1,
+    size: (i32, i32),
+}
+
+impl Selfsizing {
+    fn open(c: &Compositor, app_id: &str, size: (i32, i32)) -> Selfsizing {
+        let conn = Connection::from_socket(UnixStream::connect(c.dir.join(&c.socket)).unwrap()).unwrap();
+        let (globals, queue) = registry_queue_init::<Heard>(&conn).unwrap();
+        let qh = queue.handle();
+        let compositor: wl_compositor::WlCompositor = globals.bind(&qh, 4..=6, ()).unwrap();
+        let shm: wl_shm::WlShm = globals.bind(&qh, 1..=1, ()).unwrap();
+        let wm: xdg_wm_base::XdgWmBase = globals.bind(&qh, 1..=6, ()).unwrap();
+        let deco_mgr: zxdg_decoration_manager_v1::ZxdgDecorationManagerV1 = globals.bind(&qh, 1..=1, ()).unwrap();
+        let surface = compositor.create_surface(&qh, ());
+        let xs = wm.get_xdg_surface(&surface, &qh, ());
+        let tl = xs.get_toplevel(&qh, ());
+        let deco = deco_mgr.get_toplevel_decoration(&tl, &qh, ());
+        deco.set_mode(zxdg_toplevel_decoration_v1::Mode::ServerSide);
+        tl.set_app_id(app_id.into());
+        tl.set_title(app_id.into());
+        surface.commit();
+        let mut s = Selfsizing { queue, qh, heard: Heard::default(), shm, surface, xs, _tl: tl, _deco: deco, size };
+        let deadline = Instant::now() + Duration::from_secs(10);
+        while s.heard.configure.is_none() {
+            s.queue.roundtrip(&mut s.heard).unwrap();
+            assert!(Instant::now() < deadline, "no first configure");
+        }
+        s.pump();
+        s
+    }
+
+    fn draw(&mut self, (w, h): (i32, i32)) {
+        // Safety: memfd_create with a static name.
+        let fd = unsafe { OwnedFd::from_raw_fd(libc::memfd_create(c"repro-wm-04".as_ptr(), 0)) };
+        let mut file = std::fs::File::from(fd);
+        file.write_all(&[0x22, 0x66, 0xcc, 0xff].repeat((w * h) as usize)).unwrap();
+        let pool = self.shm.create_pool(file.as_fd(), w * h * 4, &self.qh, ());
+        let b = pool.create_buffer(0, w, h, w * 4, wl_shm::Format::Argb8888, &self.qh, ());
+        pool.destroy();
+        self.surface.attach(Some(&b), 0, 0);
+        self.surface.damage_buffer(0, 0, w, h);
+        self.surface.commit();
+        self.size = (w, h);
+    }
+
+    /// Handles what came: acks the latest configure and draws its size.
+    fn pump(&mut self) {
+        self.queue.roundtrip(&mut self.heard).unwrap();
+        if let Some(serial) = self.heard.configure.take() {
+            self.xs.ack_configure(serial);
+            let size = self.heard.asked.filter(|s| s.0 > 0 && s.1 > 0).unwrap_or(self.size);
+            self.draw(size);
+            self.queue.roundtrip(&mut self.heard).unwrap();
+        }
+    }
+
+    /// Changes its own size, unasked.
+    fn grow_to(&mut self, size: (i32, i32)) {
+        self.draw(size);
+        self.queue.roundtrip(&mut self.heard).unwrap();
+    }
+}
+
+fn wait_geometry(c: &Compositor, client: &mut Selfsizing, what: &str, f: impl Fn(&WindowInfo) -> bool) -> WindowInfo {
+    let deadline = Instant::now() + Duration::from_secs(10);
+    loop {
+        client.pump();
+        if let Some(w) = c.window("org.example.Selfsizing")
+            && f(&w)
+        {
+            return w;
+        }
+        assert!(Instant::now() < deadline, "timed out waiting for {what}: {:?}", c.window("org.example.Selfsizing"));
+        std::thread::sleep(Duration::from_millis(20));
+    }
+}
+
+#[test]
+fn repro_wm_04_a_window_moved_after_a_left_edge_resize_stays_where_it_was_put() {
+    let c = Compositor::start(Options::default());
+    let mut client = Selfsizing::open(&c, "org.example.Selfsizing", (400, 300));
+    let g = wait_geometry(&c, &mut client, "the window", |w| w.geometry.w == 400).geometry;
+
+    // Wider by 100 from the left edge: the right edge stays put.
+    let left = ((g.x - 3) as f64, (g.y + 150) as f64);
+    c.ok(Request::Synthesize {
+        events: vec![
+            Synthetic::PointerMotion { x: left.0, y: left.1 },
+            Synthetic::PointerButton { button: "left".into(), pressed: true },
+            Synthetic::PointerMotion { x: left.0 - 100.0, y: left.1 },
+            Synthetic::PointerButton { button: "left".into(), pressed: false },
+        ],
+    });
+    let r = wait_geometry(&c, &mut client, "500 wide", |w| w.geometry.w == 500).geometry;
+    assert_eq!(r.x + r.w, g.x + g.w, "a left-edge resize keeps the right edge: {r:?} from {g:?}");
+
+    // Dragged elsewhere by its tab (the tab sits above the content's
+    // top-left corner).
+    let tab = ((r.x + 30) as f64, (r.y - 11) as f64);
+    c.ok(Request::Synthesize {
+        events: vec![
+            Synthetic::PointerMotion { x: tab.0, y: tab.1 },
+            Synthetic::PointerButton { button: "left".into(), pressed: true },
+            Synthetic::PointerMotion { x: tab.0 + 20.0, y: tab.1 + 10.0 },
+            Synthetic::PointerMotion { x: tab.0 + 200.0, y: tab.1 + 100.0 },
+            Synthetic::PointerButton { button: "left".into(), pressed: false },
+        ],
+    });
+    let moved = wait_geometry(&c, &mut client, "moved", |w| w.geometry.x != r.x).geometry;
+    c.settle();
+    let moved = c.window("org.example.Selfsizing").map(|w| w.geometry).unwrap_or(moved);
+    assert_eq!((moved.w, moved.h), (500, 300), "a move keeps the size: {moved:?}");
+
+    // The app grows by itself, 60 wider (as a terminal changing its font
+    // does): it grows where it is.
+    client.grow_to((560, 300));
+    let grown = wait_geometry(&c, &mut client, "560 wide", |w| w.geometry.w == 560).geometry;
+    assert_eq!(
+        (grown.x, grown.y),
+        (moved.x, moved.y),
+        "the window jumped when its app resized it: at {moved:?} after the move, then {grown:?}; the old resize's \
+         right edge was x = {}",
+        g.x + g.w
+    );
+}
+
+impl Dispatch<wl_registry::WlRegistry, GlobalListContents> for Heard {
+    fn event(
+        _: &mut Self,
+        _: &wl_registry::WlRegistry,
+        _: wl_registry::Event,
+        _: &GlobalListContents,
+        _: &Connection,
+        _: &QueueHandle<Self>,
+    ) {
+    }
+}
+
+macro_rules! ignore {
+    ($($t:ty),*) => {$(
+        impl Dispatch<$t, ()> for Heard {
+            fn event(_: &mut Self, _: &$t, _: <$t as wayland_client::Proxy>::Event, _: &(), _: &Connection, _: &QueueHandle<Self>) {}
+        }
+    )*};
+}
+ignore!(
+    wl_compositor::WlCompositor,
+    wl_shm::WlShm,
+    wl_shm_pool::WlShmPool,
+    wl_surface::WlSurface,
+    wl_buffer::WlBuffer,
+    zxdg_decoration_manager_v1::ZxdgDecorationManagerV1,
+    zxdg_toplevel_decoration_v1::ZxdgToplevelDecorationV1
+);
+
+impl Dispatch<xdg_wm_base::XdgWmBase, ()> for Heard {
+    fn event(
+        _: &mut Self,
+        wm: &xdg_wm_base::XdgWmBase,
+        event: xdg_wm_base::Event,
+        _: &(),
+        _: &Connection,
+        _: &QueueHandle<Self>,
+    ) {
+        if let xdg_wm_base::Event::Ping { serial } = event {
+            wm.pong(serial);
+        }
+    }
+}
+
+impl Dispatch<xdg_surface::XdgSurface, ()> for Heard {
+    fn event(
+        h: &mut Self,
+        _: &xdg_surface::XdgSurface,
+        event: xdg_surface::Event,
+        _: &(),
+        _: &Connection,
+        _: &QueueHandle<Self>,
+    ) {
+        if let xdg_surface::Event::Configure { serial } = event {
+            h.configure = Some(serial);
+        }
+    }
+}
+
+impl Dispatch<xdg_toplevel::XdgToplevel, ()> for Heard {
+    fn event(
+        h: &mut Self,
+        _: &xdg_toplevel::XdgToplevel,
+        event: xdg_toplevel::Event,
+        _: &(),
+        _: &Connection,
+        _: &QueueHandle<Self>,
+    ) {
+        if let xdg_toplevel::Event::Configure { width, height, .. } = event {
+            h.asked = Some((width, height));
+        }
+    }
+}
diff --git a/desktop/aizome/crates/aizome-comp/tests/repro_wm_10.rs b/desktop/aizome/crates/aizome-comp/tests/repro_wm_10.rs
new file mode 100644
index 00000000..3874534d
--- /dev/null
+++ b/desktop/aizome/crates/aizome-comp/tests/repro_wm_10.rs
@@ -0,0 +1,73 @@
+//! WM-10: with sticky keys, a latched modifier is pressed for the next key
+//! and let go with that key's release (`Access.applied`). If the logic is
+//! replaced (a reload) or sticky keys are turned off while that key is
+//! down, `applied` is dropped and the modifier is never released: every
+//! later key comes with it.
+//!
+//! Each test latches Ctrl, presses A, does the thing in the middle,
+//! releases A, then types B: B must come without Ctrl.
+
+mod common;
+
+use aizome_ipc::{Request, Response, Synthetic};
+use common::*;
+
+const CTRL: u32 = 4;
+const KEY_A: u32 = 30;
+const KEY_B: u32 = 48;
+
+fn key(c: &Compositor, k: &str, pressed: bool) {
+    c.ok(Request::Synthesize { events: vec![Synthetic::Key { key: k.into(), pressed }] });
+}
+
+fn tap(c: &Compositor, k: &str) {
+    key(c, k, true);
+    key(c, k, false);
+}
+
+/// Latches Ctrl, holds A, runs `middle`, lets A go, types B; returns the
+/// modifiers A and B came with.
+fn latched_chord_across(middle: impl FnOnce(&Compositor)) -> (u32, u32) {
+    let c = Compositor::start(Options { settings: "[input.keyboard]\nsticky_keys = true\n", ..Default::default() });
+    let a = c.client(Spec::new("org.example.editor", 0x2222cc));
+    c.wait_window("org.example.editor");
+    a.wait_seen("keyboard focus", |s| s.keyboard_focus);
+    tap(&c, "ctrl");
+    key(&c, "a", true);
+    a.wait_seen("a", |s| s.keys.iter().any(|(k, _)| *k == KEY_A));
+    middle(&c);
+    key(&c, "a", false);
+    tap(&c, "b");
+    let s = a.wait_seen("b", |s| s.keys.iter().any(|(k, _)| *k == KEY_B));
+    let mods = |k: u32| s.keys.iter().find(|(key, _)| *key == k).map(|(_, m)| *m).unwrap();
+    (mods(KEY_A), mods(KEY_B))
+}
+
+#[test]
+fn repro_wm_10_a_logic_reload_mid_chord_leaves_no_modifier_held() {
+    let (a, b) = latched_chord_across(|c| {
+        let report = match c.request(Request::Reload {
+            logic: true,
+            shell: false,
+            from: None,
+            shell_from: None,
+            check: false,
+        }) {
+            Response::Reload { report } => report,
+            r => panic!("{r:?}"),
+        };
+        assert_eq!(report.logic.action, "reloaded", "{report:?}");
+    });
+    assert_eq!(a & CTRL, CTRL, "the latched Ctrl came with A");
+    assert_eq!(b & CTRL, 0, "Ctrl stayed held after the reload: B came with modifiers {b:#x}");
+}
+
+#[test]
+fn repro_wm_10_turning_sticky_keys_off_mid_chord_leaves_no_modifier_held() {
+    let (a, b) = latched_chord_across(|c| {
+        std::fs::write(c.dir.join("config/aizome/settings.toml"), "[input.keyboard]\nsticky_keys = false\n").unwrap();
+        c.ok(Request::ReloadConfig);
+    });
+    assert_eq!(a & CTRL, CTRL, "the latched Ctrl came with A");
+    assert_eq!(b & CTRL, 0, "Ctrl stayed held after sticky keys went off: B came with modifiers {b:#x}");
+}
diff --git a/desktop/aizome/crates/aizome-comp/tests/repro_wm_12.rs b/desktop/aizome/crates/aizome-comp/tests/repro_wm_12.rs
new file mode 100644
index 00000000..22f34984
--- /dev/null
+++ b/desktop/aizome/crates/aizome-comp/tests/repro_wm_12.rs
@@ -0,0 +1,88 @@
+//! WM-12: a pick someone asked for over IPC (`pick-area`: the share
+//! picker, the shell's recording) must always end with an `area-picked`
+//! event. `close_all` (run by `quiesce`, on a logic reload and on Reset
+//! Input) drops the picker without one, so the asker waits for ever.
+
+mod common;
+
+use std::time::Duration;
+
+use aizome_ipc::{Event, Request, Response, Synthetic};
+use common::*;
+
+/// Starts a pick for `tag`, runs `interrupt`, and returns the first
+/// `area-picked` for it within 3 s (`Some(None)`: told nothing was
+/// picked), and whether a click afterwards picked something (the picker
+/// still up).
+fn pick_interrupted_by(interrupt: impl FnOnce(&Compositor)) -> (Option<Option<aizome_ipc::Rect>>, bool) {
+    let c = Compositor::start(Options::default());
+    let mut events = aizome_ipc::Client::connect_to(&c.ipc).unwrap().events().unwrap();
+    events.stream().set_read_timeout(Some(Duration::from_secs(3))).unwrap();
+    c.ok(Request::PickArea { tag: "share".into(), prompt: Some("Choose what to share".into()), targets: Vec::new() });
+    let started = events.by_ref().find_map(|e| match e {
+        Ok(Event::PickStarted { tag }) => Some(tag),
+        _ => None,
+    });
+    assert_eq!(started.as_deref(), Some("share"), "the pick started");
+    interrupt(&c);
+    let mut next = || {
+        events.by_ref().find_map(|e| match e {
+            Ok(Event::AreaPicked { tag, area, .. }) if tag == "share" => Some(area),
+            Ok(_) => None,
+            // The read timed out: nothing came.
+            Err(e) if matches!(e.kind(), std::io::ErrorKind::WouldBlock | std::io::ErrorKind::TimedOut) => {
+                Some(Some(aizome_ipc::Rect::new(-1, -1, -1, -1)))
+            }
+            Err(_) => None,
+        })
+    };
+    let timeout = Some(aizome_ipc::Rect::new(-1, -1, -1, -1));
+    let told = next().filter(|a| *a != timeout);
+    // Is the picker still up? A click would pick the display under it.
+    c.ok(Request::Synthesize {
+        events: vec![
+            Synthetic::PointerMotion { x: 300.0, y: 300.0 },
+            Synthetic::Click { button: "left".into() },
+        ],
+    });
+    let still_up = next().is_some_and(|a| a != timeout);
+    (told, still_up)
+}
+
+#[test]
+fn repro_wm_12_reset_input_tells_the_asker_its_pick_is_over() {
+    let (told, still_up) = pick_interrupted_by(|c| match c.request(Request::RecoveryAction {
+        action: "reset-input".into(),
+        app_id: None,
+    }) {
+        Response::Message { .. } => {}
+        r => panic!("reset-input: {r:?}"),
+    });
+    assert_eq!(
+        told,
+        Some(None),
+        "after Reset Input the asker heard nothing (picker still up and picking on a click: {still_up})"
+    );
+}
+
+#[test]
+fn repro_wm_12_a_logic_reload_tells_the_asker_its_pick_is_over() {
+    let (told, still_up) = pick_interrupted_by(|c| {
+        let report = match c.request(Request::Reload {
+            logic: true,
+            shell: false,
+            from: None,
+            shell_from: None,
+            check: false,
+        }) {
+            Response::Reload { report } => report,
+            r => panic!("{r:?}"),
+        };
+        assert_eq!(report.logic.action, "reloaded", "{report:?}");
+    });
+    assert_eq!(
+        told,
+        Some(None),
+        "after a logic reload the asker heard nothing (picker still up and picking on a click: {still_up})"
+    );
+}
diff --git a/desktop/aizome/crates/aizome-comp/tests/repro_wm_15.rs b/desktop/aizome/crates/aizome-comp/tests/repro_wm_15.rs
new file mode 100644
index 00000000..428f9df2
--- /dev/null
+++ b/desktop/aizome/crates/aizome-comp/tests/repro_wm_15.rs
@@ -0,0 +1,83 @@
+//! WM-15: the Desks overview is bound to the output it opened on and
+//! drawn only there; nothing closes or moves it when that output goes, yet
+//! it keeps taking every key. The test opens it on a laptop's panel beside
+//! an external display, closes the lid, and asserts that the overview is
+//! either drawn on the display that remains or gone (keys reach the
+//! window again).
+
+mod common;
+
+use std::time::{Duration, Instant};
+
+use aizome_ipc::{Request, Synthetic};
+use common::*;
+
+const KEY_B: u32 = 48;
+
+/// Pixels in an output's top band (where the overview's "Desks" heading,
+/// its summary and the filter field are; bare desktop otherwise, with no
+/// shell) that aren't the desktop's colour. The output is the image's
+/// first 1280 points.
+fn heading_pixels(img: &Image, desk: [u8; 3]) -> usize {
+    let mut n = 0;
+    for y in 30..75 {
+        for x in 40..1240.min(img.width as i32) {
+            if !near(img.px(x, y), desk) {
+                n += 1;
+            }
+        }
+    }
+    n
+}
+
+#[test]
+fn repro_wm_15_an_overview_whose_display_left_does_not_swallow_keys_unseen() {
+    let c = Compositor::start(Options { outputs: &["eDP-1=1280x800@1", "1280x800@1"], settings: "", ..Default::default() });
+    let a = c.client(Spec::new("org.example.editor", 0x2222cc));
+    c.wait_windows("on the panel", |ws| ws.first().is_some_and(|w| w.output.as_deref() == Some("eDP-1")));
+    a.wait_seen("keyboard focus", |s| s.keyboard_focus);
+    c.settle();
+    let plain = c.screenshot();
+    let desk = plain.px(4, 4);
+    let plain_band = heading_pixels(&plain, desk);
+
+    // The overview opens on the panel, the display with the focus.
+    c.ok(Request::Overview { state: Some(true) });
+    std::thread::sleep(Duration::from_millis(600));
+    let open_band = heading_pixels(&c.screenshot(), desk);
+    assert!(
+        plain_band < 50 && open_band > 300,
+        "the overview's heading shows on the panel: {plain_band} heading pixels before, {open_band} open"
+    );
+
+    // The lid closes: the panel leaves; the Desk moves to HEADLESS-2.
+    c.ok(Request::Synthesize { events: vec![Synthetic::Lid { closed: true }] });
+    c.wait_windows("the window on the external display", |ws| {
+        ws.first().is_some_and(|w| w.output.as_deref() == Some("HEADLESS-2"))
+    });
+    std::thread::sleep(Duration::from_millis(600));
+    let shot = c.screenshot();
+    keep(&shot, "repro-wm-15-after-lid");
+    let after_band = heading_pixels(&shot, desk);
+    let overview_shows = after_band > open_band / 2;
+
+    // A key typed now.
+    tap(&c, "b");
+    let deadline = Instant::now() + Duration::from_secs(3);
+    let mut got = false;
+    while Instant::now() < deadline && !got {
+        got = a.seen().keys.iter().any(|(k, _)| *k == KEY_B);
+        std::thread::sleep(Duration::from_millis(30));
+    }
+    let s = a.seen();
+    assert!(
+        got || overview_shows,
+        "the overview, drawn on no display (heading pixels: {open_band} while it showed on the panel, \
+         {after_band} on HEADLESS-2 now, a {}x{} layout), swallowed B: the window has keyboard focus {} and heard \
+         keys {:?}",
+        shot.width,
+        shot.height,
+        s.keyboard_focus,
+        s.keys
+    );
+}
diff --git a/desktop/aizome/crates/aizome-config/tests/repro_syc_01.rs b/desktop/aizome/crates/aizome-config/tests/repro_syc_01.rs
new file mode 100644
index 00000000..752bbdf7
--- /dev/null
+++ b/desktop/aizome/crates/aizome-config/tests/repro_syc_01.rs
@@ -0,0 +1,67 @@
+//! SYC-01: keyboard settings the person never chose stay the session's.
+//!
+//! Someone never opens keyboard settings, but collapses the Deskbar once:
+//! the shell saves its section (`Shell::save_section`, `shell.rs:1004-1015`:
+//! `set_shell_section("deskbar", …)` then `Settings::save()`). Later the
+//! administrator changes `services.xserver.xkb.layout`, which the session
+//! gets as `XKB_DEFAULT_LAYOUT` (`nix/module.nix:126`). The next session
+//! must follow it. At 8e0acbe5 the unrelated save wrote every `Keyboard`
+//! field, pinning the old layout.
+//!
+//! Each "session" is this test binary run again with its own environment
+//! (a private `XDG_CONFIG_HOME` under the temporary directory, and the
+//! session's `XKB_DEFAULT_*`), as `keyboard_defaults.rs` does.
+
+use aizome_config::Settings;
+use aizome_config::shell::DeskbarSettings;
+use std::process::Command;
+
+fn session(config: &std::path::Path, layout: &str, step: &str) {
+    let mut child = Command::new(std::env::current_exe().unwrap());
+    child.args(["--exact", "repro_syc_01_session", "--ignored", "--nocapture"]);
+    for name in ["LAYOUT", "VARIANT", "OPTIONS", "MODEL"] {
+        child.env_remove(format!("XKB_DEFAULT_{name}"));
+    }
+    child.env("XDG_CONFIG_HOME", config).env("XKB_DEFAULT_LAYOUT", layout).env("REPRO_SYC_01_STEP", step);
+    assert!(child.status().unwrap().success(), "session step {step} with XKB_DEFAULT_LAYOUT={layout}");
+}
+
+#[test]
+fn an_unrelated_save_does_not_pin_the_session_keyboard() {
+    let config = std::env::temp_dir().join(format!("repro-syc-01-{}", std::process::id()));
+    let _ = std::fs::remove_dir_all(&config);
+    std::fs::create_dir_all(&config).unwrap();
+    // Session 1: the system layout is US; the person collapses the Deskbar.
+    session(&config, "us", "collapse-deskbar");
+    let saved = std::fs::read_to_string(config.join("aizome/settings.toml")).unwrap();
+    eprintln!("settings.toml after collapsing the Deskbar:\n{saved}");
+    // Session 2: the administrator made it German.
+    session(&config, "de", "check-layout");
+    std::fs::remove_dir_all(&config).unwrap();
+}
+
+#[test]
+#[ignore = "run in a subprocess by an_unrelated_save_does_not_pin_the_session_keyboard"]
+fn repro_syc_01_session() {
+    match std::env::var("REPRO_SYC_01_STEP").unwrap().as_str() {
+        "collapse-deskbar" => {
+            // What the shell does: it loaded the settings at start
+            // (`Shell::new`), then saves a section (`save_section`).
+            let mut settings = Settings::load_or_default();
+            assert_eq!(settings.input.keyboard.layouts, ["us"]);
+            let deskbar = DeskbarSettings { collapsed: true, ..DeskbarSettings::default() };
+            settings.set_shell_section("deskbar", &deskbar);
+            settings.save().unwrap();
+        }
+        "check-layout" => {
+            let settings = Settings::load_or_default();
+            assert_eq!(
+                settings.input.keyboard.layouts,
+                ["de"],
+                "the session's XKB_DEFAULT_LAYOUT=de is ignored: the Deskbar save pinned {:?}",
+                settings.input.keyboard.layouts
+            );
+        }
+        other => panic!("unknown step {other}"),
+    }
+}
diff --git a/desktop/aizome/crates/aizome-config/tests/repro_syc_02.rs b/desktop/aizome/crates/aizome-config/tests/repro_syc_02.rs
new file mode 100644
index 00000000..8ad1b2e0
--- /dev/null
+++ b/desktop/aizome/crates/aizome-config/tests/repro_syc_02.rs
@@ -0,0 +1,62 @@
+//! SYC-02: the legacy `[keys] terminal` choice survives until Aizome has
+//! moved the default terminal (`move_to_hotaru_once`, which retries "next
+//! session" when it fails, `aizome-comp-core/src/terminal.rs:76-81`).
+//!
+//! At 8e0acbe5 `Keys::legacy_terminal` is `skip_serializing`, so any save
+//! by any process (here the shell's Deskbar save, `save_section`) drops the
+//! key before a successful migration has written its marker: the retry
+//! reads `None` and ❖Return starts Hotaru, not the person's terminal.
+
+use aizome_config::Settings;
+use aizome_config::shell::DeskbarSettings;
+use std::process::Command;
+
+const BEFORE: &str = "[keys]\nterminal = [\"kitty\", \"--single-instance\"]\n\n[deskbar]\ncollapsed = false\n";
+
+fn session(config: &std::path::Path, step: &str) {
+    let mut child = Command::new(std::env::current_exe().unwrap());
+    child.args(["--exact", "repro_syc_02_session", "--ignored", "--nocapture"]);
+    child.env("XDG_CONFIG_HOME", config).env("REPRO_SYC_02_STEP", step);
+    assert!(child.status().unwrap().success(), "session step {step}");
+}
+
+#[test]
+fn the_legacy_terminal_survives_a_save_before_the_migration() {
+    let config = std::env::temp_dir().join(format!("repro-syc-02-{}", std::process::id()));
+    let _ = std::fs::remove_dir_all(&config);
+    std::fs::create_dir_all(config.join("aizome")).unwrap();
+    std::fs::write(config.join("aizome/settings.toml"), BEFORE).unwrap();
+    // First session after the upgrade: the compositor captured the key at
+    // start (`session.rs:176`) and its migration failed (no marker); the
+    // shell saves a section during the session.
+    session(&config, "first-session");
+    let after = std::fs::read_to_string(config.join("aizome/settings.toml")).unwrap();
+    eprintln!("settings.toml after the shell's save:\n{after}");
+    // Next session: the compositor reads the key again to retry.
+    session(&config, "next-session");
+    std::fs::remove_dir_all(&config).unwrap();
+}
+
+#[test]
+#[ignore = "run in a subprocess by the_legacy_terminal_survives_a_save_before_the_migration"]
+fn repro_syc_02_session() {
+    let want = Some(vec!["kitty".to_owned(), "--single-instance".to_owned()]);
+    match std::env::var("REPRO_SYC_02_STEP").unwrap().as_str() {
+        "first-session" => {
+            let mut settings = Settings::load_or_default();
+            assert_eq!(settings.keys.legacy_terminal, want, "the compositor's start reads the old choice");
+            settings.set_shell_section("deskbar", &DeskbarSettings { collapsed: true, ..DeskbarSettings::default() });
+            settings.save().unwrap();
+        }
+        "next-session" => {
+            let settings = Settings::load_or_default();
+            assert_eq!(
+                settings.keys.legacy_terminal,
+                want,
+                "the retry of the failed migration gets {:?}: the shell's Deskbar save dropped `[keys] terminal`",
+                settings.keys.legacy_terminal
+            );
+        }
+        other => panic!("unknown step {other}"),
+    }
+}
diff --git a/desktop/aizome/crates/aizome-config/tests/repro_syc_03.rs b/desktop/aizome/crates/aizome-config/tests/repro_syc_03.rs
new file mode 100644
index 00000000..c1dbd797
--- /dev/null
+++ b/desktop/aizome/crates/aizome-config/tests/repro_syc_03.rs
@@ -0,0 +1,182 @@
+//! SYC-03: the settings file's lifecycle across processes.
+//!
+//! 1. A hand edit with one typo: the shell's watcher reloads with
+//!    `Settings::load_or_default()` (`shell.rs:1273`), which turns the parse
+//!    error into the defaults; the next Deskbar change saves those defaults
+//!    over every other setting (`save_section`, `shell.rs:1004-1015`).
+//!    Correct: the person's other settings (or the broken file) survive.
+//! 2. Two writers through the one fixed temporary file `settings.toml.tmp`
+//!    (`Settings::save_to`, `lib.rs:691`; Settei's `write_atomically`,
+//!    `apps/settei/src/shared.rs:252-259`, is the same code): one truncates
+//!    the other's temporary file, a rename publishes the wrong text and the
+//!    other's rename fails. Correct: each save either lands whole or not at
+//!    all, and the file always parses.
+//!
+//! Each part runs in a subprocess with its own `XDG_CONFIG_HOME` under the
+//! temporary directory (never the real `~/.config/aizome`).
+
+use std::io::Write;
+use std::path::{Path, PathBuf};
+use std::process::Command;
+
+use aizome_config::Settings;
+use aizome_config::shell::DeskbarSettings;
+
+fn dir(name: &str) -> PathBuf {
+    let d = std::env::temp_dir().join(format!("repro-syc-03-{name}-{}", std::process::id()));
+    let _ = std::fs::remove_dir_all(&d);
+    std::fs::create_dir_all(d.join("aizome")).unwrap();
+    d
+}
+
+fn child(test: &str, config: &Path) {
+    let mut c = Command::new(std::env::current_exe().unwrap());
+    c.args(["--exact", test, "--ignored", "--nocapture"]).env("XDG_CONFIG_HOME", config);
+    assert!(c.status().unwrap().success(), "{test}");
+}
+
+const PERSONAL: &str = "\
+[appearance]
+effects = \"austere\"
+
+[keys]
+command_key_for_all_apps = false
+
+[keys.bindings]
+\"Ctrl+Super+Up\" = \"overview\"
+
+[deskbar]
+pinned = [\"org.aizome.Hotaru\", \"org.aizome.Kura\"]
+";
+
+#[test]
+fn a_typo_then_a_deskbar_change_keeps_the_persons_settings() {
+    let config = dir("typo");
+    child("repro_syc_03_typo_child", &config);
+    std::fs::remove_dir_all(&config).unwrap();
+}
+
+#[test]
+#[ignore = "run in a subprocess"]
+fn repro_syc_03_typo_child() {
+    let path = Settings::path();
+    std::fs::write(&path, PERSONAL).unwrap();
+    // The shell's copy, from its start.
+    let mut shell = Settings::load_or_default();
+    assert_eq!(shell.keys.bindings.get("Ctrl+Super+Up").map(String::as_str), Some("overview"));
+    // A hand edit with a typo (an unquoted string); the watcher fires and
+    // the shell reloads (`reload_settings`).
+    std::fs::write(&path, PERSONAL.replace("effects = \"austere\"", "effects = austere")).unwrap();
+    assert!(Settings::load().is_err(), "the edit doesn't parse");
+    shell = Settings::load_or_default();
+    // The next Deskbar change.
+    shell.set_shell_section("deskbar", &DeskbarSettings { collapsed: true, ..DeskbarSettings::default() });
+    shell.save().unwrap();
+    let after = std::fs::read_to_string(&path).unwrap();
+    eprintln!("settings.toml after the Deskbar change:\n{after}");
+    assert!(
+        after.contains("Ctrl+Super+Up") && after.contains("org.aizome.Kura"),
+        "the person's bindings and pinned apps were replaced by the defaults (see above)"
+    );
+}
+
+/// Settings that differ from the defaults by `n` long pinned app ids, so
+/// their TOML is `n` lines longer.
+fn with_pins(n: usize, tag: &str) -> Settings {
+    let mut s = Settings::default();
+    let pinned: Vec<String> = (0..n).map(|i| format!("org.example.{tag}.App{i:04}")).collect();
+    s.set_shell_section("deskbar", &DeskbarSettings { pinned, ..DeskbarSettings::default() });
+    s
+}
+
+#[test]
+fn two_writers_never_publish_a_torn_file() {
+    let config = dir("shared-tmp");
+    child("repro_syc_03_interleaved_child", &config);
+    std::fs::remove_dir_all(&config).unwrap();
+}
+
+#[test]
+#[ignore = "run in a subprocess"]
+fn repro_syc_03_interleaved_child() {
+    // One interleaving, step by step. Settei's `write_atomically` is
+    // `std::fs::write(tmp, text)` (open with O_TRUNC, then write) and
+    // `rename(tmp, path)`; the shell's save, between Settei's open and its
+    // write, is the real `Settings::save_to`.
+    let path = Settings::path();
+    let tmp = path.with_extension("toml.tmp");
+    let settei = with_pins(3, "settei");
+    let shell = with_pins(40, "shell");
+    let settei_text = settei.to_toml().unwrap();
+    assert_eq!(Settings::from_toml(&settei_text).unwrap(), settei, "each save alone reads back as itself");
+    assert_eq!(Settings::from_toml(&shell.to_toml().unwrap()).unwrap(), shell);
+    let mut settei_file = std::fs::File::create(&tmp).unwrap();
+    shell.save_to(&path).unwrap();
+    settei_file.write_all(settei_text.as_bytes()).unwrap();
+    drop(settei_file);
+    let settei_rename = std::fs::rename(&tmp, &path);
+    let published = std::fs::read_to_string(&path).unwrap();
+    let parsed = Settings::from_toml(&published);
+    eprintln!(
+        "Settei's rename: {settei_rename:?}; the published file ({} bytes) parses: {}",
+        published.len(),
+        parsed.is_ok()
+    );
+    let whole = parsed.as_ref().is_ok_and(|s| *s == settei || *s == shell);
+    assert!(
+        settei_rename.is_ok() && whole,
+        "a torn save: Settei's rename {settei_rename:?}; published text is neither save whole ({:?}):\n{}",
+        parsed.err(),
+        &published[..published.len().min(600)]
+    );
+}
+
+#[test]
+fn two_real_savers_racing() {
+    let config = dir("race");
+    child("repro_syc_03_race_child", &config);
+    std::fs::remove_dir_all(&config).unwrap();
+}
+
+#[test]
+#[ignore = "run in a subprocess"]
+fn repro_syc_03_race_child() {
+    // The same race with no stand-in: two processes' worth of
+    // `Settings::save_to` (the shell, Settei, the compositor's and the
+    // greeter's writers all use this path) on two threads, and a reader
+    // (a watcher's reload) on a third.
+    let path = Settings::path();
+    let a = with_pins(3, "a");
+    let b = with_pins(60, "b");
+    // Alone, each save reads back as itself.
+    b.save_to(&path).unwrap();
+    assert_eq!(Settings::load_from(&path).unwrap(), b);
+    a.save_to(&path).unwrap();
+    assert_eq!(Settings::load_from(&path).unwrap(), a);
+    let stop = std::sync::Arc::new(std::sync::atomic::AtomicBool::new(false));
+    let reader = {
+        let (path, stop, a, b) = (path.clone(), stop.clone(), a.clone(), b.clone());
+        std::thread::spawn(move || {
+            let mut torn = 0;
+            while !stop.load(std::sync::atomic::Ordering::Relaxed) {
+                if let Ok(text) = std::fs::read_to_string(&path) {
+                    match Settings::from_toml(&text) {
+                        Ok(s) if s == a || s == b => {}
+                        _ => torn += 1,
+                    }
+                }
+            }
+            torn
+        })
+    };
+    let writer = |s: Settings| {
+        let path = path.clone();
+        std::thread::spawn(move || (0..2000).filter(|_| s.save_to(&path).is_err()).count())
+    };
+    let (wa, wb) = (writer(a), writer(b));
+    let failed = wa.join().unwrap() + wb.join().unwrap();
+    stop.store(true, std::sync::atomic::Ordering::Relaxed);
+    let torn = reader.join().unwrap();
+    eprintln!("4000 saves: {failed} failed; reads that saw neither save whole: {torn}");
+    assert_eq!((failed, torn), (0, 0), "saves failed (ENOENT on rename) or a torn or foreign file was published");
+}
diff --git a/desktop/aizome/crates/aizome-face/tests/repro_syc_06.rs b/desktop/aizome/crates/aizome-face/tests/repro_syc_06.rs
new file mode 100644
index 00000000..a3757fc2
--- /dev/null
+++ b/desktop/aizome/crates/aizome-face/tests/repro_syc_06.rs
@@ -0,0 +1,143 @@
+//! SYC-06: a drag the compositor takes over ends for its consumer.
+//!
+//! The desktop's rubber band (`aizome-shell/src/desktop.rs:277`,
+//! `.on_drag(DesktopMsg::Band)`) sets `desktop.band` on `Start` and clears
+//! it only on `End` (`desktop_glue.rs:224-233`); the Deskbar's app drag
+//! holds the Deskbar open the same way (`deskbar_glue.rs:369-377`); the
+//! Deskbar's edge keeps `deskbar_resize` (`deskbar_glue.rs:510-535`).
+//! When the compositor takes the pointer before the release and it comes
+//! back with no button down, the consumer must hear that the drag is over.
+//!
+//! Two cases. The band (not drag-only): the kit keeps the press through
+//! the leave (it lets go only of drag-only presses, `engine.rs:2065-2072`),
+//! so the drag goes on, `Move` after `Move`, with no button down, until
+//! the next click. The edge (drag-only): the kit lets go, and Drawn resets
+//! its state at the next move (`drawn.rs:374-377`) with no `End` (there is
+//! no cancel phase). Either way the consumer is left mid-drag.
+//!
+//! The programs below are the shell's consumers, verbatim in their drag
+//! logic, over the real `drawn` element in the kit's headless harness.
+
+use aizome_face::widgets::drawn::{DragPhase, drawn};
+use aizome_kit::prelude::{AppInfo, Cx, Element, Point, Program, Vec2, WindowKey, WindowSpec};
+use aizome_kit::sidestep_ui::PointerButton;
+use aizome_kit::testing::Harness;
+
+#[derive(Default)]
+struct Desktop {
+    /// `DesktopState::band`: the rubber band's corners while dragging.
+    band: Option<(Point, Point)>,
+    phases: Vec<DragPhase>,
+}
+
+#[derive(Clone)]
+enum M {
+    Band(DragPhase),
+}
+
+impl Program for Desktop {
+    type Msg = M;
+    fn info(&self) -> AppInfo {
+        AppInfo::new("org.aizome.ReproSyc06", "Band", "Test")
+    }
+    fn launched(&mut self, cx: &mut Cx<M>) {
+        cx.open_window(WindowSpec::new("Desktop").size(400.0, 300.0));
+    }
+    fn update(&mut self, m: M, _: &mut Cx<M>) {
+        let M::Band(phase) = m;
+        self.phases.push(phase);
+        // desktop_glue.rs:224-233.
+        match phase {
+            DragPhase::Start(p) => self.band = Some((p, p)),
+            DragPhase::Move(p) => {
+                if let Some((a, _)) = self.band {
+                    self.band = Some((a, p));
+                }
+            }
+            DragPhase::End(_) => self.band = None,
+        }
+    }
+    fn view(&self, _: WindowKey) -> Element<M> {
+        drawn(400.0, 300.0, "ground", |_| {}).on_drag(M::Band).into()
+    }
+}
+
+#[test]
+fn a_band_drag_the_compositor_took_is_over_when_the_pointer_returns() {
+    let mut h = Harness::new(Desktop::default());
+    let w = h.window();
+    let at = Point::new(50.0, 50.0);
+    h.enter(w, at);
+    h.press(w, at, PointerButton::Left, 1);
+    h.move_to(w, at + Vec2::new(60.0, 40.0));
+    assert!(h.program().band.is_some(), "dragging a band: {:?}", h.program().phases);
+    // The compositor takes the pointer with the button down (a grab, a
+    // drag-and-drop, the overview); the release goes elsewhere.
+    h.leave(w);
+    // The pointer comes back, no button down.
+    h.enter(w, Point::new(200.0, 200.0));
+    h.move_to(w, Point::new(210.0, 200.0));
+    assert_eq!(
+        h.program().band,
+        None,
+        "the band is still drawn after the pointer came back with no button down; phases heard: {:?}",
+        h.program().phases
+    );
+}
+
+/// The Deskbar's inner edge (`deskbar.rs:529-545`): a drag-only element
+/// whose consumer keeps `deskbar_resize` from `Start` to `End`
+/// (`deskbar_glue.rs:510-535`). The kit lets go of a drag-only press when
+/// the pointer leaves (`engine.rs:2065-2072`), and Drawn then resets its
+/// state at the next move (`drawn.rs:374-377`) without a phase.
+#[derive(Default)]
+struct Edge {
+    resizing: Option<f64>,
+    phases: Vec<DragPhase>,
+}
+
+impl Program for Edge {
+    type Msg = M;
+    fn info(&self) -> AppInfo {
+        AppInfo::new("org.aizome.ReproSyc06Edge", "Edge", "Test")
+    }
+    fn launched(&mut self, cx: &mut Cx<M>) {
+        cx.open_window(WindowSpec::new("Deskbar").size(200.0, 300.0));
+    }
+    fn update(&mut self, m: M, _: &mut Cx<M>) {
+        let M::Band(phase) = m;
+        self.phases.push(phase);
+        match phase {
+            DragPhase::Start(p) => self.resizing = Some(p.x),
+            DragPhase::Move(_) => {}
+            DragPhase::End(_) => self.resizing = None,
+        }
+    }
+    fn view(&self, _: WindowKey) -> Element<M> {
+        aizome_kit::stack(vec![
+            drawn(200.0, 300.0, "rows", |_| {}).into(),
+            drawn(6.0, 300.0, "edge", |_| {}).on_drag(M::Band).drags_only().into(),
+        ])
+        .into()
+    }
+}
+
+#[test]
+fn a_drag_only_edge_drag_the_compositor_took_is_over_when_the_pointer_returns() {
+    let mut h = Harness::new(Edge::default());
+    let w = h.window();
+    let at = Point::new(3.0, 100.0);
+    h.enter(w, at);
+    h.press(w, at, PointerButton::Left, 1);
+    h.move_to(w, at + Vec2::new(30.0, 0.0));
+    assert!(h.program().resizing.is_some(), "resizing: {:?}", h.program().phases);
+    h.leave(w);
+    h.enter(w, at);
+    h.move_to(w, at + Vec2::new(2.0, 0.0));
+    assert_eq!(
+        h.program().resizing,
+        None,
+        "the resize is still under way: Drawn reset its press without a phase; phases heard: {:?}",
+        h.program().phases
+    );
+}
diff --git a/desktop/aizome/crates/aizome-face/tests/repro_syc_07.rs b/desktop/aizome/crates/aizome-face/tests/repro_syc_07.rs
new file mode 100644
index 00000000..8f21fca2
--- /dev/null
+++ b/desktop/aizome/crates/aizome-face/tests/repro_syc_07.rs
@@ -0,0 +1,80 @@
+//! SYC-07: a password field must not show what an input method is
+//! composing in it.
+//!
+//! The lock screen (`aizome-shell/src/lock.rs:236-244`), the polkit dialog
+//! and the greeter use `field(..).secure()`. In secure mode the value is
+//! drawn as dots, but `paint` appends the IME preedit unmasked
+//! (`field.rs:223`, `all = shown(value) + preedit`). The test renders, in
+//! the kit's headless harness, the lock screen's field holding "pa" while
+//! an input method composes "WW", and the same field style showing the
+//! plain text "••WW". Correct: the two differ (the composed characters are
+//! masked or hidden). At 8e0acbe5 they are pixel for pixel the same.
+
+use aizome_face::look;
+use aizome_face::widgets::field::field;
+use aizome_kit::prelude::{AppInfo, Cx, Element, Point, Program, WindowKey, WindowSpec};
+use aizome_kit::testing::Harness;
+use aizome_theme::typeface;
+
+struct Probe {
+    value: String,
+    secure: bool,
+}
+
+#[derive(Clone)]
+enum M {
+    Changed(String),
+}
+
+impl Program for Probe {
+    type Msg = M;
+    fn info(&self) -> AppInfo {
+        AppInfo::new("org.aizome.ReproSyc07", "Field", "Test")
+    }
+    fn launched(&mut self, cx: &mut Cx<M>) {
+        cx.open_window(WindowSpec::new("Password").size(240.0, 40.0));
+    }
+    fn update(&mut self, m: M, _: &mut Cx<M>) {
+        let M::Changed(v) = m;
+        self.value = v;
+    }
+    fn view(&self, _: WindowKey) -> Element<M> {
+        // The lock screen's field (lock.rs:236-244), less its box.
+        let f = field(&self.value, |_| {
+            look::ui(15.0, typeface::WEIGHT_REGULAR, aizome_kit::theme::color(aizome_theme::NIGHT.text))
+        })
+        .placeholder("Password")
+        .height(32.0)
+        .on_change(M::Changed);
+        let f = if self.secure { f.secure() } else { f };
+        Element::from(f)
+    }
+}
+
+/// A focused field showing `value` (secure or not), an input method
+/// composing `preedit` in it; its pixels at 2×.
+fn shown(value: &str, secure: bool, preedit: &str) -> (u32, u32, Vec<u8>) {
+    let mut h = Harness::new(Probe { value: value.to_owned(), secure });
+    let w = h.window();
+    h.focus_window(w, true);
+    h.click(w, Point::new(120.0, 16.0));
+    h.ime(w, None, preedit);
+    h.render_rgba(w, 2.0)
+}
+
+#[test]
+fn a_password_field_hides_the_text_being_composed() {
+    let composing = shown("pa", true, "WW");
+    let in_clear = shown("••WW", false, "");
+    let dots_only = shown("pa", true, "");
+    assert_eq!((composing.0, composing.1), (in_clear.0, in_clear.1));
+    let differ = |a: &[u8], b: &[u8]| a.chunks(4).zip(b.chunks(4)).filter(|(x, y)| x != y).count();
+    let vs_clear = differ(&composing.2, &in_clear.2);
+    let vs_dots = differ(&composing.2, &dots_only.2);
+    eprintln!("pixels differing from the clear-text field: {vs_clear}; from the field with no preedit: {vs_dots}");
+    assert!(vs_dots > 0, "the preedit shows somehow");
+    assert!(
+        vs_clear > 0,
+        "the secure field composing \"WW\" draws exactly what a plain field showing \"••WW\" draws: the composed text is in clear"
+    );
+}
diff --git a/desktop/aizome/crates/aizome-greeter/tests/repro_svc_05.rs b/desktop/aizome/crates/aizome-greeter/tests/repro_svc_05.rs
new file mode 100644
index 00000000..ac790f7e
--- /dev/null
+++ b/desktop/aizome/crates/aizome-greeter/tests/repro_svc_05.rs
@@ -0,0 +1,225 @@
+//! SVC-05: with no list of people (`user_list = false`, or nobody listed)
+//! the user name is typed (`Stage::Name`); a mistyped name must be
+//! correctable without restarting the greeter.
+//!
+//! The greeter runs live (`live = true`), so its own link thread connects
+//! to `$GREETD_SOCK` (`app.rs:440-481`); the socket is a fake greetd in
+//! this process, under the test's private runtime directory, answering
+//! from a script and recording what it was asked. Never real greetd.
+//!
+//! 1. PAM rejects the password: the login begins again for the same name
+//!    (`login.rs:182-183`), and the typed-name password view offers no way
+//!    back to the name (no Escape, no "Log in as someone else",
+//!    `view.rs:279`, `view.rs:297`).
+//! 2. `CreateSession` itself fails: the step is `Failed` and the field says
+//!    "Press Return to try again", but Return calls `begin`, which needs
+//!    `user()` and does nothing in the `Name` stage (`app.rs:194-199`,
+//!    `app.rs:242-248`, `app.rs:259`).
+//!
+//! Each scenario runs in a subprocess so that `GREETD_SOCK` is set before
+//! anything starts.
+
+use std::os::unix::net::UnixListener;
+use std::path::PathBuf;
+use std::process::Command;
+use std::sync::{Arc, Mutex};
+use std::time::Duration;
+
+use aizome_greeter::app::{Greeter, Stage};
+use aizome_greeter::config::{Config, State};
+use aizome_greeter::greetd::{AuthMessageType, ErrorType, Request, Response, read_msg, write_msg};
+use aizome_greeter::login::Step;
+use aizome_greeter::sessions::{Kind, Session};
+use aizome_kit::prelude::*;
+use aizome_kit::sidestep_ui::{Modifiers, NamedKey};
+use aizome_kit::testing::Harness;
+
+const W: f64 = 1440.0;
+const H: f64 = 900.0;
+
+fn scratch(name: &str) -> PathBuf {
+    let base = std::env::var_os("XDG_RUNTIME_DIR").map(PathBuf::from).unwrap_or_else(std::env::temp_dir);
+    let d = base.join(format!("svc05-{name}-{}", std::process::id()));
+    let _ = std::fs::remove_dir_all(&d);
+    std::fs::create_dir_all(&d).unwrap();
+    d
+}
+
+fn run_child(scenario: &str) {
+    let dir = scratch(scenario);
+    let mut c = Command::new(std::env::current_exe().unwrap());
+    c.args(["--exact", "repro_svc_05_child", "--ignored", "--nocapture"])
+        .env("GREETD_SOCK", dir.join("greetd.sock"))
+        .env("REPRO_SVC_05_DIR", &dir)
+        .env("REPRO_SVC_05_SCENARIO", scenario);
+    let ok = c.status().unwrap().success();
+    let _ = std::fs::remove_dir_all(&dir);
+    assert!(ok, "scenario {scenario}");
+}
+
+#[test]
+fn a_rejected_password_for_a_mistyped_name_lets_the_name_be_typed_again() {
+    run_child("auth-error");
+}
+
+#[test]
+fn a_session_that_cant_be_created_can_be_tried_again() {
+    run_child("create-fails");
+}
+
+type Log = Arc<Mutex<Vec<Request>>>;
+
+/// A greetd that answers `script` and records each request.
+fn fake_greetd(path: PathBuf, mut script: impl FnMut(&Request) -> Response + Send + 'static) -> Log {
+    let listener = UnixListener::bind(&path).unwrap();
+    let log: Log = Arc::default();
+    let seen = log.clone();
+    std::thread::spawn(move || {
+        let (mut s, _) = listener.accept().unwrap();
+        while let Ok(r) = read_msg::<Request>(&mut s) {
+            let answer = script(&r);
+            seen.lock().unwrap().push(r);
+            if write_msg(&mut s, &answer).is_err() {
+                return;
+            }
+        }
+    });
+    log
+}
+
+fn greeter(dir: &std::path::Path) -> Harness<Greeter> {
+    let cfg = Config {
+        user_list: false,
+        default_session: Some("aizome".into()),
+        power: false,
+        state: dir.join("state.toml"),
+        ..Config::default()
+    };
+    let session = Session {
+        id: "aizome".into(),
+        name: "Aizome".into(),
+        comment: String::new(),
+        exec: vec!["aizome-session".into()],
+        desktop_names: vec!["Aizome".into()],
+        kind: Kind::Wayland,
+        path: PathBuf::from("/s/aizome.desktop"),
+    };
+    // Live: the link thread talks to $GREETD_SOCK (the fake).
+    let g = Greeter::with(cfg, State::default(), Vec::new(), vec![session], "ganymede".into(), true, false);
+    let mut h = Harness::new(g);
+    h.set_outputs(vec![aizome_kit::Output {
+        id: 1,
+        name: "eDP-1".into(),
+        connector: Some("eDP-1".into()),
+        description: None,
+        make: "SDC".into(),
+        model: "Panel".into(),
+        frame: Rect::new(0.0, 0.0, W, H),
+        scale: 1.0,
+        integer_scale: 1,
+        physical_size: None,
+        refresh_hz: 60.0,
+        work_area: None,
+    }]);
+    for k in h.windows() {
+        h.resize(k, Size::new(W, H));
+    }
+    h
+}
+
+fn wait(h: &mut Harness<Greeter>, what: &str, f: impl Fn(&Greeter) -> bool) {
+    assert!(h.settle(Duration::from_secs(5), f), "waiting for {what}: step {:?}", h.program().login.step);
+}
+
+fn enter(h: &mut Harness<Greeter>, w: WindowKey) {
+    h.named(w, NamedKey::Enter, Modifiers::NONE);
+}
+
+fn click_id(h: &mut Harness<Greeter>, w: WindowKey, id: &str) {
+    let r = h.find_id(w, id).unwrap_or_else(|| panic!("no {id} showing: {:?}", h.texts(w)));
+    h.click(w, Point::new((r.x0 + r.x1) / 2.0, (r.y0 + r.y1) / 2.0));
+}
+
+fn secret() -> Response {
+    Response::AuthMessage { auth_message_type: AuthMessageType::Secret, auth_message: "Password: ".into() }
+}
+
+#[test]
+#[ignore = "run in a subprocess with GREETD_SOCK set"]
+fn repro_svc_05_child() {
+    let dir = PathBuf::from(std::env::var_os("REPRO_SVC_05_DIR").unwrap());
+    let sock = PathBuf::from(std::env::var_os("GREETD_SOCK").unwrap());
+    let scenario = std::env::var("REPRO_SVC_05_SCENARIO").unwrap();
+    let log = match scenario.as_str() {
+        // PAM asks for a password, then rejects it (as for an unknown user:
+        // PAM doesn't say which).
+        "auth-error" => fake_greetd(sock, |r| match r {
+            Request::CreateSession { .. } => secret(),
+            Request::PostAuthMessageResponse { response: Some(_) } => {
+                Response::Error { error_type: ErrorType::AuthError, description: "pam_authenticate: AUTH_ERR".into() }
+            }
+            _ => Response::Success,
+        }),
+        // greetd can't create the session at all.
+        "create-fails" => fake_greetd(sock, |r| match r {
+            Request::CreateSession { .. } => {
+                Response::Error { error_type: ErrorType::Error, description: "pam_start: user unknown".into() }
+            }
+            _ => Response::Success,
+        }),
+        other => panic!("unknown scenario {other}"),
+    };
+    let mut h = greeter(&dir);
+    let w = h.program().main_window().expect("the login's surface");
+    assert_eq!(h.program().stage, Stage::Name);
+    // The name, mistyped.
+    h.type_text(w, "alcie");
+    enter(&mut h, w);
+    match scenario.as_str() {
+        "auth-error" => {
+            wait(&mut h, "the password question", |g| matches!(g.login.step, Step::Ask { .. }));
+            click_id(&mut h, w, "greeter-password");
+            h.type_text(w, "hunter2");
+            enter(&mut h, w);
+            wait(&mut h, "the rejection and the question again", |g| {
+                g.login.failed == 1 && matches!(g.login.step, Step::Ask { .. })
+            });
+            eprintln!("greetd was asked: {:?}", log.lock().unwrap());
+            eprintln!("showing: {:?}", h.texts(w));
+            // Back, to type the name again.
+            h.named(w, NamedKey::Escape, Modifiers::NONE);
+            let user = h.program().login.user.clone();
+            assert!(
+                h.find_id(w, "greeter-name").is_some(),
+                "no way back to the name: after Escape the login is still for {user:?} and the screen shows only {:?}",
+                h.texts(w)
+            );
+        }
+        "create-fails" => {
+            wait(&mut h, "the failure", |g| g.login.step == Step::Failed);
+            let asked = log.lock().unwrap().len();
+            eprintln!("greetd was asked: {:?}; message: {:?}", log.lock().unwrap(), h.program().login.message);
+            // "Press Return to try again".
+            click_id(&mut h, w, "greeter-password");
+            // A character first, to see Return arrive: `begin` zeroes the
+            // field before it looks for whom to begin.
+            h.type_text(w, "x");
+            let typed = h.program().password.clone();
+            enter(&mut h, w);
+            eprintln!(
+                "field held {typed:?} before Return, {:?} after: Return reached `submit` → `begin`",
+                h.program().password
+            );
+            let tried = h.settle(Duration::from_secs(2), |g| g.login.step != Step::Failed);
+            let again = log.lock().unwrap().len() > asked;
+            assert!(
+                tried || h.find_id(w, "greeter-name").is_some(),
+                "Return did nothing: step {:?}, greetd asked again: {again}, user {:?}, showing {:?}",
+                h.program().login.step,
+                h.program().login.user,
+                h.texts(w)
+            );
+        }
+        _ => unreachable!(),
+    }
+}
diff --git a/desktop/aizome/crates/aizome-kit/src/repro_kit_07.rs b/desktop/aizome/crates/aizome-kit/src/repro_kit_07.rs
