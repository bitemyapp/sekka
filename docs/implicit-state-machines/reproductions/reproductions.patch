@@ -0,0 +1,59 @@
+//! YUK-20: a branch list GitHub sends for one input's chooser must not fill
+//! a chooser opened since for another input. `Msg::Branches` carries
+//! neither the input nor the sheet, so the late answer to a cancelled
+//! chooser lands in whichever chooser is open.
+//!
+//! The sample source never spawns the GitHub request (it would reach the
+//! network), so this sends the message the worker of the first chooser
+//! sends (`Msg::Branches(github_branches(owner, repo))`, app.rs:915), as it
+//! would arrive after the second chooser opened.
+use std::sync::{Arc, Mutex};
+
+use aizome_kit::testing::Harness;
+use aizome_yukimi::app::{Clock, Msg, Page, Runner, Source, Yukimi};
+use aizome_yukimi::ops::Operation;
+
+#[test]
+fn repro_yuk_20_late_branches_for_a_cancelled_chooser() {
+    let ran = Arc::new(Mutex::new(Vec::<Operation>::new()));
+    let seen = ran.clone();
+    let model = Arc::new(aizome_yukimi::fixture::model());
+    let runner = Runner::Mock(Arc::new(move |op: &Operation| {
+        seen.lock().unwrap().push(op.clone());
+        Vec::new()
+    }));
+    let mut app = Yukimi::with(Source::Sample(model.clone()), runner, Clock::Fixed(aizome_yukimi::fixture::NOW, 21));
+    app.check = Some(Arc::new(aizome_yukimi::fixture::check(&model)));
+    let mut h = Harness::new(app);
+    h.send(Msg::Show(Page::Updates));
+    // Choose a branch for home-manager (GitHub nix-community/home-manager)…
+    h.send(Msg::ChooseBranch("home-manager".into()));
+    let first = h.program().branch.as_ref().expect("home-manager's chooser").sheet;
+    // …cancel, and open the chooser for nixos-hardware (NixOS/nixos-hardware).
+    h.send(Msg::CloseSheet(first));
+    h.send(Msg::ChooseBranch("nixos-hardware".into()));
+    {
+        let chooser = h.program().branch.as_ref().expect("nixos-hardware's chooser");
+        assert_eq!(chooser.input, "nixos-hardware");
+        assert_eq!(chooser.repo, Some(("NixOS".to_owned(), "nixos-hardware".to_owned())));
+        assert!(chooser.branches.is_none(), "still asking GitHub");
+    }
+    // home-manager's answer arrives now.
+    h.send(Msg::Branches(Ok(vec!["master".into(), "release-25.05".into(), "release-25.11".into()])));
+    let listed = h.program().branch.as_ref().expect("nixos-hardware's chooser").branches.clone();
+    // What picking one of them would start.
+    if matches!(&listed, Some(Ok(names)) if names.iter().any(|n| n == "release-25.05")) {
+        h.send(Msg::Follow("release-25.05".into()));
+        let w = h.window();
+        let follow =
+            h.semantics(w).into_iter().filter(|(s, _)| s.label.as_deref() == Some("Follow")).map(|(_, r)| r).next_back();
+        if let Some(r) = follow {
+            h.click(w, r.center());
+        }
+    }
+    assert!(
+        listed.is_none(),
+        "nixos-hardware's chooser lists home-manager's branches: {listed:?}; picking one ran {:?}",
+        ran.lock().unwrap()
+    );
+}
diff --git a/desktop/aizome/crates/aizome-awake/tests/repro_azn_01.rs b/desktop/aizome/crates/aizome-awake/tests/repro_azn_01.rs
new file mode 100644
index 00000000..c36f79df
--- /dev/null
+++ b/desktop/aizome/crates/aizome-awake/tests/repro_azn_01.rs
@@ -0,0 +1,157 @@
+//! AZN-01: `aizome-awake toggle` reads the setting (`requested()`) before
+//! it takes the edit lock (`main.rs:30` vs `main.rs:118`), so two toggles
+//! that overlap both decide "turn on": the second toggle is lost and Keep
+//! Awake stays on.
+//!
+//! The real binary, twice, against stand-ins only: a fake `systemctl` first
+//! on PATH (it records start/stop in a file), a private `dbus-daemon` given
+//! to the children as their system bus, with a fake logind on it whose
+//! `ListInhibitors` lists Keep Awake's lock while that file exists, and a
+//! private `XDG_STATE_HOME`. To overlap the two runs deterministically the
+//! test holds `keep-awake.lock` itself (as a third change in progress, e.g.
+//! the menu bar's `aizome-awake on`), starts both toggles, waits until
+//! /proc/locks shows both blocked on that lock, then lets go.
+use std::fs::{self, File, OpenOptions};
+use std::io::{BufRead, BufReader, Read};
+use std::os::fd::AsRawFd;
+use std::os::unix::fs::{MetadataExt, PermissionsExt};
+use std::path::PathBuf;
+use std::process::{Child, Command, Stdio};
+use std::time::{Duration, Instant};
+
+use aizome_awake::{WHAT, WHO, WHY};
+
+struct Logind {
+    held: PathBuf,
+    uid: u32,
+}
+#[zbus::interface(name = "org.freedesktop.login1.Manager")]
+impl Logind {
+    fn list_inhibitors(&self) -> Vec<(String, String, String, String, u32, u32)> {
+        if self.held.exists() {
+            vec![(WHAT.into(), WHO.into(), WHY.into(), "block".into(), self.uid, 4242)]
+        } else {
+            vec![]
+        }
+    }
+}
+
+fn blocked_waiters(inode: u64) -> usize {
+    let needle = format!(":{inode} ");
+    fs::read_to_string("/proc/locks")
+        .unwrap()
+        .lines()
+        .filter(|l| l.contains("->") && l.contains("FLOCK") && l.contains(&needle))
+        .count()
+}
+
+fn wait_with_timeout(mut child: Child, limit: Duration) -> (bool, String) {
+    let until = Instant::now() + limit;
+    loop {
+        if let Some(status) = child.try_wait().unwrap() {
+            let mut out = String::new();
+            for pipe in [child.stdout.take().map(|p| Box::new(p) as Box<dyn std::io::Read>), child.stderr.take().map(|p| Box::new(p) as Box<dyn std::io::Read>)].into_iter().flatten() {
+                let mut text = String::new();
+                let _ = BufReader::new(pipe).read_to_string(&mut text);
+                out.push_str(text.trim());
+                out.push(' ');
+            }
+            return (status.success(), out.trim().to_owned());
+        }
+        if Instant::now() > until {
+            let _ = child.kill();
+            let _ = child.wait();
+            return (false, "timed out".into());
+        }
+        std::thread::sleep(Duration::from_millis(20));
+    }
+}
+
+
+#[test]
+fn two_overlapping_toggles_cancel_out() {
+    let tmp = std::env::temp_dir().join(format!("azn01-{}", std::process::id()));
+    let _ = fs::remove_dir_all(&tmp);
+    let bin = tmp.join("bin");
+    let state = tmp.join("state");
+    fs::create_dir_all(&bin).unwrap();
+    fs::create_dir_all(state.join("aizome")).unwrap();
+    let held = tmp.join("held");
+    let log = tmp.join("systemctl.log");
+    let systemctl = bin.join("systemctl");
+    fs::write(
+        &systemctl,
+        format!(
+            "#!/bin/sh\necho \"systemctl $*\" >> '{log}'\ncase \" $* \" in\n  *\" start \"*) : > '{held}' ;;\n  *\" stop \"*) rm -f '{held}' ;;\n  *\" is-active \"*) [ -e '{held}' ] ;;\nesac\n",
+            log = log.display(),
+            held = held.display()
+        ),
+    )
+    .unwrap();
+    fs::set_permissions(&systemctl, fs::Permissions::from_mode(0o755)).unwrap();
+
+    let mut daemon = Command::new("dbus-daemon")
+        .args(["--session", "--nofork", "--print-address"])
+        .stdout(Stdio::piped())
+        .stderr(Stdio::null())
+        .spawn()
+        .expect("dbus-daemon is required");
+    let mut address = String::new();
+    BufReader::new(daemon.stdout.take().unwrap()).read_line(&mut address).unwrap();
+    let address = address.trim().to_owned();
+    let _logind = zbus::blocking::connection::Builder::address(address.as_str())
+        .unwrap()
+        .name("org.freedesktop.login1")
+        .unwrap()
+        .serve_at("/org/freedesktop/login1", Logind { held: held.clone(), uid: unsafe { libc::geteuid() } })
+        .unwrap()
+        .build()
+        .unwrap();
+
+    // A change in progress holds the edit lock.
+    let lock_path = state.join("aizome/keep-awake.lock");
+    let lock = OpenOptions::new().create(true).truncate(false).write(true).open(&lock_path).unwrap();
+    assert_eq!(unsafe { libc::flock(lock.as_raw_fd(), libc::LOCK_EX) }, 0);
+    let inode = fs::metadata(&lock_path).unwrap().ino();
+
+    let path = format!("{}:{}", bin.display(), std::env::var("PATH").unwrap_or_default());
+    let toggle = || {
+        Command::new(env!("CARGO_BIN_EXE_aizome-awake"))
+            .arg("toggle")
+            .env("PATH", &path)
+            .env("XDG_STATE_HOME", &state)
+            .env("DBUS_SYSTEM_BUS_ADDRESS", &address)
+            .env_remove("DBUS_SESSION_BUS_ADDRESS")
+            .stdout(Stdio::piped())
+            .stderr(Stdio::piped())
+            .spawn()
+            .unwrap()
+    };
+    let first = toggle();
+    let second = toggle();
+    let until = Instant::now() + Duration::from_secs(10);
+    while blocked_waiters(inode) < 2 {
+        assert!(Instant::now() < until, "both toggles should block on the edit lock");
+        std::thread::sleep(Duration::from_millis(10));
+    }
+    let setting = state.join("aizome/keep-awake");
+    assert!(!setting.exists(), "Keep Awake starts off");
+    drop::<File>(lock);
+
+    let (ok1, out1) = wait_with_timeout(first, Duration::from_secs(20));
+    let (ok2, out2) = wait_with_timeout(second, Duration::from_secs(20));
+    let calls = fs::read_to_string(&log).unwrap_or_default();
+    println!("first toggle: ok={ok1} {out1:?}\nsecond toggle: ok={ok2} {out2:?}\nsystemctl calls:\n{calls}");
+    let on = setting.exists();
+    let held_now = held.exists();
+    daemon.kill().unwrap();
+    daemon.wait().unwrap();
+    let _ = fs::remove_dir_all(&tmp);
+    assert!(ok1 && ok2, "both toggles should succeed");
+    assert!(
+        !on && !held_now,
+        "two toggles from off left Keep Awake on (setting file present: {on}, service started: {held_now}); \
+         both read the setting before the lock: {out1:?} / {out2:?}"
+    );
+}
+
diff --git a/desktop/aizome/crates/aizome-network-agent/tests/repro_azn_04.rs b/desktop/aizome/crates/aizome-network-agent/tests/repro_azn_04.rs
new file mode 100644
index 00000000..01904aef
--- /dev/null
+++ b/desktop/aizome/crates/aizome-network-agent/tests/repro_azn_04.rs
@@ -0,0 +1,124 @@
+//! AZN-04: while another agent with the same identifier is still registered
+//! for the user (until its connection closes), NetworkManager refuses ours
+//! with PermissionDenied "already registered". The first refusal leaves
+//! `done = false, asked = true`; the second identical refusal makes
+//! `done = asked = true`, so the agent stops retrying for good and is never
+//! registered once the other agent goes.
+//!
+//! Real `aizome_network_agent::run` on a private `dbus-daemon`, against a
+//! scripted AgentManager (as in tests/credentials.rs): two "already
+//! registered" refusals, then success once the other agent is gone.
+use aizome_network_agent::{
+    Agent, AgentError, Engine, NM, PATH, Result,
+    keyring::Store,
+    model::Prompt,
+    process::Cancel,
+    prompt::Prompter,
+    vpn::Plugins,
+};
+use std::{
+    collections::HashMap,
+    io::{BufRead, BufReader},
+    process::{Command, Stdio},
+    sync::{
+        Arc,
+        atomic::{AtomicUsize, Ordering},
+    },
+    time::{Duration, Instant},
+};
+
+struct Nothing;
+impl Store for Nothing {
+    fn lookup(&self, _: &str, _: &str, _: bool, _: &Cancel) -> Result<HashMap<String, String>> {
+        Ok(HashMap::new())
+    }
+    fn saved(&self, _: &str, _: &Cancel) -> Result<Vec<(String, String)>> {
+        Ok(vec![])
+    }
+    fn store(&self, _: &str, _: &str, _: &str, _: &str, _: &str, _: &Cancel) -> Result<()> {
+        Ok(())
+    }
+    fn forget(&self, _: &str, _: &str, _: &str, _: &Cancel) -> Result<()> {
+        Ok(())
+    }
+    fn delete(&self, _: &str, _: &Cancel) -> Result<()> {
+        Ok(())
+    }
+}
+impl Prompter for Nothing {
+    fn ask(&self, _: Prompt, _: &Cancel) -> Result<HashMap<String, String>> {
+        Err(AgentError::UserCanceled("no dialog in this test".into()))
+    }
+}
+
+#[derive(Debug, zbus::DBusError)]
+#[zbus(prefix = "org.freedesktop.NetworkManager.AgentManager")]
+enum ManagerError {
+    PermissionDenied(String),
+}
+struct AgentManager {
+    calls: Arc<AtomicUsize>,
+    answers: Vec<ManagerError>,
+}
+#[zbus::interface(name = "org.freedesktop.NetworkManager.AgentManager")]
+impl AgentManager {
+    fn register_with_capabilities(&mut self, identifier: String, _capabilities: u32) -> std::result::Result<(), ManagerError> {
+        assert_eq!(identifier, "org.aizome.NetworkAgent");
+        self.calls.fetch_add(1, Ordering::SeqCst);
+        if self.answers.is_empty() { Ok(()) } else { Err(self.answers.remove(0)) }
+    }
+}
+
+#[test]
+fn keeps_asking_while_another_agent_holds_the_identifier() {
+    let mut daemon = Command::new("dbus-daemon")
+        .args(["--session", "--nofork", "--print-address"])
+        .stdout(Stdio::piped())
+        .stderr(Stdio::null())
+        .spawn()
+        .expect("dbus-daemon is required");
+    let mut address = String::new();
+    BufReader::new(daemon.stdout.take().unwrap()).read_line(&mut address).unwrap();
+    let connect = || zbus::blocking::connection::Builder::address(address.trim()).unwrap().build().unwrap();
+    let refused = || ManagerError::PermissionDenied("An agent with this ID is already registered for this user.".into());
+    let nm = connect();
+    let calls = Arc::new(AtomicUsize::new(0));
+    nm.object_server()
+        .at(
+            "/org/freedesktop/NetworkManager/AgentManager",
+            AgentManager { calls: calls.clone(), answers: vec![refused(), refused()] },
+        )
+        .unwrap();
+    nm.request_name(NM).unwrap();
+
+    let engine = Arc::new(Engine { store: Arc::new(Nothing), ui: Arc::new(Nothing), plugins: Plugins { dirs: vec![] } });
+    let agent = zbus::blocking::connection::Builder::address(address.trim())
+        .unwrap()
+        .serve_at(PATH, Agent::new(engine))
+        .unwrap()
+        .build()
+        .unwrap();
+    let served = std::thread::spawn(move || aizome_network_agent::run(agent).map_err(|e| e.to_string()));
+
+    // Refused twice (2 s apart); the third attempt would succeed, the other
+    // agent having gone. Give it three retry periods.
+    let start = Instant::now();
+    let deadline = start + aizome_network_agent::REGISTER_RETRY * 3 + Duration::from_secs(1);
+    let mut seen = vec![];
+    while calls.load(Ordering::SeqCst) < 3 && Instant::now() < deadline {
+        let n = calls.load(Ordering::SeqCst);
+        if seen.last().is_none_or(|(c, _)| *c != n) {
+            seen.push((n, start.elapsed()));
+        }
+        std::thread::sleep(Duration::from_millis(10));
+    }
+    let total = calls.load(Ordering::SeqCst);
+    println!("RegisterWithCapabilities calls over {:?}: {total}; first seen at {seen:?}", start.elapsed());
+    daemon.kill().unwrap();
+    daemon.wait().unwrap();
+    let _ = served.join();
+    assert_eq!(
+        total, 3,
+        "after two \"already registered\" refusals the agent stopped asking: it is never registered once the other agent goes"
+    );
+}
diff --git a/desktop/tatami/activity/src/repro_tap_03.rs b/desktop/tatami/activity/src/repro_tap_03.rs
new file mode 100644
index 00000000..8906e262
--- /dev/null
+++ b/desktop/tatami/activity/src/repro_tap_03.rs
@@ -0,0 +1,302 @@
+// SPDX-License-Identifier: MIT OR Apache-2.0
+//! TAP-03: the processor's power through Tatami's power meter service, read
+//! every second. The service answers a question asked within a second of its
+//! last fresh reading with that reading (tool/src/power_meter.rs:100-107);
+//! the sampler asks after its per-process scan, whose length varies.
+//!
+//! The sampler here has no graphics cards and reads the package counter from
+//! a fake powercap domain in TMPDIR, so nothing reaches the host's meters.
+//! The fake answers with the service's rule, transcribed below. The tests
+//! that make a read fail need the preload shim (it refuses the fallback's
+//! connection to /run/tatami/power.sock) and check that it is loaded.
+use super::*;
+use std::{
+    fs,
+    io::Write,
+    os::unix::fs::OpenOptionsExt,
+    sync::{
+        Arc,
+        atomic::{AtomicBool, Ordering},
+    },
+    time::{Duration, Instant},
+};
+
+const WATTS: f64 = 20.0;
+
+fn sampler(rapl: PathBuf) -> Sampler {
+    Sampler {
+        ticks: procfs::clock_ticks(),
+        // SAFETY: getuid has no preconditions.
+        uid: unsafe { libc::getuid() },
+        tick: 0,
+        lens: Lens::Cpu,
+        focus: HashSet::new(),
+        users: HashMap::new(),
+        desktop: apps::Desktop::default(),
+        cpu_name: String::new(),
+        last: None,
+        stat: None,
+        previous: HashMap::new(),
+        cache: HashMap::new(),
+        smaps: HashMap::new(),
+        drm: HashMap::new(),
+        clients: HashMap::new(),
+        devices: Vec::new(),
+        nvml: None,
+        rapl: vec![rapl],
+        rapl_before: None,
+        gpu_energy_before: Vec::new(),
+        cpu_floor: Floor::default(),
+        gpu_floors: Vec::new(),
+        energy: HashMap::new(),
+        total_energy: (0.0, 0.0),
+        disks_before: HashMap::new(),
+        disk_totals: (0, 0),
+        temperature: None,
+        buffer: String::new(),
+    }
+}
+
+/// A fake intel-rapl:0 package domain; `energy_uj` is written by the test.
+fn domain(name: &str) -> PathBuf {
+    let dir = std::env::temp_dir()
+        .join(format!("repro-tap-03-{name}-{}", std::process::id()))
+        .join("intel-rapl:0");
+    let _ = fs::remove_dir_all(&dir);
+    fs::create_dir_all(&dir).unwrap();
+    fs::write(dir.join("name"), "package-0\n").unwrap();
+    fs::write(dir.join("max_energy_range_uj"), "262143328850\n").unwrap();
+    dir
+}
+
+/// The package's real counter, in microjoules, `t` seconds in.
+fn counter(t: f64) -> u64 {
+    1_000_000_000 + (WATTS * t * 1e6) as u64
+}
+
+/// `tatami power-meter`'s answer (tool/src/power_meter.rs:100-107) on a clock
+/// given in seconds: a fresh reading at most once a second (EVERY), else the
+/// last one.
+struct Service {
+    last: Option<(f64, u64)>,
+}
+
+impl Service {
+    fn answer(&mut self, now: f64) -> u64 {
+        match self.last {
+            Some((at, energy)) if now - at < 1.0 => energy,
+            _ => {
+                let energy = counter(now);
+                self.last = Some((now, energy));
+                energy
+            }
+        }
+    }
+}
+
+/// The lowest processor power the sampler has seen: its idle floor.
+fn floor(sampler: &Sampler) -> f64 {
+    let mut floor = sampler.cpu_floor;
+    floor.update(f64::MAX)
+}
+
+fn shim_loaded() -> bool {
+    // SAFETY: dlsym with RTLD_DEFAULT and a valid C string.
+    !unsafe { libc::dlsym(libc::RTLD_DEFAULT, c"sekka_repro_shim_loaded".as_ptr()) }.is_null()
+}
+
+fn watts(readings: &[Option<f64>]) -> String {
+    readings
+        .iter()
+        .map(|w| w.map_or("none".to_owned(), |w| format!("{w:.1}")))
+        .collect::<Vec<_>>()
+        .join(", ")
+}
+
+/// Readings start on a one-second grid ("Update Every Second",
+/// sampler.rs:63-67), so each reading's dt is 1 s, and the counter is asked
+/// for after the per-process scan: here 300, 250, 320, 280, … ms in.
+#[test]
+fn repro_tap_03_steady_power_through_the_service_cache() {
+    let dir = domain("steady");
+    let mut sampler = sampler(dir.clone());
+    let mut service = Service { last: None };
+    let scans = [0.300, 0.250, 0.320, 0.280, 0.300, 0.290, 0.310, 0.260];
+    let mut readings = Vec::new();
+    for (tick, scan) in scans.iter().enumerate() {
+        let energy = service.answer(tick as f64 + scan);
+        fs::write(dir.join("energy_uj"), format!("{energy}\n")).unwrap();
+        // Never fall through to the host's service.
+        assert!(power::read_direct(&sampler.rapl).is_some());
+        let dt = if tick == 0 { 0.0 } else { 1.0 };
+        readings.push(sampler.power(&mut [], &[], &[], 1, dt).cpu);
+    }
+    let floor = floor(&sampler);
+    let _ = fs::remove_dir_all(dir.parent().unwrap());
+    let wrong: Vec<_> = readings[1..]
+        .iter()
+        .filter(|w| w.is_none_or(|w| (w - WATTS).abs() > 0.2 * WATTS))
+        .collect();
+    assert!(
+        wrong.is_empty() && floor > 0.5 * WATTS,
+        "a steady {WATTS} W package read every second through the service: \
+         readings [{}] W, idle floor now {floor} W",
+        watts(&readings)
+    );
+}
+
+/// The window's default, a reading every 2 s: `spawn` takes a baseline,
+/// then sends its first frame 350 ms after it (sampler.rs:41-43), well
+/// within the service's second. Here both scans take 100 ms.
+#[test]
+fn repro_tap_03_first_frame_at_the_default_interval() {
+    let dir = domain("first");
+    let mut sampler = sampler(dir.clone());
+    let mut service = Service { last: None };
+    // (when the reading starts, its dt, when it asks for the counter)
+    let mut readings = Vec::new();
+    for (start, dt) in [(0.0, 0.0), (0.45, 0.45), (2.45, 2.0), (4.45, 2.0), (6.45, 2.0)] {
+        let energy = service.answer(start + 0.1);
+        fs::write(dir.join("energy_uj"), format!("{energy}\n")).unwrap();
+        assert!(power::read_direct(&sampler.rapl).is_some());
+        readings.push(sampler.power(&mut [], &[], &[], 1, dt).cpu);
+    }
+    let floor = floor(&sampler);
+    let _ = fs::remove_dir_all(dir.parent().unwrap());
+    let wrong = readings[1..]
+        .iter()
+        .filter(|w| w.is_none_or(|w| (w - WATTS).abs() > 0.1 * WATTS))
+        .count();
+    assert!(
+        wrong == 0 && floor > 0.5 * WATTS,
+        "a steady {WATTS} W package, readings every 2 s: baseline and frames [{}] W, \
+         idle floor now {floor} W",
+        watts(&readings)
+    );
+}
+
+/// A read that fails (the service times out, or is restarting) keeps the
+/// older baseline (sampler.rs:877-879): the next reading divides two
+/// intervals' joules by one.
+#[test]
+fn repro_tap_03_reading_after_a_failed_read() {
+    assert!(
+        shim_loaded(),
+        "run with LD_PRELOAD=repro-shim.so: a failed direct read falls through to /run/tatami/power.sock"
+    );
+    let dir = domain("failed");
+    let mut sampler = sampler(dir.clone());
+    let mut readings = Vec::new();
+    for tick in 0..4 {
+        let file = dir.join("energy_uj");
+        if tick == 2 {
+            let _ = fs::remove_file(&file);
+        } else {
+            // Fresh readings exactly a second apart.
+            fs::write(&file, format!("{}\n", counter(tick as f64))).unwrap();
+        }
+        let dt = if tick == 0 { 0.0 } else { 1.0 };
+        readings.push(sampler.power(&mut [], &[], &[], 1, dt).cpu);
+    }
+    let _ = fs::remove_dir_all(dir.parent().unwrap());
+    assert_eq!(readings[2], None, "the failed read shows nothing");
+    let after = readings[3].unwrap();
+    assert!(
+        (after - WATTS).abs() < 0.2 * WATTS,
+        "a steady {WATTS} W package, its tick-2 read failed: readings [{}] W",
+        watts(&readings)
+    );
+}
+
+/// The sampler's own loop (spawn, sampler.rs:41-67) at one-second readings,
+/// with the real per-process scan of this machine's /proc. The fake domain's
+/// `energy_uj` is a FIFO: each read is answered when it is made, with the
+/// service's rule.
+#[test]
+fn repro_tap_03_real_scan_every_second() {
+    assert!(
+        shim_loaded(),
+        "run with LD_PRELOAD=repro-shim.so: a failed direct read falls through to /run/tatami/power.sock"
+    );
+    let dir = domain("fifo");
+    let fifo = dir.join("energy_uj");
+    let path = std::ffi::CString::new(fifo.to_str().unwrap()).unwrap();
+    // SAFETY: a valid path; mode 0600.
+    assert_eq!(unsafe { libc::mkfifo(path.as_ptr(), 0o600) }, 0);
+    let start = Instant::now();
+    let stop = Arc::new(AtomicBool::new(false));
+    let asked = Arc::new(std::sync::Mutex::new(Vec::<(f64, bool)>::new()));
+    let writer = {
+        let (fifo, stop, asked) = (fifo.clone(), stop.clone(), asked.clone());
+        std::thread::spawn(move || {
+            let mut service = Service { last: None };
+            loop {
+                // Blocks until the sampler opens it to read.
+                let mut file = fs::OpenOptions::new().write(true).open(&fifo).unwrap();
+                if stop.load(Ordering::SeqCst) {
+                    break;
+                }
+                let now = start.elapsed().as_secs_f64();
+                let fresh = service.last.is_none_or(|(at, _)| now - at >= 1.0);
+                asked.lock().unwrap().push((now, fresh));
+                let _ = writeln!(file, "{}", service.answer(now));
+                drop(file);
+                // Let the reader close before opening again: an open for
+                // writing returns at once while a reader has it open.
+                std::thread::sleep(Duration::from_millis(30));
+            }
+        })
+    };
+    let mut sampler = sampler(dir.clone());
+    let interval = Duration::from_secs(1);
+    let mut scans = Vec::new();
+    sampler.sample();
+    let mut next = Instant::now() + Duration::from_millis(350);
+    let mut readings = Vec::new();
+    for _ in 0..14 {
+        std::thread::sleep(next.saturating_duration_since(Instant::now()));
+        let began = Instant::now();
+        let frame = sampler.sample();
+        scans.push(began.elapsed().as_millis());
+        readings.push(frame.power.cpu);
+        next += interval;
+        let now = Instant::now();
+        if next < now {
+            next = now + interval;
+        }
+    }
+    stop.store(true, Ordering::SeqCst);
+    // Hold a reader open so the writer's next open returns and sees `stop`.
+    let reader = fs::OpenOptions::new()
+        .read(true)
+        .custom_flags(libc::O_NONBLOCK)
+        .open(&fifo);
+    writer.join().unwrap();
+    drop(reader);
+    let _ = fs::remove_dir_all(dir.parent().unwrap());
+    let asked = asked.lock().unwrap().clone();
+    let gaps: Vec<String> = asked
+        .windows(2)
+        .map(|pair| {
+            format!(
+                "{:.0}{}",
+                (pair[1].0 - pair[0].0) * 1000.0,
+                if pair[1].1 { "" } else { "(cached)" }
+            )
+        })
+        .collect();
+    let floor = floor(&sampler);
+    let wrong = readings
+        .iter()
+        .filter(|w| w.is_none_or(|w| (w - WATTS).abs() > 0.2 * WATTS))
+        .count();
+    assert!(
+        wrong == 0 && floor > 0.5 * WATTS,
+        "{wrong} of {} readings wrong for a steady {WATTS} W: [{}] W; idle floor {floor} W; \
+         ms between questions [{}]; scan ms {scans:?}",
+        readings.len(),
+        watts(&readings),
+        gaps.join(", ")
+    );
+}
+
diff --git a/desktop/tatami/activity/src/repro_tap_04.rs b/desktop/tatami/activity/src/repro_tap_04.rs
new file mode 100644
index 00000000..424bcf4c
--- /dev/null
+++ b/desktop/tatami/activity/src/repro_tap_04.rs
@@ -0,0 +1,117 @@
+// SPDX-License-Identifier: MIT OR Apache-2.0
+//! TAP-04: header clicks against the sorter handler's `last` column
+//! (table.rs:568-598), which isn't updated while `set_lens` swaps columns.
+//!
+//! A click on a header is what GtkColumnViewTitle does with it
+//! (gtk_column_view_sorter_toggle_column): the primary column's order flips;
+//! any other column becomes primary, ascending. `click` makes the same
+//! change with `sort_by_column`, so the sorter emits `changed` with the same
+//! primary column and order. Needs a display (a private Xvfb).
+use super::*;
+use gtk::SortType::{Ascending, Descending};
+
+fn sorter(table: &Table) -> gtk::ColumnViewSorter {
+    table.view.sorter().and_downcast().unwrap()
+}
+
+fn view_column(table: &Table, column: Column) -> gtk::ColumnViewColumn {
+    table
+        .columns
+        .borrow()
+        .iter()
+        .find(|(c, _)| *c == column)
+        .map(|(_, view_column)| view_column.clone())
+        .unwrap()
+}
+
+fn sort(table: &Table) -> (Option<Column>, gtk::SortType) {
+    let sorter = sorter(table);
+    (
+        sorter
+            .primary_sort_column()
+            .and_then(|primary| table.column_of(&primary)),
+        sorter.primary_sort_order(),
+    )
+}
+
+fn settle() {
+    let context = glib::MainContext::default();
+    while context.iteration(false) {}
+}
+
+fn click(table: &Table, column: Column) {
+    let target = view_column(table, column);
+    let sorter = sorter(table);
+    let order = if sorter.primary_sort_column().as_ref() == Some(&target) {
+        match sorter.primary_sort_order() {
+            Ascending => Descending,
+            _ => Ascending,
+        }
+    } else {
+        Ascending
+    };
+    table.view.sort_by_column(Some(&target), order);
+    settle();
+}
+
+/// The table as the window makes it (window.rs:236, :298-299).
+fn table() -> Rc<Table> {
+    let table = Table::new(gio::Menu::new().upcast_ref());
+    let store = gio::ListStore::new::<Entry>();
+    table.set_root(&store, Mode::Apps);
+    table.set_lens(Lens::Cpu);
+    settle();
+    table
+}
+
+#[test]
+fn repro_tap_04_header_clicks_after_start_and_view_switches() {
+    gtk::init().unwrap();
+    let mut wrong = Vec::new();
+
+    // 1. Just opened: sorted by % CPU, largest first. One click on % CPU
+    //    should sort it smallest first.
+    let t = table();
+    assert_eq!(sort(&t), (Some(Column::Cpu), Descending));
+    click(&t, Column::Cpu);
+    if sort(&t) != (Some(Column::Cpu), Ascending) {
+        wrong.push(format!(
+            "start-up, one click on % CPU (Descending→Ascending): now {:?}",
+            sort(&t)
+        ));
+    }
+
+    // 2. After a view switch, one click on the view's restored column.
+    let t = table();
+    click(&t, Column::Threads);
+    assert_eq!(sort(&t), (Some(Column::Threads), Descending), "a new column starts largest first");
+    t.set_lens(Lens::Memory);
+    settle();
+    assert_eq!(sort(&t), (Some(Column::Memory), Descending));
+    click(&t, Column::Memory);
+    if sort(&t) != (Some(Column::Memory), Ascending) {
+        wrong.push(format!(
+            "Memory view after a switch, one click on Memory (Descending→Ascending): now {:?}",
+            sort(&t)
+        ));
+    }
+
+    // 3. A numeric column made primary from another column sorts largest
+    //    first, unless it is the column `last` still names.
+    let t = table();
+    click(&t, Column::Threads);
+    click(&t, Column::Cpu);
+    assert_eq!(sort(&t), (Some(Column::Cpu), Descending), "a new column starts largest first");
+    t.set_lens(Lens::Energy);
+    settle();
+    assert_eq!(sort(&t), (Some(Column::Power), Descending));
+    click(&t, Column::Cpu);
+    if sort(&t) != (Some(Column::Cpu), Descending) {
+        wrong.push(format!(
+            "Energy view sorted by Power, one click on % CPU (newly primary): now {:?}",
+            sort(&t)
+        ));
+    }
+
+    assert!(wrong.is_empty(), "{wrong:#?}");
+}
diff --git a/desktop/tatami/activity/src/repro_tap_06.rs b/desktop/tatami/activity/src/repro_tap_06.rs
new file mode 100644
index 00000000..4b2c027c
--- /dev/null
+++ b/desktop/tatami/activity/src/repro_tap_06.rs
@@ -0,0 +1,247 @@
+// SPDX-License-Identifier: MIT OR Apache-2.0
+//! TAP-06: `tatami-activity --pid N` while the window exists but before its
+//! first reading. The second launch reaches `open` (window.rs:89-101), which
+//! calls `select_pid` against the latest frame's PIDs, still empty.
+//!
+//! The window is `build`'s (window.rs:173-418) without its sampler thread,
+//! which would read the host's power meters: frames come from this test, into
+//! the same loop as build's (window.rs:316-332). Needs a display (a private
+//! Xvfb) and a session bus (a private dbus-daemon) to register the app.
+use super::*;
+use crate::model::{Group, Kind, Process, Usage};
+use std::time::Instant;
+
+pub(super) fn ui(app: &adw::Application) -> (Rc<Ui>, async_channel::Sender<Frame>) {
+    let window = adw::ApplicationWindow::builder()
+        .application(app)
+        .title("Activity")
+        .default_width(1160)
+        .default_height(720)
+        .build();
+    let lenses = adw::ToggleGroup::new();
+    for lens in Lens::ALL {
+        lenses.add(toggle(lens.id(), lens.title(), ""));
+    }
+    lenses.set_active_name(Some(Lens::Cpu.id()));
+    let modes = adw::ToggleGroup::new();
+    for mode in [Mode::Apps, Mode::All, Mode::Tree] {
+        modes.add(toggle(mode.id(), mode.id(), ""));
+    }
+    modes.set_active_name(Some(Mode::Apps.id()));
+    let search = gtk::SearchEntry::new();
+    let table = Table::new(context_menu().upcast_ref());
+    let scroller = gtk::ScrolledWindow::builder()
+        .vexpand(true)
+        .child(&table.view)
+        .build();
+    let summary = Summary::new();
+    let inspector = Inspector::new();
+    let split = adw::OverlaySplitView::builder()
+        .sidebar_position(gtk::PackType::End)
+        .content(&scroller)
+        .sidebar(&inspector.root)
+        .show_sidebar(true)
+        .build();
+    let toasts = adw::ToastOverlay::new();
+    toasts.set_child(Some(&split));
+    let view = adw::ToolbarView::new();
+    view.set_content(Some(&toasts));
+    view.add_bottom_bar(&summary.stack);
+    window.set_content(Some(&view));
+    // No sampler: commands go nowhere, as focus() allows.
+    let (commands, _) = mpsc::channel();
+    // SAFETY: getuid has no preconditions.
+    let uid = unsafe { libc::getuid() };
+    let state = State {
+        lens: Lens::Cpu,
+        mode: Mode::Apps,
+        processes: HashMap::new(),
+        groups: HashMap::new(),
+        apps: gio::ListStore::new::<Entry>(),
+        all: gio::ListStore::new::<Entry>(),
+        tree: gio::ListStore::new::<Entry>(),
+        uid,
+        pids: HashMap::new(),
+        pending: None,
+    };
+    table.filter.borrow_mut().uid = uid;
+    table.set_root(&state.apps, Mode::Apps);
+    table.set_lens(Lens::Cpu);
+    summary.set_lens(Lens::Cpu);
+    let ui = Rc::new(Ui {
+        window,
+        table: table.clone(),
+        summary,
+        inspector,
+        split,
+        search,
+        lenses,
+        modes,
+        toasts,
+        commands,
+        state: RefCell::new(state),
+        presented: Cell::new(false),
+    });
+    let (frames, receiver) = async_channel::bounded::<Frame>(2);
+    let weak = Rc::downgrade(&ui);
+    glib::spawn_future_local(async move {
+        while let Ok(frame) = receiver.recv().await {
+            let Some(ui) = weak.upgrade() else {
+                break;
+            };
+            apply(&ui, &frame);
+            let pending = ui.state.borrow_mut().pending.take();
+            if let Some((pid, exact)) = pending
+                && pid != std::process::id() as i32
+            {
+                select_pid(&ui, pid, exact);
+            }
+            present(&ui);
+        }
+    });
+    let weak = Rc::downgrade(&ui);
+    table.selection.connect_selected_item_notify(move |_| {
+        if let Some(ui) = weak.upgrade() {
+            selected(&ui);
+        }
+    });
+    actions(&ui);
+    selected(&ui);
+    (ui, frames)
+}
+
+/// open()'s first launch (window.rs:103-115), with this test's window.
+pub(super) fn first_launch(ui: &Rc<Ui>, request: Request) {
+    let pending = request
+        .pid
+        .map(|pid| (pid, true))
+        .or_else(|| crate::apps::focused_pid().map(|pid| (pid, false)));
+    ui.state.borrow_mut().pending = pending;
+    UI.with_borrow_mut(|slot| *slot = Some(ui.clone()));
+    let soon = ui.clone();
+    glib::timeout_add_local_once(Duration::from_millis(600), move || present(&soon));
+}
+
+pub(super) fn app(id: &str) -> adw::Application {
+    adw::init().unwrap();
+    let app = adw::Application::builder()
+        .application_id(id)
+        .flags(gio::ApplicationFlags::NON_UNIQUE)
+        .build();
+    app.register(None::<&gio::Cancellable>).unwrap();
+    app
+}
+
+pub(super) fn settle_for(time: Duration) {
+    let context = glib::MainContext::default();
+    let end = Instant::now() + time;
+    while Instant::now() < end {
+        while context.iteration(false) {}
+        std::thread::sleep(Duration::from_millis(5));
+    }
+}
+
+/// The start time (field 22 of /proc/PID/stat).
+pub(super) fn start_of(pid: i32) -> u64 {
+    let stat = std::fs::read_to_string(format!("/proc/{pid}/stat")).unwrap();
+    let after = &stat[stat.rfind(')').unwrap() + 2..];
+    after.split_whitespace().nth(19).unwrap().parse().unwrap()
+}
+
+/// A frame of one-process applications: (PID, start, name, % CPU).
+pub(super) fn frame(apps: &[(i32, u64, &str, f64)]) -> Frame {
+    // SAFETY: getuid has no preconditions.
+    let uid = unsafe { libc::getuid() };
+    let mut frame = Frame {
+        uid,
+        ..Default::default()
+    };
+    for &(pid, start, name, cpu) in apps {
+        let key = format!("{pid}:{start}");
+        let usage = Usage {
+            cpu,
+            threads: 1,
+            ..Default::default()
+        };
+        frame.processes.push(Process {
+            pid,
+            ppid: 1,
+            key: key.clone(),
+            name: name.into(),
+            command: name.into(),
+            user: "me".into(),
+            uid,
+            state: 'S',
+            readable: true,
+            usage: usage.clone(),
+            group: format!("g{key}"),
+            ..Default::default()
+        });
+        frame.groups.push(Group {
+            key: format!("g{key}"),
+            kind: Some(Kind::App),
+            name: name.into(),
+            members: vec![pid],
+            usage,
+            ..Default::default()
+        });
+    }
+    frame
+}
+
+pub(super) fn texts(widget: &gtk::Widget, out: &mut Vec<String>) {
+    if let Some(label) = widget.downcast_ref::<gtk::Label>() {
+        out.push(label.label().into());
+    }
+    let mut child = widget.first_child();
+    while let Some(current) = child {
+        texts(&current, out);
+        child = current.next_sibling();
+    }
+}
+
+#[test]
+fn repro_tap_06_pid_request_before_the_first_reading() {
+    let app = app("org.tatami.Activity.ReproTap06");
+    let mut sleeper = std::process::Command::new("sleep")
+        .arg("60")
+        .spawn()
+        .unwrap();
+    let pid = sleeper.id() as i32;
+    let start = start_of(pid);
+
+    // `tatami-activity`: the window is made; its first reading is due in
+    // 350 ms plus a scan.
+    let (ui, frames) = ui(&app);
+    first_launch(&ui, Request::default());
+    settle_for(Duration::from_millis(100));
+
+    // `tatami-activity --pid PID`, before that reading.
+    let again = open(&app, Request {
+        pid: Some(pid),
+        ..Default::default()
+    });
+    assert!(Rc::ptr_eq(&again, &ui));
+    let mut shown = Vec::new();
+    texts(ui.toasts.upcast_ref(), &mut shown);
+    let ended = format!("Process {pid} has ended");
+    let toasted = shown.iter().any(|text| text == &ended);
+
+    // The first reading: PID is alive, among busier applications.
+    frames
+        .send_blocking(frame(&[
+            (900_001, 1, "Browser", 40.0),
+            (pid, start, "sleep", 0.5),
+            (900_002, 2, "Editor", 20.0),
+        ]))
+        .unwrap();
+    settle_for(Duration::from_millis(300));
+    let selected = ui.table.selected().map(|entry| entry.key());
+    let _ = sleeper.kill();
+    let _ = sleeper.wait();
+    assert!(
+        !toasted && selected.as_deref() == Some(format!("g{pid}:{start}").as_str()),
+        "after `--pid {pid}` for a live process: toast {:?}; selected after the first reading: {selected:?}",
+        if toasted { ended.as_str() } else { "none" }
+    );
+}
diff --git a/desktop/tatami/activity/src/repro_tap_08.rs b/desktop/tatami/activity/src/repro_tap_08.rs
