index 00000000..9462a4e0
--- /dev/null
+++ b/tests/repro_ttl_04.py
@@ -0,0 +1,84 @@
+#!/usr/bin/env python3
+"""TTL-04: a global wallpaper on a drive that is not mounted yet when
+`tatami background ensure` runs (tatami-swaybg's ExecStartPre at login, while
+udiskie automounts) must still be the choice once the drive is mounted.
+
+Runs the real CLI with private XDG state; nothing is mounted: the "drive" is
+a directory that appears after `ensure`. A per-output image on the same drive
+is the control: swaybg_args falls back for it without losing the choice.
+
+usage: repro_ttl_04.py /path/to/tatami
+"""
+import os
+from pathlib import Path
+import subprocess
+import sys
+import tempfile
+import unittest
+
+BIN = sys.argv.pop(1)
+
+def png():
+    """A 1x1 PNG, so `background set` (which decodes with gdk-pixbuf) accepts it."""
+    import struct, zlib
+    def chunk(kind, data):
+        return (struct.pack('>I', len(data)) + kind + data
+                + struct.pack('>I', zlib.crc32(kind + data) & 0xffffffff))
+    return (b'\x89PNG\r\n\x1a\n' + chunk(b'IHDR', struct.pack('>IIBBBBB', 1, 1, 8, 2, 0, 0, 0))
+            + chunk(b'IDAT', zlib.compress(b'\x00\x20\x40\x60')) + chunk(b'IEND', b''))
+
+
+PNG = png()
+
+
+class LateMountedWallpaper(unittest.TestCase):
+    def setUp(self):
+        tmp = tempfile.TemporaryDirectory(prefix='ttl04-')
+        self.addCleanup(tmp.cleanup)
+        self.root = Path(tmp.name)
+        fake = self.root / 'fake'
+        fake.mkdir()
+        for name in ['systemctl', 'notify-send']:
+            (fake / name).write_text('#!/bin/sh\nexit 0\n')
+            (fake / name).chmod(0o755)
+        self.env = dict(os.environ, XDG_STATE_HOME=str(self.root / 'state'),
+                        HOME=str(self.root / 'home'), PATH=str(fake))
+        self.drive = self.root / 'media/alice/PHOTOS'
+        self.image = self.drive / 'beach.png'
+        self.drive.mkdir(parents=True)
+        self.image.write_bytes(PNG)
+        self.link = self.root / 'state/tatami/background'
+
+    def tatami(self, *args):
+        result = subprocess.run([BIN, 'background', *args], env=self.env, text=True,
+                                capture_output=True)
+        self.assertEqual(result.returncode, 0, result.stderr)
+        return result.stdout
+
+    def unplug(self):
+        self.drive.rename(self.drive.with_name('PHOTOS.unmounted'))
+
+    def replug(self):
+        self.drive.with_name('PHOTOS.unmounted').rename(self.drive)
+
+    def test_global_choice_survives_a_late_mount(self):
+        self.tatami('set', str(self.image))
+        self.assertEqual(os.readlink(self.link), str(self.image))
+        self.unplug()                      # logged out; the drive is not mounted yet
+        self.tatami('ensure')              # tatami-swaybg ExecStartPre at login
+        self.replug()                      # udiskie mounts it a moment later
+        self.assertEqual(os.readlink(self.link), str(self.image),
+                         'the chosen wallpaper was replaced by the default')
+        self.assertEqual(self.tatami('path').strip(), str(self.link))
+
+    def test_control_per_output_choice_survives_a_late_mount(self):
+        self.tatami('set', str(self.image), '--output', 'DP-1')
+        self.unplug()
+        self.tatami('ensure')
+        self.replug()
+        status = self.tatami('status')
+        self.assertIn(str(self.image), status)
+
+
+if __name__ == '__main__':
+    unittest.main()
