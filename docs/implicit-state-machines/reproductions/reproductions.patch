+++ b/desktop/aizome/apps/sumi/tests/repro_smt_17.rs
@@ -0,0 +1,83 @@
+//! SMT-17: Quit keeps everything for next time. A document whose only
+//! change is its Encoding or Line Endings ("— Edited"), or one reopened in
+//! a chosen encoding, must come back that way, not re-read as detected.
+
+use std::path::{Path, PathBuf};
+use std::time::Duration;
+
+use aizome_kit::testing::Harness;
+use aizome_sumi::app::{Command, Msg, Places, Sumi};
+use aizome_sumi::files::{Encoding, LineEnding};
+
+fn scratch(name: &str) -> PathBuf {
+    let d = Path::new(env!("CARGO_TARGET_TMPDIR")).join("sumi-repro").join(name);
+    let _ = std::fs::remove_dir_all(&d);
+    std::fs::create_dir_all(&d).unwrap();
+    d
+}
+
+fn app(places: Places) -> Sumi {
+    let mut s = Sumi::new(places);
+    s.open_links = false;
+    s.highlight_budget = Duration::from_secs(10);
+    s
+}
+
+fn places(dir: &Path) -> Places {
+    Places { state: Some(dir.join("state")), recent: None, settings: None, documents: None }
+}
+
+#[test]
+fn an_unsaved_encoding_and_line_ending_change_survives_quit() {
+    let dir = scratch("smt17-format");
+    let file = dir.join("plain.txt");
+    std::fs::write(&file, "one\ntwo\n").unwrap();
+    let file = file.canonicalize().unwrap();
+    {
+        let mut h = Harness::new(app(places(&dir)));
+        let w = h.window();
+        h.send(Msg::Opened(Some(vec![file.clone()])));
+        assert_eq!(h.program().docs[&w].encoding, Encoding::Utf8);
+        h.send(Msg::On(w, Command::SetEncoding(Encoding::Utf16Le)));
+        h.send(Msg::On(w, Command::SetLineEnding(LineEnding::Crlf)));
+        assert_eq!(h.title(w), "plain.txt — Edited");
+        h.send(Msg::Quit);
+        assert!(h.platform.quit);
+    }
+    let h = Harness::new(app(places(&dir)));
+    let w = h.window();
+    let d = &h.program().docs[&w];
+    assert_eq!(
+        (d.path.clone(), d.encoding, d.line_ending, d.dirty(), h.title(w)),
+        (Some(file), Encoding::Utf16Le, LineEnding::Crlf, true, "plain.txt — Edited".to_owned()),
+        "(path, encoding, line endings, dirty, title) after Quit and relaunch"
+    );
+    assert_eq!(std::fs::read_to_string(dir.join("plain.txt")).unwrap(), "one\ntwo\n", "the file untouched");
+}
+
+#[test]
+fn a_reopen_in_a_chosen_encoding_survives_quit() {
+    let dir = scratch("smt17-reopen");
+    let file = dir.join("cafe.txt");
+    std::fs::write(&file, "café\n").unwrap();
+    let file = file.canonicalize().unwrap();
+    {
+        let mut h = Harness::new(app(places(&dir)));
+        let w = h.window();
+        h.send(Msg::Opened(Some(vec![file.clone()])));
+        assert_eq!(h.program().docs[&w].encoding, Encoding::Utf8);
+        // Reopen with Encoding ▸ Latin-1 (the document is clean: no question).
+        h.send(Msg::On(w, Command::Reopen(Encoding::Latin1)));
+        let d = &h.program().docs[&w];
+        assert_eq!((d.encoding, d.content.text(), d.dirty()), (Encoding::Latin1, "cafÃ©\n".to_owned(), false));
+        h.send(Msg::Quit);
+    }
+    let h = Harness::new(app(places(&dir)));
+    let w = h.window();
+    let d = &h.program().docs[&w];
+    assert_eq!(
+        (d.path.clone(), d.encoding, d.content.text()),
+        (Some(file), Encoding::Latin1, "cafÃ©\n".to_owned()),
+        "(path, encoding, text) after Quit and relaunch"
+    );
+}
diff --git a/desktop/aizome/apps/sumi/tests/repro_smt_18.rs b/desktop/aizome/apps/sumi/tests/repro_smt_18.rs
new file mode 100644
index 00000000..ea5f219b
--- /dev/null
+++ b/desktop/aizome/apps/sumi/tests/repro_smt_18.rs
@@ -0,0 +1,110 @@
+//! SMT-18: a background (> 2 MiB) read that fails must leave the window as
+//! consistent as the small-file path does: a failed open must not leave
+//! the file's name on an empty Untitled window, and a failed Revert of a
+//! big document must not detach it from its file.
+
+use std::os::unix::fs::PermissionsExt;
+use std::path::{Path, PathBuf};
+use std::time::{Duration, Instant};
+
+use aizome_kit::testing::Harness;
+use aizome_kit::WindowKey;
+use aizome_sumi::app::{Msg, Places, Sumi};
+
+fn scratch(name: &str) -> PathBuf {
+    let d = Path::new(env!("CARGO_TARGET_TMPDIR")).join("sumi-repro").join(name);
+    let _ = std::fs::remove_dir_all(&d);
+    std::fs::create_dir_all(&d).unwrap();
+    d
+}
+
+fn sumi() -> Harness<Sumi> {
+    let mut s = Sumi::new(Places::default());
+    s.open_links = false;
+    s.highlight_budget = Duration::from_secs(10);
+    Harness::new(s)
+}
+
+/// Wait for the read on its thread.
+fn settle_loaded(h: &mut Harness<Sumi>, w: WindowKey) {
+    let until = Instant::now() + Duration::from_secs(30);
+    while h.program().docs.get(&w).is_some_and(|d| d.loading.is_some()) {
+        assert!(Instant::now() < until, "timed out");
+        std::thread::sleep(Duration::from_millis(5));
+        h.send(Msg::Nothing);
+    }
+}
+
+fn write_big(path: &Path) {
+    let line = "a line of a big log file, long enough to add up quickly\n";
+    let text = line.repeat((3 << 20) / line.len());
+    std::fs::write(path, text).unwrap();
+}
+
+fn unreadable(path: &Path) -> bool {
+    std::fs::set_permissions(path, std::fs::Permissions::from_mode(0o000)).unwrap();
+    std::fs::File::open(path).is_err()
+}
+
+#[test]
+fn a_big_file_that_cant_be_read_does_not_leave_its_name_on_an_empty_window() {
+    let dir = scratch("smt18-open");
+    let file = dir.join("root-only.log");
+    write_big(&file);
+    if !unreadable(&file) {
+        eprintln!("running as root: the file stays readable; skipped");
+        return;
+    }
+    let mut h = sumi();
+    let w = h.window();
+    h.send(Msg::Opened(Some(vec![file.clone()])));
+    settle_loaded(&mut h, w);
+    assert!(h.texts(w).iter().any(|t| t.contains("couldn't be opened")), "the alert: {:?}", h.texts(w));
+    // Closing the window would do as well; kept, it must say what it holds.
+    if let Some(d) = h.program().docs.get(&w) {
+        assert_eq!(
+            (h.title(w), d.path.clone(), d.content.len_chars()),
+            (d.title(), None, 0),
+            "(window title, path, length): the title must name what the window holds"
+        );
+    }
+    let _ = std::fs::remove_file(&file);
+}
+
+#[test]
+fn a_failed_revert_keeps_the_document_on_its_file_whatever_its_size() {
+    let dir = scratch("smt18-revert");
+    let small = dir.join("small.txt");
+    std::fs::write(&small, "small\n").unwrap();
+    let big = dir.join("big.log");
+    write_big(&big);
+    let (small, big) = (small.canonicalize().unwrap(), big.canonicalize().unwrap());
+    let mut kept = Vec::new();
+    for file in [&small, &big] {
+        let mut h = sumi();
+        let w = h.window();
+        h.send(Msg::Opened(Some(vec![file.clone()])));
+        settle_loaded(&mut h, w);
+        assert_eq!(h.program().docs[&w].path.as_ref(), Some(file), "opened");
+        if !unreadable(file) {
+            eprintln!("running as root: the file stays readable; skipped");
+            return;
+        }
+        // Revert's alert button (and Reopen with Encoding) send this.
+        h.send(Msg::Reload(w, None));
+        settle_loaded(&mut h, w);
+        assert!(h.texts(w).iter().any(|t| t.contains("couldn't be opened")), "the alert");
+        let d = &h.program().docs[&w];
+        kept.push((file.file_name().unwrap().to_string_lossy().into_owned(), d.path.clone(), h.title(w)));
+        let _ = std::fs::set_permissions(file, std::fs::Permissions::from_mode(0o644));
+    }
+    assert_eq!(
+        kept,
+        vec![
+            ("small.txt".to_owned(), Some(small.clone()), "small.txt".to_owned()),
+            ("big.log".to_owned(), Some(big.clone()), "big.log".to_owned()),
+        ],
+        "(file, path after the failed Revert, title)"
+    );
+    let _ = std::fs::remove_file(&big);
+}
diff --git a/desktop/aizome/apps/sumi/tests/repro_smt_19.rs b/desktop/aizome/apps/sumi/tests/repro_smt_19.rs
new file mode 100644
index 00000000..9378b630
--- /dev/null
+++ b/desktop/aizome/apps/sumi/tests/repro_smt_19.rs
@@ -0,0 +1,108 @@
+//! SMT-19: find marks must not drift. With the find bar put away, an edit
+//! above a match must not leave highlights painted over other text; in a
+//! document over 1 MiB, ⌘G right after an edit must select a match of the
+//! text as it is now.
+
+use std::path::{Path, PathBuf};
+use std::time::{Duration, Instant};
+
+use aizome_kit::sidestep_ui::{Modifiers, NamedKey};
+use aizome_kit::testing::Harness;
+use aizome_kit::{EditorAction, Point, Selection, WindowKey};
+use aizome_sumi::app::{Command, Msg, Places, Sumi};
+
+fn scratch(name: &str) -> PathBuf {
+    let d = Path::new(env!("CARGO_TARGET_TMPDIR")).join("sumi-repro").join(name);
+    let _ = std::fs::remove_dir_all(&d);
+    std::fs::create_dir_all(&d).unwrap();
+    d
+}
+
+fn sumi() -> Harness<Sumi> {
+    let mut s = Sumi::new(Places::default());
+    s.open_links = false;
+    s.highlight_budget = Duration::from_secs(10);
+    Harness::new(s)
+}
+
+fn focus_editor(h: &mut Harness<Sumi>, w: WindowKey) {
+    h.focus_window(w, true);
+    let e = h.find_id(w, "editor").expect("the editor");
+    h.click(w, Point::new(e.x1 - 30.0, e.y1 - 10.0));
+}
+
+fn select(h: &mut Harness<Sumi>, w: WindowKey, anchor: usize, head: usize) {
+    h.send(Msg::Edit(w, EditorAction::Select(Selection { anchor, head })));
+}
+
+fn chars(text: &str, r: &std::ops::Range<usize>) -> String {
+    text.chars().skip(r.start).take(r.end - r.start).collect()
+}
+
+#[test]
+fn marks_left_after_the_find_bar_goes_do_not_drift_onto_other_text() {
+    let mut h = sumi();
+    let w = h.window();
+    focus_editor(&mut h, w);
+    h.type_text(w, "needle one\nneedle two\nthree\n");
+    h.command(w, 'f');
+    h.type_text(w, "needle");
+    assert_eq!(h.program().docs[&w].find.matches.len(), 2);
+    // Done (Escape), then type above the matches.
+    h.named(w, NamedKey::Escape, Modifiers::NONE);
+    assert!(!h.program().docs[&w].find.shown);
+    select(&mut h, w, 0, 0);
+    h.type_text(w, "a new first line\n");
+
+    // What the editor is given to paint as found text, over the text now.
+    let d = &h.program().docs[&w];
+    let text = d.content.text();
+    let covered: Vec<String> = d.find.matches.iter().map(|r| chars(&text, r)).collect();
+    // Whether it paints them: the window with these marks, and with none.
+    let with_marks = h.render_rgba(w, 1.0);
+    assert_eq!(with_marks, h.render_rgba(w, 1.0), "renders are stable");
+    h.send(Msg::On(w, Command::FindQuery(String::new())));
+    assert!(h.program().docs[&w].find.matches.is_empty());
+    let without = h.render_rgba(w, 1.0);
+    let painted = with_marks != without;
+    let drifted: Vec<&String> = covered.iter().filter(|c| *c != "needle").collect();
+    assert!(
+        !painted || drifted.is_empty(),
+        "after Done and an edit the editor paints {} mark(s) over {covered:?} in {text:?}",
+        covered.len()
+    );
+}
+
+#[test]
+fn find_next_right_after_an_edit_in_a_big_document_selects_a_current_match() {
+    let dir = scratch("smt19-big");
+    let file = dir.join("big.md");
+    let filler = "filler text that is not what is looked for\n".repeat((1 << 20) / 43 + 2000);
+    std::fs::write(&file, format!("needle at the top\n{filler}needle at the end\n")).unwrap();
+    assert!(std::fs::metadata(&file).unwrap().len() > 1 << 20 && std::fs::metadata(&file).unwrap().len() < 2 << 20);
+    let mut h = sumi();
+    let w = h.window();
+    h.send(Msg::Opened(Some(vec![file])));
+    h.send(Msg::On(w, Command::FindShow));
+    h.send(Msg::On(w, Command::FindQuery("needle".into())));
+    // The search runs on a thread above 1 MiB.
+    let until = Instant::now() + Duration::from_secs(30);
+    loop {
+        let d = &h.program().docs[&w];
+        if d.find.version == Some(d.content.version()) && d.find.matches.len() == 2 {
+            break;
+        }
+        assert!(Instant::now() < until, "timed out");
+        std::thread::sleep(Duration::from_millis(5));
+        h.send(Msg::Nothing);
+    }
+    // An edit at the very top, then ⌘G at once.
+    select(&mut h, w, 0, 0);
+    h.send(Msg::Edit(w, EditorAction::Insert("> ".into())));
+    assert!(h.program().docs[&w].content.text().starts_with("> needle at the top"));
+    h.send(Msg::On(w, Command::FindNext));
+    let d = &h.program().docs[&w];
+    let sel = d.content.selection().range();
+    let got = chars(&d.content.text(), &sel);
+    assert_eq!(got, "needle", "⌘G selected {sel:?}, {got:?}, rather than a match of the text as it is now");
+}
diff --git a/desktop/aizome/apps/tansu/tests/repro_tsh_25.rs b/desktop/aizome/apps/tansu/tests/repro_tsh_25.rs
new file mode 100644
index 00000000..9f94e3bb
--- /dev/null
+++ b/desktop/aizome/apps/tansu/tests/repro_tsh_25.rs
@@ -0,0 +1,58 @@
+//! TSH-25: Format… is open for a USB stick's partition when the stick is
+//! unplugged. Tansu falls back to another drive; the open sheet's segment
+//! index must not quietly name that drive's partition, and Add to Pending
+//! must not queue a format of it.
+//!
+//! The in-memory mock only (the sample disks, with the SD card listed
+//! first, so the drive fallen back to is another removable one). The stick
+//! "goes" by the mock's power-off, which removes it as UDisks would.
+
+use std::rc::Rc;
+
+use aizome_kit::testing::Harness;
+use tansu::app::{Msg, SheetKind, SheetMsg, Tansu};
+use tansu::backend::Backend;
+use tansu::mock::{self, Mock};
+use tansu::plan::Action;
+
+#[test]
+fn a_format_sheet_for_a_stick_that_goes_formats_nothing_else() {
+    let mut state = mock::sample();
+    let sd = state.drives.iter().position(|d| d.model == "SD SC64G").expect("the SD card");
+    let sd = state.drives.remove(sd);
+    state.drives.insert(0, sd);
+    let mock = Rc::new(Mock::new(state));
+    let mut h = Harness::new(Tansu::new(mock.clone()));
+
+    let key = h.program().drives.iter().find(|d| d.name.contains("Cruzer")).expect("the stick").key.clone();
+    h.send(Msg::SelectDrive(key.clone()));
+    let stick_disk = h.program().entry().and_then(|e| e.disk.clone()).expect("the stick's disk");
+    let i = h.program().layout.segs.iter().position(|s| s.short_name() == "sdc2").expect("sdc2");
+    h.send(Msg::SelectSeg(i));
+    h.send(Msg::Do(Action::Unmount));
+    h.send(Msg::Do(Action::Format));
+    let Some(SheetKind::Format(f)) = h.program().sheet.as_ref().map(|s| &s.kind) else { panic!("the format sheet") };
+    assert_eq!(f.seg, i);
+
+    // The stick is unplugged (UDisks drops it).
+    let _ = mock.power_off(&key);
+    h.send(Msg::Changed);
+    let names = h.program().layout.segs.get(i).map(|s| s.short_name());
+    let still_open = matches!(h.program().sheet.as_ref().map(|s| &s.kind), Some(SheetKind::Format(_)));
+    // Add to Pending.
+    if still_open {
+        h.send(Msg::Sheet(SheetMsg::Fs(0)));
+        h.send(Msg::Sheet(SheetMsg::Submit));
+    }
+    let t = h.program();
+    let wrong: Vec<String> =
+        t.plan.ops.iter().filter(|o| o.disk != stick_disk).map(|o| format!("{} on {}", tansu::plan::verb(&o.kind), o.device)).collect();
+    let typed = t.disks_to_type();
+    assert!(
+        wrong.is_empty(),
+        "the gone stick's Format sheet (its segment now {names:?} on {:?}) queued {wrong:?}; Apply would ask \
+         to type {typed:?}",
+        t.entry().map(|e| e.name.clone())
+    );
+    assert!(mock.calls().iter().all(|c| !c.starts_with("Format")), "{:?}", mock.calls());
+}
diff --git a/desktop/aizome/apps/tansu/tests/repro_tsh_26.rs b/desktop/aizome/apps/tansu/tests/repro_tsh_26.rs
new file mode 100644
index 00000000..c576c8fd
--- /dev/null
+++ b/desktop/aizome/apps/tansu/tests/repro_tsh_26.rs
@@ -0,0 +1,187 @@
+//! TSH-26: while the pending operations run, a second `aizome-tansu
+//! image.iso` hands its path over, and the Attach sheet replaces the
+//! Running sheet. Once the run ends and that sheet is dismissed, Tansu must
+//! be usable again (not "Wait for the operations to finish." for good).
+//!
+//! The in-memory mock behind a stand-in that reports its changes late (as
+//! UDisks does while a step's effect is on its way), so the run is still
+//! under way when the hand-over comes. No real device is involved.
+
+use std::cell::RefCell;
+use std::path::{Path, PathBuf};
+use std::rc::Rc;
+use std::sync::Arc;
+
+use aizome_kit::testing::Harness;
+use aizome_sys::Task;
+use aizome_sys::disks::{
+    Confirm, DeletePartition, DisksState, Format, FormatSpec, NewPartitionTable, Repair, Resize, SelfTest,
+    SmartAttribute, TableKind,
+};
+use tansu::app::{Msg, SheetKind, SheetMsg, Tansu};
+use tansu::backend::Backend;
+use tansu::mock::Mock;
+use tansu::plan::Action;
+
+/// The mock, whose state can be held as it was for a while.
+struct Late {
+    inner: Rc<Mock>,
+    held: RefCell<Option<(Arc<DisksState>, u64)>>,
+}
+
+impl Late {
+    fn hold(&self) {
+        *self.held.borrow_mut() = Some((self.inner.snapshot(), self.inner.generation()));
+    }
+    fn release(&self) {
+        *self.held.borrow_mut() = None;
+    }
+}
+
+impl Backend for Late {
+    fn snapshot(&self) -> Arc<DisksState> {
+        self.held.borrow().as_ref().map_or_else(|| self.inner.snapshot(), |(s, _)| s.clone())
+    }
+    fn generation(&self) -> u64 {
+        self.held.borrow().as_ref().map_or_else(|| self.inner.generation(), |(_, g)| *g)
+    }
+    fn mount(&self, block: &str) -> Task<String> {
+        self.inner.mount(block)
+    }
+    fn unmount(&self, block: &str) -> Task<()> {
+        self.inner.unmount(block)
+    }
+    fn unlock(&self, block: &str, passphrase: &str) -> Task<String> {
+        self.inner.unlock(block, passphrase)
+    }
+    fn lock(&self, block: &str) -> Task<()> {
+        self.inner.lock(block)
+    }
+    fn set_swap(&self, block: &str, on: bool) -> Task<()> {
+        self.inner.set_swap(block, on)
+    }
+    fn power_off(&self, drive: &str) -> Task<()> {
+        self.inner.power_off(drive)
+    }
+    fn loop_setup(&self, file: &Path, read_only: bool) -> Task<String> {
+        self.inner.loop_setup(file, read_only)
+    }
+    fn loop_delete(&self, block: &str) -> Task<()> {
+        self.inner.loop_delete(block)
+    }
+    fn check(&self, block: &str) -> Task<bool> {
+        self.inner.check(block)
+    }
+    fn smart_update(&self, drive: &str) -> Task<()> {
+        self.inner.smart_update(drive)
+    }
+    fn smart_attributes(&self, drive: &str) -> Task<Vec<SmartAttribute>> {
+        self.inner.smart_attributes(drive)
+    }
+    fn smart_selftest(&self, drive: &str, test: SelfTest) -> Task<()> {
+        self.inner.smart_selftest(drive, test)
+    }
+    fn cancel_job(&self, job: &str) -> Task<()> {
+        self.inner.cancel_job(job)
+    }
+    fn can_format(&self, fs: &str) -> Task<(bool, String)> {
+        self.inner.can_format(fs)
+    }
+    fn create_partition_table(&self, confirm: Confirm<NewPartitionTable>, kind: TableKind) -> Task<()> {
+        self.inner.create_partition_table(confirm, kind)
+    }
+    fn create_partition(
+        &self,
+        table: &str,
+        offset: u64,
+        size: u64,
+        type_id: Option<&str>,
+        name: &str,
+        format: Option<FormatSpec>,
+    ) -> Task<String> {
+        self.inner.create_partition(table, offset, size, type_id, name, format)
+    }
+    fn delete_partition(&self, confirm: Confirm<DeletePartition>) -> Task<()> {
+        self.inner.delete_partition(confirm)
+    }
+    fn format(&self, confirm: Confirm<Format>, spec: FormatSpec) -> Task<()> {
+        self.inner.format(confirm, spec)
+    }
+    fn resize_partition(&self, confirm: Confirm<Resize>, size: u64) -> Task<()> {
+        self.inner.resize_partition(confirm, size)
+    }
+    fn resize_filesystem(&self, confirm: Confirm<Resize>, size: u64) -> Task<()> {
+        self.inner.resize_filesystem(confirm, size)
+    }
+    fn repair(&self, confirm: Confirm<Repair>) -> Task<bool> {
+        self.inner.repair(confirm)
+    }
+    fn set_label(&self, block: &str, label: &str) -> Task<()> {
+        self.inner.set_label(block, label)
+    }
+    fn set_partition_type(&self, block: &str, type_id: &str) -> Task<()> {
+        self.inner.set_partition_type(block, type_id)
+    }
+    fn set_partition_flags(&self, block: &str, flags: u64) -> Task<()> {
+        self.inner.set_partition_flags(block, flags)
+    }
+}
+
+fn sheet_kind(h: &Harness<Tansu>) -> Option<&'static str> {
+    h.program().sheet.as_ref().map(|s| match s.kind {
+        SheetKind::Running => "running",
+        SheetKind::Attach { .. } => "attach",
+        SheetKind::Apply(_) => "apply",
+        SheetKind::Label { .. } => "label",
+        _ => "other",
+    })
+}
+
+#[test]
+fn a_hand_over_during_a_run_leaves_tansu_usable_once_it_ends() {
+    let mock = Rc::new(Mock::default());
+    let late = Rc::new(Late { inner: mock.clone(), held: RefCell::new(None) });
+    let mut h = Harness::new(Tansu::new(late.clone()));
+    let key = h.program().drives.iter().find(|d| d.name.contains("Cruzer")).expect("the stick").key.clone();
+    h.send(Msg::SelectDrive(key));
+    let i = h.program().layout.segs.iter().position(|s| s.short_name() == "sdc1").expect("sdc1");
+    h.send(Msg::SelectSeg(i));
+    h.send(Msg::Do(Action::Label));
+    h.send(Msg::Sheet(SheetMsg::Label("PHOTOS".into())));
+    h.send(Msg::Sheet(SheetMsg::Submit));
+    assert_eq!(h.program().plan.len(), 1);
+    h.send(Msg::Apply);
+    assert_eq!(sheet_kind(&h), Some("apply"));
+
+    // UDisks is slow to say the label changed: the run waits for it.
+    late.hold();
+    h.send(Msg::Sheet(SheetMsg::Submit));
+    assert_eq!(sheet_kind(&h), Some("running"));
+    assert!(h.program().run.as_ref().is_some_and(|r| r.is_running()), "the run is under way");
+
+    // A second launch hands over an image.
+    h.send(Msg::Launched(vec![PathBuf::from("/nonexistent/sekka-nightly.iso")]));
+    let during = sheet_kind(&h);
+
+    // UDisks reports the change: the run ends.
+    late.release();
+    h.send(Msg::Tick);
+    let ended = h.program().run.as_ref().is_none_or(|r| !r.is_running());
+    // The person dismisses the Attach sheet, and does something else.
+    h.send(Msg::CloseSheet);
+    h.send(Msg::TogglePending);
+    h.send(Msg::TogglePending);
+    let t = h.program();
+    let can = t.can(Action::Label).map(|_| ());
+    let notice = t.notice.clone();
+    let sheet = sheet_kind(&h);
+    let run_left = h.program().run.is_some();
+    assert_eq!(mock.calls(), ["SetLabel(PHOTOS) /dev/sdc1"]);
+    assert!(ended, "the run ended");
+    assert_eq!(sheet, None);
+    assert!(
+        can.is_ok() && !run_left,
+        "after the run ended under the {during:?} sheet, Tansu is stuck: {can:?} (run kept: {run_left}), \
+         the status line still says {notice:?}"
+    );
+}
diff --git a/desktop/aizome/apps/tenki/tests/repro_smt_24.rs b/desktop/aizome/apps/tenki/tests/repro_smt_24.rs
new file mode 100644
index 00000000..19926523
--- /dev/null
+++ b/desktop/aizome/apps/tenki/tests/repro_smt_24.rs
@@ -0,0 +1,70 @@
+//! SMT-24: once the user turns the current location off (or removes its
+//! row), the last GeoClue position must not stay in `state.json`, nor be
+//! written there again when a place is chosen. Recorded services only: no
+//! network, no GeoClue.
+
+use std::path::{Path, PathBuf};
+use std::sync::Arc;
+
+use aizome_kit::testing::Harness;
+use aizome_tenki::location::Located;
+use aizome_tenki::places::{CURRENT_ID, Origin, Place, parse_search};
+use aizome_tenki::services::{Recorded, Services};
+use aizome_tenki::store::{Consent, Settings, State, Store};
+use aizome_tenki::units::Units;
+use aizome_tenki::{Msg, Tenki};
+
+fn fixtures() -> PathBuf {
+    Path::new(env!("CARGO_MANIFEST_DIR")).join("tests/fixtures")
+}
+
+fn place(search: &str) -> Place {
+    let body = std::fs::read_to_string(fixtures().join(format!("search-{}.json", search.to_lowercase()))).unwrap();
+    parse_search(&body).unwrap().remove(0).place(Origin::Search)
+}
+
+fn store(name: &str) -> Store {
+    let root = Path::new(env!("CARGO_TARGET_TMPDIR")).join("tenki-repro").join(name);
+    let _ = std::fs::remove_dir_all(&root);
+    let s = Store::at(&root);
+    let tokyo = place("Tokyo");
+    s.save_places(&[tokyo.clone(), place("Chicago")]);
+    s.save_state(&State { selected: Some(tokyo.id), located: None });
+    s.save_settings(&Settings { units: Some(Units::Metric), location: Consent::Declined });
+    s
+}
+
+#[test]
+fn turning_the_current_location_off_forgets_the_position_on_disk() {
+    let mut seen = Vec::new();
+    let mut memory = Vec::new();
+    for (name, off) in [("toggle", Msg::ToggleLocation), ("remove", Msg::Remove(0)), ("decline", Msg::DeclineLocation)]
+    {
+        let r = Recorded::new(fixtures());
+        r.set_timezone(Some("America/Chicago"));
+        r.set_located(Ok(Located { latitude: 35.6901, longitude: 139.6922, accuracy: 4000.0, description: None }));
+        let r = Arc::new(r);
+        let s = store(&format!("smt24-{name}"));
+        let mut h = Harness::new(Tenki::new(r.clone() as Arc<dyn Services>, Some(s.clone())));
+        h.send(Msg::AllowLocation);
+        assert_eq!(h.program().rows()[0].id, CURRENT_ID);
+        assert!(s.load_state().located.is_some(), "allowed: the position is kept");
+        // Show Current Location off / its row removed / Not Now.
+        h.send(off);
+        assert_eq!(h.program().settings.location, Consent::Declined);
+        let after_off = s.load_state().located;
+        // Say turning it off had cleared the file: choosing another place
+        // must not write the position back.
+        s.save_state(&State { selected: h.program().selected.clone(), located: None });
+        let chicago = h.program().rows().iter().position(|p| p.name == "Chicago").unwrap();
+        h.send(Msg::Select(chicago));
+        assert_eq!(h.program().selected_place().map(|p| p.name), Some("Chicago".to_owned()));
+        seen.push((name, after_off, s.load_state().located));
+        memory.push((name, h.program().current.as_ref().map(|p| (p.latitude, p.longitude))));
+    }
+    assert_eq!(
+        seen,
+        vec![("toggle", None, None), ("remove", None, None), ("decline", None, None)],
+        "(how, state.json's position after turning it off, after choosing a place); held in memory: {memory:?}"
+    );
+}
diff --git a/desktop/aizome/apps/tokei/tests/repro_ntu_17.rs b/desktop/aizome/apps/tokei/tests/repro_ntu_17.rs
new file mode 100644
index 00000000..f4757e41
--- /dev/null
+++ b/desktop/aizome/apps/tokei/tests/repro_ntu_17.rs
@@ -0,0 +1,91 @@
+//! NTU-17: a once-alarm is ringing (its service runs `aizome-tokei --ring`)
+//! when the person opens Tokei (the notification names Tokei). Tokei's
+//! launch syncs the alarms: it must not stop the ringing alarm's service.
+//!
+//! Tokei's real `Systemd` scheduler, over stand-in `systemctl` and
+//! `systemd-run` first on PATH that keep units as files in a folder of the
+//! test's own (`stop` removes them). No user manager is asked anything.
+
+use std::os::unix::fs::PermissionsExt;
+use std::path::{Path, PathBuf};
+
+use aizome_kit::testing::Harness;
+use aizome_tokei::alarms::{self, Alarm, Systemd};
+use aizome_tokei::app::Tokei;
+use aizome_tokei::clock::Clock;
+use aizome_tokei::sound::Silent;
+use jiff::tz::TimeZone;
+
+fn script(path: &Path, body: &str) {
+    std::fs::write(path, body).unwrap();
+    std::fs::set_permissions(path, std::fs::Permissions::from_mode(0o755)).unwrap();
+}
+
+#[test]
+fn opening_tokei_while_an_alarm_rings_leaves_its_ring_running() {
+    let dir = std::env::temp_dir().join(format!("tokei-repro-ntu17-{}", std::process::id()));
+    let _ = std::fs::remove_dir_all(&dir);
+    let bin = dir.join("bin");
+    let units = dir.join("units");
+    std::fs::create_dir_all(&bin).unwrap();
+    std::fs::create_dir_all(&units).unwrap();
+    let (d, u) = (dir.display(), units.display());
+    script(
+        &bin.join("systemctl"),
+        &format!(
+            r#"#!/bin/sh
+echo "systemctl $*" >> '{d}/calls'
+[ "$1" = --user ] && shift
+verb=$1; shift
+case "$verb" in
+  stop) for unit in "$@"; do rm -f '{u}'/"$unit"; done ;;
+  list-units) for f in '{u}'/*.timer; do [ -e "$f" ] && echo "$(basename "$f") loaded active waiting Aizome alarm"; done ;;
+esac
+exit 0
+"#
+        ),
+    );
+    script(
+        &bin.join("systemd-run"),
+        &format!(
+            r#"#!/bin/sh
+echo "systemd-run $*" >> '{d}/calls'
+for a in "$@"; do case "$a" in --unit=*) touch '{u}'/"${{a#--unit=}}.timer" ;; esac; done
+exit 0
+"#
+        ),
+    );
+    let path = std::env::var("PATH").unwrap_or_default();
+    // SAFETY: the only test in this binary.
+    unsafe { std::env::set_var("PATH", format!("{}:{path}", bin.display())) };
+
+    // Tea, once at 21:42, fired at 21:42:00 Berlin: its timer has elapsed
+    // and its service rings (`--ring 0000beef`, notification up).
+    let tea = Alarm { id: "0000beef".into(), label: "Tea".into(), hour: 21, minute: 42, ..Alarm::default() };
+    let alarms_path = dir.join("alarms.json");
+    alarms::save(&alarms_path, std::slice::from_ref(&tea)).unwrap();
+    let ringing = units.join("aizome-alarm-0000beef.service");
+    std::fs::write(&ringing, "").unwrap();
+
+    // The person opens Tokei 30 s into the ring.
+    let sched = Systemd { exe: PathBuf::from("/nonexistent/aizome-tokei") };
+    let mut app = Tokei::new(None, Some(alarms_path.clone()), Box::new(sched), Box::new(Silent::default()));
+    let (c, _time) = Clock::fake("2026-10-17T19:42:30Z".parse().unwrap());
+    app.clock = c;
+    app.now = app.clock.now();
+    app.local = TimeZone::get("Europe/Berlin").unwrap();
+    app.quiet = true;
+    let h = Harness::new(app);
+    let calls = std::fs::read_to_string(dir.join("calls")).unwrap_or_default();
+    let still_ringing = ringing.exists();
+    let armed: Vec<String> =
+        calls.lines().filter(|l| l.starts_with("systemd-run")).map(|l| l.to_owned()).collect::<Vec<_>>();
+    drop(h);
+    let _ = std::fs::remove_dir_all(&dir);
+    assert!(!calls.is_empty(), "the stand-ins were asked");
+    assert!(
+        still_ringing,
+        "Tokei's launch stopped the ringing alarm's service (its --ring) before it could turn the alarm off.\n\
+         calls:\n{calls}\nre-armed: {armed:?}"
+    );
+}
diff --git a/desktop/aizome/apps/tokei/tests/repro_ntu_19.rs b/desktop/aizome/apps/tokei/tests/repro_ntu_19.rs
new file mode 100644
index 00000000..de82e983
--- /dev/null
+++ b/desktop/aizome/apps/tokei/tests/repro_ntu_19.rs
@@ -0,0 +1,59 @@
+//! NTU-19: Tokei is open while a once-alarm rings and is stopped; the ring
+//! process turns the alarm off in alarms.json. Turning another alarm off in
+//! the window must not save the window's stale list over that.
+//!
+//! The real ring (`ring::ring_with`, a scripted Stop) and the real window,
+//! with the recording scheduler.
+
+use std::path::PathBuf;
+
+use aizome_kit::testing::Harness;
+use aizome_tokei::alarms::{self, Alarm, Recorder};
+use aizome_tokei::app::{Msg, Tokei};
+use aizome_tokei::clock::Clock;
+use aizome_tokei::ring::{self, Answer, Scripted};
+use aizome_tokei::sound::Silent;
+use jiff::tz::TimeZone;
+
+#[test]
+fn a_rung_once_alarm_stays_off_when_the_open_window_saves() {
+    let dir: PathBuf = std::env::temp_dir().join(format!("tokei-repro-ntu19-{}", std::process::id()));
+    let _ = std::fs::remove_dir_all(&dir);
+    let path = dir.join("alarms.json");
+    let tea = Alarm { id: "0000beef".into(), label: "Tea".into(), hour: 21, minute: 42, ..Alarm::default() };
+    let gym =
+        Alarm { id: "0000cafe".into(), label: "Gym".into(), hour: 7, minute: 0, days: vec![1, 3, 5], ..Alarm::default() };
+    alarms::save(&path, &[tea, gym]).unwrap();
+    let mut app = Tokei::new(None, Some(path.clone()), Box::new(Recorder::new()), Box::new(Silent::default()));
+    let (c, _time) = Clock::fake("2026-10-17T19:40:00Z".parse().unwrap());
+    app.clock = c;
+    app.now = app.clock.now();
+    app.local = TimeZone::get("Europe/Berlin").unwrap();
+    app.quiet = true;
+    let mut h = Harness::new(app);
+
+    // Tea rings while the window is open, and is stopped: the ring turns
+    // the once-alarm off in the file.
+    let mut n = Scripted { posted: Vec::new(), answer: Some(Answer::Stop), closed: false };
+    ring::ring_with(&path, "0000beef", &mut n, &mut Silent::default(), &mut Recorder::new(), ring::RING_FOR);
+    assert!(!alarms::load(&path).iter().find(|a| a.id == "0000beef").unwrap().enabled, "the ring turned Tea off");
+
+    // The person turns Gym off.
+    let gym = h.program().alarms.iter().position(|a| a.id == "0000cafe").unwrap();
+    let window_says_tea_on = h.program().alarms.iter().find(|a| a.id == "0000beef").unwrap().enabled;
+    h.send(Msg::ToggleAlarm(gym, false));
+
+    let saved = alarms::load(&path);
+    let tea = saved.iter().find(|a| a.id == "0000beef").unwrap().clone();
+    // What the next launch or login `--sync` would schedule.
+    let mut next = Recorder::new();
+    alarms::sync(&mut next, &saved, "2026-10-17T20:00:00Z".parse().unwrap(), &TimeZone::get("Europe/Berlin").unwrap());
+    drop(h);
+    let _ = std::fs::remove_dir_all(&dir);
+    assert!(
+        !tea.enabled,
+        "turning Gym off saved the window's stale list: Tea is on again (window showed it on: {window_says_tea_on}); \
+         the next sync arms {:?}",
+        next.units()
+    );
+}
diff --git a/desktop/aizome/apps/utsushi/tests/repro_ntu_26.rs b/desktop/aizome/apps/utsushi/tests/repro_ntu_26.rs
new file mode 100644
index 00000000..8ecd14ff
--- /dev/null
+++ b/desktop/aizome/apps/utsushi/tests/repro_ntu_26.rs
@@ -0,0 +1,126 @@
+//! NTU-26: a long film is playing at 3:20 when another file is opened (Open,
+//! a drop, Open Recent or a second launch). The film's place is kept; the
+//! new file must not be remembered at the film's place, nor start there
+//! "Resumed".
+//!
+//! The real window and player (decoding in software, the null output), a
+//! film made here as a quiet WAV long enough to be remembered, and the
+//! engine's song fixture as the other file.
+
+use std::path::{Path, PathBuf};
+use std::time::{Duration, Instant};
+
+use aizome_kit::testing::Harness;
+use aizome_utsushi::Utsushi;
+use aizome_utsushi::app::{Msg, Status};
+
+fn fixture(name: &str) -> PathBuf {
+    PathBuf::from(env!("CARGO_MANIFEST_DIR")).join("../../crates/aizome-media/tests/fixtures").join(name)
+}
+
+/// `secs` seconds of quiet: 8 kHz, mono, unsigned 8-bit PCM.
+fn quiet_wav(path: &Path, secs: u32) {
+    let rate = 8000u32;
+    let n = rate * secs;
+    let mut b = Vec::with_capacity(44 + n as usize);
+    b.extend_from_slice(b"RIFF");
+    b.extend_from_slice(&(36 + n).to_le_bytes());
+    b.extend_from_slice(b"WAVEfmt ");
+    b.extend_from_slice(&16u32.to_le_bytes());
+    b.extend_from_slice(&1u16.to_le_bytes()); // PCM
+    b.extend_from_slice(&1u16.to_le_bytes()); // mono
+    b.extend_from_slice(&rate.to_le_bytes());
+    b.extend_from_slice(&rate.to_le_bytes()); // bytes a second
+    b.extend_from_slice(&1u16.to_le_bytes()); // block align
+    b.extend_from_slice(&8u16.to_le_bytes()); // bits
+    b.extend_from_slice(b"data");
+    b.extend_from_slice(&n.to_le_bytes());
+    b.resize(44 + n as usize, 128);
+    std::fs::write(path, b).unwrap();
+}
+
+fn until(h: &mut Harness<Utsushi>, secs: f64, mut f: impl FnMut(&Utsushi) -> bool) {
+    let end = Instant::now() + Duration::from_secs_f64(secs * 5.0);
+    loop {
+        h.send_all(std::iter::empty());
+        if f(h.program()) {
+            return;
+        }
+        let a = h.program();
+        assert!(Instant::now() < end, "timed out: status {:?}, error {:?}, at {}", a.status, a.error, a.pos);
+        std::thread::sleep(Duration::from_millis(10));
+    }
+}
+
+fn key(p: &Path) -> String {
+    std::fs::canonicalize(p).unwrap().to_string_lossy().into_owned()
+}
+
+#[test]
+fn opening_another_file_does_not_give_it_the_films_place() {
+    let dir = std::env::temp_dir().join(format!("utsushi-repro-ntu26-{}", std::process::id()));
+    let _ = std::fs::remove_dir_all(&dir);
+    std::fs::create_dir_all(&dir).unwrap();
+    let film = dir.join("film.wav");
+    quiet_wav(&film, 400); // 6:40
+    let mut app = Utsushi::new();
+    app.null_audio = true;
+    app.state_dir = Some(dir.join("state"));
+    let mut h = Harness::new(app);
+
+    h.send(Msg::Open(vec![film.clone()]));
+    until(&mut h, 5.0, |a| a.status == Status::Playing && a.duration() > 300.0);
+    h.send(Msg::SeekTo(200.0));
+    until(&mut h, 5.0, |a| a.player.as_ref().is_some_and(|p| p.position() >= 199.0));
+
+    // Another file, opened while the film plays at 3:20.
+    let song = fixture("song.flac");
+    h.send(Msg::Open(vec![song.clone()]));
+    let a = h.program();
+    let song_left = a.store.positions.get(&key(&song)).cloned();
+    let film_left = a.store.positions.get(&key(&film)).cloned();
+    let resumed = a.resumed;
+    drop(h);
+    let _ = std::fs::remove_dir_all(&dir);
+
+    assert!(film_left.is_some_and(|l| (l.position - 200.0).abs() < 5.0), "the film's own place is kept");
+    assert!(
+        song_left.is_none() && resumed.is_none(),
+        "the new file was remembered at the film's place and length ({song_left:?}) and started \
+         \"Resumed at\" {resumed:?}"
+    );
+}
+
+/// The variant: the first item had ended. Opening a film that has a
+/// place of its own must start it there, not forget the place.
+#[test]
+fn opening_a_film_after_one_ended_keeps_the_films_own_place() {
+    let dir = std::env::temp_dir().join(format!("utsushi-repro-ntu26-ended-{}", std::process::id()));
+    let _ = std::fs::remove_dir_all(&dir);
+    std::fs::create_dir_all(dir.join("state")).unwrap();
+    let film = dir.join("film.wav");
+    quiet_wav(&film, 400);
+    // Left at 1:40 last time.
+    let positions = format!("{{\"{}\": {{\"position\": 100.0, \"duration\": 400.0, \"at\": 1}}}}", key(&film));
+    std::fs::write(dir.join("state/positions.json"), positions).unwrap();
+    let mut app = Utsushi::new();
+    app.null_audio = true;
+    app.state_dir = Some(dir.join("state"));
+    let mut h = Harness::new(app);
+    assert!(h.program().store.positions.contains_key(&key(&film)), "the film's place is remembered");
+
+    // A short clip plays to its end.
+    h.send(Msg::Open(vec![fixture("song.flac")]));
+    until(&mut h, 5.0, |a| a.status == Status::Ended);
+    // Then the film is opened.
+    h.send(Msg::Open(vec![film.clone()]));
+    let a = h.program();
+    let film_left = a.store.positions.get(&key(&film)).cloned();
+    let resumed = a.resumed;
+    drop(h);
+    let _ = std::fs::remove_dir_all(&dir);
+    assert!(
+        resumed == Some(100.0) && film_left.is_some(),
+        "the ended clip's leave() was recorded under the film: its place is {film_left:?}, it starts at {resumed:?}"
+    );
+}
diff --git a/desktop/aizome/apps/yukimi/tests/repro_yuk_15.rs b/desktop/aizome/apps/yukimi/tests/repro_yuk_15.rs
new file mode 100644
index 00000000..04f16ce1
--- /dev/null
+++ b/desktop/aizome/apps/yukimi/tests/repro_yuk_15.rs
@@ -0,0 +1,206 @@
+//! YUK-15: the package index follows the system's Nixpkgs.
+//!
+//! Yukimi reads a stand-in system (`Source::System` on a temporary `/etc`,
+//! looking only) whose facts name a Nixpkgs, with the package index cache
+//! in a temporary `XDG_CACHE_HOME` and a stand-in `nix` first on `PATH`
+//! that answers `nix eval` for the index from files (or fails), so no real
+//! Nix evaluation runs. Background reads of the real store database and
+//! profiles are read-only, as in `headless.rs`'s
+//! `nothing_is_changed_when_looking_at_another_system`.
+use std::path::{Path, PathBuf};
+use std::sync::{Arc, Mutex};
+use std::time::Duration;
+
+use aizome_kit::testing::Harness;
+use aizome_yukimi::app::{Clock, Msg, Page, Runner, Source, Yukimi};
+use aizome_yukimi::ops::Operation;
+
+static SERIAL: Mutex<()> = Mutex::new(());
+
+const STUB: &str = r#"#!/bin/sh
+# Stand-in for nix: answers the package index's `nix eval`, nothing else.
+dir="$REPRO_YUK15"
+case "$*" in
+  *" eval "*) ;;
+  *) exit 1 ;;
+esac
+for name in nixpkgs-A nixpkgs-B; do
+  case "$*" in
+    *"import $dir/$name "*)
+      echo "$name" >> "$dir/evals"
+      if [ -e "$dir/fail-$name" ]; then echo "error: evaluation of $name aborted" >&2; exit 1; fi
+      touch "$dir/started-$name"
+      while [ ! -e "$dir/release-$name" ]; do sleep 0.01; done
+      cat "$dir/index-$name.json"
+      exit 0 ;;
+  esac
+done
+echo "error: unknown nixpkgs" >&2
+exit 1
+"#;
+
+fn package(version: &str) -> String {
+    format!(
+        r#"[{{"attr":"hello","pname":"hello","version":"{version}","description":"Says hello","available":true}}]"#
+    )
+}
+
+/// A system configured with channels whose facts name `nixpkgs-A`, the
+/// stand-in `nix`, and an empty cache.
+struct System {
+    dir: PathBuf,
+}
+
+impl System {
+    fn new(tag: &str) -> System {
+        let dir = std::env::temp_dir().join(format!("repro-yuk-15-{tag}-{}", std::process::id()));
+        let _ = std::fs::remove_dir_all(&dir);
+        for sub in ["etc/nixos", "etc/yukimi", "bin", "cache", "nixpkgs-A", "nixpkgs-B"] {
+            std::fs::create_dir_all(dir.join(sub)).unwrap();
+        }
+        std::fs::write(dir.join("etc/nixos/configuration.nix"), "{ ... }: { }\n").unwrap();
+        std::fs::write(dir.join("index-nixpkgs-A.json"), package("2.10")).unwrap();
+        std::fs::write(dir.join("index-nixpkgs-B.json"), package("2.12")).unwrap();
+        std::fs::write(dir.join("bin/nix"), STUB).unwrap();
+        use std::os::unix::fs::PermissionsExt;
+        std::fs::set_permissions(dir.join("bin/nix"), std::fs::Permissions::from_mode(0o755)).unwrap();
+        let system = System { dir };
+        system.use_nixpkgs("nixpkgs-A");
+        let path = format!("{}:{}", system.dir.join("bin").display(), std::env::var("PATH").unwrap_or_default());
+        // SAFETY: tests here hold SERIAL; set before any harness thread starts.
+        unsafe {
+            std::env::set_var("PATH", path);
+            std::env::set_var("XDG_CACHE_HOME", system.dir.join("cache"));
+            std::env::set_var("REPRO_YUK15", &system.dir);
+            std::env::remove_var("XDG_CURRENT_DESKTOP");
+        }
+        system
+    }
+    fn nixpkgs(&self, name: &str) -> String {
+        self.dir.join(name).to_string_lossy().into_owned()
+    }
+    /// A live update moved the system to another Nixpkgs.
+    fn use_nixpkgs(&self, name: &str) {
+        std::fs::write(
+            self.dir.join("etc/yukimi/system.json"),
+            format!(r#"{{"nixpkgs":"{}","catalogs":[],"choices":[]}}"#, self.nixpkgs(name)),
+        )
+        .unwrap();
+    }
+    fn cache_index(&self, name: &str) {
+        let cache = self.dir.join("cache/aizome/yukimi");
+        std::fs::create_dir_all(&cache).unwrap();
+        std::fs::copy(self.dir.join(format!("index-{name}.json")), cache.join(format!("packages-{name}.json"))).unwrap();
+    }
+    fn touch(&self, name: &str) {
+        std::fs::write(self.dir.join(name), "").unwrap();
+    }
+    fn evals(&self) -> Vec<String> {
+        std::fs::read_to_string(self.dir.join("evals")).unwrap_or_default().lines().map(str::to_owned).collect()
+    }
+    fn harness(&self) -> Harness<Yukimi> {
+        let paths = aizome_yukimi::paths::Paths { etc: self.dir.join("etc"), elsewhere: true };
+        let runner = Runner::Mock(Arc::new(|_: &Operation| panic!("reading must not run an operation")));
+        let mut app = Yukimi::with(Source::System(paths), runner, Clock::System);
+        app.auto_check = false;
+        let mut h = Harness::new(app);
+        assert!(h.settle(Duration::from_secs(10), |a| !a.loading), "read the stand-in system");
+        h
+    }
+}
+
+impl Drop for System {
+    fn drop(&mut self) {
+        let _ = std::fs::remove_dir_all(&self.dir);
+    }
+}
+
+fn hello(app: &Yukimi) -> Option<String> {
+    app.index.as_ref().and_then(|i| i.get("hello")).map(|p| p.version.clone())
+}
+
+fn wait_for(path: &Path) {
+    let start = std::time::Instant::now();
+    while !path.exists() {
+        assert!(start.elapsed() < Duration::from_secs(10), "{} never appeared", path.display());
+        std::thread::sleep(Duration::from_millis(5));
+    }
+}
+
+/// Reload after the system's Nixpkgs moved, and let it read.
+fn moved_to_b(h: &mut Harness<Yukimi>, system: &System) {
+    system.use_nixpkgs("nixpkgs-B");
+    h.send(Msg::Reload);
+    let b = system.nixpkgs("nixpkgs-B");
+    assert!(
+        h.settle(Duration::from_secs(10), |a| !a.loading && a.model.nixpkgs.as_deref() == Some(b.as_str())),
+        "read the moved system"
+    );
+}
+
+#[test]
+fn repro_yuk_15_live_update_keeps_old_index() {
+    let _serial = SERIAL.lock().unwrap_or_else(|p| p.into_inner());
+    let system = System::new("live");
+    system.cache_index("nixpkgs-A");
+    system.cache_index("nixpkgs-B");
+    let mut h = system.harness();
+    h.send(Msg::Show(Page::Discover));
+    assert!(h.settle(Duration::from_secs(10), |a| a.index.is_some() && !a.indexing), "loaded A's index");
+    assert_eq!(hello(h.program()).as_deref(), Some("2.10"), "A's index first");
+    moved_to_b(&mut h, &system);
+    assert!(h.settle(Duration::from_secs(10), |a| !a.indexing), "index settled");
+    assert_eq!(
+        hello(h.program()).as_deref(),
+        Some("2.12"),
+        "system now uses nixpkgs-B; index still A's (stale flag {})",
+        h.program().index_stale
+    );
+}
+
+#[test]
+fn repro_yuk_15_late_index_for_old_nixpkgs_marked_current() {
+    let _serial = SERIAL.lock().unwrap_or_else(|p| p.into_inner());
+    let system = System::new("late");
+    system.touch("release-nixpkgs-B");
+    let mut h = system.harness();
+    h.send(Msg::Show(Page::Discover));
+    // A's index is being made (no cache): Nix is busy with it.
+    wait_for(&system.dir.join("started-nixpkgs-A"));
+    assert!(h.program().indexing);
+    moved_to_b(&mut h, &system);
+    // A's evaluation finishes now.
+    system.touch("release-nixpkgs-A");
+    assert!(h.settle(Duration::from_secs(10), |a| a.index.is_some() && !a.indexing), "index settled");
+    let app = h.program();
+    assert!(
+        hello(app).as_deref() == Some("2.12") || app.index_stale,
+        "system uses nixpkgs-B, but A's late index is in use (hello {:?}) and marked current (stale {}); evals {:?}",
+        hello(app),
+        app.index_stale,
+        system.evals()
+    );
+}
+
+#[test]
+fn repro_yuk_15_failed_index_remade_per_keystroke() {
+    let _serial = SERIAL.lock().unwrap_or_else(|p| p.into_inner());
+    let system = System::new("fails");
+    system.touch("fail-nixpkgs-A");
+    let mut h = system.harness();
+    h.send(Msg::Show(Page::Discover));
+    assert!(h.settle(Duration::from_secs(10), |a| !a.indexing && !system.evals().is_empty()), "first attempt");
+    for query in ["h", "he", "hel", "hell", "hello"] {
+        h.send(Msg::Search(query.into()));
+        assert!(h.settle(Duration::from_secs(10), |a| !a.indexing), "settled after {query}");
+    }
+    let evals = system.evals();
+    assert_eq!(
+        evals.len(),
+        1,
+        "a failed index was made again for each keystroke: {} evaluations of {:?}; notes {:?}",
+        evals.len(),
+        evals.first(),
+        h.program().notes
+    );
+}
diff --git a/desktop/aizome/apps/yukimi/tests/repro_yuk_19.rs b/desktop/aizome/apps/yukimi/tests/repro_yuk_19.rs
