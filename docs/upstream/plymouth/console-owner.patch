From 647bb13f3e7d44b66223c0fa4b7fb2c37a558976 Mon Sep 17 00:00:00 2001
From: Chris Allen <cma@bitemyapp.com>
Date: Sat, 24 Oct 2026 22:06:44 -0500
Subject: [PATCH] device-manager: Free the local console when its renderer goes

local_console_managed was only cleared once no keyboards at all were
left. When a GPU's DRM driver takes over from simpledrm, the GPU's
framebuffer device can be found before its DRM device and get a renderer
of its own, without the console terminal, which simpledrm still has.
That renderer's keyboard is still there when simpledrm's renderer is
freed, so the DRM renderer that follows doesn't get the terminal either.
With legacy (terminal) input, no renderer reads the keyboard after
that: nothing typed reaches plymouthd, and neither does Escape.

Clear local_console_managed as soon as the renderer that has the local
console terminal is freed.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/libply-splash-core/ply-device-manager.c | 6 ++++++
 src/libply-splash-core/ply-renderer.c       | 6 ++++++
 src/libply-splash-core/ply-renderer.h       | 1 +
 3 files changed, 13 insertions(+)

diff --git a/src/libply-splash-core/ply-device-manager.c b/src/libply-splash-core/ply-device-manager.c
index f6a21937..baf07186 100644
--- a/src/libply-splash-core/ply-device-manager.c
+++ b/src/libply-splash-core/ply-device-manager.c
@@ -198,6 +198,12 @@ free_devices_from_device_path (ply_device_manager_t *manager,
         free_displays_for_renderer (manager, renderer);
         free_keyboards_for_renderer (manager, renderer);
 
+        if (manager->local_console_terminal != NULL &&
+            ply_renderer_get_terminal (renderer) == manager->local_console_terminal) {
+                ply_trace ("local console is free again");
+                manager->local_console_managed = false;
+        }
+
         ply_hashtable_remove (manager->renderers, (void *) device_path);
         free (key);
 
diff --git a/src/libply-splash-core/ply-renderer.c b/src/libply-splash-core/ply-renderer.c
index c139c8b2..6d9c23d3 100644
--- a/src/libply-splash-core/ply-renderer.c
+++ b/src/libply-splash-core/ply-renderer.c
@@ -129,6 +129,12 @@ ply_renderer_get_type (ply_renderer_t *renderer)
         return renderer->type;
 }
 
+ply_terminal_t *
+ply_renderer_get_terminal (ply_renderer_t *renderer)
+{
+        return renderer->terminal;
+}
+
 static bool
 ply_renderer_load_plugin (ply_renderer_t *renderer,
                           const char     *module_path)
diff --git a/src/libply-splash-core/ply-renderer.h b/src/libply-splash-core/ply-renderer.h
index ac69b120..8cc0ea68 100644
--- a/src/libply-splash-core/ply-renderer.h
+++ b/src/libply-splash-core/ply-renderer.h
@@ -66,6 +66,7 @@ void ply_renderer_deactivate (ply_renderer_t *renderer);
 bool ply_renderer_is_active (ply_renderer_t *renderer);
 const char *ply_renderer_get_device_name (ply_renderer_t *renderer);
 ply_renderer_type_t ply_renderer_get_type (ply_renderer_t *renderer);
+ply_terminal_t *ply_renderer_get_terminal (ply_renderer_t *renderer);
 ply_list_t *ply_renderer_get_heads (ply_renderer_t *renderer);
 ply_pixel_buffer_t *ply_renderer_get_buffer_for_head (ply_renderer_t      *renderer,
                                                       ply_renderer_head_t *head);
