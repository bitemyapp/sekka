#!/usr/bin/env python3
"""Provision isolated NativeLink domains without touching existing services.

init creates a private manifest; up/restart/stop/logs touch only its labelled
containers. client defaults to server-enforced read-only credentials. Redirect
secret client configuration into a mode-0600 file; never give CI the manifest.
Trusted developers explicitly request client --access writer. Shared CI only
reads trusted artifacts. A writable CI job instead needs its own init --domains
ci --port UNUSED, up, and client --domain ci --access writer. Such a job gets
separate tokens, network namespace, bounded tmpfs CAS/AC and workers; never
reuse that namespace across unrelated jobs. Restart means correct cold misses.
destroy --purge-state validates and removes only that owned job directory.

Persistent developer caches have per-store byte LRU and seven-day age limits.
These are retained-object bounds, not a hard quota on active trusted uploads.
Untrusted job tmpfs quotas include incomplete uploads. Worker scratch and logs
are independently bounded. resize uses the supported eviction configuration
against the existing cache; it never deletes objects to simulate eviction.
retain roots already-realized Nix closures, without evaluating source trees.
A minimal namespace-owner container keeps gateway process restarts independent
of backend/worker networking. up reconciles namespace-generation labels after
an owner restart or recreation, draining and replacing stale dependents.
Host publication stays loopback-only. CI joins an owned frontend bridge as a
separate container and uses client --frontend; connection-info prints its stable
network/DNS endpoint without credentials. Teardown refuses attached foreign jobs.
Use global --local when administering on the deployment host; manifests remain
portable and no SSH/agent forwarding is required. inventory emits explicit
persistent roots for physical-union accounting without traversing other services.
init imports a deterministic owned rootfs tar without Docker builder/cache state.
image/construction.json records its release checksum, exact imported diffID and
inspected image identity/platform/entrypoint; image/rootfs.tar retains the bytes.
physical-inventory forwards an explicit active/immutable scope, immutable compsize
executable, allowed roots and payload roots to the fail-closed physical observer.
It emits a sekka.physical-inventory.v1 JSON receipt then one compsize result.
Workers use bounded executable private tmpfs and a retained root-locked runtime
for NSS identities and private-session D-Bus policy, never the host's /etc or bus.
runtime explicitly migrates old manifests, replaces owned workers and restarts
their schedulers. Regenerate clients afterward: sekka.worker-runtime is part of
remote action identity.
dedupe (on the deployment host, with --local) shares extents between persistent
CAS blobs and byte-identical objects of the user's Buck2 content store, which
otherwise hold a second copy of every uploaded output on the same filesystem.

Tunnel with: ssh -N -L 17841:127.0.0.1:17841 -L 17842:127.0.0.1:17842 HOST
"""
import argparse
import errno
import fcntl
import hashlib
import json
import os
from pathlib import Path
import re
import secrets
import shlex
import shutil
import stat
import struct
import subprocess
import sys
import tarfile
import tempfile
import urllib.request

VERSION = "1.8.3"
ARCHIVE_SHA256 = "1a6596c96f059d4e99f7352164321e1f1cdff435275667ad8489e83f7e2977c5"
NGINX = "nginx@sha256:30f1c0d78e0ad60901648be663a710bdadf19e4c10ac6782c235200619158284"
DOCKER = ["docker", "-H", "unix:///run/docker.sock"]
LABEL = "computer.sekka.shared-build-service"
NETWORK_LABEL = LABEL + ".network-generation"
LOCAL = False
CACHE_BLOCK_SIZE = 4096


def remote(m, *args, capture=False, input=None):
    command = list(map(str, args)) if LOCAL else ["ssh", m["host"], shlex.join(map(str, args))]
    return subprocess.run(command,
                          check=True, text=True, capture_output=capture, input=input).stdout


def docker(m, *args, capture=False, input=None):
    return remote(m, *DOCKER, *args, capture=capture, input=input)


def inspect_frontend(m, domain):
    network = name(m, domain, "frontend")
    if not docker(m, "network", "ls", "--filter", "name=^" + network + "$",
                  "--format", "{{.Name}}", capture=True).strip():
        return None
    info = json.loads(docker(m, "network", "inspect", network, capture=True))[0]
    if info["Labels"].get(LABEL) != m["name"] or info["Driver"] != "bridge":
        raise SystemExit("Refusing unowned frontend network " + network)
    return info


def assert_frontend_unused(m, domain):
    info = inspect_frontend(m, domain)
    if info:
        allowed = set()
        for role in ("network", "gateway", "backend", "worker"):
            container = inspect_owned(m, name(m, domain, role))
            if container:
                allowed.add(container["Id"])
        foreign = [endpoint["Name"] for identifier, endpoint in info["Containers"].items()
                   if identifier not in allowed]
        if foreign:
            raise SystemExit("Refusing frontend teardown with attached jobs: " + ", ".join(foreign))
    return info


def connection_info(m, domain):
    return {"network": name(m, domain, "frontend"),
            "endpoint": "grpc://" + name(m, domain, "network") + ":50050", "instance": "sekka"}


def copy_file(m, source, relative):
    if LOCAL:
        shutil.copy2(source, Path(m["directory"]) / relative)
    else:
        subprocess.run(["scp", "-q", str(source), f'{m["host"]}:{m["directory"]}/{relative}'], check=True)


def assert_owned_directory(m):
    expected = "/home/callen/sekka-work/" + m["name"]
    suffix = m["name"].removeprefix("shared-build-service-")
    if (not m["name"].startswith("shared-build-service-") or len(suffix) != 12
            or any(c not in "0123456789abcdef" for c in suffix) or m["directory"] != expected):
        raise SystemExit("Refusing non-owned deployment path")
    if remote(m, "realpath", "-e", expected, capture=True).strip() != expected:
        raise SystemExit("Refusing symlinked deployment directory")
    owner = json.loads(remote(m, "cat", expected + "/owner.json", capture=True))
    if owner != {"name": m["name"], "schema": 1}:
        raise SystemExit("Deployment ownership marker mismatch")


def put(m, relative, content, mode=0o600):
    if LOCAL:
        target = Path(m["directory"]) / relative
        target.write_text(content)
        target.chmod(mode)
        return
    with tempfile.TemporaryDirectory(prefix="sekka-service-") as tmp:
        file = Path(tmp) / "payload"
        file.write_text(content)
        file.chmod(mode)
        copy_file(m, file, relative)


def cache_entry_limit(limit):
    # Empty ActionResults consume zero bytes in NativeLink's byte accounting.
    # Give them the same cardinality budget as minimally sized nonempty blobs.
    return max(1, limit // CACHE_BLOCK_SIZE)


def filesystem(path, limit):
    return {"filesystem": {"content_path": path + "/content", "temp_path": path + "/temp",
                           "block_size": CACHE_BLOCK_SIZE,
                           "eviction_policy": {"max_bytes": limit, "max_seconds": 604800,
                                               "max_count": cache_entry_limit(limit)}}}


FIEMAP = 0xC020660B
FIDEDUPERANGE = 0xC0189436
DEDUPE_STEP = 16 * 1024**2  # Btrfs dedupes at most 16 MiB per request.


def first_extent(fd):
    """Physical address of a file's first data extent, or None when inline/unmapped."""
    request = bytearray(32 + 56)
    struct.pack_into("=QQIII", request, 0, 0, 2**64 - 1, 0, 0, 1)
    fcntl.ioctl(fd, FIEMAP, request, True)
    mapped = struct.unpack_from("=I", request, 20)[0]
    physical, flags = struct.unpack_from("=Q", request, 40)[0], struct.unpack_from("=I", request, 72)[0]
    return physical if mapped and not flags & 0x306 else None  # UNKNOWN, DELALLOC, NOT_ALIGNED, INLINE


def dedupe(m, stores):
    """Share extents between persistent CAS blobs and identical content-store objects.

    Both are named by SHA-256 and size; the kernel compares the bytes before
    sharing anything, so a name never substitutes for content. Only files owned
    by this user on one host are touched, and only their extents change."""
    if not LOCAL:
        raise SystemExit("dedupe works on the deployment host's files; run it there with --local")
    objects = {}
    for store in stores:
        for entry in os.scandir(store):
            match = re.fullmatch(r"SHA256-([0-9a-f]{64})-([0-9]+)", entry.name)
            if match and entry.is_file(follow_symlinks=False):
                objects.setdefault((match[1], int(match[2])), entry.path)
    report = {"schema": 1, "deployment": m["name"], "content_stores": [str(s) for s in stores],
              "candidates": 0, "already_shared": 0, "deduplicated": 0, "deduplicated_bytes": 0,
              "skipped_small": 0, "differs": [], "errors": []}
    for domain in m["domains"]:
        if m.get("ephemeral_cache"):
            continue  # A tmpfs cache cannot share extents with the user's store.
        content = Path(m["directory"]) / domain / "data/cas/content"
        for blob in content.glob("*/*"):
            match = re.fullmatch(r"([0-9a-f]{64})-([0-9]+)(-[0-9]+)?", blob.name)
            source = match and objects.get((match[1], int(match[2])))
            if not source:
                continue
            size = int(match[2])
            report["candidates"] += 1
            if size < CACHE_BLOCK_SIZE:
                report["skipped_small"] += 1  # Inline or single partial block: nothing to share.
                continue
            try:
                src = os.open(source, os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC)
                try:
                    dst = os.open(blob, os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC)
                    try:
                        if any(os.fstat(fd).st_size != size or not stat.S_ISREG(os.fstat(fd).st_mode)
                               for fd in (src, dst)):
                            raise OSError(errno.EINVAL, "size or type differs from its digest name")
                        start = first_extent(src)
                        if start is not None and start == first_extent(dst):
                            report["already_shared"] += 1
                            continue
                        offset = 0
                        while offset < size:
                            length = min(DEDUPE_STEP, size - offset)
                            request = bytearray(24 + 32)
                            struct.pack_into("=QQHHI", request, 0, offset, length, 1, 0, 0)
                            struct.pack_into("=qQQiI", request, 24, dst, offset, 0, 0, 0)
                            fcntl.ioctl(src, FIDEDUPERANGE, request, True)
                            done, status = struct.unpack_from("=Qi", request, 40)
                            if status == 1:
                                report["differs"].append(str(blob))
                                break
                            if status < 0:
                                raise OSError(-status, os.strerror(-status))
                            if done == 0:
                                raise OSError(errno.EIO, "kernel shared no bytes")
                            offset += done
                        else:
                            report["deduplicated"] += 1
                            report["deduplicated_bytes"] += size
                    finally:
                        os.close(dst)
                finally:
                    os.close(src)
            except FileNotFoundError:
                continue  # Evicted by NativeLink or the content store meanwhile.
            except OSError as error:
                report["errors"].append({"blob": str(blob), "error": str(error)})
    print(json.dumps(report, indent=2))
    if report["differs"] or report["errors"]:
        raise SystemExit("dedupe found mismatched or unreadable blobs; see the report")


def backend_config(m):
    services = {kind: [{"instance_name": "sekka", field: store}]
                for kind, field, store in [("cas", "cas_store", "cas"),
                                           ("bytestream", "cas_store", "cas"), ("ac", "ac_store", "ac")]}
    services["execution"] = [{"instance_name": "sekka", "cas_store": "cas", "scheduler": "scheduler"}]
    services["capabilities"] = [{"instance_name": "sekka", "remote_execution": {"scheduler": "scheduler"}}]
    return {"stores": [
        {"name": "cas", "verify": {"verify_size": True, "verify_hash": True,
                                   "backend": filesystem("/data/cas", m["cas_bytes"])}},
        {"name": "ac", "completeness_checking": {"backend": filesystem("/data/ac", m["ac_bytes"]),
                                                 "cas_store": {"ref_store": {"name": "cas"}}}}],
        "schedulers": [{"name": "scheduler", "simple": {"supported_platform_properties": {
            "OSFamily": "exact", "ISA": "exact", "cpu_count": "minimum", "sekka.worker-runtime": "exact"}}}],
        "servers": [{"name": "reapi", "listener": {"http": {"socket_address": "127.0.0.1:50051"}},
                     "services": services},
                    {"name": "workers", "listener": {"http": {"socket_address": "127.0.0.1:50061"}},
                     "services": {"worker_api": {"scheduler": "scheduler"}, "health": {}}}],
        "global": {"max_open_files": 16384}}


def worker_config(m):
    def grpc(kind):
        return {"grpc": {"instance_name": "sekka", "endpoints": [{"address": "grpc://127.0.0.1:50051"}],
                         "store_type": kind}}
    return {"stores": [{"name": "cas", "fast_slow": {"fast": filesystem("/scratch/cas", m["worker_cache_bytes"]),
                                                       "slow": grpc("cas")}},
                       {"name": "ac", **grpc("ac")}],
            "workers": [{"local": {"worker_api_endpoint": {"uri": "grpc://127.0.0.1:50061"},
                                    "cas_fast_slow_store": "cas", "upload_action_result": {"ac_store": "ac"},
                                    "work_directory": "/scratch/work",
                                    "max_inflight_tasks": m["jobs"], "max_action_timeout_s": 3600,
                                    "max_concurrent_input_downloads": 64,
                                    "max_captured_output_bytes": 1048576,
                                    "orphan_sweep_interval_s": 60, "drain_on_shutdown": True,
                                    "platform_properties": {"OSFamily": {"values": ["linux"]},
                                                            "ISA": {"values": ["x86-64"]},
                                                            "cpu_count": {"values": [str(m["jobs"])]},
                                                            "sekka.worker-runtime": {"values": [m["worker_runtime"]]}}}}],
            "servers": [], "global": {"max_open_files": 16384}}


def gateway_config(token, reader_token):
    # Backend is namespace-loopback, not the host-accessible Docker bridge.
    return '''worker_processes 2;
pid /tmp/nginx.pid;
error_log /dev/stderr notice;
events { worker_connections 4096; }
http {
  map_hash_bucket_size 128;
  access_log /dev/stdout;
  client_body_temp_path /tmp/client;
  proxy_temp_path /tmp/proxy;
  fastcgi_temp_path /tmp/fastcgi;
  uwsgi_temp_path /tmp/uwsgi;
  scgi_temp_path /tmp/scgi;
  map $http_authorization $access {
    default none;
    "Bearer WRITER_TOKEN" writer;
    "Bearer READER_TOKEN" reader;
  }
  map "$access:$uri" $allowed {
    default 0;
    ~^writer: 1;
    "reader:/build.bazel.remote.execution.v2.Capabilities/GetCapabilities" 1;
    "reader:/build.bazel.remote.execution.v2.ActionCache/GetActionResult" 1;
    "reader:/build.bazel.remote.execution.v2.ContentAddressableStorage/FindMissingBlobs" 1;
    "reader:/build.bazel.remote.execution.v2.ContentAddressableStorage/BatchReadBlobs" 1;
    "reader:/build.bazel.remote.execution.v2.ContentAddressableStorage/GetTree" 1;
    "reader:/google.bytestream.ByteStream/Read" 1;
  }
  server {
    listen 50050;
    http2 on;
    client_max_body_size 0;
    error_page 401 = @unauthenticated;
    error_page 403 = @forbidden;
    location @unauthenticated {
      default_type application/grpc;
      add_header grpc-status 16 always;
      add_header grpc-message "Unauthenticated" always;
      return 200;
    }
    location @forbidden {
      default_type application/grpc;
      add_header grpc-status 7 always;
      add_header grpc-message "Permission denied" always;
      return 200;
    }
    location / {
      if ($access = none) { return 401; }
      if ($allowed = 0) { return 403; }
      grpc_pass grpc://127.0.0.1:50051;
      grpc_set_header Authorization "";
      grpc_read_timeout 3600s;
      grpc_send_timeout 3600s;
    }
  }
}
'''.replace("WRITER_TOKEN", token).replace("READER_TOKEN", reader_token)


def name(m, domain, role):
    return f'{m["name"]}-{domain}-{role}'


def assert_owned(m, container):
    found = docker(m, "inspect", "--format", '{{ index .Config.Labels "' + LABEL + '" }}', container, capture=True).strip()
    if found != m["name"]:
        raise SystemExit("Refusing unowned container " + container)


def inspect_owned(m, container):
    if not docker(m, "ps", "-a", "--filter", "name=^/" + container + "$",
                  "--format", "{{.Names}}", capture=True).strip():
        return None
    info = json.loads(docker(m, "inspect", container, capture=True))[0]
    if info["Config"]["Labels"].get(LABEL) != m["name"]:
        raise SystemExit("Refusing unowned container " + container)
    return info


def reconcile_network(m, domain, generation):
    dependents = [(role, inspect_owned(m, name(m, domain, role)))
                  for role in ("worker", "backend", "gateway")]
    if not any(info and info["Config"]["Labels"].get(NETWORK_LABEL) != generation
               for _, info in dependents):
        return
    for role, info in dependents:
        if info:
            container = name(m, domain, role)
            docker(m, "stop", "--timeout", "3600" if role == "worker" else "30", container)
            docker(m, "rm", container)


def run_container(m, domain, role, *args, network_generation=None):
    container = name(m, domain, role)
    existing = inspect_owned(m, container)
    if existing:
        state = existing["State"]["Status"]
        docker(m, "restart" if state == "restarting" else "start", container)
        return
    labels = [] if network_generation is None else ["--label", NETWORK_LABEL + "=" + network_generation]
    docker(m, "run", "-d", "--name", container, "--label", LABEL + "=" + m["name"], *labels,
           "--restart", "unless-stopped", "--read-only", "--cap-drop=ALL", "--security-opt=no-new-privileges",
           "--pids-limit", "2048", "--ulimit", "nofile=16384:16384",
           "--log-driver=json-file", "--log-opt=max-size=10m", "--log-opt=max-file=3", *args)


def runtime_paths(worker_runtime):
    if (not worker_runtime or Path(worker_runtime).parent != Path("/nix/store")
            or ".." in Path(worker_runtime).parts):
        raise SystemExit("Missing immutable worker runtime: use the Nix-packaged controller runtime command "
                         "(or --worker-runtime /nix/store/ROOT), then regenerate client configs")
    return {"worker_runtime": worker_runtime,
            "worker_shell": worker_runtime + "/bin/bash", "worker_env": worker_runtime + "/bin/env"}


def retain_runtime(m):
    remote(m, "mkdir", "-p", m["directory"] + "/roots")
    runtime = m["worker_runtime"]
    for relative in ("etc/passwd", "etc/group", "etc/nsswitch.conf", "etc/dbus-1/session.conf"):
        remote(m, "test", "-r", runtime + "/" + relative)
    for executable in ("bash", "env", "dbus-daemon", "dbus-run-session", "dbus-send"):
        remote(m, "test", "-x", runtime + "/bin/" + executable)
    remote(m, "nix-store", "--realise", runtime, "--add-root",
           m["directory"] + "/roots/" + Path(runtime).name, "--indirect")



def import_service_image(m):
    source_url = (f"https://github.com/TraceMachina/nativelink/releases/download/v{VERSION}/"
                  f"nativelink-{VERSION}-x86_64-unknown-linux-musl.tar.gz")
    entries = [
        {"path": "bin/", "type": "directory", "mode": "0755", "uid": 0, "gid": 0, "mtime": 0},
        {"path": "bin/nativelink", "type": "file", "mode": "0755", "uid": 0, "gid": 0, "mtime": 0},
    ]
    with tempfile.TemporaryDirectory(prefix="sekka-nativelink-") as tmp:
        archive = Path(tmp) / "nativelink.tar.gz"
        urllib.request.urlretrieve(source_url, archive)
        with archive.open("rb") as stream:
            if hashlib.file_digest(stream, "sha256").hexdigest() != ARCHIVE_SHA256:
                raise SystemExit("NativeLink archive checksum mismatch")
        rootfs = Path(tmp) / "rootfs.tar"
        with tarfile.open(archive) as release, tarfile.open(rootfs, "w", format=tarfile.USTAR_FORMAT) as tar:
            binary = next(x for x in release.getmembers()
                          if x.name.rsplit("/", 1)[-1] == "nativelink" and x.isfile())
            directory = tarfile.TarInfo("bin/")
            directory.type = tarfile.DIRTYPE
            directory.mode = 0o755
            tar.addfile(directory)
            executable = tarfile.TarInfo("bin/nativelink")
            executable.mode = 0o755
            executable.size = binary.size
            with release.extractfile(binary) as stream:
                binary_sha256 = hashlib.file_digest(stream, "sha256").hexdigest()
                stream.seek(0)
                tar.addfile(executable, stream)
        rootfs.chmod(0o600)
        with rootfs.open("rb") as stream:
            rootfs_sha256 = hashlib.file_digest(stream, "sha256").hexdigest()
        copy_file(m, rootfs, "image/rootfs.tar")
    entries[1].update(sha256=binary_sha256, size=binary.size)
    diff_id = "sha256:" + rootfs_sha256
    imported_id = docker(m, "image", "import", "--platform", "linux/amd64",
                         "--change", 'ENTRYPOINT ["/bin/nativelink"]',
                         m["directory"] + "/image/rootfs.tar", m["image"], capture=True).strip()
    inspected = json.loads(docker(m, "image", "inspect", m["image"], capture=True))[0]
    image = {"id": inspected["Id"], "os": inspected["Os"], "architecture": inspected["Architecture"],
             "entrypoint": inspected["Config"].get("Entrypoint"),
             "rootfs_type": inspected["RootFS"]["Type"], "diff_ids": inspected["RootFS"].get("Layers")}
    expected = {"id": imported_id, "os": "linux", "architecture": "amd64",
                "entrypoint": ["/bin/nativelink"], "rootfs_type": "layers", "diff_ids": [diff_id]}
    if image != expected:
        raise SystemExit("Imported NativeLink image does not match the owned rootfs/platform/entrypoint")
    # Only allowlisted, nonsecret construction data is eligible for public inventory.
    put(m, "image/construction.json", json.dumps({
        "schema": 1, "method": "docker-image-import-v1",
        "source": {"url": source_url, "version": VERSION, "archive_sha256": ARCHIVE_SHA256,
                   "binary_sha256": binary_sha256},
        "rootfs": {"path": "image/rootfs.tar", "sha256": rootfs_sha256, "diff_id": diff_id,
                   "format": "ustar", "entries": entries},
        "image": image,
    }, indent=2) + "\n")


def init(args):
    if args.manifest.exists():
        raise SystemExit("Manifest already exists; refusing to overwrite credentials")
    unique = "shared-build-service-" + secrets.token_hex(6)
    m = {"schema": 1, "name": unique, "host": args.host,
         "directory": "/home/callen/sekka-work/" + unique, "image": "sekka-nativelink:" + unique,
         "cas_bytes": args.cas_bytes, "ac_bytes": args.ac_bytes, "jobs": args.jobs,
         "scratch_bytes": args.scratch_bytes, "worker_cache_bytes": args.scratch_bytes // 4,
         "domains": {d: {"port": args.port + i, "token": secrets.token_hex(32),
                         "reader_token": secrets.token_hex(32)} for i, d in enumerate(args.domains)}}
    m.update(runtime_paths(args.worker_runtime))
    # Untrusted writable jobs must not fill the host filesystem through active
    # uploads outside the retained-object LRU. Their entire CAS/AC/temp area is
    # a size-limited tmpfs and disappears on restart; a miss rebuilds correctly.
    m["ephemeral_cache"] = args.domains == ["ci"]
    m["backend_data_bytes"] = args.cas_bytes + args.ac_bytes + min(args.cas_bytes, 4 * 1024**3)
    remote(m, "mkdir", "-m", "700", m["directory"])
    remote(m, "mkdir", "-m", "700", m["directory"] + "/image")
    m["uid"] = int(remote(m, "id", "-u", capture=True))
    m["gid"] = int(remote(m, "id", "-g", capture=True))
    args.manifest.parent.mkdir(parents=True, exist_ok=True)
    with args.manifest.open("x") as f:
        os.chmod(f.fileno(), 0o600)
        json.dump(m, f, indent=2)
    put(m, "owner.json", json.dumps({"name": unique, "schema": 1}))
    retain_runtime(m)
    import_service_image(m)
    docker(m, "pull", NGINX)
    for d, settings in m["domains"].items():
        remote(m, "mkdir", "-m", "700", m["directory"] + "/" + d)
        remote(m, "mkdir", "-m", "700", m["directory"] + "/" + d + "/data")
        put(m, d + "/backend.json", json.dumps(backend_config(m)), 0o644)
        put(m, d + "/worker.json", json.dumps(worker_config(m)), 0o644)
        put(m, d + "/nginx.conf", gateway_config(settings["token"], settings["reader_token"]), 0o644)
    print(json.dumps({"manifest": str(args.manifest), "host": m["host"], "directory": m["directory"]}))


def up(m):
    for d, settings in m["domains"].items():
        put(m, d + "/backend.json", json.dumps(backend_config(m)), 0o644)
        put(m, d + "/worker.json", json.dumps(worker_config(m)), 0o644)
        put(m, d + "/nginx.conf", gateway_config(settings["token"], settings["reader_token"]), 0o644)
        base = m["directory"] + "/" + d
        owner = name(m, d, "network")
        frontend = name(m, d, "frontend")
        if not inspect_frontend(m, d):
            docker(m, "network", "create", "--driver", "bridge", "--label", LABEL + "=" + m["name"], frontend)
        bindings = [{"HostIp": "127.0.0.1", "HostPort": str(settings["port"])}]
        existing = inspect_owned(m, owner)
        if existing and (existing["HostConfig"]["PortBindings"] != {"50050/tcp": bindings}
                         or not existing["HostConfig"]["Init"]
                         or existing["HostConfig"]["NetworkMode"] != frontend):
            reconcile_network(m, d, "")
            docker(m, "stop", "--timeout", "30", owner)
            docker(m, "rm", owner)
            existing = None
        if not existing:
            # Also cuts over deployments whose gateway owned the namespace.
            reconcile_network(m, d, "")
        run_container(m, d, "network", "--network", frontend, "--init", "--user", "65534:65534",
                      "--memory", "32m", "--cpus", "0.1", "-p", f'127.0.0.1:{settings["port"]}:50050',
                      "--entrypoint", "/bin/sleep", NGINX, "infinity")
        generation = docker(m, "inspect", "--format", "{{.Id}}:{{.NetworkSettings.SandboxID}}",
                            owner, capture=True).strip()
        reconcile_network(m, d, generation)
        network = "container:" + owner
        run_container(m, d, "gateway", "--network", network, "--user", "101:101", "--memory", "256m", "--cpus", "2",
                      "--tmpfs", "/tmp:rw,nosuid,nodev,size=64m,uid=101,gid=101",
                      "-v", base + "/nginx.conf:/etc/nginx/nginx.conf:ro",
                      "--entrypoint", "nginx", NGINX, "-g", "daemon off;", network_generation=generation)
        if m.get("ephemeral_cache", False):
            storage = ["--tmpfs", f'/data:rw,nosuid,nodev,size={m["backend_data_bytes"]},uid={m["uid"]},gid={m["gid"]},mode=0700']
            memory = str(m["backend_data_bytes"] + 1024**3)
        else:
            storage = ["-v", base + "/data:/data:rw"]
            memory = "8g"
        run_container(m, d, "backend", "--network", network, "--user", f'{m["uid"]}:{m["gid"]}',
                      "--memory", memory, "--cpus", "8", *storage,
                      "-v", base + "/backend.json:/config.json:ro", "-e", "RUST_LOG=info", m["image"], "/config.json",
                      network_generation=generation)
        run_container(m, d, "worker", "--network", network, "--user", "30501:30501",
                      "--memory", str(m["scratch_bytes"] + 8 * 1024**3), "--cpus", str(m["jobs"]),
                      "--tmpfs", f'/scratch:rw,exec,nosuid,nodev,size={m["scratch_bytes"]},uid=30501,gid=30501,mode=0700',
                      "--tmpfs", "/tmp:rw,exec,nosuid,nodev,size=1g,uid=30501,gid=30501,mode=1777",
                      "-v", "/nix/store:/nix/store:ro", "-v", base + "/worker.json:/config.json:ro",
                      "-v", m["worker_shell"] + ":/bin/sh:ro",
                      "-v", m["worker_shell"] + ":/bin/bash:ro",
                      "-v", m["worker_env"] + ":/usr/bin/env:ro",
                      "-v", m["worker_runtime"] + "/etc/passwd:/etc/passwd:ro",
                      "-v", m["worker_runtime"] + "/etc/group:/etc/group:ro",
                      "-v", m["worker_runtime"] + "/etc/nsswitch.conf:/etc/nsswitch.conf:ro",
                      "-v", m["worker_runtime"] + "/etc/dbus-1:/etc/dbus-1:ro",
                      "-e", "RUST_LOG=info", m["image"], "/config.json", network_generation=generation)


def main():
    global LOCAL
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--manifest", type=Path, required=True)
    parser.add_argument("--local", action="store_true", help="Execute administration directly on this deployment host, without SSH")
    sub = parser.add_subparsers(dest="command", required=True)
    create = sub.add_parser("init")
    create.add_argument("--host", default="wx-workstation")
    create.add_argument("--port", type=int, default=17841)
    create.add_argument("--domains", choices=("trusted", "ci"), nargs="+", default=["trusted"],
                        help="ci alone creates a disposable writer job; trusted ci together is for qualification only")
    create.add_argument("--jobs", type=int, default=8)
    create.add_argument("--cas-bytes", type=int, default=64 * 1024**3)
    create.add_argument("--ac-bytes", type=int, default=1024**3)
    create.add_argument("--scratch-bytes", type=int, default=32 * 1024**3)
    runtime = sub.add_parser("runtime", help="Retain immutable interpreters/NSS/DBus runtime, replace owned workers and restart schedulers")
    for command in (create, runtime):
        command.add_argument("--worker-runtime", default=os.environ.get("SEKKA_BUILD_SERVICE_WORKER_RUNTIME"),
                             help="Root-locked service worker runtime store root (Nix wrapper supplies default)")
    for command in ("up", "stop", "restart", "logs", "status", "issue-reader", "metrics", "inventory"):
        sub.add_parser(command)
    cache_inventory = sub.add_parser("cache-inventory", help="Snapshot persistent cache entries with owned backends paused")
    cache_inventory.add_argument("--timeout", type=int, default=60, help="Seconds to await configured cache byte/entry bounds")
    physical = sub.add_parser("physical-inventory", help="Measure one fail-closed physical extent union with public provenance")
    physical.add_argument("--scope", choices=("active", "immutable"), required=True,
                          help="Account active deployment state or only supplied immutable payload roots")
    physical.add_argument("--compsize", required=True, help="Immutable /nix/store/.../bin/compsize executable")
    physical.add_argument("--allow-root", action="append", default=[], help="Allowed accounting root (repeatable)")
    physical.add_argument("roots", nargs="+", help="Payload roots to include in the single extent-union measurement")
    destroy = sub.add_parser("destroy")
    destroy.add_argument("--purge-state", action="store_true", help="Remove only the validated owned deployment directory after stopping containers")
    deduplicate = sub.add_parser("dedupe", help="Share extents between CAS blobs and identical local Buck2 content-store objects")
    deduplicate.add_argument("--content-store", action="append", type=Path,
                             help="Content store directory (repeatable; default: the per-user Buck2 store)")
    retain = sub.add_parser("retain")
    retain.add_argument("store_paths", nargs="+", help="Already-provisioned immutable toolchain/native store roots")
    resize = sub.add_parser("resize")
    resize.add_argument("--cas-bytes", type=int, required=True)
    resize.add_argument("--ac-bytes", type=int, required=True)
    client = sub.add_parser("client")
    client.add_argument("--domain", choices=("trusted", "ci"), required=True)
    client.add_argument("--format", choices=("bazel", "buck2", "json"), default="json")
    address = client.add_mutually_exclusive_group()
    address.add_argument("--frontend", action="store_true", help="Use stable DNS from a separate container on the owned frontend bridge")
    address.add_argument("--endpoint")
    client.add_argument("--access", choices=("read-only", "writer"), default="read-only")
    connection = sub.add_parser("connection-info", help="Print nonsecret Docker network and authenticated gateway DNS endpoint")
    connection.add_argument("--domain", choices=("trusted", "ci"), required=True)
    args = parser.parse_args()
    LOCAL = args.local
    if args.command == "init":
        init(args)
        return
    if args.manifest.stat().st_mode & 0o077:
        raise SystemExit("Credential manifest must be mode 0600")
    m = json.loads(args.manifest.read_text())
    if args.command in ("up", "restart", "resize", "client"):
        expected = runtime_paths(m.get("worker_runtime"))
        if any(m.get(key) != value for key, value in expected.items()):
            raise SystemExit("Manifest interpreters must come from worker_runtime; run runtime and regenerate clients")
    if args.command in ("inventory", "cache-inventory", "physical-inventory"):
        script = os.environ.get("SEKKA_BUILD_SERVICE_INVENTORY",
                                str(Path(__file__).resolve().parents[1] / "nix/build-service/inventory.py"))
        inventory_args = [sys.executable, script, "--controller", str(Path(__file__).resolve()),
                          "--manifest", str(args.manifest), *(["--local"] if LOCAL else [])]
        if args.command == "cache-inventory":
            inventory_args.extend(["--cache-entries", "--timeout", str(args.timeout)])
        elif args.command == "physical-inventory":
            inventory_args.extend(["--physical", "--scope", args.scope, "--compsize", args.compsize])
            for root in args.allow_root:
                inventory_args.extend(["--allow-root", root])
            inventory_args.extend(["--", *args.roots])
        subprocess.run(inventory_args, check=True)
        return
    if args.command == "connection-info":
        print(json.dumps(connection_info(m, args.domain)))
        return
    if args.command == "dedupe":
        cache = Path(os.environ.get("XDG_CACHE_HOME") or Path.home() / ".cache")
        dedupe(m, args.content_store or [cache / "sekka/buck2/content-v1"])
        return
    if args.command == "runtime":
        m.update(runtime_paths(args.worker_runtime))
        retain_runtime(m)
        args.manifest.write_text(json.dumps(m, indent=2) + "\n")
        for domain in m["domains"]:
            container = name(m, domain, "worker")
            assert_owned(m, container)
            docker(m, "stop", "--timeout", "3600", container)
            docker(m, "rm", container)
            # The scheduler must load the matching runtime platform property.
            backend = name(m, domain, "backend")
            assert_owned(m, backend)
            docker(m, "stop", "--timeout", "30", backend)
        up(m)
        return
    if args.command == "restart":
        for domain in m["domains"]:
            for role in ("worker", "backend", "gateway"):
                assert_owned(m, name(m, domain, role))
                docker(m, "stop", "--timeout", "3600" if role == "worker" else "30", name(m, domain, role))
        up(m)
        return
    if args.command == "resize":
        if min(args.cas_bytes, args.ac_bytes) < 1:
            raise SystemExit("Cache bounds must be positive")
        if m.get("ephemeral_cache") and args.cas_bytes + args.ac_bytes > m["backend_data_bytes"]:
            raise SystemExit("New cache budget exceeds the job's immutable tmpfs quota; provision a larger job instead")
        m.update(cas_bytes=args.cas_bytes, ac_bytes=args.ac_bytes)
        for domain in m["domains"]:
            for role in ("worker", "backend"):
                assert_owned(m, name(m, domain, role))
                docker(m, "stop", "--timeout", "3600", name(m, domain, role))
            put(m, domain + "/backend.json", json.dumps(backend_config(m)), 0o644)
            put(m, domain + "/worker.json", json.dumps(worker_config(m)), 0o644)
        up(m)
        args.manifest.write_text(json.dumps(m, indent=2) + "\n")
        print(json.dumps({"deployment": m["name"], "cas_bytes": m["cas_bytes"], "ac_bytes": m["ac_bytes"]}))
        return
    if args.command == "metrics":
        containers = [name(m, d, role) for d in m["domains"] for role in ("network", "gateway", "backend", "worker")]
        for container in containers:
            assert_owned(m, container)
        stats = docker(m, "stats", "--no-stream", "--format", "{{json .}}", *containers, capture=True)
        allocated = {}
        for domain in m["domains"]:
            path = m["directory"] + "/" + domain + "/data"
            allocated[domain] = int(remote(m, "du", "-s", "-B1", path, capture=True).split()[0])
        print(json.dumps({"schema": 1, "deployment": m["name"], "host": m["host"],
                          "configured_per_domain": {k: m[k] for k in ("cas_bytes", "ac_bytes", "scratch_bytes", "worker_cache_bytes")},
                          "ephemeral_cache": m.get("ephemeral_cache", False),
                          "backend_hard_bytes": m.get("backend_data_bytes") if m.get("ephemeral_cache") else None,
                          "filesystem_allocated_bytes_not_extent_union": allocated,
                          "containers": [json.loads(line) for line in stats.splitlines()]}, indent=2))
        return
    if args.command == "destroy" and args.purge_state:
        assert_owned_directory(m)
    if args.command == "issue-reader":
        for d, settings in m["domains"].items():
            settings.setdefault("reader_token", secrets.token_hex(32))
            put(m, d + "/nginx.conf", gateway_config(settings["token"], settings["reader_token"]), 0o644)
            assert_owned(m, name(m, d, "gateway"))
            docker(m, "exec", name(m, d, "gateway"), "nginx", "-s", "reload")
        args.manifest.write_text(json.dumps(m, indent=2) + "\n")
        return
    if args.command == "retain":
        remote(m, "mkdir", "-p", m["directory"] + "/roots")
        for path in args.store_paths:
            if not path.startswith("/nix/store/") or "/" in path[len("/nix/store/"):] or ".." in path:
                raise SystemExit("Expected a Nix store root, not a subpath: " + path)
            # Requires a pre-realized closure. No flake/source evaluation and no
            # import of unsigned arbitrary client outputs into the worker store.
            remote(m, "nix-store", "--check-validity", path)
            remote(m, "nix-store", "--realise", path, "--add-root",
                   m["directory"] + "/roots/" + Path(path).name, "--indirect")
        return
    if args.command == "up":
        up(m)
    elif args.command == "client":
        d = m["domains"][args.domain]
        endpoint = (connection_info(m, args.domain)["endpoint"] if args.frontend
                    else args.endpoint or f'grpc://127.0.0.1:{d["port"]}')
        token = d["token" if args.access == "writer" else "reader_token"]
        if args.format == "bazel":
            print(f'build --remote_cache={endpoint}\nbuild --remote_instance_name=sekka')
            print("build --remote_default_exec_properties=OSFamily=linux")
            print("build --remote_default_exec_properties=ISA=x86-64")
            print("build --remote_default_exec_properties=sekka.worker-runtime=" + m["worker_runtime"])
            # Bazel includes rc options in routine BEP and option-error output.
            # A comment is private file data, never a native --remote_header.
            print("# sekka-bazel-credential-v1 " + json.dumps({"endpoint": endpoint, "token": token}))
            if args.access == "read-only":
                print("build --remote_upload_local_results=false")
        elif args.format == "buck2":
            print("[buck2_re_client]")
            for address in ("engine_address", "action_cache_address", "cas_address"):
                print(f"{address} = {endpoint}")
            print("tls = false\ninstance_name = sekka")
            print("http_headers = authorization: Bearer " + token)
            print("\n[sekka]\nworker_runtime = " + m["worker_runtime"])
        else:
            print(json.dumps({"endpoint": endpoint, "instance": "sekka", "authorization": "Bearer " + token,
                              "access": args.access, "worker_runtime": m["worker_runtime"]}))
    else:
        if args.command == "destroy":
            for domain in m["domains"]:
                assert_frontend_unused(m, domain)
        for domain in m["domains"]:
            for role in ("worker", "backend", "gateway", "network"):
                container = name(m, domain, role)
                if args.command == "destroy" and not docker(
                    m, "ps", "-a", "--filter", "name=^/" + container + "$", "--format", "{{.Names}}", capture=True
                ).strip():
                    continue
                assert_owned(m, container)
                if args.command == "logs":
                    docker(m, "logs", "--tail", "200", container)
                elif args.command == "status":
                    docker(m, "inspect", "--format", "{{.Name}} {{.State.Status}} {{.State.ExitCode}}", container)
                elif args.command == "destroy":
                    docker(m, "rm", "-f", container)
                else:
                    docker(m, "stop", "--timeout", "3600" if role == "worker" else "30", container)
        if args.command == "destroy":
            for domain in m["domains"]:
                network = assert_frontend_unused(m, domain)
                if network:
                    docker(m, "network", "rm", network["Id"])
        if args.command == "destroy" and args.purge_state:
            remote(m, "rm", "-rf", "--one-file-system", "--", m["directory"])


if __name__ == "__main__":
    main()
