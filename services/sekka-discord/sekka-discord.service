[Unit]
Description=Sekka GitHub notifications for Discord

[Service]
Type=simple
Environment=DISCORD_TOKEN_FILE=%h/.config/sekka-discord/bot-token
Environment=GITHUB_WEBHOOK_SECRET_FILE=%h/.config/sekka-discord/webhook-secret
Environment=SEKKA_LISTEN_ADDR=127.0.0.1:8787
Environment=SEKKA_STATE_DIR=%h/.local/state/sekka-discord
EnvironmentFile=%h/.config/sekka-discord/service.env
ExecStart=%h/.local/lib/sekka-discord/bin/sekka-discord run
Restart=on-failure
RestartSec=30
StateDirectory=sekka-discord
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=default.target
